# Declaration and path resolution shared by builds and compiler-free manifests.
macro(duckdb_parse_extension NAME PREFIX)
    set(options DONT_BUILD LOAD_TESTS APPLY_PATCHES)
    set(oneValueArgs SOURCE_DIR INCLUDE_DIR TEST_DIR GIT_URL GIT_TAG EXTENSION_VERSION LINKED_LIBS)
    cmake_parse_arguments(${PREFIX} "${options}" "${oneValueArgs}" "SUBMODULES" ${ARGN})
    if("DONT_LINK" IN_LIST ${PREFIX}_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "duckdb_extension_load(${NAME} DONT_LINK): DONT_LINK was removed, extensions are only linked when listed with duckdb_extension_statically_link() or STATICALLY_LINK_EXTENSIONS")
    endif()
    string(TOLOWER "${NAME}" EXTENSION_NAME_LOWERCASE)
    string(TOUPPER "${NAME}" EXTENSION_NAME_UPPERCASE)
    set(${PREFIX}_SELECTED TRUE)
    if(EXTENSION_NAME_LOWERCASE IN_LIST DUCKDB_EXTENSION_NAMES OR EXTENSION_NAME_LOWERCASE IN_LIST SKIP_EXTENSIONS)
        set(${PREFIX}_SELECTED FALSE)
    endif()
    if(${PREFIX}_SELECTED AND NOT ${PREFIX}_DONT_BUILD AND ${PREFIX}_GIT_URL AND NOT ${PREFIX}_GIT_TAG)
        message(FATAL_ERROR "Git URL specified but no valid GIT_TAG was found for ${NAME} extension")
    endif()
endmacro()

function(duckdb_resolve_extension_paths NAME PREFIX CHECKOUT)
    string(TOUPPER "DUCKDB_${NAME}_DIRECTORY" directory_override)
    set(source "${${PREFIX}_SOURCE_DIR}")
    set(include_path "${${PREFIX}_INCLUDE_DIR}")
    set(test_path "${${PREFIX}_TEST_DIR}")
    if(${PREFIX}_GIT_URL)
        if(DEFINED ENV{${directory_override}})
            set(CHECKOUT "$ENV{${directory_override}}")
        elseif(NOT CHECKOUT AND DUCKDB_NEW_EXTENSION_BUILD_ENABLED)
            set(CHECKOUT "${PROJECT_SOURCE_DIR}/extension/external/${NAME}")
        endif()
        if(CHECKOUT)
            get_filename_component(CHECKOUT "${CHECKOUT}" ABSOLUTE BASE_DIR "${PROJECT_SOURCE_DIR}")
            set(source "${CHECKOUT}/${source}")
            if(NOT include_path)
                set(include_path "src/include")
            endif()
            if(NOT test_path)
                set(test_path "test/sql")
            endif()
            if(NOT IS_ABSOLUTE "${include_path}")
                set(include_path "${CHECKOUT}/${include_path}")
            endif()
            if(NOT IS_ABSOLUTE "${test_path}")
                set(test_path "${CHECKOUT}/${test_path}")
            endif()
        else()
            set(source "")
            set(include_path "")
            set(test_path "")
        endif()
    elseif(source)
        get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${PROJECT_SOURCE_DIR}")
        if(NOT include_path)
            set(include_path "${source}/src/include")
        endif()
        if(NOT test_path)
            set(test_path "${source}/test/sql")
        endif()
    elseif(EXISTS "${PROJECT_SOURCE_DIR}/extension_external/${NAME}")
        set(source "${PROJECT_SOURCE_DIR}/extension_external/${NAME}")
        set(include_path "${source}/src/include")
        set(test_path "${source}/test/sql")
    else()
        set(source "${PROJECT_SOURCE_DIR}/extension/${NAME}")
        set(include_path "${source}/include")
        set(test_path "${source}/test/sql")
    endif()
    foreach(field SOURCE_PATH INCLUDE_PATH TEST_PATH)
        if(field STREQUAL "SOURCE_PATH")
            set(path "${source}")
        elseif(field STREQUAL "INCLUDE_PATH")
            set(path "${include_path}")
        else()
            set(path "${test_path}")
        endif()
        if(path)
            get_filename_component(path "${path}" ABSOLUTE BASE_DIR "${PROJECT_SOURCE_DIR}")
        endif()
        set(${PREFIX}_${field} "${path}" PARENT_SCOPE)
    endforeach()
    set(${PREFIX}_CHECKOUT_DIR "${CHECKOUT}" PARENT_SCOPE)
endfunction()

function(duckdb_manifest_json_string RESULT INPUT)
    string(REPLACE "\\" "\\\\" escaped "${INPUT}")
    string(REPLACE "\"" "\\\"" escaped "${escaped}")
    string(REPLACE "\n" "\\n" escaped "${escaped}")
    string(REPLACE "\r" "\\r" escaped "${escaped}")
    string(REPLACE "\t" "\\t" escaped "${escaped}")
    set(${RESULT} "\"${escaped}\"" PARENT_SCOPE)
endfunction()
