# name: benchmark/micro/join/left_join_chain_dense_match.benchmark
# description: Null-rejected LEFT joins whose right-hand keys cover 98% of the left-hand groups
# group: [join]

group micro
subgroup join

load
CREATE TABLE sales AS SELECT i % 1000000 AS k, (i % 7)::INTEGER AS qty FROM range(10000000) t(i);
CREATE TABLE web AS SELECT i AS k, 1 AS qty FROM range(490000) t(i);
CREATE TABLE catalog AS SELECT 490000 + i AS k, 1 AS qty FROM range(490000) t(i);

run
SELECT count(*), sum(s.qty)
FROM (SELECT k, sum(qty) qty FROM sales GROUP BY k) s
LEFT JOIN (SELECT k, sum(qty) qty FROM web GROUP BY k) w ON s.k=w.k
LEFT JOIN (SELECT k, sum(qty) qty FROM catalog GROUP BY k) c ON s.k=c.k
WHERE w.qty IS NOT NULL OR c.qty IS NOT NULL;

result II
980000	29400000
