# name: benchmark/micro/case/integer_simple_case_alternate.benchmark
# description: Simple CASE counterpart to integer_case_alternate.benchmark
# group: [case]

name Simple CASE operand with integers
group case

load
CREATE TABLE integers AS SELECT * FROM range(100000000) tbl(i);

run
SELECT SUM(CASE i % 2 WHEN 0 THEN 1 ELSE 0 END) FROM integers;

result I
50000000
