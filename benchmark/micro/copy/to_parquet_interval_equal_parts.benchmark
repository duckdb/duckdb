# name: benchmark/micro/copy/to_parquet_interval_equal_parts.benchmark
# description: Copy intervals with as many months as days to Parquet, dictionary encoded
# group: [copy]

name Copy to Parquet, intervals with equal parts
group copy

load
CREATE TABLE intervals AS SELECT to_months(i % 2000) + to_days(i % 2000) AS iv FROM range(10000000) t(i);

run
COPY intervals TO '${BENCHMARK_DIR}/interval_equal_parts.parquet' (FORMAT parquet);

result I
10000000
