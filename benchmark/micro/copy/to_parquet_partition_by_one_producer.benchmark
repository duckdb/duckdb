# name: benchmark/micro/copy/to_parquet_partition_by_one_producer.benchmark
# description: Copy to Parquet from range(), one producer thread, 2 partitions
# group: [copy]

name Copy to Parquet from range(), one producer thread, 2 partitions
group copy

run
COPY (SELECT i%2::INT32 AS part_col, i::INT32 AS v, (i * 7)::BIGINT AS w FROM range(0,13000000) tbl(i)) TO '${BENCHMARK_DIR}/partitioned_write' (FORMAT parquet, PARTITION_BY part_col, OVERWRITE);
