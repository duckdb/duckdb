# name: benchmark/micro/copy/to_parquet_interval_representations.benchmark
# description: Copy intervals to Parquet, with many representations of the same normalized interval in one dictionary
# group: [copy]

name Copy to Parquet, interval representations
group copy

load
CREATE TABLE intervals AS SELECT to_months(i % 2000) + to_days(30 * (2000 - i % 2000)) AS iv FROM range(2000000) t(i);

run
COPY intervals TO '${BENCHMARK_DIR}/interval_representations.parquet' (FORMAT parquet);

result I
2000000
