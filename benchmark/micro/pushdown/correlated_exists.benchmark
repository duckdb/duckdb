# name: benchmark/micro/pushdown/correlated_exists.benchmark
# description: Correlated EXISTS with selective equality keys and a residual comparison
# group: [pushdown]

name CorrelatedExists
group micro
subgroup pushdown

load
CREATE TABLE orders AS
SELECT i AS id, i % 97 AS amount FROM range(20000000) t(i);
CREATE TABLE refunds AS
SELECT 19000000 + i * 10 AS order_id, i % 89 AS amount FROM range(100000) t(i);

run
SELECT count(*), sum(o.amount)
FROM orders o
WHERE EXISTS (
    SELECT 1 FROM refunds r WHERE r.order_id = o.id AND r.amount > o.amount
);

result II
45353	1315111
