# name: benchmark/micro/window/predicate_elimination.benchmark
# description: Equivalence 13 from Lidner+ VLDB 2026
# group: [window]

name PredicateElimination
group micro
subgroup window

# Note that Table 3 varies alpha and the partition count, even though neither is appropriate.
# It also doesn't mention the limits used
argument rows 1_000_000
argument k 10
argument disabled ''

load
SET disabled_optimizers=${disabled};
CREATE OR REPLACE TABLE t AS (
	SELECT i, i::VARCHAR AS v
	FROM range(${rows}) tbl(i)
);
	
run
FROM t
QUALIFY row_number() OVER (ORDER BY v DESC) <= ${k};
