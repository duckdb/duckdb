# name: benchmark/micro/window/partitioned_window_with_aggregate.benchmark
# description: A partitioned window and a GROUP BY on the two sides of a FULL join: the window's hash-group sorts must not starve the aggregate of memory
# group: [window]

name Partitioned window beside a GROUP BY
group micro
subgroup window

load
SET threads = 16;
SET memory_limit = '24GiB';
CREATE TABLE t_win AS SELECT (range % 50000)::BIGINT AS k, range::BIGINT AS v FROM range(3000000);
CREATE TABLE t_agg AS SELECT (hash(range) % 2000000)::BIGINT AS g, range::BIGINT AS x FROM range(100000000);

run
SELECT count(*), sum(coalesce(w.s, 0) + coalesce(a.s, 0)) FROM
	(SELECT k, sum(v) OVER (PARTITION BY k ORDER BY v ROWS UNBOUNDED PRECEDING) AS s FROM t_win) w
	FULL JOIN (SELECT g, sum(x) AS s FROM t_agg GROUP BY g) a ON w.k = a.g;

result II
4950000	12455339086772340
