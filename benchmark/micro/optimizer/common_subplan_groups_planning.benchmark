# name: benchmark/micro/optimizer/common_subplan_groups_planning.benchmark
# description: Plan 256 distinct aggregate subplans, each used twice
# group: [optimizer]

name Common Subplan Groups Planning
group micro
subgroup optimizer

load
SET max_expression_depth=10000;
SET VARIABLE common_subplan_sql = (
	SELECT string_agg(format('SELECT sum(i) FROM range({}) r(i)', 8 + i // 2), ' UNION ALL ' ORDER BY i)
	FROM range(512) r(i)
);

run
PREPARE common_subplan_groups AS FROM query(getvariable('common_subplan_sql'));
