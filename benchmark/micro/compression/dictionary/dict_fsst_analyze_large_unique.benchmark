# name: benchmark/micro/compression/dictionary/dict_fsst_analyze_large_unique.benchmark
# description: Storing large values that are all unique, so only a couple of them fit in one block
# group: [dictionary]

name Dictionary Compression Write
group dictionary
storage persistent v1.4.0
require_reinit

load
PRAGMA force_compression='dict_fsst';
DROP TABLE IF EXISTS test;
CREATE OR REPLACE TABLE vals AS
	SELECT g AS grp, (SELECT string_agg(md5((g * 1000 + x)::VARCHAR), '') FROM range(180) x) AS txt
	FROM range(30_000) t(g);

run
CREATE TABLE test AS SELECT txt AS i FROM vals;
checkpoint;
