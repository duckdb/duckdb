# name: benchmark/micro/arithmetic/hugeint_decimal_modulo_minmax.benchmark
# description: Maximum and minimum of the modulo of a HUGEINT and a DECIMAL without fractional digits
# group: [arithmetic]

name Hugeint decimal modulo minmax
group arithmetic

load
CREATE TABLE hugeint_decimal AS SELECT i::HUGEINT h, 97::DECIMAL(18,0) d FROM range(10000000) t(i);

run
SELECT max(h % d), min(h % d) FROM hugeint_decimal

result II
96	0
