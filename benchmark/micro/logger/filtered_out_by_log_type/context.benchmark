# name: benchmark/micro/logger/filtered_out_by_log_type/context.benchmark
# description: Benchmarking the Context logger filtering out disabled log types
# group: [filtered_out_by_log_type]

name Context
group logger

load
CALL enable_logging('FileSystem');

# Note: this will call the Logger, but the log type is filtered out
run
SELECT write_log('hello world', level := 'warning', scope := 'context', log_type := 'duckdb.SomeName.SomeOtherName.BlaBla' ) from range(0,10000000);
