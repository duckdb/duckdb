# name: benchmark/feature/clickstream/serve/serve_s1_simple_r1_n1_ttl30d_sp100k_asof-latest_f3_cte.benchmark
# description: Generated SERVE scenario s1_simple_r1_n1_ttl30d_sp100k_asof-latest_f3_cte (seed=42)
# group: [serve]

template benchmark/feature/clickstream/serve/serve.benchmark.in
BENCH_NAME=Serve_s1_simple_r1_n1_ttl30d_sp100k_asof-latest_f3_cte
PARQUET_COUNT=1
SETUP_SQL=DROP FEATURE IF EXISTS f; DROP FEATURE IF EXISTS f2; DROP FEATURE IF EXISTS f3; CREATE FEATURE f ENTITY users TIMESTAMP EventTime WINDOW 3650 DAYS TTL 30 DAYS RETAIN 1 AS (SELECT UserID, COUNT(*) AS event_count FROM hits GROUP BY UserID); CREATE FEATURE f2 ENTITY users TIMESTAMP EventTime WINDOW 3650 DAYS TTL 30 DAYS RETAIN 1 AS (SELECT UserID, COUNT(*) AS event_count_2, AVG(RegionID) AS avg_region_2 FROM hits GROUP BY UserID); CREATE FEATURE f3 ENTITY users TIMESTAMP EventTime WINDOW 3650 DAYS TTL 30 DAYS RETAIN 1 AS (SELECT UserID, COUNT(*) AS event_count_3 FROM hits GROUP BY UserID); CREATE OR REPLACE TABLE serve_requests AS SELECT DISTINCT UserID, TIMESTAMP '2014-07-31 00:00:00' AS EventTime FROM hits USING SAMPLE 100000 ROWS; REFRESH FEATURE f AT '2013-07-31 00:00:00'; REFRESH FEATURE f2 AT '2013-07-31 00:00:00'; REFRESH FEATURE f3 AT '2013-07-31 00:00:00';
RUN_QUERY=WITH s AS (SELECT * FROM SERVE FEATURES f, f2, f3 FOR serve_requests ASOF EventTime) SELECT count(*) AS n FROM s WHERE event_count IS NOT NULL;
