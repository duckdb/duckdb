# name: benchmark/feature/clickstream/serve/serve_s100_multi_r20_n20_ttl0_sp100k_asof-mid_f3_groupby.benchmark
# description: Generated SERVE scenario s100_multi_r20_n20_ttl0_sp100k_asof-mid_f3_groupby (seed=42)
# group: [serve]

template benchmark/feature/clickstream/serve/serve.benchmark.in
BENCH_NAME=Serve_s100_multi_r20_n20_ttl0_sp100k_asof-mid_f3_groupby
PARQUET_COUNT=100
CLUSTER_TAG=clu
CLUSTER_BY=ORDER BY EventTime
SETUP_SQL=DROP FEATURE IF EXISTS f; DROP FEATURE IF EXISTS f2; DROP FEATURE IF EXISTS f3; CREATE FEATURE f ENTITY users TIMESTAMP EventTime WINDOW 3650 DAYS RETAIN 20 AS (SELECT UserID, COUNT(*) AS event_count, AVG(RegionID) AS avg_region, MIN(RegionID) AS min_region, MAX(RegionID) AS max_region FROM hits GROUP BY UserID); CREATE FEATURE f2 ENTITY users TIMESTAMP EventTime WINDOW 3650 DAYS RETAIN 20 AS (SELECT UserID, COUNT(*) AS event_count_2, AVG(RegionID) AS avg_region_2 FROM hits GROUP BY UserID); CREATE FEATURE f3 ENTITY users TIMESTAMP EventTime WINDOW 3650 DAYS RETAIN 20 AS (SELECT UserID, COUNT(*) AS event_count_3 FROM hits GROUP BY UserID); CREATE OR REPLACE TABLE serve_requests AS SELECT DISTINCT UserID, TIMESTAMP '2012-11-18 00:00:00' AS EventTime FROM hits USING SAMPLE 100000 ROWS; REFRESH FEATURE f AT '2012-01-08 00:00:00'; REFRESH FEATURE f2 AT '2012-01-08 00:00:00'; REFRESH FEATURE f3 AT '2012-01-08 00:00:00'; REFRESH FEATURE f AT '2012-02-07 00:00:00'; REFRESH FEATURE f2 AT '2012-02-07 00:00:00'; REFRESH FEATURE f3 AT '2012-02-07 00:00:00'; REFRESH FEATURE f AT '2012-03-08 00:00:00'; REFRESH FEATURE f2 AT '2012-03-08 00:00:00'; REFRESH FEATURE f3 AT '2012-03-08 00:00:00'; REFRESH FEATURE f AT '2012-04-07 00:00:00'; REFRESH FEATURE f2 AT '2012-04-07 00:00:00'; REFRESH FEATURE f3 AT '2012-04-07 00:00:00'; REFRESH FEATURE f AT '2012-05-07 00:00:00'; REFRESH FEATURE f2 AT '2012-05-07 00:00:00'; REFRESH FEATURE f3 AT '2012-05-07 00:00:00'; REFRESH FEATURE f AT '2012-06-06 00:00:00'; REFRESH FEATURE f2 AT '2012-06-06 00:00:00'; REFRESH FEATURE f3 AT '2012-06-06 00:00:00'; REFRESH FEATURE f AT '2012-07-06 00:00:00'; REFRESH FEATURE f2 AT '2012-07-06 00:00:00'; REFRESH FEATURE f3 AT '2012-07-06 00:00:00'; REFRESH FEATURE f AT '2012-08-05 00:00:00'; REFRESH FEATURE f2 AT '2012-08-05 00:00:00'; REFRESH FEATURE f3 AT '2012-08-05 00:00:00'; REFRESH FEATURE f AT '2012-09-04 00:00:00'; REFRESH FEATURE f2 AT '2012-09-04 00:00:00'; REFRESH FEATURE f3 AT '2012-09-04 00:00:00'; REFRESH FEATURE f AT '2012-10-04 00:00:00'; REFRESH FEATURE f2 AT '2012-10-04 00:00:00'; REFRESH FEATURE f3 AT '2012-10-04 00:00:00'; REFRESH FEATURE f AT '2012-11-03 00:00:00'; REFRESH FEATURE f2 AT '2012-11-03 00:00:00'; REFRESH FEATURE f3 AT '2012-11-03 00:00:00'; REFRESH FEATURE f AT '2012-12-03 00:00:00'; REFRESH FEATURE f2 AT '2012-12-03 00:00:00'; REFRESH FEATURE f3 AT '2012-12-03 00:00:00'; REFRESH FEATURE f AT '2013-01-02 00:00:00'; REFRESH FEATURE f2 AT '2013-01-02 00:00:00'; REFRESH FEATURE f3 AT '2013-01-02 00:00:00'; REFRESH FEATURE f AT '2013-02-01 00:00:00'; REFRESH FEATURE f2 AT '2013-02-01 00:00:00'; REFRESH FEATURE f3 AT '2013-02-01 00:00:00'; REFRESH FEATURE f AT '2013-03-03 00:00:00'; REFRESH FEATURE f2 AT '2013-03-03 00:00:00'; REFRESH FEATURE f3 AT '2013-03-03 00:00:00'; REFRESH FEATURE f AT '2013-04-02 00:00:00'; REFRESH FEATURE f2 AT '2013-04-02 00:00:00'; REFRESH FEATURE f3 AT '2013-04-02 00:00:00'; REFRESH FEATURE f AT '2013-05-02 00:00:00'; REFRESH FEATURE f2 AT '2013-05-02 00:00:00'; REFRESH FEATURE f3 AT '2013-05-02 00:00:00'; REFRESH FEATURE f AT '2013-06-01 00:00:00'; REFRESH FEATURE f2 AT '2013-06-01 00:00:00'; REFRESH FEATURE f3 AT '2013-06-01 00:00:00'; REFRESH FEATURE f AT '2013-07-01 00:00:00'; REFRESH FEATURE f2 AT '2013-07-01 00:00:00'; REFRESH FEATURE f3 AT '2013-07-01 00:00:00'; REFRESH FEATURE f AT '2013-07-31 00:00:00'; REFRESH FEATURE f2 AT '2013-07-31 00:00:00'; REFRESH FEATURE f3 AT '2013-07-31 00:00:00';
RUN_QUERY=SELECT event_count IS NULL AS missing, count(*) AS n FROM SERVE FEATURES f, f2, f3 FOR serve_requests ASOF EventTime GROUP BY event_count IS NULL;
