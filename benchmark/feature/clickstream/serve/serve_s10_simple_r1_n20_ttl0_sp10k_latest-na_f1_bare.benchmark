# name: benchmark/feature/clickstream/serve/serve_s10_simple_r1_n20_ttl0_sp10k_latest-na_f1_bare.benchmark
# description: Generated SERVE scenario s10_simple_r1_n20_ttl0_sp10k_latest-na_f1_bare (seed=42)
# group: [serve]

template benchmark/feature/clickstream/serve/serve.benchmark.in
BENCH_NAME=Serve_s10_simple_r1_n20_ttl0_sp10k_latest-na_f1_bare
PARQUET_COUNT=10
SETUP_SQL=DROP FEATURE IF EXISTS f; DROP FEATURE IF EXISTS f2; DROP FEATURE IF EXISTS f3; CREATE FEATURE f ENTITY users TIMESTAMP EventTime WINDOW 3650 DAYS RETAIN 1 AS (SELECT UserID, COUNT(*) AS event_count FROM hits GROUP BY UserID); CREATE OR REPLACE TABLE serve_requests AS SELECT DISTINCT UserID, TIMESTAMP '2013-07-31 00:00:00' AS EventTime FROM hits USING SAMPLE 10000 ROWS; REFRESH FEATURE f AT '2012-01-08 00:00:00'; REFRESH FEATURE f AT '2012-02-07 00:00:00'; REFRESH FEATURE f AT '2012-03-08 00:00:00'; REFRESH FEATURE f AT '2012-04-07 00:00:00'; REFRESH FEATURE f AT '2012-05-07 00:00:00'; REFRESH FEATURE f AT '2012-06-06 00:00:00'; REFRESH FEATURE f AT '2012-07-06 00:00:00'; REFRESH FEATURE f AT '2012-08-05 00:00:00'; REFRESH FEATURE f AT '2012-09-04 00:00:00'; REFRESH FEATURE f AT '2012-10-04 00:00:00'; REFRESH FEATURE f AT '2012-11-03 00:00:00'; REFRESH FEATURE f AT '2012-12-03 00:00:00'; REFRESH FEATURE f AT '2013-01-02 00:00:00'; REFRESH FEATURE f AT '2013-02-01 00:00:00'; REFRESH FEATURE f AT '2013-03-03 00:00:00'; REFRESH FEATURE f AT '2013-04-02 00:00:00'; REFRESH FEATURE f AT '2013-05-02 00:00:00'; REFRESH FEATURE f AT '2013-06-01 00:00:00'; REFRESH FEATURE f AT '2013-07-01 00:00:00'; REFRESH FEATURE f AT '2013-07-31 00:00:00';
RUN_QUERY=SELECT * FROM SERVE FEATURE f FOR serve_requests;
