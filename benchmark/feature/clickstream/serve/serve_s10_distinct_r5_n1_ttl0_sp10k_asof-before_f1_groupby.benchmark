# name: benchmark/feature/clickstream/serve/serve_s10_distinct_r5_n1_ttl0_sp10k_asof-before_f1_groupby.benchmark
# description: Generated SERVE scenario s10_distinct_r5_n1_ttl0_sp10k_asof-before_f1_groupby (seed=42)
# group: [serve]

template benchmark/feature/clickstream/serve/serve.benchmark.in
BENCH_NAME=Serve_s10_distinct_r5_n1_ttl0_sp10k_asof-before_f1_groupby
PARQUET_COUNT=10
SETUP_SQL=DROP FEATURE IF EXISTS f; DROP FEATURE IF EXISTS f2; DROP FEATURE IF EXISTS f3; CREATE FEATURE f ENTITY users TIMESTAMP EventTime WINDOW 3650 DAYS RETAIN 5 AS (SELECT UserID, COUNT(DISTINCT RegionID) AS distinct_regions, COUNT(*) AS event_count FROM hits GROUP BY UserID); CREATE OR REPLACE TABLE serve_requests AS SELECT DISTINCT UserID, TIMESTAMP '2013-07-01 00:00:00' AS EventTime FROM hits USING SAMPLE 10000 ROWS; REFRESH FEATURE f AT '2013-07-31 00:00:00';
RUN_QUERY=SELECT event_count IS NULL AS missing, count(*) AS n FROM SERVE FEATURE f FOR serve_requests ASOF EventTime GROUP BY event_count IS NULL;
