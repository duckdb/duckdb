# name: benchmark/feature/clickstream/serve/serve_s100_window_r20_n5_ttl0_sp10k_latest-na_f1_where.benchmark
# description: Generated SERVE scenario s100_window_r20_n5_ttl0_sp10k_latest-na_f1_where (seed=42)
# group: [serve]

template benchmark/feature/clickstream/serve/serve.benchmark.in
BENCH_NAME=Serve_s100_window_r20_n5_ttl0_sp10k_latest-na_f1_where
PARQUET_COUNT=100
SETUP_SQL=DROP FEATURE IF EXISTS f; DROP FEATURE IF EXISTS f2; DROP FEATURE IF EXISTS f3; CREATE FEATURE f ENTITY users TIMESTAMP EventTime WINDOW 3650 DAYS RETAIN 20 AS (SELECT DISTINCT UserID, COUNT(*) OVER (PARTITION BY UserID) AS event_count, AVG(RegionID) OVER (PARTITION BY UserID) AS avg_region FROM hits); CREATE OR REPLACE TABLE serve_requests AS SELECT DISTINCT UserID, TIMESTAMP '2013-07-31 00:00:00' AS EventTime FROM hits USING SAMPLE 10000 ROWS; REFRESH FEATURE f AT '2013-04-02 00:00:00'; REFRESH FEATURE f AT '2013-05-02 00:00:00'; REFRESH FEATURE f AT '2013-06-01 00:00:00'; REFRESH FEATURE f AT '2013-07-01 00:00:00'; REFRESH FEATURE f AT '2013-07-31 00:00:00';
RUN_QUERY=SELECT * FROM SERVE FEATURE f FOR serve_requests WHERE event_count IS NOT NULL;
