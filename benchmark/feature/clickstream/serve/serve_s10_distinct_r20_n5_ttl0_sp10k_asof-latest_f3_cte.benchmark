# name: benchmark/feature/clickstream/serve/serve_s10_distinct_r20_n5_ttl0_sp10k_asof-latest_f3_cte.benchmark
# description: Generated SERVE scenario s10_distinct_r20_n5_ttl0_sp10k_asof-latest_f3_cte (seed=42)
# group: [serve]

template benchmark/feature/clickstream/serve/serve.benchmark.in
BENCH_NAME=Serve_s10_distinct_r20_n5_ttl0_sp10k_asof-latest_f3_cte
PARQUET_COUNT=10
SETUP_SQL=DROP FEATURE IF EXISTS f; DROP FEATURE IF EXISTS f2; DROP FEATURE IF EXISTS f3; CREATE FEATURE f ENTITY users TIMESTAMP EventTime WINDOW 3650 DAYS RETAIN 20 AS (SELECT UserID, COUNT(DISTINCT RegionID) AS distinct_regions, COUNT(*) AS event_count FROM hits GROUP BY UserID); CREATE FEATURE f2 ENTITY users TIMESTAMP EventTime WINDOW 3650 DAYS RETAIN 20 AS (SELECT UserID, COUNT(*) AS event_count_2, AVG(RegionID) AS avg_region_2 FROM hits GROUP BY UserID); CREATE FEATURE f3 ENTITY users TIMESTAMP EventTime WINDOW 3650 DAYS RETAIN 20 AS (SELECT UserID, COUNT(*) AS event_count_3 FROM hits GROUP BY UserID); CREATE OR REPLACE TABLE serve_requests AS SELECT DISTINCT UserID, TIMESTAMP '2014-07-31 00:00:00' AS EventTime FROM hits USING SAMPLE 10000 ROWS; REFRESH FEATURE f AT '2013-04-02 00:00:00'; REFRESH FEATURE f2 AT '2013-04-02 00:00:00'; REFRESH FEATURE f3 AT '2013-04-02 00:00:00'; REFRESH FEATURE f AT '2013-05-02 00:00:00'; REFRESH FEATURE f2 AT '2013-05-02 00:00:00'; REFRESH FEATURE f3 AT '2013-05-02 00:00:00'; REFRESH FEATURE f AT '2013-06-01 00:00:00'; REFRESH FEATURE f2 AT '2013-06-01 00:00:00'; REFRESH FEATURE f3 AT '2013-06-01 00:00:00'; REFRESH FEATURE f AT '2013-07-01 00:00:00'; REFRESH FEATURE f2 AT '2013-07-01 00:00:00'; REFRESH FEATURE f3 AT '2013-07-01 00:00:00'; REFRESH FEATURE f AT '2013-07-31 00:00:00'; REFRESH FEATURE f2 AT '2013-07-31 00:00:00'; REFRESH FEATURE f3 AT '2013-07-31 00:00:00';
RUN_QUERY=WITH s AS (SELECT * FROM SERVE FEATURES f, f2, f3 FOR serve_requests ASOF EventTime) SELECT count(*) AS n FROM s WHERE event_count IS NOT NULL;
