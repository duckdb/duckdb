# name: benchmark/feature/clickstream/serve/serve_s10_multi_r5_n1_ttl30d_sp10k_latest-na_f1_cte.benchmark
# description: Generated SERVE scenario s10_multi_r5_n1_ttl30d_sp10k_latest-na_f1_cte (seed=42)
# group: [serve]

template benchmark/feature/clickstream/serve/serve.benchmark.in
BENCH_NAME=Serve_s10_multi_r5_n1_ttl30d_sp10k_latest-na_f1_cte
PARQUET_COUNT=10
SETUP_SQL=DROP FEATURE IF EXISTS f; DROP FEATURE IF EXISTS f2; DROP FEATURE IF EXISTS f3; CREATE FEATURE f ENTITY users TIMESTAMP EventTime WINDOW 3650 DAYS TTL 30 DAYS RETAIN 5 AS (SELECT UserID, COUNT(*) AS event_count, AVG(RegionID) AS avg_region, MIN(RegionID) AS min_region, MAX(RegionID) AS max_region FROM hits GROUP BY UserID); CREATE OR REPLACE TABLE serve_requests AS SELECT DISTINCT UserID, TIMESTAMP '2013-07-31 00:00:00' AS EventTime FROM hits USING SAMPLE 10000 ROWS; REFRESH FEATURE f AT '2013-07-31 00:00:00';
RUN_QUERY=WITH s AS (SELECT * FROM SERVE FEATURE f FOR serve_requests) SELECT count(*) AS n FROM s WHERE event_count IS NOT NULL;
