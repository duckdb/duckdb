# name: benchmark/feature/clickstream/refresh/refresh_s20_simple_w3650d_r1_prior0_unc.benchmark
# description: Generated REFRESH scenario s20_simple_w3650d_r1_prior0_unc (seed=42)
# group: [refresh]

template benchmark/feature/clickstream/refresh/refresh.benchmark.in
BENCH_NAME=Refresh_s20_simple_w3650d_r1_prior0_unc
PARQUET_COUNT=20
CLUSTER_TAG=unc
CLUSTER_BY=
SETUP_SQL=DROP FEATURE IF EXISTS f; DROP FEATURE IF EXISTS f2; DROP FEATURE IF EXISTS f3; CREATE FEATURE f ENTITY users TIMESTAMP EventTime WINDOW 3650 DAYS RETAIN 1 AS (SELECT UserID, COUNT(*) AS event_count FROM hits GROUP BY UserID);
RUN_QUERY=REFRESH FEATURE f AT '2013-07-31 00:00:00';
