template benchmark/feature/clickstream/refresh/refresh.benchmark.in
BENCH_NAME=Refresh_s20_window_w3650d_r20_prior5_unc
PARQUET_COUNT=20
CLUSTER_TAG=unc
CLUSTER_BY=
SETUP_SQL=DROP FEATURE IF EXISTS f; DROP FEATURE IF EXISTS f2; DROP FEATURE IF EXISTS f3; CREATE FEATURE f ENTITY users TIMESTAMP EventTime WINDOW 3650 DAYS RETAIN 20 AS (SELECT DISTINCT UserID, COUNT(*) OVER (PARTITION BY UserID) AS event_count, AVG(RegionID) OVER (PARTITION BY UserID) AS avg_region FROM hits); REFRESH FEATURE f AT '2013-03-03 00:00:00'; REFRESH FEATURE f AT '2013-04-02 00:00:00'; REFRESH FEATURE f AT '2013-05-02 00:00:00'; REFRESH FEATURE f AT '2013-06-01 00:00:00'; REFRESH FEATURE f AT '2013-07-01 00:00:00';
RUN_QUERY=REFRESH FEATURE f AT '2013-07-31 00:00:00';
