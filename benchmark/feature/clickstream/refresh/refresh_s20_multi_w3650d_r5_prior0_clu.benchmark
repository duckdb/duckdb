# name: benchmark/feature/clickstream/refresh/refresh_s20_multi_w3650d_r5_prior0_clu.benchmark
# description: Generated REFRESH scenario s20_multi_w3650d_r5_prior0_clu (seed=42)
# group: [refresh]

template benchmark/feature/clickstream/refresh/refresh.benchmark.in
BENCH_NAME=Refresh_s20_multi_w3650d_r5_prior0_clu
PARQUET_COUNT=20
CLUSTER_TAG=clu
CLUSTER_BY=ORDER BY EventTime
SETUP_SQL=DROP FEATURE IF EXISTS f; DROP FEATURE IF EXISTS f2; DROP FEATURE IF EXISTS f3; CREATE FEATURE f ENTITY users TIMESTAMP EventTime WINDOW 3650 DAYS RETAIN 5 AS (SELECT UserID, COUNT(*) AS event_count, AVG(RegionID) AS avg_region, MIN(RegionID) AS min_region, MAX(RegionID) AS max_region FROM hits GROUP BY UserID);
RUN_QUERY=REFRESH FEATURE f AT '2013-07-31 00:00:00';
