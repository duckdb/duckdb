# name: benchmark/feature/clickstream/cases/case_multi_version_refresh_s20_clu.benchmark
# description: Build an 8-version refresh history in one timed unit (RETAIN 20, no eviction) (seed=42)
# group: [cases]

template benchmark/feature/clickstream/cases/cases.benchmark.in
BENCH_NAME=Case_multi_version_refresh_s20_clu
PARQUET_COUNT=20
CLUSTER_TAG=clu
CLUSTER_BY=ORDER BY EventTime
SETUP_SQL=DROP FEATURE IF EXISTS f; DROP FEATURE IF EXISTS f2; DROP FEATURE IF EXISTS f3; CREATE FEATURE f ENTITY users TIMESTAMP EventTime WINDOW 3650 DAYS RETAIN 20 AS (SELECT UserID, COUNT(*) AS event_count FROM hits GROUP BY UserID);
RUN_QUERY=REFRESH FEATURE f AT '2013-01-02 00:00:00'; REFRESH FEATURE f AT '2013-02-01 00:00:00'; REFRESH FEATURE f AT '2013-03-03 00:00:00'; REFRESH FEATURE f AT '2013-04-02 00:00:00'; REFRESH FEATURE f AT '2013-05-02 00:00:00'; REFRESH FEATURE f AT '2013-06-01 00:00:00'; REFRESH FEATURE f AT '2013-07-01 00:00:00'; REFRESH FEATURE f AT '2013-07-31 00:00:00';
