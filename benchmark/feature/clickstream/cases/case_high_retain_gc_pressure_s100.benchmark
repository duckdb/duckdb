# name: benchmark/feature/clickstream/cases/case_high_retain_gc_pressure_s100.benchmark
# description: 8 refreshes against a pre-built 10-version store (RETAIN 10) -- every timed refresh evicts from an already-large store (seed=42)
# group: [cases]

template benchmark/feature/clickstream/cases/cases.benchmark.in
BENCH_NAME=Case_high_retain_gc_pressure_s100
PARQUET_COUNT=100
SETUP_SQL=DROP FEATURE IF EXISTS f; DROP FEATURE IF EXISTS f2; DROP FEATURE IF EXISTS f3; CREATE FEATURE f ENTITY users TIMESTAMP EventTime WINDOW 3650 DAYS RETAIN 10 AS (SELECT UserID, COUNT(*) AS event_count FROM hits GROUP BY UserID); REFRESH FEATURE f AT '2015-03-07 00:00:00'; REFRESH FEATURE f AT '2015-04-06 00:00:00'; REFRESH FEATURE f AT '2015-05-06 00:00:00'; REFRESH FEATURE f AT '2015-06-05 00:00:00'; REFRESH FEATURE f AT '2015-07-05 00:00:00'; REFRESH FEATURE f AT '2015-08-04 00:00:00'; REFRESH FEATURE f AT '2015-09-03 00:00:00'; REFRESH FEATURE f AT '2015-10-03 00:00:00'; REFRESH FEATURE f AT '2015-11-02 00:00:00'; REFRESH FEATURE f AT '2015-12-02 00:00:00';
RUN_QUERY=REFRESH FEATURE f AT '2015-06-05 00:00:00'; REFRESH FEATURE f AT '2015-07-05 00:00:00'; REFRESH FEATURE f AT '2015-08-04 00:00:00'; REFRESH FEATURE f AT '2015-09-03 00:00:00'; REFRESH FEATURE f AT '2015-10-03 00:00:00'; REFRESH FEATURE f AT '2015-11-02 00:00:00'; REFRESH FEATURE f AT '2015-12-02 00:00:00'; REFRESH FEATURE f AT '2016-01-01 00:00:00';
