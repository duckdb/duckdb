# name: test/issues/general/test_24936.test
# description: Issue 24936 - value count mismatch when writing DELTA_BINARY_PACKED for NULLs nested in a LIST
# group: [general]

require parquet

# the list child vector fills up a data page (100MB) part way through
statement ok
CREATE TABLE lists AS
SELECT i AS id, list(CASE WHEN j % 9 = 0 THEN NULL ELSE lpad((i * 400 + j)::VARCHAR, 400, 'N') END ORDER BY j) AS v
FROM range(800) s(i), (SELECT unnest(range(400)) AS j)
GROUP BY i;

statement ok
COPY lists TO '{TEST_DIR}/24936_list.parquet' (FORMAT PARQUET, PARQUET_VERSION V2);

query I
SELECT count(*) FROM lists JOIN '{TEST_DIR}/24936_list.parquet' p USING (id) WHERE lists.v IS DISTINCT FROM p.v;
----
0

# the same through a STRUCT inside the LIST
statement ok
COPY (SELECT id, [{'s': x} for x in v] AS v FROM lists) TO '{TEST_DIR}/24936_list_struct.parquet' (FORMAT PARQUET, PARQUET_VERSION V2);

query I
SELECT count(*) FROM (SELECT id, [{'s': x} for x in v] AS v FROM lists) l
JOIN '{TEST_DIR}/24936_list_struct.parquet' p USING (id) WHERE l.v IS DISTINCT FROM p.v;
----
0

# V1 pages take the same Prepare path
statement ok
COPY lists TO '{TEST_DIR}/24936_list_v1.parquet' (FORMAT PARQUET, PARQUET_VERSION V1);

query I
SELECT count(*) FROM lists JOIN '{TEST_DIR}/24936_list_v1.parquet' p USING (id) WHERE lists.v IS DISTINCT FROM p.v;
----
0

# a large element at the page boundary must not blow up the page size estimate
statement ok
SET memory_limit='4GB';

statement ok
CREATE TABLE big AS
SELECT list(s ORDER BY i) AS l FROM (
    SELECT i, CASE WHEN i < 204799 THEN lpad(i::VARCHAR, 508, '0')
                   WHEN i = 204799 THEN repeat('B', 1000000)
                   ELSE 'y' END AS s
    FROM range(224800) r(i));

statement ok
COPY big TO '{TEST_DIR}/24936_big.parquet' (FORMAT PARQUET);

query I
SELECT count(*) FROM big JOIN '{TEST_DIR}/24936_big.parquet' p ON (big.l = p.l);
----
1
