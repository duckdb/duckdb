# name: test/issues/general/test_26144.test
# description: A sequence function folded while binding a prepared statement marks the database as modified
# group: [general]

load {TEST_DIR}/test_26144.db

# the restart below replays the sequence changes from the WAL
statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
PRAGMA wal_autocheckpoint='1TB';

statement ok
CREATE SEQUENCE s;

statement ok
CREATE SEQUENCE s2;

statement ok
PREPARE z AS SELECT count(*) FROM range(nextval('s2'));

statement ok
PREPARE p AS SELECT count(*) FROM range(nextval('s'));

query I
SELECT 42;
----
42

query I
EXECUTE p;
----
1

statement ok
PREPARE g AS SELECT count(*) FROM generate_series(1, nextval('s'));

query I
SELECT currval('s');
----
2

statement ok
BEGIN;

statement ok
PREPARE q AS SELECT count(*) FROM range(nextval('s'));

statement ok
COMMIT;

query I
SELECT currval('s');
----
3

# a read-only transaction cannot advance the sequence
statement ok
BEGIN TRANSACTION READ ONLY;

statement error
PREPARE r AS SELECT count(*) FROM range(nextval('s'));
----
transaction is launched in read-only mode

statement ok
ROLLBACK;

# currval only reads it
statement ok
BEGIN TRANSACTION READ ONLY;

statement ok
PREPARE c AS SELECT count(*) FROM range(currval('s'));

query I
EXECUTE c;
----
3

statement ok
COMMIT;

statement ok
PREPARE v AS SELECT count(*) FROM range(setval('s', 10));

query I
SELECT currval('s');
----
10

# a sequence function in a branch that does not run marks nothing
statement ok
BEGIN TRANSACTION READ ONLY;

statement ok
PREPARE x AS SELECT count(*) FROM range(CASE WHEN false THEN nextval('s') ELSE 2 END);

statement ok
COMMIT;

# a database attached read-only cannot advance its sequence
statement ok
ATTACH '{TEST_DIR}/test_26144_ro.db' AS ro;

statement ok
CREATE SEQUENCE ro.s;

statement ok
DETACH ro;

statement ok
ATTACH '{TEST_DIR}/test_26144_ro.db' AS ro (READ_ONLY);

statement error
PREPARE a AS SELECT count(*) FROM range(nextval('ro.s'));
----
which is attached in read-only mode

statement error
PREPARE b AS SELECT count(*) FROM range(setval('ro.s', 10));
----
which is attached in read-only mode

query I
SELECT 42;
----
42

# the sequence advanced while binding is persisted
statement ok
DETACH ro;

restart

query II
SELECT nextval('s'), nextval('s2');
----
11	2
