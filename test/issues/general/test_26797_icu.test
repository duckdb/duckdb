# name: test/issues/general/test_26797_icu.test
# description: ICU functions cannot create finite timestamps below the TIMESTAMP WITH TIME ZONE range
# group: [general]

require icu

statement ok
SET TimeZone = 'UTC';

statement error
SELECT make_timestamptz(-9223372036854775806);
----
Conversion Error: Timestamp microseconds out of range: -9223372036854775806

query I
SELECT make_timestamptz(-9223372022400000000);
----
290309-12-22 (BC) 00:00:00+00

# the local hour of the first instant of the range starts before it
statement ok
SET TimeZone = 'Asia/Tokyo';

statement error
SELECT date_trunc('hour', TIMESTAMPTZ '290309-12-22 (BC) 00:00:00+00');
----
Conversion Error: ICU date overflows timestamp range

query I
SELECT epoch_us(date_trunc('hour', TIMESTAMPTZ '290309-12-22 (BC) 01:00:00+00'));
----
-9223372019939000000
