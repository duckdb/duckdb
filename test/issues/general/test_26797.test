# name: test/issues/general/test_26797.test
# description: Cast a finite timestamp whose day starts below the timestamp range to VARCHAR
# group: [general]

statement ok
CREATE TABLE t AS SELECT make_timestamp(-9223372036854775806) AS ts;

query IIII
SELECT ts::VARCHAR, TRY_CAST(ts AS VARCHAR), ts::DATE, ts::TIME FROM t;
----
290309-12-21 (BC) 19:59:05.224194	290309-12-21 (BC) 19:59:05.224194	290309-12-21 (BC)	19:59:05.224194

# the smallest finite timestamp
query I
SELECT make_timestamp(-9223372036854775808)::VARCHAR;
----
290309-12-21 (BC) 19:59:05.224192

# the last microsecond below the first midnight, and the first midnight
query II
SELECT make_timestamp(-9223372022400000001)::VARCHAR, make_timestamp(-9223372022400000000)::VARCHAR;
----
290309-12-21 (BC) 23:59:59.999999	290309-12-22 (BC) 00:00:00

query II
SELECT epoch_ms(-9223372036854775)::VARCHAR, epoch_ms(-9223372036854775)::TIMESTAMP_MS::VARCHAR;
----
290309-12-21 (BC) 19:59:05.225	290309-12-21 (BC) 19:59:05.225

query III
SELECT ts::VARIANT::VARCHAR, [ts]::VARCHAR, {'a': ts}::VARCHAR FROM t;
----
290309-12-21 (BC) 19:59:05.224194	['290309-12-21 (BC) 19:59:05.224194']	{'a': '290309-12-21 (BC) 19:59:05.224194'}

query I
SELECT epoch_us(ts) FROM t;
----
-9223372036854775806

# arithmetic that leaves the range still fails
statement error
SELECT TIMESTAMP '290309-12-22 (BC) 00:00:00' - INTERVAL 1 DAY;
----
Conversion Error
