# name: test/issues/general/test_26877.test
# description: Issue 26877: a scan with a LIMIT expands only the file patterns it reads
# group: [general]

require parquet

require json

statement ok
COPY (SELECT 42 AS i) TO '{TEMP_DIR}/lazy_list.parquet';

statement ok
COPY (SELECT 42 AS i) TO '{TEMP_DIR}/lazy_list.json';

# the progress bar expands the list in proportion to the files that were read, which is not tested here
statement ok
SET enable_progress_bar=false;

# the LIMIT is reached long before the pattern that matches no file
query I
SELECT * FROM read_parquet(['{TEMP_DIR}/lazy_list*.parquet' FOR x IN range(1000)] || ['{TEMP_DIR}/missing*.parquet']) LIMIT 1
----
42

query I
SELECT * FROM read_json(['{TEMP_DIR}/lazy_list*.json' FOR x IN range(1000)] || ['{TEMP_DIR}/missing*.json']) LIMIT 1
----
42

# a scan that reads every file expands every pattern
statement error
SELECT count(*) FROM read_parquet(['{TEMP_DIR}/lazy_list*.parquet' FOR x IN range(1000)] || ['{TEMP_DIR}/missing*.parquet'])
----
No files found that match the pattern

query I
SELECT count(*) FROM read_parquet(['{TEMP_DIR}/lazy_list*.parquet' FOR x IN range(1000)])
----
1000
