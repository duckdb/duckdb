# name: test/issues/general/test_26877.test
# description: Issue 26877: a scan with a LIMIT does not expand the whole list of file patterns
# group: [general]

require parquet

require json

statement ok
COPY (SELECT 42 AS i) TO '{TEMP_DIR}/lazy_list.parquet';

statement ok
COPY (SELECT 42 AS i) TO '{TEMP_DIR}/lazy_list.json';

# the progress bar and the threads of the scan expand the list in proportion to the files that were read, which is
# not tested here
statement ok
SET enable_progress_bar=false;

statement ok
SET threads=4;

# the LIMIT is reached long before the pattern that matches no file
query I
SELECT * FROM read_parquet(['{TEMP_DIR}/lazy_list*.parquet' FOR x IN range(10000)] || ['{TEMP_DIR}/missing*.parquet']) LIMIT 1
----
42

query I
SELECT * FROM read_json(['{TEMP_DIR}/lazy_list*.json' FOR x IN range(10000)] || ['{TEMP_DIR}/missing*.json']) LIMIT 1
----
42

# a scan that reads every file expands every pattern
statement error
SELECT count(*) FROM read_parquet(['{TEMP_DIR}/lazy_list*.parquet' FOR x IN range(1000)] || ['{TEMP_DIR}/missing*.parquet'])
----
No files found that match the pattern

query I
SELECT count(*) FROM read_parquet(['{TEMP_DIR}/lazy_list*.parquet' FOR x IN range(1000)])
----
1000

statement error
SELECT count(*) FROM read_json(['{TEMP_DIR}/lazy_list*.json' FOR x IN range(1000)] || ['{TEMP_DIR}/missing*.json'])
----
No files found that match the pattern

query I
SELECT count(*) FROM read_json(['{TEMP_DIR}/lazy_list*.json' FOR x IN range(1000)])
----
1000

# CSV counts the files of the scan for its rejects table, so it expands every pattern
statement ok
COPY (SELECT 42 AS i) TO '{TEMP_DIR}/lazy_list.csv';

statement error
SELECT * FROM read_csv(['{TEMP_DIR}/lazy_list*.csv' FOR x IN range(1000)] || ['{TEMP_DIR}/missing*.csv']) LIMIT 1
----
No files found that match the pattern

query II
SELECT count(*), count(DISTINCT filename) FROM read_csv(['{TEMP_DIR}/lazy_list*.csv' FOR x IN range(1000)], filename = true)
----
1000	1

# the rejects of two scans in one query get distinct file ids, which takes the exact count of the first scan
statement ok
COPY (SELECT * FROM (VALUES ('x'), ('1')) t(num)) TO '{TEMP_DIR}/lazy_rejects.csv' (HEADER);

query II
SELECT (SELECT sum(num) FROM read_csv(['{TEMP_DIR}/lazy_rejects*.csv' FOR x IN range(600)], columns = {'num': 'INTEGER'}, header = true, store_rejects = true)), (SELECT sum(num) FROM read_csv(['{TEMP_DIR}/lazy_rejects*.csv' FOR x IN range(700)], columns = {'num': 'INTEGER'}, header = true, store_rejects = true))
----
600	700

query III
SELECT count(*), count(DISTINCT (scan_id, file_id)), max(file_id) FROM reject_errors
----
1300	1300	1299
