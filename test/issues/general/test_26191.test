# name: test/issues/general/test_26191.test
# description: A json_transform structure nests no deeper than max_expression_depth
# group: [general]

require json

statement error
SELECT json_transform('1', repeat('{"a":', 20000) || '"VARCHAR"' || repeat('}', 20000));
----
Max expression depth limit of 1000 exceeded

statement error
SELECT from_json('[1]', repeat('[', 20000) || '"VARCHAR"' || repeat(']', 20000));
----
Max expression depth limit of 1000 exceeded

# a structure below the limit is accepted
query I
SELECT json_transform(repeat('{"a":', 50) || '1' || repeat('}', 50), repeat('{"a":', 50) || '"INTEGER"' || repeat('}', 50))::VARCHAR
	= repeat('{''a'': ', 50) || '1' || repeat('}', 50);
----
true

statement ok
SET max_expression_depth = 30;

statement error
SELECT json_transform('{}', repeat('{"a":', 50) || '"INTEGER"' || repeat('}', 50));
----
Max expression depth limit of 30 exceeded

# the nesting of a type written in a string adds to the nesting of the structure around it
statement error
SELECT json_transform('null', repeat('[', 20) || '"INTEGER' || repeat('[]', 20) || '"' || repeat(']', 20));
----
Max expression depth limit of 30 exceeded

query I
SELECT typeof(json_transform('null', repeat('[', 10) || '"INTEGER' || repeat('[]', 10) || '"' || repeat(']', 10)))
	= 'INTEGER' || repeat('[]', 20);
----
true

query III
SELECT typeof(json_transform('null', '["MAP(VARCHAR, INTEGER[])"]')), typeof(json_transform('null', '{"a": "UNION(i INTEGER, s VARCHAR[])"}')),
	typeof(json_transform('null', '"INTEGER[3][2]"'));
----
MAP(VARCHAR, INTEGER[])[]	STRUCT(a UNION(i INTEGER, s VARCHAR[]))	INTEGER[3][2]
