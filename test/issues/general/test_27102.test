# name: test/issues/general/test_27102.test
# description: Issue 27102: fmod returns the exact floored remainder for large quotients
# group: [general]

query RRRRRR
SELECT fmod(1e16, 3.0), fmod(-1e16, 3.0), fmod(1e16, -3.0), fmod(-1e16, -3.0), fmod(1e300, 7.0), fmod(-1e-300, 3)
----
1.0	2.0	-2.0	-1.0	1.0	3.0

statement ok
CREATE TABLE vals AS SELECT * FROM (VALUES (1e16::DOUBLE, 3), (1e16, -3), (-1e16, 3), (10, 3), (10, -3), (-10, 3), (-10, -3), (NULL, 3), (10, NULL)) t(x, y)

query R
SELECT fmod(x, y) FROM vals
----
1.0
-2.0
2.0
1.0
-2.0
2.0
-1.0
NULL
NULL

# FLOAT arguments are computed and returned as FLOAT, all other numeric arguments as DOUBLE
query IIIIII
SELECT typeof(fmod(10::FLOAT, 3::FLOAT)), typeof(fmod(10::FLOAT, 3)), typeof(fmod(10, 3)), typeof(fmod(10.5, 3)), typeof(fmod(10::HUGEINT, 3)), typeof(fmod(10::FLOAT, 3::DOUBLE))
----
FLOAT	FLOAT	DOUBLE	DOUBLE	DOUBLE	DOUBLE

query RR
SELECT fmod(1e16::FLOAT, 3::FLOAT), fmod(-10::FLOAT, 3::FLOAT)
----
2.0	2.0

# an exact zero remainder is a positive zero
query II
SELECT fmod(-6.0, 3)::VARCHAR, fmod(6.0, -3)::VARCHAR
----
0.0	0.0

# each argument is evaluated once
query I
SELECT bool_and(r >= 0 AND r < 1) FROM (SELECT fmod(random() * 1000, 1) r FROM range(10000))
----
true

# infinite divisors keep the dividend, or the divisor when the signs differ
query RRRR
SELECT fmod(5, 'inf'::DOUBLE), fmod(-5, 'inf'::DOUBLE), fmod(5, '-inf'::DOUBLE), fmod(-5, '-inf'::DOUBLE)
----
5.0	inf	-inf	-5.0

query III
SELECT isnan(fmod('inf'::DOUBLE, 3)), isnan(fmod('nan'::DOUBLE, 3)), isnan(fmod(3, 'nan'::DOUBLE))
----
true	true	true

# with IEEE semantics a zero divisor gives NaN
query II
SELECT isnan(fmod(42, 0)), isnan(fmod(42::FLOAT, 0::FLOAT))
----
true	true

statement ok
SET ieee_floating_point_ops=false;

statement error
SELECT fmod(42, 0)
----
Division by zero

statement error
SELECT fmod(42::FLOAT, 0::FLOAT)
----
Division by zero

statement ok
SET error_on_division_by_zero=false;

query RR
SELECT fmod(42, 0), fmod(42::FLOAT, 0::FLOAT)
----
NULL	NULL
