# name: test/extension/test_loadable_grammar_extension.test
# description: Test a loadable extension that changes the PEG grammar.
# group: [extension]

require skip_reload

statement ok
LOAD '{BUILD_DIRECTORY}/test/extension/loadable_grammar_extension_demo.duckdb_extension';

statement ok
SET active_grammar_extensions = ['pipe_query_syntax'];

statement ok
CREATE OR REPLACE TABLE produce(item VARCHAR, category VARCHAR, sales INTEGER);

statement ok
INSERT INTO produce VALUES
    ('apples', 'fruit', 10),
    ('apples', 'fruit', 15),
    ('bananas', 'fruit', 20),
    ('cashews', 'nut', 30),
    ('carrots', 'vegetable', 40);

query TII
FROM produce
  |> WHERE
        item != 'bananas'
        AND category IN ('fruit', 'nut')
  |> AGGREGATE COUNT(*) AS num_items, SUM(sales) AS total_sales
     GROUP BY item
  |> ORDER BY item DESC;
----
cashews	1	30
apples	2	25

query I
FROM produce
  |> WHERE category = 'fruit'
  |> SELECT item
  |> DISTINCT
  |> ORDER BY item
  |> LIMIT 1;
----
apples

query TII
FROM produce
  |> WHERE item = 'cashews'
  |> EXTEND sales * 2 AS doubled_sales
  |> SELECT item, sales, doubled_sales;
----
cashews	30	60

statement ok
CREATE TYPE sort_mood AS ENUM ('sad', 'ok', 'happy');

statement ok
CREATE TABLE sort_grammar(i BIGINT, s VARCHAR, m sort_mood, st STRUCT(a INTEGER, b VARCHAR));

statement ok
INSERT INTO sort_grammar VALUES
	(2, 'b', 'happy', {'a': 2, 'b': 'y'}),
	(1, 'c', 'sad', {'a': 1, 'b': 'z'}),
	(3, NULL, 'ok', NULL),
	(1, 'a', NULL, {'a': 0, 'b': 'w'});

query IT
SELECT i, s FROM sort_grammar ORDER BY i DESC, s;
----
3	NULL
2	b
1	a
1	c

query I
SELECT i FROM sort_grammar ORDER BY m NULLS FIRST, st;
----
1
1
3
2

query IT
FROM sort_grammar
  |> SELECT i, s
  |> ORDER BY s DESC NULLS LAST, i;
----
1	c
2	b
1	a
3	NULL
