# name: test/extension/loadable_parser_override.test
# description: Try loading a parser override with an extension
# group: [extension]

require skip_reload

statement error
override
----
Catalog Error: Table with name override does not exist!

statement ok
LOAD '{BUILD_DIRECTORY}/test/extension/loadable_extension_demo.duckdb_extension';

statement error
set allow_parser_override_extension=doesnotexist;
----
unrecognized value "doesnotexist" for enum "AllowParserOverride"

statement ok
set allow_parser_override_extension=default;

# Default behavior is not using the parser override
statement error
override
----
Catalog Error: Table with name override does not exist!

# Fallback behavior is trying the parser override and if they error falling back to the default parser
statement ok
set allow_parser_override_extension=fallback;

# The QuackParser can return a valid SQLStatement for this query
query I
override
----
The DuckDB parser has been overridden

# The parser cannot return a valid SQLStatement for this query, the default parser also gets an error
statement error
overri
----
Catalog Error: Table with name overri does not exist!

query I
SELECT 1;
----
1

statement ok
set allow_parser_override_extension=strict;

query I
override
----
The DuckDB parser has been overridden

statement error
overri
----
Parser Error: Parser overridden, query equaled "overri" but not "override"

query I
SELECT 1;
----
1

statement ok
CREATE TYPE mood AS ENUM ('sad', 'ok', 'happy');

statement ok
CREATE TABLE sort_override(i BIGINT, s VARCHAR, m mood, st STRUCT(a INTEGER, b VARCHAR), l INTEGER[]);

statement ok
INSERT INTO sort_override VALUES
	(2, 'b', 'happy', {'a': 2, 'b': 'y'}, [2, 1]),
	(1, 'c', 'sad', {'a': 1, 'b': 'z'}, [3]),
	(3, NULL, 'ok', {'a': 3, 'b': 'x'}, NULL),
	(1, 'a', NULL, NULL, [1, 2]);

foreach override_mode strict fallback default

statement ok
set allow_parser_override_extension={override_mode};

query IT
SELECT i, s FROM sort_override ORDER BY i, s DESC NULLS FIRST;
----
1	c
1	a
2	b
3	NULL

query T
SELECT m FROM sort_override ORDER BY m DESC NULLS LAST;
----
happy
ok
sad
NULL

query I
SELECT i FROM sort_override ORDER BY st NULLS FIRST, l;
----
1
1
2
3

query I
SELECT i FROM sort_override ORDER BY l NULLS LAST, i;
----
1
2
1
3

endloop
