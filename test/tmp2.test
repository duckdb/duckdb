# name: test/tmp2.test
# description: An index-expression ordinal is mistaken for a physical column ID
# group: [tmp]

statement ok
CREATE TABLE t(a INTEGER, b INTEGER)

statement ok
INSERT INTO t VALUES (1, 10), (2, 20)

statement ok
CREATE INDEX t_b ON t(b)

statement ok
CREATE VIEW v AS SELECT a, b FROM t

query II
EXPLAIN ANALYZE SELECT * FROM v WHERE b = 10
