# ARRAY

query I
SELECT array_cross_product(
    array2 := array_value(1.0::FLOAT, 2.0::FLOAT, 3.0::FLOAT),
    array1 := array_value(2.0::FLOAT, 3.0::FLOAT, 4.0::FLOAT)
)
----
[1.0, -2.0, 1.0]

query I
SELECT array_cosine_similarity(
    array2 := array_value(1.0::FLOAT, 2.0::FLOAT, 3.0::FLOAT), 
    array1 := array_value(2.0::FLOAT, 3.0::FLOAT, 4.0::FLOAT)
)
----
0.9925834

query I
SELECT array_cross_product(
    array2 := array_value(1.0::FLOAT, 2.0::FLOAT, 3.0::FLOAT), 
    array1 := array_value(2.0::FLOAT, 3.0::FLOAT, 4.0::FLOAT)
)
----
[1.0, -2.0, 1.0]

query I
SELECT array_distance(
    array2 := array_value(1.0::FLOAT, 2.0::FLOAT, 3.0::FLOAT), 
    array1 := array_value(2.0::FLOAT, 3.0::FLOAT, 4.0::FLOAT)
)
----
1.7320508

query I
SELECT array_inner_product(
    array2:= array_value(1.0::FLOAT, 2.0::FLOAT, 3.0::FLOAT), 
    array1:= array_value(2.0::FLOAT, 3.0::FLOAT, 4.0::FLOAT)
)
----
20.0

query I
SELECT array_negative_inner_product(
    array2 := array_value(1.0::FLOAT, 2.0::FLOAT, 3.0::FLOAT), 
    array1 := array_value(2.0::FLOAT, 3.0::FLOAT, 4.0::FLOAT)
)
----
-20.0

# BITSTRING

query I
SELECT bitstring(
    length := 7,
    bitstring := '1010'::BITSTRING
)
----
0001010

query I
SELECT bitstring(
    length := 7,
    bitstring := '1010'
)
----
0001010

query I
SELECT bitstring_byte_comparable(bitstring := '1010'::BIT)
----
\x03\x02\x03\x02

query I
SELECT get_bit(
    index := 2,
    bitstring := '0110010'::BIT
)
----
1

query I 
SELECT set_bit(
    new_value := 0,
    bitstring := '0110010'::BIT, 
    index := 2
)
----
0100010

query I 
SELECT bit_position(
    bitstring := '101010101'::BIT,
    substring := '010'::BIT
)
----
2

BLOB

