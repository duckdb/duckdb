{
	"description": "Run with verify-vector 'variant_vector'.",
	"on_init": "PRAGMA debug_verify_vector = 'variant_vector';",
	"skip_compiled": "true",
	"skip_tests": [
		{
			"reason": "Runs with memory constraints",
			"paths": [
				"test/parquet/constant_dictionary_vector_parquet.test",
				"test/sql/types/type/test_make_get_type.test",
				"test/parquet/constant_dictionary_vector_parquet.test_slow"
			]
		},
		{
			"reason": "NUMERIC values come back from VARIANT in another representation, and NUMERIC values wider than 38 digits are not supported in VARIANT",
			"paths": [
				"test/sql/types/numeric/numeric_aggregates.test",
				"test/sql/types/numeric/numeric_canonical_encoding.test",
				"test/sql/types/numeric/numeric_casts.test",
				"test/sql/types/numeric/numeric_kernel_contract.test",
				"test/sql/types/numeric/numeric_kernel_sizing.test",
				"test/sql/types/numeric/numeric_no_common_representation.test",
				"test/sql/types/numeric/numeric_to_float_rounding.test",
				"test/sql/types/numeric/numeric_to_float_rounding_representation.test",
				"test/sql/types/numeric/numeric_type_arithmetic.test",
				"test/sql/types/numeric/numeric_type.test",
				"test/sql/types/numeric/numeric_variant_arithmetic.test",
				"test/sql/types/numeric/numeric_variant_smoke.test",
				"test/sql/types/numeric/numeric_variant_storage_smoke.test",
				"test/sql/types/variant/variant_numeric_ordering.test",
				"test/sql/types/numeric/postgres_numeric_big.test",
				"test/sql/types/numeric/numeric_limits_review.test",
				"test/sql/types/numeric/numeric_magnitude_overflow.test",
				"test/sql/storage/types/numeric/numeric_storage_version.test",
				"test/optimizer/compressed_materialization_numeric.test"
			]
		},
		{
			"reason": "Roundtrip is not possible (MAP type)",
			"paths": [
				"test/parquet/test_parquet_schema.test",
				"test/parquet/schema_nested_extract.test",
				"test/parquet/test_parquet_schema_null_nested.test",
				"test/parquet/schema_nested_evolution.test",
				"test/parquet/test_parquet_schema_incompatible_nested_types.test",
				"test/parquet/parquet_schema_renamed_struct_filter.test",
				"test/sql/copy/parquet/parquet_schema_pushdown_extract_nested_default.test",
				"test/sql/copy/parquet/parquet_schema_default_only_struct.test"
			]
		},
		{
			"reason": "Checks the vector types of its input rows, which the VARIANT round trip of this config flattens",
			"paths": [
				"test/sql/unnest/unnest_constant_reference_types.test"
			]
		}
	]
}
