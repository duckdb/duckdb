# name: test/optimizer/duplicate_eliminated_domain_factoring.test
# description: Factor duplicate-eliminated domains from cheaper outer-input subtrees
# group: [optimizer]

statement ok
PRAGMA explain_output=optimized_only;

statement ok
CREATE TABLE domain_dim(k INTEGER, state VARCHAR);

statement ok
INSERT INTO domain_dim VALUES (1, 'selected'), (2, 'selected'), (3, 'selected'), (4, 'other'), (NULL, 'selected');

statement ok
CREATE TABLE domain_fact(k INTEGER, v INTEGER, payload VARCHAR);

statement ok
INSERT INTO domain_fact VALUES
    (1, 2, 'a'), (1, 4, 'b'), (1, 6, 'c'),
    (2, 1, 'd'), (2, 5, 'e'), (4, 7, 'f'),
    (NULL, 2, 'null-low'), (NULL, 6, 'null-high');

# Q17 shape: the filtered dimension provides a safe-superset key domain.
query III rowsort
SELECT f.k, f.v, length(f.payload)
FROM domain_fact f
JOIN domain_dim d ON f.k = d.k
WHERE d.state = 'selected'
  AND f.v < (
      SELECT avg(i.v)
      FROM domain_fact i
      WHERE i.k = d.k
  );
----
1	2	1
2	1	1

query II
EXPLAIN
SELECT f.k, f.v
FROM domain_fact f
JOIN domain_dim d ON f.k = d.k
WHERE d.state = 'selected'
  AND f.v < (
      SELECT avg(i.v)
      FROM domain_fact i
      WHERE i.k = d.k
  );
----
logical_opt	<!REGEX>:.*(__duckdb_duplicate_eliminated_factor_|__duckdb_delim_).*

# Factoring the candidate source must preserve duplicate payload rows.
statement ok
CREATE TABLE domain_duplicate_dim(k INTEGER, state VARCHAR, tag VARCHAR);

statement ok
INSERT INTO domain_duplicate_dim VALUES
    (1, 'selected', 'a'), (1, 'selected', 'b'), (2, 'selected', 'c'), (9, 'selected', 'unused');

query III rowsort
SELECT f.k, f.v, d.tag
FROM domain_fact f
JOIN domain_duplicate_dim d ON f.k = d.k
WHERE d.state = 'selected'
  AND f.v < (
      SELECT avg(i.v)
      FROM domain_fact i
      WHERE i.k = d.k
  );
----
1	2	a
1	2	b
2	1	c

query IIIII rowsort
SELECT f.k, f.v, d.k, d.state, d.tag
FROM domain_fact f
JOIN domain_duplicate_dim d ON f.k = d.k
WHERE d.state = 'selected'
  AND f.v < (
      SELECT avg(i.v)
      FROM domain_fact i
      WHERE i.k = d.k
  );
----
1	2	1	selected	a
1	2	1	selected	b
2	1	2	selected	c

query II
EXPLAIN
SELECT f.k, f.v
FROM domain_fact f
JOIN domain_duplicate_dim d ON f.k = d.k
WHERE d.state = 'selected'
  AND f.v < (
      SELECT avg(i.v)
      FROM domain_fact i
      WHERE i.k = d.k
  );
----
logical_opt	<!REGEX>:.*(__duckdb_duplicate_eliminated_factor_|__duckdb_delim_).*

# Q1 shape: trace the correlated key through an inner-join equality to the filtered side.
statement ok
CREATE TABLE domain_totals(customer_id INTEGER, store_key INTEGER, total INTEGER);

statement ok
INSERT INTO domain_totals VALUES
    (10, 1, 100), (11, 1, 20), (12, 2, 90), (13, 2, 10), (14, 4, 1000);

query I rowsort
SELECT t.customer_id
FROM domain_totals t
JOIN domain_dim d ON d.k = t.store_key
WHERE d.state = 'selected'
  AND t.total > (
      SELECT avg(t2.total) * 1.2
      FROM domain_totals t2
      WHERE t2.store_key = t.store_key
  );
----
10
12

query II
EXPLAIN
SELECT t.customer_id
FROM domain_totals t
JOIN domain_dim d ON d.k = t.store_key
WHERE d.state = 'selected'
  AND t.total > (
      SELECT avg(t2.total) * 1.2
      FROM domain_totals t2
      WHERE t2.store_key = t.store_key
  );
----
logical_opt	<!REGEX>:.*(__duckdb_duplicate_eliminated_factor_|__duckdb_delim_).*

# Trace a key through a direct projection mapping.
query I rowsort
SELECT t.customer_id
FROM domain_totals t
JOIN (
    SELECT k AS store_key, state
    FROM domain_dim
) d ON d.store_key = t.store_key
WHERE d.state = 'selected'
  AND t.total > (
      SELECT avg(t2.total) * 1.2
      FROM domain_totals t2
      WHERE t2.store_key = d.store_key
  );
----
10
12

query II
EXPLAIN
SELECT t.customer_id
FROM domain_totals t
JOIN (
    SELECT k AS store_key, state
    FROM domain_dim
) d ON d.store_key = t.store_key
WHERE d.state = 'selected'
  AND t.total > (
      SELECT avg(t2.total) * 1.2
      FROM domain_totals t2
      WHERE t2.store_key = d.store_key
  );
----
logical_opt	<!REGEX>:.*(__duckdb_duplicate_eliminated_factor_|__duckdb_delim_).*

# A grouped candidate can provide grouping keys.
query II rowsort
SELECT f.k, f.v
FROM domain_fact f
JOIN (
    SELECT k
    FROM domain_dim
    GROUP BY k
    HAVING min(state) = 'selected'
) d ON f.k = d.k
WHERE f.v < (
    SELECT avg(i.v)
    FROM domain_fact i
    WHERE i.k = d.k
);
----
1	2
2	1

query II
EXPLAIN
SELECT f.k, f.v
FROM domain_fact f
JOIN (
    SELECT k
    FROM domain_dim
    GROUP BY k
    HAVING min(state) = 'selected'
) d ON f.k = d.k
WHERE f.v < (
    SELECT avg(i.v)
    FROM domain_fact i
    WHERE i.k = d.k
);
----
logical_opt	<REGEX>:.*__duckdb_duplicate_eliminated_factor_.*Table: memory.main.domain_dim.*Groups: k.*

# Aggregate results themselves are not proven key-domain sources.
query II
EXPLAIN
SELECT f.k
FROM domain_fact f
JOIN (
    SELECT min(k) AS k
    FROM domain_dim
) d ON f.k = d.k
WHERE f.v < (
    SELECT avg(i.v)
    FROM domain_fact i
    WHERE i.k = d.k
);
----
logical_opt	<!REGEX>:.*__duckdb_duplicate_eliminated_factor_.*

# A SEMI join can provide keys from its output side.
query II rowsort
SELECT f.k, f.v
FROM domain_fact f
JOIN (
    SELECT d.k
    FROM domain_dim d
    SEMI JOIN domain_totals p ON d.k = p.store_key
    WHERE d.state = 'selected'
) d ON f.k = d.k
WHERE f.v < (
    SELECT avg(i.v)
    FROM domain_fact i
    WHERE i.k = d.k
);
----
1	2
2	1

query II
EXPLAIN
SELECT f.k, f.v
FROM domain_fact f
JOIN (
    SELECT d.k
    FROM domain_dim d
    SEMI JOIN domain_totals p ON d.k = p.store_key
    WHERE d.state = 'selected'
) d ON f.k = d.k
WHERE f.v < (
    SELECT avg(i.v)
    FROM domain_fact i
    WHERE i.k = d.k
);
----
logical_opt	<REGEX>:.*__duckdb_duplicate_eliminated_factor_.*Join Type: SEMI.*

# All correlated keys must be covered in canonical order.
statement ok
CREATE TABLE domain_pair_dim(k1 INTEGER, k2 INTEGER, state VARCHAR);

statement ok
INSERT INTO domain_pair_dim VALUES
    (1, 10, 'selected'), (2, 20, 'selected'), (3, 30, 'other'), (9, 90, 'selected');

statement ok
CREATE TABLE domain_pair_fact(k1 INTEGER, k2 INTEGER, v INTEGER);

statement ok
INSERT INTO domain_pair_fact VALUES
    (1, 10, 2), (1, 10, 4), (1, 10, 6),
    (2, 20, 1), (2, 20, 5), (3, 30, 7);

query III rowsort
SELECT f.k1, f.k2, f.v
FROM domain_pair_fact f
JOIN domain_pair_dim d ON f.k1 = d.k1 AND f.k2 = d.k2
WHERE d.state = 'selected'
  AND f.v < (
      SELECT avg(i.v)
      FROM domain_pair_fact i
      WHERE i.k1 = d.k1 AND i.k2 = d.k2
  );
----
1	10	2
2	20	1

query II
EXPLAIN
SELECT f.v
FROM domain_pair_fact f
JOIN domain_pair_dim d ON f.k1 = d.k1 AND f.k2 = d.k2
WHERE d.state = 'selected'
  AND f.v < (
      SELECT avg(i.v)
      FROM domain_pair_fact i
      WHERE i.k1 = d.k1 AND i.k2 = d.k2
  );
