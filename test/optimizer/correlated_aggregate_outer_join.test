# nested correlated counts
query II
SELECT sum(c), count(c)
FROM (SELECT (SELECT count(*) FROM s WHERE s.k = o.k AND s.q > (SELECT count(*) FROM s s2 WHERE s2.k = s.k)) AS c FROM o);
