# hand-written joins of this shape: the rewrite needs exactly one domain column per group of the duplicate
# elimination, otherwise the domain has several rows per key and multiplies the outer rows
statement ok
CREATE TABLE ht AS SELECT * FROM (VALUES (1, 10), (1, 20), (2, 10), (NULL, 10), (NULL, 20)) v(k, e);

statement ok
CREATE TABLE hr AS SELECT * FROM (VALUES (1, 10), (1, 10), (2, NULL), (NULL, 10), (3, 30)) v(k, k2);

statement ok
CREATE TABLE ht2(k INTEGER, e INTEGER);

statement ok
INSERT INTO ht2 VALUES (1, 10), (1, 20);

statement ok
CREATE TABLE hr2(k INTEGER);

statement ok
INSERT INTO hr2 VALUES (1);

# one group projected twice, the other not at all
query I
WITH s AS MATERIALIZED (SELECT * FROM ht2)
SELECT count(*) FROM s JOIN (
    SELECT d.k1, d.k2, a.c
    FROM (SELECT k AS k1, k AS k2 FROM s GROUP BY k, e) d
    LEFT JOIN (SELECT k, k AS k_, count(*) AS c FROM hr2 GROUP BY k) a ON d.k1 = a.k AND d.k2 = a.k_
) p ON s.k IS NOT DISTINCT FROM p.k1 AND s.k IS NOT DISTINCT FROM p.k2;
----
4

query II
WITH s AS MATERIALIZED (SELECT * FROM ht)
SELECT count(*), sum(p.c) FROM s JOIN (
    SELECT d.k1, d.k2, a.c
    FROM (SELECT k AS k1, k AS k2 FROM s GROUP BY k, e) d
    LEFT JOIN (SELECT k, k AS k_, count(*) AS c FROM hr GROUP BY k) a ON d.k1 = a.k AND d.k2 = a.k_
) p ON s.k IS NOT DISTINCT FROM p.k1 AND s.k IS NOT DISTINCT FROM p.k2;
----
9	9

# a group that is not a domain column
query II
WITH s AS MATERIALIZED (SELECT * FROM ht)
SELECT count(*), sum(p.c) FROM s JOIN (
    SELECT d.k1, a.c FROM (SELECT k AS k1 FROM s GROUP BY k, e) d
    LEFT JOIN (SELECT k, count(*) AS c FROM hr GROUP BY k) a ON d.k1 = a.k
) p ON s.k IS NOT DISTINCT FROM p.k1;
----
9	9

# a domain column that the outer join does not compare
query II
WITH s AS MATERIALIZED (SELECT * FROM ht)
SELECT count(*), sum(p.c) FROM s JOIN (
    SELECT d.k1, d.k2, a.c FROM (SELECT k AS k1, e AS k2 FROM s GROUP BY k, e) d
    LEFT JOIN (SELECT k, count(*) AS c FROM hr GROUP BY k) a ON d.k1 = a.k
) p ON s.k IS NOT DISTINCT FROM p.k1;
----
9	9

# a key through an expression
query II
WITH s AS MATERIALIZED (SELECT * FROM ht)
SELECT count(*), sum(p.c) FROM s JOIN (
    SELECT d.k1, a.c FROM (SELECT k + 0 AS k1 FROM s GROUP BY k) d
    LEFT JOIN (SELECT k, count(*) AS c FROM hr GROUP BY k) a ON d.k1 = a.k
) p ON s.k IS NOT DISTINCT FROM p.k1;
----
5	5

# the aggregate grouped by more than the join key
query II
WITH s AS MATERIALIZED (SELECT * FROM ht)
SELECT count(*), sum(p.c) FROM s JOIN (
    SELECT d.k1, a.c FROM (SELECT k AS k1 FROM s GROUP BY k) d
    LEFT JOIN (SELECT k, count(*) AS c FROM hr GROUP BY k, k2) a ON d.k1 = a.k
) p ON s.k IS NOT DISTINCT FROM p.k1;
----
5	5

# the aggregate key compared twice, and the outer key compared twice
query II
WITH s AS MATERIALIZED (SELECT * FROM ht)
SELECT count(*), sum(p.c) FROM s JOIN (
    SELECT d.k1, a.c FROM (SELECT k AS k1 FROM s GROUP BY k) d
    LEFT JOIN (SELECT k, k AS k_, count(*) AS c FROM hr GROUP BY k) a ON d.k1 = a.k AND d.k1 = a.k_
) p ON s.k IS NOT DISTINCT FROM p.k1;
----
5	5

query II
WITH s AS MATERIALIZED (SELECT * FROM ht)
SELECT count(*), sum(p.c) FROM s JOIN (
    SELECT d.k1, a.c FROM (SELECT k AS k1 FROM s GROUP BY k) d
    LEFT JOIN (SELECT k, count(*) AS c FROM hr GROUP BY k) a ON d.k1 = a.k
) p ON s.k IS NOT DISTINCT FROM p.k1 AND s.k IS NOT DISTINCT FROM p.k1;
----
5	5

# NULL keys: = on the outer join, a mix of = and IS NOT DISTINCT FROM on the inner one
query II
WITH s AS MATERIALIZED (SELECT * FROM ht)
SELECT count(*), sum(p.c) FROM s LEFT JOIN (
    SELECT d.k1, a.c FROM (SELECT k AS k1 FROM s GROUP BY k) d
    LEFT JOIN (SELECT k, count(*) AS c FROM hr GROUP BY k) a ON d.k1 = a.k
) p ON s.k = p.k1;
----
5	5

query II
WITH s AS MATERIALIZED (SELECT * FROM ht)
SELECT count(*), sum(p.c) FROM s JOIN (
    SELECT d.k1, d.k2, a.c FROM (SELECT k AS k1, e AS k2 FROM s GROUP BY k, e) d
    LEFT JOIN (SELECT k, k2, count(*) AS c FROM hr GROUP BY k, k2) a ON d.k1 IS NOT DISTINCT FROM a.k AND d.k2 = a.k2
) p ON s.k IS NOT DISTINCT FROM p.k1 AND s.e IS NOT DISTINCT FROM p.k2;
----
5	3

# DISTINCT instead of GROUP BY, grouping sets on either side, a filtered domain, swapped keys
query II
WITH s AS MATERIALIZED (SELECT * FROM ht)
SELECT count(*), sum(p.c) FROM s JOIN (
    SELECT d.k1, a.c FROM (SELECT DISTINCT k AS k1 FROM s) d
    LEFT JOIN (SELECT DISTINCT k, 1 AS c FROM hr) a ON d.k1 = a.k
) p ON s.k IS NOT DISTINCT FROM p.k1;
----
5	3

query II
WITH s AS MATERIALIZED (SELECT * FROM ht)
SELECT count(*), sum(p.c) FROM s JOIN (
    SELECT d.k1, a.c FROM (SELECT k AS k1 FROM s GROUP BY GROUPING SETS ((k), ())) d
    LEFT JOIN (SELECT k, count(*) AS c FROM hr GROUP BY k) a ON d.k1 = a.k
) p ON s.k IS NOT DISTINCT FROM p.k1;
----
7	5

query II
WITH s AS MATERIALIZED (SELECT * FROM ht)
SELECT count(*), sum(p.c) FROM s JOIN (
    SELECT d.k1, a.c FROM (SELECT k AS k1 FROM s GROUP BY k) d
    LEFT JOIN (SELECT k, count(*) AS c FROM hr GROUP BY GROUPING SETS ((k), ())) a ON d.k1 = a.k
) p ON s.k IS NOT DISTINCT FROM p.k1;
----
5	5

query II
WITH s AS MATERIALIZED (SELECT * FROM ht)
SELECT count(*), sum(p.c) FROM s JOIN (
    SELECT d.k1, a.c FROM (SELECT k AS k1 FROM s WHERE e > 10 GROUP BY k) d
    LEFT JOIN (SELECT k, count(*) AS c FROM hr GROUP BY k) a ON d.k1 = a.k
) p ON s.k IS NOT DISTINCT FROM p.k1;
