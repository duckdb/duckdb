514	511883

# Several subqueries share one outer side.
query IIII
SELECT sum(c1), sum(c2), sum(c3), count(*)
FROM (SELECT (SELECT count(*) FROM s WHERE s.k = o.k AND q > 2) AS c1, (SELECT count(*) FROM s WHERE s.k = o.x) AS c2,
             (SELECT count(q) FROM s WHERE s.id = o.id) AS c3 FROM o WHERE o.x <> 4);
----
4504	5999	1714	1714

query II
EXPLAIN (FORMAT JSON)
SELECT (SELECT count(*) FROM s WHERE s.k = o.k AND q > 2) AS c1, (SELECT count(*) FROM s WHERE s.k = o.k AND q < 9) AS c2,
       (SELECT count(q) FROM s WHERE s.k = o.k) AS c3 FROM o WHERE o.x <> 4;
----
physical_plan	<!REGEX>:[\s\S]*__duckdb_delim[\s\S]*

query IIIIIII
SELECT sum(c1),sum(c2),sum(c3),count(*),count(c1),count(c2),count(c3) FROM (
    SELECT (SELECT count(*) FROM s WHERE s.k = o.k AND q > 2) AS c1,
           (SELECT count(*) FROM s WHERE s.k = o.k AND q < 9) AS c2,
           (SELECT count(q) FROM s WHERE s.k = o.k) AS c3
    FROM o WHERE o.x <> 4
);
----
4504	4061	5862	1714	1714	1714	1714

# must keep the keys: a selective outer side restricts the aggregate to the keys it reads
query II
SELECT o.id, (SELECT count(*) FROM s WHERE s.k = o.k) AS c FROM o WHERE o.id = 1234;
----
1234	3

query II
EXPLAIN (FORMAT JSON) SELECT o.id, (SELECT count(*) FROM s WHERE s.k = o.k) AS c FROM o WHERE o.id = 1234;
----
physical_plan	<REGEX>:[\s\S]*"Join Type": "(RIGHT_)?SEMI"[\s\S]*

# must keep the keys: a correlation that is not an equality groups the aggregate by the outer keys
query II
