# with the pass disabled the count keeps the join against the duplicate-eliminated keys
statement ok
SET disabled_optimizers = 'duplicate_eliminated_domain';

query II
EXPLAIN (FORMAT JSON) SELECT o.id, (SELECT count(*) FROM s WHERE s.k = o.k AND s.q > 3) AS c FROM o;
----
physical_plan	<REGEX>:[\s\S]*"Join Type": "SINGLE"[\s\S]*__duckdb_delim[\s\S]*

query IIIII
SELECT sum(c), count(*), count(c), min(c), max(c)
FROM (SELECT o.id, (SELECT count(*) FROM s WHERE s.k = o.k AND s.q > 3) AS c FROM o);
----
4739	2000	2000	0	4

query I
WITH s AS MATERIALIZED (SELECT * FROM ht2)
SELECT count(*) FROM s JOIN (
    SELECT d.k1, d.k2, a.c
    FROM (SELECT k AS k1, k AS k2 FROM s GROUP BY k, e) d
    LEFT JOIN (SELECT k, k AS k_, count(*) AS c FROM hr2 GROUP BY k) a ON d.k1 = a.k AND d.k2 = a.k_
) p ON s.k IS NOT DISTINCT FROM p.k1 AND s.k IS NOT DISTINCT FROM p.k2;
----
4

statement ok
RESET disabled_optimizers;

# a chain of CTEs that each read the previous one twice: the readers of the outer side are counted with one walk per
# CTE definition (the walk per reference took 2^40 steps here)
query II
WITH c0 AS MATERIALIZED (SELECT k FROM s),
     c1 AS MATERIALIZED (SELECT k FROM c0 WHERE k < 400 UNION ALL SELECT k FROM c0 WHERE k >= 400),
     c2 AS MATERIALIZED (SELECT k FROM c1 WHERE k < 400 UNION ALL SELECT k FROM c1 WHERE k >= 400),
     c3 AS MATERIALIZED (SELECT k FROM c2 WHERE k < 400 UNION ALL SELECT k FROM c2 WHERE k >= 400),
     c4 AS MATERIALIZED (SELECT k FROM c3 WHERE k < 400 UNION ALL SELECT k FROM c3 WHERE k >= 400),
