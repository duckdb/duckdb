# Scalar recovery can also collapse while retaining a selective input restriction.
statement ok
CREATE TABLE scalar_outer AS SELECT i AS id,i%15000 AS k FROM range(20000) t(i);

statement ok
CREATE TABLE scalar_inner AS SELECT i%100000 AS k FROM range(300000) t(i);

# Preserve analyzed statistics across forced restarts.
statement ok
