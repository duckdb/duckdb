4	4

query II
WITH s AS MATERIALIZED (SELECT * FROM ht)
SELECT count(*), sum(p.c) FROM s JOIN (
    SELECT d.k1, d.k2, a.c FROM (SELECT e AS k1, k AS k2 FROM s GROUP BY k, e) d
    LEFT JOIN (SELECT k, k2, count(*) AS c FROM hr GROUP BY k, k2) a ON d.k2 = a.k AND d.k1 = a.k2
) p ON s.k IS NOT DISTINCT FROM p.k1 AND s.e IS NOT DISTINCT FROM p.k2;
