# a correlation on two keys joins the aggregate grouped by both, without a generated CTE
query IIIII
SELECT sum(c), count(*), count(c), min(c), max(c)
FROM (SELECT o.id, (SELECT count(*) FROM s WHERE s.k = o.k AND s.q = o.x) AS c FROM o);
----
531	2000	2000	0	1

query IIIII
SELECT sum(c), count(*), count(c), min(c), max(c)
FROM (SELECT o.id, (SELECT count(*) FROM s WHERE s.k IS NOT DISTINCT FROM o.k AND s.q = o.x) AS c FROM o);
----
3009	2000	2000	0	21

query II
EXPLAIN (FORMAT JSON) SELECT o.id, (SELECT count(*) FROM s WHERE s.k = o.k AND s.q = o.x) AS c FROM o;
