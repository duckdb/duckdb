# name: test/optimizer/correlated_aggregate_outer_join.test
# description: A correlated aggregate without groups joins its outer side directly instead of the duplicate-eliminated keys
# group: [optimizer]

statement ok
CREATE TABLE recovery_outer AS
SELECT i AS id, i % 20 AS k, i % 3 AS k2, i % 100 AS sel FROM range(30000) t(i);

statement ok
CREATE TABLE recovery_inner AS
SELECT i % 100 AS k, (i // 100) % 10 AS k2 FROM range(30000) t(i);

# Duplicate-heavy recovery keeps evaluation per key even for a cheap expression.
query II
EXPLAIN (FORMAT JSON)
SELECT (SELECT count(*) FROM recovery_inner r WHERE r.k=o.k AND r.k2=o.k2)
FROM recovery_outer o WHERE o.sel<>7;
----
physical_plan	<REGEX>:[\s\S]*"Join Type": "SINGLE"[\s\S]*

query II
EXPLAIN (FORMAT JSON)
SELECT (SELECT count(*) FROM recovery_inner r WHERE r.k=o.k AND r.k2=o.k2)
FROM recovery_outer o WHERE o.id=1234;
----
physical_plan	<REGEX>:[\s\S]*"Join Type": "(RIGHT_)?SEMI"[\s\S]*

query II
SELECT count(*), sum(c) FROM (
    SELECT (SELECT count(*) FROM recovery_inner r WHERE r.k=o.k AND r.k2=o.k2) AS c
    FROM recovery_outer o WHERE o.sel<>7
);
----
29700	891000

# Expensive recovery stays per key with a restriction.
query II
EXPLAIN (FORMAT JSON)
SELECT (SELECT sha256(sha256(count(*)::VARCHAR)) FROM recovery_inner r WHERE r.k=o.k AND r.k2=o.k2)
FROM recovery_outer o WHERE o.sel<>7;
----
physical_plan	<REGEX>:[\s\S]*"Join Type": "SINGLE"[\s\S]*

query I
SELECT count(*) FROM (
    SELECT (SELECT sha256(sha256(count(*)::VARCHAR)) FROM recovery_inner r WHERE r.k=o.k AND r.k2=o.k2) AS c
    FROM recovery_outer o WHERE o.sel<>7
) WHERE c=sha256(sha256('30'));
----
29700

# The same evaluation-frequency guard applies when there is no input restriction.
query II
EXPLAIN (FORMAT JSON)
SELECT (SELECT sha256(sha256(count(*)::VARCHAR)) FROM recovery_inner r WHERE r.k=o.k)
FROM recovery_outer o;
----
physical_plan	<REGEX>:[\s\S]*__duckdb_delim[\s\S]*

query I
SELECT count(*) FROM (
    SELECT (SELECT sha256(sha256(count(*)::VARCHAR)) FROM recovery_inner r WHERE r.k=o.k) AS c
    FROM recovery_outer o
) WHERE c=sha256(sha256('300'));
----
30000

statement ok
DROP TABLE recovery_outer;

statement ok
DROP TABLE recovery_inner;

# A composite input restriction can remain useful after broad outer filtering.
statement ok
CREATE TABLE broad_outer AS
SELECT i AS id, ((i % 5000) * 7919) % 30000 AS k, i % 3 AS k2, i % 100 AS sel FROM range(30000) t(i);

statement ok
CREATE TABLE broad_inner AS
SELECT i % 30000 AS k, i // 30000 AS k2, i % 13 AS v FROM range(90000) t(i);

statement ok
ANALYZE broad_outer;

statement ok
ANALYZE broad_inner;

query II
EXPLAIN (FORMAT JSON)
SELECT (SELECT count(*) FROM broad_inner r WHERE r.k=o.k AND r.k2=o.k2)
FROM broad_outer o WHERE o.sel<>7;
----
physical_plan	<REGEX>:[\s\S]*"Join Type": "(RIGHT_)?SEMI"[\s\S]*

# Cheap user expressions also permit recovery while retaining the restriction.
query II
EXPLAIN (FORMAT JSON)
SELECT (SELECT coalesce(max(v), 0) FROM broad_inner r WHERE r.k=o.k AND r.k2=o.k2)
FROM broad_outer o WHERE o.sel<>7;
----
physical_plan	<!REGEX>:[\s\S]*"Join Type": "SINGLE"[\s\S]*

query II
EXPLAIN (FORMAT JSON)
SELECT (SELECT coalesce(max(v), 0) FROM broad_inner r WHERE r.k=o.k AND r.k2=o.k2)
FROM broad_outer o WHERE o.sel<>7;
----
physical_plan	<REGEX>:[\s\S]*"Join Type": "(RIGHT_)?SEMI"[\s\S]*

query III
SELECT count(*), sum(c), sum(m) FROM (
    SELECT (SELECT count(*) FROM broad_inner r WHERE r.k=o.k AND r.k2=o.k2) AS c,
           (SELECT coalesce(max(v), 0) FROM broad_inner r WHERE r.k=o.k AND r.k2=o.k2) AS m
    FROM broad_outer o WHERE o.sel<>7
);
----
29700	29700	178206

