# Tuple containment cannot be established from independent sets of column bindings.
query II
WITH source AS MATERIALIZED (SELECT * FROM nullable_outer WHERE id<>7),
domain AS MATERIALIZED (SELECT DISTINCT k,k2 FROM source)
SELECT count(*),sum(coalesce(p.c,0)) FROM source o JOIN (
    SELECT d.k,d.k2,a.c FROM domain d LEFT JOIN (
        SELECT r.k,r.k2,count(*) c FROM nullable_inner r
        SEMI JOIN (SELECT DISTINCT k2 AS a,k AS b FROM source) keys
        ON r.k IS NOT DISTINCT FROM keys.a AND r.k2 IS NOT DISTINCT FROM keys.b GROUP BY r.k,r.k2
    ) a ON d.k IS NOT DISTINCT FROM a.k AND d.k2 IS NOT DISTINCT FROM a.k2
) p ON o.k IS NOT DISTINCT FROM p.k AND o.k2 IS NOT DISTINCT FROM p.k2;
----
119999	1379788

# Empty input values are recovered for every outer row.
query II
SELECT count(*),sum(c) FROM (
    SELECT (SELECT coalesce(sum(k),0) FROM nullable_inner r WHERE false AND r.k=o.k AND r.k2=o.k2) c
    FROM nullable_outer o
);
----
120000	0

# An additional reader keeps the key-domain producer live and makes its restriction worth retaining.
statement ok
CREATE TABLE reader_outer AS SELECT i AS id, i%500 AS k, (i//500)%3 AS k2 FROM range(20000) t(i);

statement ok
CREATE TABLE reader_inner AS SELECT i%4000 AS k, (i//4000)%3 AS k2 FROM range(12000) t(i);

statement ok
CREATE VIEW reader_released AS
WITH source AS MATERIALIZED (SELECT * FROM reader_outer WHERE id<>7),
domain AS MATERIALIZED (SELECT DISTINCT k,k2 FROM source)
SELECT count(*) AS n, sum(coalesce(p.c,0)) AS total
FROM source o JOIN (
    SELECT d.k,d.k2,a.c FROM domain d LEFT JOIN (
        SELECT r.k,r.k2,count(*) c FROM reader_inner r SEMI JOIN domain keys
        ON r.k=keys.k AND r.k2=keys.k2 GROUP BY r.k,r.k2
    ) a ON d.k=a.k AND d.k2=a.k2
) p ON o.k IS NOT DISTINCT FROM p.k AND o.k2 IS NOT DISTINCT FROM p.k2;

query II
SELECT * FROM reader_released;
----
19999	19999

query II
EXPLAIN (FORMAT JSON) SELECT * FROM reader_released;
----
physical_plan	<!REGEX>:[\s\S]*"Join Type": "(RIGHT_)?SEMI"[\s\S]*

statement ok
CREATE VIEW reader_shared AS
WITH source AS MATERIALIZED (SELECT * FROM reader_outer WHERE id<>7),
domain AS MATERIALIZED (SELECT DISTINCT k,k2 FROM source)
SELECT count(*) AS n, sum(coalesce(p.c,0)) AS total, (SELECT count(*) FROM domain) AS domain_rows
FROM source o JOIN (
    SELECT d.k,d.k2,a.c FROM domain d LEFT JOIN (
        SELECT r.k,r.k2,count(*) c FROM reader_inner r SEMI JOIN domain keys
        ON r.k=keys.k AND r.k2=keys.k2 GROUP BY r.k,r.k2
    ) a ON d.k=a.k AND d.k2=a.k2
) p ON o.k IS NOT DISTINCT FROM p.k AND o.k2 IS NOT DISTINCT FROM p.k2;

query III
SELECT * FROM reader_shared;
----
19999	19999	1500

query II
EXPLAIN (FORMAT JSON) SELECT * FROM reader_shared;
----
physical_plan	<REGEX>:[\s\S]*"Join Type": "(RIGHT_)?SEMI"[\s\S]*

statement ok
DROP VIEW reader_released;

statement ok
DROP VIEW reader_shared;

statement ok
DROP TABLE reader_outer;

statement ok
DROP TABLE reader_inner;
