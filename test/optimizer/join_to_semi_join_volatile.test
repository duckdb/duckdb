# a materialized CTE whose definition is volatile: as the relation the predicates read
statement ok
create or replace sequence seq;

query I rowsort
with d as materialized (select lo, nextval('seq') as n from p) select distinct a.x from a, d where a.y > d.n;
----
1
2
3
6
7
NULL

# the sequence was advanced once per row of the CTE
query I
select nextval('seq');
----
8

# and as the relation they filter
statement ok
create or replace sequence seq;

query I rowsort
with d as materialized (select x, y, nextval('seq') as n from a) select distinct d.x from d, p where d.n > p.lo;
----
0
1
2
3
4
6
7
NULL

# the sequence was advanced once per row of the CTE
query I
select nextval('seq');
----
11

endloop

statement ok
RESET disabled_optimizers;
