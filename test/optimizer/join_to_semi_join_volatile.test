# a volatile condition of an outer join above the region
statement ok
create or replace sequence seq;

query I rowsort
select distinct t.x from (select a.x from a, p where a.y > p.lo) t left join b on t.x = b.x and nextval('seq') > 0;
----
1
2
3
6
7
NULL

# the sequence was advanced as often as without the optimizer
query I
select nextval('seq');
----
1

# a volatile condition of the SEMI join whose right side the region is
statement ok
create or replace sequence seq;

query II rowsort
select * from b where exists (select 1 from a, p where a.y > p.lo and a.x = b.x and nextval('seq') > 0);
----
1	1
2	0
2	2
3	NULL
7	0
7	0

# the sequence was advanced as often as without the optimizer
query I
select nextval('seq');
----
34

# a volatile filter on the other side of an IN: the right side is read as a set, the left side is untouched
statement ok
create or replace sequence seq;

query II rowsort
select * from b where nextval('seq') > 0 and b.x in (select a.x from a, p where a.y > p.lo);
----
1	1
2	0
2	2
3	NULL
7	0
7	0

# the sequence was advanced as often as without the optimizer
query I
select nextval('seq');
----
