# UNION above
query I rowsort
select a.x from a, p where a.y > p.lo union select x from b where x > 100;
----
1
2
3
6
7
NULL

# the right side of NOT IN, with NULLs
query II rowsort
select * from b where b.x not in (select a.x from a, p where a.y > p.hi);
----

# the right side of IN
query II rowsort
select * from b where b.x in (select a.x from a, p where a.y > p.hi);
----
1	1
2	0
2	2
3	NULL
7	0
7	0

# a correlated EXISTS
query II rowsort
select * from b where exists (select 1 from a, p where a.y > p.hi and a.x = b.x);
----
1	1
2	0
2	2
3	NULL
7	0
7	0

# a scalar subquery of max
query II rowsort
select b.x, (select max(a.y) from a, p where a.y > p.lo and a.x = b.x) from b;
----
0	NULL
1	10
2	20
2	20
3	30
5	NULL
7	75
7	75
9	NULL
NULL	NULL

# a scalar subquery that counts
query II rowsort
select b.x, (select count(*) from a, p where a.y > p.lo and a.x = b.x) from b;
----
0	0
1	1
2	4
2	4
3	4
5	0
7	10
7	10
9	0
NULL	0

# read by a correlated subquery
query I rowsort
select distinct a.x from a, p where a.y > p.lo and exists (select 1 from b where b.x = p.hi - 34);
----
2
3
6
7
NULL

# read by a lateral join
query I rowsort
select distinct a.x from a, p, lateral (select b.z from b where b.x < p.lo) l where a.y > p.lo;
----
2
3
6
7
NULL

# two unread relations filter the same one
query I rowsort
select distinct a.x from a, p, q where a.y > p.lo and a.y < q.hi;
----
1
2

# an unread relation filters another unread one
query I rowsort
select distinct a.x from a, p, q where a.y > p.lo and p.hi > q.lo;
----
2
3
6
7
NULL

# two unread relations and an empty one
query I rowsort
select distinct a.x from a, p, e where a.y > p.lo and a.y < e.hi;
----

# the filtered relation has duplicates and NULLs: count(*) above a DISTINCT subquery
query I rowsort
select count(*) from (select distinct a.x, a.y from a, p where a.y between p.lo and p.hi) t;
----
3

# a materialized CTE read twice
query I rowsort
with m as materialized (select a.x from a, p where a.y > p.lo) select count(*) from m m1, m m2 where m1.x = m2.x;
----
149

# a FULL join above
query II rowsort
select distinct t.x, b.x from (select a.x from a, p where a.y > p.lo) t full join b on t.x = b.x;
----
1	1
2	2
3	3
6	NULL
7	7
NULL	0
NULL	5
NULL	9
NULL	NULL

# a volatile predicate of the region is evaluated once per row of the region
statement ok
create or replace sequence seq;

query I
select count(*) from (select distinct a.x from a, p where a.y > p.lo and nextval('seq') > 0);
----
6

query I
select nextval('seq');
----
28

endloop

statement ok
RESET disabled_optimizers;
