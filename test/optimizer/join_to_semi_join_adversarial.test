# name: test/optimizer/join_to_semi_join_adversarial.test
# description: Shapes that match the join_to_semi_join pattern while breaking one of its preconditions: same result with the optimizer on and off
# group: [optimizer]

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

statement ok
create table a as select * from (values (0, 0), (1, 10), (2, 20), (2, 20), (3, 30), (4, NULL), (NULL, 50), (6, 60), (7, 70), (7, 75)) t(x, y);

statement ok
create table b as select * from (values (0, 0), (1, 1), (2, 2), (2, 0), (3, NULL), (NULL, 1), (5, 2), (7, 0), (7, 0), (9, 1)) t(x, z);

statement ok
create table p as select * from (values (15, 35), (25, 45), (25, 45), (200, 300), (NULL, 50), (60, NULL), (0, 0)) t(lo, hi);

statement ok
create table q as select * from (values (5, 25), (NULL, NULL)) t(lo, hi);

statement ok
create table e (lo integer, hi integer);

statement ok
create table s as select * from (values ('1'), ('20'), ('x'), (NULL)) t(v);

# an empty relation: no row either way
query II
explain select distinct a.x from a, e where a.y > e.lo;
----
physical_plan	<REGEX>:.*Join Type: SEMI.*

# an empty relation, no predicate: stays a cross product
query II
explain select distinct a.x from a, e;
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# an empty relation below min / max
query II
explain select min(a.x), max(a.y) from a, e where a.y > e.lo or a.x < e.hi;
----
physical_plan	<REGEX>:.*Join Type: SEMI.*

# NULL bounds only
query II
explain select distinct a.x from a, (select * from q where lo is null) r where a.y > r.lo or a.y < r.hi;
----
physical_plan	<REGEX>:.*Join Type: SEMI.*

# a one-row constant: exactly one row, count(*) may see it
query II
explain select b.z, count(*) from a join b on a.x = b.x, (select 15 as lo, 35 as hi) r where a.y < r.lo or a.y > r.hi group by b.z;
----
physical_plan	<REGEX>:.*Join Type: SEMI.*

# a one-row constant with a NULL
query II
explain select b.z, count(*) from a join b on a.x = b.x, (select NULL::integer as lo, 35 as hi) r where a.y < r.lo or a.y > r.hi group by b.z;
----
physical_plan	<REGEX>:.*Join Type: SEMI.*

# not one row: a constant behind a filter that drops it
query II
explain select b.z, count(*) from a join b on a.x = b.x, (select 15 as lo, 35 as hi where 1 = 0) r where a.y < r.lo or a.y > r.hi group by b.z;
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# not one row: a constant behind a filter that keeps it
query II
explain select b.z, count(*) from a join b on a.x = b.x, (select 15 as lo, 35 as hi where (select count(*) from e) = 0) r where a.y < r.lo or a.y > r.hi group by b.z;
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# not one row: a constant built from scalar subqueries, one of them over an empty table
query II
explain select b.z, count(*) from a join b on a.x = b.x, (select (select max(lo) from e) as lo, (select max(hi) from p) as hi) r where a.y < r.lo or a.y > r.hi group by b.z;
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# not one row: VALUES with one row
query II
explain select b.z, count(*) from a join b on a.x = b.x, (values (15, 35)) r(lo, hi) where a.y < r.lo or a.y > r.hi group by b.z;
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# not one row: VALUES with duplicates
query II
explain select b.z, count(*) from a join b on a.x = b.x, (values (15, 35), (15, 35)) r(lo, hi) where a.y < r.lo or a.y > r.hi group by b.z;
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# not one row: an ungrouped aggregate over an empty table (one row of NULLs)
query II
explain select b.z, count(*) from a join b on a.x = b.x, (select min(lo) as lo, max(hi) as hi from e) r where a.y < r.lo or a.y > r.hi group by b.z;
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# not one row: an ungrouped aggregate with a HAVING that drops its row
query II
explain select b.z, count(*) from a join b on a.x = b.x, (select min(lo) as lo, max(hi) as hi from p having count(*) > 100) r where a.y < r.lo or a.y > r.hi group by b.z;
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# not one row: a scan with a filter on a unique value
query II
explain select b.z, count(*) from a join b on a.x = b.x, (select lo, hi from p where lo = 15) r where a.y < r.lo or a.y > r.hi group by b.z;
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# a one-row constant and no third relation
query II
explain select a.x, count(*) from a, (select 15 as lo, 35 as hi) r where a.y < r.lo or a.y > r.hi group by a.x;
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# predicates that are NULL
query II
explain select distinct a.x from a, p where a.y is distinct from p.lo;
----
physical_plan	<REGEX>:.*Join Type: SEMI.*

# predicates that are NULL: IS NOT TRUE keeps them
query II
explain select distinct a.x from a, p where (a.y > p.lo) is not true;
----
physical_plan	<REGEX>:.*Join Type: SEMI.*

# predicates that are NULL: NOT
query II
explain select distinct a.x from a, p where not (a.y <= p.hi);
----
physical_plan	<REGEX>:.*Join Type: SEMI.*

# predicates that are NULL: CASE
query II
explain select distinct a.x from a, p where case when p.lo is null then a.y > 20 else a.y > p.lo end;
----
physical_plan	<REGEX>:.*Join Type: SEMI.*

# a predicate on the relation alone goes with it
query II
explain select distinct a.x from a, p where a.y > p.lo and p.hi < 50;
----
physical_plan	<REGEX>:.*Join Type: SEMI.*

# a predicate that can throw is not moved: a cast of a string
query II
explain select distinct a.x from a, s where a.y > try_cast(s.v as integer) and a.x < cast(s.v as integer) and s.v <> 'x';
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# a predicate that can throw is not moved: arithmetic
query II
explain select distinct a.x from a, p where a.y > p.lo + 5;
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# a volatile predicate anywhere in the region
query II
explain select distinct a.x from a, p where a.y > p.lo and random() < 2;
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# the relation inside an OR with a third relation
query II
explain select distinct a.x from a, b, p where a.x = b.x and (a.y > p.lo or b.z > p.hi);
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# the relation compared with two relations
query II
explain select distinct a.x from a, b, p where a.x = b.x and a.y > p.lo and b.z < p.hi;
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# read by the condition of an outer join above
query II
explain select distinct a.x from (a cross join p) left join b on b.x = p.lo where a.y > p.lo;
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# read by the condition of an outer join in the region's place
query II
explain select distinct a.x from a left join p on a.y > p.lo;
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# read by a filter above a subquery
query II
explain select distinct x from (select a.x, p.hi from a, p where a.y > p.lo) t where hi > 40;
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# read by an aggregate
query II
explain select a.x, max(p.hi) from a, p where a.y > p.lo group by a.x;
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# read by the FILTER of an aggregate
query II
explain select a.x, max(a.y) filter (where p.hi > 40) from a, p where a.y > p.lo group by a.x;
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# read by a group
query II
explain select p.hi, max(a.y) from a, p where a.y > p.lo group by p.hi;
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# min / max with a FILTER ignore duplicates
query II
explain select a.x, max(a.y) filter (where a.y > 10), min(a.y) from a, p where a.y > p.lo group by a.x;
----
physical_plan	<REGEX>:.*Join Type: SEMI.*

# count(DISTINCT) ignores duplicates
query II
explain select a.x, count(distinct a.y) from a, p where a.y > p.lo group by a.x;
----
physical_plan	<REGEX>:.*Join Type: SEMI.*

# count(DISTINCT) next to count(*)
query II
explain select a.x, count(distinct a.y), count(*) from a, p where a.y > p.lo group by a.x;
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# sum sees the repeated rows
query II
explain select a.x, sum(a.y) from a, p where a.y > p.lo group by a.x;
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# an ordered aggregate sees the repeated rows
query II
explain select a.x, string_agg(a.y::varchar, '|' order by a.y) from a, p where a.y > p.lo group by a.x;
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# grouping sets of min / max
query II
explain select a.x, a.y, max(a.y) from a, p where a.y > p.lo group by rollup (a.x, a.y);
----
physical_plan	<REGEX>:.*Join Type: SEMI.*

# HAVING on count(*)
query II
explain select a.x from a, p where a.y > p.lo group by a.x having count(*) > 2;
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# HAVING on max
query II
explain select a.x from a, p where a.y > p.lo group by a.x having max(a.y) > 20;
----
physical_plan	<REGEX>:.*Join Type: SEMI.*

# a window between the region and the DISTINCT
query II
explain select distinct x, rn from (select a.x, row_number() over (partition by a.x order by a.y) as rn from a, p where a.y > p.lo) t;
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# a LIMIT between the region and the DISTINCT
query II
explain select distinct x from (select a.x from a, p where a.y > p.lo order by all limit 7) t;
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# UNION ALL above
query II
explain select count(*) from (select a.x from a, p where a.y > p.lo union all select x from b) t;
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# the right side of NOT IN, with NULLs
query II
explain select * from b where b.x not in (select a.x from a, p where a.y > p.hi);
----
physical_plan	<REGEX>:.*Join Type: SEMI.*

# the right side of IN
query II
explain select * from b where b.x in (select a.x from a, p where a.y > p.hi);
----
physical_plan	<REGEX>:.*Join Type: SEMI.*

# a scalar subquery that counts
query II
explain select b.x, (select count(*) from a, p where a.y > p.lo and a.x = b.x) from b;
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# read by a correlated subquery
query II
explain select distinct a.x from a, p where a.y > p.lo and exists (select 1 from b where b.x = p.hi - 34);
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# read by a lateral join
query II
explain select distinct a.x from a, p, lateral (select b.z from b where b.x < p.lo) l where a.y > p.lo;
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# two unread relations filter the same one
query II
explain select distinct a.x from a, p, q where a.y > p.lo and a.y < q.hi;
----
physical_plan	<REGEX>:.*Join Type: SEMI.*

# an unread relation filters another unread one
query II
explain select distinct a.x from a, p, q where a.y > p.lo and p.hi > q.lo;
----
physical_plan	<REGEX>:.*Join Type: SEMI.*

# two unread relations and an empty one
query II
explain select distinct a.x from a, p, e where a.y > p.lo and a.y < e.hi;
----
physical_plan	<REGEX>:.*Join Type: SEMI.*

# the filtered relation has duplicates and NULLs: count(*) above a DISTINCT subquery
query II
explain select count(*) from (select distinct a.x, a.y from a, p where a.y between p.lo and p.hi) t;
----
physical_plan	<REGEX>:.*Join Type: SEMI.*

# a materialized CTE read twice
query II
explain with m as materialized (select a.x from a, p where a.y > p.lo) select count(*) from m m1, m m2 where m1.x = m2.x;
----
physical_plan	<!REGEX>:.*Join Type: SEMI.*

# the results, with the optimizer on and off
# ('extension' disables nothing that is used here: that is the run with the optimizer on)
foreach disabled extension join_to_semi_join

statement ok
SET disabled_optimizers = '{disabled}';

# an empty relation: no row either way
query I rowsort
select distinct a.x from a, e where a.y > e.lo;
