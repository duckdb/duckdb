# a materialized CTE that is defined above the join and read by the inner side stays a reference: the join stays, and
# so does the CTE for its other readers
query II
EXPLAIN WITH g AS MATERIALIZED (SELECT k, max(v) AS m FROM d WHERE v > 2 GROUP BY k) SELECT sum(f.x), count(*), (SELECT count(*) FROM g) FROM f LEFT JOIN g ON f.k = g.k;
----
