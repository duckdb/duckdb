EXPLAIN SELECT sum(f.x), count(*) FROM f LEFT JOIN (WITH c AS MATERIALIZED (SELECT k, v FROM d WHERE v > 2) SELECT a.k FROM (SELECT k FROM c GROUP BY k) a JOIN (SELECT k FROM c GROUP BY k) b ON a.k = b.k) g ON f.k = g.k;
----
