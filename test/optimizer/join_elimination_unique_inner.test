# name: test/optimizer/join_elimination_unique_inner.test
# description: Outer joins with an unread inner side that is distinct on the join keys are eliminated
# group: [optimizer]

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

statement ok
CREATE TABLE f(k INTEGER, k2 INTEGER, x INTEGER);

statement ok
INSERT INTO f VALUES (1, 1, 10), (1, 1, 11), (2, 1, 12), (2, 2, 13), (3, NULL, 14), (NULL, 1, 15), (NULL, NULL, 16), (4, 4, 17), (5, 1, 18);

statement ok
CREATE TABLE d(k INTEGER, k2 INTEGER, v INTEGER);

statement ok
INSERT INTO d VALUES (1, 1, 1), (1, 1, 2), (1, 2, 3), (2, 1, 4), (2, 1, 5), (3, NULL, 6), (3, NULL, 7), (NULL, 1, 8), (NULL, 1, 9), (NULL, NULL, 10), (NULL, NULL, 11), (5, 5, 12);

statement ok
CREATE TABLE pk(k INTEGER PRIMARY KEY, v INTEGER);

statement ok
INSERT INTO pk VALUES (1, 1), (2, 2), (3, 3), (5, 5);

statement ok
CREATE TABLE pk2(k INTEGER, k2 INTEGER, v INTEGER, PRIMARY KEY (k, k2));

statement ok
INSERT INTO pk2 VALUES (1, 1, 1), (1, 2, 2), (2, 1, 3), (5, 5, 4);

# the inner side is grouped by the join key: every outer row finds at most one match, so the join returns exactly its
# outer rows, whatever reads them. A filter on the inner side, pushed into the scan or not, only removes inner rows
query II
EXPLAIN SELECT sum(f.x), count(*) FROM f LEFT JOIN (SELECT k, max(v) AS m FROM d WHERE v > 2 GROUP BY k) g ON f.k = g.k;
----
physical_plan	<!REGEX>:.*JOIN.*

query II
SELECT sum(f.x), count(*) FROM f LEFT JOIN (SELECT k, max(v) AS m FROM d WHERE v > 2 GROUP BY k) g ON f.k = g.k;
----
126	9

