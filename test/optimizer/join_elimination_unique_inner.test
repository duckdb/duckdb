# an aggregate with DISTINCT and other aggregates is planned as two aggregates over a shared materialized input that
# are joined on the groups. The result is still distinct on the groups, so the join to it is removed with it
query II
EXPLAIN SELECT sum(f.x), count(*) FROM f LEFT JOIN (SELECT k, count(DISTINCT v) AS c, sum(v) AS s FROM d GROUP BY k) g ON f.k = g.k;
