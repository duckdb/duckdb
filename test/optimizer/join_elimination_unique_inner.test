# NULL keys: the inner side has at most one row per key, NULLs included. = never matches it, IS NOT DISTINCT FROM
# matches exactly one row; a composite key may mix the two
query II
EXPLAIN SELECT sum(f.x), count(*) FROM f LEFT JOIN (SELECT k, max(v) AS m FROM d WHERE v > 2 GROUP BY k) g ON f.k IS NOT DISTINCT FROM g.k;
----
