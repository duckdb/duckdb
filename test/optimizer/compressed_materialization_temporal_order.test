# name: test/optimizer/compressed_materialization_temporal_order.test
# description: Only skip payload compression for bounded single-vector sorts on temporal keys
# group: [optimizer]

statement ok
SET explain_output = 'OPTIMIZED_ONLY'

statement ok
CREATE TABLE events AS
SELECT DATE '2024-01-01' + (i % 13)::INTEGER AS d, i % 17 AS p, i::VARCHAR AS label
FROM range(current_setting('standard_vector_size')::BIGINT) t(i)

# At the vector boundary, the temporal sort can carry the original integer payload.
query TT
EXPLAIN SELECT p FROM events ORDER BY d
----
logical_opt	<!REGEX>:.*TINYINT.*

# An integer sort key or string payload still takes the regular compression path.
query TT
EXPLAIN SELECT p FROM events ORDER BY d, p
----
logical_opt	<REGEX>:.*TINYINT.*

query TT
EXPLAIN SELECT p, label FROM events ORDER BY d
----
logical_opt	<REGEX>:.*TINYINT.*

statement ok
INSERT INTO events VALUES (NULL, NULL, NULL)

# The same temporal sort crosses the boundary when one more row is visible.
query TT
EXPLAIN SELECT p FROM events ORDER BY d
----
logical_opt	<REGEX>:.*TINYINT.*
