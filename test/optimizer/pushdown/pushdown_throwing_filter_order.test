# name: test/optimizer/pushdown/pushdown_throwing_filter_order.test
# description: A filter that can throw stays above a table scan with other filters, since the scan reorders them
# group: [pushdown]

statement ok
CREATE TABLE t(id VARCHAR, s VARCHAR, g GEOMETRY, i INTEGER);

statement ok
INSERT INTO t VALUES ('bad', 'x', 'POINT(0 0)', 0), ('2', 'keep', 'POINT(2 2)', 2);

# the cast never runs on the row the other filter removes
query I
SELECT count(*) FROM t WHERE s LIKE '%ee%' AND id::INT = 2
----
1

query I
SELECT count(*) FROM t WHERE g && 'POINT(2 2)'::GEOMETRY AND id::INT = 2
----
1

query I
SELECT count(*) FROM t WHERE i = 2 AND id::INT = 2
----
1

query I
SELECT count(*) FROM t WHERE i + 1 = 3 AND s LIKE '%ee%' AND id::INT = 2
----
1

# the filters that cannot throw are still pushed into the scan
query II
EXPLAIN SELECT count(*) FROM t WHERE s LIKE '%ee%' AND id::INT = 2
----
physical_plan	<REGEX>:[\s\S]*Filter ─[\s\S]*Expression: CAST\(id AS INTEGER\) = 2[\s\S]*Filters: contains\(s, 'ee'\)[\s\S]*

query II
EXPLAIN SELECT count(*) FROM t WHERE i = 2 AND id::INT = 2
----
physical_plan	<REGEX>:[\s\S]*Filter ─[\s\S]*Expression: CAST\(id AS INTEGER\) = 2[\s\S]*Filters: i = 2[\s\S]*

# a filter that can throw is pushed when it is the only one
query II
EXPLAIN SELECT count(*) FROM t WHERE id::INT = 2
----
physical_plan	<!REGEX>:[\s\S]*Filter ─[\s\S]*

statement error
SELECT count(*) FROM t WHERE id::INT = 2
----
Could not convert string 'bad' to INT32

query I
SELECT count(*) FROM t WHERE TRY_CAST(id AS INT) = 2 AND s LIKE '%ee%'
----
1
