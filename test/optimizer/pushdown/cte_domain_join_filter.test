# name: test/optimizer/pushdown/cte_domain_join_filter.test
# description: Join key sets restrict nested recursive CTE inputs
# group: [pushdown]

require json

statement ok
SET max_execution_time=10000;

statement ok
CREATE TABLE person(id BIGINT PRIMARY KEY, selected BOOLEAN);

statement ok
INSERT INTO person SELECT i, i IN (3,17,51) FROM range(1000) t(i);

statement ok
CREATE VIEW nested_walk AS
SELECT *
FROM (
    SELECT o.id, o.selected, q.x
    FROM person o,
    LATERAL (
        SELECT r.x
        FROM person i,
        LATERAL (
            WITH RECURSIVE walk(x) USING KEY(x) AS (
                SELECT i.id
                UNION
                SELECT w.x + 1
                FROM walk w
                WHERE w.x < i.id + 2
                  AND NOT EXISTS (
                      SELECT 1
                      FROM recurring.walk visited
                      WHERE visited.x = w.x + 1
                  )
            )
            SELECT max(x) AS x FROM walk
        ) r
        WHERE i.id = o.id
        UNION ALL
        SELECT -1
    ) q
) result
;

statement ok
CREATE MACRO recursive_rows() AS (
    SELECT sum((value->>'intermediate_rows')::BIGINT)
    FROM read_text('{TEST_DIR}/cte_domain_join_filter.json'), json_tree(content)
    WHERE value->>'type'='RECURSIVE_CTE'
);

statement ok
CREATE MACRO semi_joins() AS (
    SELECT count(*) FROM read_text('{TEST_DIR}/cte_domain_join_filter.json'), json_tree(content)
    WHERE (value->'extra_info')->>'Join Type'='SEMI'
);

statement ok
PRAGMA enable_profiling='json';

statement ok
SET profiling_output='{TEST_DIR}/cte_domain_join_filter.json';

# One outer key

statement ok
PRAGMA enable_profiling='json';

query I
SELECT max(x) FROM nested_walk WHERE id=3;
----
5

statement ok
PRAGMA disable_profiling;

query I
SELECT recursive_rows();
----
3

# Sparse multi-row key set

statement ok
PRAGMA enable_profiling='json';

query III
SELECT count(*), sum(x), max(x) FROM nested_walk WHERE selected;
----
6	74	53

statement ok
PRAGMA disable_profiling;

query I
SELECT recursive_rows();
----
9

query I
SELECT semi_joins();
----
1

# An unselective source does not introduce a semijoin

statement ok
PRAGMA enable_profiling='json';

query II
SELECT count(*),sum(x) FROM nested_walk;
----
2000	500500

statement ok
PRAGMA disable_profiling;

query I
SELECT recursive_rows();
----
3000

query I
SELECT semi_joins();
----
0

# Many duplicate source keys still require scanning and building a large source.
statement ok
CREATE VIEW plain_walk AS
SELECT i.id,r.x FROM person i, LATERAL (
    WITH RECURSIVE walk(x) USING KEY(x) AS (
        SELECT i.id UNION SELECT x+1 FROM walk WHERE x<i.id+2
    ) SELECT max(x) x FROM walk
) r;

statement ok
PRAGMA enable_profiling='json';

query II
WITH heavy AS MATERIALIZED (SELECT id FROM person, range(500) WHERE selected)
SELECT count(*),sum(q.x) FROM heavy o JOIN plain_walk q ON o.id=q.id;
----
1500	38500

statement ok
PRAGMA disable_profiling;

query II
SELECT recursive_rows(),semi_joins();
----
3000	0

# An independently observed materialized result cannot be restricted for just one reader.
statement ok
PRAGMA enable_profiling='json';

query III
WITH o AS MATERIALIZED (SELECT id FROM person WHERE selected),
     q AS MATERIALIZED (SELECT * FROM plain_walk)
SELECT count(*),sum(q.x),(SELECT sum(x) FROM q) FROM o JOIN q ON o.id=q.id;
----
3	77	501500

statement ok
PRAGMA disable_profiling;

query II
SELECT recursive_rows(),semi_joins();
----
3000	0

# DISTINCT ON must choose its representative before the ancestor join restricts keys.
statement ok
ALTER TABLE person ADD COLUMN grp INTEGER DEFAULT 0;

query II
EXPLAIN WITH o AS MATERIALIZED (SELECT id FROM person WHERE selected)
SELECT count(*) FROM o JOIN (
    SELECT DISTINCT ON (i.grp) i.id,r.x FROM person i, LATERAL (
        WITH RECURSIVE walk(x) AS (
            SELECT i.id UNION ALL SELECT x+1 FROM walk WHERE x<i.id+2
        ) SELECT max(x) x FROM walk
    ) r
) q ON o.id=q.id;
----
physical_plan	<!REGEX>:[\s\S]*Join Type: SEMI[\s\S]*

# Disabling the coordinating pass must retain all recursive partitions.
statement ok
SET disabled_optimizers='cte_filter_pusher';

statement ok
PRAGMA enable_profiling='json';

query I
SELECT max(x) FROM nested_walk WHERE id=3;
----
5

statement ok
PRAGMA disable_profiling;

query I
SELECT recursive_rows();
----
3000

statement ok
RESET disabled_optimizers;

statement ok
RESET max_execution_time;
