query I
SELECT (
    SELECT count(*)
    FROM state_events e
    ASOF LEFT JOIN state_thresholds t ON e.k = t.k AND e.ts >= t.ts
    WHERE e.k = d.k
)
FROM (VALUES (2)) o(k)
JOIN (
    SELECT k FROM state_domain WHERE selected GROUP BY k
) d ON o.k = d.k;
----
