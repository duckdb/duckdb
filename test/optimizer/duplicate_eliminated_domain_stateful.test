# A domain-dependent UNNEST with potentially throwing list construction takes
# the exact-domain fallback and still keeps generated rows isolated.
query I
SELECT (
    SELECT sum(x)
    FROM UNNEST([d.k, d.k + 1]) values(x)
)
FROM (VALUES (2)) o(k)
JOIN (
    SELECT k FROM state_domain WHERE selected GROUP BY k
) d ON o.k = d.k;
----
5

statement ok
SET debug_verify_aggregate_state_export=false;

query II
EXPLAIN
SELECT (
    SELECT sum(x)
    FROM UNNEST([d.k, d.k + 1]) values(x)
)
FROM state_plan_outer o
JOIN (
    SELECT k FROM state_domain WHERE selected GROUP BY k
) d ON o.k = d.k;
----
logical_opt	<REGEX>:.*__duckdb_delim_[0-9]+.*

statement ok
SET debug_verify_aggregate_state_export=getvariable('dedup_original_verify_aggregate_state_export');

# Every grouping set must include the duplicate-eliminated key.
query I
SELECT (
    SELECT sum(group_count)
    FROM (
        SELECT count(*) group_count
        FROM state_values s
        WHERE s.k = d.k
        GROUP BY GROUPING SETS ((s.v), ())
    ) grouped
)
FROM (VALUES (2)) o(k)
JOIN (
    SELECT k FROM state_domain WHERE selected GROUP BY k
) d ON o.k = d.k;
----
4

statement ok
SET debug_verify_aggregate_state_export=false;

query II
EXPLAIN
SELECT (
    SELECT sum(group_count)
    FROM (
        SELECT count(*) group_count
        FROM state_values s
        WHERE s.k = d.k
        GROUP BY GROUPING SETS ((s.v), ())
    ) grouped
)
FROM state_plan_outer o
JOIN (
    SELECT k FROM state_domain WHERE selected GROUP BY k
) d ON o.k = d.k;
----
logical_opt	<REGEX>:.*__duckdb_duplicate_eliminated_factor_.*

statement ok
SET debug_verify_aggregate_state_export=getvariable('dedup_original_verify_aggregate_state_export');

# A materialized CTE must carry the active key through its definition and references.
query I
SELECT (
    WITH materialized_values AS MATERIALIZED (
        SELECT v FROM state_values s WHERE s.k = d.k
    )
    SELECT sum(v) FROM materialized_values
)
FROM (VALUES (2)) o(k)
JOIN (
    SELECT k FROM state_domain WHERE selected GROUP BY k
) d ON o.k = d.k;
----
30

statement ok
SET debug_verify_aggregate_state_export=false;

