# Non-inner joins must match rows independently for each duplicate-eliminated key.
query I
SELECT (
    SELECT count(*)
    FROM state_values a
    FULL JOIN state_extra b ON a.k = b.k AND a.v = b.v
    WHERE coalesce(a.k, b.k) = d.k
)
FROM (VALUES (2)) o(k)
JOIN (
    SELECT k FROM state_domain WHERE selected GROUP BY k
) d ON o.k = d.k;
----
3

statement ok
SET debug_verify_aggregate_state_export=false;

query II
EXPLAIN
SELECT (
    SELECT count(*)
    FROM state_values a
    FULL JOIN state_extra b ON a.k = b.k AND a.v = b.v
    WHERE coalesce(a.k, b.k) = d.k
)
FROM state_plan_outer o
JOIN (
    SELECT k FROM state_domain WHERE selected GROUP BY k
) d ON o.k = d.k;
----
logical_opt	<REGEX>:.*__duckdb_duplicate_eliminated_factor_.*

statement ok
