# name: test/optimizer/duplicate_eliminated_domain_stateful.test
# description: Preserve domain isolation across stateful operators when factoring a safe-superset domain
# group: [optimizer]

statement ok
PRAGMA explain_output=optimized_only;

statement ok
SET VARIABLE dedup_original_verify_aggregate_state_export = current_setting('debug_verify_aggregate_state_export');

statement ok
CREATE TABLE state_domain(k INTEGER, selected BOOLEAN);

statement ok
INSERT INTO state_domain VALUES (2, true), (4, true);

statement ok
CREATE TABLE state_plan_outer(k INTEGER);

statement ok
INSERT INTO state_plan_outer SELECT 2 FROM range(100);

statement ok
CREATE TABLE state_values(k INTEGER, v INTEGER);

statement ok
INSERT INTO state_values VALUES (2, 10), (2, 20), (4, 40);

statement ok
CREATE TABLE state_extra(k INTEGER, v INTEGER);

statement ok
INSERT INTO state_extra VALUES (2, 20), (2, 30), (4, 50);

statement ok
CREATE TABLE state_events(k INTEGER, ts INTEGER);

statement ok
INSERT INTO state_events VALUES (2, 5), (2, 15), (4, 5);

statement ok
CREATE TABLE state_thresholds(k INTEGER, ts INTEGER);

statement ok
INSERT INTO state_thresholds VALUES (2, 1), (2, 10), (4, 1);

# The grouped source contains k=4, but the outer join only emits k=2. It therefore
# forces a factored safe-superset domain for each correlated subquery below.

# Windows must partition independently for every duplicate-eliminated key.
query I
SELECT (
    SELECT max(rn)
    FROM (
        SELECT row_number() OVER (ORDER BY v) rn
        FROM state_values s
        WHERE s.k = d.k
    ) windowed
)
FROM (VALUES (2)) o(k)
JOIN (
    SELECT k
    FROM state_domain
    WHERE selected
    GROUP BY k
) d ON o.k = d.k;
----
2

statement ok
SET debug_verify_aggregate_state_export=false;

query II
EXPLAIN
SELECT (
    SELECT max(rn)
    FROM (
        SELECT row_number() OVER (ORDER BY v) rn
        FROM state_values s
        WHERE s.k = d.k
    ) windowed
)
FROM state_plan_outer o
JOIN (
    SELECT k
    FROM state_domain
    WHERE selected
    GROUP BY k
) d ON o.k = d.k;
----
logical_opt	<REGEX>:.*__duckdb_duplicate_eliminated_factor_.*Window.*

statement ok
SET debug_verify_aggregate_state_export=getvariable('dedup_original_verify_aggregate_state_export');

# Set operations must compare rows only within the same key domain.
query I
SELECT (
    SELECT count(*)
    FROM (
        SELECT v FROM state_values s WHERE s.k = d.k
        UNION
        SELECT v FROM state_extra e WHERE e.k = d.k
    ) unioned
)
FROM (VALUES (2)) o(k)
JOIN (
    SELECT k FROM state_domain WHERE selected GROUP BY k
) d ON o.k = d.k;
----
3

statement ok
SET debug_verify_aggregate_state_export=false;

query II
EXPLAIN
SELECT (
    SELECT count(*)
    FROM (
        SELECT v FROM state_values s WHERE s.k = d.k
        UNION
        SELECT v FROM state_extra e WHERE e.k = d.k
    ) unioned
)
FROM state_plan_outer o
JOIN (
    SELECT k FROM state_domain WHERE selected GROUP BY k
) d ON o.k = d.k;
----
logical_opt	<REGEX>:.*__duckdb_duplicate_eliminated_factor_.*

statement ok
SET debug_verify_aggregate_state_export=getvariable('dedup_original_verify_aggregate_state_export');

