# name: test/optimizer/estimate_distinct_cardinality_overflow.test
# description: Distinct cardinality estimation must not overflow when the input cardinality saturates
# group: [optimizer]

statement ok
CREATE TABLE t AS SELECT 1 a FROM range(600);

# 600^7 overflows idx_t, so the cross product cardinality saturates to the maximum idx_t
statement ok
EXPLAIN SELECT 1 FROM (SELECT row_number() OVER () r1, rank() OVER (ORDER BY t1.a) r2 FROM t t1, t t2, t t3, t t4, t t5, t t6, t t7) s GROUP BY r1, r2;

statement ok
EXPLAIN SELECT DISTINCT r1, r2 FROM (SELECT row_number() OVER () r1, rank() OVER (ORDER BY t1.a) r2 FROM t t1, t t2, t t3, t t4, t t5, t t6, t t7) s;
