query II
WITH RECURSIVE r(i, c) AS (SELECT 1, 0::BIGINT UNION ALL SELECT i + 1, (SELECT sum(c) FROM (SELECT count(*) AS c FROM sales WHERE month = 1 UNION ALL SELECT count(*) FROM sales WHERE month = 2)) FROM r WHERE i < 3) SELECT * FROM r ORDER BY ALL;
----
1	0
2	500
3	500

query II
WITH RECURSIVE r(month, c) AS (SELECT 1, count(*) FROM sales WHERE month = 1 UNION ALL SELECT r.month + 1, (SELECT count(*) FROM sales WHERE sales.month = r.month + 1) FROM r WHERE r.month < 4) SELECT * FROM r ORDER BY ALL;
----
