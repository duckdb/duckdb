# aggregates that can fail, in branches without groups: one of them is evaluated even if none is read

query I
SELECT count(*) FROM (SELECT sum(amount::TINYINT) FROM sales WHERE month = 1 UNION ALL SELECT sum(amount::TINYINT) FROM sales WHERE month = 2);
----
2

