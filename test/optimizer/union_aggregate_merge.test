# HAVING

query II
SELECT store, sum(amount) FROM sales WHERE month = 1 GROUP BY store HAVING sum(amount) > 2400 UNION ALL SELECT store, sum(amount) FROM sales WHERE month = 2 GROUP BY store HAVING sum(amount) > 2400 ORDER BY ALL;
