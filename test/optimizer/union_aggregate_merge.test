query III
SELECT d.date_id, l.* FROM dates d, LATERAL (SELECT store, count(*) AS c FROM sales WHERE month = 1 AND store = d.date_id GROUP BY store UNION ALL SELECT store, count(*) FROM sales WHERE month = 2 AND store = d.date_id GROUP BY store) l WHERE d.date_id < 3 ORDER BY ALL;
