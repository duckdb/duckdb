SELECT 1 AS half, 'x', store, sum(amount) FROM sales WHERE month = 1 GROUP BY store UNION ALL SELECT 2, 'x', store, sum(amount) FROM sales WHERE month = 7 GROUP BY store ORDER BY ALL;
