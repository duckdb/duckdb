# two compared columns, on a table that is joined

query III
SELECT d.year, f.store, sum(f.amount) FROM facts f, dates d WHERE f.date_id = d.date_id AND d.year = 2000 AND d.month = 1 GROUP BY d.year, f.store UNION ALL SELECT d.year, f.store, sum(f.amount) FROM facts f, dates d WHERE f.date_id = d.date_id AND d.year = 2000 AND d.month = 8 GROUP BY d.year, f.store UNION ALL SELECT d.year, f.store, sum(f.amount) FROM facts f, dates d WHERE f.date_id = d.date_id AND d.year = 2001 AND d.month = 1 GROUP BY d.year, f.store UNION ALL SELECT d.year, f.store, sum(f.amount) FROM facts f, dates d WHERE f.date_id = d.date_id AND d.year = 2002 AND d.month = 12 GROUP BY d.year, f.store ORDER BY ALL;
----
2000	0	440
2000	1	618
2000	2	464
2000	3	606
2000	4	548
2001	0	420
2001	1	562
2001	2	516
2001	3	636
2001	4	528
2002	0	595
2002	1	442
2002	2	584
2002	3	526
2002	4	618

query III
SELECT 'a', sum(f.amount), count(*) FROM facts f JOIN dates d ON f.date_id = d.date_id WHERE d.year = 2000 AND d.month = 1 UNION ALL SELECT 'b', sum(f.amount), count(*) FROM facts f JOIN dates d ON f.date_id = d.date_id WHERE d.year = 2000 AND d.month = 8 UNION ALL SELECT 'c', sum(f.amount), count(*) FROM facts f JOIN dates d ON f.date_id = d.date_id WHERE d.year = 2001 AND d.month = 8;
----
a	2676	112
b	NULL	0
c	2789	111

# a predicate that all branches share stays

query II
