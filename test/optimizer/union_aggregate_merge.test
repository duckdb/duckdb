# NULL: a comparison with NULL has no rows, IS NULL is not a comparison with a constant

query II
SELECT count(*), sum(amount) FROM sales WHERE amount = NULL UNION ALL SELECT count(*), sum(amount) FROM sales WHERE amount = 5 UNION ALL SELECT count(*), sum(amount) FROM sales WHERE amount = 6;
----
0	NULL
20	100
30	180

query II
SELECT count(*), sum(store) FROM sales WHERE amount IS NULL UNION ALL SELECT count(*), sum(store) FROM sales WHERE amount = 5 UNION ALL SELECT count(*), sum(store) FROM sales WHERE amount = 6;
----
300	0
20	0
30	30

# values that are equal without being the same: DOUBLE and collated VARCHAR keys are not merged

query I
SELECT count(*) FROM sales WHERE ratio = 0.0 UNION ALL SELECT count(*) FROM sales WHERE ratio = -0.0 UNION ALL SELECT count(*) FROM sales WHERE ratio = 1.0;
----
750
750
1000

query I
SELECT count(*) FROM sales WHERE code = 'a' UNION ALL SELECT count(*) FROM sales WHERE code = 'A' UNION ALL SELECT count(*) FROM sales WHERE code = 'b';
----
2750
2750
0

# the order of a UNION ALL of grouped branches can be observed without a sort above it

query I rowsort
SELECT count(*) FROM (SELECT store, sum(amount) FROM sales WHERE month = 1 GROUP BY store UNION ALL SELECT store, sum(amount) FROM sales WHERE month = 2 GROUP BY store LIMIT 7);
----
7

# branches without groups below a LIMIT: the first branches

query II
SELECT 'jan' AS name, sum(amount) FROM sales WHERE month = 1 UNION ALL SELECT 'feb', sum(amount) FROM sales WHERE month = 2 UNION ALL SELECT 'mar', sum(amount) FROM sales WHERE month = 3 LIMIT 2;
----
jan	10000
feb	12750

# aggregates that read their rows in order are only merged where a hash aggregate computes them already

query II
SELECT first(amount), list(store)[1:3] FROM sales WHERE month = 1 UNION ALL SELECT first(amount), list(store)[1:3] FROM sales WHERE month = 2;
----
NULL	[0, 2, 4]
7	[2, 4, 1]

