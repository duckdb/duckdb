# below an aggregate, a join, a DISTINCT; in a CTE that is read twice; in a correlated subquery; in a recursive CTE

query II rowsort
SELECT count(*), sum(s) FROM (SELECT store, sum(amount) AS s FROM sales WHERE month = 1 GROUP BY store UNION ALL SELECT store, sum(amount) FROM sales WHERE month = 2 GROUP BY store);
----
10	22750

query III
SELECT u.store, u.s, d.year FROM (SELECT store, sum(amount) AS s FROM sales WHERE month = 1 GROUP BY store UNION ALL SELECT store, sum(amount) FROM sales WHERE month = 2 GROUP BY store) u JOIN dates d ON u.store = d.date_id ORDER BY ALL;
