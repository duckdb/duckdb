jan	10000	feb	12750

query IIII
WITH u AS MATERIALIZED (SELECT 'jan' AS name, sum(amount) AS s FROM sales WHERE month = 1 UNION ALL SELECT 'feb', sum(amount) FROM sales WHERE month = 2) SELECT * FROM u a JOIN u b ON a.s <> b.s ORDER BY ALL;
----
feb	12750	jan	10000
jan	10000	feb	12750

query II
