# name: test/optimizer/union_aggregate_merge.test
# description: UNION ALL branches that aggregate the same input under different constants return the same rows as one aggregate
# group: [optimizer]

# Every query runs with the rule disabled and enabled, at one thread (where it merges also the branches over
# small tables) and at four threads; the expected rows are those of the unoptimized plan.

statement ok
CREATE TABLE sales AS SELECT (i * 7 % 12 + 1)::INTEGER AS month, (2000 + i % 3)::INTEGER AS year, (i % 5)::INTEGER AS store, CASE WHEN i % 10 = 0 THEN NULL ELSE i % 100 END::BIGINT AS amount, 'c' || (i % 4) AS category, DATE '2024-01-01' + (i % 6)::INTEGER AS day, (i % 3)::DOUBLE AS ratio, CASE i % 2 WHEN 0 THEN 'a' ELSE 'A' END COLLATE NOCASE AS code FROM range(3000) r(i) WHERE i * 7 % 12 + 1 <> 4;

statement ok
CREATE TABLE dates AS SELECT i::INTEGER AS date_id, (2000 + i // 12)::INTEGER AS year, (i % 12 + 1)::INTEGER AS month FROM range(36) r(i);

statement ok
CREATE TABLE facts AS SELECT (i % 36)::INTEGER AS date_id, (i % 5)::INTEGER AS store, (i % 50)::BIGINT AS amount FROM range(4000) r(i) WHERE i % 36 <> 7;

statement ok
CREATE TABLE nothing(month INTEGER, store INTEGER, amount BIGINT);

statement ok
CREATE SEQUENCE seq;

statement ok
CREATE TABLE big AS SELECT (i * 7 % 12 + 1)::INTEGER AS month, (i % 5)::INTEGER AS store, i::BIGINT AS amount, (i // 100000)::INTEGER AS batch FROM range(1200000) r(i);

foreach threads 1 4

statement ok
SET threads = {threads};

foreach disabled 'union_aggregate_merge' ''

statement ok
SET disabled_optimizers = {disabled};

# branches without groups: one row per branch in the order of the branches, also for a month without rows (4) and a month out of range (13)

query III
SELECT 'jan' AS name, sum(amount), count(*) FROM sales WHERE month = 1 UNION ALL SELECT 'apr', sum(amount), count(*) FROM sales WHERE month = 4 UNION ALL SELECT 'feb', sum(amount), count(*) FROM sales WHERE month = 2;
----
jan	10000	250
apr	NULL	0
feb	12750	250

query III
SELECT 'jan' AS name, sum(amount), count(*) FROM sales WHERE month = 1 UNION ALL SELECT 'none', sum(amount), count(*) FROM sales WHERE month = 13 UNION ALL SELECT 'feb', sum(amount), count(*) FROM sales WHERE month = 2 UNION ALL SELECT 'mar', sum(amount), count(*) FROM sales WHERE month = 3;
----
jan	10000	250
none	NULL	0
feb	12750	250
mar	10000	250

query IIIIIII
SELECT sum(amount), count(*), count(amount), min(amount), max(amount), avg(amount), count(DISTINCT store) FROM sales WHERE month = 4 UNION ALL SELECT sum(amount), count(*), count(amount), min(amount), max(amount), avg(amount), count(DISTINCT store) FROM sales WHERE month = 5 UNION ALL SELECT sum(amount), count(*), count(amount), min(amount), max(amount), avg(amount), count(DISTINCT store) FROM sales WHERE month = 6;
----
NULL	0	0	NULL	NULL	NULL	0
10000	250	200	4	96	50.0	5
12750	250	250	3	99	51.0	5

# aggregates whose value over no rows is not NULL, inside expressions

query IIII
SELECT month_name, c + 1, coalesce(s, -1), l FROM (SELECT 'apr' AS month_name, count(*) AS c, sum(amount) AS s, count_if(amount > 5) AS l FROM sales WHERE month = 4 UNION ALL SELECT 'may', count(*), sum(amount), count_if(amount > 5) FROM sales WHERE month = 5 UNION ALL SELECT 'jun', count(*), sum(amount), count_if(amount > 5) FROM sales WHERE month = 6) ORDER BY ALL;
----
apr	1	-1	NULL
jun	251	12750	240
may	251	10000	190

query IIIII
SELECT list(amount ORDER BY amount) IS NULL, string_agg(category, ',' ORDER BY category) IS NULL, bool_and(amount > 0), approx_count_distinct(store), any_value(1) FROM sales WHERE month = 4 UNION ALL SELECT list(amount ORDER BY amount) IS NULL, string_agg(category, ',' ORDER BY category) IS NULL, bool_and(amount > 0), approx_count_distinct(store), any_value(1) FROM sales WHERE month = 7;
----
true	true	NULL	0	NULL
false	false	true	5	1

# FILTER, DISTINCT and ORDER BY in the aggregates

query IIIII
SELECT month, sum(amount) FILTER (WHERE store > 1), count(DISTINCT category), first(amount ORDER BY amount DESC, store), sum(DISTINCT amount) FROM sales WHERE month = 1 GROUP BY month UNION ALL SELECT month, sum(amount) FILTER (WHERE store > 1), count(DISTINCT category), first(amount ORDER BY amount DESC, store), sum(DISTINCT amount) FROM sales WHERE month = 2 GROUP BY month UNION ALL SELECT month, sum(amount) FILTER (WHERE store > 1), count(DISTINCT category), first(amount ORDER BY amount DESC, store), sum(DISTINCT amount) FROM sales WHERE month = 4 GROUP BY month ORDER BY ALL;
----
1	7200	1	96	1000
2	7450	1	99	1275

