query II
SELECT store, sum(amount) FROM sales WHERE month = 1 GROUP BY store UNION ALL SELECT store, sum(amount) FROM sales WHERE month = 2 GROUP BY store UNION ALL SELECT store, sum(amount) FROM sales WHERE month = 4 GROUP BY store ORDER BY ALL;
