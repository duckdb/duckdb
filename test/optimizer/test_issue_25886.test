# name: test/optimizer/test_issue_25886.test
# description: Issue #25886 - use-after-free in compressed materialization when the root LIMIT is removed
# group: [optimizer]

statement ok
CREATE TABLE t (ts TIMESTAMP, k BIGINT, ns VARCHAR, b VARCHAR);

# the LIMIT at the root of the plan is redundant and removed during statistics propagation
query IIII
SELECT * FROM t WHERE ((ns = 'n0' AND b LIKE '%|d0|%')) ORDER BY ts, k LIMIT 10001;
----

query IIII
SELECT * FROM t ORDER BY ts, k LIMIT 10001;
----

statement ok
INSERT INTO t VALUES ('2023-01-02', 2, 'n0', 'x|d0|y'), ('2023-01-01', 1, 'n0', 'x|d0|y'), ('2023-01-03', 3, 'n1', 'z');

query IIII
SELECT * FROM t WHERE ((ns = 'n0' AND b LIKE '%|d0|%')) ORDER BY ts, k LIMIT 10001;
----
2023-01-01 00:00:00	1	n0	x|d0|y
2023-01-02 00:00:00	2	n0	x|d0|y

query IIII
SELECT * FROM t ORDER BY ts, k LIMIT 10001;
----
