# name: test/optimizer/topn_window_elimination_join_window_column.test
# description: Top-N window elimination over a join whose other side computes a window column
# group: [optimizer]

statement ok
CREATE TABLE a AS SELECT i AS k FROM range(4) t(i);

statement ok
CREATE TABLE b AS SELECT a.k, j AS x FROM a, range(3) t(j);

query III
SELECT b.k, b.x, w.n
FROM b JOIN (SELECT k, row_number() OVER (ORDER BY k) AS n FROM a) w ON w.k = b.k
QUALIFY row_number() OVER (PARTITION BY b.k ORDER BY b.x) = 1
ORDER BY ALL
----
0	0	1
1	0	2
2	0	3
3	0	4

# the window subquery written first
query III
SELECT b.k, b.x, w.n
FROM (SELECT k, row_number() OVER (ORDER BY k) AS n FROM a) w JOIN b ON w.k = b.k
QUALIFY row_number() OVER (PARTITION BY b.k ORDER BY b.x) = 1
ORDER BY ALL
----
0	0	1
1	0	2
2	0	3
3	0	4

# more than one row per partition
query III
SELECT b.k, b.x, w.n
FROM b JOIN (SELECT k, row_number() OVER (ORDER BY k) AS n FROM a) w ON w.k = b.k
QUALIFY row_number() OVER (PARTITION BY b.k ORDER BY b.x) <= 2
ORDER BY ALL
----
0	0	1
0	1	1
1	0	2
1	1	2
2	0	3
2	1	3
3	0	4
3	1	4

# partition by the join key of the window side
query III
SELECT w.k, b.x, w.n
FROM b JOIN (SELECT k, row_number() OVER (ORDER BY k) AS n FROM a) w ON w.k = b.k
QUALIFY row_number() OVER (PARTITION BY w.k ORDER BY b.x) = 1
ORDER BY ALL
----
0	0	1
1	0	2
2	0	3
3	0	4

# partition by the window column
query III
SELECT w.n, b.x, b.k
FROM b JOIN (SELECT k, row_number() OVER (ORDER BY k) AS n FROM a) w ON w.k = b.k
QUALIFY row_number() OVER (PARTITION BY w.n ORDER BY b.x) = 1
ORDER BY ALL
----
1	0	0
2	0	1
3	0	2
4	0	3

# order by an expression over the window column
query III
SELECT b.k, b.x, w.n
FROM b JOIN (SELECT k, row_number() OVER (ORDER BY k) AS n FROM a) w ON w.k = b.k
QUALIFY row_number() OVER (PARTITION BY b.k ORDER BY w.n + b.x DESC) = 1
ORDER BY ALL
----
0	2	1
1	2	2
2	2	3
3	2	4

# other window functions
query III
SELECT b.k, b.x, w.n
FROM b JOIN (SELECT k, sum(k) OVER (ORDER BY k) AS n FROM a) w ON w.k = b.k
QUALIFY row_number() OVER (PARTITION BY b.k ORDER BY b.x) = 1
ORDER BY ALL
----
0	0	0
1	0	1
2	0	3
3	0	6

query III
SELECT b.k, b.x, w.n
FROM b JOIN (SELECT k, lag(k::VARCHAR, 1, 'none') OVER (ORDER BY k) AS n FROM a) w ON w.k = b.k
QUALIFY row_number() OVER (PARTITION BY b.k ORDER BY b.x) = 1
ORDER BY ALL
----
0	0	none
1	0	0
2	0	1
3	0	2

# two window columns
query IIII
SELECT b.k, b.x, w.n, w.m
FROM b JOIN (
	SELECT k, row_number() OVER (ORDER BY k) AS n, row_number() OVER (ORDER BY k DESC) AS m FROM a
) w ON w.k = b.k
QUALIFY row_number() OVER (PARTITION BY b.k ORDER BY b.x) = 1
ORDER BY ALL
----
0	0	1	4
1	0	2	3
2	0	3	2
3	0	4	1

# payload columns of several types, including nested ones
statement ok
CREATE TABLE payload AS
SELECT i % 4 AS k, i AS x, 'str_' || i AS s, [i, i + 1] AS l, {'a': i, 'b': i::VARCHAR} AS st
FROM range(12) t(i);

query IIIIII
SELECT payload.k, payload.x, payload.s, payload.l, payload.st, w.n
FROM payload JOIN (SELECT k, row_number() OVER (ORDER BY k DESC) AS n FROM a) w ON w.k = payload.k
QUALIFY row_number() OVER (PARTITION BY payload.k ORDER BY payload.x DESC) = 1
ORDER BY ALL
----
0	8	str_8	[8, 9]	{'a': 8, 'b': 8}	4
1	9	str_9	[9, 10]	{'a': 9, 'b': 9}	3
2	10	str_10	[10, 11]	{'a': 10, 'b': 10}	2
3	11	str_11	[11, 12]	{'a': 11, 'b': 11}	1

# nested payload from the window side
statement ok
CREATE TABLE lists AS SELECT i AS k, [i + 10, i + 20] AS l FROM range(4) t(i);

query IIII
SELECT b.k, b.x, w.l, w.n
FROM b JOIN (SELECT k, l, row_number() OVER (ORDER BY k DESC) AS n FROM lists) w ON w.k = b.k
QUALIFY row_number() OVER (PARTITION BY b.k ORDER BY b.x DESC) = 1
ORDER BY ALL
----
0	2	[10, 20]	4
1	2	[11, 21]	3
2	2	[12, 22]	2
3	2	[13, 23]	1

# string join keys: the window column and the join key have different types
statement ok
CREATE TABLE string_keys AS SELECT 'key_' || i AS k FROM range(4) t(i);

statement ok
CREATE TABLE string_payload AS SELECT 'key_' || (i % 4) AS k, i AS x, 'str_' || i AS s FROM range(12) t(i);

query IIII
SELECT p.k, p.x, p.s, w.n
FROM string_payload p JOIN (SELECT k, row_number() OVER (ORDER BY k DESC) AS n FROM string_keys) w ON w.k = p.k
QUALIFY row_number() OVER (PARTITION BY p.k ORDER BY p.x) = 1
ORDER BY ALL
----
key_0	0	str_0	4
key_1	1	str_1	3
key_2	2	str_2	2
key_3	3	str_3	1

# the window side is the larger side of the join
statement ok
CREATE TABLE big AS SELECT i AS k FROM range(100) t(i);

statement ok
CREATE TABLE small AS SELECT i * 33 AS k, j AS x, 'small_' || i || '_' || j AS s FROM range(4) t(i), range(2) t2(j);

query IIII
SELECT small.k, small.x, small.s, w.n
FROM small JOIN (SELECT k, row_number() OVER (ORDER BY k DESC) AS n FROM big) w ON w.k = small.k
QUALIFY row_number() OVER (PARTITION BY small.k ORDER BY small.x DESC) = 1
ORDER BY ALL
----
0	1	small_0_1	100
33	1	small_1_1	67
66	1	small_2_1	34
99	1	small_3_1	1

query IIII
SELECT small.k, small.x, small.s, w.n
FROM (SELECT k, row_number() OVER (ORDER BY k DESC) AS n FROM big) w JOIN small ON w.k = small.k
QUALIFY row_number() OVER (PARTITION BY small.k ORDER BY small.x DESC) <= 2
ORDER BY ALL
----
0	0	small_0_0	100
0	1	small_0_1	100
33	0	small_1_0	67
33	1	small_1_1	67
66	0	small_2_0	34
66	1	small_2_1	34
99	0	small_3_0	1
99	1	small_3_1	1

# other join types
query III
SELECT b.k, b.x, w.n
FROM b LEFT JOIN (SELECT k, row_number() OVER (ORDER BY k) AS n FROM a WHERE k > 0) w ON w.k = b.k
QUALIFY row_number() OVER (PARTITION BY b.k ORDER BY b.x) = 1
ORDER BY ALL
----
0	0	NULL
1	0	1
2	0	2
3	0	3

query III
SELECT b.k, b.x, w.n
FROM (SELECT * FROM b WHERE k < 3) b RIGHT JOIN (SELECT k, row_number() OVER (ORDER BY k) AS n FROM a) w ON w.k = b.k
QUALIFY row_number() OVER (PARTITION BY b.k ORDER BY b.x) = 1
ORDER BY ALL
----
0	0	1
1	0	2
2	0	3
NULL	NULL	4

query III
SELECT b.k, b.x, w.n
FROM (SELECT * FROM b WHERE k < 3) b FULL JOIN (SELECT k, row_number() OVER (ORDER BY k) AS n FROM a WHERE k > 0) w ON w.k = b.k
QUALIFY row_number() OVER (PARTITION BY b.k ORDER BY b.x) = 1
ORDER BY ALL
----
0	0	NULL
1	0	1
2	0	2
NULL	NULL	3

query II
SELECT b.k, b.x
FROM b
WHERE b.k IN (SELECT n FROM (SELECT k, row_number() OVER (ORDER BY k) AS n FROM a))
QUALIFY row_number() OVER (PARTITION BY b.k ORDER BY b.x) = 1
ORDER BY ALL
----
1	0
2	0
3	0
