# name: test/optimizer/projection_placement_lowering.test
# description: Projection lowering through deep join paths preserves aliases, NULLs and grouped expressions
# group: [optimizer]

statement ok
CREATE TABLE lowering_dimension AS
SELECT 0::INTEGER AS i, repeat('x', 100) AS v
UNION ALL SELECT 1, NULL;

statement ok
CREATE TABLE lowering_factor AS SELECT * FROM (VALUES (0), (0), (1)) t(i);

statement ok
SET disabled_optimizers = 'projection_pullup,common_subplan,compressed_materialization,join_elimination,join_to_semi_join';

query IIIII
SELECT count(*), count(a), count(b), sum(length(a)), sum(length(b))
FROM (
	SELECT substring(d.payload, 1, 20) AS a, substring(d.payload, 1, 30) AS b
	FROM (SELECT i AS k, v AS payload FROM lowering_dimension) d
	JOIN lowering_factor f0 ON d.k = f0.i
	JOIN lowering_factor f1 ON (d.k + f0.i) % 2 = f1.i
	JOIN lowering_factor f2 ON (d.k + f0.i + f1.i) % 2 = f2.i
	JOIN lowering_factor f3 ON (d.k + f0.i + f1.i + f2.i) % 2 = f3.i
	JOIN lowering_factor f4 ON (d.k + f0.i + f1.i + f2.i + f3.i) % 2 = f4.i
	JOIN lowering_factor f5 ON (d.k + f0.i + f1.i + f2.i + f3.i + f4.i) % 2 = f5.i
	JOIN lowering_factor f6 ON (d.k + f0.i + f1.i + f2.i + f3.i + f4.i + f5.i) % 2 = f6.i
	JOIN lowering_factor f7 ON (d.k + f0.i + f1.i + f2.i + f3.i + f4.i + f5.i + f6.i) % 2 = f7.i
);
----
384	256	256	5120	7680

# A different source on the other join branch is reconsidered after the first group changes bindings.
query IIIII
SELECT count(*), count(a), count(b), sum(length(a)), sum(length(b))
FROM (
	SELECT substring(l.v, 1, 20) AS a, substring(r.v, 1, 30) AS b
	FROM (
		SELECT d.v, (d.i + f0.i + f1.i + f2.i) % 2 AS k
		FROM lowering_dimension d
		JOIN lowering_factor f0 ON d.i = f0.i
		JOIN lowering_factor f1 ON (d.i + f0.i) % 2 = f1.i
		JOIN lowering_factor f2 ON (d.i + f0.i + f1.i) % 2 = f2.i
	) l
	JOIN (
		SELECT d.v, (d.i + f0.i + f1.i + f2.i) % 2 AS k
		FROM lowering_dimension d
		JOIN lowering_factor f0 ON d.i = f0.i
		JOIN lowering_factor f1 ON (d.i + f0.i) % 2 = f1.i
		JOIN lowering_factor f2 ON (d.i + f0.i + f1.i) % 2 = f2.i
	) r ON l.k = r.k
);
----
144	96	96	1920	2880
