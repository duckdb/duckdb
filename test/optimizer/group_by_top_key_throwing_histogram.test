# name: test/optimizer/group_by_top_key_throwing_histogram.test
# description: GROUP BY k ORDER BY k LIMIT n: a binned histogram whose finalize can throw does not see the groups after the bound
# group: [optimizer]

statement ok
SET threads = 1;

# histogram_exact takes the bins of a group from its first row, the row with the largest i under the ORDER BY. A filter
# below the aggregate with the bound k = 1 drops the rows of k = 2 that arrive after it, and the bin 2147483647 of the
# row that comes first then is the key of the "other values" bucket that the value 1 falls into
statement ok
CREATE TABLE hin AS
SELECT i, CASE WHEN i = 6144 THEN 0 WHEN i < 2048 THEN 2 WHEN i < 4096 THEN 1 ELSE 2 END AS k,
       CASE WHEN i < 2048 THEN [2147483647] ELSE [1] END AS bins
FROM range(6145) AS source(i);

foreach disabled 'group_by_top_key' ''

statement ok
SET disabled_optimizers = {disabled};

query II
SELECT k, histogram_exact(1::INTEGER, bins ORDER BY i DESC) FROM hin GROUP BY k ORDER BY k LIMIT 1
----
0	{1=1}

query II
SELECT k, histogram_exact(1::INTEGER, bins ORDER BY i DESC) FROM hin GROUP BY k ORDER BY k DESC LIMIT 2
----
2	{1=4096}
1	{1=2048}

endloop
