# an empty input
query III
SELECT g, count(x) AS c, sum(count(x)) OVER () AS total FROM t WHERE x < 0 GROUP BY g;
----

# the same answers as the window itself, for aggregates of every kind over the shared input
# (d holds dyadic fractions: its sums are exact in any order)
statement ok
CREATE VIEW agg AS
SELECT k, g, n, count(*) AS c, min(x) AS m, sum(x / 8) AS d, max(s) AS z FROM t WHERE n IS NULL OR n < 4 GROUP BY k, g, n;

query II
EXPLAIN SELECT k, g, n, c, median(c) OVER (PARTITION BY n), count(DISTINCT c) OVER (PARTITION BY n) FROM agg;
----
physical_plan	<!REGEX>:.*SEQ_SCAN.*SEQ_SCAN.*

statement ok
CREATE OR REPLACE TABLE shared AS
SELECT k, g, n, c,
	sum(c) OVER w AS w1, avg(c) OVER w AS w2, min(m) OVER w AS w3, max(d) OVER w AS w4, sum(d) OVER w AS w5,
	count(DISTINCT c) OVER w AS w6, median(c) OVER w AS w7, string_agg(z, ',' ORDER BY k, g, n) OVER w AS w8,
	list(c ORDER BY k, g, n) OVER w AS w9, count(*) FILTER (WHERE c > 3) OVER w AS w10
FROM agg WINDOW w AS ();

statement ok
SET disabled_optimizers = 'window_self_join';

statement ok
CREATE OR REPLACE TABLE windowed AS
SELECT k, g, n, c,
	sum(c) OVER w AS w1, avg(c) OVER w AS w2, min(m) OVER w AS w3, max(d) OVER w AS w4, sum(d) OVER w AS w5,
	count(DISTINCT c) OVER w AS w6, median(c) OVER w AS w7, string_agg(z, ',' ORDER BY k, g, n) OVER w AS w8,
	list(c ORDER BY k, g, n) OVER w AS w9, count(*) FILTER (WHERE c > 3) OVER w AS w10
FROM agg WINDOW w AS ();

statement ok
RESET disabled_optimizers;

query I
SELECT count(*) FROM ((FROM shared EXCEPT ALL FROM windowed) UNION ALL (FROM windowed EXCEPT ALL FROM shared));
----
0

query I
SELECT count(*) FROM shared;
----
1260

foreach partition_key g n g,n

statement ok
CREATE OR REPLACE TABLE shared AS
SELECT k, g, n, c,
	sum(c) OVER w AS w1, avg(c) OVER w AS w2, min(m) OVER w AS w3, max(d) OVER w AS w4, sum(d) OVER w AS w5,
	count(DISTINCT c) OVER w AS w6, median(c) OVER w AS w7, string_agg(z, ',' ORDER BY k, g, n) OVER w AS w8,
	list(c ORDER BY k, g, n) OVER w AS w9, count(*) FILTER (WHERE c > 3) OVER w AS w10
FROM agg WINDOW w AS (PARTITION BY {partition_key});

statement ok
SET disabled_optimizers = 'window_self_join';

statement ok
CREATE OR REPLACE TABLE windowed AS
SELECT k, g, n, c,
	sum(c) OVER w AS w1, avg(c) OVER w AS w2, min(m) OVER w AS w3, max(d) OVER w AS w4, sum(d) OVER w AS w5,
	count(DISTINCT c) OVER w AS w6, median(c) OVER w AS w7, string_agg(z, ',' ORDER BY k, g, n) OVER w AS w8,
	list(c ORDER BY k, g, n) OVER w AS w9, count(*) FILTER (WHERE c > 3) OVER w AS w10
FROM agg WINDOW w AS (PARTITION BY {partition_key});

statement ok
RESET disabled_optimizers;

query I
SELECT count(*) FROM ((FROM shared EXCEPT ALL FROM windowed) UNION ALL (FROM windowed EXCEPT ALL FROM shared));
----
0

query I
SELECT count(*) FROM shared;
----
1260

endloop

# an ordered window whose frame is the whole partition
statement ok
CREATE OR REPLACE TABLE shared AS
SELECT k, g, n, c,
	sum(c) OVER w AS w1, avg(c) OVER w AS w2, min(m) OVER w AS w3, max(d) OVER w AS w4, sum(d) OVER w AS w5,
	count(DISTINCT c) OVER w AS w6, median(c) OVER w AS w7, string_agg(z, ',' ORDER BY k, g, n) OVER w AS w8,
	list(c ORDER BY k, g, n) OVER w AS w9, count(*) FILTER (WHERE c > 3) OVER w AS w10
FROM agg WINDOW w AS (PARTITION BY g ORDER BY k, g, n RANGE BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING);

statement ok
SET disabled_optimizers = 'window_self_join';

statement ok
CREATE OR REPLACE TABLE windowed AS
SELECT k, g, n, c,
	sum(c) OVER w AS w1, avg(c) OVER w AS w2, min(m) OVER w AS w3, max(d) OVER w AS w4, sum(d) OVER w AS w5,
	count(DISTINCT c) OVER w AS w6, median(c) OVER w AS w7, string_agg(z, ',' ORDER BY k, g, n) OVER w AS w8,
	list(c ORDER BY k, g, n) OVER w AS w9, count(*) FILTER (WHERE c > 3) OVER w AS w10
FROM agg WINDOW w AS (PARTITION BY g ORDER BY k, g, n RANGE BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING);

statement ok
RESET disabled_optimizers;

query I
SELECT count(*) FROM ((FROM shared EXCEPT ALL FROM windowed) UNION ALL (FROM windowed EXCEPT ALL FROM shared));
----
0

query I
SELECT count(*) FROM shared;
----
1260

# a prepared statement: the parameter reaches the one input that is left
statement ok
PREPARE share AS SELECT g, count(x) AS c, sum(count(x)) OVER () AS total FROM t WHERE k < $1 GROUP BY g ORDER BY g;

query III
EXECUTE share(1);
