# a window over a plain scan keeps its two scans: the aggregate reads fewer columns than the other side, and
# filters reach the two sides separately
query II
EXPLAIN SELECT x, count(*) OVER (PARTITION BY k) FROM t;
----
physical_plan	<!REGEX>:.*CTE.*

# a volatile input is not copied, so that there is nothing to share
statement ok
CREATE SEQUENCE seq;

query II
EXPLAIN SELECT g, c, sum(c) OVER () FROM (SELECT g, count(x + nextval('seq')) AS c FROM t GROUP BY g);
----
physical_plan	<REGEX>:.*WINDOW.*

query III
SELECT g, c, sum(c) OVER () FROM (SELECT g, count(x + nextval('seq')) AS c FROM t GROUP BY g) ORDER BY g;
----
0	1429	10000
1	1429	10000
2	1429	10000
3	1429	10000
4	1428	10000
5	1428	10000
6	1428	10000

query I
SELECT nextval('seq');
----
10001

# the input of the window is a join: there the window stays
query II
EXPLAIN SELECT a.g, count(*) AS c, sum(count(*)) OVER () FROM t a JOIN t b ON a.x = b.k GROUP BY a.g;
----
physical_plan	<REGEX>:.*WINDOW.*
