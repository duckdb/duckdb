# name: test/optimizer/window_self_join_shared_input.test
# description: The window self-join reads an aggregated input once: its copy of the input is a common subplan
# group: [optimizer]

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

statement ok
CREATE TABLE t AS
SELECT i AS x, i % 100 AS k, i % 7 AS g, CASE WHEN i % 11 = 0 THEN NULL ELSE i % 5 END AS n, 's' || (i % 13) AS s
FROM range(10000) r(i);

# share of the total: the window over the aggregate becomes an aggregate over the same aggregate
query II
EXPLAIN SELECT g, count(x) AS c, count(x) * 100.0 / sum(count(x)) OVER () AS pct FROM t GROUP BY g;
----
physical_plan	<REGEX>:.*CTE.*CROSS_PRODUCT.*CTE_SCAN.*CTE_SCAN.*

# and the table is read once
query II
EXPLAIN SELECT g, count(x) AS c, count(x) * 100.0 / sum(count(x)) OVER () AS pct FROM t GROUP BY g;
----
physical_plan	<!REGEX>:.*SEQ_SCAN.*SEQ_SCAN.*

query IIII
SELECT g, count(x) AS c, sum(count(x)) OVER () AS total, round(count(x) * 100.0 / sum(count(x)) OVER (), 2) AS pct
FROM t GROUP BY g ORDER BY g;
----
0	1429	10000	14.29
1	1429	10000	14.29
2	1429	10000	14.29
3	1429	10000	14.29
4	1428	10000	14.28
5	1428	10000	14.28
6	1428	10000	14.28

# partitioned window over the aggregate
query II
EXPLAIN SELECT k, g, sum(x) AS s, sum(sum(x)) OVER (PARTITION BY g) AS w FROM t GROUP BY k, g;
----
physical_plan	<REGEX>:.*CTE.*Join Type: INNER.*CTE_SCAN.*CTE_SCAN.*

query II
EXPLAIN SELECT k, g, sum(x) AS s, sum(sum(x)) OVER (PARTITION BY g) AS w FROM t GROUP BY k, g;
----
physical_plan	<!REGEX>:.*SEQ_SCAN.*SEQ_SCAN.*

query IIII
SELECT k, g, sum(x) AS s, sum(sum(x)) OVER (PARTITION BY g) AS w FROM t WHERE k < 2 GROUP BY k, g ORDER BY k, g;
