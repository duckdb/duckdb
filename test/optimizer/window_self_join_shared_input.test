1	2	69314	144314
1	3	75015	145715
1	4	70714	137214
1	5	66514	138614
1	6	72114	140014

# a NULL partition key, a filter on the aggregate, and a filter on the window
query II
EXPLAIN SELECT n, c, w FROM (
	SELECT n, g, count(*) AS c, sum(count(*)) OVER (PARTITION BY n) AS w FROM t GROUP BY n, g HAVING count(*) > 250
) WHERE w > 1500;
----
physical_plan	<!REGEX>:.*SEQ_SCAN.*SEQ_SCAN.*

query III
SELECT n, c, w FROM (
	SELECT n, g, count(*) AS c, sum(count(*)) OVER (PARTITION BY n) AS w FROM t GROUP BY n, g HAVING count(*) > 250
) WHERE w > 1500 ORDER BY ALL;
