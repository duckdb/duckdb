# QUALIFY on the window over the aggregate
query II
SELECT k, sum(x) AS s FROM t GROUP BY k QUALIFY sum(x) = max(sum(x)) OVER () ORDER BY k;
----
99	504900

# two windows over the same aggregate with different partitions
query IIIII
SELECT k, g, count(*) AS c, sum(count(*)) OVER (PARTITION BY k) AS wk, sum(count(*)) OVER (PARTITION BY g) AS wg
FROM t WHERE k < 2 GROUP BY k, g ORDER BY k, g;
----
