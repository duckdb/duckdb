# name: test/optimizer/projection_pullup_nested_plan.test
# description: Moving a computed projection still visits projections below its child join
# group: [optimizer]

statement ok
CREATE TABLE t(i INTEGER);

statement ok
INSERT INTO t VALUES (1), (20);

# Compression would introduce its own projections below the joins.
statement ok
SET disabled_optimizers = 'compressed_materialization';

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

statement ok
SET explain_output = 'optimized_only';

# Pulling length above the outer join must also remove the inner column-reference projections.
query II
EXPLAIN SELECT p.x, z.i
FROM (
	SELECT length(a.i::VARCHAR) x, a.i
	FROM (SELECT i FROM t) a JOIN (SELECT i FROM t) b USING (i)
) p JOIN t z USING (i);
----
logical_opt	<!REGEX>:(?s).*JOIN.*PROJECTION.*

# Constants and aliases on both sides can move above a cross product.
query II
EXPLAIN SELECT p.x, q.y, p.c, q.d
FROM (SELECT i x, 42 c FROM t) p CROSS JOIN (SELECT i y, 43 d FROM t) q;
----
logical_opt	<!REGEX>:(?s).*CROSS_PRODUCT.*PROJECTION.*

query IIII rowsort
SELECT p.x, q.y, p.c, q.d
FROM (SELECT i x, 42 c FROM t) p CROSS JOIN (SELECT i y, 43 d FROM t) q;
----
1	1	42	43
1	20	42	43
20	1	42	43
20	20	42	43

# Scalar projections retain the bindings produced by their dummy scans.
query II
EXPLAIN SELECT * FROM (SELECT 42 a), (SELECT 43 b);
----
logical_opt	<REGEX>:.*CROSS_PRODUCT.*

# A computed projection must still execute before Cartesian multiplication.
query II
EXPLAIN SELECT sum(p.n) FROM (SELECT length(i::VARCHAR) n FROM t) p CROSS JOIN t q;
----
logical_opt	<REGEX>:(?s).*CROSS_PRODUCT.*PROJECTION.*

query I
SELECT sum(p.n) FROM (SELECT length(i::VARCHAR) n FROM t) p CROSS JOIN t q;
----
6
