2	2
3	3
4	4
NULL	4

query II
select idb, max(n) from (select b.idb, count(*) n from b left join a on b.idb = a.ida group by b.idb) group by idb order by all;
----
1	2
2	1
3	3
4	1
NULL	2

# SEMI / ANTI joins: the removed side on their right side, also with other conditions

query II
select idc, valuec from c where idc in (select b.idb from b left join a on b.valueb < a.valuea) order by all;
----
1	1
2	2
3	3
3	3
3	NULL
4	4

query II
select idc, valuec from c where idc not in (select b.valueb from b left join a on b.idb = a.ida where b.valueb is not null) order by all;
----


query II
select idc, valuec from c where exists (select 1 from b left join a on b.idb = a.ida where b.idb = c.idc and b.valueb <= c.valuec) order by all;
----
1	1
2	2
3	3
3	3
4	4


query II
select idc, valuec from c where exists (select 1 from b left join a on b.idb = a.ida where b.idb = c.idc and a.valuea <= c.valuec) order by all;
----
1	1
2	2


query II
select idc, valuec from c where not exists (select 1 from b left join a on b.idb = a.ida where b.idb = c.idc and a.valuea is null) order by all;
----
1	1
2	2
NULL	4
NULL	NULL

query II
select idc, valuec from c where exists (select 1 from b left join a on b.idb = a.ida and a.valuea = c.valuec where b.idb = c.idc) order by all;
----
