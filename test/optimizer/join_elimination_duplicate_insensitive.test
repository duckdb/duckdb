1	1
2	2
3	3
4	4
NULL	4

query I
select nextval('seq');
----
7

query II
explain select b.idb, max(b.valueb) from b left join a on b.idb = a.ida and random() < 2 group by b.idb;
----
physical_plan	<REGEX>:.*JOIN.*

# an error that only the removed inner side or the removed join condition raises is not raised any more, like the error
# of any other expression that is not evaluated because nothing reads it: the join is removed
query II
explain select b.idb, max(b.valueb) from b left join a on b.idb = cast('x' || a.ida as int) group by b.idb;
----
physical_plan	<!REGEX>:.*JOIN.*

# so the query runs; only a configuration that executes the unoptimized plan (debug_disable_optimizer) still raises
statement maybe
select b.idb, max(b.valueb) from b left join a on b.idb = cast('x' || a.ida as int) group by b.idb order by all;
----
Conversion Error

statement ok
SET disabled_optimizers = 'join_elimination';

statement error
select b.idb, max(b.valueb) from b left join a on b.idb = cast('x' || a.ida as int) group by b.idb order by all;
