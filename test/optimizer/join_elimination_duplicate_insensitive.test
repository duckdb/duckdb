# operators between the join and the aggregate that see the repeated rows

query II
select idb, max(valueb) from (select b.*, row_number() over (partition by b.idb order by b.valueb) rn from b left join a on b.idb = a.ida) where rn = 2 group by idb order by all;
----
1	1
3	3
NULL	NULL

query III
select idb, max(valueb), max(rn) from (select b.*, row_number() over (partition by b.idb order by b.valueb) rn from b left join a on b.idb = a.ida) group by idb order by all;
----
1	1	2
2	2	1
3	3	3
4	4	1
NULL	4	2

query II
select idb, max(valueb) from (select b.* from b left join a on b.idb = a.ida order by b.idb nulls last, b.valueb nulls last limit 5) group by idb order by all;
