2	2
3	3

query II
select idb, max(valueb) from (select b.* from b left join a on b.idb = a.ida order by b.idb nulls last, b.valueb nulls last limit 3 offset 2) group by idb order by all;
----
2	2
3	3

query II
select idb, max(valueb) from (select distinct on (b.idb) b.idb, b.valueb from b left join a on b.idb = a.ida order by b.idb, b.valueb) group by idb order by all;
----
