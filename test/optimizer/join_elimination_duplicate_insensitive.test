statement ok
SET disabled_optimizers = '';

# aggregate functions that advertise that they depend neither on duplicates nor on the order of their input
query II
explain select b.idb, bool_and(b.valueb > 1), bool_or(b.valueb > 1) from b left join a on b.idb = a.ida group by b.idb;
----
physical_plan	<!REGEX>:.*JOIN.*

# must not fire: first and last do not depend on duplicates, but on the order of their input
query II
explain select b.idb, first(b.valueb), max(b.valueb) from b left join a on b.idb = a.ida group by b.idb;
----
physical_plan	<REGEX>:.*JOIN.*

query II
explain select b.idb, last(b.valueb) from b left join a on b.idb = a.ida group by b.idb;
----
physical_plan	<REGEX>:.*JOIN.*

# a join that is the direct child of a join (this raised an assertion in the nested-join analysis)
statement ok
create table n1(i integer);

statement ok
create table n2(i integer);

statement ok
create table n3(i integer);

statement ok
insert into n1 values (1);

statement ok
insert into n2 values (1), (1);

statement ok
insert into n3 values (1);

query I
select max(n1.i) from n1 left join n2 on n1.i = n2.i left join n3 on n2.i = n3.i;
----
1

query II
explain select max(n1.i) from n1 left join n2 on n1.i = n2.i left join n3 on n2.i = n3.i;
----
physical_plan	<!REGEX>:.*JOIN.*

# must not fire: an exported aggregate state may depend on the repeated rows although the finalized value does not
# (an ordered aggregate buffers every input row)
statement ok
create table outer_rows(i integer);

statement ok
create table matches(i integer);

statement ok
insert into outer_rows values (1);

statement ok
insert into matches values (1), (1);

loop i 0 2

statement ok
SET disabled_optimizers = CASE WHEN {i} = 0 THEN 'join_elimination' ELSE '' END;

query I
select (min(outer_rows.i order by outer_rows.i) export_state)::varchar from outer_rows left join matches using (i);
----
[{'v0': 1}, {'v0': 1}]

# the text of an ordered state depends on how the statement was planned (a sort key equal to the argument may or may
# not be stored twice), so these compare with the state over the INNER join, which returns the same two rows
query I
select (select (bool_and(outer_rows.i > 0 order by outer_rows.i > 0) export_state)::varchar from outer_rows left join matches using (i)) = (select (bool_and(outer_rows.i > 0 order by outer_rows.i > 0) export_state)::varchar from outer_rows join matches using (i));
----
true

query I
select (select (min(outer_rows.i order by outer_rows.i) export_state)::varchar from outer_rows left join matches using (i)) = (select (min(outer_rows.i order by outer_rows.i) export_state)::varchar from outer_rows join matches using (i));
----
true

query II
select finalize(min(outer_rows.i order by outer_rows.i) export_state), (max(outer_rows.i) filter (where outer_rows.i > 0) export_state)::varchar from outer_rows left join matches using (i);
----
1	1

endloop

statement ok
SET disabled_optimizers = '';

query II
explain select (min(outer_rows.i) export_state)::varchar from outer_rows left join matches using (i);
----
physical_plan	<REGEX>:.*JOIN.*

query II
explain select min(outer_rows.i order by outer_rows.i) from outer_rows left join matches using (i);
----
