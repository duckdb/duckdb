statement ok
SET disabled_optimizers = '';

# an inner side or a join condition with a volatile expression stays: a sequence is advanced once per inner row
statement ok
create sequence seq;

query II
explain select b.idb, max(b.valueb) from b left join (select ida, nextval('seq') n from a) a on b.idb = a.ida and a.n > 0 group by b.idb;
----
physical_plan	<REGEX>:.*JOIN.*

query II
select b.idb, max(b.valueb) from b left join (select ida, nextval('seq') n from a) a on b.idb = a.ida and a.n > 0 group by b.idb order by all;
