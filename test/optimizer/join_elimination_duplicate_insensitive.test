# aggregates: FILTER, ORDER BY, DISTINCT next to aggregates that count the repeated rows

query III
select b.idb, max(b.valueb) filter (where b.valueb > 1), min(b.valueb) filter (where b.idb < 4) from b left join a on b.idb = a.ida group by b.idb order by all;
----
1	NULL	1
2	2	2
3	3	3
4	4	NULL
NULL	4	NULL

query III
select b.idb, min(b.valueb order by b.valueb desc), count(distinct b.valueb) filter (where b.valueb > 2) from b left join a on b.idb = a.ida group by b.idb order by all;
----
1	1	0
2	2	0
3	3	1
4	4	1
NULL	4	1

query III
select b.idb, count(distinct b.valueb), count(*) from b left join a on b.idb = a.ida group by b.idb order by all;
