# name: test/optimizer/duplicate_eliminated_domain_correctness.test
# description: Preserve scalar and observable-evaluation semantics when substituting duplicate-eliminated domains
# group: [optimizer]

statement ok
PRAGMA explain_output=optimized_only;

statement ok
SET VARIABLE dedup_original_verify_aggregate_state_export = current_setting('debug_verify_aggregate_state_export');

statement ok
CREATE TABLE dedup_outer(k INTEGER, payload VARCHAR);

statement ok
INSERT INTO dedup_outer VALUES (1, 'same'), (1, 'same'), (2, 'other');

statement ok
CREATE TABLE dedup_dim(k INTEGER, state VARCHAR);

statement ok
INSERT INTO dedup_dim VALUES (1, 'selected'), (2, 'selected'), (4, 'selected'), (NULL, 'selected');

statement ok
CREATE TABLE dedup_measure(k INTEGER, v INTEGER, text_value VARCHAR);

statement ok
INSERT INTO dedup_measure VALUES (1, 2, '2'), (1, 4, '4'), (4, 8, 'invalid'), (NULL, 3, '3');

# Duplicate, byte-identical source rows retain payload multiplicity while the scalar result is computed by D.
query ITI rowsort
SELECT o.k, o.payload,
       (SELECT sum(m.v) FROM dedup_measure m WHERE m.k = d.k)
FROM dedup_outer o
JOIN dedup_dim d ON o.k = d.k
WHERE d.state = 'selected';
----
1	same	6
1	same	6
2	other	NULL

query III rowsort
SELECT o.k,
       (SELECT sum(m.v) FROM dedup_measure m WHERE m.k = d.k),
       (SELECT avg(m.v) FROM dedup_measure m WHERE m.k = d.k)
FROM dedup_outer o
JOIN dedup_dim d ON o.k = d.k
WHERE d.state = 'selected';
----
1	6	3
1	6	3
2	NULL	NULL

# HAVING rejection produces an empty scalar relation and null-extends only the scalar result.
query II rowsort
SELECT o.k,
       (SELECT count(*)
        FROM dedup_measure m
        WHERE m.k = d.k
        HAVING count(*) > 0)
FROM dedup_outer o
JOIN dedup_dim d ON o.k = d.k
WHERE d.state = 'selected';
----
1	2
1	2
2	NULL

query II rowsort
SELECT o.k,
       (SELECT count(*)
        FROM dedup_measure m
        WHERE m.k = d.k
        HAVING NULL::BOOLEAN)
FROM dedup_outer o
JOIN dedup_dim d ON o.k = d.k
WHERE d.state = 'selected';
----
1	NULL
1	NULL
2	NULL

# Duplicate-eliminated-domain lowering retains scalar cardinality through the SINGLE join. Factoring is optional
# when its candidate is not estimated cheaper than the canonical selected-domain CTE.
statement ok
SET debug_verify_aggregate_state_export=false;

query II
EXPLAIN
SELECT o.k,
       (SELECT count(*)
        FROM dedup_measure m
        WHERE m.k = d.k
        HAVING count(*) > 0)
FROM dedup_outer o
JOIN dedup_dim d ON o.k = d.k
WHERE d.state = 'selected';
----
logical_opt	<REGEX>:.*(__duckdb_duplicate_eliminated_factor_|__duckdb_delim_).*Join Type: SINGLE.*

statement ok
SET debug_verify_aggregate_state_export=getvariable('dedup_original_verify_aggregate_state_export');

# Inlining replaces only the duplicate-free restriction side of the semi join. The retained aggregate input and its
# per-key row order remain unchanged, including for an aggregate whose result observes that order.
statement ok
CREATE TABLE dedup_order_dim(k INTEGER, state VARCHAR);

statement ok
INSERT INTO dedup_order_dim SELECT i % 2, 'selected' FROM range(100) r(i);

statement ok
ANALYZE dedup_order_dim;

statement ok
CREATE TABLE dedup_order_outer(k INTEGER);

statement ok
INSERT INTO dedup_order_outer SELECT i % 2 FROM range(1000) r(i);

statement ok
ANALYZE dedup_order_outer;

statement ok
CREATE TABLE dedup_order_measure(k INTEGER, v INTEGER);

statement ok
INSERT INTO dedup_order_measure VALUES (0, 30), (0, 10), (1, 40), (1, 20);

query II rowsort
SELECT x, count(*)
FROM (
    SELECT (SELECT first(m.v) FROM dedup_order_measure m WHERE m.k = d.k) AS x
    FROM dedup_order_outer o
    JOIN dedup_order_dim d ON o.k = d.k
    WHERE d.state = 'selected'
)
GROUP BY x;
----
30	25000
40	25000

query II
EXPLAIN
SELECT (SELECT first(m.v) FROM dedup_order_measure m WHERE m.k = d.k)
FROM dedup_order_outer o
JOIN dedup_order_dim d ON o.k = d.k
WHERE d.state = 'selected';
----
logical_opt	<!REGEX>:.*__duckdb_delim_[0-9]+.*

query II
EXPLAIN
SELECT (SELECT first(m.v) FROM dedup_order_measure m WHERE m.k = d.k)
FROM dedup_order_outer o
JOIN dedup_order_dim d ON o.k = d.k
WHERE d.state = 'selected';
----
logical_opt	<REGEX>:.*Join Type: (RIGHT_)?SEMI.*

# Correlated values remain available above empty static aggregates.
query II rowsort
SELECT o.k,
       (SELECT coalesce(sum(m.v), d.k) FROM dedup_measure m WHERE m.k = d.k)
FROM dedup_outer o
JOIN dedup_dim d ON o.k = d.k
WHERE d.state = 'selected';
----
1	6
1	6
2	2

# Filters and projections above the aggregate retain zero-or-one scalar cardinality.
query II rowsort
SELECT o.k,
       (SELECT scalar_value
        FROM (
            SELECT coalesce(sum(m.v), d.k) AS scalar_value
            FROM dedup_measure m
            WHERE m.k = d.k
        ) scalar_input
        WHERE scalar_value > 5)
FROM dedup_outer o
JOIN dedup_dim d ON o.k = d.k
WHERE d.state = 'selected';
----
1	6
1	6
2	NULL

query II rowsort
SELECT o.k,
       (SELECT scalar_value + 10
        FROM (
            SELECT coalesce(sum(m.v), d.k) AS scalar_value
            FROM dedup_measure m
            WHERE m.k = d.k
        ) scalar_input
        WHERE scalar_value > 0
          AND scalar_value < 3)
FROM dedup_outer o
JOIN dedup_dim d ON o.k = d.k
WHERE d.state = 'selected';
----
1	NULL
1	NULL
2	12

# Expressions above a rejected aggregate row must not be evaluated. The optional strategy retains the exact domain
# because it does not try to prove that the HAVING predicate rejects every additional group.
query II rowsort
SELECT o.k,
       (SELECT CAST('not an integer' AS INTEGER)
        FROM dedup_measure m
        WHERE m.k = d.k
        HAVING count(*) < 0)
FROM dedup_outer o
JOIN dedup_dim d ON o.k = d.k
WHERE d.state = 'selected';
----
1	NULL
1	NULL
2	NULL

statement ok
SET debug_verify_aggregate_state_export=false;

query II
EXPLAIN
SELECT o.k,
       (SELECT CAST('not an integer' AS INTEGER)
        FROM dedup_measure m
        WHERE m.k = d.k
        HAVING count(*) < 0)
FROM dedup_outer o
JOIN dedup_dim d ON o.k = d.k
WHERE d.state = 'selected';
----
logical_opt	<REGEX>:.*__duckdb_delim_[0-9]+.*

statement ok
SET debug_verify_aggregate_state_export=getvariable('dedup_original_verify_aggregate_state_export');

# Function metadata, rather than the mere presence of bind data, controls whether additional groups are safe.
# Fallible functions retain the exact domain; deterministic non-fallible aggregate and window configuration may use
# a safe-superset source.
statement ok
CREATE TABLE dedup_bind_measure(k INTEGER, v INTEGER, text_value VARCHAR);

statement ok
INSERT INTO dedup_bind_measure VALUES (2, 10, 'ok'), (4, 20, 'unused');

query IIII rowsort
SELECT o.k,
       (SELECT sum(length(regexp_extract(m.text_value, '([a-z]+)', 1)))
        FROM dedup_bind_measure m WHERE m.k = d.k),
       (SELECT quantile_cont(m.v, 0.5)
        FROM dedup_bind_measure m WHERE m.k = d.k),
       (SELECT first(q)
        FROM (
            SELECT quantile_cont(m.v, 0.5) OVER (PARTITION BY m.k) AS q
            FROM dedup_bind_measure m
            WHERE m.k = d.k
        ) windowed)
FROM dedup_outer o
JOIN dedup_dim d ON o.k = d.k
WHERE d.state = 'selected';
----
1	NULL	NULL	NULL
1	NULL	NULL	NULL
2	2	10	10

# bitstring_agg consumes opaque bind data and can throw for an unreachable
# safe-superset key. The optional strategy must not evaluate that extra group.
statement ok
CREATE TABLE dedup_bind_bitstring(k INTEGER, v INTEGER);

statement ok
INSERT INTO dedup_bind_bitstring VALUES (1, 1), (4, 100);

statement ok
SET debug_verify_aggregate_state_export=false;

query IT rowsort
SELECT o.k,
       (SELECT bitstring_agg(m.v, 0, 10) FROM dedup_bind_bitstring m WHERE m.k = d.k)
FROM dedup_outer o
JOIN dedup_dim d ON o.k = d.k
WHERE d.state = 'selected';
----
1	01000000000
1	01000000000
2	NULL

query II
EXPLAIN
SELECT (SELECT sum(length(regexp_extract(m.text_value, '([a-z]+)', 1)))
        FROM dedup_bind_measure m WHERE m.k = d.k)
FROM dedup_outer o
JOIN dedup_dim d ON o.k = d.k
WHERE d.state = 'selected';
----
logical_opt	<REGEX>:.*__duckdb_duplicate_eliminated_factor_[0-9]+.*

query II
EXPLAIN
SELECT (SELECT quantile_cont(m.v, 0.5)
        FROM dedup_bind_measure m WHERE m.k = d.k)
FROM dedup_outer o
JOIN dedup_dim d ON o.k = d.k
WHERE d.state = 'selected';
----
logical_opt	<!REGEX>:.*__duckdb_delim_[0-9]+.*

query II
EXPLAIN
SELECT (SELECT first(q)
        FROM (
            SELECT quantile_cont(m.v, 0.5) OVER (PARTITION BY m.k) AS q
            FROM dedup_bind_measure m
            WHERE m.k = d.k
        ) windowed)
FROM dedup_outer o
JOIN dedup_dim d ON o.k = d.k
WHERE d.state = 'selected';
----
logical_opt	<!REGEX>:.*__duckdb_delim_[0-9]+.*

query II
EXPLAIN
SELECT o.k,
       (SELECT bitstring_agg(m.v, 0, 10) FROM dedup_bind_bitstring m WHERE m.k = d.k)
FROM dedup_outer o
JOIN dedup_dim d ON o.k = d.k
WHERE d.state = 'selected';
----
logical_opt	<REGEX>:.*__duckdb_delim_[0-9]+.*

statement ok
SET debug_verify_aggregate_state_export=getvariable('dedup_original_verify_aggregate_state_export');

# Multiple correlated keys remain in canonical order.
statement ok
CREATE TABLE dedup_pair_outer(k1 INTEGER, k2 INTEGER);

statement ok
INSERT INTO dedup_pair_outer VALUES (1, 10), (1, 10), (2, 20);

statement ok
CREATE TABLE dedup_pair_dim(k1 INTEGER, k2 INTEGER, state VARCHAR);

statement ok
INSERT INTO dedup_pair_dim VALUES (1, 10, 'selected'), (2, 20, 'selected'), (9, 90, 'selected');

statement ok
CREATE TABLE dedup_pair_measure(k1 INTEGER, k2 INTEGER, v INTEGER);

statement ok
INSERT INTO dedup_pair_measure VALUES (1, 10, 3), (1, 10, 7);

query III rowsort
SELECT o.k1, o.k2,
       (SELECT coalesce(sum(m.v), d.k1 + d.k2)
        FROM dedup_pair_measure m
        WHERE m.k1 = d.k1 AND m.k2 = d.k2)
FROM dedup_pair_outer o
JOIN dedup_pair_dim d ON o.k1 = d.k1 AND o.k2 = d.k2
WHERE d.state = 'selected';
----
1	10	10
1	10	10
2	20	22

# A safe superset is not selected without a local profitability proof. Here the one-row payload is already cheaper
# than the candidate source, so canonical lowering remains preferable.
statement ok
CREATE TABLE dedup_unsafe_measure(k INTEGER, text_value VARCHAR);

statement ok
INSERT INTO dedup_unsafe_measure VALUES (2, '1'), (4, 'invalid');

query I
SELECT (
    SELECT sum(length(m.text_value))
    FROM dedup_unsafe_measure m
    WHERE m.k = d.k
)
FROM (VALUES (2)) o(k)
JOIN dedup_dim d ON o.k = d.k
WHERE d.state = 'selected';
----
1

statement ok
SET debug_verify_aggregate_state_export=false;

query II
EXPLAIN
SELECT (
    SELECT sum(length(m.text_value))
    FROM dedup_unsafe_measure m
    WHERE m.k = d.k
)
FROM (VALUES (2)) o(k)
JOIN dedup_dim d ON o.k = d.k
WHERE d.state = 'selected';
----
logical_opt	<REGEX>:.*__duckdb_delim_[0-9]+.*

statement ok
SET debug_verify_aggregate_state_export=getvariable('dedup_original_verify_aggregate_state_export');

# A throwing aggregate expression cannot be evaluated for unreachable superset keys.
query I
SELECT (
    SELECT sum(CAST(m.text_value AS INTEGER))
    FROM dedup_unsafe_measure m
    WHERE m.k = d.k
)
FROM (VALUES (1)) o(k)
JOIN dedup_dim d ON o.k * 2 = d.k
WHERE d.state = 'selected';
----
1

statement ok
SET debug_verify_aggregate_state_export=false;

query II
EXPLAIN
SELECT (
    SELECT sum(CAST(m.text_value AS INTEGER))
    FROM dedup_unsafe_measure m
    WHERE m.k = d.k
)
FROM (VALUES (1)) o(k)
JOIN dedup_dim d ON o.k * 2 = d.k
WHERE d.state = 'selected';
----
logical_opt	<REGEX>:.*__duckdb_delim_[0-9]+.*

statement ok
SET debug_verify_aggregate_state_export=getvariable('dedup_original_verify_aggregate_state_export');

# Volatile aggregate input also retains the exact duplicate-eliminated domain.
statement ok
SET debug_verify_aggregate_state_export=false;

query II
EXPLAIN
SELECT (
    SELECT sum(random())
    FROM dedup_unsafe_measure m
    WHERE m.k = d.k
)
FROM (VALUES (1)) o(k)
JOIN dedup_dim d ON o.k * 2 = d.k
WHERE d.state = 'selected';
----
logical_opt	<REGEX>:.*Delim Join.*

statement ok
SET debug_verify_aggregate_state_export=getvariable('dedup_original_verify_aggregate_state_export');

# The same safety rule applies when the available candidate would otherwise be factored.
query I
SELECT (
    SELECT sum(CAST(m.text_value AS INTEGER))
    FROM dedup_unsafe_measure m
    WHERE m.k = d.k
)
FROM (VALUES (1)) o(k)
JOIN (
    SELECT k
    FROM dedup_dim
    WHERE state = 'selected'
    GROUP BY k
) d ON o.k * 2 = d.k;
----
1

statement ok
SET debug_verify_aggregate_state_export=false;

query II
EXPLAIN
SELECT (
    SELECT sum(CAST(m.text_value AS INTEGER))
    FROM dedup_unsafe_measure m
    WHERE m.k = d.k
)
FROM (VALUES (1)) o(k)
JOIN (
    SELECT k
    FROM dedup_dim
    WHERE state = 'selected'
    GROUP BY k
) d ON o.k * 2 = d.k;
----
logical_opt	<REGEX>:.*__duckdb_delim_[0-9]+.*

statement ok
SET debug_verify_aggregate_state_export=getvariable('dedup_original_verify_aggregate_state_export');

# Additional domain groups must not invoke a correlated table function for unreachable keys.
statement ok
CREATE TABLE dedup_function_domain(k BIGINT, step BIGINT);

statement ok
INSERT INTO dedup_function_domain VALUES (2, 1), (4, 0);

query I
SELECT (
    SELECT count(*)
    FROM generate_series(0, d.k, d.step)
)
FROM (VALUES (1)) o(k)
JOIN dedup_function_domain d ON o.k * 2 = d.k
WHERE d.k > 0;
----
3

statement ok
SET debug_verify_aggregate_state_export=false;

query II
EXPLAIN
SELECT (
    SELECT count(*)
    FROM generate_series(0, d.k, d.step)
)
FROM (VALUES (1)) o(k)
JOIN dedup_function_domain d ON o.k * 2 = d.k
WHERE d.k > 0;
----
logical_opt	<REGEX>:.*__duckdb_delim_[0-9]+.*

statement ok
SET debug_verify_aggregate_state_export=getvariable('dedup_original_verify_aggregate_state_export');

# Domain-dependent table functions take the conservative path even when every argument is valid.
statement ok
CREATE TABLE dedup_valid_function_domain(k BIGINT, step BIGINT);

statement ok
INSERT INTO dedup_valid_function_domain VALUES (2, 1), (4, 1);

query I
SELECT (
    SELECT count(*)
    FROM generate_series(0, d.k, d.step)
)
FROM (VALUES (1)) o(k)
JOIN dedup_valid_function_domain d ON o.k * 2 = d.k
WHERE d.k > 0;
----
3

statement ok
SET debug_verify_aggregate_state_export=false;

query II
EXPLAIN
SELECT (
    SELECT count(*)
    FROM generate_series(0, d.k, d.step)
)
FROM (VALUES (1)) o(k)
JOIN dedup_valid_function_domain d ON o.k * 2 = d.k
WHERE d.k > 0;
----
logical_opt	<REGEX>:.*__duckdb_delim_[0-9]+.*

statement ok
SET debug_verify_aggregate_state_export=getvariable('dedup_original_verify_aggregate_state_export');

# Additional groups must not expose scalar-subquery cardinality errors from unreachable keys.
statement ok
CREATE TABLE dedup_scalar_domain(k BIGINT);

statement ok
INSERT INTO dedup_scalar_domain VALUES (2), (4);

statement ok
CREATE TABLE dedup_scalar_values(k BIGINT, v BIGINT);

statement ok
INSERT INTO dedup_scalar_values VALUES (2, 10), (4, 20), (4, 30);

query I
SELECT (
    SELECT sum((SELECT v FROM dedup_scalar_values s WHERE s.k = d.k))
    FROM (VALUES (1)) unused(x)
)
FROM (VALUES (1)) o(k)
JOIN dedup_scalar_domain d ON o.k * 2 = d.k
WHERE d.k > 0;
----
10

statement ok
SET debug_verify_aggregate_state_export=false;

query II
EXPLAIN
SELECT (
    SELECT sum((SELECT v FROM dedup_scalar_values s WHERE s.k = d.k))
    FROM (VALUES (1)) unused(x)
)
FROM (VALUES (1)) o(k)
JOIN dedup_scalar_domain d ON o.k * 2 = d.k
WHERE d.k > 0;
----
logical_opt	<REGEX>:.*__duckdb_delim_[0-9]+.*

