# name: test/optimizer/sum_rewrite_subtract_grouped.test
# description: SUM(x - C), SUM(C - x) and grouped SUM(x +/- C) are rewritten to SUM(x) and COUNT(x)
# group: [optimizer]

statement ok
CREATE TABLE t(g INTEGER, x INTEGER);

statement ok
INSERT INTO t VALUES (1, 10), (1, NULL), (1, 20), (2, NULL);

query II
EXPLAIN ANALYZE SELECT sum(x - 1), sum(5 - x) FROM t;
----
analyzed_plan	<!REGEX>:.*(x - 1|5 - x).*

query II
SELECT sum(x - 1), sum(5 - x) FROM t;
----
28	-20

# grouped sums of the same x share SUM(x) and COUNT(x)
query II
EXPLAIN ANALYZE SELECT g, sum(x + 1), sum(3 - x) FROM t GROUP BY g;
----
analyzed_plan	<!REGEX>:.*(x \+ 1|3 - x).*

query III
SELECT g, sum(x + 1), sum(3 - x) FROM t GROUP BY g ORDER BY g;
----
1	32	-24
2	NULL	NULL

# a lone grouped sum is not rewritten
query II
EXPLAIN ANALYZE SELECT g, sum(x + 1) FROM t GROUP BY g;
----
analyzed_plan	<REGEX>:.*x \+ 1.*

# unsigned subtraction is not rewritten, so its underflow error is preserved
statement ok
CREATE TABLE u AS SELECT 1::UINTEGER AS x;

statement error
SELECT sum(x - 5) FROM u;
----
<REGEX>:Out of Range Error:.*Overflow in subtraction.*
