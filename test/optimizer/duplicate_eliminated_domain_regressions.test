# Selected evidence restrictions must reach nested scalar domains. Otherwise the
# nested aggregate is evaluated globally after generated-domain cleanup.
statement ok
CREATE TABLE dedup_reg_evidence_outer(k INTEGER, selected BOOLEAN);

statement ok
