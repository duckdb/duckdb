# A duplicate-free nested scalar aggregate cannot force materialization of the complete join-condition payload.
statement ok
CREATE TABLE dedup_reg_nested_users(id INTEGER);

statement ok
INSERT INTO dedup_reg_nested_users VALUES (1), (1), (2), (NULL);

statement ok
CREATE TABLE dedup_reg_nested_posts(id INTEGER, owner_user_id INTEGER);

statement ok
INSERT INTO dedup_reg_nested_posts VALUES (10, 1), (11, NULL), (12, 2);

statement ok
CREATE TABLE dedup_reg_nested_comments(post_id INTEGER);

statement ok
INSERT INTO dedup_reg_nested_comments VALUES (10), (10), (12);

statement ok
CREATE VIEW dedup_reg_nested_scalar_domain AS
WITH keyed AS MATERIALIZED (
    SELECT p.id, p.owner_user_id,
           (SELECT count(*) FROM dedup_reg_nested_comments c WHERE c.post_id = p.id) AS comment_count
    FROM dedup_reg_nested_posts p
), grouped AS (
    SELECT id, max(comment_count) AS max_comments FROM keyed GROUP BY id
)
SELECT u.id AS user_id, g.id AS post_id
FROM dedup_reg_nested_users u
JOIN grouped g ON u.id = (SELECT owner_user_id FROM keyed k WHERE k.id = g.id)
WHERE u.id IS NULL OR u.id > 0 OR g.max_comments > 0;

query II rowsort
SELECT * FROM dedup_reg_nested_scalar_domain;
----
1	10
1	10
2	12

statement ok
CREATE VIEW dedup_reg_nested_scalar_domain_nullsafe AS
WITH keyed AS MATERIALIZED (
    SELECT p.id, p.owner_user_id,
           (SELECT count(*) FROM dedup_reg_nested_comments c WHERE c.post_id = p.id) AS comment_count
    FROM dedup_reg_nested_posts p
), grouped AS (
    SELECT id, max(comment_count) AS max_comments FROM keyed GROUP BY id
)
SELECT u.id AS user_id, g.id AS post_id
FROM dedup_reg_nested_users u
JOIN grouped g ON u.id IS NOT DISTINCT FROM (SELECT owner_user_id FROM keyed k WHERE k.id = g.id)
WHERE u.id IS NULL OR u.id > 0 OR g.max_comments > 0;

