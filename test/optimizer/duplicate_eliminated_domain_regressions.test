# SUM, AVG, and COUNT in a pair-dependent join predicate retain empty-group
# semantics through a filtered CTE that is reused by all three subqueries.
statement ok
SET debug_verify_aggregate_state_export=false;

statement ok
CREATE TABLE dedup_reg_scalar_expected(k INTEGER, expected_sum BIGINT, expected_avg DOUBLE, expected_count BIGINT);

statement ok
INSERT INTO dedup_reg_scalar_expected VALUES (1, 6, 3, 2), (2, NULL, NULL, 0), (3, 5, 5, 1);

statement ok
CREATE TABLE dedup_reg_scalar_dimension(k INTEGER);

statement ok
INSERT INTO dedup_reg_scalar_dimension VALUES (1), (2), (3);

statement ok
CREATE TABLE dedup_reg_scalar_measure(k INTEGER, v INTEGER, selected BOOLEAN);

statement ok
INSERT INTO dedup_reg_scalar_measure VALUES (1, 2, true), (1, 4, true), (3, 5, true), (2, 99, false);

statement ok
CREATE VIEW dedup_reg_scalar_aggregate_join AS
WITH filtered_measure AS MATERIALIZED (
    SELECT k, v FROM dedup_reg_scalar_measure WHERE selected
)
SELECT o.k
FROM dedup_reg_scalar_expected o
JOIN dedup_reg_scalar_dimension d ON
    o.k = d.k
    AND o.expected_sum IS NOT DISTINCT FROM (
        SELECT sum(m.v) FROM filtered_measure m WHERE m.k = d.k
    )
    AND o.expected_avg IS NOT DISTINCT FROM (
        SELECT avg(m.v) FROM filtered_measure m WHERE m.k = d.k
    )
    AND o.expected_count = (
        SELECT count(*) FROM filtered_measure m WHERE m.k = d.k
    );

