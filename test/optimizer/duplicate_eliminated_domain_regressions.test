# Reused UNNEST CTEs retain tag multiplicity and ordered aggregate results.
statement ok
CREATE TABLE dedup_reg_tag_lists(post_id INTEGER, tags VARCHAR[]);

statement ok
INSERT INTO dedup_reg_tag_lists VALUES
    (10, ['sql', 'db', 'db']),
    (11, ['sql', NULL]),
    (12, ['db']),
    (14, [NULL]);

statement ok
CREATE VIEW dedup_reg_reused_unnest AS
WITH ranked_posts AS (
    SELECT p.id AS post_id, p.title, p.creation_date, p.score, p.view_count, p.tags,
           row_number() OVER (PARTITION BY p.tags ORDER BY p.creation_date DESC) AS tag_rank
    FROM dedup_reg_posts p
    JOIN dedup_reg_users u ON p.owner_user_id = u.id
    WHERE p.post_type_id = 1
), filtered_posts AS (
    SELECT post_id, title, creation_date, score, view_count, tags
    FROM ranked_posts WHERE tag_rank <= 5
), post_tags AS (
    SELECT fp.post_id, unnest(tl.tags) AS tag
    FROM filtered_posts fp
    JOIN dedup_reg_tag_lists tl ON fp.post_id = tl.post_id
), tag_usage AS (
    SELECT tag, count(*) AS post_count, avg(fp.view_count) AS avg_views, avg(fp.score) AS avg_score
    FROM post_tags pt JOIN filtered_posts fp ON pt.post_id = fp.post_id
    GROUP BY tag
)
SELECT tu.tag, tu.post_count, tu.avg_views, tu.avg_score,
       string_agg(fp.title, ', ' ORDER BY fp.view_count DESC) AS related_posts
FROM tag_usage tu
JOIN filtered_posts fp ON EXISTS (
    SELECT 1 FROM post_tags pt WHERE pt.post_id = fp.post_id AND pt.tag = tu.tag
)
GROUP BY tu.tag, tu.post_count, tu.avg_views, tu.avg_score;

query TIRRT rowsort
SELECT * FROM dedup_reg_reused_unnest;
----
db	3	900.0	9.0	first, third
sql	2	750.0	7.5	first, second

# Generated-domain cleanup must inspect joins inside CTEs synthesized by required lowering.
query II
EXPLAIN SELECT * FROM dedup_reg_reused_unnest;
----
logical_opt	<!REGEX>:.*CTE Name: __duckdb_delim_.*

# A factored domain may not expand through a pair-dependent outer-join consumer.
statement ok
CREATE VIEW dedup_reg_outer_join_domain AS
WITH v AS (
    SELECT u.id AS user_id, count(v.id) AS n
    FROM dedup_reg_users u
    LEFT JOIN dedup_reg_votes v ON u.id = v.user_id
    GROUP BY u.id
), u AS (
    SELECT id FROM dedup_reg_users WHERE reputation IS NOT NULL
)
SELECT u.id, h.id
FROM v JOIN u ON v.user_id = u.id
LEFT JOIN dedup_reg_history h ON h.post_id IN (
    SELECT post_id FROM dedup_reg_votes WHERE user_id = u.id
)
WHERE v.n > 5
ORDER BY u.id, h.id;

query II rowsort
SELECT * FROM dedup_reg_outer_join_domain;
----
1	1
1	2

query II
EXPLAIN SELECT * FROM dedup_reg_outer_join_domain;
----
logical_opt	<!REGEX>:.*__duckdb_duplicate_eliminated_factor_.*

query II
EXPLAIN SELECT * FROM dedup_reg_outer_join_domain;
----
logical_opt	<REGEX>:.*__duckdb_delim_[0-9]+.*

# Additional-group elimination may not cross UNNEST, windows, and ANY before reduction.
statement ok
CREATE VIEW dedup_reg_unnest_any AS
WITH tag_counts AS (
    SELECT unnest(string_to_array(trim(both '<>' FROM tags), '><')) AS tag,
           count(*) AS post_count
    FROM dedup_reg_posts
    WHERE post_type_id = 1
    GROUP BY tag
), top_tags AS (
    SELECT tag, post_count, row_number() OVER (ORDER BY post_count DESC) AS rank
    FROM tag_counts WHERE post_count > 0
), popular_users AS (
    SELECT id, display_name, reputation FROM dedup_reg_users WHERE reputation > 1000
), questions AS (
    SELECT p.id, p.view_count, u.display_name AS owner
    FROM dedup_reg_posts p
    LEFT JOIN dedup_reg_users u ON p.owner_user_id = u.id
    JOIN top_tags t ON t.tag = ANY(string_to_array(trim(both '<>' FROM p.tags), '><'))
    WHERE p.post_type_id = 1
)
SELECT q.id
FROM questions q
JOIN popular_users u ON q.owner = u.display_name
WHERE u.reputation > 5000
ORDER BY q.id;

