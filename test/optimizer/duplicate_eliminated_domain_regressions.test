statement ok
CREATE TABLE dedup_reg_in_evidence(post_id INTEGER, user_id INTEGER);

statement ok
INSERT INTO dedup_reg_in_evidence VALUES
    (1, NULL), (1, NULL), (1, NULL), (1, NULL), (1, NULL), (1, NULL),
    (3, 1), (3, 1), (3, 1), (3, 1), (3, 1), (3, 1);

statement ok
CREATE VIEW dedup_reg_pair_in_semantics AS
WITH matches AS (
    SELECT p.id,
           p.probe IN (
               SELECT user_id FROM dedup_reg_in_evidence e
               WHERE e.post_id = p.id
               GROUP BY user_id
               HAVING count(*) > 5
           ) AS matched
    FROM dedup_reg_in_probes p
)
SELECT id,
       CASE WHEN matched THEN 'true' WHEN matched IS NULL THEN 'null' ELSE 'false' END AS match_state
FROM matches;

