# Pair-dependent IN retains grouped evidence, duplicates, NULLs, and empty evidence.
statement ok
CREATE VIEW dedup_reg_pair_in AS
SELECT p.id, u.id
FROM dedup_reg_posts p
JOIN dedup_reg_users u ON u.id IN (
    SELECT user_id FROM dedup_reg_votes
    WHERE post_id = p.id
    GROUP BY user_id
    HAVING count(*) > 5
);

query II rowsort
SELECT * FROM dedup_reg_pair_in;
----
10	1

# NULL evidence and an empty evidence group retain ordinary IN three-valued logic.
statement ok
CREATE TABLE dedup_reg_in_probes(id INTEGER, probe INTEGER);

statement ok
