2	false
3	null
3	true
4	false

# A scalar aggregate in a join predicate is evaluated per correlated key.
statement ok
CREATE VIEW dedup_reg_scalar_join AS
WITH t AS (
    SELECT id, score, tags FROM dedup_reg_posts WHERE post_type_id = 1
)
SELECT p.id, u.id
FROM t p
JOIN dedup_reg_users u ON p.score = (
    SELECT max(x.score) FROM t x WHERE x.tags = p.tags
)
ORDER BY p.id, u.id;

