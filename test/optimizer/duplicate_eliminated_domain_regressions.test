# A direct positive IN marker uses the ordinary SEMI rewrite. It must not preserve
# a second selected payload CTE around the nested evidence domain.
statement ok
CREATE VIEW dedup_reg_positive_nested_in AS
SELECT d.k,
	       (SELECT sum(1)
        FROM dedup_reg_evidence_inner u
        WHERE u.k IN (
            SELECT t.k
            FROM dedup_reg_evidence_middle t
            WHERE t.k = d.k AND t.selected
        )) AS match_count
FROM dedup_reg_evidence_outer d
WHERE d.selected;

