# Wide aggregate/projection output retains its type through two scalar predicates.
statement ok
CREATE VIEW dedup_reg_optional_projection AS
WITH r AS (
    SELECT p.id AS post_id, p.title, p.score, p.view_count,
           row_number() OVER (PARTITION BY p.post_type_id ORDER BY p.score DESC) AS rank
    FROM dedup_reg_posts p
    WHERE p.creation_date >= DATE '2024-10-01' - INTERVAL '30 days'
), t AS (
    SELECT post_id, title, score, view_count FROM r WHERE rank <= 5
), s AS (
    SELECT u.id AS user_id, u.display_name,
           count(DISTINCT p.id) AS total_posts,
           count(DISTINCT c.id) AS total_comments,
           coalesce(sum(v.bounty_amount), 0) AS total_bounties
    FROM dedup_reg_users u
    LEFT JOIN dedup_reg_posts p ON u.id = p.owner_user_id
    LEFT JOIN dedup_reg_comments c ON p.id = c.post_id
    LEFT JOIN dedup_reg_votes v ON p.id = v.post_id AND v.vote_type_id = 8
    GROUP BY u.id, u.display_name
), e AS (
    SELECT t.post_id, t.view_count,
           CASE WHEN s.total_posts IS NULL THEN 'No User' ELSE s.display_name END AS label
    FROM t LEFT JOIN s ON t.post_id = s.user_id
)
SELECT post_id, typeof(post_id)
FROM e
WHERE view_count > (SELECT avg(view_count) FROM dedup_reg_posts)
  AND (SELECT count(*) FROM dedup_reg_comments c WHERE c.post_id = e.post_id) > (
      SELECT avg((SELECT count(*) FROM dedup_reg_comments c2 WHERE c2.post_id = p.id))
      FROM dedup_reg_posts p WHERE p.post_type_id = 1
  );

query IT rowsort
SELECT * FROM dedup_reg_optional_projection;
----
10	INTEGER

# Windowed projected columns remain bound through an UNNEST-derived ANY join.
statement ok
CREATE VIEW dedup_reg_window_any AS
WITH r AS (
    SELECT id, owner_user_id, title, score, row_number() OVER (ORDER BY score) AS r1
    FROM dedup_reg_posts
), p AS (
    SELECT unnest(string_to_array(tags, '>')) AS tag
    FROM dedup_reg_posts
    GROUP BY tag
), t AS (
    SELECT r.id, r.title, u.id AS user_id, row_number() OVER (ORDER BY r.score) AS r2
    FROM r JOIN dedup_reg_users u ON r.owner_user_id = u.id
    WHERE r1 <= 4
)
SELECT t.id, t.user_id
FROM t JOIN p ON p.tag = ANY(string_to_array(t.title, '>'))
WHERE t.r2 <= 10;

query II rowsort
SELECT * FROM dedup_reg_window_any;
----

# Required CTE lowering preserves projected aggregate output types.
statement ok
CREATE VIEW dedup_reg_required_projection AS
WITH ranked_posts AS (
    SELECT p.id, p.owner_user_id,
           row_number() OVER (PARTITION BY p.owner_user_id ORDER BY p.score DESC) AS post_rank
    FROM dedup_reg_posts p
    WHERE p.creation_date > TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '1 year'
), user_scores AS (
    SELECT u.id AS user_id,
           sum(CASE WHEN v.vote_type_id = 2 THEN 1 ELSE 0 END) AS upvote_count,
           count(DISTINCT b.id) AS badge_count,
           coalesce(sum(CASE WHEN p.accepted_answer_id IS NOT NULL THEN 1 ELSE 0 END), 0) AS accepted_answers
    FROM dedup_reg_users u
    LEFT JOIN dedup_reg_votes v ON u.id = v.user_id
    LEFT JOIN dedup_reg_badges b ON u.id = b.user_id
    LEFT JOIN dedup_reg_posts p ON u.id = p.owner_user_id
    GROUP BY u.id
), post_details AS (
    SELECT rp.id AS post_id, us.upvote_count, us.badge_count, us.accepted_answers
    FROM ranked_posts rp
    JOIN user_scores us ON rp.owner_user_id = us.user_id
    WHERE rp.post_rank <= 5
)
SELECT pd.post_id, typeof(pd.upvote_count), typeof(pd.accepted_answers)
FROM post_details pd
LEFT JOIN dedup_reg_history ph ON pd.post_id = ph.post_id
    AND ph.creation_date = (
        SELECT max(creation_date) FROM dedup_reg_history WHERE post_id = pd.post_id
    )
ORDER BY pd.post_id;

