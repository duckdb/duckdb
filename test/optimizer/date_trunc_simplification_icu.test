# name: test/optimizer/date_trunc_simplification_icu.test
# description: test DATE_TRUNC() constant simplifications that require icu
# group: [optimizer]

require icu

statement ok
set Calendar='gregorian';

#
# check operation with hour offsets that aren't complete hours
#

statement ok
create table test(d TIMESTAMPTZ);

statement ok
insert into test values ('2025-01-01 01:01:00+02:10'), ('2025-01-10 19:00:00-06:45');

statement ok
set timezone='utc';

query I
select * from test where date_trunc('day', d) < '2025-01-01'::TIMESTAMPTZ;
----
2024-12-31 22:51:00+00

query I
select * from test where date_trunc('day', d) >= '2025-01-01'::TIMESTAMPTZ;
----
2025-01-11 01:45:00+00

query I
select * from test where date_trunc('day', d) <= '2025-01-10'::TIMESTAMPTZ;
----
2024-12-31 22:51:00+00

query I
select * from test where date_trunc('day', d) > '2025-01-10'::TIMESTAMPTZ;
----
2025-01-11 01:45:00+00

#
# check correctness on DST edge cases using the St. Johns timezone
#

statement ok
set TimeZone='America/St_Johns';

statement ok
create table test2(d TIMESTAMPTZ);

statement ok
insert into test2 values ('2025-03-09T01:05:00'),
                         ('2025-03-09T03:05:00'),
                         ('2025-11-02T00:30:00'),
                         ('2025-11-02T01:30:00');

query I
select * from test2 where date_trunc('hour', d) < '2025-03-09T05:00:00+00'::TIMESTAMPTZ;
----
2025-03-09 01:05:00-03:30

query I
select * from test2 where date_trunc('hour', d) <= '2025-03-09T05:30:00+00'::TIMESTAMPTZ;
----
2025-03-09 01:05:00-03:30
2025-03-09 03:05:00-02:30

query I
select * from test2 where date_trunc('hour', d) > '2025-11-02T03:30:00+00'::TIMESTAMPTZ;
----
2025-11-02 01:30:00-03:30

query I
select * from test2 where date_trunc('hour', d) > '2025-11-02T02:30:00+00'::TIMESTAMPTZ;
----
2025-11-02 01:30:00-03:30

query I
select * from test2 where date_trunc('hour', d) >= '2025-11-02T02:30:00+00'::TIMESTAMPTZ;
----
2025-11-02 00:30:00-02:30
2025-11-02 01:30:00-03:30

#
# truncating to a minute or longer can cross a change of UTC offset
#

# at a fall-back, 01:30 EDT truncates to 01:00 EST, after it
statement ok
set TimeZone='America/New_York';

statement ok
create table test3 as select TIMESTAMPTZ '2021-11-07 04:00:00+00' + INTERVAL (i) MINUTE AS d from range(240) r(i);

query I
select count(*) from test3 where date_trunc('hour', d) >= '2021-11-07 06:00:00+00'::TIMESTAMPTZ and date_trunc('hour', d) <= '2021-11-07 07:00:00+00'::TIMESTAMPTZ;
----
180

# Monrovia went from -00:44:30 to +00 at 00:44:30 UTC, so 00:44:30 to 00:44:59 UTC truncate to the minute 00:44:00 UTC
statement ok
set TimeZone='Africa/Monrovia';

statement ok
create table test4 as select TIMESTAMPTZ '1972-01-07 00:40:00+00' + INTERVAL (i) SECOND AS d from range(600) r(i);

query I
select count(*) from test4 where date_trunc('minute', d) >= '1972-01-07 00:44:00+00'::TIMESTAMPTZ;
----
330

# offsets are whole seconds, so a second or finer is still rewritten
query II
explain select count(*) from test4 where date_trunc('second', d) >= '1972-01-07 00:44:00+00'::TIMESTAMPTZ;
----
physical_plan	<!REGEX>:.*date_trunc\(.*

# ICU truncates TIMESTAMPTZ_NS in the session time zone too
statement ok
set TimeZone='America/New_York';

statement ok
create table test3_ns as select cast(TIMESTAMPTZ '2021-11-07 04:00:00+00' + INTERVAL (i) MINUTE as TIMESTAMPTZ_NS) AS d from range(240) r(i);

query I
select count(*) from test3_ns where date_trunc('hour', d) >= '2021-11-07 06:00:00+00'::TIMESTAMPTZ and date_trunc('hour', d) <= '2021-11-07 07:00:00+00'::TIMESTAMPTZ;
----
180

statement ok
set TimeZone='Africa/Monrovia';

statement ok
create table test4_ns as select cast(TIMESTAMPTZ '1972-01-07 00:40:00+00' + INTERVAL (i) SECOND as TIMESTAMPTZ_NS) AS d from range(600) r(i);

query I
select count(*) from test4_ns where date_trunc('minute', d) >= '1972-01-07 00:44:00+00'::TIMESTAMPTZ;
----
330

#
# truncation that follows the local time is not monotone, so statistics must not prune the comparison either
#

# Magadan fell back two hours: 01:30+12 truncates to 01:00+10, after the truncation of the later 00:30+10
statement ok
set TimeZone='Asia/Magadan';

statement ok
create table test5 as select unnest([TIMESTAMPTZ '2014-10-25 13:30:00+00', TIMESTAMPTZ '2014-10-25 14:30:00+00', TIMESTAMPTZ '2014-10-25 16:00:00+00']) AS d;

query I
select count(*) from test5 where date_trunc('hour', d) = '2014-10-25 14:00:00+00'::TIMESTAMPTZ;
----
1

query I
select count(*) from test5 where date_trunc('hour', d) <= '2014-10-25 14:00:00+00'::TIMESTAMPTZ;
----
1

# Casey fell back from 02:00 to 23:00 of the day before, so the local date moves backwards
statement ok
set TimeZone='Antarctica/Casey';

statement ok
create table test6 as select unnest([TIMESTAMPTZ '2010-03-04 14:30:00+00', TIMESTAMPTZ '2010-03-04 15:30:00+00']) AS d;

query I
select count(*) from test6 where date_trunc('day', d) >= '2010-03-04 00:00:00+00'::TIMESTAMPTZ;
----
1

query I
select count(*) from test6 where date_trunc('hour', d) >= '2010-03-04 16:00:00+00'::TIMESTAMPTZ;
----
1

#
# check comparisons with infinity
#

statement ok
create table infinity_tz_test(d TIMESTAMPTZ);

statement ok
insert into infinity_tz_test values ('-infinity'), ('2025-01-01'), ('infinity'), (NULL);

query IIIIII
select date_trunc('day', d) = 'infinity'::TIMESTAMPTZ,
       date_trunc('day', d) != 'infinity'::TIMESTAMPTZ,
       date_trunc('day', d) < 'infinity'::TIMESTAMPTZ,
       date_trunc('day', d) <= 'infinity'::TIMESTAMPTZ,
       date_trunc('day', d) > 'infinity'::TIMESTAMPTZ,
       date_trunc('day', d) >= 'infinity'::TIMESTAMPTZ
from infinity_tz_test
order by d;
----
false	true	true	true	false	false
false	true	true	true	false	false
true	false	false	true	false	true
NULL	NULL	NULL	NULL	NULL	NULL

# the year check of the constant does not need a TIMESTAMPTZ to DATE cast
statement ok
SET TimeZone = 'UTC';

statement ok
CREATE TABLE trunc_values(stamp TIMESTAMPTZ);

statement ok
INSERT INTO trunc_values VALUES (TIMESTAMPTZ '2024-06-15 00:00:00+00');

statement ok
SET disable_timestamptz_casts = true;

query I
SELECT count(*) FROM trunc_values WHERE date_trunc('century', stamp) = TIMESTAMPTZ '2000-01-01 00:00:00+00';
----
1

statement ok
RESET disable_timestamptz_casts;
