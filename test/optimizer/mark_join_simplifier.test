# name: test/optimizer/mark_join_simplifier.test
# description: Explicit MARK simplification retains existing conversions and optimizer gates
# group: [optimizer]

statement ok
SET explain_output='optimized_only';

statement ok
CREATE TABLE mark_probe AS SELECT i AS a FROM range(100) t(i);

statement ok
CREATE TABLE mark_build AS SELECT i AS b FROM range(10) t(i);

query II
EXPLAIN SELECT a FROM mark_probe WHERE a IN (SELECT b FROM mark_build);
----
logical_opt	<REGEX>:.*SEMI.*

query II
EXPLAIN SELECT a FROM mark_probe WHERE EXISTS (SELECT 1 FROM mark_build WHERE a IS NOT DISTINCT FROM b);
----
logical_opt	<REGEX>:.*SEMI.*Conditions:.* = .*

query II
EXPLAIN SELECT a FROM mark_probe WHERE NOT EXISTS (SELECT 1 FROM mark_build WHERE a IS NOT DISTINCT FROM b);
----
logical_opt	<REGEX>:.*ANTI.*

query II
EXPLAIN WITH c AS MATERIALIZED (SELECT a FROM mark_probe WHERE a IN (SELECT b FROM mark_build)) SELECT sum(a) FROM c UNION ALL SELECT max(a) FROM c;
----
logical_opt	<REGEX>:.*SEMI.*

query II
EXPLAIN SELECT a, m FROM (SELECT a, a IN (SELECT b FROM mark_build) AS m FROM mark_probe) WHERE m;
----
logical_opt	<REGEX>:.*MARK.*

statement ok
SET disabled_optimizers='filter_pushdown';

query II
EXPLAIN SELECT a FROM mark_probe WHERE a IN (SELECT b FROM mark_build);
----
logical_opt	<REGEX>:.*MARK.*

statement ok
RESET disabled_optimizers;
