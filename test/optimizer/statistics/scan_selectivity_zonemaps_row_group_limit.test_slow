# name: test/optimizer/statistics/scan_selectivity_zonemaps_row_group_limit.test_slow
# description: The zonemap bound of a scan estimate reads at most 16,384 row groups; a table with more row groups keeps its estimate
# group: [statistics]

statement ok
SET explain_output='physical_only';

statement ok
ATTACH '{TEST_DIR}/scan_selectivity_zonemaps_row_group_limit.db' AS rg (ROW_GROUP_SIZE 2048);

# 16,000 row groups of 2,048 rows: below the limit, every row group is checked: 1,600 and 978 row groups are left
# (actual 3,276,800 and 2,000,000 rows)
statement ok
CREATE TABLE rg.below AS SELECT range AS i, range // 1000000 AS d FROM range(32768000);

query I
SELECT count(DISTINCT row_group_id) FROM pragma_storage_info('rg.below');
----
16000

query II
EXPLAIN (FORMAT JSON) SELECT sum(d) FROM rg.below WHERE i < 3276800;
----
physical_plan	<REGEX>:[\s\S]*"SEQ_SCAN"[^}]*"Estimated Cardinality": "3276800"[\s\S]*

query II
EXPLAIN (FORMAT JSON) SELECT sum(i) FROM rg.below WHERE d >= 3 AND d <= 4;
----
physical_plan	<REGEX>:[\s\S]*"SEQ_SCAN"[^}]*"Estimated Cardinality": "2002944"[\s\S]*

# 16,386 row groups: above the limit. Every other row group matches the filter (16,779,264 rows): checking only some
# of the row groups could miss all of them, so the table is not bounded at all and keeps the estimate of the table
# statistics
statement ok
CREATE TABLE rg.above AS SELECT range AS id, (range // 2048) % 2 AS bucket FROM range(33558528);

query I
SELECT count(DISTINCT row_group_id) FROM pragma_storage_info('rg.above');
----
16386

# half of the values of [0, 1]
query II
EXPLAIN (FORMAT JSON) SELECT sum(id) FROM rg.above WHERE bucket > 0;
----
physical_plan	<REGEX>:[\s\S]*"SEQ_SCAN"[^}]*"Estimated Cardinality": "16779264"[\s\S]*

# one row group is left (2,048 rows), but the row groups are not read: the default selectivity of a range
query II
EXPLAIN (FORMAT JSON) SELECT sum(bucket) FROM rg.above WHERE id < 2048;
----
physical_plan	<REGEX>:[\s\S]*"SEQ_SCAN"[^}]*"Estimated Cardinality": "6711705"[\s\S]*

# the row groups that the transaction has added count towards the limit: 16,386 transaction-local row groups
statement ok
CREATE TABLE rg.local_rows (i BIGINT);

statement ok
BEGIN;

statement ok
INSERT INTO rg.local_rows SELECT range FROM range(33558528);

query II
EXPLAIN (FORMAT JSON) SELECT sum(i) FROM rg.local_rows WHERE i < 2048;
----
physical_plan	<REGEX>:[\s\S]*"SEQ_SCAN"[^}]*"Estimated Cardinality": "6711705"[\s\S]*

query I
SELECT count(*) FROM rg.local_rows WHERE i < 2048;
----
2048

statement ok
ROLLBACK;

query III
SELECT count(*), sum(id), (SELECT count(*) FROM rg.below WHERE i < 3276800) FROM rg.above WHERE bucket > 0;
----
16779264	281560873958400	3276800
