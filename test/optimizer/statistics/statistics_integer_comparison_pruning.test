# name: test/optimizer/statistics/statistics_integer_comparison_pruning.test
# description: Row-group pruning for integer inequality and distinct-from comparisons
# group: [statistics]

statement ok
ATTACH '{TEST_DIR}/integer_comparison.duckdb' AS db (ROW_GROUP_SIZE 2048);

statement ok
CREATE TABLE db.integers AS
SELECT CASE range // 2048 WHEN 0 THEN 1 WHEN 1 THEN 1 ELSE 2 END AS a,
       CASE range // 2048 WHEN 0 THEN 1 WHEN 1 THEN 2 ELSE 2 END AS b
FROM range(6144);

query II
EXPLAIN ANALYZE SELECT sum(a) FROM db.integers WHERE a != b;
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

query I
SELECT sum(a) FROM db.integers WHERE a != b;
----
2048

query II
EXPLAIN ANALYZE SELECT sum(a) FROM db.integers WHERE a IS DISTINCT FROM b;
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

query I
SELECT sum(a) FROM db.integers WHERE a IS DISTINCT FROM b;
----
2048

query II
EXPLAIN ANALYZE SELECT sum(a) FROM db.integers WHERE a IS NOT DISTINCT FROM b;
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 2 / 3.*

query I
SELECT sum(a) FROM db.integers WHERE a IS NOT DISTINCT FROM b;
----
6144
