# name: test/optimizer/statistics/statistics_min_max_infinity.test
# description: Issue #28985 - min/max answered from row group statistics of a column holding only infinity
# group: [statistics]

load __TEST_DIR__/statistics_min_max_infinity.db

statement ok
CREATE TABLE t (d DATE, ts TIMESTAMP);

statement ok
INSERT INTO t VALUES ('infinity', '-infinity');

statement ok
CHECKPOINT;

query IIII
SELECT min(d), max(d), min(ts), max(ts) FROM t;
----
infinity	infinity	-infinity	-infinity

foreach type DATE TIMESTAMP TIMESTAMP_S TIMESTAMP_MS TIMESTAMP_NS TIMESTAMPTZ TIMESTAMPTZ_NS

statement ok
CREATE OR REPLACE TABLE pos AS SELECT 'infinity'::{type} c FROM range(1000);

statement ok
CREATE OR REPLACE TABLE neg AS SELECT '-infinity'::{type} c FROM range(1000);

statement ok
CHECKPOINT;

query II
SELECT min(c) = 'infinity'::{type}, max(c) = 'infinity'::{type} FROM pos;
----
true	true

query II
SELECT min(c) = '-infinity'::{type}, max(c) = '-infinity'::{type} FROM neg;
----
true	true

endloop

# the finite limits of the type as actual values
statement ok
CREATE TABLE lim AS SELECT * FROM (VALUES ('5881580-07-10'::DATE), ('5877642-06-25 (BC)'::DATE)) v(d);

statement ok
CHECKPOINT;

query II
SELECT min(d), max(d) FROM lim;
----
5877642-06-25 (BC)	5881580-07-10
