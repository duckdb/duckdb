# name: test/optimizer/statistics/statistics_exp_libm.test
# description: exp must not be treated as monotone: libm exp can invert the order of adjacent doubles
# group: [statistics]

statement ok
CREATE TABLE t(x DOUBLE);

# on Apple libm exp(min) > exp(max) for this pair, which used to raise an INTERNAL error at optimize time
statement ok
INSERT INTO t VALUES (-1.1801838152580846e-11), (-1.1801837285219108e-11);

query I
SELECT count(*) FROM (SELECT exp(x) FROM t)
----
2

query II
SELECT s.min, s.max FROM (SELECT STATS(exp(x)) s FROM t LIMIT 1)
----
NULL	NULL

# with the corners in order, an interior value can still exceed exp(max); bounds derived from the
# corners used to prune the matching row away
statement ok
INSERT INTO t VALUES (-1.2e-11);

query I
SELECT count(*) FROM t WHERE exp(x) > exp(-1.1801837285219108e-11::DOUBLE)
----
1

query I
SELECT count(*) FROM t WHERE exp(x) >= (SELECT max(exp(x)) FROM t)
----
1
