# name: test/optimizer/statistics/statistics_date_sub_month.test
# description: Prune impossible whole-month differences between timestamp ranges
# group: [statistics]

statement ok
CREATE TABLE spans(s TIMESTAMP, e TIMESTAMP);

statement ok
INSERT INTO spans VALUES ('2024-01-31 18:00', '2024-03-01'), ('2024-02-02', '2024-03-28');

statement ok
SET explain_output = 'OPTIMIZED_ONLY';

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

query II
EXPLAIN SELECT * FROM spans WHERE date_sub('month', TIMESTAMP '2024-01-15', e) < 0;
----
logical_opt	<REGEX>:.*EMPTY_RESULT.*

query II
EXPLAIN SELECT * FROM spans WHERE date_sub('months', s, e) > 2;
----
logical_opt	<REGEX>:.*EMPTY_RESULT.*

query II
EXPLAIN SELECT * FROM spans WHERE date_sub('month', e, s) < -2;
----
logical_opt	<REGEX>:.*EMPTY_RESULT.*
