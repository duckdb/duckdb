# name: test/optimizer/statistics/scan_selectivity_zonemaps.test
# description: The estimate of a table scan is bounded by the rows of the row groups whose zonemaps can satisfy its table filters
# group: [statistics]

# The scan skips every row group whose min/max statistics cannot satisfy the pushed-down filters. The estimate of
# the scan is bounded by the rows of the row groups that are left. A row group that cannot be skipped counts
# whole, and the bound never raises an estimate.

statement ok
SET threads=4;

statement ok
SET explain_output='physical_only';

# i is sorted (one row group = 122,880 consecutive values), d has 100,000 rows per value in order (one or two row
# groups per value), u is a permutation of i (every row group spans the whole range), c10 cycles, dt follows d
statement ok
CREATE TABLE t AS SELECT range AS i, range // 100000 AS d, (range * 7919) % 5000000 AS u, range % 10 AS c10, DATE '2000-01-01' + (range // 100000)::INTEGER AS dt FROM range(5000000);

# ---------------------------------------------------------------------------------------------------------------
# no row group can be skipped: the estimate is the one of the table statistics, where the default selectivity of
# 0.2 is the floor of a range
# ---------------------------------------------------------------------------------------------------------------

# a range on the permuted column: every row group intersects it (actual 300,000)
query II
EXPLAIN (FORMAT JSON) SELECT sum(c10) FROM t WHERE u < 300000;
----
physical_plan	<REGEX>:[\s\S]*"SEQ_SCAN"[^}]*"Estimated Cardinality": "1000000"[\s\S]*

# ---------------------------------------------------------------------------------------------------------------
# row groups are skipped: the estimate is at most the rows of the ones that are left
# ---------------------------------------------------------------------------------------------------------------

# the same range on the sorted column: three row groups are left (actual 300,000)
query II
EXPLAIN (FORMAT JSON) SELECT sum(c10) FROM t WHERE i < 300000;
----
physical_plan	<REGEX>:[\s\S]*"SEQ_SCAN"[^}]*"Estimated Cardinality": "368640"[\s\S]*

# a range inside one row group: the row group counts whole (actual 10)
query II
EXPLAIN (FORMAT JSON) SELECT sum(c10) FROM t WHERE i < 10;
----
physical_plan	<REGEX>:[\s\S]*"SEQ_SCAN"[^}]*"Estimated Cardinality": "122880"[\s\S]*

# a DATE range: five row groups (five days of fifty, actual 500,000)
query II
EXPLAIN (FORMAT JSON) SELECT sum(c10) FROM t WHERE dt BETWEEN DATE '2000-01-11' AND DATE '2000-01-15';
----
physical_plan	<REGEX>:[\s\S]*"SEQ_SCAN"[^}]*"Estimated Cardinality": "614400"[\s\S]*

# an open DATE range: the last five row groups (actual 500,000)
query II
EXPLAIN (FORMAT JSON) SELECT sum(c10) FROM t WHERE dt >= DATE '2000-02-15';
----
physical_plan	<REGEX>:[\s\S]*"SEQ_SCAN"[^}]*"Estimated Cardinality": "576320"[\s\S]*

# a conjunction across two columns that the statistics of the table cannot refute (d = 7 lives in rows
# 700,000..799,999, and every row group that holds it has i < 900,000): every row group is skipped (actual 0)
query II
EXPLAIN (FORMAT JSON) SELECT sum(c10) FROM t WHERE d = 7 AND i > 900000;
----
physical_plan	<REGEX>:[\s\S]*"SEQ_SCAN"[^}]*"Estimated Cardinality": "1"[\s\S]*

# two ranges, on the sorted column and on the permuted one: the first leaves five row groups, the second skips
# none of them (actual 250,044)
query II
EXPLAIN (FORMAT JSON) SELECT sum(c10) FROM t WHERE i BETWEEN 1000000 AND 1499999 AND u < 2500000;
----
physical_plan	<REGEX>:[\s\S]*"SEQ_SCAN"[^}]*"Estimated Cardinality": "614400"[\s\S]*

# ---------------------------------------------------------------------------------------------------------------
# the bound never raises an estimate
# ---------------------------------------------------------------------------------------------------------------

# nine row groups are left (1,105,920 rows, actual 1,000,000): the estimate of the table statistics is lower and
# stands
query II
EXPLAIN (FORMAT JSON) SELECT sum(c10) FROM t WHERE i BETWEEN 1000000 AND 1999999;
----
physical_plan	<REGEX>:[\s\S]*"SEQ_SCAN"[^}]*"Estimated Cardinality": "1000000"[\s\S]*

# five row groups with one DOUBLE value each (0.0 .. 4.0): three of them are left (368,640 rows, the actual
# count), the estimate of the table statistics (0.2 of 614,400) is lower and stands
statement ok
CREATE TABLE constant_groups AS SELECT (range // 122880)::DOUBLE AS x, (range // 122880)::INTEGER AS k FROM range(614400);

query II
EXPLAIN (FORMAT JSON) SELECT sum(k) FROM constant_groups WHERE x < 2.5;
----
physical_plan	<REGEX>:[\s\S]*"SEQ_SCAN"[^}]*"Estimated Cardinality": "122880"[\s\S]*

# ---------------------------------------------------------------------------------------------------------------
# the results of the queries above
# ---------------------------------------------------------------------------------------------------------------

query IIIIIII
SELECT (SELECT count(*) FROM t WHERE u < 300000), (SELECT count(*) FROM t WHERE i < 300000), (SELECT count(*) FROM t WHERE i < 10), (SELECT count(*) FROM t WHERE dt BETWEEN DATE '2000-01-11' AND DATE '2000-01-15'), (SELECT count(*) FROM t WHERE dt >= DATE '2000-02-15'), (SELECT count(*) FROM t WHERE d = 7 AND i > 900000), (SELECT count(*) FROM t WHERE i BETWEEN 1000000 AND 1499999 AND u < 2500000);
----
300000	300000	10	500000	500000	0	250044

query II
SELECT (SELECT count(*) FROM t WHERE i BETWEEN 1000000 AND 1999999), (SELECT count(*) FROM constant_groups WHERE x < 2.5);
----
1000000	368640

# ---------------------------------------------------------------------------------------------------------------
# the row groups are counted with the rows that the transaction can see
# ---------------------------------------------------------------------------------------------------------------

# rows that the transaction has inserted are counted
statement ok
BEGIN;

statement ok
INSERT INTO t SELECT range + 5000000, 50, 0, 0, DATE '2000-01-01' FROM range(200000);

query II
EXPLAIN (FORMAT JSON) SELECT sum(c10) FROM t WHERE i >= 5000000;
----
physical_plan	<REGEX>:[\s\S]*"SEQ_SCAN"[^}]*"Estimated Cardinality": "200000"[\s\S]*

query I
SELECT count(*) FROM t WHERE i >= 5000000;
----
200000

statement ok
ROLLBACK;

# an update widens the zonemap of its row group at once, also before it is committed: the last row group (84,800
# rows) now starts at 10 and cannot be skipped, next to the first one (actual 101)
statement ok
BEGIN;

statement ok
UPDATE t SET i = 10 WHERE i = 4999999;

query II
EXPLAIN (FORMAT JSON) SELECT sum(c10) FROM t WHERE i < 100;
----
physical_plan	<REGEX>:[\s\S]*"SEQ_SCAN"[^}]*"Estimated Cardinality": "207680"[\s\S]*

query I
SELECT count(*) FROM t WHERE i < 100;
----
101

statement ok
ROLLBACK;

query I
SELECT count(*) FROM t WHERE i < 100;
----
100

# rows that the transaction has deleted are not counted; after a rollback they are counted again. The last
# 699,200 rows are exactly the row groups from the 36th on
statement ok
BEGIN;

statement ok
DELETE FROM t WHERE i >= 4300800;

query II
EXPLAIN (FORMAT JSON) SELECT sum(c10) FROM t WHERE i >= 4300800;
----
physical_plan	<REGEX>:[\s\S]*"SEQ_SCAN"[^}]*"Estimated Cardinality": "1"[\s\S]*

query I
SELECT count(*) FROM t WHERE i >= 4300800;
----
0

statement ok
ROLLBACK;

query II
EXPLAIN (FORMAT JSON) SELECT sum(c10) FROM t WHERE i >= 4300800;
----
physical_plan	<REGEX>:[\s\S]*"SEQ_SCAN"[^}]*"Estimated Cardinality": "699200"[\s\S]*

query I
SELECT count(*) FROM t WHERE i >= 4300800;
----
699200

# a transaction that started before a delete of another connection was committed still sees the rows, and
# its estimate still counts them
statement ok con1
BEGIN;

query I con1
SELECT count(*) FROM t WHERE i >= 4300800;
----
699200

statement ok con2
DELETE FROM t WHERE i >= 4300800;

query II con1
EXPLAIN (FORMAT JSON) SELECT sum(c10) FROM t WHERE i >= 4300800;
----
physical_plan	<REGEX>:[\s\S]*"SEQ_SCAN"[^}]*"Estimated Cardinality": "699200"[\s\S]*

query I con1
SELECT count(*) FROM t WHERE i >= 4300800;
----
699200

statement ok con1
COMMIT;

# once the delete is visible the row groups are empty for the transaction (actual 0). After a restart the deletes
# of a row group are not loaded until a scan needs them: such a row group is counted with all of its rows
query II con1
EXPLAIN (FORMAT JSON) SELECT sum(c10) FROM t WHERE i >= 4300800;
----
physical_plan	<REGEX>:[\s\S]*"SEQ_SCAN"[^}]*"Estimated Cardinality": "(1|699200)"[\s\S]*

query I con1
SELECT count(*) FROM t WHERE i >= 4300800;
----
0
