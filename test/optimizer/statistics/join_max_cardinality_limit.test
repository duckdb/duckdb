# name: test/optimizer/statistics/join_max_cardinality_limit.test
# description: Join max cardinality must bound every join type correctly so necessary LIMITs are not removed
# group: [statistics]

statement ok
CREATE TABLE l AS SELECT range AS x FROM range(5);

statement ok
CREATE TABLE e (y BIGINT);

query I
SELECT count(*) FROM (SELECT x FROM l LEFT JOIN e ON e.y IS NULL LIMIT 2);
----
2

query I
SELECT count(*) FROM (SELECT x FROM l LEFT JOIN e ON x = y LIMIT 2);
----
2

# RIGHT
query I
SELECT count(*) FROM (SELECT x FROM e RIGHT JOIN l ON e.y IS NULL LIMIT 2);
----
2

# FULL OUTER
query I
SELECT count(*) FROM (SELECT x FROM l FULL OUTER JOIN e ON e.y IS NULL LIMIT 2);
----
2

query I
SELECT count(*) FROM (SELECT x FROM e FULL OUTER JOIN l ON e.y IS NULL LIMIT 2);
----
2

# SEMI
query I
SELECT count(*) FROM (SELECT x FROM l SEMI JOIN e ON e.y IS NULL LIMIT 2);
----
0

# ANTI
query I
SELECT count(*) FROM (SELECT x FROM l ANTI JOIN e ON e.y IS NULL LIMIT 2);
----
2

# MARK
query I
SELECT count(m) FROM (SELECT x IN (SELECT y FROM e) AS m FROM l LIMIT 2);
----
2

