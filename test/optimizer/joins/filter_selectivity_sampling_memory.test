# name: test/optimizer/joins/filter_selectivity_sampling_memory.test
# description: Optional filter sampling falls back when projected rows do not fit in memory
# group: [joins]

require vector_size 2048

load {TEST_DIR}/filter_selectivity_sampling_memory.db

statement ok
SET threads = 1;

statement ok
SET memory_limit = '256MB';

statement ok
CREATE TABLE t AS SELECT repeat('x', 1021) || 'xyz' AS s FROM range(2048);

statement ok
CHECKPOINT;

restart

statement ok
SET memory_limit = '1MB';

statement ok
SET filter_selectivity_sample_size = 2048;

statement ok
SET explain_output = 'optimized_only';

query II
EXPLAIN (FORMAT JSON) SELECT 1 FROM t WHERE contains(s, 'xyz') LIMIT 1;
----
logical_opt	<REGEX>:.*"Table":\s*".*\.main.t",\s*"Type":\s*"Sequential Scan",\s*"Estimated Cardinality":\s*"409".*

query I
SELECT 1 FROM t WHERE contains(s, 'xyz') LIMIT 1;
----
1

statement ok
SET memory_limit = '256MB';
