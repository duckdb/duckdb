query IT rowsort
SELECT * FROM l INTERSECT ALL SELECT * FROM empty
----

query IT rowsort
SELECT * FROM empty INTERSECT ALL SELECT * FROM l
----

query IT rowsort
SELECT * FROM empty EXCEPT ALL SELECT * FROM empty
----

query IT rowsort
SELECT * FROM l WHERE k > 100 EXCEPT ALL SELECT * FROM r
----

query IT rowsort
SELECT * FROM l INTERSECT ALL SELECT * FROM r WHERE s = 'zzz'
----

# no columns of the result are read, only some are read, a column is read twice
query I
SELECT count(*) FROM (SELECT * FROM l EXCEPT ALL SELECT * FROM r)
----
4

query T rowsort
SELECT s FROM (SELECT * FROM l INTERSECT ALL SELECT * FROM r)
----
NULL
NULL
a
b
b

