# one more join condition
query IT rowsort
SELECT l2.k, l2.s FROM (SELECT k, s, row_number() OVER (PARTITION BY k, s) AS rn FROM l) l2 SEMI JOIN (SELECT k, s, row_number() OVER (PARTITION BY k, s) AS rn FROM r) r2 ON l2.k IS NOT DISTINCT FROM r2.k AND l2.s IS NOT DISTINCT FROM r2.s AND l2.rn IS NOT DISTINCT FROM r2.rn AND l2.k < 2
----
1	a

