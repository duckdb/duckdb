# name: test/optimizer/setop_all_aggregate.test
# description: EXCEPT ALL / INTERSECT ALL as one aggregate over the UNION ALL of both inputs, where equal rows are identical, and the filters that move around the set operation
# group: [optimizer]

statement ok
CREATE TABLE l(k INTEGER, s VARCHAR);

statement ok
INSERT INTO l VALUES (1, 'a'), (1, 'a'), (1, 'a'), (2, 'b'), (2, 'b'), (NULL, NULL), (NULL, NULL), (3, NULL), (4, 'd');

statement ok
CREATE TABLE r(k INTEGER, s VARCHAR);

statement ok
INSERT INTO r VALUES (1, 'a'), (2, 'b'), (2, 'b'), (2, 'b'), (NULL, NULL), (5, 'e'), (3, NULL), (3, NULL);

statement ok
CREATE TABLE empty(k INTEGER, s VARCHAR);

statement ok
CREATE TABLE ul AS SELECT * FROM (VALUES ('a')) t(s);

statement ok
CREATE TABLE ub AS SELECT * FROM (VALUES ('b')) t(s);

statement ok
CREATE TABLE ur AS SELECT * FROM (VALUES ('A')) t(s);

statement ok
CREATE TABLE nested_l AS SELECT [k, NULL] AS ks, {'k': k, 's': [s]} AS st, [k, k]::INTEGER[2] AS arr FROM l;

statement ok
CREATE TABLE nested_r AS SELECT [k, NULL] AS ks, {'k': k, 's': [s]} AS st, [k, k]::INTEGER[2] AS arr FROM r;

statement ok
CREATE TABLE typed_l AS SELECT k::TINYINT AS k, k::DECIMAL(4,1) AS d, DATE '2024-01-01' + k AS dt, s::BLOB AS b FROM l;

statement ok
CREATE TABLE typed_r AS SELECT k::BIGINT AS k, k::DECIMAL(9,3) AS d, (DATE '2024-01-01' + k)::TIMESTAMP AS dt, s AS b FROM r;

# ---- The plan: one aggregate over the union, no window and no join ---------------------------------------------

query II
EXPLAIN SELECT * FROM l EXCEPT ALL SELECT * FROM r
----
physical_plan	<REGEX>:.*Unnest.*Unnest.*Group By.*Union.*

query II
EXPLAIN SELECT * FROM l EXCEPT ALL SELECT * FROM r
----
physical_plan	<!REGEX>:.*(Window|Join).*

query II
EXPLAIN SELECT * FROM l INTERSECT ALL SELECT * FROM r
----
physical_plan	<REGEX>:.*Unnest.*Unnest.*Group By.*Union.*

query II
EXPLAIN SELECT * FROM l INTERSECT ALL SELECT * FROM r
----
physical_plan	<!REGEX>:.*(Window|Join).*

# nested types whose leaves qualify
query II
EXPLAIN SELECT * FROM nested_l EXCEPT ALL SELECT * FROM nested_r
----
physical_plan	<REGEX>:.*Unnest.*Group By.*Union.*

# the casts of the set operation apply below the aggregate
query II
EXPLAIN SELECT * FROM typed_l INTERSECT ALL SELECT * FROM typed_r
----
physical_plan	<REGEX>:.*Unnest.*Group By.*Union.*

# both set operations of a chain
query II
EXPLAIN (SELECT * FROM l EXCEPT ALL SELECT * FROM r) INTERSECT ALL SELECT * FROM l
----
physical_plan	<REGEX>:.*Unnest.*Group By.*Union.*Unnest.*Group By.*Union.*

# ---- Filters move around the set operation before it becomes an aggregate or a join ---------------------------------

statement ok
CREATE TABLE ints_a AS SELECT range AS i, range % 7 AS j FROM range(100);

statement ok
CREATE TABLE ints_b AS SELECT range AS i, range % 5 AS j FROM range(50);

# a filter above the set operation reaches both inputs
query II
EXPLAIN SELECT * FROM (SELECT i FROM ints_a EXCEPT ALL SELECT i FROM ints_b) WHERE i = 7
----
physical_plan	<REGEX>:.*Unnest.*Group By.*Union.*Filters: i = 7.*Filters: i = 7.*

query II
EXPLAIN SELECT * FROM (SELECT i FROM ints_a INTERSECT ALL SELECT i FROM ints_b) WHERE i = 7
----
physical_plan	<REGEX>:.*Unnest.*Group By.*Union.*Filters: i = 7.*Filters: i = 7.*

query II
EXPLAIN SELECT * FROM (SELECT i, j FROM ints_a EXCEPT ALL SELECT i, j FROM ints_b) WHERE i BETWEEN 3 AND 5 AND j IN (1, 2)
----
physical_plan	<REGEX>:.*Unnest.*Group By.*Union.*Filters: \(i >= 3\) AND \(i <= 5\).*Filters: \(i >= 3\) AND \(i <= 5\).*

# a filter inside the left input reaches the right input
query II
EXPLAIN SELECT i FROM ints_a WHERE i = 7 EXCEPT ALL SELECT i FROM ints_b
----
physical_plan	<REGEX>:.*Unnest.*Group By.*Union.*Filters: i = 7.*Filters: i = 7.*

query II
EXPLAIN SELECT i FROM ints_a WHERE i = 7 INTERSECT ALL SELECT i FROM ints_b
----
physical_plan	<REGEX>:.*Unnest.*Group By.*Union.*Filters: i = 7.*Filters: i = 7.*

# a filter inside the right input reaches the left input of INTERSECT ALL, whose rows all have an equal row there ..
query II
EXPLAIN SELECT i FROM ints_a INTERSECT ALL SELECT i FROM ints_b WHERE i = 7
----
physical_plan	<REGEX>:.*Unnest.*Group By.*Union.*Filters: i = 7.*Filters: i = 7.*

# .. but not the left input of EXCEPT ALL, which keeps the rows without an equal row
query II
EXPLAIN SELECT i FROM ints_a EXCEPT ALL SELECT i FROM ints_b WHERE i = 7
----
physical_plan	<!REGEX>:.*Filters: i = 7.*Filters: i = 7.*

# the same for a set operation that becomes the join: a DOUBLE column
statement ok
CREATE TABLE dbl_a AS SELECT range::DOUBLE AS d FROM range(100);

statement ok
CREATE TABLE dbl_b AS SELECT range::DOUBLE AS d FROM range(50);

query II
EXPLAIN SELECT * FROM (SELECT d FROM dbl_a EXCEPT ALL SELECT d FROM dbl_b) WHERE d = 7
----
physical_plan	<REGEX>:.*Join.*Filters: d = 7.0.*Filters: d = 7.0.*

query II
EXPLAIN SELECT d FROM dbl_a WHERE d = 7 INTERSECT ALL SELECT d FROM dbl_b
----
physical_plan	<REGEX>:.*Join.*Filters: d = 7.0.*Filters: d = 7.0.*

query II
EXPLAIN SELECT d FROM dbl_a INTERSECT ALL SELECT d FROM dbl_b WHERE d = 7
----
physical_plan	<REGEX>:.*Join.*Filters: d = 7.0.*Filters: d = 7.0.*

query II
EXPLAIN SELECT d FROM dbl_a EXCEPT ALL SELECT d FROM dbl_b WHERE d = 7
----
physical_plan	<!REGEX>:.*Filters: d = 7.0.*Filters: d = 7.0.*

# ---- Few distinct rows with many copies keep the join ---------------------------------------------------------------

# the few groups of the aggregate could not feed all threads with the rows they expand to
statement ok
CREATE TABLE few_groups AS SELECT (range % 3)::INTEGER AS g, range AS u FROM range(100000);

statement ok
SET threads = 4;

query II
EXPLAIN SELECT g FROM few_groups EXCEPT ALL SELECT g FROM few_groups WHERE u < 10
----
physical_plan	<REGEX>:.*Join.*Window.*

query II
EXPLAIN SELECT g, g + 1, 'x' FROM few_groups INTERSECT ALL SELECT g, g + 1, 'x' FROM few_groups WHERE u < 10
----
physical_plan	<!REGEX>:.*Unnest.*

# many groups, or one thread: the aggregate
query II
EXPLAIN SELECT u FROM few_groups EXCEPT ALL SELECT u FROM few_groups WHERE u < 10
----
physical_plan	<REGEX>:.*Unnest.*Group By.*Union.*

query II
EXPLAIN SELECT g, u FROM few_groups EXCEPT ALL SELECT g, u FROM few_groups WHERE u < 10
----
physical_plan	<REGEX>:.*Unnest.*Group By.*Union.*

statement ok
SET threads = 1;

query II
EXPLAIN SELECT g FROM few_groups EXCEPT ALL SELECT g FROM few_groups WHERE u < 10
----
physical_plan	<REGEX>:.*Unnest.*Group By.*Union.*

query II
SELECT g, count(*) FROM (SELECT g FROM few_groups EXCEPT ALL SELECT g FROM few_groups WHERE u < 10) GROUP BY g ORDER BY g
----
0	33330
1	33330
2	33330

statement ok
RESET threads;

query II
SELECT g, count(*) FROM (SELECT g FROM few_groups EXCEPT ALL SELECT g FROM few_groups WHERE u < 10) GROUP BY g ORDER BY g
----
0	33330
1	33330
2	33330

# ---- Set operations that become the join -------------------------------------------------------------------------

# without ALL
query II
EXPLAIN SELECT * FROM l EXCEPT SELECT * FROM r
----
physical_plan	<!REGEX>:.*Unnest.*

query II
EXPLAIN SELECT * FROM l INTERSECT SELECT * FROM r
----
physical_plan	<!REGEX>:.*Unnest.*

# a collated column compares equal strings that differ, and the set operation returns the left rows
statement ok
CREATE TABLE lc(s VARCHAR COLLATE NOCASE);

statement ok
INSERT INTO lc VALUES ('a'), ('A'), ('b');

statement ok
CREATE TABLE rc(s VARCHAR COLLATE NOCASE);

statement ok
INSERT INTO rc VALUES ('B');

query II
EXPLAIN SELECT * FROM lc EXCEPT ALL SELECT * FROM rc
----
physical_plan	<REGEX>:.*Join.*Window.*

query II
EXPLAIN SELECT * FROM lc EXCEPT ALL SELECT * FROM rc
----
physical_plan	<!REGEX>:.*Unnest.*

query II
EXPLAIN SELECT s COLLATE NOCASE FROM l INTERSECT ALL SELECT s FROM r
----
physical_plan	<!REGEX>:.*Unnest.*

# a filter that compares the collated column reaches both inputs, in either direction for INTERSECT ALL
query II
EXPLAIN SELECT * FROM (SELECT * FROM lc EXCEPT ALL SELECT * FROM rc) WHERE s = 'b'
----
physical_plan	<REGEX>:.*Filters: lower\(s\) = 'b'.*Filters: lower\(s\) = 'b'.*

query II
EXPLAIN SELECT * FROM lc INTERSECT ALL SELECT * FROM rc WHERE s = 'b'
----
physical_plan	<REGEX>:.*Filters: lower\(s\) = 'b'.*Filters: lower\(s\) = 'b'.*

query II
EXPLAIN SELECT * FROM lc EXCEPT ALL SELECT * FROM rc WHERE s = 'b'
----
physical_plan	<!REGEX>:.*Filters: lower\(s\) = 'b'.*Filters: lower\(s\) = 'b'.*

# a filter that tells 'a' and 'A' apart, which the set operation treats as equal, runs after it has chosen its rows
query II
EXPLAIN SELECT * FROM (SELECT * FROM lc INTERSECT ALL SELECT * FROM rc) WHERE ascii(s) = 97
----
physical_plan	<!REGEX>:.*Filters:.*

# floating point columns: 0.0 = -0.0
statement ok
CREATE TABLE ld(d DOUBLE, f FLOAT);

statement ok
INSERT INTO ld VALUES (0.0, 1.5), (-0.0, 1.5), (1.0, 2.5), ('nan', 'nan');

statement ok
CREATE TABLE rd(d DOUBLE, f FLOAT);

statement ok
INSERT INTO rd VALUES (1.0, 2.5);

query II
EXPLAIN SELECT d FROM ld EXCEPT ALL SELECT d FROM rd
----
physical_plan	<REGEX>:.*Join.*Window.*

query II
EXPLAIN SELECT f FROM ld INTERSECT ALL SELECT f FROM rd
----
physical_plan	<REGEX>:.*Join.*Window.*

query II
EXPLAIN SELECT [d] FROM ld EXCEPT ALL SELECT [d] FROM rd
----
physical_plan	<!REGEX>:.*Unnest.*

query II
EXPLAIN SELECT {'k': 1, 'f': f} FROM ld EXCEPT ALL SELECT {'k': 1, 'f': f} FROM rd
----
physical_plan	<!REGEX>:.*Unnest.*

# an integer column compared with a floating point column is compared as floating point
query II
EXPLAIN SELECT k FROM l EXCEPT ALL SELECT d FROM rd
----
physical_plan	<!REGEX>:.*Unnest.*

# types whose comparison normalizes: intervals (1 month = 30 days), times with a time zone
query II
EXPLAIN SELECT INTERVAL 1 MONTH EXCEPT ALL SELECT INTERVAL 30 DAY
----
physical_plan	<!REGEX>:.*Unnest.*

query II
EXPLAIN SELECT x::TIMETZ FROM (VALUES ('12:00:00+01')) t(x) EXCEPT ALL SELECT x::TIMETZ FROM (VALUES ('11:00:00+00')) t(x)
----
physical_plan	<!REGEX>:.*Unnest.*

# maps
query II
EXPLAIN SELECT MAP {k: s} FROM l EXCEPT ALL SELECT MAP {k: s} FROM r
----
physical_plan	<!REGEX>:.*Unnest.*

# hand-written queries of the form of the join plan (numbered rows, SEMI / ANTI join on the columns and the number)
# are not set operations: no plan is recognized, and they keep theirs
query II
EXPLAIN SELECT l2.k, l2.s FROM (SELECT k, s, row_number() OVER (PARTITION BY k, s) AS rn FROM l) l2 ANTI JOIN (SELECT k, s, row_number() OVER (PARTITION BY k, s) AS rn FROM r) r2 ON l2.k IS NOT DISTINCT FROM r2.k AND l2.s IS NOT DISTINCT FROM r2.s AND l2.rn IS NOT DISTINCT FROM r2.rn
----
physical_plan	<!REGEX>:.*Unnest.*

query II
EXPLAIN SELECT l2.k, l2.s FROM (SELECT k, s, row_number() OVER (PARTITION BY k, s) AS rn FROM l) l2 SEMI JOIN (SELECT k, s, row_number() OVER (PARTITION BY k, s) AS rn FROM r) r2 ON l2.k IS NOT DISTINCT FROM r2.k AND l2.s IS NOT DISTINCT FROM r2.s AND l2.rn IS NOT DISTINCT FROM r2.rn
----
physical_plan	<!REGEX>:.*Unnest.*

query II
EXPLAIN SELECT l2.k, l2.s FROM (SELECT k, s, row_number() OVER (PARTITION BY k, s) AS rn FROM l) l2 WHERE NOT EXISTS (SELECT 1 FROM (SELECT k, s, row_number() OVER (PARTITION BY k, s) AS rn FROM r) r2 WHERE l2.k IS NOT DISTINCT FROM r2.k AND l2.s IS NOT DISTINCT FROM r2.s AND l2.rn IS NOT DISTINCT FROM r2.rn)
----
physical_plan	<!REGEX>:.*Unnest.*

query II
EXPLAIN WITH l2 AS (SELECT k, s, row_number() OVER (PARTITION BY k, s) AS rn FROM l), r2 AS (SELECT k, s, row_number() OVER (PARTITION BY k, s) AS rn FROM r) SELECT l2.k, l2.s FROM l2 WHERE EXISTS (SELECT 1 FROM r2 WHERE l2.k IS NOT DISTINCT FROM r2.k AND l2.s IS NOT DISTINCT FROM r2.s AND l2.rn IS NOT DISTINCT FROM r2.rn)
----
physical_plan	<!REGEX>:.*Unnest.*

# ---- The answers are the same for every way the set operation is planned -----------------------------------------

# 0: the join plan, 1: the aggregate plan, 2 / 3: without the filters moving around the set operation,
# 4: without the optimizer, where the physical planner runs the set operation
loop i 0 5

statement ok
SET disabled_optimizers = CASE {i} WHEN 0 THEN 'set_operation_aggregate' WHEN 2 THEN 'filter_pushdown' WHEN 3 THEN 'filter_pullup' ELSE '' END;

statement ok
SET enable_optimizer = ({i} <> 4);

# a row that occurs n times on the left and m times on the right: n - m times (EXCEPT ALL), min(n, m) times
# (INTERSECT ALL); NULLs are equal to each other
query IT rowsort
SELECT * FROM l EXCEPT ALL SELECT * FROM r
----
1	a
1	a
4	d
NULL	NULL

query IT rowsort
SELECT * FROM r EXCEPT ALL SELECT * FROM l
----
2	b
3	NULL
5	e

query IT rowsort
SELECT * FROM l INTERSECT ALL SELECT * FROM r
----
1	a
2	b
2	b
3	NULL
NULL	NULL

query IT rowsort
SELECT * FROM r INTERSECT ALL SELECT * FROM l
----
1	a
2	b
2	b
3	NULL
NULL	NULL

# the same rows on both sides
query IT rowsort
SELECT * FROM l EXCEPT ALL SELECT * FROM l
----

query I
SELECT count(*) FROM (SELECT * FROM l INTERSECT ALL SELECT * FROM l)
----
9

# a column that is NULL in every row
query II rowsort
SELECT NULL::INTEGER, k FROM l EXCEPT ALL SELECT NULL, k FROM r
----
NULL	1
NULL	1
NULL	4
NULL	NULL

query I
SELECT count(*) FROM (SELECT NULL FROM l INTERSECT ALL SELECT NULL FROM r)
----
8

