query I
SELECT count(*) FROM (SELECT k FROM l WHERE random() >= 0 INTERSECT ALL SELECT k FROM r WHERE random() >= 0)
----
5

# prepared, with a parameter inside and above the set operation
statement ok
PREPARE p AS SELECT count(*) FROM (SELECT * FROM l WHERE k <> $1 EXCEPT ALL SELECT * FROM r) WHERE k < $2

query I
EXECUTE p(4, 10)
----
2

query I
EXECUTE p(1, 10)
----
1

# the columns are compared under the collations the binder resolved, which a UNION child does not show (it has the
# types of its first branch) and a cast to VARCHAR does not carry
query T
SELECT * FROM ((SELECT s FROM ul UNION ALL SELECT s COLLATE nocase FROM ub) INTERSECT ALL SELECT 'A'::VARCHAR);
----
a

query T
SELECT * FROM ((SELECT s FROM ul UNION ALL SELECT s COLLATE nocase FROM ub) EXCEPT ALL SELECT 'A'::VARCHAR) ORDER BY ALL;
----
b

query T
SELECT * FROM ((SELECT s FROM ul EXCEPT ALL SELECT s COLLATE nocase FROM ub) INTERSECT ALL SELECT s FROM ur) q WHERE s COLLATE "binary" = 'a';
----
a

# the collation of the right side only, of a nested set operation, below a cast, in a correlated subquery
query T
SELECT * FROM (SELECT s FROM ul INTERSECT ALL (SELECT s FROM ub UNION ALL SELECT s COLLATE nocase FROM ur))
----
a

query T
SELECT * FROM (SELECT s FROM ul EXCEPT ALL (SELECT s FROM ur INTERSECT ALL SELECT s COLLATE nocase FROM ul))
----

query T
SELECT * FROM (SELECT 1::VARCHAR EXCEPT ALL (SELECT s FROM ul UNION ALL SELECT s COLLATE nocase FROM ub)) t(s)
----
1

query TI rowsort
SELECT o.s, (SELECT count(*) FROM ((SELECT s FROM ul WHERE o.s IS NOT NULL UNION ALL SELECT s COLLATE nocase FROM ub) INTERSECT ALL SELECT upper(o.s))) FROM (SELECT * FROM ul UNION ALL SELECT * FROM ub UNION ALL SELECT * FROM ur) o
----
A	1
a	1
b	1

