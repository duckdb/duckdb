# many copies of few groups, a filter above the set operation
query III rowsort
SELECT k, count(*), sum(i) FROM (SELECT i % 3 AS k, i % 2 AS i FROM range(1000) t(i) EXCEPT ALL SELECT i % 3, i % 2 FROM range(400) t(i)) GROUP BY k
----
0	200	100
1	200	100
2	200	100

query II rowsort
SELECT k, count(*) FROM (SELECT i % 3 AS k FROM range(1000) t(i) INTERSECT ALL SELECT i % 4 FROM range(400) t(i)) WHERE k > 0 GROUP BY k
----
1	100
2	100

