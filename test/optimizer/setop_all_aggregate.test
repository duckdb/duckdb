# a filter between the numbering and the join
query IT rowsort
SELECT l2.k, l2.s FROM (SELECT k, s, row_number() OVER (PARTITION BY k, s) AS rn FROM l QUALIFY rn > 1) l2 ANTI JOIN (SELECT k, s, row_number() OVER (PARTITION BY k, s) AS rn FROM r) r2 ON l2.k IS NOT DISTINCT FROM r2.k AND l2.s IS NOT DISTINCT FROM r2.s AND l2.rn IS NOT DISTINCT FROM r2.rn
----
1	a
1	a
NULL	NULL

query IT rowsort
SELECT l2.k, l2.s FROM (SELECT k, s, row_number() OVER (PARTITION BY k, s) AS rn FROM l) l2 SEMI JOIN (SELECT * FROM (SELECT k, s, row_number() OVER (PARTITION BY k, s) AS rn FROM r) r2 WHERE rn = 2) r3 ON l2.k IS NOT DISTINCT FROM r3.k AND l2.s IS NOT DISTINCT FROM r3.s AND l2.rn IS NOT DISTINCT FROM r3.rn
----
2	b

# the two sides number different expressions
query IT rowsort
SELECT l2.k, l2.s FROM (SELECT k, s, row_number() OVER (PARTITION BY k, s) AS rn FROM l) l2 SEMI JOIN (SELECT k::BIGINT AS k, lower(s) AS s, row_number() OVER (PARTITION BY k % 2, s) AS rn FROM r) r2 ON l2.k IS NOT DISTINCT FROM r2.k AND l2.s IS NOT DISTINCT FROM r2.s AND l2.rn IS NOT DISTINCT FROM r2.rn
----
1	a
2	b
2	b
3	NULL
NULL	NULL

# IN compares with =
query IT rowsort
SELECT l2.k, l2.s FROM (SELECT k, s, row_number() OVER (PARTITION BY k, s) AS rn FROM l) l2 WHERE (k, s, rn) IN (SELECT k, s, rn FROM (SELECT k, s, row_number() OVER (PARTITION BY k, s) AS rn FROM r) r2)
----
1	a
2	b
2	b

# an input with a LIMIT, the same input on both sides, an input with a volatile filter
query IT rowsort
(SELECT * FROM l ORDER BY ALL LIMIT 5) EXCEPT ALL SELECT * FROM r
----
1	a
1	a

