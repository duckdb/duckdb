# hand-written queries of the form of the join plan, and variants that differ from it in one property each
query IT rowsort
SELECT l2.k, l2.s FROM (SELECT k, s, row_number() OVER (PARTITION BY k, s) AS rn FROM l) l2 ANTI JOIN (SELECT k, s, row_number() OVER (PARTITION BY k, s) AS rn FROM r) r2 ON l2.k IS NOT DISTINCT FROM r2.k AND l2.s IS NOT DISTINCT FROM r2.s AND l2.rn IS NOT DISTINCT FROM r2.rn
----
1	a
1	a
4	d
NULL	NULL

query IT rowsort
SELECT l2.k, l2.s FROM (SELECT k, s, row_number() OVER (PARTITION BY k, s) AS rn FROM l) l2 SEMI JOIN (SELECT k, s, row_number() OVER (PARTITION BY k, s) AS rn FROM r) r2 ON l2.k IS NOT DISTINCT FROM r2.k AND l2.s IS NOT DISTINCT FROM r2.s AND l2.rn IS NOT DISTINCT FROM r2.rn
----
1	a
2	b
2	b
3	NULL
NULL	NULL

query IT rowsort
SELECT l2.k, l2.s FROM (SELECT k, s, row_number() OVER (PARTITION BY k, s) AS rn FROM l) l2 WHERE EXISTS (SELECT 1 FROM (SELECT k, s, row_number() OVER (PARTITION BY k, s) AS rn FROM r) r2 WHERE l2.k IS NOT DISTINCT FROM r2.k AND l2.s IS NOT DISTINCT FROM r2.s AND l2.rn IS NOT DISTINCT FROM r2.rn)
----
1	a
2	b
2	b
3	NULL
NULL	NULL

# = instead of IS NOT DISTINCT FROM: rows with a NULL never match
query IT rowsort
SELECT l2.k, l2.s FROM (SELECT k, s, row_number() OVER (PARTITION BY k, s) AS rn FROM l) l2 ANTI JOIN (SELECT k, s, row_number() OVER (PARTITION BY k, s) AS rn FROM r) r2 ON l2.k = r2.k AND l2.s = r2.s AND l2.rn = r2.rn
----
1	a
1	a
3	NULL
4	d
NULL	NULL
NULL	NULL

query IT rowsort
SELECT l2.k, l2.s FROM (SELECT k, s, row_number() OVER (PARTITION BY k, s) AS rn FROM l) l2 SEMI JOIN (SELECT k, s, row_number() OVER (PARTITION BY k, s) AS rn FROM r) r2 ON l2.k IS NOT DISTINCT FROM r2.k AND l2.s = r2.s AND l2.rn IS NOT DISTINCT FROM r2.rn
----
1	a
2	b
2	b

# the rows are numbered within some of the columns only, in a fixed order
query IT rowsort
SELECT l2.k, l2.s FROM (SELECT k, s, row_number() OVER (PARTITION BY s ORDER BY k) AS rn FROM l) l2 ANTI JOIN (SELECT k, s, row_number() OVER (PARTITION BY s ORDER BY k) AS rn FROM r) r2 ON l2.k IS NOT DISTINCT FROM r2.k AND l2.s IS NOT DISTINCT FROM r2.s AND l2.rn IS NOT DISTINCT FROM r2.rn
----
1	a
1	a
4	d
NULL	NULL

# rank() numbers every copy of a row alike
query IT rowsort
SELECT l2.k, l2.s FROM (SELECT k, s, rank() OVER (PARTITION BY k, s ORDER BY k) AS rn FROM l) l2 ANTI JOIN (SELECT k, s, rank() OVER (PARTITION BY k, s ORDER BY k) AS rn FROM r) r2 ON l2.k IS NOT DISTINCT FROM r2.k AND l2.s IS NOT DISTINCT FROM r2.s AND l2.rn IS NOT DISTINCT FROM r2.rn
----
4	d

# the join compares some of the columns only
query IT rowsort
SELECT l2.k, l2.s FROM (SELECT k, s, row_number() OVER (PARTITION BY k, s) AS rn FROM l) l2 ANTI JOIN (SELECT k, s, row_number() OVER (PARTITION BY k, s) AS rn FROM r) r2 ON l2.k IS NOT DISTINCT FROM r2.k AND l2.rn IS NOT DISTINCT FROM r2.rn
----
1	a
1	a
