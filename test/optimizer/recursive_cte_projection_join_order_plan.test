# name: test/optimizer/recursive_cte_projection_join_order_plan.test
# description: Equality joins reorder a projected recursive input before a large range
# group: [optimizer]

statement ok
SET max_execution_time=10000;

statement ok
SET disabled_optimizers='build_side_probe_side';

# Result coverage, including synthetic verification projections, is in the companion test.
# Match the inner join's children: the filtered recursive scan and range(3).
# The surrounding root join can put range(1000) on either side.
query TT
EXPLAIN (FORMAT JSON) WITH RECURSIVE r(i) AS (
    VALUES (0)
    UNION ALL
    SELECT x.i + 1
    FROM range(1000) n(i)
    JOIN (SELECT * FROM r) x ON x.i = n.i
    JOIN range(3) tiny(j) ON tiny.j = n.i
    WHERE x.i < 3
)
SELECT count(*), sum(i) FROM r;
----
physical_plan	<REGEX>:.*"name": "HASH_JOIN",\s*"children": \[\s*\{\s*"name": "FILTER",\s*"children": \[\s*\{[^{}]*"name": "REC_CTE_SCAN"[^{}]*\{[^{}]*\}\s*\}\s*\],[^{}]*\{[^{}]*\}\s*\},\s*\{\s*"name": "RANGE",[^{}]*\{[^{}]*"Estimated Cardinality": "3"[^{}]*\}\s*\}\s*\].*
