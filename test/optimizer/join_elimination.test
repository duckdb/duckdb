statement ok
create table pk_table (id int primary key, val int);

statement ok
create table fk_table (id int, fk_id int not null, foreign key (fk_id) references pk_table(id));

statement ok
create table fk_table_nullable (id int, fk_id int, foreign key (fk_id) references pk_table(id));

statement ok
