----
physical_plan	<REGEX>:.*JOIN.*

# unnest emits multiple rows per input row, so a distinct group below it does not survive above it
# (issue #25213)

statement ok
create table dup_keys(k int);

statement ok
insert into dup_keys values (1),(1),(2),(3);

statement ok
create table probe_keys(idb int);

statement ok
insert into probe_keys values (1),(1),(2),(3),(4),(NULL),(2),(3);

query I
select count(*) from probe_keys left join (select k, unnest([1,2,3]) e from (select distinct k from dup_keys) s) t on t.k=probe_keys.idb;
----
20

query II
explain select count(*) from probe_keys left join (select k, unnest([1,2,3]) e from (select distinct k from dup_keys) s) t on t.k=probe_keys.idb;
----
physical_plan	<REGEX>:.*JOIN.*

# same through group by instead of distinct
query I
select count(*) from probe_keys left join (select k, unnest([1,2,3]) e from (select k from dup_keys group by k) s) t on t.k=probe_keys.idb;
----
20

# same through a nested unnest
query I
select count(*) from probe_keys left join (select k, unnest([[1,2],[3]], recursive := true) e from (select distinct k from dup_keys) s) t on t.k=probe_keys.idb;
----
20

# a distinct ABOVE the unnest still makes the inner side unique, so the join is still eliminated
query I
select count(*) from probe_keys left join (select distinct k from (select k, unnest([1,2,3]) e from dup_keys) u) t on t.k=probe_keys.idb;
----
8

query II
explain select count(*) from probe_keys left join (select distinct k from (select k, unnest([1,2,3]) e from dup_keys) u) t on t.k=probe_keys.idb;
----
physical_plan	<!REGEX>:.*JOIN.*

# a distinct above LIMIT, SAMPLE or a window does not hold below it, because duplicate rows change the result

statement ok
create table p(id bigint, g varchar);

statement ok
insert into p values (1,'x'),(2,'y'),(3,'x'),(4,'y'),(5,'x'),(6,'y'),(7,'z');

statement ok
create table k(a bigint, b bigint);

statement ok
insert into k values (1,2),(1,3),(2,3),(3,4),(4,1),(5,1),(6,7),(6,4);

query I
select distinct pg from (select p.id as pid, p.g as pg from p left join k on p.id = k.a order by p.g desc, p.id limit 2 offset 3) order by pg;
----
y

query I
select distinct pg from (select p.id as pid, p.g as pg from k right join p on p.id = k.a order by p.g desc, p.id limit 2 offset 3) order by pg;
----
y

query I
select count(*) > 0 from (select distinct pg from (select p.g as pg from p left join k on p.id = k.a limit 2 offset 7));
----
true

query I
select distinct g from (select p.g, row_number() over (order by p.id) rn from p left join k on p.id = k.a) where rn <= 2 order by g;
----
x

query I
select distinct g from (select p.g, count(*) over () c from p left join k on p.id = k.a) where c = 9 order by g;
----
x
y
z

query II
explain select distinct g from (select p.g from p left join k on p.id = k.a using sample 50%);
----
physical_plan	<REGEX>:.*JOIN.*

query I
select distinct g from (select p.g, unnest([1, 2]) e from p left join k on p.id = k.a qualify count(*) over () = 9) order by g;
----
x
y
z

# volatile expressions run once per row, so duplicate rows change their result

statement ok
create sequence seq;

query I
select count(*) > 0 from (select distinct p.g from p left join k on p.id = k.a where nextval('seq') > 7);
----
true

query I
select currval('seq');
----
9

statement ok
create sequence seq_projection;

query I
select count(*) > 0 from (select distinct g from (select p.g, nextval('seq_projection') n from p left join k on p.id = k.a) where n > 7);
----
true

statement ok
create sequence seq_unnest;

query I
select count(*) > 0 from (select distinct g from (select p.g, unnest([nextval('seq_unnest')]) n from p left join k on p.id = k.a) where n > 7);
----
true

statement ok
create table z(id bigint);

statement ok
insert into z values (5);

statement ok
create sequence seq_join;

statement ok
select count(*) from (select distinct s.g from (select p.id, p.g, unnest([1]) e from p left join k on p.id = k.a) s join z on s.id + nextval('seq_join') = z.id);

query I
select currval('seq_join');
----
9

statement ok
create sequence seq_any_join;

statement ok
select count(*) from (select distinct s.g from (select p.id, p.g, unnest([1]) e from p left join k on p.id = k.a) s join z on s.id + z.id + nextval('seq_any_join') < 0);

query I
select currval('seq_any_join');
----
9

# a distinct below a LIMIT still eliminates the join

query I
select * from (select distinct p.g from p left join k on p.id = k.a) order by g limit 2;
----
x
y

query II
explain select * from (select distinct p.g from p left join k on p.id = k.a) order by g limit 2;
----
physical_plan	<!REGEX>:.*JOIN.*

query II
explain select g, nextval('seq') from (select distinct p.g from p left join k on p.id = k.a);
----
physical_plan	<!REGEX>:.*JOIN.*
