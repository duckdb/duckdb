# name: test/optimizer/duplicate_eliminated_domain_inlining_parquet.test
# description: Factor duplicate-free domains for Parquet scans without duplicating an externally backed scan
# group: [optimizer]

require parquet

statement ok
PRAGMA explain_output=optimized_only;

statement ok
SET VARIABLE dedup_original_verify_aggregate_state_export = current_setting('debug_verify_aggregate_state_export');

statement ok
CREATE TABLE parquet_fact(k INTEGER, v INTEGER);

statement ok
INSERT INTO parquet_fact VALUES (1, 2), (1, 4), (1, 6);

statement ok
COPY (SELECT 1 AS k, 'selected' AS state, 'a' AS tag)
TO '{TEST_DIR}/direct_identity_a.parquet' (FORMAT PARQUET);

statement ok
COPY (SELECT 1 AS k, 'selected' AS state, 'b' AS tag)
TO '{TEST_DIR}/direct_identity_b.parquet' (FORMAT PARQUET);

# A Parquet source with unknown generic repeatability remains shared through a factored CTE.
query II rowsort
SELECT f.v, d.tag
FROM parquet_fact f
JOIN read_parquet('{TEST_DIR}/direct_identity_a.parquet') d ON f.k = d.k
WHERE d.state = 'selected'
  AND f.v < (
      SELECT avg(i.v)
      FROM parquet_fact i
      WHERE i.k = d.k
  );
----
2	a

statement ok
SET debug_verify_aggregate_state_export=false;

query II
EXPLAIN
SELECT f.v
FROM parquet_fact f
JOIN read_parquet('{TEST_DIR}/direct_identity_a.parquet') d ON f.k = d.k
WHERE d.state = 'selected'
  AND f.v < (
      SELECT avg(i.v)
      FROM parquet_fact i
      WHERE i.k = d.k
  );
----
logical_opt	<REGEX>:.*__duckdb_duplicate_eliminated_factor_.*

statement ok
SET debug_verify_aggregate_state_export=getvariable('dedup_original_verify_aggregate_state_export');

# Duplicate keys across files are removed only from D; the untouched payload retains both source rows.
query II rowsort
SELECT f.v, d.tag
FROM parquet_fact f
JOIN read_parquet('{TEST_DIR}/direct_identity_*.parquet') d ON f.k = d.k
WHERE d.state = 'selected'
  AND f.v < (
      SELECT avg(i.v)
      FROM parquet_fact i
      WHERE i.k = d.k
  );
----
2	a
2	b

statement ok
SET debug_verify_aggregate_state_export=false;

query II
EXPLAIN
SELECT f.v
FROM parquet_fact f
JOIN read_parquet('{TEST_DIR}/direct_identity_*.parquet') d ON f.k = d.k
WHERE d.state = 'selected'
  AND f.v < (
      SELECT avg(i.v)
      FROM parquet_fact i
      WHERE i.k = d.k
  );
----
logical_opt	<!REGEX>:.*(__duckdb_delim_|WINDOW).*

statement ok
SET debug_verify_aggregate_state_export=getvariable('dedup_original_verify_aggregate_state_export');
