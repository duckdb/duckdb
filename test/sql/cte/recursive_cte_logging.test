# A sparse direct probe uses the broad anchor once, then schedules its narrow probe frontiers inline.
query II
WITH RECURSIVE t(k, v) USING KEY (k) AS (
	SELECT i,
	       CASE WHEN i < greatest(current_setting('standard_vector_size')::BIGINT / 4, 1) THEN 0 ELSE 100 END
	FROM range(current_setting('standard_vector_size')::BIGINT * 16) r(i)
	UNION ALL
	SELECT n.k, r.v + 1
	FROM t n
	JOIN recurring.t r USING (k)
	WHERE n.v < 4
)
SELECT count(*) = current_setting('standard_vector_size')::BIGINT * 16, min(v) FROM t;
----
1	4

