  ON runtime.parameters['Table Index'] = summary.parameters['Table Index']
 AND runtime.info.invocation_id = summary.info.invocation_id
WHERE runtime.class = 'PhysicalRecursiveCTE' AND runtime.event = 'RuntimeMetrics'
  AND summary.class = 'PhysicalRecursiveCTE' AND summary.event = 'EpochSummary';
