# A filter on recurring state rejects the direct probe and retains full-scan work accounting.
query II
WITH RECURSIVE t(k, v) USING KEY (k) AS (
	SELECT i, 0
	FROM range(current_setting('standard_vector_size')::BIGINT * 4) r(i)
	UNION ALL
	SELECT r.k, r.v + 1
	FROM range(current_setting('standard_vector_size')::BIGINT * 4) n(i)
	JOIN (SELECT * FROM recurring.t WHERE v < 2) r ON r.k = n.i
)
SELECT count(*) = current_setting('standard_vector_size')::BIGINT * 4, max(v) FROM t;
----
1	2

