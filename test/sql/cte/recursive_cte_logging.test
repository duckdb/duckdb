# Key-delta metrics distinguish aggregate candidates from observable state changes.
query II rowsort
WITH RECURSIVE t(k, v) USING KEY (k, min(v)) AS (
	VALUES (1, 5), (1, 6), (2, 10)
	UNION
	SELECT k, CASE k WHEN 1 THEN v + 1 ELSE v - 1 END
	FROM t
	WHERE (k = 1 AND v = 5) OR (k = 2 AND v = 10)
)
TABLE t;
----
1	5
2	9

