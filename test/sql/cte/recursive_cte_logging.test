# This broad CPU-heavy recursion uses multiple workers and promotes the distinct sink.
query II
WITH RECURSIVE t(i, digest, level) AS (
	SELECT i, md5(i::VARCHAR), 0
	FROM range(current_setting('standard_vector_size')::BIGINT * 24) r(i)
	UNION
	SELECT i, md5(md5(md5(md5(digest)))), level + 1 FROM t WHERE level < 7
)
SELECT count(*) = current_setting('standard_vector_size')::BIGINT * 24 * 8, max(level) FROM t;
----
1	7

