# Frontier metrics describe each iteration input once, while scheduler metrics account for both scan references.
query II
WITH RECURSIVE t(i, level) AS (
	VALUES (1, 0), (2, 0)
	UNION ALL
	SELECT a.i, a.level + 1
	FROM t a
	JOIN t b USING (i)
	WHERE a.level < 1 AND b.level < 1
)
SELECT count(*), max(level) FROM t;
----
4	1

statement ok
CALL disable_logging();

