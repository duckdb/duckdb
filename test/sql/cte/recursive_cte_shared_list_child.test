# a carried list with NULL elements is not shared and copied as before
query IIIII
WITH RECURSIVE r(i, acc) AS (
	SELECT 0, list_transform(range(3000), lambda x: CASE WHEN x % 1000 = 7 THEN NULL ELSE x END)
	UNION ALL
	SELECT i + 1, acc FROM r WHERE i < 50
)
SELECT count(*), sum(len(acc)), sum(list_count(acc)), sum((acc[8] IS NULL)::INT), sum(acc[-1]) FROM r;
----
51	153000	152847	51	152949
