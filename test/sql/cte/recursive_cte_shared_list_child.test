# name: test/sql/cte/recursive_cte_shared_list_child.test
# description: Empty or NULL lists selected from a chunk holding a shared list child, followed by more appends into the same chunk
# group: [cte]

# reading a list child whose chain head hides the appended entries does not terminate, bound it
statement ok
SET max_execution_time=30000;

# the k = 0 row selects nothing of the shared 3000-element child, the k = 1 branch appends a new list into the same chunk
query III
WITH RECURSIVE r(i, k, acc) AS (
	SELECT 0, k, CASE WHEN k = 0 THEN NULL ELSE range(3000)::INT[] END FROM (VALUES (0), (1)) v(k)
	UNION ALL
	(SELECT i + 1, k, acc FROM r WHERE i < 1 AND k = 0
	 UNION ALL
	 SELECT i + 1, 5, [7, 8, 9] FROM r WHERE i < 1 AND k = 1)
)
SELECT i, k, acc FROM r WHERE k <> 1 ORDER BY ALL;
----
0	0	NULL
1	0	NULL
1	5	[7, 8, 9]

query IIIIII
WITH RECURSIVE r(i, k, acc) AS (
	SELECT 0, k, CASE WHEN k = 0 THEN NULL ELSE range(3000)::INT[] END FROM (VALUES (0), (1)) v(k)
	UNION ALL
	(SELECT i + 1, k, acc FROM r WHERE i < 1 AND k = 0
	 UNION ALL
	 SELECT i + 1, 5, [7, 8, 9] FROM r WHERE i < 1 AND k = 1)
)
SELECT i, k, len(acc), acc[1], acc[-1], list_sum(acc) FROM r WHERE k <> 1 ORDER BY ALL;
----
0	0	NULL	NULL	NULL	NULL
1	0	NULL	NULL	NULL	NULL
1	5	3	7	9	24

query IIIIII
