# name: test/sql/cte/recursive_cte_aoc2022.test_slow
# description: Adapted recursive Advent of Code 2022 SQL workloads
# group: [cte]

statement ok
SET threads=2;

statement ok
SET max_execution_time=30000;

# Day 9: chained rope-following recursion
statement ok
CREATE MACRO aoc2022_day09_follow(t, delta_x, delta_y) AS
	CASE
		WHEN abs(delta_x) > 1 OR abs(delta_y) > 1
			THEN {x: t.x + sign(delta_x), y: t.y + sign(delta_y)}
		ELSE t
	END;

statement ok
CREATE TABLE aoc2022_day09_head AS
WITH steps(move, delta_x, delta_y) AS (
	SELECT move,
	       CASE direction WHEN 0 THEN 1 WHEN 2 THEN -1 ELSE 0 END,
	       CASE direction WHEN 1 THEN 1 WHEN 3 THEN -1 ELSE 0 END
	FROM (
		SELECT move, ((move // 29) + (move // 113)) % 4 AS direction
		FROM range(1, 4097) moves(move)
	)
)
SELECT move,
       {x: sum(delta_x) OVER (ORDER BY move), y: sum(delta_y) OVER (ORDER BY move)} AS xy
FROM steps;

statement ok
SET VARIABLE aoc_sql = (
	SELECT content FROM read_text('benchmark/recursive_cte/queries/performance/aoc2022_day09.sql')
);

query IIIIT
SELECT * FROM query(getvariable('aoc_sql'));
----
4097	1876	-19338	5921	c992e7f0979d6c097a27442baff04905

