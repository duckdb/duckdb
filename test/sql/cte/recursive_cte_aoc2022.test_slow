# Day 16: ordinary and USING KEY valve traversal
statement ok
CREATE TABLE aoc2022_day16_input(valve VARCHAR, flow INTEGER, tunnel VARCHAR);

statement ok
INSERT INTO aoc2022_day16_input
WITH valves(id, valve, flow) AS (
	SELECT id,
	       'A' || chr(ascii('A') + id::INTEGER),
	       CASE WHEN id = 0 THEN 0 ELSE ((id * 7) % 19 + 1)::INTEGER END
	FROM range(20) valves(id)
)
SELECT source.valve, source.flow, target.valve
FROM valves source,
     (VALUES (1), (3), (7)) offsets(delta),
     valves target
WHERE target.id = (source.id + offsets.delta) % 20;

statement ok
SET VARIABLE aoc_sql = (
	SELECT content FROM read_text('benchmark/recursive_cte/queries/performance/aoc2022_day16.sql')
);

