# name: test/sql/cte/recursive_cte_key_union.test
# description: USING KEY UNION emits finalized rows only for effectively changed keys
# group: [cte]

statement ok
SET threads=1;

# Reproducing the current value produces an empty delta and terminates recursion.
query II
WITH RECURSIVE t(k, v) USING KEY (k) AS (
	VALUES (1, 0)
	UNION
	SELECT k, v FROM t
)
TABLE t;
----
1	0

# Inferior and duplicate candidates are still aggregate inputs, but do not remain recursive work.
query II
WITH RECURSIVE t(k, v) USING KEY (k, min(v)) AS (
	VALUES (1, 5)
	UNION
	SELECT k, v + delta
	FROM t, (VALUES (0), (0), (1), (2)) offsets(delta)
)
TABLE t;
----
1	5

# New keys and changed finalized values form the next working table.
query II rowsort
WITH RECURSIVE t(k, v) USING KEY (k) AS (
	VALUES (1, 10)
	UNION
	SELECT k + 1, v + 10 FROM t WHERE k < 4
)
TABLE t;
----
1	10
2	20
3	30
4	40

# Changes in later payload columns are detected after earlier columns narrow the candidate rows.
query III rowsort
WITH RECURSIVE t(k, a, b) USING KEY (k) AS (
	VALUES (1, 0, 0), (2, 0, 0)
	UNION
	SELECT k,
	       CASE WHEN k = 1 THEN 1 ELSE a END,
	       CASE WHEN k = 2 THEN b + 1 ELSE b END
	FROM t
	WHERE (k = 1 AND a = 0) OR (k = 2 AND b < 2)
)
TABLE t;
----
1	1	0
2	0	2

# Aggregate output types are visible through the recursive CTE name.
query I
WITH RECURSIVE t(k, total) USING KEY (k, sum(total)) AS (
	VALUES (1, 1::INTEGER)
	UNION
	SELECT k, 1 FROM t WHERE total < 3
)
SELECT total FROM t;
----
3

query IIT
WITH RECURSIVE t(k, total, recursive_type) USING KEY (k, sum(total)) AS (
	VALUES (1, 1::INTEGER, 'anchor')
	UNION
	SELECT k, 1, typeof(total) FROM t WHERE total < 2
)
SELECT k, total, recursive_type FROM t;
----
1	2	HUGEINT

# Multiple candidates for a new key are all applied before its finalized row is emitted.
query II
WITH RECURSIVE t(k, total) USING KEY (k, sum(total)) AS (
	VALUES (1, 1), (1, 2)
	UNION
	SELECT k, 0 FROM t WHERE false
)
TABLE t;
----
1	3

# NULL payloads are compared with IS DISTINCT FROM semantics.
query II
WITH RECURSIVE t(k, v) USING KEY (k) AS (
	VALUES (1, NULL::INTEGER)
	UNION
	SELECT k, v FROM t
)
TABLE t;
----
1	NULL

# NaN and signed zero use the same SQL observable-equality semantics.
query III
WITH RECURSIVE t(k, v) USING KEY (k) AS (
	VALUES (1, 'NaN'::DOUBLE), (2, -0e0::DOUBLE)
	UNION
	SELECT k, CASE WHEN k = 1 THEN 'NaN'::DOUBLE ELSE 0e0::DOUBLE END
	FROM t
)
SELECT count(*), count_if(isnan(v)), count_if(signbit(v)) FROM t;
----
2	1	0

# With only key columns, an existing key cannot produce an observable change.
query I
WITH RECURSIVE t(k) USING KEY (k) AS (
	VALUES (1)
	UNION
	SELECT k FROM t
)
TABLE t;
----
1

# A transient aggregate-state change that returns to the old value produces no work.
query II
WITH RECURSIVE t(k, v) USING KEY (k, bit_xor(v)) AS (
	VALUES (1, 0)
	UNION
	SELECT k, 1 FROM t, range(2) duplicates(_)
)
TABLE t;
----
1	0

# Hidden aggregate-state changes do not form work when the finalized value is unchanged.
query II
WITH RECURSIVE t(k, v) USING KEY (k, avg(v) AS v) AS (
	VALUES (1, 0), (1, 2)
	UNION
	SELECT k, x
	FROM t, (VALUES (0), (2)) values_(x)
)
TABLE t;
----
1	1.0

# Composite and NULL keys use the keyed hash table's NOT DISTINCT lookup semantics.
query III rowsort
WITH RECURSIVE t(k1, k2, v) USING KEY (k1, k2, min(v)) AS (
	VALUES (1, NULL::INTEGER, 5), (1, 2, 10)
	UNION
	SELECT k1, k2, v FROM t
)
TABLE t;
----
1	2	10
1	NULL	5

# Nested payload equality uses SQL value semantics.
query II
WITH RECURSIVE t(k, v) USING KEY (k) AS (
	VALUES (1, [1, NULL]::INTEGER[])
	UNION
	SELECT k, [1, NULL]::INTEGER[] FROM t
)
TABLE t;
----
1	[1, NULL]

# An empty anchor terminates without executing a recursive epoch.
query I
WITH RECURSIVE t(k) USING KEY (k) AS (
	SELECT i FROM range(0) r(i)
	UNION
	SELECT k FROM t
)
SELECT count(*) FROM t;
----
0

# Correlated invocations construct and terminate their deltas independently.
query II rowsort
SELECT limit_value, final_value
FROM range(4) limits(limit_value), LATERAL (
	WITH RECURSIVE t(k, v) USING KEY (k) AS (
		VALUES (1, 0)
		UNION
		SELECT k, v + 1 FROM t WHERE v < limit_value
	)
	SELECT v AS final_value FROM t
);
----
0	0
1	1
2	2
3	3

# Complete-key probes over recurring state remain eligible for the specialized join.
statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

statement ok
PRAGMA explain_output='physical_only';

query II
EXPLAIN WITH RECURSIVE t(k, total) USING KEY (k, sum(total)) AS (
	SELECT i, 1 FROM range(100) r(i)
	UNION
	SELECT n.k, r.total * 0 + 1
	FROM t n JOIN recurring.t r USING (k)
	WHERE n.total < 3
)
TABLE t;
----
physical_plan	<REGEX>:.*RECURSIVE_KEY_JOIN.*

query II
WITH RECURSIVE t(k, total) USING KEY (k, sum(total)) AS (
	SELECT i, 1 FROM range(100) r(i)
	UNION
	SELECT n.k, r.total * 0 + 1
	FROM t n JOIN recurring.t r USING (k)
	WHERE n.total < 3
)
SELECT count(*), sum(total) FROM t;
----
100	300

# Plain UNION retains partial-key probes and updates the index for newly finalized keys.
query II
EXPLAIN WITH RECURSIVE t(k1, k2, v) USING KEY (k1, k2, sum(v) AS v) AS (
	VALUES (1, 1, 1)
	UNION
	SELECT n.k1, n.k2 + 1, n.v
	FROM t n JOIN recurring.t r ON r.k1 = n.k1
	WHERE n.k2 < 3
)
TABLE t;
----
physical_plan	<REGEX>:.*RECURSIVE_PARTIAL_KEY_JOIN.*

query III rowsort
WITH RECURSIVE t(k1, k2, v) USING KEY (k1, k2, sum(v) AS v) AS (
	VALUES (1, 1, 1)
	UNION
	SELECT n.k1, n.k2 + 1, n.v
	FROM t n JOIN recurring.t r ON r.k1 = n.k1
	WHERE n.k2 < 3
)
TABLE t;
----
1	1	1
1	2	1
1	3	2

# Nested invocations own independent touched-key and lookup state.
query II rowsort
WITH RECURSIVE outer_cte(a, b) AS (
	SELECT 1, 1
	UNION
	(
		WITH RECURSIVE inner_cte(k, v) USING KEY (k) AS (
			SELECT a, 0 FROM outer_cte WHERE b < 4
			UNION
			SELECT k, v FROM inner_cte
		)
		SELECT k, b + 1
		FROM inner_cte, outer_cte
		WHERE b < 4
	)
)
TABLE outer_cte;
----
1	1
1	2
1	3
1	4

# UNION ALL retains candidate-frontier semantics.
query II
WITH RECURSIVE t(k, v) USING KEY (k) AS (
	VALUES (1, 0)
	UNION ALL
	SELECT k, v + 1 FROM t WHERE v < 3
)
TABLE t;
----
1	3

# Delta construction remains correct when candidate production is parallel.
statement ok
SET threads=4;

query II
WITH RECURSIVE t(k, v) USING KEY (k, min(v)) AS (
	SELECT i, 100 FROM range(10000) r(i)
	UNION
	SELECT k, v - delta
	FROM t, range(2) offsets(delta)
	WHERE v > 98
)
SELECT count(*), sum(v) FROM t;
----
10000	980000

# The existing logical union flag preserves the new behavior through serializer verification.
statement ok
SET debug_verify_serializer=true;

query II
WITH RECURSIVE t(k, v) USING KEY (k, min(v)) AS (
	VALUES (1, 5)
	UNION
	SELECT k, v + 1 FROM t
)
TABLE t;
----
1	5

statement ok
SET debug_verify_serializer=false;

# The temporary compatibility setting was removed with the implementation of UNION semantics.
statement error
SET deprecated_using_key_syntax='UNION_AS_UNION_ALL';
----
<REGEX>:.*unrecognized configuration parameter.*deprecated_using_key_syntax.*
