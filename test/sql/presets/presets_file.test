# name: test/sql/presets/presets_file.test
# description: Presets loaded from a JSON file
# group: [presets]

# settings are applied in the order the file lists them, with their JSON types
query II
SELECT setting, status FROM preset(file := 'test/sql/presets/example_preset.json')
----
threads	applied
preserve_insertion_order	applied
tracked_metrics	applied
max_expression_depth	reset

query I
SELECT current_setting('threads')
----
3

query I
SELECT current_setting('preserve_insertion_order')
----
false

query I
SELECT current_setting('tracked_metrics')
----
[query.*, operator.*]

# null resets rather than assigning null
statement ok
SET max_expression_depth=9999

query II
SELECT setting, new_value FROM preset(file := 'test/sql/presets/example_preset.json') WHERE setting = 'max_expression_depth'
----
max_expression_depth	1000

# a name and a file are mutually exclusive
statement error
SELECT * FROM preset('host:shared', file := 'test/sql/presets/example_preset.json')
----
<REGEX>:.*not both.*

statement error
SELECT * FROM preset()
----
<REGEX>:.*requires either a preset name or file.*

# malformed files are rejected
statement error
SELECT * FROM preset(file := 'test/sql/presets/does_not_exist.json')
----
<REGEX>:.*does not exist.*

# an unknown setting is caught before anything is applied
statement ok
SET threads=7

statement error
SELECT * FROM preset(file := 'test/sql/presets/bad_preset.json')
----
<REGEX>:.*unrecognized configuration parameter.*

query I
SELECT current_setting('threads')
----
7
