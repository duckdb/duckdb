# name: test/sql/storage/trigger_checkpoint_lock.test
# description: Triggers created, replaced and dropped in an open transaction do not hold a checkpoint back, and replay from the WAL
# group: [storage]

require skip_reload

load {TEST_DIR}/trigger_checkpoint_lock.db readwrite v2.0.0

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE t (i INTEGER)

statement ok
CREATE TABLE log (i INTEGER)

statement ok
CREATE TABLE tick (i INTEGER)

statement ok
CREATE TRIGGER kept AFTER INSERT ON t INSERT INTO log VALUES (1)

statement ok
CREATE TRIGGER dropped AFTER INSERT ON t INSERT INTO log VALUES (-1)

statement ok
CHECKPOINT

# rolled back after a checkpoint
statement ok con1
BEGIN TRANSACTION

statement ok con1
CREATE TRIGGER rolled_back AFTER INSERT ON t INSERT INTO log VALUES (-2)

statement ok con1
DROP TRIGGER kept ON t

statement ok
INSERT INTO tick VALUES (1)

statement ok
CHECKPOINT

statement ok con1
ROLLBACK

# committed after a checkpoint, which writes the triggers as of its bound: the WAL has the changes
statement ok con1
BEGIN TRANSACTION

statement ok con1
CREATE TRIGGER created AFTER INSERT ON t INSERT INTO log VALUES (2)

statement ok con1
DROP TRIGGER dropped ON t

statement ok con1
CREATE OR REPLACE TRIGGER kept AFTER INSERT ON t INSERT INTO log VALUES (3)

statement ok con1
CREATE TRIGGER IF NOT EXISTS created AFTER INSERT ON t INSERT INTO log VALUES (-3)

statement ok
INSERT INTO tick VALUES (2)

statement ok
CHECKPOINT

statement ok con1
COMMIT

statement ok
INSERT INTO t VALUES (1)

query I
SELECT i FROM log ORDER BY ALL
----
2
3

# replay the WAL on top of that checkpoint, as after a crash
restart

query I
SELECT trigger_name FROM duckdb_triggers() ORDER BY ALL
----
created
kept

statement ok
INSERT INTO t VALUES (2)

statement ok
CHECKPOINT

restart

query I
SELECT trigger_name FROM duckdb_triggers() ORDER BY ALL
----
created
kept

statement ok
INSERT INTO t VALUES (3)

query II
SELECT i, COUNT(*) FROM log GROUP BY ALL ORDER BY ALL
----
2	3
3	3
