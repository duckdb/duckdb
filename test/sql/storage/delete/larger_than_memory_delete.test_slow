# name: test/sql/storage/delete/larger_than_memory_delete.test_slow
# description: Test larger than memory deletes of scattered rows, whose per-row delete ids have to be evicted
# group: [delete]

load {TEST_DIR}/larger_than_memory_delete.db

statement ok
CREATE TABLE integers AS FROM range(10000000) t(i);

statement ok
SET threads=1

# the per-row delete ids of the vectors are 16 KB each, ~80MB for 10M rows
statement ok
SET memory_limit='8MB';

statement ok con1
BEGIN

query II con1
SELECT COUNT(*), SUM(i) FROM integers
----
10000000	49999995000000

query I
DELETE FROM integers WHERE i%2=0;
----
5000000

query II con1
SELECT COUNT(*), SUM(i) FROM integers
----
10000000	49999995000000

query II
SELECT COUNT(*), SUM(i) FROM integers
----
5000000	25000000000000

statement ok con1
ROLLBACK

# a rolled back delete writes the previous ids back into the evicted per-row ids
statement ok
BEGIN

query I
DELETE FROM integers WHERE i%3=0;
----
1666667

statement ok
ROLLBACK

query II
SELECT COUNT(*), SUM(i) FROM integers
----
5000000	25000000000000

query I
DELETE FROM integers WHERE i%3=0;
----
1666667

query II
SELECT COUNT(*), SUM(i) FROM integers
----
3333333	16666663333333

restart

query II
SELECT COUNT(*), SUM(i) FROM integers
----
3333333	16666663333333
