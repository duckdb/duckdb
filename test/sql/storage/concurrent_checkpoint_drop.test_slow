# name: test/sql/storage/concurrent_checkpoint_drop.test_slow
# description: Tables without indexes dropped while a checkpoint runs, also ones it does not have, and older snapshots that read dropped tables after later checkpoints
# group: [storage]

load {TEST_DIR}/concurrent_checkpoint_drop.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
CREATE TABLE a (i INTEGER, s VARCHAR);

statement ok
INSERT INTO a SELECT i, 'a' || i FROM range(100000) t(i);

statement ok
CREATE TABLE keep AS SELECT i FROM range(1000) t(i);

statement ok
CHECKPOINT

statement ok
SET debug_checkpoint_sleep_ms=3000

concurrentloop threadid 0 3

# thread 2 is a reader that needs the state from before the drop
onlyif threadid=2
statement ok
BEGIN TRANSACTION

onlyif threadid=2
query I
SELECT COUNT(*) FROM a
----
100000

onlyif threadid=1
statement ok
BEGIN TRANSACTION

sleep 500 millisecond

onlyif threadid=0
statement ok
INSERT INTO keep VALUES (-1)

onlyif threadid=0
statement ok
CHECKPOINT

sleep 1000 millisecond

# the drop commits while the checkpoint waits before its catalog scan, which still writes the table
onlyif threadid=1
statement ok
DROP TABLE a

onlyif threadid=1
statement ok
COMMIT

# the commit did not wait for the running checkpoint
onlyif threadid=1
statement error
CHECKPOINT
----
Cannot CHECKPOINT

sleep 4000 millisecond

# a later checkpoint while the reader still sees the dropped table
onlyif threadid=1
statement ok
INSERT INTO keep VALUES (-2)

onlyif threadid=1
statement ok
CHECKPOINT

sleep 2000 millisecond

onlyif threadid=2
query II
SELECT COUNT(*), SUM(i) FROM a WHERE s LIKE 'a%'
----
100000	4999950000

onlyif threadid=2
query II
SELECT i, s FROM a WHERE i = 4242
----
4242	a4242

onlyif threadid=2
query II
SELECT i, s FROM a WHERE s = 'a777'
----
777	a777

onlyif threadid=2
statement ok
COMMIT

endloop

statement ok
SET debug_checkpoint_sleep_ms=0

restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

query I
SELECT COUNT(*) FROM duckdb_tables() WHERE table_name = 'a'
----
0

query II
SELECT COUNT(*), SUM(i) FROM keep
----
1002	499497

# a table dropped while a checkpoint runs that rewrites it: that checkpoint still writes the table
statement ok
CREATE TABLE b (i INTEGER, s VARCHAR, t VARCHAR);

statement ok
INSERT INTO b SELECT i, 'b' || i, 't' || i FROM range(100000) t(i);

statement ok
CREATE TABLE u AS SELECT i FROM range(1000) t(i);

statement ok
CHECKPOINT

# the next checkpoint rewrites the updated column and frees the blocks it replaces, after the table was dropped
statement ok
UPDATE b SET t = 'u' || i WHERE i % 10 = 0

statement ok
SET debug_checkpoint_sleep_ms=3000

concurrentloop threadid 0 3

# thread 2 is a reader that needs the state from before the insert below, so that this is a concurrent checkpoint
onlyif threadid=2
statement ok
BEGIN TRANSACTION

onlyif threadid=2
query I
SELECT COUNT(*) FROM b
----
100000

sleep 500 millisecond

onlyif threadid=0
statement ok
INSERT INTO u VALUES (-1)

onlyif threadid=0
statement ok
CHECKPOINT

sleep 1000 millisecond

onlyif threadid=1
statement ok
DROP TABLE b

onlyif threadid=1
statement ok
INSERT INTO u VALUES (5)

# the reader ends, and the drop is cleaned up, while the checkpoint that frees the table still runs
onlyif threadid=2
statement ok
COMMIT

sleep 4000 millisecond

endloop

statement ok
SET debug_checkpoint_sleep_ms=0

# replay the WAL on top of the checkpoint that ran during the drop, twice
restart

loop k 0 2

statement ok
PRAGMA disable_checkpoint_on_shutdown

query II
SELECT COUNT(*) FILTER (WHERE table_name = 'b'), COUNT(*) FILTER (WHERE table_name = 'u') FROM duckdb_tables()
----
0	1

query III
SELECT COUNT(*), COUNT(DISTINCT i), COUNT(*) FILTER (WHERE i = 5) FROM u
----
1002	1001	2

restart

endloop

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
INSERT INTO u VALUES (1000)

# the checkpoint accounts for every block, also those of the dropped table
statement ok
CHECKPOINT

restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

query III
SELECT COUNT(*), COUNT(DISTINCT i), COUNT(*) FILTER (WHERE i = 5) FROM u
----
1003	1002	2

# a checkpoint of an empty WAL does nothing
statement ok
CREATE TABLE tick1 AS SELECT 1 AS x

statement ok
CHECKPOINT

# a reader older than a drop runs the checkpoint that frees the table, and reads it after later checkpoints
statement ok
SET force_compression='uncompressed'

statement ok
CREATE TABLE d AS SELECT i, repeat(md5(i::VARCHAR), 160) AS s FROM range(20000) t(i);

statement ok
DELETE FROM d WHERE i % 3 = 0

statement ok
CREATE TABLE c AS SELECT 1 AS x

# tables the checkpoints below fill while an older reader is open
loop k 0 3

statement ok
CREATE TABLE b{k} (i BIGINT, s VARCHAR);

endloop

statement ok
CHECKPOINT

restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
SET force_compression='uncompressed'

statement ok con1
BEGIN TRANSACTION

query I con1
SELECT COUNT(*) FROM c
----
1

statement ok
DROP TABLE d

statement ok con1
CHECKPOINT

loop k 0 3

statement ok
INSERT INTO b{k} SELECT i, repeat(md5((i + 7)::VARCHAR), 160) AS s FROM range(20000) t(i);

statement ok
DELETE FROM b{k} WHERE i % 3 = 1

statement ok
CHECKPOINT

endloop

query IIIIII con1
SELECT COUNT(*), SUM(i), COUNT(*) FILTER (WHERE i % 3 = 0), COUNT(*) FILTER (WHERE i % 3 = 1), SUM(length(s)), bool_and(s = repeat(md5(i::VARCHAR), 160)) FROM d
----
13333	133326667	0	6667	68264960	true

# a crash while the old reader still keeps the dropped blocks from reuse: they are free on disk
restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
CREATE TABLE tick2 AS SELECT 1 AS x

statement ok
CHECKPOINT

query I
SELECT COUNT(*) FROM duckdb_tables() WHERE table_name = 'd'
----
0

query II
SELECT COUNT(*), SUM(i) FROM b2
----
13333	133320000

# a table dropped before any checkpoint wrote it: only the WAL references its blocks
statement ok
SET checkpoint_threshold='1TB'

statement ok
CREATE TABLE f (i BIGINT, s VARCHAR)

statement ok
CHECKPOINT

statement ok
CREATE TABLE n AS SELECT i, i::VARCHAR || 'n' AS s FROM range(1000000) t(i)

statement ok con2
BEGIN TRANSACTION

query I con2
SELECT COUNT(*) FROM n
----
1000000

statement ok
DROP TABLE n

# frees n on disk while con2 still reads it
statement ok
CHECKPOINT

statement ok
INSERT INTO f SELECT i, i::VARCHAR || 'f' AS s FROM range(1000000) t(i)

statement ok
CHECKPOINT

query III con2
SELECT COUNT(*), SUM(i), SUM(length(s)) FROM n
----
1000000	499999500000	6888890

# a crash while con2 still reads n: its blocks are free on disk
restart

statement ok
SET debug_verify_blocks=true

statement ok
INSERT INTO tick1 VALUES (3)

statement ok
CHECKPOINT

query I
SELECT COUNT(*) FROM duckdb_tables() WHERE table_name = 'n'
----
0

# a table created after the bound of a running checkpoint and dropped while it still runs: the checkpoint takes it over
statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE checkpoint_done (i INTEGER)

statement ok
SET debug_checkpoint_sleep_ms=4000

concurrentloop threadid 0 3

# thread 2 is a reader that needs the state from before the insert below, so that this is a concurrent checkpoint
onlyif threadid=2
statement ok
BEGIN TRANSACTION

onlyif threadid=2
query I
SELECT COUNT(*) FROM checkpoint_done
----
0

sleep 500 millisecond

onlyif threadid=0
statement ok
INSERT INTO tick1 VALUES (4)

onlyif threadid=0
statement ok
CHECKPOINT

onlyif threadid=0
statement ok
INSERT INTO checkpoint_done VALUES (1)

sleep 1000 millisecond

onlyif threadid=1
statement ok
CREATE TABLE gone AS SELECT i, 'g' || i AS s FROM range(200000) t(i)

onlyif threadid=1
statement ok
CREATE TABLE gone_blocks AS SELECT DISTINCT block_id FROM pragma_storage_info('gone') WHERE block_id >= 0

onlyif threadid=1
statement ok
DROP TABLE gone

onlyif threadid=1
query I
SELECT COUNT(*) FROM checkpoint_done
----
0

sleep 5000 millisecond

onlyif threadid=2
statement ok
COMMIT

endloop

statement ok
SET debug_checkpoint_sleep_ms=0

# the WAL still refers to the blocks of the dropped table: new rows must not reuse them yet
statement ok
CREATE TABLE after AS SELECT i, 'a' || i AS s FROM range(300000) t(i)

query II
SELECT COUNT(*) > 0, COUNT(*) FILTER (WHERE block_id IN (SELECT block_id FROM pragma_storage_info('after'))) FROM gone_blocks
----
true	0

# replay the WAL on top of that checkpoint, as after a crash
restart

statement ok
SET debug_verify_blocks=true

query III
SELECT COUNT(*), SUM(i), MAX(s) FROM after
----
300000	44999850000	a99999

query I
SELECT COUNT(*) FROM duckdb_tables() WHERE table_name = 'gone'
----
0

statement ok
INSERT INTO tick1 VALUES (5)

statement ok
CHECKPOINT
