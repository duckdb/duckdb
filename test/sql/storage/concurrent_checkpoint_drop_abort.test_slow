# name: test/sql/storage/concurrent_checkpoint_drop_abort.test_slow
# description: A table dropped while a checkpoint runs that then fails, and recover from the WAL
# group: [storage]

# db is an attached database, so a failing checkpoint on it is scoped to db (the instance keeps running)

foreach abort_mode before_header before_wal_finish before_header_non_fatal

statement ok
ATTACH '{TEST_DIR}/concurrent_checkpoint_drop_abort_{abort_mode}.db' AS db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
CREATE TABLE db.a (i INTEGER, s VARCHAR)

statement ok
INSERT INTO db.a SELECT i, 'a' || i FROM range(100000) t(i)

statement ok
CREATE TABLE db.b (i INTEGER, s VARCHAR)

statement ok
INSERT INTO db.b SELECT i, 'b' || i FROM range(100000) t(i)

statement ok
CREATE TABLE db.keep AS SELECT i FROM range(1000) t(i)

statement ok
CHECKPOINT db

# the failing checkpoint rewrites the table
statement ok
UPDATE db.a SET s = s || 'x' WHERE i % 2 = 0

statement ok
INSERT INTO db.a SELECT i, 'a' || i FROM range(100000, 110000) t(i)

statement ok
INSERT INTO db.b SELECT i, 'b' || i FROM range(100000, 110000) t(i)

# the checkpoint sleeps for three seconds before it scans the catalog, and then fails
statement ok
SET debug_checkpoint_sleep_ms=3000

statement ok
SET debug_checkpoint_abort='{abort_mode}'

concurrentloop threadid 0 3

# thread 2 is a reader that needs the state from before the drop, so that this is a concurrent checkpoint
onlyif threadid=2
statement ok
BEGIN TRANSACTION

onlyif threadid=2
query I
SELECT COUNT(*) FROM db.a
----
110000

sleep 300 millisecond

onlyif threadid=0
statement ok
INSERT INTO db.keep VALUES (-1)

onlyif threadid=0
statement error
CHECKPOINT db
----
<REGEX>:.*Checkpoint aborted.*

sleep 700 millisecond

# during the sleep before the catalog scan: the checkpoint still writes the table, and would free it at its end
onlyif threadid=1
statement ok
DROP TABLE db.a

sleep 5000 millisecond

# a failed checkpoint invalidates the database, also when it fails non-fatally: nothing is freed in memory
onlyif threadid=2
statement error
SELECT COUNT(*), SUM(i), SUM(length(s)) FROM db.a
----
<REGEX>:.*invalidated.*

onlyif threadid=2
statement maybe
COMMIT
----
<REGEX>:.*invalidated.*

endloop

statement ok
SET debug_checkpoint_abort='none'

statement ok
SET debug_checkpoint_sleep_ms=0

statement error
CHECKPOINT db
----
<REGEX>:.*invalidated.*

# recover from the failed checkpoint, twice: the WAL replays the drop, which frees the storage
restart

loop k 0 2

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
ATTACH '{TEST_DIR}/concurrent_checkpoint_drop_abort_{abort_mode}.db' AS db

query I
SELECT COUNT(*) FROM duckdb_tables() WHERE database_name = 'db' AND table_name = 'a'
----
0

query II
SELECT COUNT(*), SUM(i) FROM db.b
----
110000	6049945000

query I
SELECT COUNT(*) - {k} FROM db.keep
----
1001

# the checkpoint accounts for every block, also those of the dropped table
statement ok
INSERT INTO db.keep VALUES (-2)

statement ok
CHECKPOINT db

statement ok
DETACH db

restart

endloop

endloop
