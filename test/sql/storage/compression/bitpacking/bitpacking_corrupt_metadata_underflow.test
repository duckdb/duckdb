# name: test/sql/storage/compression/bitpacking/bitpacking_corrupt_metadata_underflow.test
# description: A bitpacking metadata offset of 0 must error, not underflow the metadata pointer
# group: [bitpacking]

require vector_size 2048

unzip data/storage/corrupt/bitpacking_corrupt_metadata_underflow.db.gz {TEST_DIR}/bitpacking_corrupt_metadata_underflow.db

load {TEST_DIR}/bitpacking_corrupt_metadata_underflow.db readonly

query I
SELECT compression FROM pragma_storage_info('t') WHERE column_name='a' AND compression='BitPacking';
----
BitPacking

statement error
SELECT sum(a) FROM t;
----
Data Corruption Error: Corrupted bitpacking segment: offset is outside the segment

restart

statement ok
SET debug_force_fetch_row=true;

statement error
SELECT sum(a) FROM t;
----
Data Corruption Error: Corrupted bitpacking segment: offset is outside the segment
