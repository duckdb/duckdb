# name: test/sql/storage/compression/bitpacking/bitpacking_corrupt_count.test
# description: A segment.count inflated past the real metadata group directory must error, not read phantom groups
# group: [bitpacking]

require vector_size 2048

unzip data/storage/corrupt/bitpacking_corrupt_count.db.gz {TEST_DIR}/bitpacking_corrupt_count.db

load {TEST_DIR}/bitpacking_corrupt_count.db readonly

query I
SELECT compression FROM pragma_storage_info('t') WHERE column_name='a' AND compression='BitPacking';
----
BitPacking

statement error
SELECT sum(a) FROM t;
----
Data Corruption Error: Corrupted bitpacking segment: group offsets do not describe a range in the data region

restart

statement ok
SET debug_force_fetch_row=true;

statement error
SELECT sum(a) FROM t;
----
Data Corruption Error: Corrupted bitpacking segment: group offsets do not describe a range in the data region
