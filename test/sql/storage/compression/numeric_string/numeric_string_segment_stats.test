# name: test/sql/storage/compression/numeric_string/numeric_string_segment_stats.test
# description: The total string length of a NUMERIC_STRING segment counts only the segment's rows
# group: [numeric_string]

statement ok
ATTACH '{TEST_DIR}/numeric_string_segment_stats.db' AS d (STORAGE_VERSION 'v2.1.0', BLOCK_SIZE 16384);

statement ok
USE d;

statement ok
SET disabled_compression_methods = 'bitpacking';

statement ok
SET force_compression = 'numeric_string';

# small blocks: the vectors straddle the segment boundaries
statement ok
CREATE TABLE t AS SELECT lpad(i::VARCHAR, 18, '0') AS v FROM range(6000) r(i);

statement ok
CHECKPOINT;

query I
SELECT count(*) > 1 FROM pragma_storage_info('t') WHERE segment_type = 'VARCHAR' AND compression = 'NUMERIC_STRING';
----
true

# the segment totals add up to the string lengths of the table (the table-level total depends on the plan that
# appended the rows, not on the compression method)
query II
SELECT sum(stats.total_string_length::BIGINT), (SELECT sum(length(v)) FROM t)
FROM pragma_storage_info('t') WHERE column_name = 'v' AND segment_type = 'VARCHAR';
----
108000	108000

query I
SELECT sum(length(v)) FROM t WHERE v >= '000000000000003000';
----
54000
