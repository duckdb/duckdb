# name: test/sql/storage/compression/numeric_string/numeric_string_selection.test
# description: NUMERIC_STRING is picked automatically for high-cardinality numeric strings and only then
# group: [numeric_string]

load {TEST_DIR}/numeric_string_selection.db readwrite v2.1.0

statement ok
CREATE TABLE t AS
SELECT i::VARCHAR AS sequential_ids,
       ((i * 2654435761) % 4294967296)::VARCHAR AS random_ids,
       ((i * 2654435761) % 4294967296 / 100.0)::DECIMAL(18,2)::VARCHAR AS amounts,
       (i % 5)::VARCHAR AS low_cardinality,
       'id-' || i::VARCHAR AS not_numeric,
       CASE WHEN i % 100 = 0 THEN 'n/a' ELSE i::VARCHAR END AS mostly_numeric
FROM range(300000) t(i);

statement ok
CHECKPOINT;

# high-cardinality numeric strings compress better as numbers than as dictionary entries
query II
SELECT column_name, string_agg(DISTINCT compression, ',')
FROM pragma_storage_info('t')
WHERE segment_type = 'VARCHAR' AND column_name IN ('sequential_ids', 'random_ids', 'amounts')
GROUP BY column_name ORDER BY column_name;
----
amounts	NUMERIC_STRING
random_ids	NUMERIC_STRING
sequential_ids	NUMERIC_STRING

# low-cardinality and non-numeric columns never pick the codec
query I
SELECT count(*) FROM pragma_storage_info('t')
WHERE segment_type = 'VARCHAR' AND column_name IN ('low_cardinality', 'not_numeric', 'mostly_numeric') AND compression = 'NUMERIC_STRING';
----
0

query IIII
SELECT count(*), count(DISTINCT random_ids), sum(sequential_ids::BIGINT),
       sum(amounts::DECIMAL(18,2)) = (SELECT sum(((i * 2654435761) % 4294967296 / 100.0)::DECIMAL(18,2)) FROM range(300000) t(i))
FROM t;
----
300000	300000	44999850000	true

# disabling the codec removes it from consideration
statement ok
SET disabled_compression_methods = 'numeric_string';

statement ok
CREATE TABLE t2 AS SELECT sequential_ids FROM t;

statement ok
CHECKPOINT;

query I
SELECT count(*) FROM pragma_storage_info('t2') WHERE segment_type = 'VARCHAR' AND compression = 'NUMERIC_STRING';
----
0

statement ok
RESET disabled_compression_methods;

# explicit USING COMPRESSION
statement ok
CREATE TABLE t3 (v VARCHAR USING COMPRESSION numeric_string);

statement ok
INSERT INTO t3 SELECT (i * 7)::VARCHAR FROM range(10000) t(i);

statement ok
CHECKPOINT;

query I
SELECT DISTINCT compression FROM pragma_storage_info('t3') WHERE segment_type = 'VARCHAR';
----
NUMERIC_STRING

statement error
CREATE TABLE t4 (v INTEGER USING COMPRESSION numeric_string);
----
Binder Error: Can't compress column "v" with type 'INTEGER' (physical: INT32) using compression type 'NUMERIC_STRING'
