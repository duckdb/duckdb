# name: test/sql/storage/compression/alprd/alprd_corrupt_offset_unordered.test
# description: Unordered ALPRD vector offsets must be rejected
# group: [alprd]

require vector_size 2048

unzip data/storage/corrupt/alprd_corrupt_offset_unordered.db.gz {TEST_DIR}/alprd_corrupt_offset_unordered.db

load {TEST_DIR}/alprd_corrupt_offset_unordered.db readonly

query I
SELECT compression FROM pragma_storage_info('t') WHERE column_name='a' AND compression='ALPRD' LIMIT 1;
----
ALPRD

statement error
SELECT sum(a) FROM t;
----
Data Corruption Error: Corrupted ALPRD vector: attempted to read past the end of the segment

restart

statement ok
SET debug_force_fetch_row=true;

statement error
SELECT sum(a) FROM t;
----
Data Corruption Error: Corrupted ALPRD vector: attempted to read past the end of the segment
