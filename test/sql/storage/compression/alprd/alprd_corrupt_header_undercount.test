# name: test/sql/storage/compression/alprd/alprd_corrupt_header_undercount.test
# description: An ALPRD vector whose payload crosses the segment end must be rejected
# group: [alprd]

require vector_size 2048

unzip data/storage/corrupt/alprd_corrupt_header_undercount.db.gz {TEST_DIR}/alprd_corrupt_header_undercount.db

load {TEST_DIR}/alprd_corrupt_header_undercount.db readonly

query I
SELECT compression FROM pragma_storage_info('t') WHERE column_name='a' AND compression='ALPRD' LIMIT 1;
----
ALPRD

statement error
SELECT sum(a) FROM t;
----
Data Corruption Error: Corrupted ALPRD segment: vector offsets do not describe a data range

restart

statement ok
SET debug_force_fetch_row=true;

statement error
SELECT sum(a) FROM t;
----
Data Corruption Error: Corrupted ALPRD segment: vector offsets do not describe a data range
