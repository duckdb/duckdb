# name: test/sql/storage/compression/uncompressed/uncompressed_offset.test
# description: Reading a segment with a block offset past the block must error, not read past the block
# group: [uncompressed]

require vector_size 2048

unzip data/storage/corrupt/uncompressed_offset.db.gz {TEST_DIR}/uncompressed_offset.db

load {TEST_DIR}/uncompressed_offset.db readonly

query I
SELECT compression FROM pragma_storage_info('t') WHERE column_name='b' AND compression='Uncompressed';
----
Uncompressed

statement error
SELECT sum(b) FROM t;
----
Data Corruption Error: Corrupted fixed-size segment: block offset exceeds the block size

restart

statement ok
SET debug_force_fetch_row=true;

statement error
SELECT sum(b) FROM t;
----
Data Corruption Error: Corrupted fixed-size segment: block offset exceeds the block size
