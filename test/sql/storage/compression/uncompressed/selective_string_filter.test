# name: test/sql/storage/compression/uncompressed/selective_string_filter.test
# description: Selective string filters preserve row positions across uncompressed segments
# group: [uncompressed]

require vector_size 2048

load {TEST_DIR}/selective_string_filter.db

statement ok
CREATE TABLE strings(i BIGINT, k INTEGER, s VARCHAR USING COMPRESSION uncompressed);

statement ok
INSERT INTO strings
SELECT i, i % 997,
       CASE WHEN i % 7 <> 0 THEN i::VARCHAR || ':' || repeat('x', 240) END
FROM range(10003) t(i);

statement ok
CHECKPOINT;

restart

# A full vector spans multiple string segments.
query I
SELECT max(count) < 2048 FROM pragma_storage_info('strings') WHERE column_name = 's' AND compression = 'Uncompressed' AND segment_type = 'VARCHAR';
----
true

# Include nulls, gaps between selected rows, and a partial final vector.
query III
SELECT count(*), sum(i), sum(length(s)) FROM strings WHERE k < 3 AND contains(s, '9');
----
26	142597	6367
