# name: test/sql/storage/compression/string/inlined_string_comparison.test
# description: Compare compressed string columns against short (inlined) and long constants
# group: [string]

load {TEST_DIR}/inlined_string_comparison.db readwrite v2.0.0

statement ok
SET force_compression='dict_fsst'

statement ok
CREATE TABLE test (s VARCHAR)

# the values in byte order: '', 'a', 'a\0', 'ab', 'abc', 'abcd', 'abcd\0', 'abcde', 'abcdefgh', 'abcdefghijk',
# 'abcdefghijkl', 'abcdefghijkl\0', 'abcdefghijklm', 'abcdefghijkm', 'abcdefgi', 'abce', 'b'
statement ok
INSERT INTO test SELECT s FROM (VALUES
	(''), ('a'), ('a' || chr(0)), ('ab'), ('abc'), ('abcd'), ('abcd' || chr(0)), ('abcde'), ('abcdefgh'),
	('abcdefghijk'), ('abcdefghijkl'), ('abcdefghijkl' || chr(0)), ('abcdefghijklm'), ('abcdefghijkm'),
	('abcdefgi'), ('abce'), ('b')
) t(s), range(1000) r(i)
ORDER BY hash(i, s)

# NULLs only at the end, so the leading vectors have no NULLs
statement ok
INSERT INTO test SELECT NULL FROM range(1000)

statement ok
CHECKPOINT

query T
SELECT DISTINCT compression FROM pragma_storage_info('test') WHERE segment_type ILIKE 'VARCHAR'
----
DICT_FSST

# =, <>, >, < through pushed-down table filters, then through filter expressions
statement ok
CREATE MACRO compare_constant(c) AS TABLE
SELECT (SELECT count(*) FROM test WHERE s = c), (SELECT count(*) FROM test WHERE s <> c),
	(SELECT count(*) FROM test WHERE s > c), (SELECT count(*) FROM test WHERE s < c),
	count(*) FILTER (s = c), count(*) FILTER (c <> s), count(*) FILTER (s > c), count(*) FILTER (c > s)
FROM test

query IIIIIIII
FROM compare_constant('')
----
1000	16000	16000	0	1000	16000	16000	0

query IIIIIIII
FROM compare_constant('a' || chr(0))
----
1000	16000	14000	2000	1000	16000	14000	2000

query IIIIIIII
FROM compare_constant('abcd' || chr(0))
----
1000	16000	10000	6000	1000	16000	10000	6000

query IIIIIIII
FROM compare_constant('abcdefghijkl')
----
1000	16000	6000	10000	1000	16000	6000	10000

query IIIIIIII
FROM compare_constant('abcdefghijklm')
----
1000	16000	4000	12000	1000	16000	4000	12000

query IIIIIIII
FROM compare_constant('abcc')
----
0	17000	12000	5000	0	17000	12000	5000

query IIIIIIII
FROM compare_constant('abcdefghijkz')
----
0	17000	3000	14000	0	17000	3000	14000
