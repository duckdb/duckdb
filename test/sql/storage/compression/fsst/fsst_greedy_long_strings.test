# name: test/sql/storage/compression/fsst/fsst_greedy_long_strings.test
# description: FSST compresses strings longer than 511 bytes greedily, without chunking
# group: [fsst]

statement ok
SET force_compression = 'fsst';

statement ok
ATTACH '{TEST_DIR}/fsst_greedy.db' AS db
    (BLOCK_SIZE 262144, STORAGE_VERSION 'v1.2.0');

statement ok
CREATE TABLE db.t AS
SELECT repeat('x', 510) || 'abcdefghij' || lpad(i::VARCHAR, 8, '0') AS s
FROM range(3500) t(i);

statement ok
CHECKPOINT db;

query I
SELECT count(*)
FROM pragma_storage_info('db.t')
WHERE column_name = 's'
  AND compression = 'FSST';
----
1
