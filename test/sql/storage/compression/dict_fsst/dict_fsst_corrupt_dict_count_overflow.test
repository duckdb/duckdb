# name: test/sql/storage/compression/dict_fsst/dict_fsst_corrupt_dict_count_overflow.test
# description: A dict_count close to UINT32_MAX must not overflow the string lengths buffer size
# group: [dict_fsst]

require vector_size 2048

unzip data/storage/corrupt/dict_fsst_corrupt_dict_count_overflow.db.gz {TEST_DIR}/dict_fsst_corrupt_dict_count_overflow.db

load {TEST_DIR}/dict_fsst_corrupt_dict_count_overflow.db readonly

statement ok
USE dict_fsst_corrupt_dict_count_overflow

query I
SELECT compression FROM pragma_storage_info('t') WHERE column_name='s' AND compression='DICT_FSST' LIMIT 1;
----
DICT_FSST

statement error
SELECT count(DISTINCT s) FROM t;
----
Data Corruption Error: Corrupted DICT_FSST segment: zero-width lengths allow at most two dictionary entries

restart

statement ok
SET debug_force_fetch_row=true;

statement error
SELECT count(DISTINCT s) FROM t;
----
Data Corruption Error: Corrupted DICT_FSST segment: zero-width lengths allow at most two dictionary entries
