# name: test/sql/storage/compression/dict_fsst/dict_fsst_corrupt_string_length.test
# description: String lengths that run past the end of the dictionary must error, not read past it
# group: [dict_fsst]

require vector_size 2048

unzip data/storage/corrupt/dict_fsst_corrupt_string_length.db.gz {TEST_DIR}/dict_fsst_corrupt_string_length.db

load {TEST_DIR}/dict_fsst_corrupt_string_length.db readonly

statement ok
USE dict_fsst_corrupt_string_length;

query I
SELECT compression FROM pragma_storage_info('t') WHERE column_name='s' AND segment_type='VARCHAR';
----
DICT_FSST

statement error
SELECT sum(length(s)) FROM t;
----
Data Corruption Error: Failed to scan dictionary string - dictionary offset was out of range. Database file appears to be corrupted.

restart

statement ok
SET debug_force_fetch_row=true;

statement error
SELECT sum(length(s)) FROM t;
----
Data Corruption Error: Failed to scan dictionary string - dictionary offset was out of range. Database file appears to be corrupted.

# a single row only unpacks the lengths of its own group
statement error
SELECT s FROM t WHERE rowid = 999;
----
Data Corruption Error: Failed to scan dictionary string - dictionary offset was out of range. Database file appears to be corrupted.
