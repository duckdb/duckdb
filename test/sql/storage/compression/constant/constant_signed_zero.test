# name: test/sql/storage/compression/constant/constant_signed_zero.test
# description: CONSTANT compression must preserve IEEE signed zero
# group: [constant]

load {TEST_DIR}/constant_signed_zero.db

statement ok
CREATE TABLE t AS SELECT * FROM (VALUES (-0e0::DOUBLE), (0e0::DOUBLE)) tbl(x);

statement ok
CHECKPOINT

query I
SELECT compression FROM pragma_storage_info('t') WHERE segment_type ILIKE 'DOUBLE'
----
Constant

restart

query I
SELECT signbit(x) FROM t ORDER BY signbit(x)
----
0
1
