# name: test/sql/storage/compression/constant/constant_signed_zero.test
# description: CONSTANT compression must preserve IEEE signed zero
# group: [constant]

load {TEST_DIR}/constant_signed_zero.db

# Mixed +0/-0 cannot be CONSTANT (one stored value cannot keep both signs).
statement ok
CREATE TABLE mixed AS SELECT * FROM (VALUES (-0e0::DOUBLE), (0e0::DOUBLE)) tbl(x);

statement ok
CHECKPOINT

restart

query I
SELECT signbit(x) FROM mixed ORDER BY signbit(x)
----
0
1

# A column of only -0 can still use CONSTANT and must keep the sign bit.
statement ok
CREATE TABLE neg AS SELECT -0e0::DOUBLE AS x FROM range(2);

statement ok
CHECKPOINT

query I
SELECT compression FROM pragma_storage_info('neg') WHERE segment_type ILIKE 'DOUBLE'
----
Constant

restart

query I
SELECT DISTINCT signbit(x) FROM neg
----
1
