require vector_size 2048

unzip data/storage/corrupt/alp_corrupt_exception_position.db.gz {TEST_DIR}/alp_corrupt_exception_position.db

statement ok
ATTACH '{TEST_DIR}/alp_corrupt_exception_position.db' AS db2

statement ok
USE db2;

query I
SELECT compression FROM pragma_storage_info('two_alp') WHERE compression='ALP';
