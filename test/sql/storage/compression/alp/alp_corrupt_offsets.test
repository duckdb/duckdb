# name: test/sql/storage/compression/alp/alp_corrupt_offsets.test
# group: [alp]

require vector_size 2048

unzip data/storage/corrupt/alp_corrupt_offsets.db.gz {TEST_DIR}/alp_corrupt_offsets.db

statement ok
ATTACH '{TEST_DIR}/alp_corrupt_offsets.db' AS db2

statement ok
USE db2;

query I
SELECT compression FROM pragma_storage_info('random_alp_double') WHERE compression='ALP';
----
ALP

statement error
SELECT * FROM random_alp_double LIMIT 1;
----
Data Corruption Error: Corrupted ALP segment: vector offsets do not describe a data range
