# name: test/sql/storage/compression/alp/alp_corrupt_header_undercount.test
# description: An ALP vector offset outside the data region must be rejected
# group: [alp]

require vector_size 2048

unzip data/storage/corrupt/alp_corrupt_header_undercount.db.gz {TEST_DIR}/alp_corrupt_header_undercount.db

load {TEST_DIR}/alp_corrupt_header_undercount.db readonly

query I
SELECT compression FROM pragma_storage_info('t') WHERE column_name='a' AND compression='ALP';
----
ALP

statement error
SELECT sum(a) FROM t;
----
Data Corruption Error: Corrupted ALP segment: vector offsets do not describe a data range

restart

statement ok
SET debug_force_fetch_row=true;

statement error
SELECT sum(a) FROM t;
----
Data Corruption Error: Corrupted ALP segment: vector offsets do not describe a data range
