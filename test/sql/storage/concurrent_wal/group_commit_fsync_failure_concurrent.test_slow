# name: test/sql/storage/concurrent_wal/group_commit_fsync_failure_concurrent.test_slow
# description: Group commit: when a shared fsync fails no commit in the group is acknowledged, and the database fails stop
# group: [concurrent_wal]

load {TEST_DIR}/group_commit_fsync_fail_conc.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE t(i INTEGER)

# these commits are acknowledged before any failure is injected
statement ok
INSERT INTO t SELECT range FROM range(50)

statement ok
SET debug_force_wal_fsync_failure=true

# one leader's fsync covers the whole group, so every committer must observe the failure and none
# may be acknowledged. Nothing may hang, and the database must fail stop rather than continue
concurrentloop threadid 0 8

loop x 0 20

statement maybe
INSERT INTO t VALUES (1000 + {threadid} * 100 + {x});
----

endloop

endloop

# fail-stop: the database is invalidated rather than silently continuing
statement error
INSERT INTO t VALUES (999999)
----

restart

# the acknowledged prefix comes back intact; the commits whose sync failed are in doubt and may be
# replayed, since their bytes reached the OS before the failure
query I
SELECT count(*) FILTER (WHERE i < 1000) FROM t
----
50

query I
SELECT count(*) >= 50 FROM t
----
true
