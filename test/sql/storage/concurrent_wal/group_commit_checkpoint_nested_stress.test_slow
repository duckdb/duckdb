# name: test/sql/storage/concurrent_wal/group_commit_checkpoint_nested_stress.test_slow
# description: Group commit: nested (LIST/ARRAY) appends racing force checkpoints
# group: [concurrent_wal]

# a checkpoint must freeze each row group at its snapshot's row count and cut LIST/ARRAY child columns to match

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

# widen the checkpoint window so it overlaps in-flight commits
foreach sleep_time 50

statement ok
SET debug_checkpoint_sleep_ms={sleep_time}

statement ok
ATTACH '{TEST_DIR}/group_commit_ckpt_nested{sleep_time}.db' AS gc

statement ok
CREATE TABLE gc.t(i INTEGER, l INTEGER[], a INTEGER[3])

# threads 0-8 insert disjoint key ranges; thread 9 force-checkpoints
concurrentloop threadid 0 10

loop x 0 8

onlyif threadid<>9
statement ok
INSERT INTO gc.t SELECT i, [i + y FOR y IN range((i % 4) + 1)], [i, i + 10, i + 20] FROM range({threadid} * 100000 + {x} * 2000, {threadid} * 100000 + {x} * 2000 + 2000) t(i)

onlyif threadid=9
statement maybe
FORCE CHECKPOINT gc
----

endloop

endloop

# 9 threads x 8 iterations x 2000 rows, every key exactly once
query II
SELECT COUNT(*), COUNT(DISTINCT i) FROM gc.t
----
144000	144000

# nested values intact
query I
SELECT COUNT(*) FROM gc.t WHERE l != [i + y FOR y IN range((i % 4) + 1)] OR a != [i, i + 10, i + 20]
----
0

# and after a reload
statement ok
DETACH gc

statement ok
ATTACH '{TEST_DIR}/group_commit_ckpt_nested{sleep_time}.db' AS gc

query II
SELECT COUNT(*), COUNT(DISTINCT i) FROM gc.t
----
144000	144000

query I
SELECT COUNT(*) FROM gc.t WHERE l != [i + y FOR y IN range((i % 4) + 1)] OR a != [i, i + 10, i + 20]
----
0

statement ok
DETACH gc

statement ok
SET debug_checkpoint_sleep_ms=0

endloop
