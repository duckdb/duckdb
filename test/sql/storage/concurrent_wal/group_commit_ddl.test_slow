# name: test/sql/storage/concurrent_wal/group_commit_ddl.test_slow
# description: Group commit: concurrent DDL and data commits
# group: [concurrent_wal]

# WAL-only, so reopening replays catalog and data
statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

# widen the publish-to-durable window
statement ok
SET debug_wal_fsync_sleep_ms=2

statement ok
ATTACH '{TEST_DIR}/group_commit_ddl.db' AS gc

statement ok
CREATE TABLE gc.base(i INTEGER)

statement ok
INSERT INTO gc.base SELECT range FROM range(100)

statement ok
CREATE TABLE gc.owner(i INTEGER)

statement ok
CREATE VIEW gc.owner_view AS SELECT * FROM gc.owner

# threads 0-2 churn views, 3-5 append, 6 drops and recreates a dependency pair
concurrentloop threadid 0 7

loop x 0 15

onlyif threadid<3
statement maybe
CREATE OR REPLACE VIEW gc.v_{threadid}_{x} AS SELECT count(*) AS c FROM gc.base;
----

onlyif threadid<3
statement maybe
DROP VIEW IF EXISTS gc.v_{threadid}_{x};
----

onlyif threadid>=3
statement maybe
INSERT INTO gc.base VALUES ({threadid} * 1000 + {x});
----

onlyif threadid=6
statement maybe
DROP VIEW IF EXISTS gc.owner_view;
----

onlyif threadid=6
statement maybe
CREATE OR REPLACE VIEW gc.owner_view AS SELECT * FROM gc.owner;
----

endloop

endloop

query I
SELECT count(*) >= 100 AND count(*) = count(DISTINCT i) FROM gc.base
----
true

# reopen: replayed from the WAL
statement ok
DETACH gc

statement ok
ATTACH '{TEST_DIR}/group_commit_ddl.db' AS gc

query I
SELECT count(*) >= 100 AND count(*) = count(DISTINCT i) FROM gc.base
----
true

statement ok
CHECKPOINT gc

query I
SELECT count(*) >= 100 AND count(*) = count(DISTINCT i) FROM gc.base
----
true
