# name: test/sql/storage/concurrent_wal/group_commit_unique_conflict.test_slow
# description: Group commit: concurrent inserts of the same primary keys never duplicate
# group: [concurrent_wal]

# WAL-only, so reopening replays the primary-key index
statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

# widen the publish-to-durable window
statement ok
SET debug_wal_fsync_sleep_ms=2

statement ok
ATTACH '{TEST_DIR}/group_commit_unique_conflict.db' AS gc

statement ok
CREATE TABLE gc.t(id INTEGER PRIMARY KEY, who INTEGER)

# 8 threads race to insert the same 200 keys; exactly one wins each
concurrentloop threadid 0 8

loop k 0 200

statement maybe
INSERT INTO gc.t VALUES ({k}, {threadid})
----

endloop

endloop

# every key exactly once
query III
SELECT COUNT(*), COUNT(DISTINCT id), MAX(id) FROM gc.t
----
200	200	199

query I
SELECT COUNT(*) FROM gc.t WHERE id < 0 OR id >= 200
----
0

# the primary key is still enforced
statement error
INSERT INTO gc.t VALUES (0, 99)
----
<REGEX>:.*violates primary key.*

# reopen: replayed from the WAL
statement ok
DETACH gc

statement ok
ATTACH '{TEST_DIR}/group_commit_unique_conflict.db' AS gc

query II
SELECT COUNT(*), COUNT(DISTINCT id) FROM gc.t
----
200	200

# still enforced after replay
statement error
INSERT INTO gc.t VALUES (100, 99)
----
<REGEX>:.*violates primary key.*
