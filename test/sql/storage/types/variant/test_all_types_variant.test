# name: test/sql/storage/types/variant/test_all_types_variant.test
# group: [variant]

load {TEST_DIR}/test_all_types_variant.db readwrite v1.5.0

# GEOGRAPHY values cannot be stored in a VARIANT column at this storage version
statement ok
create table tbl as select COLUMNS(* EXCLUDE (geography))::VARIANT from test_all_types()

statement ok
checkpoint

restart

foreach col <all_types_columns>

query I nosort expected_res
select "{col}"::VARIANT from test_all_types()
----

query I nosort expected_res
select "{col}" from tbl
----

reset label expected_res

endloop
