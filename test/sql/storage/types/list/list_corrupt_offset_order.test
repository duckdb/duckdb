# name: test/sql/storage/types/list/list_corrupt_offset_order.test
# description: Decreasing list offset must error, not underflow
# group: [list]

require vector_size 2048

unzip data/storage/corrupt/list_corrupt_offset_order.db.gz {TEST_DIR}/list_corrupt_offset_order.db

load {TEST_DIR}/list_corrupt_offset_order.db readonly

statement error
SELECT len(a) FROM t LIMIT 5 OFFSET 98;
----
Data Corruption Error: Corrupted LIST column: later offset is smaller than the preceding offset

restart

statement ok
SET debug_force_fetch_row=true;

statement error
SELECT len(a) FROM t LIMIT 5 OFFSET 98;
----
Data Corruption Error: Corrupted LIST column: later offset is smaller than the preceding offset
