# name: test/sql/storage/read_duckdb/read_duckdb_schema_filter_pushdown.test
# description: Filters on columns read_duckdb reads as stored reach the table scan when another column is converted
# group: [read_duckdb]

require json

require no_alternative_verify

statement ok
SET threads = 1

# i and k ascend, so their zonemaps let the table scan skip row groups - p makes the row groups large
statement ok
ATTACH '{TEST_DIR}/rd_schema_pushdown.db' AS rd

statement ok
CREATE TABLE rd.t AS SELECT i::INTEGER i, i::BIGINT k, hash(i) p, hash(i + 1) q FROM range(600000) r(i)

statement ok
DETACH rd

# i is read as BIGINT, k and p are read as stored
statement ok
CREATE VIEW mapped AS
FROM read_duckdb('{TEST_DIR}/rd_schema_pushdown.db', schema = MAP {
	'i': {name: 'i', type: 'BIGINT', default_value: NULL},
	'k': {name: 'k', type: 'BIGINT', default_value: NULL},
	'p': {name: 'p', type: 'UBIGINT', default_value: NULL}
})

# the filters stay in the scan
query II
EXPLAIN SELECT i, k, p FROM mapped WHERE k = 599999
----
physical_plan	<REGEX>:.*READ_DUCKDB.*Filters: k = 599999.*

query II
EXPLAIN SELECT i, k, p FROM mapped WHERE k = 599999
----
physical_plan	<!REGEX>:.*Filter .*

query II
EXPLAIN SELECT i, k, p FROM mapped WHERE i = 599999
----
physical_plan	<REGEX>:.*READ_DUCKDB.*Filters: i = 599999.*

query II
EXPLAIN SELECT i, k, p FROM mapped WHERE i >= 599990 AND k > 599000
----
physical_plan	<REGEX>:.*READ_DUCKDB.*Filters:.*

query II
EXPLAIN SELECT i, k, p FROM mapped WHERE i >= 599990 AND k > 599000
----
physical_plan	<!REGEX>:.*Filter .*

statement ok
SET tracked_metrics = ['io.total_bytes_read']

# no filter: every row group is read
statement ok
SET enable_profiling = 'json'

statement ok
SET profiling_output = '{TEST_DIR}/rd_schema_pushdown_all.json'

query III
SELECT count(*), sum(i), bit_xor(p) = (SELECT bit_xor(hash(i)) FROM range(600000) r(i)) FROM mapped
----
600000	179999700000	true

statement ok
PRAGMA disable_profiling

# a filter on a column that is read as stored: the table scan skips the row groups its zonemaps exclude
statement ok
SET enable_profiling = 'json'

statement ok
SET profiling_output = '{TEST_DIR}/rd_schema_pushdown_direct.json'

query III
SELECT count(*), sum(i), bit_xor(p) = hash(599999) FROM mapped WHERE k = 599999
----
1	599999	true

statement ok
PRAGMA disable_profiling

# the same filter beside a filter on the converted column
statement ok
SET enable_profiling = 'json'

statement ok
SET profiling_output = '{TEST_DIR}/rd_schema_pushdown_both.json'

query III
SELECT count(*), sum(i), bit_xor(p) = (SELECT bit_xor(hash(i)) FROM range(599990, 600000) r(i))
FROM mapped WHERE i >= 599990 AND k > 599000
----
10	5999945	true

statement ok
PRAGMA disable_profiling

# a filter on the converted column only is applied after the conversion
query III
SELECT count(*), sum(i), bit_xor(p) = (SELECT bit_xor(hash(i)) FROM range(599990, 600000) r(i))
FROM mapped WHERE i >= 599990
----
10	5999945	true

query I
SELECT io.total_bytes_read > 0 FROM '{TEST_DIR}/rd_schema_pushdown_all.json'
----
true

query I
SELECT d.io.total_bytes_read * 2 < a.io.total_bytes_read
FROM '{TEST_DIR}/rd_schema_pushdown_all.json' a, '{TEST_DIR}/rd_schema_pushdown_direct.json' d
----
true

query I
SELECT b.io.total_bytes_read * 2 < a.io.total_bytes_read
FROM '{TEST_DIR}/rd_schema_pushdown_all.json' a, '{TEST_DIR}/rd_schema_pushdown_both.json' b
----
true

# a read_duckdb without a schema pushes the filter as before
statement ok
SET enable_profiling = 'json'

statement ok
SET profiling_output = '{TEST_DIR}/rd_schema_pushdown_plain.json'

query II
SELECT count(*), bit_xor(p) = hash(599999) FROM read_duckdb('{TEST_DIR}/rd_schema_pushdown.db') WHERE i = 599999
----
1	true

statement ok
PRAGMA disable_profiling

query I
SELECT p.io.total_bytes_read * 2 < a.io.total_bytes_read
FROM '{TEST_DIR}/rd_schema_pushdown_all.json' a, '{TEST_DIR}/rd_schema_pushdown_plain.json' p
----
true

# two databases that store i with different integer widths
statement ok
ATTACH '{TEST_DIR}/rd_schema_pushdown_wide.db' AS rd

statement ok
CREATE TABLE rd.t AS SELECT (i + 600000)::BIGINT i, i::BIGINT k, hash(i) p, hash(i + 1) q FROM range(600000) r(i)

statement ok
DETACH rd

statement ok
CREATE VIEW two_files AS
SELECT i, p FROM read_duckdb(['{TEST_DIR}/rd_schema_pushdown_wide.db', '{TEST_DIR}/rd_schema_pushdown.db'])

query II
SELECT count(*), typeof(any_value(i)) FROM two_files WHERE p IS NOT NULL
----
1200000	BIGINT

# the row is in the file whose column is converted
query II
SELECT i, p = hash(5) FROM two_files WHERE i = 5
----
5	true

# the row is in the file that stores the scan type
query II
SELECT i, p = hash(599999) FROM two_files WHERE i = 1199999
----
1199999	true

# late materialization: the top-N over the converted column runs over a scan of its own, the other columns are
# fetched by row id
query II
EXPLAIN SELECT i, k, p FROM mapped ORDER BY i DESC LIMIT 2
----
physical_plan	<REGEX>:.*SEMI.*

query III
SELECT i, k, p = hash(i) FROM mapped ORDER BY i DESC LIMIT 2
----
599999	599999	true
599998	599998	true

query II
EXPLAIN SELECT i, p FROM two_files ORDER BY i LIMIT 2
----
physical_plan	<REGEX>:.*SEMI.*

query II
SELECT i, p = hash(i) FROM two_files ORDER BY i LIMIT 2
----
0	true
1	true

# a narrowing conversion that fails is only run on the rows the other filters keep
statement ok
CREATE VIEW too_narrow AS FROM read_duckdb('{TEST_DIR}/rd_schema_pushdown.db', schema = MAP {
	'i': {name: 'i', type: 'INTEGER', default_value: NULL},
	'k': {name: 'k', type: 'SMALLINT', default_value: NULL}
})

query II
SELECT i, k FROM too_narrow WHERE k = 600 AND i < 1000
----
600	600

query II
SELECT count(*), max(k) FROM too_narrow WHERE k > 100 AND i < 1000
----
899	999

statement error
SELECT count(*) FROM too_narrow WHERE k > 100 AND i > 100000
----
Conversion Error

statement error
SELECT max(k) FROM too_narrow
----
Conversion Error

# rows the conversion fails on are interleaved with rows it succeeds on in every vector - a filter on a column read as
# stored removes the failing ones before the conversion runs
statement ok
ATTACH '{TEST_DIR}/rd_schema_pushdown_mixed.db' AS rd

statement ok
CREATE TABLE rd.t AS
SELECT i::BIGINT id, (CASE WHEN i % 7 = 1 THEN i % 1000 ELSE 100000 + i END)::BIGINT k, 'v' || (i % 7) d
FROM range(600000) r(i)

statement ok
DETACH rd

statement ok
CREATE VIEW mixed AS FROM read_duckdb('{TEST_DIR}/rd_schema_pushdown_mixed.db', schema = MAP {
	'id': {name: 'id', type: 'BIGINT', default_value: NULL},
	'k': {name: 'k', type: 'SMALLINT', default_value: NULL},
	'd': {name: 'd', type: 'VARCHAR', default_value: NULL}
})

query I
SELECT (SELECT (count(*), min(k), max(k), sum(id)) FROM mixed WHERE k = 8 AND d = 'v1') =
       (SELECT (count(*), 8::SMALLINT, 8::SMALLINT, sum(i)) FROM range(600000) r(i) WHERE i % 7 = 1 AND i % 1000 = 8)
----
true

query I
SELECT (SELECT (count(*), sum(k), sum(id)) FROM mixed WHERE d = 'v1' AND k < 500) =
       (SELECT (count(*), sum(i % 1000), sum(i)) FROM range(600000) r(i) WHERE i % 7 = 1 AND i % 1000 < 500)
----
true

query II
SELECT count(*), max(k) FROM mixed WHERE d = 'v1'
----
85715	999

statement error
SELECT count(*) FROM mixed WHERE k = 8
----
Conversion Error

statement error
SELECT count(*) FROM mixed WHERE k = 8 AND d = 'v2'
----
Conversion Error

# an equality on an indexed column that is read as stored uses the index, also beside a filter on a converted column
# the rows are shuffled, so the zonemaps of id exclude nothing
statement ok
ATTACH '{TEST_DIR}/rd_schema_pushdown_index.db' AS rd

statement ok
CREATE TABLE rd.t (id INTEGER PRIMARY KEY, x INTEGER, p UBIGINT, q UBIGINT)

statement ok
INSERT INTO rd.t SELECT i, i % 1000, hash(i), hash(i + 1) FROM range(600000) r(i) ORDER BY hash(i + 7)

statement ok
CHECKPOINT rd

statement ok
DETACH rd

statement ok
CREATE VIEW indexed AS FROM read_duckdb('{TEST_DIR}/rd_schema_pushdown_index.db', schema = MAP {
	'id': {name: 'id', type: 'INTEGER', default_value: NULL},
	'x': {name: 'x', type: 'BIGINT', default_value: NULL},
	'p': {name: 'p', type: 'UBIGINT', default_value: NULL}
})

statement ok
SET enable_profiling = 'json'

statement ok
SET profiling_output = '{TEST_DIR}/rd_schema_pushdown_index_all.json'

query II
SELECT count(*), bit_xor(p) = (SELECT bit_xor(hash(i)) FROM range(600000) r(i)) FROM indexed
----
600000	true

statement ok
PRAGMA disable_profiling

statement ok
SET enable_profiling = 'json'

statement ok
SET profiling_output = '{TEST_DIR}/rd_schema_pushdown_index_key.json'

query III
SELECT id, x, p = hash(77777) FROM indexed WHERE id = 77777
----
77777	777	true

statement ok
PRAGMA disable_profiling

statement ok
SET enable_profiling = 'json'

statement ok
SET profiling_output = '{TEST_DIR}/rd_schema_pushdown_index_both.json'

query III
SELECT id, x, p = hash(77777) FROM indexed WHERE id = 77777 AND x = 777
----
77777	777	true

statement ok
PRAGMA disable_profiling

query I
SELECT count(*) FROM indexed WHERE id = 77777 AND x = 778
----
0

query I
SELECT k.io.total_bytes_read * 4 < a.io.total_bytes_read
FROM '{TEST_DIR}/rd_schema_pushdown_index_all.json' a, '{TEST_DIR}/rd_schema_pushdown_index_key.json' k
----
true

query I
SELECT b.io.total_bytes_read * 4 < a.io.total_bytes_read
FROM '{TEST_DIR}/rd_schema_pushdown_index_all.json' a, '{TEST_DIR}/rd_schema_pushdown_index_both.json' b
----
true

