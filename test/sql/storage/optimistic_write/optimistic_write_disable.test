# name: test/sql/storage/optimistic_write/optimistic_write_disable.test
# description: Test the enable_optimistic_write setting
# group: [optimistic_write]

# with optimistic writing enabled (the default), a large append is written to disk during the transaction
# only the (small) block pointers end up in the WAL
load {TEST_DIR}/optimistic_write_enabled.db

statement ok
SET debug_skip_checkpoint_on_commit=true

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE t1 (i INTEGER)

statement ok
INSERT INTO t1 SELECT * FROM range(2000000)

# the data was written to disk optimistically, so the WAL stays small (kilobytes)
query I
SELECT wal_size NOT LIKE '%MiB' FROM pragma_database_size()
----
1

restart

query I
SELECT sum(i) FROM t1
----
1999999000000

# with optimistic writing disabled, the whole append is kept in memory - nothing is written to disk
# so the full data set has to be written to the WAL instead (megabytes)
load {TEST_DIR}/optimistic_write_disabled.db

statement ok
SET debug_skip_checkpoint_on_commit=true

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET enable_optimistic_write=false

statement ok
CREATE TABLE t1 (i INTEGER)

statement ok
INSERT INTO t1 SELECT * FROM range(2000000)

# nothing was optimistically written, so the full data set lands in the WAL
query I
SELECT wal_size LIKE '%MiB' FROM pragma_database_size()
----
1

restart

query I
SELECT sum(i) FROM t1
----
1999999000000
