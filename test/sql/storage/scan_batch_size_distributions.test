# worst_bpr = 4 + 16 + 2000 and Target=131072 → ~65 rows/batch throughout.
# ============================================================

statement ok
CREATE TABLE t_varchar_linear AS SELECT i, repeat('g', i % 2001) as v FROM range(0, 5000) tbl(i)

statement ok
SET scan_target_size_bytes=131072

