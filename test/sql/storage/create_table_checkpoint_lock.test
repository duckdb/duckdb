# name: test/sql/storage/create_table_checkpoint_lock.test
# description: CREATE TABLE AS with rows written to blocks before its commit, across checkpoints that run meanwhile
# group: [storage]

require skip_reload

load {TEST_DIR}/create_table_checkpoint_lock.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
CREATE TABLE tick (i INTEGER)

statement ok
CHECKPOINT

# rolled back after a checkpoint wrote its header
statement ok con1
BEGIN TRANSACTION

statement ok con1
CREATE TABLE rolled_back AS SELECT i, 's' || i AS s FROM range(300000) t(i)

statement ok
INSERT INTO tick VALUES (1)

statement ok
CHECKPOINT

statement ok con1
ROLLBACK

# created and dropped in one transaction, across a checkpoint
statement ok con1
BEGIN TRANSACTION

statement ok con1
CREATE TABLE created_and_dropped AS SELECT i, 's' || i AS s FROM range(300000) t(i)

statement ok
INSERT INTO tick VALUES (2)

statement ok
CHECKPOINT

statement ok con1
DROP TABLE created_and_dropped

statement ok con1
COMMIT

# committed after a checkpoint wrote its header, which lists the blocks of the rows as free
statement ok con1
BEGIN TRANSACTION

statement ok con1
CREATE TABLE ctas AS SELECT i, 's' || i AS s FROM range(300000) t(i)

statement ok
INSERT INTO tick VALUES (3)

statement ok
CHECKPOINT

statement ok con1
COMMIT

# WAL replay claims these blocks again
restart

statement ok
SET checkpoint_threshold='1TB'

statement ok
SET debug_verify_blocks=true

query I
SELECT table_name FROM duckdb_tables() ORDER BY ALL
----
ctas
tick

query III
SELECT COUNT(*), SUM(i), MAX(s) FROM ctas
----
300000	44999850000	s99999

statement ok
INSERT INTO tick VALUES (4)

# the checkpoint accounts for every block
statement ok
CHECKPOINT

# an open transaction with CREATE TABLE AS keeps a checkpoint from vacuuming, as an insert does
statement ok
SET max_vacuum_tasks=99

statement ok
CREATE TABLE vacuumed AS SELECT i FROM range(1000000) t(i)

statement ok
CHECKPOINT

statement ok
DELETE FROM vacuumed WHERE i % 2 = 0

statement ok con1
BEGIN TRANSACTION

statement ok con1
CREATE TABLE ctas_during_vacuum AS SELECT i FROM vacuumed WHERE i < 1000

statement ok
CHECKPOINT

query I
SELECT COUNT(DISTINCT row_group_id) > 6 FROM pragma_storage_info('vacuumed')
----
true

statement ok con1
COMMIT

statement ok
CHECKPOINT

query I
SELECT COUNT(DISTINCT row_group_id) <= 6 FROM pragma_storage_info('vacuumed')
----
true

query II
SELECT COUNT(*), SUM(i) FROM ctas_during_vacuum
----
500	250000
