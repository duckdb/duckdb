# name: test/sql/storage/corrupt/block_alloc_size_underflow.test
# description: Reject a database block allocation size smaller than the block header
# group: [corrupt]

require vector_size 2048

unzip data/storage/corrupt/block_alloc_size_corrupt_underflow.db.gz {TEST_DIR}/block_alloc_size_corrupt_underflow.db

statement error
ATTACH '{TEST_DIR}/block_alloc_size_corrupt_underflow.db' AS corrupt_db (READ_ONLY)
----
Data Corruption Error: Corrupt database file: invalid block allocation size 1
