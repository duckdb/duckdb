# name: test/sql/storage/wal/wal_fsync_failure_reopened.test
# description: A failed fsync must only drop this session's never-durable tail, not the WAL it inherited
# group: [wal]

load __TEST_DIR__/wal_fsync_failure_reopened.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE t(i INTEGER)

statement ok
INSERT INTO t VALUES (1)

# reopen with a non-empty WAL: everything in it is already durable
restart

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

query I
SELECT count(*) FROM t
----
1

statement ok
SET debug_wal_fsync_failure_rate=1.0

statement error
INSERT INTO t VALUES (2)
----
injected WAL fsync failure

# the inherited WAL survives: only the bytes this session never synced are removed
restart

query I
SELECT count(*) FROM t
----
1
