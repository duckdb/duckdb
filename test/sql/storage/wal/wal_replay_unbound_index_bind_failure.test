# name: test/sql/storage/wal/wal_replay_unbound_index_bind_failure.test
# description: A bind that fails after the index storage was handed off cannot be retried and invalidates its database
# group: [wal]

require skip_reload

load {TEST_DIR}/bind_failure_initial.db

statement ok
ATTACH '{TEST_DIR}/bind_failure_attached.db' AS db1;

statement ok
CREATE TEMP MACRO tnorm(s) AS lower(s);

statement ok
CREATE TABLE db1.t(k VARCHAR);

statement ok
CREATE INDEX idx ON db1.t((tnorm(k)));

statement ok
INSERT INTO db1.t VALUES ('a'), ('b');

statement ok
CHECKPOINT db1;

statement ok
SET debug_checkpoint_abort='BEFORE_HEADER_NON_FATAL';

statement ok
SET checkpoint_threshold='999999GB';

# This insert stays in the WAL.
statement ok
INSERT INTO db1.t VALUES ('c');

statement maybe
DETACH db1;
----
Checkpoint aborted before header write (non-fatal) because of PRAGMA checkpoint_abort flag

statement ok
RESET debug_checkpoint_abort;

# The WAL replay buffers the insert, and the redefined macro fails while the bind applies it.
statement ok
CREATE OR REPLACE TEMP MACRO tnorm(s) AS CASE WHEN s = 'c' THEN error('boom') ELSE lower(s) END;

statement ok
ATTACH '{TEST_DIR}/bind_failure_attached.db' AS db1;

# The bound index already took over the on-disk index storage: this bind cannot be retried.
statement error
INSERT INTO db1.t VALUES ('z');
----
Failed to apply the buffered WAL operations

# Instead of retrying the bind, the database is invalidated.
statement error
INSERT INTO db1.t VALUES ('z');
----
invalidated

# Only the attached database is invalidated, not the instance.
query I
SELECT 42;
----
42

# The WAL was kept: detach and reattach recovers it, and binding applies the buffered insert.
statement ok
DETACH db1;

statement ok
CREATE OR REPLACE TEMP MACRO tnorm(s) AS lower(s);

statement ok
ATTACH '{TEST_DIR}/bind_failure_attached.db' AS db1;

query I
SELECT k FROM db1.t ORDER BY k;
----
a
b
c

statement ok
DELETE FROM db1.t;

# The same failure in the initial database invalidates the whole instance.

load {TEST_DIR}/bind_failure_initial2.db

statement ok
CREATE TEMP MACRO tnorm(s) AS lower(s);

statement ok
CREATE TABLE t(k VARCHAR);

statement ok
CREATE INDEX idx ON t((tnorm(k)));

statement ok
INSERT INTO t VALUES ('a'), ('b');

statement ok
CHECKPOINT;

statement ok
SET wal_autocheckpoint = '1TB';

statement ok
PRAGMA disable_checkpoint_on_shutdown;

# This insert stays in the WAL.
statement ok
INSERT INTO t VALUES ('c');

restart

statement ok
CREATE TEMP MACRO tnorm(s) AS CASE WHEN s = 'c' THEN error('boom') ELSE lower(s) END;

statement error
INSERT INTO t VALUES ('z');
----
Failed to apply the buffered WAL operations

statement error
SELECT 42;
----
boom

# The WAL survives the fatal error: a restart with a working macro recovers everything.
restart

statement ok
CREATE TEMP MACRO tnorm(s) AS lower(s);

query I
SELECT k FROM t ORDER BY k;
----
a
b
c

statement ok
DELETE FROM t;
