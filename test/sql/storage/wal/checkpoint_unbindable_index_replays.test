# name: test/sql/storage/wal/checkpoint_unbindable_index_replays.test
# description: Test checkpoints of an index with buffered WAL operations that cannot be bound
# group: [wal]

require skip_reload

# The index expression of idx is a macro of schema s1, so it only binds while s1 is in the search path.
# Any connection that binds the index from outside s1 fails, which is how these tests make binding fail.

load {TEST_DIR}/checkpoint_unbindable_index_replays.db

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET checkpoint_threshold='1TB'

statement ok
CREATE SCHEMA s1

statement ok
USE s1

statement ok
CREATE MACRO m(x) AS x + 1

statement ok
CREATE TABLE t(k INTEGER)

statement ok
CREATE UNIQUE INDEX idx ON t(m(k))

statement ok
CREATE TABLE big AS SELECT i AS a, i AS b FROM range(100000) r(i)

statement ok
CHECKPOINT

# These rows are only in the WAL, so the replay buffers them in the unbound index.
statement ok
INSERT INTO t SELECT i FROM range(100) r(i)

restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

# An explicit CHECKPOINT reports that it cannot persist the buffered operations.
statement error
CHECKPOINT
----
<REGEX>:.*Cannot CHECKPOINT: an index with buffered write-ahead log operations cannot be bound.*

# The failed CHECKPOINT neither invalidates the database nor drops the buffered operations.
query I
SELECT count(*) FROM s1.t
----
100

query I
SELECT wal_size != '0 bytes' FROM pragma_database_size()
----
true

# An automatic checkpoint keeps the WAL instead of writing the index without the buffered operations.
statement ok
SET wal_autocheckpoint='1KB'

statement ok
CREATE TABLE other AS SELECT * FROM range(20000) r(x)

query I
SELECT wal_size != '0 bytes' FROM pragma_database_size()
----
true

# A commit that is large enough to skip its WAL write in favor of the checkpoint must still be durable,
# because the checkpoint it relies on is cancelled.
statement ok
UPDATE s1.big SET b = b + 1

restart

statement ok
USE s1

query II
SELECT count(*), sum(b) FROM big
----
100000	5000050000

query I
SELECT count(*) FROM other
----
20000

# The buffered index operations are still there: the unique index sees the rows of the WAL.
statement error
INSERT INTO t VALUES (5)
----
<REGEX>:.*Constraint Error.*

query I
SELECT count(*) FROM t
----
100

# Binding the index succeeds from s1, so the checkpoint persists the buffered operations.
statement ok
CHECKPOINT

query I
SELECT wal_size FROM pragma_database_size()
----
0 bytes

restart

statement ok
USE s1

statement error
INSERT INTO t VALUES (5)
----
<REGEX>:.*Constraint Error.*

query I
SELECT count(*) FROM t
----
100
