# name: test/sql/storage/wal/checkpoint_on_shutdown_index_replays.test
# description: Test that a checkpoint without a client context keeps the WAL of an unbound index
# group: [wal]

require skip_reload

load {TEST_DIR}/checkpoint_on_shutdown_index_replays.db

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET checkpoint_threshold='1TB'

statement ok
CREATE TABLE t(k INTEGER)

statement ok
CREATE UNIQUE INDEX idx ON t(k)

statement ok
CHECKPOINT

# These rows are only in the WAL, so the replay buffers them in the unbound index.
statement ok
INSERT INTO t SELECT i FROM range(100) r(i)

restart

# This session keeps checkpoint_on_shutdown enabled, and its checkpoint has no context to bind the index with.
restart

query I
SELECT wal_size != '0 bytes' FROM pragma_database_size()
----
true

# The buffered index operations are still there: the unique index sees the rows of the WAL.
statement error
INSERT INTO t VALUES (5)
----
<REGEX>:.*Constraint Error.*

query I
SELECT count(*) FROM t
----
100
