# name: test/sql/storage/wal/wal_replay_unbound_index_automatic_checkpoint.test
# description: Test that an automatic checkpoint after WAL replay keeps the index entries of replayed rows
# group: [wal]

require skip_reload

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
SET checkpoint_threshold='999999GB';

statement ok
ATTACH '{TEST_DIR}/wal_replay_auto_checkpoint.db' AS db;

statement ok
CREATE TABLE db.t(id INTEGER, k VARCHAR);

statement ok
CREATE INDEX idx_k ON db.t(k);

statement ok
INSERT INTO db.t SELECT i, 'k' || i FROM range(500) r(i);

statement ok
CHECKPOINT db;

# committed to the WAL only: no checkpoint may run after this insert
statement ok
INSERT INTO db.t SELECT i + 500, 'k' || (i + 500) FROM range(500) r(i);

statement ok
DETACH db;

# reopening replays the WAL, the index is unbound and the replayed rows sit in its replay buffer
statement ok
ATTACH '{TEST_DIR}/wal_replay_auto_checkpoint.db' AS db;

statement ok
SET wal_autocheckpoint='1KB';

# this commit crosses the autocheckpoint threshold and triggers an automatic checkpoint
statement ok
CREATE TABLE db.other AS SELECT * FROM range(1000) r(x);

statement ok
DETACH db;

statement ok
ATTACH '{TEST_DIR}/wal_replay_auto_checkpoint.db' AS db;

statement ok
SET index_scan_max_count = 999999999;

statement ok
SET index_scan_percentage = 1.0;

# a row that was already checkpointed before the crash
query I
SELECT count(*) FROM db.t WHERE k = 'k7';
----
1

# a row that only existed in the WAL and was restored by replay
query I
SELECT count(*) FROM db.t WHERE k = 'k507';
----
1

statement ok
DELETE FROM db.t;

statement ok
DETACH db;
