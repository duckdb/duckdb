# name: test/sql/storage/wal/wal_simple_case_set_default.test
# description: WAL replay preserves a v2.1 simple CASE in an altered column default
# group: [wal]

require skip_reload

statement ok
ATTACH '{TEST_DIR}/alter_default.db' AS db (STORAGE_VERSION 'v2.1.0')

statement ok
CREATE TABLE db.t (i INTEGER)

statement ok
CREATE SEQUENCE db.s

statement ok
CHECKPOINT db

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET wal_autocheckpoint = '1TB'

statement ok
ALTER TABLE db.t ALTER i SET DEFAULT
    CASE nextval('db.s') WHEN -1 THEN 0 WHEN -2 THEN 1 ELSE 42 END

statement ok
INSERT INTO db.t DEFAULT VALUES

query I
SELECT currval('db.s')
----
1

statement ok
DETACH db

query I
SELECT count(*) FROM glob('{TEST_DIR}/alter_default.db.wal')
----
1

statement ok
ATTACH '{TEST_DIR}/alter_default.db' AS db

query I
SELECT currval('db.s')
----
1

statement ok
INSERT INTO db.t DEFAULT VALUES

query II
SELECT count(*), currval('db.s') FROM db.t WHERE i = 42
----
2	2
