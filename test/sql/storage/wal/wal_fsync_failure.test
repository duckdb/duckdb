# name: test/sql/storage/wal/wal_fsync_failure.test
# description: A failed WAL fsync poisons durability: later commits fail instead of being acknowledged without durability
# group: [wal]

load __TEST_DIR__/wal_fsync_failure.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE t(i INTEGER)

statement ok
INSERT INTO t VALUES (1)

statement ok
SET debug_force_wal_fsync_failure=true

statement error
INSERT INTO t VALUES (2)
----
injected WAL fsync failure

# the database is invalidated: a published commit cannot be rolled back
statement error
SELECT count(*) FROM t
----
Failed to sync the WAL after committing

# the commit that reported failure is in doubt: its WAL bytes reached the OS before the sync
# failed, so a reopen on the same machine replays them. Either way the database reopens cleanly
restart

query I
SELECT count(*) FROM t
----
2
