# name: test/sql/storage/wal/group_commit_ddl.test_slow
# description: Group commit: concurrent DDL shares fsyncs with data commits and replays correctly
# group: [wal]

# force WAL-only so reopening must replay both the catalog and the data changes
statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

# widen the publish-to-durable window so catalog commits overlap each other and the data commits
statement ok
SET debug_wal_fsync_sleep_ms=2

statement ok
ATTACH '{TEST_DIR}/group_commit_ddl.db' AS gc

statement ok
CREATE TABLE gc.base(i INTEGER)

statement ok
INSERT INTO gc.base SELECT range FROM range(100)

statement ok
CREATE TABLE gc.owner(i INTEGER)

statement ok
CREATE VIEW gc.owner_view AS SELECT * FROM gc.owner

# threads 0-2 churn catalog entries, 3-5 append data, 6 drops and recreates a dependency pair -
# a bounded snapshot can now start exactly at a pending catalog commit, which is the boundary
# CatalogSet::HasConflict and DependencyManager::VerifyCommitDrop newly have to handle
concurrentloop threadid 0 7

loop x 0 15

onlyif threadid<3
statement maybe
CREATE OR REPLACE VIEW gc.v_{threadid}_{x} AS SELECT count(*) AS c FROM gc.base;
----

onlyif threadid<3
statement maybe
DROP VIEW IF EXISTS gc.v_{threadid}_{x};
----

onlyif threadid>=3
statement maybe
INSERT INTO gc.base VALUES ({threadid} * 1000 + {x});
----

onlyif threadid=6
statement maybe
DROP VIEW IF EXISTS gc.owner_view;
----

onlyif threadid=6
statement maybe
CREATE OR REPLACE VIEW gc.owner_view AS SELECT * FROM gc.owner;
----

endloop

endloop

query I
SELECT count(*) >= 100 AND count(*) = count(DISTINCT i) FROM gc.base
----
true

# reopen: the catalog and the appended rows must come back purely from WAL replay
statement ok
DETACH gc

statement ok
ATTACH '{TEST_DIR}/group_commit_ddl.db' AS gc

query I
SELECT count(*) >= 100 AND count(*) = count(DISTINCT i) FROM gc.base
----
true

statement ok
CHECKPOINT gc

query I
SELECT count(*) >= 100 AND count(*) = count(DISTINCT i) FROM gc.base
----
true

statement ok
DETACH gc
