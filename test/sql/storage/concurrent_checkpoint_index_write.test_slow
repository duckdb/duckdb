# name: test/sql/storage/concurrent_checkpoint_index_write.test_slow
# description: A checkpoint does not hold a table's index list lock between the writes of the table's indexes
# group: [storage]

load {TEST_DIR}/concurrent_checkpoint_index_write.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE t (i INTEGER PRIMARY KEY, s VARCHAR);

statement ok
CREATE INDEX t_s ON t(s);

statement ok
INSERT INTO t SELECT i, 's' || i FROM range(100000) t(i);

statement ok
CHECKPOINT

# the next checkpoint copies the buffers that this changes and shares the others
statement ok
DELETE FROM t WHERE i >= 50000 AND i % 10 != 0

statement ok
CREATE TABLE other (i INTEGER);

# the timing table lives in a database the checkpoint does not write
statement ok
ATTACH ':memory:' AS mem

statement ok
CREATE TABLE mem.timing (who VARCHAR, t TIMESTAMP);

# the checkpoint sleeps for three seconds after it wrote each of the two indexes of t
statement ok
SET debug_checkpoint_index_sleep_ms=3000

concurrentloop threadid 0 4

# thread 2 reads the state from before the commit of thread 0, so that the checkpoint is a concurrent one
onlyif threadid=2
statement ok
BEGIN TRANSACTION

onlyif threadid=2
query I
SELECT COUNT(*) FROM t
----
55000

sleep 1000 millisecond

onlyif threadid=0
statement ok
INSERT INTO other VALUES (1)

onlyif threadid=0
statement ok
INSERT INTO mem.timing VALUES ('checkpoint start', now())

onlyif threadid=0
statement ok
CHECKPOINT

onlyif threadid=0
statement ok
INSERT INTO mem.timing VALUES ('checkpoint end', now())

sleep 2000 millisecond

# during the first sleep: the primary key index is copied, t_s is not yet
# the changes go to the checkpoint deltas of both, and the constraint still holds
onlyif threadid=1
statement ok
INSERT INTO t VALUES (100000, 'during'), (100001, 'during')

onlyif threadid=1
statement error
INSERT INTO t VALUES (10, 'duplicate')
----
Duplicate key

onlyif threadid=1
statement ok
DELETE FROM t WHERE i = 20

onlyif threadid=1
statement ok
INSERT INTO mem.timing VALUES ('changes', now())

# creating an index waits for the checkpoint
onlyif threadid=3
statement ok
CREATE INDEX other_i ON other(i)

onlyif threadid=3
statement ok
INSERT INTO mem.timing VALUES ('create index', now())

onlyif threadid=2
statement ok
ROLLBACK

endloop

# the checkpoint slept after each index
query I
SELECT COUNT(*) FROM mem.timing s, mem.timing e WHERE s.who = 'checkpoint start' AND e.who = 'checkpoint end' AND e.t > s.t + INTERVAL 5 SECOND
----
1

# the changes did not wait for the checkpoint to write the remaining index
query I
SELECT COUNT(*) FROM mem.timing w, mem.timing e WHERE w.who = 'changes' AND e.who = 'checkpoint end' AND w.t < e.t - INTERVAL 2 SECOND
----
1

query I
SELECT COUNT(*) FROM mem.timing w, mem.timing e WHERE w.who = 'create index' AND e.who = 'checkpoint end' AND w.t > e.t - INTERVAL 1 SECOND
----
1

statement ok
SET debug_checkpoint_index_sleep_ms=0

query II
SELECT COUNT(*), SUM(i) FROM t
----
55001	1625149981

statement error
INSERT INTO t VALUES (100000, 'again')
----
Duplicate key

statement ok
INSERT INTO t VALUES (20, 'again')

query II
SELECT COUNT(*), SUM(i) FROM t
----
55002	1625150001

query II
SELECT i, s FROM t WHERE s = 'during' ORDER BY i
----
100000	during
100001	during

query I
SELECT s FROM t WHERE i = 20
----
again

# WAL replay of the changes and of the new index on top of the checkpoint
restart

query II
SELECT COUNT(*), SUM(i) FROM t
----
55002	1625150001

statement error
INSERT INTO t VALUES (100001, 'again')
----
Duplicate key

query II
SELECT i, s FROM t WHERE s = 'during' ORDER BY i
----
100000	during
100001	during

query I
SELECT index_name FROM duckdb_indexes() ORDER BY ALL
----
other_i
t_s

statement ok
CHECKPOINT

restart

query II
SELECT COUNT(*), SUM(i) FROM t
----
55002	1625150001

statement error
INSERT INTO t VALUES (20, 'third')
----
Duplicate key

query II
SELECT i, s FROM t WHERE s = 'during' ORDER BY i
----
100000	during
100001	during

query I
SELECT index_name FROM duckdb_indexes() ORDER BY ALL
----
other_i
t_s
