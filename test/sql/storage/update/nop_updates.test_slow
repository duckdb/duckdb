# name: test/sql/storage/update/nop_updates.test_slow
# description: Test nop updates
# group: [update]

# load the DB from disk
load {TEST_DIR}/nop_updates.db

statement ok
create table integers as select * from generate_series(0, 10000000, 1) tbl(i);

query I
select sum(i) from integers
----
50000005000000

query I
SELECT CASE WHEN block_size >= 262144 THEN total_blocks * block_size < 3000000 ELSE total_blocks * block_size < 90000000 END FROM pragma_database_size();
----
true

loop i 0 2

statement ok
UPDATE integers SET i=i

endloop

query I
SELECT CASE WHEN block_size >= 262144 THEN total_blocks * block_size < 3000000 ELSE total_blocks * block_size < 90000000 END FROM pragma_database_size();
----
true

statement ok
CHECKPOINT

# ALMOST nop update
statement ok
UPDATE integers SET i=CASE WHEN i=9999997 THEN 42 ELSE i END

query I
select sum(i) from integers
----
49999995000045
