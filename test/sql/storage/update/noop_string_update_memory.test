# name: test/sql/storage/update/noop_string_update_memory.test
# description: No-op string updates must not leave string copies in memory across checkpoints
# group: [update]

load {TEST_DIR}/noop_string_update_memory.db

statement ok
CREATE TABLE t AS SELECT repeat('x', 65536) AS payload, 0 AS marker;

statement ok
CHECKPOINT;

loop i 0 5

statement ok
UPDATE t SET payload = payload;

# a real change in another column makes the checkpoint process this row group
statement ok
UPDATE t SET marker = marker + 1;

statement ok
CHECKPOINT;

endloop

query I
SELECT COALESCE(SUM(memory_usage_bytes), 0) < 32768 FROM duckdb_memory() WHERE tag = 'ALLOCATOR';
----
true

query II
SELECT length(payload), marker FROM t;
----
65536	5
