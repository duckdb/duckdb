# name: test/sql/storage/prefetch/async_native_scan_positional.test
# description: Positional scans cannot receive resume callbacks, async scan I/O must fall back to synchronous execution
# group: [prefetch]

load {TEST_DIR}/async_native_scan_positional.db

statement ok
CREATE TABLE t1 AS SELECT range AS i FROM range(100000);

statement ok
CREATE TABLE t2 AS SELECT range * 2 AS j FROM range(100000);

statement ok
CHECKPOINT

restart

statement ok
SET debug_physical_table_scan_execution_strategy=DEFAULT

statement ok
SET storage_block_prefetch='debug_force_always'

query I
SELECT sum(i + j) FROM (SELECT * FROM t1 POSITIONAL JOIN t2)
----
14999850000
