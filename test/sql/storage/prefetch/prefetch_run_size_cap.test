# name: test/sql/storage/prefetch/prefetch_run_size_cap.test
# description: A large contiguous assignment splits into size-capped prefetch runs instead of one giant read
# group: [prefetch]

require vector_size 2048

statement ok
ATTACH '{TEST_DIR}/prefetch_run_cap.db' AS cap_db (ROW_GROUP_SIZE 8388608)

# a single 8M row double column makes one row group hold ~64MB of contiguous blocks
statement ok
CREATE TABLE cap_db.t AS SELECT random() AS d FROM range(8388608)

statement ok
CHECKPOINT cap_db

# re-attach so the payload blocks begin cold
statement ok
DETACH cap_db

statement ok
ATTACH '{TEST_DIR}/prefetch_run_cap.db' AS cap_db (READ_ONLY)

# a single thread keeps the whole row group in one assignment, more threads would split it below the cap
statement ok
SET threads=1

statement ok
SET async_threads=4

# the per-thread path schedules its I/O through AsyncResult, which logs one event per assignment
statement ok
SET read_ahead_depth=0

statement ok
SET storage_block_prefetch='debug_force_always'

statement ok
CALL enable_logging('AsyncTaskSchedule')

query I
SELECT sum(d) > 0 FROM cap_db.t
----
true

# the ~64MB assignment must split into multiple capped runs, one task each
query I
SELECT max(task_count) BETWEEN 2 AND 4 FROM duckdb_logs_parsed('AsyncTaskSchedule')
----
true

statement ok
CALL truncate_duckdb_logs()

# a memory limit below the run cap shrinks the runs, so the staging buffers of the I/O threads fit in memory
statement ok
SET memory_limit='48MB'

query I
SELECT sum(d) > 0 FROM cap_db.t
----
true

query I
SELECT max(task_count) > 4 FROM duckdb_logs_parsed('AsyncTaskSchedule')
----
true

statement ok
SET read_ahead_depth=-1

query I
SELECT sum(d) > 0 FROM cap_db.t
----
true

statement ok
CALL truncate_duckdb_logs()
