# name: test/sql/storage/prefetch/async_native_scan_read_ahead_sample.test
# description: Seeded system sampling returns the same sample with and without read-ahead
# group: [prefetch]

load {TEST_DIR}/async_native_scan_read_ahead_sample.db

statement ok
CREATE TABLE integers AS SELECT range AS i FROM range(1000000);

statement ok
CHECKPOINT

# restart so the payload blocks begin cold
restart

statement ok
SET threads=1

statement ok
SET async_threads=4

statement ok
SET storage_block_prefetch='debug_force_always'

# ground truth from the per-thread scan path
statement ok
SET read_ahead_depth=0

statement ok
CREATE TEMPORARY TABLE expected AS SELECT count(*) AS c, sum(i) AS s FROM integers USING SAMPLE 1 PERCENT (system, 42)

statement ok
SET read_ahead_depth=-1

# single threaded, the read-ahead scan draws the same sample from the seed
query I
SELECT count(*) = (SELECT c FROM expected) AND sum(i) = (SELECT s FROM expected) FROM integers USING SAMPLE 1 PERCENT (system, 42)
----
true

# rerunning returns the same sample again
query I
SELECT count(*) = (SELECT c FROM expected) AND sum(i) = (SELECT s FROM expected) FROM integers USING SAMPLE 1 PERCENT (system, 42)
----
true
