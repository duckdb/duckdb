# name: test/sql/upsert/upsert_column_list_checks.test
# description: INSERT with ON CONFLICT, OR IGNORE or OR REPLACE checks its column list like a plain INSERT (#26175)
# group: [upsert]

statement ok
CREATE TABLE w (i INT UNIQUE, j INT, g AS (j * 2));

statement error
INSERT INTO w (zz) SELECT 1 ON CONFLICT DO NOTHING;
----
does not have a column with name "zz"

statement error
INSERT INTO w (r) SELECT 1 ON CONFLICT (i) DO UPDATE SET j = 0;
----
does not have a column with name "r"

statement error
INSERT OR IGNORE INTO w (i) SELECT 5, 6;
----
expected 1 columns but 2 values were supplied

statement error
INSERT INTO w (i, j) SELECT 1 ON CONFLICT DO NOTHING;
----
expected 2 columns but 1 values were supplied

statement error
INSERT INTO w (g) VALUES (4) ON CONFLICT DO NOTHING;
----
Cannot insert into a generated column

statement error
INSERT INTO w (g) SELECT 4 ON CONFLICT DO NOTHING;
----
Cannot insert into a generated column

statement error
INSERT INTO w (i, i) SELECT 1, 2 ON CONFLICT DO NOTHING;
----
Duplicate column name "i" in INSERT

# OR REPLACE built its SET list from the column list and raised an internal error
statement error
INSERT OR REPLACE INTO w (zz) SELECT 1;
----
does not have a column with name "zz"

# nothing of the above was inserted
query III
SELECT * FROM w;
----

# valid statements keep working, with the column list, without it, and prepared
statement ok
INSERT INTO w (j, i) SELECT 2, 1 ON CONFLICT DO NOTHING;

statement ok
INSERT OR REPLACE INTO w (i, j) SELECT 1, 3;

statement ok
INSERT INTO w SELECT 2, 4 ON CONFLICT DO NOTHING;

statement ok
PREPARE upsert AS INSERT INTO w (i, j) SELECT ?, ? ON CONFLICT DO UPDATE SET j = excluded.j;

statement ok
EXECUTE upsert(2, 5);

statement ok
INSERT INTO w (i, j) WITH src AS (SELECT 3 AS a, 6 AS b) SELECT a, b FROM src ON CONFLICT DO NOTHING;

query III
SELECT * FROM w ORDER BY i;
----
1	3	6
2	5	10
3	6	12
