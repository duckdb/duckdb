# name: test/sql/json/copy_geojson.test
# description: Test COPY ... TO/FROM ... (FORMAT GEOJSON)
# group: [json]

require json

statement ok
CREATE TABLE places (id INTEGER, name VARCHAR, geom GEOMETRY);

statement ok
INSERT INTO places VALUES (1, 'alpha', 'POINT(1 2)'), (2, 'beta', 'LINESTRING(0 0, 1 1)'), (3, NULL, NULL);

# By default the output is a single FeatureCollection
statement ok
COPY places TO '{TEST_DIR}/places.geojson' (FORMAT GEOJSON);

query I
SELECT replace(replace(trim(content, chr(10)), chr(10), ' '), chr(9), '') FROM read_text('{TEST_DIR}/places.geojson');
----
{"type":"FeatureCollection","features":[ {"type":"Feature","geometry":{"type":"Point","coordinates":[1.0,2.0]},"properties":{"id":1,"name":"alpha"}}, {"type":"Feature","geometry":{"type":"LineString","coordinates":[[0.0,0.0],[1.0,1.0]]},"properties":{"id":2,"name":"beta"}}, {"type":"Feature","geometry":null,"properties":{"id":3,"name":null}} ]}

# ARRAY false writes one Feature per line instead
statement ok
COPY places TO '{TEST_DIR}/places.geojsonl' (FORMAT GEOJSON, ARRAY false);

query I
SELECT replace(replace(trim(content, chr(10)), chr(10), ' '), chr(9), '') FROM read_text('{TEST_DIR}/places.geojsonl');
----
{"type":"Feature","geometry":{"type":"Point","coordinates":[1.0,2.0]},"properties":{"id":1,"name":"alpha"}} {"type":"Feature","geometry":{"type":"LineString","coordinates":[[0.0,0.0],[1.0,1.0]]},"properties":{"id":2,"name":"beta"}} {"type":"Feature","geometry":null,"properties":{"id":3,"name":null}}

# The format is inferred from the file extension
statement ok
COPY places TO '{TEST_DIR}/inferred.geojson';

query I
SELECT count(*) FROM read_json('{TEST_DIR}/inferred.geojson');
----
3

# Round-trip through read_json
query III
SELECT id, name, ST_AsText(geometry) FROM read_json('{TEST_DIR}/places.geojson') ORDER BY id;
----
1	alpha	POINT (1 2)
2	beta	LINESTRING (0 0, 1 1)
3	NULL	NULL

query III
SELECT id, name, ST_AsText(geometry) FROM read_json('{TEST_DIR}/places.geojsonl') ORDER BY id;
----
1	alpha	POINT (1 2)
2	beta	LINESTRING (0 0, 1 1)
3	NULL	NULL

# Round-trip through COPY ... FROM
statement ok
CREATE TABLE places2 (geometry GEOMETRY, id INTEGER, name VARCHAR);

statement ok
COPY places2 FROM '{TEST_DIR}/places.geojson' (FORMAT GEOJSON);

query III
SELECT id, name, ST_AsText(geometry) FROM places2 ORDER BY id;
----
1	alpha	POINT (1 2)
2	beta	LINESTRING (0 0, 1 1)
3	NULL	NULL

statement ok
CREATE TABLE places3 (geometry GEOMETRY, id INTEGER, name VARCHAR);

statement ok
COPY places3 FROM '{TEST_DIR}/places.geojsonl' (FORMAT GEOJSON);

query III
SELECT id, name, ST_AsText(geometry) FROM places3 ORDER BY id;
----
1	alpha	POINT (1 2)
2	beta	LINESTRING (0 0, 1 1)
3	NULL	NULL

# A table with only a geometry column has empty properties
statement ok
COPY (SELECT 'POINT(7 8)'::GEOMETRY AS g) TO '{TEST_DIR}/only_geom.geojsonl' (FORMAT GEOJSON, ARRAY false);

query I
SELECT replace(replace(trim(content, chr(10)), chr(10), ' '), chr(9), '') FROM read_text('{TEST_DIR}/only_geom.geojsonl');
----
{"type":"Feature","geometry":{"type":"Point","coordinates":[7.0,8.0]},"properties":{}}

# Property values honor DATEFORMAT / TIMESTAMPFORMAT
statement ok
COPY (SELECT DATE '2024-03-05' AS d, TIMESTAMP '2024-03-05 06:07:08' AS ts, 'POINT(1 2)'::GEOMETRY AS g)
TO '{TEST_DIR}/formats.geojsonl' (FORMAT GEOJSON, ARRAY false, DATEFORMAT '%d-%m-%Y', TIMESTAMPFORMAT '%H:%M:%S');

query I
SELECT replace(replace(trim(content, chr(10)), chr(10), ' '), chr(9), '') FROM read_text('{TEST_DIR}/formats.geojsonl');
----
{"type":"Feature","geometry":{"type":"Point","coordinates":[1.0,2.0]},"properties":{"d":"05-03-2024","ts":"06:07:08"}}

# PARTITION_BY keeps working
statement ok
COPY (SELECT 1 AS part, 'POINT(1 2)'::GEOMETRY AS g UNION ALL SELECT 2, 'POINT(3 4)'::GEOMETRY)
TO '{TEST_DIR}/geojson_parts' (FORMAT GEOJSON, PARTITION_BY ('part'));

query II
SELECT filename, replace(replace(trim(content, chr(10)), chr(10), ' '), chr(9), '')
FROM read_text('{TEST_DIR}/geojson_parts/*/*.geojson') ORDER BY filename;
----
{TEST_DIR}/geojson_parts/part=1/data_0.geojson	{"type":"FeatureCollection","features":[ {"type":"Feature","geometry":{"type":"Point","coordinates":[1.0,2.0]},"properties":{}} ]}
{TEST_DIR}/geojson_parts/part=2/data_0.geojson	{"type":"FeatureCollection","features":[ {"type":"Feature","geometry":{"type":"Point","coordinates":[3.0,4.0]},"properties":{}} ]}

# Nested geometries inside properties are written as GeoJSON too
statement ok
COPY (SELECT 'POINT(1 2)'::GEOMETRY AS g, {pt: 'POINT(3 4)'::GEOMETRY} AS s)
TO '{TEST_DIR}/nested_geom.geojsonl' (FORMAT GEOJSON, ARRAY false);

query I
SELECT replace(replace(trim(content, chr(10)), chr(10), ' '), chr(9), '') FROM read_text('{TEST_DIR}/nested_geom.geojsonl');
----
{"type":"Feature","geometry":{"type":"Point","coordinates":[1.0,2.0]},"properties":{"s":{"pt":{"type":"Point","coordinates":[3.0,4.0]}}}}

statement error
COPY (SELECT 1 AS id, 'x' AS name) TO '{TEST_DIR}/no_geom.geojson' (FORMAT GEOJSON);
----
<REGEX>:.*requires a GEOMETRY column.*

statement error
COPY places TO '{TEST_DIR}/bad_option.geojson' (FORMAT GEOJSON, NONSENSE 1);
----
<REGEX>:.*Unknown option for COPY \.\.\. TO \.\.\. \(FORMAT GEOJSON\).*

# The internal writer is not meant to be called directly
statement error
SELECT __internal_json_copy_to_geojson(1, NULL, NULL);
----
<REGEX>:.*internal use only.*
