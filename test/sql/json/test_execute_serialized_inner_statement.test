# name: test/sql/json/test_execute_serialized_inner_statement.test
# description: json_execute_serialized_sql plans its statement when the outer query is bound, and plans and runs it again at each scan start
# group: [json]

require json

statement ok
CREATE TABLE t(i INTEGER, s VARCHAR);

statement ok
INSERT INTO t VALUES (1, 'abc'), (2, 'def');

# a parameter the statement binds is refused when the outer query is bound
statement error
SELECT * FROM json_execute_serialized_sql(json_serialize_sql('SELECT $1 + 1'));
----
Binder Error: json_execute_serialized_sql cannot execute a statement with parameters

statement error
SELECT 1 FROM json_execute_serialized_sql(json_serialize_sql('SELECT $1 + 1'));
----
Binder Error: json_execute_serialized_sql cannot execute a statement with parameters

statement error
SELECT * FROM json_execute_serialized_sql(json_serialize_sql('SELECT * FROM t WHERE i = $1'));
----
Binder Error: json_execute_serialized_sql cannot execute a statement with parameters

statement error
EXPLAIN SELECT * FROM json_execute_serialized_sql(json_serialize_sql('SELECT $1::INTEGER AS p'));
----
Binder Error: json_execute_serialized_sql cannot execute a statement with parameters

statement error
EXPLAIN SELECT * FROM json_execute_serialized_sql(json_serialize_sql('SELECT ? AS p'));
----
Binder Error: json_execute_serialized_sql cannot execute a statement with parameters

# also when the serialized statement does not list it among its parameters
statement error
SELECT 1 FROM json_execute_serialized_sql(replace(json_serialize_sql('SELECT $1 + 1'), ',"named_param_map":[{"key":"1","value":1}]', ''));
----
Binder Error: json_execute_serialized_sql cannot execute a statement with parameters

statement error
EXPLAIN SELECT * FROM json_execute_serialized_sql(replace(json_serialize_sql('SELECT $1::INTEGER AS p'), ',"named_param_map":[{"key":"1","value":1}]', ''));
----
Binder Error: json_execute_serialized_sql cannot execute a statement with parameters

# a parameter in a part of the statement that is never bound is ignored
query I
SELECT * FROM json_execute_serialized_sql(json_serialize_sql('WITH unused AS (SELECT $1) SELECT 42'));
----
42

# planning this statement fails
statement error
EXPLAIN SELECT * FROM (VALUES ('abc'::INTEGER));
----
Conversion Error: Could not convert string 'abc' to INT32

# the function plans it when the outer query is bound, so explaining the outer query fails too
statement error
EXPLAIN SELECT * FROM json_execute_serialized_sql(json_serialize_sql('SELECT * FROM (VALUES (''abc''::INTEGER))'));
----
Conversion Error: Could not convert string 'abc' to INT32

statement error
SELECT * FROM json_execute_serialized_sql(json_serialize_sql('SELECT * FROM (VALUES (''abc''::INTEGER))'));
----
Conversion Error: Could not convert string 'abc' to INT32

# an error raised while the statement runs points into the statement's own text; only the text is pinned, not the caret
statement error
SELECT * FROM json_execute_serialized_sql(json_serialize_sql('SELECT 1, s::INTEGER FROM t'));
----
<REGEX>:.*LINE 1: SELECT 1, CAST\(s AS INTEGER\) FROM t.*

# the statement runs on a connection of its own, which does not see the outer transaction
statement ok
BEGIN;

statement ok
CREATE TABLE u(i INTEGER);

statement error
SELECT * FROM json_execute_serialized_sql(json_serialize_sql('SELECT * FROM u'));
----
Table with name u does not exist

statement ok
ROLLBACK;

# the function can run a statement that calls the function
query I
SELECT * FROM json_execute_serialized_sql(json_serialize_sql('SELECT * FROM json_execute_serialized_sql(json_serialize_sql(''SELECT 42 AS a''))'));
----
42
