# name: test/sql/json/table/read_json_timestamp_specials.test
# description: JSON timestamp auto-detection with infinite values
# group: [table]

require json

# Infinite timestamps are valid for TIMESTAMP and TIMESTAMPTZ and provide no offset evidence.
statement ok
copy (select * from (values
	('{"plain_ts":"2024-01-01T00:00:00","offset_ts":"2024-01-01T00:00:00Z"}'),
	('{"plain_ts":"infinity","offset_ts":"infinity"}'),
	('{"plain_ts":"-infinity","offset_ts":"-infinity"}')
)) to '{TEMP_DIR}/timestamp_specials.json' (format csv, quote '', header 0)

query II
select typeof(plain_ts), typeof(offset_ts)
from read_json_auto('{TEMP_DIR}/timestamp_specials.json')
limit 1
----
TIMESTAMP	TIMESTAMP WITH TIME ZONE
