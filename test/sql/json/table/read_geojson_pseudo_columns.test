# name: test/sql/json/table/read_geojson_pseudo_columns.test
# description: Read the Feature-level "id" and "bbox" pseudo-columns alongside conflicting properties
# group: [table]

require json

# The Feature's own members come first and its metadata members are prefixed, so a property named "id" keeps its
# own name and its own value
query II
SELECT column_name, column_type
FROM (DESCRIBE SELECT * FROM read_json('data/json/geojson/pseudo_columns.geojsonl'));
----
geometry	GEOMETRY
feature_id	VARCHAR
feature_bbox	DOUBLE[]
id	VARCHAR
name	VARCHAR

query IIIII
SELECT ST_AsText(geometry), feature_id, feature_bbox, id, name
FROM read_json('data/json/geojson/pseudo_columns.geojsonl') ORDER BY feature_id;
----
POINT (1 2)	FEATURE-1	[0.0, 0.0, 1.0, 1.0]	PROP-1	a
POINT (3 4)	FEATURE-2	[2.0, 2.0, 3.0, 3.0]	PROP-2	b

# The two are resolved by position, not by name, so neither shadows the other
query II
SELECT feature_id, id FROM read_json('data/json/geojson/pseudo_columns.geojsonl') ORDER BY feature_id;
----
FEATURE-1	PROP-1
FEATURE-2	PROP-2

# Projection pushdown of just the property, and just the pseudo-column
query I
SELECT id FROM read_json('data/json/geojson/pseudo_columns.geojsonl') ORDER BY id;
----
PROP-1
PROP-2

query I
SELECT feature_id FROM read_json('data/json/geojson/pseudo_columns.geojsonl') ORDER BY feature_id;
----
FEATURE-1
FEATURE-2

query I
SELECT feature_bbox[1] FROM read_json('data/json/geojson/pseudo_columns.geojsonl') ORDER BY 1;
----
0.0
2.0

# Properties that collide with a prefixed name are deduplicated with a suffix, and because the suffixed name can
# itself collide, the deduplication is applied repeatedly until the name is unique
query II
SELECT column_name, column_type
FROM (DESCRIBE SELECT * FROM read_json('data/json/geojson/pseudo_columns_nasty.geojsonl'));
----
geometry	GEOMETRY
feature_id	VARCHAR
feature_bbox	DOUBLE[]
feature_id_1	VARCHAR
feature_id_1_1	VARCHAR
id	VARCHAR
geometry_1	VARCHAR

# Every column still reads from the right place despite the renaming
query IIIIII
SELECT ST_AsText(geometry), feature_id, feature_id_1, feature_id_1_1, id, geometry_1
FROM read_json('data/json/geojson/pseudo_columns_nasty.geojsonl');
----
POINT (1 2)	FEATURE	P-collides	P-collides-again	P-plain	P-geom

# A FeatureCollection without any id/bbox members gets no pseudo-columns
query II
SELECT column_name, column_type
FROM (DESCRIBE SELECT * FROM read_json('data/json/geojson/features.geojson'));
----
geometry	GEOMETRY
name	VARCHAR
pop	BIGINT
area	DOUBLE

# COPY ... FROM resolves the pseudo-columns by the same names
statement ok
CREATE TABLE features (geometry GEOMETRY, feature_id VARCHAR, id VARCHAR, name VARCHAR);

statement ok
COPY features FROM 'data/json/geojson/pseudo_columns.geojsonl' (FORMAT GEOJSON);

query IIII
SELECT ST_AsText(geometry), feature_id, id, name FROM features ORDER BY feature_id;
----
POINT (1 2)	FEATURE-1	PROP-1	a
POINT (3 4)	FEATURE-2	PROP-2	b
