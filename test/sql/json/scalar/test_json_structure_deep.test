# name: test/sql/json/scalar/test_json_structure_deep.test
# description: json_structure on a very deeply nested document errors instead of overflowing the stack
# group: [scalar]

require json

statement ok
PRAGMA enable_verification

statement error
SELECT json_structure(repeat('[', 30000) || '1' || repeat(']', 30000));
----
<REGEX>:Invalid Input Error.*nested more than.*

statement error
SELECT json_structure(repeat('{"a":', 30000) || '1' || repeat('}', 30000));
----
<REGEX>:Invalid Input Error.*nested more than.*

# nesting within the limit keeps working
query I
SELECT json_structure(repeat('[', 500) || '1' || repeat(']', 500)) = (repeat('[', 500) || '"UBIGINT"' || repeat(']', 500))::JSON;
----
true
