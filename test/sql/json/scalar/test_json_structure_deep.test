# name: test/sql/json/scalar/test_json_structure_deep.test
# description: json_structure on a deeply nested JSON column is fallible
# group: [scalar]

require json

statement ok
CREATE TABLE j AS SELECT ('{' || repeat('"k":{', 200) || '"v":1' || repeat('}', 200) || '}')::JSON AS c;

statement error
SELECT json_structure(c) FROM j;
----
Invalid Input Error: JSON exceeds maximum recursion depth of 128

query I
SELECT TRY(json_structure(c)) FROM j;
----
NULL
