# name: test/sql/json/test_execute_serialized_reexecute.test
# description: json_execute_serialized_sql re-executes its statement on every scan initialization
# group: [json]

require json

# Skipped with the optimizer disabled: the CTE is then not inlined, the function executes once into the
# materialized CTE, and every iteration sees the same value.

statement ok
CREATE SEQUENCE s START 1;

# Each recursive iteration re-initializes the scan and re-executes the statement, so the sequence advances
# per iteration. A cached or rewound result would repeat the first value, and an exhausted one yields NULL.
query II
WITH RECURSIVE
c AS NOT MATERIALIZED (
    SELECT * FROM json_execute_serialized_sql(
        json_serialize_sql('SELECT nextval(''s'') AS v'))
),
w(d, v) AS (
    SELECT 0, 0::BIGINT
    UNION ALL
    SELECT d + 1, (SELECT v FROM c)
    FROM w
    WHERE d < 3
)
SELECT d, v FROM w ORDER BY d;
----
0	0
1	1
2	2
3	3
