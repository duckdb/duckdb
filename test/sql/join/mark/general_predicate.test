# name: test/sql/join/mark/general_predicate.test
# description: General MARK predicates retain per-pair three-valued truth
# group: [mark]

foreach disable false true

statement ok
SET debug_disable_optimizer={disable};

query I
SELECT __mark_join_marker FROM (VALUES (NULL::INTEGER)) l(a) JOIN BY (TYPE MARK) (VALUES (NULL::INTEGER)) r(b) ON a IS NOT DISTINCT FROM NULL::INTEGER AND a+b=2;
----
NULL

query I
SELECT __mark_join_marker FROM (VALUES (1)) l(a) JOIN BY (TYPE MARK) (VALUES (1,NULL::INTEGER)) r(b,c) ON a=b AND a+c>0;
----
NULL

query I
SELECT __mark_join_marker FROM (VALUES (NULL::INTEGER)) l(a) JOIN BY (TYPE MARK) (VALUES (1)) r(b) ON a=b AND a+b IS NOT NULL;
----
false

query I
SELECT __mark_join_marker FROM (VALUES (1)) l(a) JOIN BY (TYPE MARK) (VALUES (NULL::INTEGER)) r(b) ON a=b AND a+b IS NOT NULL;
----
false

# A false comparison suppresses another comparison's unknown value.
query I
SELECT __mark_join_marker FROM (VALUES (NULL::INTEGER,0)) l(a,c) JOIN BY (TYPE MARK) (VALUES (1,1)) r(b,d) ON a=b AND c IS NOT DISTINCT FROM d;
----
false

query I
SELECT __mark_join_marker FROM (VALUES (NULL::INTEGER,0)) l(a,c) JOIN BY (TYPE MARK) (VALUES (1,1)) r(b,d) ON a=b AND c>d;
----
false

# General MARK truth is independent of the range-join cost thresholds.
statement ok
SET nested_loop_join_threshold=0;

statement ok
SET merge_join_threshold=0;

statement ok
SET prefer_range_joins=true;

query I
SELECT __mark_join_marker FROM (VALUES (NULL::INTEGER,0)) l(a,c) JOIN BY (TYPE MARK) (VALUES (1,1)) r(b,d) ON a<b AND c>d;
----
false

query I
SELECT __mark_join_marker FROM (VALUES (NULL::INTEGER,2)) l(a,c) JOIN BY (TYPE MARK) (VALUES (1,1)) r(b,d) ON a<b AND c>d;
----
NULL

query I
SELECT __mark_join_marker FROM (VALUES (NULL::INTEGER,2)) l(a,c) JOIN BY (TYPE MARK) (VALUES (1,1)) r(b,d) ON a<b AND c>d AND a+b IS NOT NULL;
----
false

statement ok
CREATE OR REPLACE TABLE mark_probe(id INTEGER, label VARCHAR, a INTEGER, c INTEGER);

statement ok
INSERT INTO mark_probe VALUES (0,'null',NULL,NULL),(1,'one',1,NULL),(2,'two',2,2);

statement ok
CREATE OR REPLACE TABLE mark_build(b INTEGER,d INTEGER);

statement ok
INSERT INTO mark_build VALUES (1,NULL);

# Output maps may omit the key and residual columns, and repeat/reorder others.
query TTII rowsort
SELECT label,label,id,__mark_join_marker FROM mark_probe JOIN BY (TYPE MARK) mark_build ON a=b AND c+d>0;
----
null	null	0	NULL
one	one	1	NULL
two	two	2	false

statement ok
DELETE FROM mark_build;

query TTII rowsort
SELECT label,label,id,__mark_join_marker FROM mark_probe JOIN BY (TYPE MARK) mark_build ON a=b AND c+d>0;
----
null	null	0	false
one	one	1	false
two	two	2	false

query II rowsort
SELECT id,__mark_join_marker FROM mark_probe JOIN BY (TYPE MARK) mark_build ON a<2 AND a>2 AND a+b=2;
----
0	false
1	false
2	false

statement ok
RESET nested_loop_join_threshold;

statement ok
RESET merge_join_threshold;

statement ok
RESET prefer_range_joins;

endloop

statement ok
SET debug_disable_optimizer=false;
