# name: test/sql/join/mark/nested_operator_semantics.test
# description: MARK retains native nested-key comparison semantics for each operator
# group: [mark]

foreach external false true

statement ok
SET debug_force_external={external};

query I
SELECT __mark_join_marker FROM (VALUES (row(1,2))) p(c) JOIN BY(TYPE MARK) (VALUES (row(1,NULL::INT))) b(d) ON c = d;
----
false

query I
SELECT __mark_join_marker FROM (VALUES (row(1,2))) p(c) JOIN BY(TYPE MARK) (VALUES (row(1,NULL::INT))) b(d) ON c <> d;
----
NULL

query I
SELECT __mark_join_marker FROM (VALUES (row(1,2))) p(c) JOIN BY(TYPE MARK) (VALUES (row(1,NULL::INT))) b(d) ON c < d;
----
true

query I
SELECT __mark_join_marker FROM (VALUES (row(1,2))) p(c) JOIN BY(TYPE MARK) (VALUES (row(1,NULL::INT))) b(d) ON c <= d;
----
true

query I
SELECT __mark_join_marker FROM (VALUES (row(1,2))) p(c) JOIN BY(TYPE MARK) (VALUES (row(1,NULL::INT))) b(d) ON c > d;
----
false

query I
SELECT __mark_join_marker FROM (VALUES (row(1,2))) p(c) JOIN BY(TYPE MARK) (VALUES (row(1,NULL::INT))) b(d) ON c >= d;
----
false

query I
SELECT __mark_join_marker FROM (VALUES (row(1,2))) p(c) JOIN BY(TYPE MARK) (VALUES (row(1,NULL::INT))) b(d) ON c IS DISTINCT FROM d;
----
true

query I
SELECT __mark_join_marker FROM (VALUES (row(1,2))) p(c) JOIN BY(TYPE MARK) (VALUES (row(1,NULL::INT))) b(d) ON c IS NOT DISTINCT FROM d;
----
false

query I
SELECT __mark_join_marker FROM (VALUES (row(1,NULL::INT))) p(c) JOIN BY(TYPE MARK) (VALUES (row(1,2))) b(d) ON c = d;
----
false

query I
SELECT __mark_join_marker FROM (VALUES (row(1,NULL::INT))) p(c) JOIN BY(TYPE MARK) (VALUES (row(1,2))) b(d) ON c <> d;
----
NULL

query I
SELECT __mark_join_marker FROM (VALUES (row(1,NULL::INT))) p(c) JOIN BY(TYPE MARK) (VALUES (row(1,2))) b(d) ON c < d;
----
false

query I
SELECT __mark_join_marker FROM (VALUES (row(1,NULL::INT))) p(c) JOIN BY(TYPE MARK) (VALUES (row(1,2))) b(d) ON c <= d;
----
false

query I
SELECT __mark_join_marker FROM (VALUES (row(1,NULL::INT))) p(c) JOIN BY(TYPE MARK) (VALUES (row(1,2))) b(d) ON c > d;
----
true

query I
SELECT __mark_join_marker FROM (VALUES (row(1,NULL::INT))) p(c) JOIN BY(TYPE MARK) (VALUES (row(1,2))) b(d) ON c >= d;
----
true

query I
SELECT __mark_join_marker FROM (VALUES (row(1,NULL::INT))) p(c) JOIN BY(TYPE MARK) (VALUES (row(1,2))) b(d) ON c IS DISTINCT FROM d;
----
true

query I
SELECT __mark_join_marker FROM (VALUES (row(1,NULL::INT))) p(c) JOIN BY(TYPE MARK) (VALUES (row(1,2))) b(d) ON c IS NOT DISTINCT FROM d;
----
false

query I
SELECT __mark_join_marker FROM (VALUES (1,row(1,2))) p(a,c) JOIN BY(TYPE MARK) (VALUES (1,row(1,NULL::INT))) b(b,d) ON a=b AND c <> d;
----
true

query I
SELECT __mark_join_marker FROM (VALUES (1,row(1,2))) p(a,c) JOIN BY(TYPE MARK) (VALUES (1,row(1,NULL::INT))) b(b,d) ON a=b AND c < d;
----
true

query I
SELECT __mark_join_marker FROM (VALUES (1,row(1,2))) p(a,c) JOIN BY(TYPE MARK) (VALUES (1,row(1,NULL::INT))) b(b,d) ON a=b AND c = d;
----
false

query I
SELECT __mark_join_marker FROM (VALUES (1,row(1,2))) p(a,c) JOIN BY(TYPE MARK) (VALUES (1,row(1,NULL::INT))) b(b,d) ON a=b AND c IS DISTINCT FROM d;
----
true

query I
SELECT __mark_join_marker FROM (VALUES (2,row(1,2))) p(a,c) JOIN BY(TYPE MARK) (VALUES (1,row(1,NULL::INT))) b(b,d) ON a=b AND c <> d;
----
false

query I
SELECT __mark_join_marker FROM (VALUES (2,row(1,2))) p(a,c) JOIN BY(TYPE MARK) (VALUES (1,row(1,NULL::INT))) b(b,d) ON a=b AND c < d;
----
false

query I
SELECT __mark_join_marker FROM (VALUES (2,row(1,2))) p(a,c) JOIN BY(TYPE MARK) (VALUES (1,row(1,NULL::INT))) b(b,d) ON a=b AND c = d;
----
false

query I
SELECT __mark_join_marker FROM (VALUES (2,row(1,2))) p(a,c) JOIN BY(TYPE MARK) (VALUES (1,row(1,NULL::INT))) b(b,d) ON a=b AND c IS DISTINCT FROM d;
----
false

query I
SELECT __mark_join_marker FROM (VALUES (NULL::INT,row(1,2))) p(a,c) JOIN BY(TYPE MARK) (VALUES (1,row(1,NULL::INT))) b(b,d) ON a=b AND c <> d;
----
NULL

endloop
