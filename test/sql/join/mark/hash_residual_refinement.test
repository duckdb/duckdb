# name: test/sql/join/mark/hash_residual_refinement.test
# description: Hash MARK NULL refinement retains residual payload and evaluates each candidate once
# group: [mark]

foreach external false true

statement ok
SET debug_force_external={external};

foreach threads 1 4

statement ok
SET threads={threads};

statement ok
CREATE OR REPLACE TABLE residual_p AS
SELECT i id, CASE WHEN i%3=0 THEN NULL ELSE i%4 END a,
       CASE WHEN i%5=0 THEN NULL ELSE i%6 END c,
       CASE WHEN i%7=0 THEN NULL ELSE i%5 END e, i%3 g,
       CASE WHEN i%4=0 THEN NULL ELSE i%9 END x FROM range(23) t(i);

statement ok
CREATE OR REPLACE TABLE residual_b AS
SELECT CASE WHEN i%4=0 THEN NULL ELSE i%4 END b,
       CASE WHEN i%3=0 THEN NULL ELSE i%6 END d,
       CASE WHEN i%5=0 THEN NULL ELSE i%5 END f, i%3 h,
       CASE WHEN i%6=0 THEN NULL ELSE i%9 END y FROM range(19) t(i);

query I
WITH actual AS (SELECT id,__mark_join_marker m FROM residual_p JOIN BY(TYPE MARK) residual_b ON a=b AND x+y<7),
expected AS (SELECT id,max(CASE WHEN a=b AND x+y<7 THEN 2
                              WHEN (a=b AND x+y<7) IS NULL THEN 1 ELSE 0 END) m
             FROM residual_p CROSS JOIN residual_b GROUP BY id)
SELECT count(*) FROM actual FULL JOIN expected USING(id)
WHERE actual.id IS NULL OR expected.id IS NULL
   OR CASE WHEN actual.m THEN 2 WHEN actual.m IS NULL THEN 1 ELSE 0 END <> expected.m;
----
0

query I
WITH actual AS (SELECT id,__mark_join_marker m FROM residual_p JOIN BY(TYPE MARK) residual_b ON a=b AND c=d AND x+y<7),
expected AS (SELECT id,max(CASE WHEN a=b AND c=d AND x+y<7 THEN 2
                              WHEN (a=b AND c=d AND x+y<7) IS NULL THEN 1 ELSE 0 END) m
             FROM residual_p CROSS JOIN residual_b GROUP BY id)
SELECT count(*) FROM actual FULL JOIN expected USING(id)
WHERE actual.id IS NULL OR expected.id IS NULL
   OR CASE WHEN actual.m THEN 2 WHEN actual.m IS NULL THEN 1 ELSE 0 END <> expected.m;
----
0

query I
WITH actual AS (SELECT id,__mark_join_marker m FROM residual_p JOIN BY(TYPE MARK) residual_b ON a=b AND c<d AND x+y<7),
expected AS (SELECT id,max(CASE WHEN a=b AND c<d AND x+y<7 THEN 2
                              WHEN (a=b AND c<d AND x+y<7) IS NULL THEN 1 ELSE 0 END) m
             FROM residual_p CROSS JOIN residual_b GROUP BY id)
SELECT count(*) FROM actual FULL JOIN expected USING(id)
WHERE actual.id IS NULL OR expected.id IS NULL
   OR CASE WHEN actual.m THEN 2 WHEN actual.m IS NULL THEN 1 ELSE 0 END <> expected.m;
----
0

query I
WITH actual AS (SELECT id,__mark_join_marker m FROM residual_p JOIN BY(TYPE MARK) residual_b ON a=b AND c<d AND e>f AND x+y<7),
expected AS (SELECT id,max(CASE WHEN a=b AND c<d AND e>f AND x+y<7 THEN 2
                              WHEN (a=b AND c<d AND e>f AND x+y<7) IS NULL THEN 1 ELSE 0 END) m
             FROM residual_p CROSS JOIN residual_b GROUP BY id)
SELECT count(*) FROM actual FULL JOIN expected USING(id)
WHERE actual.id IS NULL OR expected.id IS NULL
   OR CASE WHEN actual.m THEN 2 WHEN actual.m IS NULL THEN 1 ELSE 0 END <> expected.m;
----
0

query I
WITH actual AS (SELECT id,__mark_join_marker m FROM residual_p JOIN BY(TYPE MARK) residual_b ON a=b AND c<d AND e>f AND g<=h AND x+y<7),
expected AS (SELECT id,max(CASE WHEN a=b AND c<d AND e>f AND g<=h AND x+y<7 THEN 2
                              WHEN (a=b AND c<d AND e>f AND g<=h AND x+y<7) IS NULL THEN 1 ELSE 0 END) m
             FROM residual_p CROSS JOIN residual_b GROUP BY id)
SELECT count(*) FROM actual FULL JOIN expected USING(id)
WHERE actual.id IS NULL OR expected.id IS NULL
   OR CASE WHEN actual.m THEN 2 WHEN actual.m IS NULL THEN 1 ELSE 0 END <> expected.m;
----
0

query I
WITH actual AS (SELECT id,__mark_join_marker m FROM residual_p JOIN BY(TYPE MARK) residual_b ON a=b AND c IS NOT DISTINCT FROM d AND x+y<7),
expected AS (SELECT id,max(CASE WHEN a=b AND c IS NOT DISTINCT FROM d AND x+y<7 THEN 2
                              WHEN (a=b AND c IS NOT DISTINCT FROM d AND x+y<7) IS NULL THEN 1 ELSE 0 END) m
             FROM residual_p CROSS JOIN residual_b GROUP BY id)
SELECT count(*) FROM actual FULL JOIN expected USING(id)
WHERE actual.id IS NULL OR expected.id IS NULL
   OR CASE WHEN actual.m THEN 2 WHEN actual.m IS NULL THEN 1 ELSE 0 END <> expected.m;
----
0

# The best range witness fails the residual; a different row still contributes UNKNOWN.
query I
SELECT __mark_join_marker FROM (VALUES (NULL::INTEGER,2,10)) p(a,c,x)
JOIN BY(TYPE MARK) (VALUES (1,1,0),(1,0,20)) b(b,d,y) ON a=b AND c>d AND x+y<15;
----
NULL

# NULL keys on either side do not override a false residual.
query I
SELECT __mark_join_marker FROM (VALUES (NULL::INTEGER)) p(a)
JOIN BY(TYPE MARK) (VALUES (1)) b(b) ON a=b AND a+b IS NOT NULL;
----
false

query I
SELECT __mark_join_marker FROM (VALUES (1)) p(a)
JOIN BY(TYPE MARK) (VALUES (NULL::INTEGER)) b(b) ON a=b AND a+b IS NOT NULL;
----
false

# A retained build can contain only NULL keys, so the hash table itself is empty.
query I
SELECT __mark_join_marker FROM (VALUES (1,5)) p(a,x)
JOIN BY(TYPE MARK) (VALUES (NULL::INTEGER,1),(NULL::INTEGER,9)) b(b,y) ON a=b AND x+y<10;
----
NULL

statement ok
DELETE FROM residual_b;

query I
SELECT count(*) FROM (SELECT __mark_join_marker m FROM residual_p JOIN BY(TYPE MARK) residual_b ON a=b AND x+y<7) WHERE m IS DISTINCT FROM false;
----
0

# Hash implementation protection: native matches must not execute their residual again in refinement.
statement ok
CREATE OR REPLACE SEQUENCE residual_calls;

query I
SELECT count(*) FROM (SELECT __mark_join_marker m FROM (VALUES (1),(NULL::INTEGER)) p(a)
JOIN BY(TYPE MARK) (VALUES (1),(2)) b(b) ON a=b AND nextval('residual_calls')+coalesce(a+b,0)<0)
WHERE m IS DISTINCT FROM false;
----
0

query I
SELECT currval('residual_calls');
----
3

endloop

endloop

statement ok
RESET threads;

statement ok
RESET debug_force_external;
