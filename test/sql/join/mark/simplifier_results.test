# name: test/sql/join/mark/simplifier_results.test
# description: MARK conversion preserves complete predicates and nested NULL semantics
# group: [mark]

statement ok
CREATE TABLE p(a INTEGER);

statement ok
INSERT INTO p VALUES (0), (1), (2), (NULL);

statement ok
CREATE TABLE b(b INTEGER);

statement ok
INSERT INTO b VALUES (1), (NULL);

query I rowsort
SELECT a FROM p WHERE a IN (SELECT b FROM b);
----
1

query I rowsort
SELECT a FROM p WHERE NOT EXISTS (SELECT 1 FROM b WHERE a IS NOT DISTINCT FROM b);
----
0
2

query I rowsort
SELECT a FROM p WHERE NOT EXISTS (SELECT 1 FROM b WHERE a IS NOT DISTINCT FROM b AND a+b>0);
----
0
2
NULL

query I rowsort
SELECT a FROM p WHERE EXISTS (SELECT 1 FROM b WHERE a IS NOT DISTINCT FROM b AND a+b>0);
----
1

query I rowsort
SELECT a FROM p WHERE NOT EXISTS (SELECT 1 FROM b WHERE a IS NOT DISTINCT FROM b AND (a+b) IS NULL);
----
0
1
2

query II rowsort
SELECT a, m FROM (SELECT a, a IN (SELECT b FROM b) AS m FROM p) WHERE m;
----
1	true

query II
WITH c AS MATERIALIZED (SELECT a, a IN (SELECT b FROM b) AS m FROM p)
SELECT (SELECT count(*) FROM c WHERE m), (SELECT count(*) FROM c WHERE m IS NULL);
----
1	3

statement ok
PREPARE marker_query AS SELECT a FROM p WHERE a IN (SELECT b FROM b) ORDER BY a;

query I
EXECUTE marker_query;
----
1

statement ok
DELETE FROM b;

query I
EXECUTE marker_query;
----

query I
SELECT count(*) FROM p JOIN BY (TYPE MARK) b ON a IS NOT DISTINCT FROM b WHERE NOT __mark_join_marker;
----
4

statement ok
INSERT INTO b VALUES (2);

query I
EXECUTE marker_query;
----
2

# An active UNION member can be NULL even when the UNION itself is not.
statement ok
CREATE TABLE union_probe AS SELECT union_value(i:=NULL::INTEGER) AS a;

statement ok
CREATE TABLE union_build AS SELECT union_value(i:=NULL::INTEGER) AS b;

query I
SELECT count(*) FROM union_probe JOIN BY (TYPE MARK) union_build ON a IS NOT DISTINCT FROM b WHERE __mark_join_marker;
----
1

# MARK tuple inequality can return NULL when ordinary tuple inequality returns TRUE.
statement ok
CREATE TABLE tuple_probe AS SELECT row(1,2) AS a;

statement ok
CREATE TABLE tuple_build AS SELECT row(1,NULL::INTEGER) AS b;

query I
SELECT count(*) FROM tuple_probe JOIN BY (TYPE MARK) tuple_build ON a<>b WHERE __mark_join_marker;
----
0

query I
SELECT count(*) FROM (VALUES ((1,NULL))) p(a) JOIN BY (TYPE MARK) (VALUES ((1,NULL))) b(b) ON a=b WHERE __mark_join_marker;
----
1
