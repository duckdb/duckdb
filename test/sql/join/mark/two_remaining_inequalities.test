# name: test/sql/join/mark/two_remaining_inequalities.test
# description: IE MARK NULL probes use extrema over qualifying prefixes of the same build rows
# group: [mark]

statement ok
SET prefer_range_joins=true;

statement ok
SET nested_loop_join_threshold=0;

statement ok
SET merge_join_threshold=0;

foreach external false true

statement ok
SET debug_force_external={external};

foreach comparison1 < <= > >=

foreach comparison2 < <= > >=

foreach build_null 0 1 2 3

query I
WITH l AS (
    SELECT i id,NULL::INTEGER a,i%11 c,i%13 e FROM range(19)t(i)
), r AS (
    SELECT i b,CASE WHEN {build_null}&1 AND i%3=0 THEN NULL ELSE i%17 END d,
               CASE WHEN {build_null}&2 AND i%5=0 THEN NULL ELSE i%19 END f FROM range(23)t(i)
), native AS (
    SELECT id,__mark_join_marker m FROM l JOIN BY(TYPE MARK) r ON a<b AND c {comparison1} d AND e {comparison2} f
), oracle AS (
    SELECT id,max(CASE WHEN a<b AND c {comparison1} d AND e {comparison2} f THEN 2
                      WHEN (a<b AND c {comparison1} d AND e {comparison2} f) IS NULL THEN 1 ELSE 0 END)m
    FROM l CROSS JOIN r GROUP BY id
)
SELECT count(*) FROM native JOIN oracle USING(id)
WHERE CASE WHEN native.m THEN 2 WHEN native.m IS NULL THEN 1 ELSE 0 END<>oracle.m;
----
0

endloop

endloop

endloop

# Both independent extrema qualify, but they belong to different rows.
query I
SELECT __mark_join_marker FROM (VALUES(NULL::INTEGER,5,5))l(a,c,e)
JOIN BY(TYPE MARK)(VALUES(1,4,4),(1,6,6))r(b,d,f) ON a<b AND c>d AND e<f;
----
false

# Equal first keys must all participate for inclusive comparison and none for strict comparison.
query II
WITH l AS (SELECT NULL::INTEGER a,5 c,5 e), r AS (SELECT * FROM (VALUES(1,5,4),(1,5,6))t(b,d,f))
SELECT (SELECT __mark_join_marker FROM l JOIN BY(TYPE MARK) r ON a<b AND c>=d AND e<f),
       (SELECT __mark_join_marker FROM l JOIN BY(TYPE MARK) r ON a<b AND c>d AND e<f);
----
NULL	false

# Prefix search crosses vector boundaries. An UNKNOWN pair must satisfy both surviving inequalities.
query IIII
WITH l AS (
    SELECT i id,NULL::BIGINT a,i c,i%97 e FROM range(3000)t(i)
), r AS (
    SELECT i b,i+1 d,i%97+1 f FROM range(3000)t(i)
), native AS (
    SELECT id,__mark_join_marker m FROM l JOIN BY(TYPE MARK) r ON a<b AND c>d AND e<f
), oracle AS (
    SELECT id,max(CASE WHEN a<b AND c>d AND e<f THEN 2
                      WHEN (a<b AND c>d AND e<f) IS NULL THEN 1 ELSE 0 END)m
    FROM l CROSS JOIN r GROUP BY id
)
SELECT count(*) FILTER(WHERE native.m),count(*) FILTER(WHERE native.m IS NULL),count(*) FILTER(WHERE native.m IS FALSE),
       count(*) FILTER(WHERE CASE WHEN native.m THEN 2 WHEN native.m IS NULL THEN 1 ELSE 0 END<>oracle.m)
FROM native JOIN oracle USING(id);
----
0	2903	97	0

# A fourth ordinary NULL comparison also disappears; the same two surviving inequalities remain.
query I
SELECT __mark_join_marker FROM (VALUES(NULL::INTEGER,5,5,NULL::INTEGER))l(a,c,e,g)
JOIN BY(TYPE MARK)(VALUES(1,4,6,1))r(b,d,f,h) ON a<b AND c>d AND e<f AND g>h;
----
NULL

endloop

statement ok
RESET prefer_range_joins;

statement ok
RESET nested_loop_join_threshold;

statement ok
RESET merge_join_threshold;

statement ok
RESET debug_force_external;
