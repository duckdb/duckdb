# name: test/sql/join/mark/pattern_refinement.test
# description: MARK refinement preserves exact truth across scalar NULL-pattern groups
# group: [mark]

foreach external false true

statement ok
SET debug_force_external={external};

loop probe_mask 0 2

loop build_mask 0 2

query II
WITH l AS (SELECT i id,CASE WHEN {probe_mask}&1 THEN NULL ELSE (i+0)%3 END a0 FROM range(4)t(i)),
r AS (SELECT CASE WHEN {build_mask}&1 THEN NULL ELSE (i+0)%4 END b0 FROM range(5)t(i)),
actual AS (SELECT id,__mark_join_marker m FROM l JOIN BY(TYPE MARK) r ON a0=b0),
expected AS (SELECT id,max(CASE WHEN a0=b0 THEN 2 WHEN (a0=b0) IS NULL THEN 1 ELSE 0 END)m
FROM l CROSS JOIN r GROUP BY id)
SELECT count(*),count(*) FILTER(WHERE CASE WHEN actual.m THEN 2 WHEN actual.m IS NULL THEN 1 ELSE 0 END<>expected.m)
FROM actual JOIN expected USING(id);
----
4	0

endloop

endloop

loop probe_mask 0 4

loop build_mask 0 4

query II
WITH l AS (SELECT i id,CASE WHEN {probe_mask}&1 THEN NULL ELSE (i+0)%3 END a0,CASE WHEN {probe_mask}&2 THEN NULL ELSE (i+1)%3 END a1 FROM range(4)t(i)),
r AS (SELECT CASE WHEN {build_mask}&1 THEN NULL ELSE (i+0)%4 END b0,CASE WHEN {build_mask}&2 THEN NULL ELSE (i+1)%4 END b1 FROM range(5)t(i)),
actual AS (SELECT id,__mark_join_marker m FROM l JOIN BY(TYPE MARK) r ON a0=b0 AND a1=b1),
expected AS (SELECT id,max(CASE WHEN a0=b0 AND a1=b1 THEN 2 WHEN (a0=b0 AND a1=b1) IS NULL THEN 1 ELSE 0 END)m
FROM l CROSS JOIN r GROUP BY id)
SELECT count(*),count(*) FILTER(WHERE CASE WHEN actual.m THEN 2 WHEN actual.m IS NULL THEN 1 ELSE 0 END<>expected.m)
FROM actual JOIN expected USING(id);
----
4	0

endloop

endloop

loop probe_mask 0 8

loop build_mask 0 8

query II
WITH l AS (SELECT i id,CASE WHEN {probe_mask}&1 THEN NULL ELSE (i+0)%3 END a0,CASE WHEN {probe_mask}&2 THEN NULL ELSE (i+1)%3 END a1,CASE WHEN {probe_mask}&4 THEN NULL ELSE (i+2)%3 END a2 FROM range(4)t(i)),
r AS (SELECT CASE WHEN {build_mask}&1 THEN NULL ELSE (i+0)%4 END b0,CASE WHEN {build_mask}&2 THEN NULL ELSE (i+1)%4 END b1,CASE WHEN {build_mask}&4 THEN NULL ELSE (i+2)%4 END b2 FROM range(5)t(i)),
actual AS (SELECT id,__mark_join_marker m FROM l JOIN BY(TYPE MARK) r ON a0=b0 AND a1=b1 AND a2<b2),
expected AS (SELECT id,max(CASE WHEN a0=b0 AND a1=b1 AND a2<b2 THEN 2 WHEN (a0=b0 AND a1=b1 AND a2<b2) IS NULL THEN 1 ELSE 0 END)m
FROM l CROSS JOIN r GROUP BY id)
SELECT count(*),count(*) FILTER(WHERE CASE WHEN actual.m THEN 2 WHEN actual.m IS NULL THEN 1 ELSE 0 END<>expected.m)
FROM actual JOIN expected USING(id);
----
4	0

endloop

endloop

loop probe_mask 0 16

loop build_mask 0 16

query II
WITH l AS (SELECT i id,CASE WHEN {probe_mask}&1 THEN NULL ELSE (i+0)%3 END a0,CASE WHEN {probe_mask}&2 THEN NULL ELSE (i+1)%3 END a1,CASE WHEN {probe_mask}&4 THEN NULL ELSE (i+2)%3 END a2,CASE WHEN {probe_mask}&8 THEN NULL ELSE (i+3)%3 END a3 FROM range(4)t(i)),
r AS (SELECT CASE WHEN {build_mask}&1 THEN NULL ELSE (i+0)%4 END b0,CASE WHEN {build_mask}&2 THEN NULL ELSE (i+1)%4 END b1,CASE WHEN {build_mask}&4 THEN NULL ELSE (i+2)%4 END b2,CASE WHEN {build_mask}&8 THEN NULL ELSE (i+3)%4 END b3 FROM range(5)t(i)),
actual AS (SELECT id,__mark_join_marker m FROM l JOIN BY(TYPE MARK) r ON a0=b0 AND a1=b1 AND a2<b2 AND a3>=b3),
expected AS (SELECT id,max(CASE WHEN a0=b0 AND a1=b1 AND a2<b2 AND a3>=b3 THEN 2 WHEN (a0=b0 AND a1=b1 AND a2<b2 AND a3>=b3) IS NULL THEN 1 ELSE 0 END)m
FROM l CROSS JOIN r GROUP BY id)
SELECT count(*),count(*) FILTER(WHERE CASE WHEN actual.m THEN 2 WHEN actual.m IS NULL THEN 1 ELSE 0 END<>expected.m)
FROM actual JOIN expected USING(id);
----
4	0

endloop

endloop

loop probe_mask 0 32

loop build_mask 0 32

query II
WITH l AS (SELECT i id,CASE WHEN {probe_mask}&1 THEN NULL ELSE (i+0)%3 END a0,CASE WHEN {probe_mask}&2 THEN NULL ELSE (i+1)%3 END a1,CASE WHEN {probe_mask}&4 THEN NULL ELSE (i+2)%3 END a2,CASE WHEN {probe_mask}&8 THEN NULL ELSE (i+3)%3 END a3,CASE WHEN {probe_mask}&16 THEN NULL ELSE (i+4)%3 END a4 FROM range(4)t(i)),
r AS (SELECT CASE WHEN {build_mask}&1 THEN NULL ELSE (i+0)%4 END b0,CASE WHEN {build_mask}&2 THEN NULL ELSE (i+1)%4 END b1,CASE WHEN {build_mask}&4 THEN NULL ELSE (i+2)%4 END b2,CASE WHEN {build_mask}&8 THEN NULL ELSE (i+3)%4 END b3,CASE WHEN {build_mask}&16 THEN NULL ELSE (i+4)%4 END b4 FROM range(5)t(i)),
actual AS (SELECT id,__mark_join_marker m FROM l JOIN BY(TYPE MARK) r ON a0=b0 AND a1=b1 AND a2<b2 AND a3>=b3 AND a4<b4),
expected AS (SELECT id,max(CASE WHEN a0=b0 AND a1=b1 AND a2<b2 AND a3>=b3 AND a4<b4 THEN 2 WHEN (a0=b0 AND a1=b1 AND a2<b2 AND a3>=b3 AND a4<b4) IS NULL THEN 1 ELSE 0 END)m
FROM l CROSS JOIN r GROUP BY id)
SELECT count(*),count(*) FILTER(WHERE CASE WHEN actual.m THEN 2 WHEN actual.m IS NULL THEN 1 ELSE 0 END<>expected.m)
FROM actual JOIN expected USING(id);
----
4	0

endloop

endloop

endloop

statement ok
RESET debug_force_external;
