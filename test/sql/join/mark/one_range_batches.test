# name: test/sql/join/mark/one_range_batches.test
# description: Single-range MARK witnesses preserve truth across probe batches and NULL groups
# group: [mark]

statement ok
SET nested_loop_join_threshold=0;

statement ok
SET merge_join_threshold=0;

statement ok
SET max_execution_time=30000;

foreach external false true

statement ok
SET debug_force_external={external};

foreach threads 1 4

statement ok
SET threads={threads};

foreach type BIGINT DOUBLE VARCHAR

foreach cmp < <= > >=

loop flip 0 2

query I
WITH p AS (
 SELECT i id, CASE WHEN i%3=0 THEN NULL ELSE i%4 END a,
        CAST(CASE WHEN i%5=0 THEN NULL ELSE i%7 END AS {type}) b
 FROM range(CASE WHEN {flip}=0 THEN 4099 ELSE 13 END) t(i)
), r AS (
 SELECT CASE WHEN i%4=0 THEN NULL ELSE i%4 END a,
        CAST(CASE WHEN i%3=0 THEN NULL ELSE i%7 END AS {type}) b
 FROM range(CASE WHEN {flip}=0 THEN 13 ELSE 4099 END) t(i)
), actual AS (
 SELECT p.id, __mark_join_marker m FROM p JOIN BY(TYPE MARK) r ON p.a=r.a AND p.b{cmp}r.b
), expected AS (
 SELECT p.id, max(CASE WHEN p.a=r.a AND p.b{cmp}r.b THEN 2
                      WHEN (p.a=r.a AND p.b{cmp}r.b) IS NULL THEN 1 ELSE 0 END) m
 FROM p CROSS JOIN r GROUP BY p.id
)
SELECT abs(count(*)-(SELECT count(*) FROM p)) + count(*) FILTER (
 WHERE actual.id IS NULL OR expected.id IS NULL
    OR CASE WHEN actual.m THEN 2 WHEN actual.m IS NULL THEN 1 ELSE 0 END <> expected.m)
FROM actual FULL JOIN expected USING(id);
----
0

endloop

endloop

endloop

endloop

endloop
