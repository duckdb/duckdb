# name: test/sql/join/mark/hash_residual_lifecycle.test
# description: Hash MARK residual payload survives chunk boundaries, nested keys and external execution
# group: [mark]

statement ok
SET max_execution_time=30000;

foreach external false true

statement ok
SET debug_force_external={external};

foreach threads 1 4

statement ok
SET threads={threads};

# Sparse NULLs cross several probe chunks; payload columns are independently NULL.
query I
WITH p AS (SELECT i id, CASE WHEN i%2048=0 THEN NULL ELSE i%17 END a,
                  CASE WHEN i%5=0 THEN NULL ELSE i%9 END x FROM range(4099) t(i)),
     b AS (SELECT CASE WHEN i%13=0 THEN NULL ELSE i%17 END b,
                  CASE WHEN i%7=0 THEN NULL ELSE i%11 END y FROM range(65) t(i)),
     actual AS (SELECT id,__mark_join_marker m FROM p JOIN BY(TYPE MARK) b ON a=b AND x+y<5),
     expected AS (SELECT id,max(CASE WHEN a=b AND x+y<5 THEN 2
                                    WHEN (a=b AND x+y<5) IS NULL THEN 1 ELSE 0 END) m
                  FROM p CROSS JOIN b GROUP BY id)
SELECT count(*) FROM actual FULL JOIN expected USING(id)
WHERE actual.id IS NULL OR expected.id IS NULL
   OR CASE WHEN actual.m THEN 2 WHEN actual.m IS NULL THEN 1 ELSE 0 END <> expected.m;
----
0

# Retain evaluated key expressions rather than executing their effects during refinement.
statement ok
CREATE OR REPLACE SEQUENCE probe_keys;

statement ok
CREATE OR REPLACE SEQUENCE build_keys;

query I
SELECT count(*) FROM (
SELECT __mark_join_marker m FROM range(4099) p(i) JOIN BY(TYPE MARK) range(17) b(i)
ON CASE WHEN nextval('probe_keys')>0 THEN NULL::BIGINT ELSE p.i END
 = CASE WHEN nextval('build_keys')>0 THEN b.i ELSE NULL::BIGINT END
AND p.i+b.i<0) WHERE m IS DISTINCT FROM false;
----
0

query II
SELECT currval('probe_keys'),currval('build_keys');
----
4099	17

# Probe state and cached refinement survive repeated recursive iterations.
query II
WITH RECURSIVE t(i,m) AS (
SELECT 0,NULL::BOOLEAN
UNION ALL
SELECT t.i+1,__mark_join_marker FROM t
JOIN BY(TYPE MARK) (VALUES(NULL::INTEGER,0),(1,2)) b(k,y)
ON t.i=b.k AND t.i+b.y<1 WHERE t.i<3)
SELECT * FROM t ORDER BY i;
----
0	NULL
1	NULL
2	false
3	false

# The build changes each iteration; stale retained payload would make the last marker NULL.
query II
WITH RECURSIVE t(i,m) AS (
SELECT 0,NULL::BOOLEAN
UNION ALL
SELECT p.i+1,__mark_join_marker FROM t p
JOIN BY(TYPE MARK) (SELECT NULL::INTEGER k,i y FROM t) b
ON p.i=b.k AND p.i+b.y<3 WHERE p.i<3)
SELECT * FROM t ORDER BY i;
----
0	NULL
1	NULL
2	NULL
3	false

query I
WITH p(id,a,x)AS (VALUES (0,NULL::UNION(i INTEGER,s VARCHAR),5),(1,union_value(i:=1)::UNION(i INTEGER,s VARCHAR),0),(2,union_value(s:='x')::UNION(i INTEGER,s VARCHAR),10)),
b(b,y) AS (VALUES (NULL::UNION(i INTEGER,s VARCHAR),1),(union_value(i:=1)::UNION(i INTEGER,s VARCHAR),1),(union_value(s:='x')::UNION(i INTEGER,s VARCHAR),0)),
actual AS (SELECT id,__mark_join_marker m FROM p JOIN BY(TYPE MARK) b ON a=b AND x+y<7),
expected AS (SELECT id,max(CASE WHEN a=b AND x+y<7 THEN 2 WHEN (a=b AND x+y<7) IS NULL THEN 1 ELSE 0 END) m FROM p CROSS JOIN b GROUP BY id)
SELECT count(*) FROM actual FULL JOIN expected USING(id) WHERE actual.id IS NULL OR expected.id IS NULL OR CASE WHEN actual.m THEN 2 WHEN actual.m IS NULL THEN 1 ELSE 0 END<>expected.m;
----
0

foreach constructor row list_value

# Hash nested equality remains composite, including nested NULLs and top-level NULLs.
query I
WITH p(id,a,x) AS (VALUES (0,NULL,5),(1,{constructor}(NULL::INTEGER,2),10),(2,{constructor}(1,2),0)),
     b(b,y) AS (VALUES ({constructor}(1,2),1),({constructor}(NULL::INTEGER,2),2),(NULL,10)),
     actual AS (SELECT id,__mark_join_marker m FROM p JOIN BY(TYPE MARK) b ON a=b AND x+y<7),
     expected AS (SELECT id,max(CASE WHEN a=b AND x+y<7 THEN 2
                                    WHEN (a=b AND x+y<7) IS NULL THEN 1 ELSE 0 END) m
                  FROM p CROSS JOIN b GROUP BY id)
SELECT count(*) FROM actual FULL JOIN expected USING(id)
WHERE actual.id IS NULL OR expected.id IS NULL
   OR CASE WHEN actual.m THEN 2 WHEN actual.m IS NULL THEN 1 ELSE 0 END <> expected.m;
----
0

endloop

endloop

endloop

statement ok
RESET threads;

statement ok
RESET debug_force_external;

statement ok
RESET max_execution_time;
