# name: test/sql/join/mark/tuple_value_semantics.test
# description: MARK compares nested NULLs as values and top-level NULLs as unknown
# group: [mark]

foreach external false true

statement ok
SET debug_force_external={external};

query I
SELECT row(NULL::INT,2) = ANY (SELECT row(1,2));
----
false

query I
SELECT __mark_join_marker FROM (VALUES (row(NULL::INT,2),1)) p(k,v) JOIN BY (TYPE MARK) (VALUES (row(1,2),2)) b(k,v) ON p.k=b.k AND p.v<b.v;
----
false

query I
SELECT row(NULL::INT,2) = ANY (SELECT row(NULL::INT,2));
----
true

query I
SELECT __mark_join_marker FROM (VALUES (row(NULL::INT,2),1)) p(k,v) JOIN BY (TYPE MARK) (VALUES (row(NULL::INT,2),2)) b(k,v) ON p.k=b.k AND p.v<b.v;
----
true

query I
SELECT NULL::TUPLE(INT,INT) = ANY (SELECT row(1,2));
----
NULL

query I
SELECT __mark_join_marker FROM (VALUES (NULL::TUPLE(INT,INT),1)) p(k,v) JOIN BY (TYPE MARK) (VALUES (row(1,2),2)) b(k,v) ON p.k=b.k AND p.v<b.v;
----
NULL

query I
SELECT row(1,2) = ANY (SELECT row(NULL::INT,2));
----
false

query I
SELECT __mark_join_marker FROM (VALUES (row(1,2),1)) p(k,v) JOIN BY (TYPE MARK) (VALUES (row(NULL::INT,2),2)) b(k,v) ON p.k=b.k AND p.v<b.v;
----
false

query I
SELECT row(NULL::INT,2) < ANY (SELECT row(1,2));
----
false

query I
SELECT row(NULL::INT,2) > ANY (SELECT row(1,2));
----
true

endloop
