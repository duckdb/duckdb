# name: test/sql/join/mark/ie_tail_conjunction.test
# description: IE MARK tail conjunctions refine NULL blocks with per-pair truth values
# group: [mark]

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

statement ok
CREATE TABLE ie_tail_probe AS SELECT i a,i c,i%97 e FROM range(20000)t(i);

statement ok
CREATE TABLE ie_tail_build AS SELECT i b,i+1 d,i%97+1 f FROM range(20000)t(i);

query TT
EXPLAIN SELECT count(*) FROM (SELECT __mark_join_marker m FROM ie_tail_probe JOIN BY(TYPE MARK) ie_tail_build ON a<b AND c>d AND e<f) markers WHERE m IS FALSE;
----
physical_plan	<REGEX>:[\s\S]*IE_JOIN[\s\S]*

statement ok
SET max_execution_time=1000;

query I
SELECT count(*) FROM (SELECT __mark_join_marker m FROM ie_tail_probe JOIN BY(TYPE MARK) ie_tail_build ON a<b AND c>d AND e<f) markers WHERE m IS FALSE;
----
20000

statement ok
RESET max_execution_time;

foreach external false true

statement ok
SET debug_force_external={external};

statement ok
SET nested_loop_join_threshold=0;

statement ok
SET merge_join_threshold=0;

statement ok
SET prefer_range_joins=true;

statement ok
CREATE OR REPLACE TABLE tail_probe AS SELECT i id,CASE WHEN i%1000=0 THEN NULL ELSE i END a,0 c FROM range(3000)t(i);

statement ok
CREATE OR REPLACE TABLE tail_build AS SELECT i b,CASE WHEN i=2997 THEN NULL ELSE 1 END d FROM range(3000)t(i);

query IIII
WITH native AS (
    SELECT id,__mark_join_marker m FROM tail_probe JOIN BY(TYPE MARK) tail_build ON a<b AND c>d AND a<b+1
), oracle AS (
    SELECT id,max(CASE WHEN a<b AND c>d AND a<b+1 THEN 2 WHEN (a<b AND c>d AND a<b+1) IS NULL THEN 1 ELSE 0 END) m
    FROM tail_probe CROSS JOIN tail_build GROUP BY id
)
SELECT count(*) FILTER(WHERE native.m),count(*) FILTER(WHERE native.m IS NULL),count(*) FILTER(WHERE native.m IS FALSE),
       count(*) FILTER(WHERE CASE WHEN native.m THEN 2 WHEN native.m IS NULL THEN 1 ELSE 0 END<>oracle.m)
FROM native JOIN oracle USING(id);
----
0	2997	3	0

# A null-safe tail can make a pair TRUE even though sorting put it in the NULL block.
query I
SELECT __mark_join_marker FROM (VALUES (1,2,NULL::INTEGER)) l(a,c,e)
JOIN BY(TYPE MARK) (VALUES (2,1,NULL::INTEGER)) r(b,d,f) ON a<b AND c>d AND e IS NOT DISTINCT FROM f;
----
true

# An earlier UNKNOWN pair must not hide a later TRUE pair.
query I
SELECT __mark_join_marker FROM (VALUES (1,2,NULL::INTEGER)) l(a,c,e)
JOIN BY(TYPE MARK) (VALUES (2,NULL::INTEGER,NULL::INTEGER),(2,1,NULL::INTEGER)) r(b,d,f)
ON a<b AND c>d AND e IS NOT DISTINCT FROM f;
----
true

# Tail refinement uses the evaluated invocation, without repeating its effect.
statement ok
CREATE OR REPLACE SEQUENCE ie_tail_sequence;

query I
SELECT __mark_join_marker FROM (VALUES (1,2)) l(a,c)
JOIN BY(TYPE MARK) (VALUES (2,1,NULL::INTEGER)) r(b,d,f)
ON a<b AND c>d AND CASE WHEN nextval('ie_tail_sequence')=1 THEN NULL ELSE 0 END IS NOT DISTINCT FROM f;
----
true

query I
SELECT last_value FROM duckdb_sequences() WHERE sequence_name='ie_tail_sequence';
----
1

# Tuple comparisons treat nested NULLs as values on either side.
query I
SELECT __mark_join_marker FROM (VALUES (1,1,(1,NULL))) l(a,c,e)
JOIN BY(TYPE MARK) (VALUES (2,2,(1,2))) r(b,d,f) ON a<b AND c<d AND e = f;
----
false

query I
SELECT __mark_join_marker FROM (VALUES (1,1,(1,2))) l(a,c,e)
JOIN BY(TYPE MARK) (VALUES (2,2,(1,NULL))) r(b,d,f) ON a<b AND c<d AND e = f;
----
false

# Tuple comparisons treat nested NULLs as values on either side.
query I
SELECT __mark_join_marker FROM (VALUES (1,1,(1,NULL))) l(a,c,e)
JOIN BY(TYPE MARK) (VALUES (2,2,(1,2))) r(b,d,f) ON a<b AND c<d AND e <> f;
----
true

query I
SELECT __mark_join_marker FROM (VALUES (1,1,(1,2))) l(a,c,e)
JOIN BY(TYPE MARK) (VALUES (2,2,(1,NULL))) r(b,d,f) ON a<b AND c<d AND e <> f;
----
true


# A differing tuple field makes equality FALSE and inequality TRUE despite another NULL.
query I
SELECT __mark_join_marker FROM (VALUES (1,1,(2,NULL))) l(a,c,e)
JOIN BY(TYPE MARK) (VALUES (2,2,(1,2))) r(b,d,f) ON a<b AND c<d AND e=f;
----
false

query I
SELECT __mark_join_marker FROM (VALUES (1,1,(2,NULL))) l(a,c,e)
JOIN BY(TYPE MARK) (VALUES (2,2,(1,2))) r(b,d,f) ON a<b AND c<d AND e<>f;
----
true

# A UNION active child can be NULL even when its outer value is valid.
query I
SELECT __mark_join_marker FROM (VALUES (1,1,union_value(x:=NULL::INTEGER))) l(a,c,e)
JOIN BY(TYPE MARK) (VALUES (2,2,union_value(x:=1))) r(b,d,f) ON a<b AND c<d AND e=f;
----
NULL

# Such ordering keys need pair refinement instead of scalar extrema.
query I
SELECT __mark_join_marker FROM (VALUES (1,union_value(x:=NULL::INTEGER))) l(a,e)
JOIN BY(TYPE MARK) (VALUES (2,union_value(x:=1))) r(b,f) ON a<b AND e<f;
----
NULL

query I
SELECT __mark_join_marker FROM (VALUES (1,union_value(x:=1))) l(a,e)
JOIN BY(TYPE MARK) (VALUES (2,union_value(x:=NULL::INTEGER))) r(b,f) ON a<b AND e<f;
----
NULL

endloop

statement ok
RESET debug_force_external;

statement ok
RESET nested_loop_join_threshold;

statement ok
RESET merge_join_threshold;

statement ok
RESET prefer_range_joins;
