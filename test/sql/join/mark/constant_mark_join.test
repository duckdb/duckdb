query II rowsort
SELECT p.a, __mark_join_marker
FROM (VALUES (10, 1), (20, 3), (30, NULL::INTEGER)) p(a, b)
JOIN BY(TYPE MARK) (SELECT 3::INTEGER AS j) r ON p.b<r.j;
----
10	true
20	false
30	NULL

query II
EXPLAIN SELECT p.a, __mark_join_marker
FROM (VALUES (10, 1), (20, 3), (30, NULL::INTEGER)) p(a, b)
JOIN BY(TYPE MARK) (SELECT 3::INTEGER AS j) r ON p.b<r.j;
----
physical_plan	<!REGEX>:.*Join Type: MARK.*

# A volatile build-side operand must stay in the MARK join.
query II
EXPLAIN SELECT __mark_join_marker
FROM probe p JOIN BY(TYPE MARK) (SELECT 2::INTEGER AS j) r ON p.i=r.j+random();
----
physical_plan	<REGEX>:.*Join Type: MARK.*

query II
EXPLAIN
SELECT __mark_join_marker FROM probe p JOIN BY(TYPE MARK) (SELECT 2::INTEGER AS j) r ON p.i<>r.j
UNION ALL
SELECT __mark_join_marker FROM probe p JOIN BY(TYPE MARK) (SELECT 2::INTEGER AS j) r ON p.i<r.j
UNION ALL
SELECT __mark_join_marker FROM probe p JOIN BY(TYPE MARK) (SELECT 2::INTEGER AS j) r ON p.i>r.j
UNION ALL
SELECT __mark_join_marker FROM probe p JOIN BY(TYPE MARK) (SELECT 2::INTEGER AS j) r ON p.i<=r.j
UNION ALL
SELECT __mark_join_marker FROM probe p JOIN BY(TYPE MARK) (SELECT 2::INTEGER AS j) r ON p.i>=r.j
UNION ALL
SELECT __mark_join_marker FROM probe p JOIN BY(TYPE MARK) (SELECT 2::INTEGER AS j) r ON p.i IS DISTINCT FROM r.j
UNION ALL
SELECT __mark_join_marker FROM probe p JOIN BY(TYPE MARK) (SELECT 2::INTEGER AS j) r ON p.i IS NOT DISTINCT FROM r.j;
----
physical_plan	<!REGEX>:.*Join Type: MARK.*

# Tuple <> has different NULL semantics from a direct comparison, so keep its MARK join.
query II
EXPLAIN SELECT __mark_join_marker FROM (VALUES (ROW(1, 2))) p(v)
JOIN BY(TYPE MARK) (SELECT ROW(1, NULL::INTEGER) AS j) r ON p.v<>r.j;
----
physical_plan	<REGEX>:.*Join Type: MARK.*

query II rowsort
SELECT p.id, __mark_join_marker
FROM (VALUES (1, ROW(1, 2)), (2, ROW(1, NULL::INTEGER)), (3, ROW(1, 3)), (4, ROW(NULL::INTEGER, 2))) p(id, v)
JOIN BY(TYPE MARK) (SELECT ROW(1, NULL::INTEGER) AS j) r ON p.v<r.j;
----
1	true
2	false
3	true
4	false

query II rowsort
SELECT p.id, __mark_join_marker
FROM (VALUES (1, ROW(1, 2)), (2, ROW(1, NULL::INTEGER)), (3, ROW(1, 3)), (4, ROW(NULL::INTEGER, 2))) p(id, v)
JOIN BY(TYPE MARK) (SELECT ROW(1, NULL::INTEGER) AS j) r ON p.v>r.j;
----
1	false
2	false
3	false
4	true

