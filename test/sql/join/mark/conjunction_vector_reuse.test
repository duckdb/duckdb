# name: test/sql/join/mark/conjunction_vector_reuse.test
# description: Reused nested-loop comparison vectors preserve nested NULLs and validity
# group: [mark]

statement ok
SET nested_loop_join_threshold=1000000;

foreach mode none dictionary_expression dictionary_operator constant_operator

statement ok
SET debug_verify_vector='{mode}';

foreach type INTEGER[] INTEGER[2]

statement ok
CREATE OR REPLACE TABLE reuse_probe AS SELECT i id, (CASE WHEN i%4=0 THEN NULL WHEN i%4=1 THEN [1,NULL] WHEN i%4=2 THEN [2,0] ELSE [0,1] END)::{type} v FROM range(2050) t(i);

statement ok
CREATE OR REPLACE TABLE reuse_build AS SELECT (CASE WHEN i%3=0 THEN NULL WHEN i%3=1 THEN [1,NULL] ELSE [0,1] END)::{type} v FROM range(5) t(i);

query I
WITH actual AS (SELECT p.id,__mark_join_marker m FROM reuse_probe p JOIN BY(TYPE MARK) reuse_build b ON p.v<b.v AND p.v<>b.v), expected AS (SELECT p.id,CASE WHEN bool_or(p.v<b.v AND p.v<>b.v) THEN true WHEN bool_or((p.v<b.v AND p.v<>b.v) IS NULL) THEN NULL ELSE false END m FROM reuse_probe p CROSS JOIN reuse_build b GROUP BY p.id) SELECT count(*) FROM actual a JOIN expected e USING(id) WHERE a.m IS DISTINCT FROM e.m;
----
0

endloop

endloop

statement ok
RESET debug_verify_vector;

statement ok
RESET nested_loop_join_threshold;
