physical_plan	<REGEX>:.*Hash Join.*

statement ok
DELETE FROM candidates;

query I
SELECT count(*) FROM (SELECT __mark_join_marker AS marker FROM probes p JOIN BY (TYPE MARK) candidates c ON p.g IS NOT DISTINCT FROM c.g AND p.v=c.v) q WHERE marker IS NOT FALSE;
----
0
