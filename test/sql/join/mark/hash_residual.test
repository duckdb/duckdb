# name: test/sql/join/mark/hash_residual.test
# description: Hash MARK combines comparison and residual truth before reducing markers
# group: [mark]

foreach disable false true

statement ok
SET debug_disable_optimizer={disable};

query I
SELECT __mark_join_marker FROM (VALUES (1)) p(a) JOIN BY(TYPE MARK) (VALUES (1)) b(b) ON a=b AND NULL::BOOLEAN;
----
NULL

query I
SELECT __mark_join_marker FROM (VALUES (1,2)) p(a,c) JOIN BY(TYPE MARK) (VALUES (1,1)) b(b,d) ON a=b AND c>d AND a+b<0;
----
false

query I
SELECT __mark_join_marker FROM (VALUES (1,NULL::INTEGER)) p(a,c) JOIN BY(TYPE MARK) (VALUES (1,1)) b(b,d) ON a=b AND c>d AND a+b<0;
----
false

query I
SELECT __mark_join_marker FROM (VALUES (NULL::INTEGER)) p(a) JOIN BY(TYPE MARK) (VALUES (NULL::INTEGER)) b(b) ON a IS NOT DISTINCT FROM b AND NULL::BOOLEAN;
----
NULL

# A later true candidate overrides an unknown candidate.
query I
SELECT __mark_join_marker FROM (VALUES (1,2)) p(a,c) JOIN BY(TYPE MARK) (VALUES (1,NULL::INTEGER),(1,0),(1,0)) b(b,d) ON a=b AND c>d AND a+b>0;
----
true

# Residual columns need not be output or appear in the comparison keys.
query I
WITH p(id,a,c,x) AS (VALUES (0,1,2,10),(1,1,NULL::INTEGER,20),(2,2,3,30)),
     b(b,d,y) AS (VALUES (1,1,0),(1,NULL::INTEGER,20),(1,1,0),(2,0,NULL::INTEGER)),
     actual AS (SELECT p.id,__mark_join_marker m FROM p JOIN BY(TYPE MARK) b ON a=b AND c>d AND x+y<25),
     expected AS (SELECT id,max(CASE WHEN a=b AND c>d AND x+y<25 THEN 2
                                    WHEN (a=b AND c>d AND x+y<25) IS NULL THEN 1 ELSE 0 END) m
                  FROM p CROSS JOIN b GROUP BY id)
SELECT count(*) FROM actual FULL JOIN expected USING(id)
WHERE actual.id IS NULL OR expected.id IS NULL
   OR CASE WHEN actual.m THEN 2 WHEN actual.m IS NULL THEN 1 ELSE 0 END <> expected.m;
----
0

endloop

statement ok
RESET debug_disable_optimizer;
