# name: test/sql/join/mark/hash_conjunction.test
# description: Mixed MARK comparisons retain hash execution and per-pair three-valued truth
# group: [mark]

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

statement ok
CREATE TABLE hash_probe AS SELECT i AS k, i AS v FROM range(20000) t(i);

statement ok
CREATE TABLE hash_build AS SELECT i AS k, i+1 AS v FROM range(20000) t(i);

query TT
EXPLAIN SELECT __mark_join_marker FROM hash_probe p JOIN BY (TYPE MARK) hash_build b ON p.k=b.k AND p.v<b.v;
----
physical_plan	<REGEX>:[\s\S]*HASH_JOIN[\s\S]*

# Repeat the probe to cover reuse; the plan assertion above protects hash routing.
query I
WITH q AS NOT MATERIALIZED (
    SELECT count(*) n FROM (
        SELECT __mark_join_marker m FROM hash_probe p JOIN BY (TYPE MARK) hash_build b ON p.k=b.k AND p.v<b.v
    ) markers WHERE m
), r AS NOT MATERIALIZED (FROM q UNION ALL FROM q UNION ALL FROM q UNION ALL FROM q),
s AS NOT MATERIALIZED (FROM r UNION ALL FROM r UNION ALL FROM r UNION ALL FROM r)
SELECT sum(n) FROM s;
----
320000

foreach external false true

statement ok
SET debug_force_external={external};

statement ok
CREATE OR REPLACE TABLE null_probe(id INTEGER, k INTEGER, v INTEGER);

statement ok
INSERT INTO null_probe VALUES (0,1,0),(1,2,0),(2,3,0),(3,NULL,20),(4,NULL,-1),(5,4,NULL),(6,9,0);

statement ok
CREATE OR REPLACE TABLE null_build(k INTEGER,v INTEGER);

statement ok
INSERT INTO null_build VALUES (1,NULL),(2,NULL),(2,1),(3,-1),(NULL,-1),(4,0);

# Unknown key matches, late TRUE, false residuals and NULL-key probes are distinct cases.
query II
SELECT id,__mark_join_marker FROM null_probe p JOIN BY (TYPE MARK) null_build b ON p.k=b.k AND p.v<b.v ORDER BY id;
----
0	NULL
1	true
2	false
3	NULL
4	NULL
5	NULL
6	false

statement ok
DELETE FROM null_build WHERE v IS NULL;

query II
SELECT id,__mark_join_marker FROM null_probe p JOIN BY (TYPE MARK) null_build b ON p.k=b.k AND p.v<b.v ORDER BY id;
----
0	false
1	true
2	false
3	false
4	NULL
5	NULL
6	false

# A NULL probe key needs non-NULL build rows, including rows in another hash partition.
query I
SELECT __mark_join_marker FROM (VALUES (NULL::BIGINT,-1)) p(k,v) JOIN BY (TYPE MARK) hash_build b ON p.k=b.k AND p.v<b.v;
----
NULL

# Unequal remaining hash keys suppress UNKNOWN from the NULL key.
query I
SELECT __mark_join_marker FROM (VALUES (NULL::INTEGER,7,0)) p(k,g,v) JOIN BY (TYPE MARK) (VALUES (1,8,1)) b(k,g,v) ON p.k=b.k AND p.g=b.g AND p.v<b.v;
----
false

# Nested NULLs are values in tuple equality.
query I
SELECT __mark_join_marker FROM (VALUES ((1,NULL),5)) p(k,v) JOIN BY (TYPE MARK) (VALUES ((1,2),6)) b(k,v) ON p.k=b.k AND p.v<b.v;
----
false

query I
SELECT __mark_join_marker FROM (VALUES ((1,2),5)) p(k,v) JOIN BY (TYPE MARK) (VALUES ((1,NULL),6)) b(k,v) ON p.k=b.k AND p.v<b.v;
----
false

query I
SELECT __mark_join_marker FROM (VALUES ((1,NULL),5)) p(k,v) JOIN BY (TYPE MARK) (VALUES ((2,2),6)) b(k,v) ON p.k=b.k AND p.v<b.v;
----
false

# Only NULL hash keys remain, so the normal hash table is empty.
statement ok
DELETE FROM null_build WHERE k IS NOT NULL;

query II
SELECT id,__mark_join_marker FROM null_probe p JOIN BY (TYPE MARK) null_build b ON p.k=b.k AND p.v<b.v ORDER BY id;
----
0	false
1	false
2	false
3	false
4	false
5	NULL
6	false

statement ok
DELETE FROM null_build;

query I
SELECT count(*) FROM (SELECT __mark_join_marker m FROM null_probe p JOIN BY (TYPE MARK) null_build b ON p.k=b.k AND p.v<b.v) q WHERE m IS NOT FALSE;
----
0

# An actually empty build must not evaluate probe keys, unlike an empty hash partition.
statement ok
CREATE OR REPLACE SEQUENCE empty_build_sequence;

query I
SELECT __mark_join_marker FROM range(2) p(i) JOIN BY (TYPE MARK) (SELECT i FROM range(12) b(i) WHERE random()<0) b ON nextval('empty_build_sequence')=b.i AND p.i<b.i;
----
false
false

query I
SELECT last_value FROM duckdb_sequences() WHERE sequence_name='empty_build_sequence';
----
NULL

query I
SELECT __mark_join_marker FROM range(2) p(i) JOIN BY (TYPE MARK) (SELECT i FROM range(12) b(i) WHERE random()<0) b ON CAST(error('probe evaluated') AS BIGINT)=b.i AND p.i<b.i;
----
false
false

endloop

statement ok
RESET debug_force_external;
