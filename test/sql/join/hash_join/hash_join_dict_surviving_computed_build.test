# name: test/sql/join/hash_join/hash_join_dict_surviving_computed_build.test
# description: Build columns that are computed on the build side are not narrowed by the dict-surviving hash join
# group: [hash_join]

statement ok
CREATE TABLE nation AS SELECT i AS nk, 'NATION_' || (i % 5) AS n_name FROM range(25) t(i);

statement ok
CREATE TABLE customer AS SELECT i * 1000 AS ck, i % 25 AS nk FROM range(10000) t(i);

statement ok
CREATE TABLE probe AS SELECT (i % 10000) * 1000 AS ck FROM range(100000) t(i);

# the CASE forwards the dictionary of n_name for some chunks, and produces flat vectors for others
query II
SELECT count(*), count(DISTINCT nm) FROM probe p JOIN (SELECT c.ck, CASE WHEN c.ck < 5000000 OR random() < 0 THEN n.n_name ELSE 'other' END AS nm FROM customer c JOIN nation n ON c.nk = n.nk) b ON p.ck = b.ck;
----
100000	6

query II
SELECT count(*), count(DISTINCT nm) FROM probe p JOIN (SELECT c.ck, n.n_name || '' AS nm FROM customer c JOIN nation n ON c.nk = n.nk) b ON p.ck = b.ck;
----
100000	5

statement ok
PRAGMA threads=1

query II
SELECT count(*), count(DISTINCT nm) FROM probe p JOIN (SELECT c.ck, CASE WHEN c.ck < 5000000 OR random() < 0 THEN n.n_name ELSE 'other' END AS nm FROM customer c JOIN nation n ON c.nk = n.nk) b ON p.ck = b.ck;
----
100000	6
