statement ok
SET disabled_optimizers = '';

# a probe over many row groups, with and without a runtime filter on its scan
foreach threads 1 8

statement ok
SET threads = {threads};

query I
SELECT k FROM small s SEMI JOIN many b ON s.k < b.k ORDER BY k;
----
9
10
10
11
500
1009
1010

query I
SELECT k FROM small s SEMI JOIN many b ON s.k >= b.k ORDER BY k;
----
9
10
10
11
500
1009
1010

query I
SELECT k FROM (SELECT k FROM small WHERE k < 11) s SEMI JOIN many b ON s.k > b.k ORDER BY k;
----
9
10
10

query I
SELECT k FROM (SELECT k + 998990 AS k FROM small) s SEMI JOIN many b ON s.k < b.k ORDER BY k;
----
998999
999000
999000
999001
999490

endloop

statement ok
RESET threads;

# a prepared statement plans the join once and runs it with fresh states
statement ok
PREPARE q AS SELECT k FROM small s SEMI JOIN big b ON s.k < b.k WHERE s.k > ? ORDER BY k;

query I
EXECUTE q(10);
----
11
500

query I
EXECUTE q(8);
----
9
10
10
11
500

query I
EXECUTE q(1000);
----

statement ok
DEALLOCATE q;

# a recursive CTE runs the join once per iteration, with the states of the previous one reset
query II
EXPLAIN WITH RECURSIVE t(i) AS (
	SELECT 0::INTEGER
	UNION ALL
	(WITH tmp AS (SELECT * FROM t)
	 SELECT i + 101 FROM tmp SEMI JOIN big b ON tmp.i + 100 < b.k)
) SELECT count(*), max(i) FROM t;
----
physical_plan	<REGEX>:(?s).*RIGHT_SEMI.*

query II
WITH RECURSIVE t(i) AS (
	SELECT 0::INTEGER
	UNION ALL
	(WITH tmp AS (SELECT * FROM t)
	 SELECT i + 101 FROM tmp SEMI JOIN big b ON tmp.i + 100 < b.k)
) SELECT count(*), max(i) FROM t;
----
10	909

query II
WITH RECURSIVE t(i) AS (
	SELECT 1005::INTEGER
	UNION ALL
	(WITH tmp AS (SELECT * FROM t),
	      above AS (SELECT count(*) AS c FROM small s SEMI JOIN big b ON s.k > b.k)
	 SELECT i + c::INTEGER FROM tmp, above WHERE i < 1013)
) SELECT count(*), max(i) FROM t;
----
3	1013

endloop
