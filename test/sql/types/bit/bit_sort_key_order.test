# name: test/sql/types/bit/bit_sort_key_order.test
# description: BIT values are ordered the same in sort keys, min/max N and ORDER BY
# group: [bit]

statement ok
CREATE TABLE b AS SELECT x::BIT x, i FROM (VALUES ('0',1),('1111111111111111111',2),('01',3),('1',4),('10',5)) v(x,i);

query I
SELECT list(i ORDER BY x) FROM b
----
[1, 3, 4, 5, 2]

query IIII
SELECT list(i ORDER BY {'x': x}), list(i ORDER BY [x]), list(i ORDER BY x DESC), list_sort(list(x))::VARCHAR FROM b
----
[1, 3, 4, 5, 2]	[1, 3, 4, 5, 2]	[2, 5, 4, 3, 1]	[0, 01, 1, 10, 1111111111111111111]

query IIII
SELECT max(x, 2), min(x, 2), arg_max(i, x, 2), arg_min(i, x, 2) FROM b
----
[1111111111111111111, 10]	[0, 01]	[2, 5]	[1, 3]

query II
SELECT max(x), min(x) FROM b
----
1111111111111111111	0

# sort keys can be decoded again
query I
SELECT list(x ORDER BY x)::VARCHAR FROM (SELECT x FROM b ORDER BY {'x': x}) t
----
[0, 01, 1, 10, 1111111111111111111]

query I
SELECT max(x, 5) FROM b
----
[1111111111111111111, 10, 1, 01, 0]
