# name: test/sql/types/decimal/decimal_exponent.test
# description: Test casting from varchar to decimal (exponents)
# group: [decimal]

# standard exponents
query IIII
SELECT '1e3'::DECIMAL, '1e-1'::DECIMAL, '.1e3'::DECIMAL, '0.1e3'::DECIMAL
----
1000.000	0.1	100.000	100.000

# negative numbers
query IIII
SELECT '-1e3'::DECIMAL, '-0.1e3'::DECIMAL, '-.1e-1'::DECIMAL, '-0.1e-1'::DECIMAL
----
-1000	-100	-0.01	-0.01

# zero
query IIII
SELECT '0e1'::DECIMAL, '-0e1'::DECIMAL, '00000e1'::DECIMAL, '-00000e1'::DECIMAL
----
0	0	0	0

# not enough precision: just truncated to 0
query I
SELECT '1e-100'::DECIMAL
----
0

# large negative exponent
query I
SELECT '1e-9999'::DECIMAL
----
0

# different decimal precisions
query I
SELECT '1E3'::DECIMAL(4,0)
----
1000

query I
SELECT '1e8'::DECIMAL(9,0)
----
100000000

query I
SELECT '1e17'::DECIMAL(18,0)
----
100000000000000000

query I
SELECT '1e37'::DECIMAL(38,0)
----
10000000000000000000000000000000000000

statement error
SELECT '1e4'::DECIMAL(4,0)
----
<REGEX>:Conversion Error.*Could not convert string.*

statement error
SELECT '1e9'::DECIMAL(9,0)
----
<REGEX>:Conversion Error.*Could not convert string.*

statement error
SELECT '1e18'::DECIMAL(18,0)
----
<REGEX>:Conversion Error.*Could not convert string.*

statement error
SELECT '1e38'::DECIMAL(38,0)
----
<REGEX>:Conversion Error.*Could not convert string.*

# overflow
statement error
SELECT '1e100'::DECIMAL
----
<REGEX>:Conversion Error.*Could not convert string.*

# multiple exponents
statement error
SELECT '1e100e100'::DECIMAL
----
<REGEX>:Conversion Error.*Could not convert string.*

# fractional exponent
statement error
SELECT '1e100.2'::DECIMAL
----
<REGEX>:Conversion Error.*Could not convert string.*

# very large exponents
statement error
SELECT '1e9999999999'::DECIMAL
----
<REGEX>:Conversion Error.*Could not convert string.*

statement error
SELECT '1e-9999999999'::DECIMAL
----
<REGEX>:Conversion Error.*Could not convert string.*

statement error
SELECT '1e-99999999999999999999999999999999'::DECIMAL
----
<REGEX>:Conversion Error.*Could not convert string.*

# not an exponent
statement error
SELECT '.1f3'::DECIMAL
----
<REGEX>:Conversion Error.*Could not convert string.*

statement error
SELECT '1f3'::DECIMAL
----
<REGEX>:Conversion Error.*Could not convert string.*

# large negative exponent with mantissa >= 5 should truncate to 0, not round up (issue #23768)
query I
SELECT '5.8207660913467407e-11'::DECIMAL(18,4)
----
0.0000

query I
SELECT '5.5e-11'::DECIMAL(18,4)
----
0.0000

query I
SELECT '4.9e-11'::DECIMAL(18,4)
----
0.0000

query I
SELECT '9.9e-11'::DECIMAL(18,4)
----
0.0000

query I
SELECT '5e-11'::DECIMAL(18,4)
----
0.0000

query I
SELECT '1e-10'::DECIMAL(18,4)
----
0.0000

# negative mantissa with large negative exponent
query I
SELECT '-5.5e-11'::DECIMAL(18,4)
----
0.0000

query I
SELECT '-9.9e-11'::DECIMAL(18,4)
----
0.0000

query I
SELECT '-5e-11'::DECIMAL(18,4)
----
0.0000

# large negative exponent with higher precision scale
query I
SELECT '5.5e-11'::DECIMAL(18,10)
----
0.0000000001

query I
SELECT '4.9e-11'::DECIMAL(18,10)
----
0.0000000000

query I
SELECT '5.5e-12'::DECIMAL(18,10)
----
0.0000000000

# rounding at the boundary: exponent close to scale should still round correctly
query I
SELECT '5e-4'::DECIMAL(18,4)
----
0.0005

query I
SELECT '5e-5'::DECIMAL(18,4)
----
0.0001

query I
SELECT '4.9e-5'::DECIMAL(18,4)
----
0.0000

query I
SELECT '5.5e-5'::DECIMAL(18,4)
----
0.0001

# default DECIMAL precision (18,3) with large negative exponent
query I
SELECT '5.5e-10'::DECIMAL
----
0.000

query I
SELECT '9.9e-10'::DECIMAL
----
0.000

# large negative exponent with varying DECIMAL scales
query I
SELECT '5.5e-6'::DECIMAL(18,6)
----
0.000006

query I
SELECT '5.5e-7'::DECIMAL(18,6)
----
0.000001

query I
SELECT '5.5e-8'::DECIMAL(18,6)
----
0.000000

# decimals that the exponent moves before the point count towards the width
query IIIII
SELECT '1.5e3'::DECIMAL(4,0), '-1.5e3'::DECIMAL(4,0), '1.25e3'::DECIMAL(5,1), '1.5e17'::DECIMAL(18,0), '9.9e37'::DECIMAL(38,0)
----
1500	-1500	1250.0	150000000000000000	99000000000000000000000000000000000000

statement error
SELECT '1.5e4'::DECIMAL(4,0)
----
<REGEX>:Conversion Error.*Could not convert string.*

statement error
SELECT '-1.5e4'::DECIMAL(4,0)
----
<REGEX>:Conversion Error.*Could not convert string.*

statement error
SELECT '1.25e4'::DECIMAL(5,1)
----
<REGEX>:Conversion Error.*Could not convert string.*

statement error
SELECT '1.5e9'::DECIMAL(9,0)
----
<REGEX>:Conversion Error.*Could not convert string.*

statement error
SELECT '1.5e18'::DECIMAL(18,0)
----
<REGEX>:Conversion Error.*Could not convert string.*

statement error
SELECT '1.0e38'::DECIMAL(38,0)
----
<REGEX>:Conversion Error.*Could not convert string.*

query II
SELECT TRY_CAST('1.0e38' AS DECIMAL(38,0)), TRY_CAST('-1.7e38' AS DECIMAL(38,0))
----
NULL	NULL

# the width, not the HUGEINT storage, limits the digits before the point
query III
SELECT '1.70141e36'::DECIMAL(38,1), '-1.70141e36'::DECIMAL(38,1), '9.99e17'::DECIMAL(19,1)
----
1701410000000000000000000000000000000.0	-1701410000000000000000000000000000000.0	999000000000000000.0

statement error
SELECT '1.70141e+37'::DECIMAL(38,1)
----
<REGEX>:Conversion Error.*Could not convert string.*

query III
SELECT TRY_CAST('1.70141e+37' AS DECIMAL(38,1)), TRY_CAST('-1.70141e+37' AS DECIMAL(38,1)),
	TRY_CAST('1.25e18' AS DECIMAL(19,1))
----
NULL	NULL	NULL

# zeros that the exponent moves before the point leave room for the integer digits
query IIII
SELECT '0.01e3'::DECIMAL(4,2), '-0.01e3'::DECIMAL(4,2), '0.01e7'::DECIMAL(9,3), '0.01e2'::DECIMAL(38,37)
----
10.00	-10.00	100000.000	1.0000000000000000000000000000000000000

# digits after leading zeros of the decimals are kept for the exponent
query III
SELECT '0.00019e1'::DECIMAL(4,4), '-0.00019e1'::DECIMAL(4,4),
	'0.00000000000000000000000000000000000012345e40'::DECIMAL(38,10)
----
.0019	-.0019	1234.5000000000

query II
SELECT ('0.' || repeat('0', 254) || '1e255')::DECIMAL(38,2), ('0.' || repeat('0', 256) || '5')::DECIMAL(18,3)
----
1.00	0.000

# the first decimal that does not fit the result rounds it
query IIII
SELECT '843.09e1'::DECIMAL(4,0), '-843.09e1'::DECIMAL(4,0), '843.049e1'::DECIMAL(4,0),
	'1.00000000000000000000000000000000000005e36'::DECIMAL(38,1)
----
8431	-8431	8430	1000000000000000000000000000000000000.1

query III
SELECT TRY_CAST('0.99995e1' AS DECIMAL(4,3)), TRY_CAST('0.099995e1' AS DECIMAL(4,4)),
	TRY_CAST('-0.099995e1' AS DECIMAL(4,4))
----
NULL	NULL	NULL
