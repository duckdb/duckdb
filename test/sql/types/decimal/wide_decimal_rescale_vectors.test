# name: test/sql/types/decimal/wide_decimal_rescale_vectors.test
# description: Wide decimal rescaling retains results across values and vectors
# group: [decimal]

statement ok
CREATE TABLE rescale_input AS
SELECT i, CASE WHEN i % 17 = 0 THEN NULL
               ELSE (CASE WHEN i % 2 = 0 THEN '-' ELSE '' END ||
                     '123456789012345678901234567890123456789' || i || '.0050') END v
FROM range(4103) t(i)

query I
SELECT count(*) FROM
  (SELECT i, CAST(CAST(v AS DECIMAL(60,4)) AS DECIMAL(60,2)) rounded FROM rescale_input) rescale_output
WHERE rounded::VARCHAR IS DISTINCT FROM
      CASE WHEN i % 17 = 0 THEN NULL ELSE
           CASE WHEN i % 2 = 0 THEN '-' ELSE '' END ||
           '123456789012345678901234567890123456789' || i || '.01' END
----
0

query I
SELECT count(*) FROM
  (SELECT i, CAST(CAST(v AS DECIMAL(60,4)) AS DECIMAL(70,8)) expanded FROM rescale_input) rescale_output
WHERE expanded::VARCHAR IS DISTINCT FROM
      CASE WHEN i % 17 = 0 THEN NULL ELSE
           CASE WHEN i % 2 = 0 THEN '-' ELSE '' END ||
           '123456789012345678901234567890123456789' || i || '.00500000' END
----
0

query I
SELECT count(*) FROM rescale_input
WHERE CAST(CAST(v AS DECIMAL(60,4)) AS DECIMAL(70,4)) IS DISTINCT FROM CAST(v AS DECIMAL(60,4))
----
0

query I
SELECT count(*) FROM rescale_input
WHERE TRY_CAST(CAST(v AS DECIMAL(60,4)) AS DECIMAL(39,2)) IS NOT NULL
----
0

query I
SELECT count(*) FROM
  (SELECT i, CAST(CAST(v AS DECIMAL(60,4)) AS DECIMAL(60,2)) rounded
   FROM rescale_input WHERE i % 7 <> 0 ORDER BY i DESC) s
JOIN
  (SELECT i, CAST(CAST(v AS DECIMAL(60,4)) AS DECIMAL(60,2)) rounded FROM rescale_input) o USING (i)
WHERE s.rounded IS DISTINCT FROM o.rounded
----
0

statement ok
DROP TABLE rescale_input
