# name: test/sql/types/decimal/decimal_case_coalesce_warning.test
# description: Warn when CASE or COALESCE type resolution reduces a decimal scale
# group: [decimal]

statement ok
SET enable_logging=true;

statement ok
SET warnings_as_errors=true;

# DECIMAL(38,0) and DECIMAL(38,20) need 58 digits, so the common type keeps the integer digits and drops the scale
statement error
SELECT COALESCE(NULL::DECIMAL(38,0), 1.5::DECIMAL(38,20));
----
<REGEX>:Invalid Input Error: Potential loss of decimal precision while resolving a COALESCE expression: type DECIMAL\(38,20\) is being cast to DECIMAL\(38,0\), reducing the scale from 20 to 0\..*

statement error
SELECT COALESCE(1.5::DECIMAL(38,20), NULL::DECIMAL(38,0));
----
<REGEX>:Invalid Input Error: Potential loss of decimal precision while resolving a COALESCE expression: type DECIMAL\(38,20\) is being cast to DECIMAL\(38,0\), reducing the scale from 20 to 0\..*

statement error
SELECT ifnull(NULL::DECIMAL(38,0), 1.5::DECIMAL(38,20));
----
<REGEX>:Invalid Input Error: Potential loss of decimal precision while resolving a COALESCE expression.*

statement error
SELECT CASE WHEN true THEN 1.5::DECIMAL(38,20) ELSE NULL::DECIMAL(38,0) END;
----
<REGEX>:Invalid Input Error: Potential loss of decimal precision while resolving a CASE expression: type DECIMAL\(38,20\) is being cast to DECIMAL\(38,0\), reducing the scale from 20 to 0\..*

statement error
SELECT CASE WHEN false THEN NULL::DECIMAL(38,0) ELSE 1.5::DECIMAL(38,20) END;
----
<REGEX>:Invalid Input Error: Potential loss of decimal precision while resolving a CASE expression: type DECIMAL\(38,20\) is being cast to DECIMAL\(38,0\), reducing the scale from 20 to 0\..*

# a partial reduction of the scale
statement error
SELECT COALESCE(NULL::DECIMAL(18,0), 1.5::DECIMAL(38,24));
----
<REGEX>:Invalid Input Error: Potential loss of decimal precision while resolving a COALESCE expression: type DECIMAL\(38,24\) is being cast to DECIMAL\(38,20\), reducing the scale from 24 to 20\..*

statement ok
CREATE TABLE decimals AS SELECT 1.5::DECIMAL(38,20) AS d, NULL::DECIMAL(38,0) AS n;

statement error
SELECT COALESCE(n, d) FROM decimals;
----
<REGEX>:Invalid Input Error: Potential loss of decimal precision while resolving a COALESCE expression.*

statement error
SELECT CASE WHEN d > 1 THEN d ELSE n END FROM decimals;
----
<REGEX>:Invalid Input Error: Potential loss of decimal precision while resolving a CASE expression.*

# a DECIMAL nested in a LIST, ARRAY, MAP or STRUCT
statement error
SELECT COALESCE(NULL::DECIMAL(38,0)[], [1.5::DECIMAL(38,20)]);
----
<REGEX>:Invalid Input Error: Potential loss of decimal precision while resolving a COALESCE expression: type DECIMAL\(38,20\)\[\] is being cast to DECIMAL\(38,0\)\[\], reducing the scale from 20 to 0\..*

statement error
SELECT COALESCE(NULL::DECIMAL(38,0)[2], [1.5::DECIMAL(38,20), 2.5::DECIMAL(38,20)]::DECIMAL(38,20)[2]);
----
<REGEX>:Invalid Input Error: Potential loss of decimal precision while resolving a COALESCE expression.*

statement error
SELECT COALESCE(NULL::MAP(VARCHAR, DECIMAL(38,0)), MAP {'a': 1.5::DECIMAL(38,20)});
----
<REGEX>:Invalid Input Error: Potential loss of decimal precision while resolving a COALESCE expression.*

statement error
SELECT CASE WHEN true THEN {'a': 1, 'b': 1.5::DECIMAL(38,20)} ELSE {'b': NULL::DECIMAL(38,0), 'a': 1} END;
----
<REGEX>:Invalid Input Error: Potential loss of decimal precision while resolving a CASE expression: type STRUCT\(a INTEGER, b DECIMAL\(38,20\)\) is being cast to .*, reducing the scale from 20 to 0\..*

statement error
SELECT CASE WHEN true THEN [{'a': [1.5::DECIMAL(38,20)]}] ELSE [{'a': [NULL::DECIMAL(38,0)]}] END;
----
<REGEX>:Invalid Input Error: Potential loss of decimal precision while resolving a CASE expression.*

statement error
SELECT COALESCE(NULL::TUPLE(INTEGER, DECIMAL(38,0)), row(1, 1.5::DECIMAL(38,20)));
----
<REGEX>:Invalid Input Error: Potential loss of decimal precision while resolving a COALESCE expression.*

statement error
SELECT COALESCE(NULL::DECIMAL(38,0)[1], [1.5::DECIMAL(38,20)]);
----
<REGEX>:Invalid Input Error: Potential loss of decimal precision while resolving a COALESCE expression: type DECIMAL\(38,20\)\[\] is being cast to DECIMAL\(38,0\)\[1\], reducing the scale from 20 to 0\..*

statement error
SELECT COALESCE(NULL::MAP(DECIMAL(38,0), INTEGER), MAP {1.5::DECIMAL(38,20): 1});
----
<REGEX>:Invalid Input Error: Potential loss of decimal precision while resolving a COALESCE expression.*

statement error
SELECT CASE WHEN true THEN {'A': 1.5::DECIMAL(38,20)} ELSE {'a': NULL::DECIMAL(38,0)} END;
----
<REGEX>:Invalid Input Error: Potential loss of decimal precision while resolving a CASE expression.*

statement error
SELECT CASE WHEN true THEN row(1.5::DECIMAL(38,20)) ELSE {'a': NULL::DECIMAL(38,0)} END;
----
<REGEX>:Invalid Input Error: Potential loss of decimal precision while resolving a CASE expression.*

statement error
SELECT CASE WHEN true THEN {'a': [1.5::DECIMAL(38,20)]} ELSE {'a': NULL::DECIMAL(38,0)[1]} END;
----
<REGEX>:Invalid Input Error: Potential loss of decimal precision while resolving a CASE expression.*

statement error
VALUES ([1.5::DECIMAL(38,20)]), (NULL::DECIMAL(38,0)[]);
----
<REGEX>:Invalid Input Error: Potential loss of decimal precision while resolving a VALUES column.*

# no warning when the common type keeps the scale
statement ok
SELECT COALESCE(NULL::DECIMAL(10,2), 1.5::DECIMAL(38,20));

statement ok
SELECT COALESCE(NULL, 1.5::DECIMAL(38,20));

statement ok
SELECT CASE WHEN true THEN 1.5::DECIMAL(10,2) ELSE 2::INTEGER END;

statement ok
SELECT CASE WHEN true THEN 1.5::DECIMAL(38,20) END;

statement ok
SELECT COALESCE(NULL::DECIMAL(10,2)[], [1.5::DECIMAL(38,20)]);

statement ok
SELECT CASE WHEN true THEN {'a': 1.5::DECIMAL(38,20)} ELSE {'b': NULL::DECIMAL(38,0)} END;

statement ok
SELECT 1.5::DECIMAL(38,20) IN (NULL::DECIMAL(38,0), 2::DECIMAL(38,0));

# the result does not change, and every expression warns once per query
statement ok
SET warnings_as_errors=false;

statement ok
CALL truncate_duckdb_logs();

query I
SELECT COALESCE(NULL::DECIMAL(38,0), 1.5::DECIMAL(38,20), 2.5::DECIMAL(38,20));
----
2

query I
SELECT count(*) > 0 AND count(*) = count(DISTINCT query_id)
FROM duckdb_logs
WHERE log_level = 'WARNING' AND message LIKE 'Potential loss of decimal precision while resolving a COALESCE expression%';
----
true

statement ok
CALL truncate_duckdb_logs();

query I
SELECT CASE WHEN true THEN 1.5::DECIMAL(38,20) WHEN false THEN 2.5::DECIMAL(38,20) ELSE NULL::DECIMAL(38,0) END;
----
2

query I
SELECT count(*) > 0 AND count(*) = count(DISTINCT query_id)
FROM duckdb_logs
WHERE log_level = 'WARNING' AND message LIKE 'Potential loss of decimal precision while resolving a CASE expression%';
----
true

statement ok
CALL truncate_duckdb_logs();

query II
SELECT COALESCE(NULL::DECIMAL(38,0), 1.5::DECIMAL(38,20)), COALESCE(NULL::DECIMAL(18,0), 1.5::DECIMAL(38,24));
----
2	1.50000000000000000000

query I
SELECT count(*) FILTER (WHERE message LIKE '%from 20 to 0%') = count(DISTINCT query_id)
       AND count(*) FILTER (WHERE message LIKE '%from 24 to 20%') = count(DISTINCT query_id)
       AND count(*) = 2 * count(DISTINCT query_id)
       AND count(*) > 0
FROM duckdb_logs
WHERE log_level = 'WARNING' AND message LIKE 'Potential loss of decimal precision while resolving a COALESCE expression%';
----
true

query I
SELECT COALESCE(NULL::DECIMAL(38,0)[], [1.5::DECIMAL(38,20)]);
----
[2]
