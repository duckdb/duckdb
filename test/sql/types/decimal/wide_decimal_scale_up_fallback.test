# name: test/sql/types/decimal/wide_decimal_scale_up_fallback.test
# description: fixed-width to wide DECIMAL scale-up, on both sides of the HUGEINT fast path
# group: [decimal]

statement ok
CREATE TABLE t AS SELECT (i % 21 - 10)::DECIMAL(4,0) AS d FROM range(5000) r(i);

query IIII
SELECT count(*), count(DISTINCT x), count(*) FILTER (x = y), count(*) FILTER (hash(x) = hash(y))
FROM (SELECT TRY_CAST(d AS DECIMAL(39,38)) x, TRY_CAST(d::VARCHAR AS DECIMAL(39,38)) y FROM t WHERE abs(d) < 10);
----
4523	19	4523	4523

query II
SELECT 1::DECIMAL(4,0)::DECIMAL(39,38), 9::DECIMAL(4,0)::DECIMAL(39,38)
----
1.00000000000000000000000000000000000000	9.00000000000000000000000000000000000000

query I
SELECT TRY_CAST(10::DECIMAL(4,0) AS DECIMAL(39,38))
----
NULL

statement error
SELECT 10::DECIMAL(4,0)::DECIMAL(39,38)
----
value is out of range
