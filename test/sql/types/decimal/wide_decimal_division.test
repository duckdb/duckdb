# name: test/sql/types/decimal/wide_decimal_division.test
# description: decimal_division with arguments or results wider than 38 digits
# group: [decimal]

# wide decimal columns need the latest storage version
statement ok
ATTACH ':memory:' AS wd (STORAGE_VERSION 'latest');

statement ok
USE wd;

# the divisions over columns below are also executed from a serialized plan
statement ok
SET debug_verify_serializer = true;

# the default result scale of two DECIMAL(18,2) needs 39 digits
# result_scale = max(6, 2+18+1) = 21, result_width = 18-2+2+21 = 39
query III
SELECT decimal_division(1.00::DECIMAL(18,2), 3.00::DECIMAL(18,2)),
       decimal_division(2.00::DECIMAL(18,2), 3.00::DECIMAL(18,2)),
       typeof(decimal_division(1.00::DECIMAL(18,2), 3.00::DECIMAL(18,2)));
----
0.333333333333333333333	0.666666666666666666667	DECIMAL(39,21)

# wide arguments, result_width = 40-0+0+2 = 42
query I
SELECT typeof(decimal_division(1::DECIMAL(40,0), 8::DECIMAL(40,0), 2));
----
DECIMAL(42,2)

# round half to even, like the fixed-size decimals
query IIII
SELECT decimal_division(1::DECIMAL(40,0), 8::DECIMAL(40,0), 2),
       decimal_division(3::DECIMAL(40,0), 8::DECIMAL(40,0), 2),
       decimal_division(5::DECIMAL(40,0), 8::DECIMAL(40,0), 2),
       decimal_division(7::DECIMAL(40,0), 8::DECIMAL(40,0), 2);
----
0.12	0.38	0.62	0.88

query IIII
SELECT decimal_division(-1::DECIMAL(40,0), 8::DECIMAL(40,0), 2),
       decimal_division(3::DECIMAL(40,0), -8::DECIMAL(40,0), 2),
       decimal_division(-5::DECIMAL(40,0), -8::DECIMAL(40,0), 2),
       decimal_division(-7::DECIMAL(40,0), 8::DECIMAL(40,0), 2);
----
-0.12	-0.38	0.62	-0.88

# a negative quotient that rounds to zero is zero
query III
SELECT decimal_division(-1::DECIMAL(40,0), 800::DECIMAL(40,0), 2),
       decimal_division(-1::DECIMAL(40,0), 800::DECIMAL(40,0), 2) = 0,
       decimal_division(1::DECIMAL(40,0), -800::DECIMAL(40,0), 2) = 0;
----
0.00	true	true

# a result scale below the scale of the dividend scales the divisor up
query II
SELECT decimal_division(12.34::DECIMAL(40,2), 3.5::DECIMAL(40,1), 0),
       typeof(decimal_division(12.34::DECIMAL(40,2), 3.5::DECIMAL(40,1), 0));
----
4	DECIMAL(39,0)

query IIII
SELECT decimal_division(2.5::DECIMAL(40,1), 1::DECIMAL(40,0), 0),
       decimal_division(3.5::DECIMAL(40,1), 1::DECIMAL(40,0), 0),
       decimal_division(-2.5::DECIMAL(40,1), 1::DECIMAL(40,0), 0),
       decimal_division(2.5::DECIMAL(40,1), -1::DECIMAL(40,0), 0);
----
2	4	-2	-2

# values beyond the fixed-size decimals
query II
SELECT decimal_division(('1' || repeat('0', 60))::DECIMAL(61,0), 3::DECIMAL(1,0), 2)::VARCHAR = repeat('3', 60) || '.33',
       typeof(decimal_division(('1' || repeat('0', 60))::DECIMAL(61,0), 3::DECIMAL(1,0), 2));
----
true	DECIMAL(63,2)

query I
SELECT decimal_division('123456789012345678901234567890123456789012345678.90'::DECIMAL(50,2),
                        '-1234567890123456789012345678901234567890.123'::DECIMAL(43,3), 10);
----
-100000000.0000000000

# the default result scale of wide arguments
# result_scale = max(6, 2+43+1) = 46, result_width = 50-2+3+46 = 97
query I
SELECT typeof(decimal_division('1'::DECIMAL(50,2), '3'::DECIMAL(43,3)));
----
DECIMAL(97,46)

query I
SELECT decimal_division('1'::DECIMAL(50,2), '3'::DECIMAL(43,3));
----
0.3333333333333333333333333333333333333333333333

# wide arguments with a fixed-size result
query II
SELECT decimal_division('0.25'::DECIMAL(41,40), '0.5'::DECIMAL(40,39), 3),
       typeof(decimal_division('0.25'::DECIMAL(41,40), '0.5'::DECIMAL(40,39), 3));
----
0.500	DECIMAL(43,3)

query II
SELECT decimal_division('0.25'::DECIMAL(41,40), 3::DECIMAL(1,0), 3),
       typeof(decimal_division('0.25'::DECIMAL(41,40), 3::DECIMAL(1,0), 3));
----
0.083	DECIMAL(4,3)

# integer arguments
query II
SELECT decimal_division(1::HUGEINT, 3::BIGINT), typeof(decimal_division(1::HUGEINT, 3::BIGINT));
----
0.33333333333333333333	DECIMAL(58,20)

# wide arguments from a column with a fixed-size result, in each physical type of the result
statement ok
CREATE TABLE w (a DECIMAL(41,40));

statement ok
INSERT INTO w VALUES ('0.25'), ('-0.25'), (NULL);

query IIIIIIII
SELECT decimal_division(a, 3::DECIMAL(1,0), 3) AS q16, typeof(q16),
       decimal_division(a, 3::DECIMAL(1,0), 8) AS q32, typeof(q32),
       decimal_division(a, 3::DECIMAL(1,0), 17) AS q64, typeof(q64),
       decimal_division(a, 3::DECIMAL(1,0), 30) AS q128, typeof(q128)
FROM w ORDER BY a DESC NULLS LAST;
----
0.083	DECIMAL(4,3)	0.08333333	DECIMAL(9,8)	0.08333333333333333	DECIMAL(18,17)	0.083333333333333333333333333333	DECIMAL(31,30)
-0.083	DECIMAL(4,3)	-0.08333333	DECIMAL(9,8)	-0.08333333333333333	DECIMAL(18,17)	-0.083333333333333333333333333333	DECIMAL(31,30)
NULL	DECIMAL(4,3)	NULL	DECIMAL(9,8)	NULL	DECIMAL(18,17)	NULL	DECIMAL(31,30)

# an uncast HUGEINT or UHUGEINT argument is bound as DECIMAL(38,0) as long as these types report 38 digits: a value of
# 39 digits fails the cast at execution. Once they report 39 digits (duckdb/duckdb#29340, which lands after this
# change) the argument is a DECIMAL(39,0) and these statements divide, which is to be pinned there
statement error
SELECT decimal_division(170141183460469231731687303715884105727::HUGEINT, 7);
----
<REGEX>:Conversion Error:.*Could not cast value 170141183460469231731687303715884105727 to DECIMAL\(38,0\).*

statement error
SELECT decimal_division(340282366920938463463374607431768211455::UHUGEINT, 7);
----
<REGEX>:Conversion Error:.*Could not cast value.*

# cast explicitly, the HUGEINT and UHUGEINT values of 39 digits divide as DECIMAL(39,0)
query II
SELECT decimal_division(170141183460469231731687303715884105727::HUGEINT::DECIMAL(39,0), 2::DECIMAL(1,0), 0),
       decimal_division(340282366920938463463374607431768211455::UHUGEINT::DECIMAL(39,0), 5::DECIMAL(1,0), 0);
----
85070591730234615865843651857942052864	68056473384187692692674921486353642291

# NULL arguments
query III
SELECT decimal_division(NULL::DECIMAL(40,0), 8::DECIMAL(40,0), 2),
       decimal_division(1::DECIMAL(40,0), NULL::DECIMAL(40,0), 2),
       decimal_division(1.00::DECIMAL(18,2), NULL::DECIMAL(18,2));
----
NULL	NULL	NULL

# division by zero raises an error
statement error
SELECT decimal_division(1::DECIMAL(40,0), 0::DECIMAL(40,0));
----
decimal_division: division by zero

statement error
SELECT decimal_division(1.00::DECIMAL(18,2), 0.00::DECIMAL(18,2));
----
decimal_division: division by zero

# rounding can carry into an additional integer digit that does not fit the result width
statement error
SELECT decimal_division((repeat('9', 39) || '.99')::DECIMAL(41,2), 0.1::DECIMAL(1,1), 0);
----
decimal_division: result out of range for result type

statement error
SELECT decimal_division('9.99'::DECIMAL(41,40), 0.1::DECIMAL(1,1), 0);
----
decimal_division: result out of range for result type

# the wide kernel computes the results of the fixed-size kernels, across the tiers of the arguments and the result
statement ok
CREATE TABLE vals AS
SELECT ((i * 7919) % 100003 - 50000)::BIGINT AS a, ((i * 104729) % 9973 - 4986)::BIGINT AS b
FROM range(5000) t(i);

statement ok
DELETE FROM vals WHERE b = 0;

statement ok
INSERT INTO vals VALUES (NULL, 3), (3, NULL), (5, 2), (-5, 2), (7, -2), (-7, -2), (0, 9);

statement ok
CREATE TABLE decimals AS
SELECT a::DECIMAL(12,0) AS a0, a::DECIMAL(12,4) AS a4, a::DECIMAL(40,0) AS wa0, a::DECIMAL(40,4) AS wa4,
       b::DECIMAL(6,0) AS b0, b::DECIMAL(9,2) AS b2, b::DECIMAL(40,0) AS wb0, b::DECIMAL(40,2) AS wb2
FROM vals;

query IIII
SELECT count(*), count(decimal_division(wa0, wb0, 9)),
       count(*) FILTER (WHERE decimal_division(a0, b0, 9)::VARCHAR IS DISTINCT FROM decimal_division(wa0, wb0, 9)::VARCHAR),
       count(*) FILTER (WHERE decimal_division(a0, b0, 0)::VARCHAR IS DISTINCT FROM decimal_division(wa0, wb0, 0)::VARCHAR)
FROM decimals;
----
5006	5004	0	0

# a fixed-size argument on either side
query IIII
SELECT count(*) FILTER (WHERE decimal_division(a4, b2, 7)::VARCHAR IS DISTINCT FROM decimal_division(wa4, b2, 7)::VARCHAR),
       count(*) FILTER (WHERE decimal_division(a4, b2, 7)::VARCHAR IS DISTINCT FROM decimal_division(a4, wb2, 7)::VARCHAR),
       count(*) FILTER (WHERE decimal_division(a4, b2, 7)::VARCHAR IS DISTINCT FROM decimal_division(wa4, wb2, 7)::VARCHAR),
       count(*) FILTER (WHERE decimal_division(a0, b2, 7)::VARCHAR IS DISTINCT FROM decimal_division(wa0, b2, 7)::VARCHAR)
FROM decimals;
----
0	0	0	0

# a scaled divisor
query III
SELECT count(*) FILTER (WHERE decimal_division(a4, b0, 1)::VARCHAR IS DISTINCT FROM decimal_division(wa4, wb0, 1)::VARCHAR),
       count(*) FILTER (WHERE decimal_division(a4, b0, 0)::VARCHAR IS DISTINCT FROM decimal_division(wa4, b0, 0)::VARCHAR),
       count(*) FILTER (WHERE decimal_division(a4, b2, 0)::VARCHAR IS DISTINCT FROM decimal_division(a4, wb2, 0)::VARCHAR)
FROM decimals;
----
0	0	0

# fixed-size arguments with a wide result: the quotient times the divisor is the dividend, up to the rounding
query II
SELECT typeof(decimal_division(a4, b2, 35)),
       count(*) FILTER (WHERE abs(decimal_division(a4, b2, 35) * b2 - a4) > 0.0000000000000000000000000001)
FROM decimals GROUP BY ALL;
----
DECIMAL(45,35)	0

query III
SELECT a0, b0, decimal_division(wa0, wb0, 3) FROM decimals WHERE a0 IS NULL OR b0 IS NULL OR abs(b0) = 2 OR a0 = 0 ORDER BY ALL;
----
-7	-2	3.500
-5	2	-2.500
0	9	0.000
3	NULL	NULL
5	2	2.500
7	-2	-3.500
37946	-2	-18973.000
NULL	3	NULL

statement error
SELECT decimal_division(wa0, wb0 - wb0) FROM decimals;
----
decimal_division: division by zero

# the result is bound within the width limit of the session, like the results of the other decimal operators
statement ok
SET max_decimal_width = 50;

# result_scale = max(6, 2+37+1) = 40, result_width = 38-2+2+40 = 78
statement error
SELECT decimal_division(3::decimal(38,2), 16384::decimal(37,2));
----
Division needs a DECIMAL of 78 digits, the maximum DECIMAL width is 50

# result_scale = max(6, 20+37+1) = 58
statement error
SELECT decimal_division(3::decimal(38,20), 16384::decimal(37,2));
----
<REGEX>:Out of Range Error:.*Needed scale 58.*Max scale is 50; could not perform an accurate division.*

statement error
SELECT decimal_division(1.0::DECIMAL(4,1), 3.0::DECIMAL(4,1), 51);
----
decimal_division: scale must be between 0 and 50, got 51

query II
SELECT decimal_division(1.0::DECIMAL(4,1), 3.0::DECIMAL(4,1), 46), typeof(decimal_division(1.0::DECIMAL(4,1), 3.0::DECIMAL(4,1), 46));
----
0.3333333333333333333333333333333333333333333333	DECIMAL(50,46)
