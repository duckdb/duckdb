# name: test/sql/types/time/time_beyond_day.test
# description: TIME and TIME_NS values cannot exceed 24:00:00
# group: [time]

statement error
SELECT make_time(23, 59, 60.5)
----
Time out of range

statement error
SELECT '24:00:00.000000001'::TIME_NS
----
time field value out of range

# a leap second is still accepted, as long as the time does not exceed 24:00:00
query IIII
SELECT make_time(23, 59, 60), make_time(12, 30, 60), '24:00:00'::TIME_NS, '23:59:59.999999999'::TIME_NS
----
24:00:00	12:31:00	24:00:00	23:59:59.999999999
