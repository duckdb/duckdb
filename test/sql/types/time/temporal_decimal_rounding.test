# name: test/sql/types/time/temporal_decimal_rounding.test
# description: Round discarded temporal decimal digits to microseconds or nanoseconds, ties to even
# group: [time]

statement ok
PRAGMA enable_verification

query I
SELECT ('2024-01-01 12:00:00.1234565'::VARCHAR)::TIMESTAMP::VARCHAR
----
2024-01-01 12:00:00.123456

query I
SELECT ('2024-01-01 12:00:00.1234575'::VARCHAR)::TIMESTAMP::VARCHAR
----
2024-01-01 12:00:00.123458

query I
SELECT ('2024-01-01 12:00:00.0001255'::VARCHAR)::TIMESTAMP::VARCHAR
----
2024-01-01 12:00:00.000126

query I
SELECT ('2024-01-01 12:00:00.1234565000000001'::VARCHAR)::TIMESTAMP::VARCHAR
----
2024-01-01 12:00:00.123457

query I
SELECT ('2024-01-01 12:00:00.1234564999999999'::VARCHAR)::TIMESTAMP::VARCHAR
----
2024-01-01 12:00:00.123456

query I
SELECT ('1969-12-31 23:59:59.9999995'::VARCHAR)::TIMESTAMP::VARCHAR
----
1970-01-01 00:00:00

query I
SELECT ('2024-12-31 23:59:59.9999995'::VARCHAR)::TIMESTAMP::VARCHAR
----
2025-01-01 00:00:00

query I
SELECT ('9999-12-31 23:59:59.9999995'::VARCHAR)::TIMESTAMP::VARCHAR
----
10000-01-01 00:00:00

query I
SELECT ('23:59:59.9999995'::VARCHAR)::TIME::VARCHAR
----
24:00:00

query I
SELECT ('12:00:00.0001255'::VARCHAR)::TIME::VARCHAR
----
12:00:00.000126

query I
SELECT ('2024-01-01 12:00:00.1234567885'::VARCHAR)::TIMESTAMP_NS::VARCHAR
----
2024-01-01 12:00:00.123456788

query I
SELECT ('2024-01-01 12:00:00.1234567895'::VARCHAR)::TIMESTAMP_NS::VARCHAR
----
2024-01-01 12:00:00.12345679

query I
SELECT ('2024-01-01 12:00:00.0000001255'::VARCHAR)::TIMESTAMP_NS::VARCHAR
----
2024-01-01 12:00:00.000000126

query I
SELECT ('1969-12-31 23:59:59.9999999995'::VARCHAR)::TIMESTAMP_NS::VARCHAR
----
1970-01-01 00:00:00

query I
SELECT ('23:59:59.9999999995'::VARCHAR)::TIME_NS::VARCHAR
----
24:00:00

query I
SELECT COUNT(*) FROM range(1000) t(i)
WHERE epoch_us((printf('2024-01-01 12:00:00.%06d5', i)::VARCHAR)::TIMESTAMP)
    - epoch_us(TIMESTAMP '2024-01-01 12:00:00') <> i + (i % 2)
----
0

query I
SELECT TRY_CAST('24:00:00.0000006'::VARCHAR AS TIME) IS NULL
----
true

query I
SELECT TRY_CAST('not-a-time'::VARCHAR AS TIME) IS NULL
----
true

require icu

statement ok
SET TimeZone='America/New_York'

query I
SELECT ('2024-01-01 12:00:00.1234575'::VARCHAR)::TIMESTAMPTZ::VARCHAR
----
2024-01-01 12:00:00.123458-05

query I
SELECT ('2024-01-01 12:00:00.1234575 America/New_York'::VARCHAR)::TIMESTAMPTZ::VARCHAR
----
2024-01-01 12:00:00.123458-05

query I
SELECT ('2024-01-01 12:00:00.1234575+09'::VARCHAR)::TIMESTAMPTZ::VARCHAR
----
2023-12-31 22:00:00.123458-05

query I
SELECT ('12:00:00.1234575-04'::VARCHAR)::TIMETZ::VARCHAR
----
12:00:00.123458-04

query I
SELECT ('23:59:59.9999995-04'::VARCHAR)::TIMETZ::VARCHAR
----
24:00:00-04

statement ok
COPY (SELECT '2024-01-01 12:00:00.0001255' AS ts, '2024-01-01 12:00:00.1234575 America/New_York' AS tstz,
             '23:59:59.9999995' AS tm, '23:59:59.9999995-04' AS tmtz,
             '2024-01-01 12:00:00.0000001255' AS tsns)
TO '__TEST_DIR__/temporal_decimal_rounding.csv' (FORMAT CSV, HEADER false)

statement ok
CREATE TABLE temporal_csv_rounding (ts TIMESTAMP, tstz TIMESTAMPTZ, tm TIME, tmtz TIMETZ, tsns TIMESTAMP_NS)

statement ok
COPY temporal_csv_rounding FROM '__TEST_DIR__/temporal_decimal_rounding.csv' (FORMAT CSV, HEADER false)

query IIIII
SELECT ts::VARCHAR, tstz::VARCHAR, tm::VARCHAR, tmtz::VARCHAR, tsns::VARCHAR FROM temporal_csv_rounding
----
2024-01-01 12:00:00.000126	2024-01-01 12:00:00.123458-05	24:00:00	24:00:00-04	2024-01-01 12:00:00.000000126
