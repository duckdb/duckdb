# name: test/sql/types/uhugeint/test_uhugeint_to_string.test
# description: Test formatting UHUGEINT values as strings around the chunk boundaries of the formatter
# group: [uhugeint]

query I
SELECT CAST(v AS VARCHAR) FROM (VALUES
	(0::UHUGEINT),
	(1::UHUGEINT),
	(9::UHUGEINT),
	(10::UHUGEINT),
	(18446744073709551615::UHUGEINT),
	(18446744073709551616::UHUGEINT),
	(9999999999999999999::UHUGEINT),
	(10000000000000000000::UHUGEINT),
	(50000000000000000007::UHUGEINT),
	(100000000000000000000::UHUGEINT),
	(100000000000000000000000000000000000000::UHUGEINT),
	(100000000000000000010000000000000000001::UHUGEINT),
	(340282366920938463463374607431768211455::UHUGEINT)
) t(v)
----
0
1
9
10
18446744073709551615
18446744073709551616
9999999999999999999
10000000000000000000
50000000000000000007
100000000000000000000
100000000000000000000000000000000000000
100000000000000000010000000000000000001
340282366920938463463374607431768211455

# the HUGEINT formatter is a separate implementation: both have to agree below 2^127
query I
SELECT count(*) FROM (
	SELECT r::UHUGEINT * m AS v
	FROM range(1, 2000) t(r), (VALUES
		(1::UHUGEINT),
		(10000000000000000000::UHUGEINT),
		(9999999999999999999::UHUGEINT),
		(CAST('1' || repeat('0', 34) AS UHUGEINT)),
		(CAST('1' || repeat('0', 33) AS UHUGEINT) + 7::UHUGEINT)
	) m(m)
) WHERE CAST(v AS VARCHAR) <> CAST(v::HUGEINT AS VARCHAR)
----
0

# formatting and parsing round-trip, also above 2^127
query I
SELECT count(*) FROM (
	SELECT 340282366920938463463374607431768211455::UHUGEINT - r::UHUGEINT * 10000000000000000000::UHUGEINT AS v
	FROM range(0, 5000) t(r)
) WHERE CAST(CAST(v AS VARCHAR) AS UHUGEINT) <> v
----
0

# Uhugeint::ToString and Hugeint::ToString are used in error messages
statement error
SELECT 340282366920938463463374607431768211455::UHUGEINT + 1::UHUGEINT
----
<REGEX>:.*340282366920938463463374607431768211455 \+ 1.*

statement error
SELECT (-170141183460469231731687303715884105727)::HUGEINT - 10::HUGEINT
----
<REGEX>:.*-170141183460469231731687303715884105727 - 10.*
