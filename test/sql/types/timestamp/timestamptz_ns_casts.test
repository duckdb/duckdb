# name: test/sql/types/timestamp/timestamptz_ns_casts.test
# description: Casts from TIMESTAMPTZ_NS to the millisecond and second timestamp types
# group: [timestamp]

statement ok
CREATE TABLE ts AS SELECT CAST('2020-01-02 03:04:05.123456789+00' AS TIMESTAMPTZ_NS) AS t
UNION ALL SELECT CAST('1969-12-31 23:59:59.123456789+00' AS TIMESTAMPTZ_NS)
UNION ALL SELECT NULL;

query TT
SELECT CAST(t AS TIMESTAMP_MS), CAST(t AS TIMESTAMP_S) FROM ts
----
2020-01-02 03:04:05.123	2020-01-02 03:04:05
1969-12-31 23:59:59.123	1969-12-31 23:59:59
NULL	NULL

query T
SELECT CAST('infinity'::TIMESTAMPTZ_NS AS TIMESTAMP_MS)
----
infinity

query T
SELECT CAST('-infinity'::TIMESTAMPTZ_NS AS TIMESTAMP_S)
----
-infinity
