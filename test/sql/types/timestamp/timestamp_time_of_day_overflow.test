# name: test/sql/types/timestamp/timestamp_time_of_day_overflow.test
# description: Test time of day extraction at the minimum timestamp
# group: [timestamp]

# The time of day used to be timestamp - days * MICROS_PER_DAY, and that
# product overflows int64_t on the first day of the TIMESTAMP range.
query II
SELECT make_timestamp(-9223372022400000000)::TIME, make_timestamp(-9223372022399999999)::TIME;
----
00:00:00	00:00:00.000001

# values below the minimum timestamp cannot be created
statement error
SELECT make_timestamp(-9223372036854775806)::TIME;
----
Timestamp microseconds out of range
