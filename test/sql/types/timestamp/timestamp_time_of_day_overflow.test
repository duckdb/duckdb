# name: test/sql/types/timestamp/timestamp_time_of_day_overflow.test
# description: Test time of day extraction at the ends of the timestamp range
# group: [timestamp]

# the first day of the range starts at midnight, below it no timestamp can be created
statement error
SELECT make_timestamp(-9223372036854775806)::TIME;
----
Conversion Error: Timestamp microseconds out of range: -9223372036854775806

query II
SELECT make_timestamp(-9223372022400000000)::TIME, make_timestamp(9223372036854775806)::TIME;
----
00:00:00	04:00:54.775806
