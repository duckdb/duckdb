# NestedLoopJoin
query II
SELECT * 
FROM issue14384 
INNER  JOIN  (
	SELECT  INTERVAL 1000 DAY AS col0 FROM issue14384) AS sub0  
	ON (issue14384.i < sub0.col0) 
WHERE (NOT (issue14384.i != issue14384.i))
ORDER BY ALL;
