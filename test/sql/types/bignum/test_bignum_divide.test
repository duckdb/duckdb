# name: test/sql/types/bignum/test_bignum_divide.test
# description: Test bignum integer division
# group: [bignum]

query I
SELECT 42::BIGNUM // 7::BIGNUM
----
6

query I
SELECT 43::BIGNUM // 7::BIGNUM
----
6

# integer division truncates towards zero, like the other integer types
query IIII
SELECT 7::BIGNUM // 2::BIGNUM, (-7)::BIGNUM // 2::BIGNUM, 7::BIGNUM // (-2)::BIGNUM, (-7)::BIGNUM // (-2)::BIGNUM
----
3	-3	-3	3

query IIII
SELECT 7 // 2, -7 // 2, 7 // -2, -7 // -2
----
3	-3	-3	3

# a smaller dividend gives zero
query II
SELECT 3::BIGNUM // 7::BIGNUM, (-3)::BIGNUM // 7::BIGNUM
----
0	0

query II
SELECT 0::BIGNUM // 7::BIGNUM, 0::BIGNUM // (-7)::BIGNUM
----
0	0

query II
SELECT 7::BIGNUM // 7::BIGNUM, 7::BIGNUM // (-7)::BIGNUM
----
1	-1

query II
SELECT NULL::BIGNUM // 7::BIGNUM, 7::BIGNUM // NULL::BIGNUM
----
NULL	NULL

# integers are implicitly cast to BIGNUM, the result stays a BIGNUM
query II
SELECT 15::BIGNUM // 3, typeof(15::BIGNUM // 3)
----
5	BIGNUM

# division by zero
statement error
SELECT 100::BIGNUM // 0::BIGNUM
----
<REGEX>:.*Division by zero.*

query I
SELECT TRY(100::BIGNUM // 0::BIGNUM)
----
NULL

statement ok
SET null_on_division_by_zero = true

query I
SELECT 100::BIGNUM // 0::BIGNUM
----
NULL

query II
SELECT a // b, a FROM (VALUES (1::BIGNUM, 0::BIGNUM), (10::BIGNUM, 3::BIGNUM), (NULL, 3::BIGNUM)) t(a, b) ORDER BY a NULLS FIRST
----
NULL	NULL
NULL	1
3	10

statement ok
SET null_on_division_by_zero = false

statement error
SELECT 100::BIGNUM // 0::BIGNUM
----
<REGEX>:.*Division by zero.*

# single-digit (< 2^32) divisors
query I
SELECT '121932631137021795226185032733622923332237463801111263526900'::BIGNUM // 1000000000::BIGNUM
----
121932631137021795226185032733622923332237463801111

# multi-digit divisors
query I
SELECT '121932631137021795226185032733622923332237463801111263526900'::BIGNUM // '987654321098765432109876543210'::BIGNUM
----
123456789012345678901234567890

query I
SELECT '121932631137021795226185032733622923332237463801111263526900'::BIGNUM // '123456789012345678901234567890'::BIGNUM
----
987654321098765432109876543210

query I
SELECT '121932631137021795226185032733622923332237463801111263526901'::BIGNUM // '123456789012345678901234567890'::BIGNUM
----
987654321098765432109876543210

query I
SELECT '-121932631137021795226185032733622923332237463801111263526901'::BIGNUM // '123456789012345678901234567890'::BIGNUM
----
-987654321098765432109876543210

query I
SELECT '987654321098765432109876543210'::BIGNUM // '123456789012345678901234567890'::BIGNUM
----
8

query I
SELECT '123456789012345678901234567890'::BIGNUM // '987654321098765432109876543210'::BIGNUM
----
0

query I
SELECT ('1' || repeat('0', 100))::BIGNUM // ('1' || repeat('0', 50))::BIGNUM
----
100000000000000000000000000000000000000000000000000

query I
SELECT '115792089237316195423570985008687907853269984665640564039457584007913129639936'::BIGNUM // '340282366920938463463374607431768211456'::BIGNUM
----
340282366920938463463374607431768211456

# divisor just over 2^64
query I
SELECT ('1606938044258990275541962092341162602522202993782792835301376'::BIGNUM + 12345::BIGNUM) // '18446744073709551617'::BIGNUM
----
87112285931760246641901533019663016919296

# adversarial base-2^32 digit patterns: a multiply-and-subtract step that borrows two units,
# and quotient digit estimates that are one too large and need the add-back step
query I
SELECT '1461501637330902918124456670229688798170805436416'::BIGNUM // '39614081294025656939896111103'::BIGNUM
----
36893488113059364897

query I
SELECT '1461501636990620551203518206757090818695739998208'::BIGNUM // '79228162495817593515539431425'::BIGNUM
----
18446744073709551615

query I
SELECT '170141183460469231713240559633584619521'::BIGNUM // '79228162477370849454714781695'::BIGNUM
----
2147483648

query I
SELECT '170141183579311475539977298253619134462'::BIGNUM // '39614081266355540837921718271'::BIGNUM
----
4294967297

query I
SELECT '340282366802096219701201473078307061761'::BIGNUM // '79228162505040965560984141823'::BIGNUM
----
4294967294

# 50! // 49! = 50
query I
WITH RECURSIVE fact(i, f) AS (
	SELECT 1, 1::BIGNUM
	UNION ALL
	SELECT i + 1, f * (i + 1)::BIGNUM FROM fact WHERE i < 50
)
SELECT (SELECT f FROM fact WHERE i = 50) // (SELECT f FROM fact WHERE i = 49)
----
50

# compare against HUGEINT arithmetic on a range of values that fit in a HUGEINT
query I
SELECT count(*)
FROM (
	SELECT (hash(i) % 2000000000000000000)::HUGEINT - 1000000000000000000 AS x,
	       (hash(i + 7) % 20000000000)::HUGEINT - 10000000000 AS y
	FROM range(2000) t(i)
)
WHERE y <> 0 AND x::BIGNUM // y::BIGNUM <> (x // y)::BIGNUM
----
0

query I
SELECT count(*)
FROM range(-50, 50) t(x), range(-50, 50) t2(y)
WHERE y <> 0 AND x::BIGNUM // y::BIGNUM <> (x // y)::BIGNUM
----
0

# verify the division identity a = (a // b) * b + (a % b) with |a % b| < |b| on large pseudo-random operands
statement ok
CREATE TABLE pairs AS
SELECT i,
       (CASE WHEN i % 3 = 0 THEN '-' ELSE '' END || hash(i)::VARCHAR || hash(i + 1000)::VARCHAR || substr(hash(i + 2000)::VARCHAR, 1, 1 + i % 20))::BIGNUM AS a,
       (CASE WHEN i % 5 = 0 THEN '-' ELSE '' END || substr(hash(i * 31)::VARCHAR || hash(i * 17)::VARCHAR, 1, 1 + i % 45))::BIGNUM AS b
FROM range(3000) t(i)
WHERE b <> 0;

query I
SELECT count(*) > 2900 FROM pairs
----
true

query I
SELECT count(*) FROM pairs WHERE (a // b) * b + (a % b) <> a
----
0

query I
SELECT count(*) FROM pairs WHERE NOT ((a % b) < (CASE WHEN b < 0 THEN -b ELSE b END) AND (a % b) > -(CASE WHEN b < 0 THEN -b ELSE b END))
----
0

# the quotient is negative exactly when the signs differ (and it is not zero)
query I
SELECT count(*) FROM pairs WHERE (a // b) <> 0 AND (((a // b) < 0) <> ((a < 0) <> (b < 0)))
----
0

# dividing by a value bigger than the dividend gives zero
query I
SELECT count(*) FROM pairs WHERE a // (a * 2::BIGNUM + 1::BIGNUM) <> 0
----
0

# (a * b) // b = a
query I
SELECT count(*) FROM pairs WHERE (a * b) // b <> a
----
0

# operands around powers of two hit the digit boundaries of the base-2^32 long division
statement ok
CREATE TABLE pow2 AS
WITH RECURSIVE p(k, v) AS (
	SELECT 0, 1::BIGNUM
	UNION ALL
	SELECT k + 1, v + v FROM p WHERE k < 260
)
SELECT k, v FROM p;

statement ok
CREATE TABLE edge AS
SELECT sign::BIGNUM * (a.v + da::BIGNUM) AS a, b.v + db::BIGNUM AS b
FROM pow2 a, pow2 b, range(-2, 3) t1(da), range(-2, 3) t2(db), (VALUES (-1), (1)) t3(sign)
WHERE a.k BETWEEN 60 AND 260 AND a.k % 7 = 0
  AND b.k BETWEEN 33 AND 200 AND b.k % 5 = 0;

query I
SELECT count(*) > 40000 FROM edge
----
true

query I
SELECT count(*) FROM edge WHERE (a // b) * b + (a % b) <> a
----
0

query I
SELECT count(*) FROM edge WHERE NOT ((a % b) < (CASE WHEN b < 0 THEN -b ELSE b END) AND (a % b) > -(CASE WHEN b < 0 THEN -b ELSE b END))
----
0

query I
SELECT count(*) FROM edge WHERE (a // b) <> 0 AND (((a // b) < 0) <> ((a < 0) <> (b < 0)))
----
0

# 2^k // 2^j = 2^(k-j)
query I
SELECT count(*)
FROM pow2 a, pow2 b, pow2 c
WHERE a.k >= b.k AND c.k = a.k - b.k AND a.v // b.v <> c.v
----
0

query I
SELECT count(*)
FROM pow2 a, pow2 b, pow2 c
WHERE a.k + b.k = c.k AND a.v * b.v <> c.v
----
0
