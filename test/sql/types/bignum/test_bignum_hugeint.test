# name: test/sql/types/bignum/test_bignum_hugeint.test
# description: Test bignum double
# group: [bignum]

query I
Select 85070591730234614260976917445211069672::BIGNUM ;
----
85070591730234614260976917445211069672

query I
Select (-85070591730234614260976917445211069672)::BIGNUM ;
----
-85070591730234614260976917445211069672

statement ok
create table t as select (10 * power(10,i))::hugeint as i from range (0,38) t(i)

query I
select distinct i::varchar == i::bignum::varchar FROM t;
----
true

query I
select distinct (-i)::varchar == (-i)::bignum::varchar FROM t;
----
true

query I
select distinct i::uhugeint::varchar == i::uhugeint::bignum::varchar FROM t;
----
true

# Check BIGNUM boundary values around 2^120, where the byte size calc used to round down
query I
select 1329227995784915872903807060280344576::hugeint::bignum
----
1329227995784915872903807060280344576

query I
select 1329227995784915872903807060280344577::hugeint::bignum
----
1329227995784915872903807060280344577

query I
select (1329227995784915872903807060280344576 + 182)::hugeint::bignum
----
1329227995784915872903807060280344758

query I
select (1329227995784915872903807060280344576 + 183)::hugeint::bignum
----
1329227995784915872903807060280344759

query I
select (-1329227995784915872903807060280344576)::hugeint::bignum
----
-1329227995784915872903807060280344576

query I
select 170141183460469231731687303715884105727::hugeint::bignum
----
170141183460469231731687303715884105727

