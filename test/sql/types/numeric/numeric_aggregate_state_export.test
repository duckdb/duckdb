# name: test/sql/types/numeric/numeric_aggregate_state_export.test
# description: The aggregate-state export verification leaves the NUMERIC aggregates as they are and still verifies the other aggregates of the query
# group: [numeric]

statement ok
CREATE TABLE input AS SELECT i AS value, i::NUMERIC AS n, i % 2 AS g FROM range(1, 11) t(i);

statement ok
SET debug_verify_aggregate_state_export = true;

# a NUMERIC aggregate next to a verified one, without and with groups
query IIII
SELECT sum(value), sum(n), max(n), avg(value) FROM input;
----
55	55	10	5.5

query IIIII
SELECT g, sum(value), sum(n), min(n), count(*) FROM input GROUP BY g ORDER BY g;
----
0	30	30	2	5
1	25	25	1	5

query III
SELECT g, first(n ORDER BY value DESC), string_agg(value, ',' ORDER BY value) FROM input GROUP BY g ORDER BY g;
----
0	10	2,4,6,8,10
1	9	1,3,5,7,9

# the other aggregates are still exported and finalized
query II
EXPLAIN SELECT sum(value), sum(n) FROM input;
----
physical_plan	<REGEX>:(?s).*finalize.*EXPORT_STATE.*

# a query of NUMERIC aggregates alone runs as it is
query II
SELECT sum(n), max(n) FROM input;
----
55	10

statement ok
RESET debug_verify_aggregate_state_export;
