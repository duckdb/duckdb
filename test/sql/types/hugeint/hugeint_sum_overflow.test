# name: test/sql/types/hugeint/hugeint_sum_overflow.test
# description: Test hugeint sum overflow
# group: [hugeint]

# Constant / single-stream overflow via AddNumber
statement error
SELECT SUM(170141183460469231731687303715884105727) FROM range(10);
----
Overflow

statement error
SELECT SUM(x) FROM (VALUES (170141183460469231731687303715884105727), (170141183460469231731687303715884105727)) t(x)
----
Overflow

statement error
SELECT AVG(170141183460469231731687303715884105727) FROM range(10);
----
Overflow

statement error
SELECT AVG(x) FROM (VALUES (170141183460469231731687303715884105727), (170141183460469231731687303715884105727)) t(x)
----
Overflow

# Combine-path overflow: two large partial aggregates joined via UNION ALL
statement error
SELECT SUM(x) FROM (
	SELECT 100000000000000000000000000000000000000::HUGEINT AS x
	UNION ALL
	SELECT 100000000000000000000000000000000000000::HUGEINT
) t;
----
Overflow

statement error
SELECT AVG(x) FROM (
	SELECT 100000000000000000000000000000000000000::HUGEINT AS x
	UNION ALL
	SELECT 100000000000000000000000000000000000000::HUGEINT
) t;
----
Overflow

# Combine without overflow (2 * 5e37 fits in hugeint)
query I
SELECT SUM(x) FROM (
	SELECT 50000000000000000000000000000000000000::HUGEINT AS x
	UNION ALL
	SELECT 50000000000000000000000000000000000000::HUGEINT
) t;
----
100000000000000000000000000000000000000
