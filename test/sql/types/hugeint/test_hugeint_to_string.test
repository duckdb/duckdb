# name: test/sql/types/hugeint/test_hugeint_to_string.test
# description: Test formatting HUGEINT and DECIMAL(38) values as strings around the chunk boundaries of the formatter
# group: [hugeint]

query I
SELECT CAST(v AS VARCHAR) FROM (VALUES
	('0'::HUGEINT),
	('1'::HUGEINT),
	('-1'::HUGEINT),
	('-9'::HUGEINT),
	('18446744073709551615'::HUGEINT),
	('-18446744073709551615'::HUGEINT),
	('18446744073709551616'::HUGEINT),
	('-18446744073709551616'::HUGEINT),
	('9999999999999999999'::HUGEINT),
	('-10000000000000000000'::HUGEINT),
	('-50000000000000000007'::HUGEINT),
	('100000000000000000010000000000000000001'::HUGEINT),
	('-100000000000000000010000000000000000001'::HUGEINT),
	('170141183460469231731687303715884105727'::HUGEINT),
	('-170141183460469231731687303715884105727'::HUGEINT),
	('-170141183460469231731687303715884105728'::HUGEINT)
) t(v)
----
0
1
-1
-9
18446744073709551615
-18446744073709551615
18446744073709551616
-18446744073709551616
9999999999999999999
-10000000000000000000
-50000000000000000007
100000000000000000010000000000000000001
-100000000000000000010000000000000000001
170141183460469231731687303715884105727
-170141183460469231731687303715884105727
-170141183460469231731687303715884105728

# reference: split the magnitude at 10^19 and format both halves as UBIGINT
query I
SELECT count(*) FROM (
	SELECT s * r::HUGEINT * m AS v
	FROM range(1, 2000) t(r), (VALUES (1::HUGEINT), (-1::HUGEINT)) sign(s), (VALUES
		(1::HUGEINT),
		(10000000000000000000::HUGEINT),
		(9999999999999999999::HUGEINT),
		(CAST('1' || repeat('0', 34) AS HUGEINT)),
		(CAST('1' || repeat('0', 33) AS HUGEINT) + 7::HUGEINT)
	) m(m)
) WHERE CAST(v AS VARCHAR) <> CASE WHEN v < 0 THEN '-' ELSE '' END || CASE
	WHEN abs(v) < 10000000000000000000::HUGEINT THEN CAST(abs(v)::UBIGINT AS VARCHAR)
	ELSE CAST((abs(v) // 10000000000000000000::HUGEINT)::UBIGINT AS VARCHAR) ||
		lpad(CAST((abs(v) % 10000000000000000000::HUGEINT)::UBIGINT AS VARCHAR), 19, '0')
	END
----
0

# formatting and parsing round-trip near the maximum and the minimum
query I
SELECT count(*) FROM (
	SELECT '170141183460469231731687303715884105727'::HUGEINT - r::HUGEINT * 10000000000000000000::HUGEINT AS v
	FROM range(0, 5000) t(r)
	UNION ALL
	SELECT '-170141183460469231731687303715884105728'::HUGEINT + r::HUGEINT * 10000000000000000000::HUGEINT AS v
	FROM range(0, 5000) t(r)
) WHERE CAST(CAST(v AS VARCHAR) AS HUGEINT) <> v
----
0

query I
SELECT * FROM (VALUES
	(CAST('12345678901234567890123.456789012345'::DECIMAL(38,15) AS VARCHAR)),
	(CAST('-99999999999999999999999999999999999999'::DECIMAL(38,0) AS VARCHAR)),
	(CAST('-9.9999999999999999999999999999999999999'::DECIMAL(38,37) AS VARCHAR)),
	(CAST('-1.5'::DECIMAL(38,10) AS VARCHAR)),
	(CAST('12345678.123456789012345678901234567890'::DECIMAL(38,30) AS VARCHAR)),
	(CAST('-12345678.000000000012345678901234567890'::DECIMAL(38,30) AS VARCHAR)),
	(CAST('1.000000000000000000000000000001'::DECIMAL(38,30) AS VARCHAR)),
	(CAST('0'::DECIMAL(38,10) AS VARCHAR)),
	(CAST('-0.5'::DECIMAL(38,10) AS VARCHAR)),
	(CAST('0.0000000001'::DECIMAL(38,10) AS VARCHAR)),
	(CAST('-0.12345678901234567890123456789012345678'::DECIMAL(38,38) AS VARCHAR)),
	(CAST('0.00000000000000000000000000000000000001'::DECIMAL(38,38) AS VARCHAR))
) t(v)
----
12345678901234567890123.456789012345000
-99999999999999999999999999999999999999
-9.9999999999999999999999999999999999999
-1.5000000000
12345678.123456789012345678901234567890
-12345678.000000000012345678901234567890
1.000000000000000000000000000001
0.0000000000
-0.5000000000
0.0000000001
-.12345678901234567890123456789012345678
.00000000000000000000000000000000000001

# Hugeint::ToString is used in error messages
statement error
SELECT (-170141183460469231731687303715884105727)::HUGEINT - 10::HUGEINT
----
<REGEX>:.*-170141183460469231731687303715884105727 - 10.*

statement error
SELECT 170141183460469231731687303715884105727::HUGEINT + 1::HUGEINT
----
<REGEX>:.*\(170141183460469231731687303715884105727 \+ 1\).*

# the minimum HUGEINT cannot be negated as a HUGEINT
statement error
SELECT ((-170141183460469231731687303715884105727)::HUGEINT - 1::HUGEINT) - 1::HUGEINT
----
<REGEX>:.*\(-170141183460469231731687303715884105728 - 1\).*
