# name: test/sql/types/union/union_validity.test
# group: [union]

statement ok
CREATE TABLE tbl (u UNION(a INT, b VARCHAR));

statement ok
INSERT INTO tbl VALUES (1), (NULL), (NULL::VARCHAR), (NULL::INT);

statement ok
DELETE FROM tbl

statement ok
INSERT INTO tbl VALUES (1), (NULL), (NULL::VARCHAR), (NULL::INT);

query II rowsort
SELECT union_tag(u) as tag, u as val FROM tbl;
----
NULL	NULL
a	1
a	NULL
b	NULL



# a union whose selected member is NULL casts to a SQL NULL, not the string 'NULL' (#27509)
query II rowsort
SELECT u::VARCHAR IS NULL, length(u::VARCHAR) FROM tbl;
----
false	1
true	NULL
true	NULL
true	NULL
