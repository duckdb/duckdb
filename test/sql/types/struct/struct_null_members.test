statement ok
CREATE TABLE nested_values(id INTEGER, value STRUCT(child STRUCT(i INTEGER)));

statement ok
INSERT INTO nested_values VALUES
	(1, {'child': {'i': 1}}),
	(2, {'child': {'i': 2}}),
	(3, {'child': NULL});


loop nlj 0 2

# Less or equal
query IT
SELECT id, value <= value FROM nested_values ORDER BY id;
----
1	true
2	true
3	true

query I
SELECT lhs.id * 10 + rhs.id
FROM nested_values lhs
JOIN nested_values rhs ON lhs.value <= rhs.value
ORDER BY ALL;
----
11
12
13
22
23
33

# Less
query IT
SELECT id, value < value FROM nested_values ORDER BY id;
----
1	false
2	false
3	false

query I
SELECT lhs.id * 10 + rhs.id
FROM nested_values lhs
JOIN nested_values rhs ON lhs.value < rhs.value
ORDER BY ALL;
----
12
13
23

# Greater or equal
query IT
SELECT id, value >= value FROM nested_values ORDER BY id;
----
1	true
2	true
3	true

query I
SELECT lhs.id * 10 + rhs.id
FROM nested_values lhs
JOIN nested_values rhs ON lhs.value >= rhs.value
ORDER BY ALL;
----
11
21
22
31
32
33

# Greater 
query IT
SELECT id, value > value FROM nested_values ORDER BY id;
----
1	false
2	false
3	false

query I
SELECT lhs.id * 10 + rhs.id
FROM nested_values lhs
JOIN nested_values rhs ON lhs.value > rhs.value
ORDER BY ALL;
----
21
31
32

# Not equals
query IT
SELECT id, value <> value FROM nested_values ORDER BY id;
----
1	false
2	false
3	false

query I
SELECT lhs.id * 10 + rhs.id
FROM nested_values lhs
JOIN nested_values rhs ON lhs.value <> rhs.value
ORDER BY ALL;
----
12
13
21
23
31
32

# Equals
query IT
SELECT id, value = value FROM nested_values ORDER BY id;
----
1	true
2	true
3	true

query I
SELECT lhs.id * 10 + rhs.id
FROM nested_values lhs
JOIN nested_values rhs ON lhs.value = rhs.value
ORDER BY ALL;
----
11
22
33

statement ok 
set merge_join_threshold=0;

endloop
