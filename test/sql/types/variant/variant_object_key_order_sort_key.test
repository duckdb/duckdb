# name: test/sql/types/variant/variant_object_key_order_sort_key.test
# description: Functions that rely on the sort key treat objects with a different stored key order as equal
# group: [variant]

# TODO: "Force storage" will use default storage version, but variant requires v1.5.0, so skip for now
require no_force_storage

require json

statement ok
CREATE TABLE objects AS
SELECT 1 AS id, '{"c":1,"b":2}'::JSON::VARIANT AS v
UNION ALL SELECT 2, {'b': 2::UBIGINT, 'c': 1::UBIGINT}::VARIANT
UNION ALL SELECT 3, '{"b":2,"c":1}'::JSON::VARIANT
UNION ALL SELECT 4, {'c': 1::UBIGINT, 'b': 2::UBIGINT}::VARIANT;

query I
SELECT count(DISTINCT create_sort_key(v, 'ASC NULLS LAST')) FROM objects;
----
1

query I
SELECT len(list_distinct(list(v))) FROM objects;
----
1

query I
SELECT list_unique(list(v)) FROM objects;
----
1

query I
SELECT len(list_intersect([x.v], [y.v])) FROM objects x, objects y WHERE x.id = 1 ORDER BY y.id;
----
1
1
1
1

query I
SELECT element_at(MAP {x.v: 1}, y.v) FROM objects x, objects y WHERE x.id = 1 ORDER BY y.id;
----
[1]
[1]
[1]
[1]

# nested in other types
query I
SELECT count(DISTINCT create_sort_key([v], 'ASC NULLS LAST')) FROM objects;
----
1

query I
SELECT count(DISTINCT create_sort_key({'x': v}, 'ASC NULLS LAST')) FROM objects;
----
1

# the distinct value is decoded from its key
query I
SELECT list_distinct(list(v))::VARCHAR FROM objects;
----
[{'b': 2, 'c': 1}]
