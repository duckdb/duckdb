# name: test/sql/types/variant/variant_stats_merge_constant.test
# description: Statistics of a VARIANT constant merged with a shredded VARIANT column
# group: [variant]

statement ok
ATTACH '{TEST_DIR}/variant_stats_merge_constant.db' AS d

statement ok
USE d

statement ok
SET variant_minimum_shredding_size = 0

statement ok
CREATE TABLE t(i INTEGER, v VARIANT)

statement ok
INSERT INTO t SELECT i, {'b': 100}::VARIANT FROM range(4096) r(i)

statement ok
CHECKPOINT d

# a non-NULL constant is not shredded, so the merge has no min/max for b
query I
SELECT stats(CASE WHEN i = 0 THEN {'b': 1}::VARIANT ELSE v END).shredding_state FROM t LIMIT 1
----
INCONSISTENT

query I
SELECT count(*) FROM t WHERE TRY_CAST((CASE WHEN i = 0 THEN {'b': 1}::VARIANT ELSE v END).b AS INTEGER) < 50
----
1

query I
SELECT (CASE WHEN i = 0 THEN {'b': 1}::VARIANT ELSE v END).b::INTEGER AS x FROM t GROUP BY x ORDER BY x
----
1
100

# a NULL constant keeps the column's shredded stats
query IIII
SELECT s.shredding_state, s.fully_shredded.b.type, s.fully_shredded.b.stats.min, s.fully_shredded.b.stats.max
FROM (SELECT stats(CASE WHEN i = 0 THEN NULL ELSE v END) s FROM t LIMIT 1)
----
SHREDDED	INTEGER	100	100
