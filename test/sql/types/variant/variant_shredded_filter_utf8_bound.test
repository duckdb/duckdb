# name: test/sql/types/variant/variant_shredded_filter_utf8_bound.test
# description: A filter over shredded VARIANT strings whose statistics upper bound pads a truncated character
# group: [variant]

load __TEST_DIR__/shredded_bound.db

statement ok
SET variant_minimum_shredding_size = 0;

statement ok
SET force_variant_shredding = 'VARCHAR';

statement ok
CREATE TABLE s (col VARIANT);

# the strings truncate inside a four byte character, so the bound fills it past the Unicode range
statement ok
INSERT INTO s SELECT ('aaaaaaaaaaa' || chr((1048576 + i)::INTEGER))::VARIANT FROM range(3) t(i);

statement ok
CHECKPOINT;

query I
SELECT count(*) FROM s WHERE col > 'a'::VARIANT;
----
3
