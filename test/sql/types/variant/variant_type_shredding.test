# name: test/sql/types/variant/variant_type_shredding.test
# description: TYPE values in a VARIANT column are never shredded
# group: [variant]

load {TEST_DIR}/variant_type_shredding.db

statement ok
SET variant_minimum_shredding_size = 0;

statement ok
CREATE TABLE t AS
SELECT CASE WHEN i = 0 THEN NULL WHEN i = 1 THEN 42::VARIANT ELSE make_type('INTEGER')::VARIANT END v
FROM range(3002) t(i);

statement ok
CHECKPOINT;

restart

# the column shreds on the INTEGER and keeps the TYPE values unshredded
query II
SELECT s.shredding_state, s.partially_shredded.type FROM (SELECT stats(v) s FROM t LIMIT 1);
----
SHREDDED	INTEGER

query II
SELECT v::VARCHAR, count(*) FROM t GROUP BY ALL ORDER BY ALL
----
42	1
INTEGER	3000
NULL	1
