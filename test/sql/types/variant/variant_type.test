# name: test/sql/types/variant/variant_type.test
# description: VARIANT holds TYPE values
# group: [variant]

load {TEST_DIR}/variant_type.db

query III
SELECT v, variant_typeof(v), v::TYPE FROM (SELECT make_type('INTEGER')::VARIANT v)
----
INTEGER	TYPE	INTEGER

# the type survives the round trip, nested types included
query II
SELECT v::TYPE = t, v::VARCHAR FROM (SELECT t, t::VARIANT v FROM (VALUES
	(make_type('INTEGER')),
	(get_type(1.5::DECIMAL(18, 3))),
	(get_type({'a': 1, 'b': ['x']})),
	(get_type(MAP {'k': 1.5::DOUBLE})),
	(get_type(union_value(i := 1)::UNION(i INTEGER, s VARCHAR)))) t(t))
----
true	INTEGER
true	DECIMAL(18,3)
true	STRUCT(a INTEGER, b VARCHAR[])
true	MAP(VARCHAR, DOUBLE)
true	UNION(i INTEGER, s VARCHAR)

# NULLs stay NULL
query II
SELECT CAST(v AS VARIANT), TRY_CAST(v AS VARIANT) FROM (VALUES (NULL::TYPE), (make_type('VARCHAR'))) t(v)
----
NULL	NULL
VARCHAR	VARCHAR

query I
SELECT CAST(CASE WHEN i > 10 THEN make_type('INTEGER') ELSE NULL END AS VARIANT) FROM range(3) t(i)
----
NULL
NULL
NULL

# TYPE values inside nested values
query II
SELECT v, variant_typeof(v) FROM (SELECT [make_type('INTEGER'), NULL, make_type('VARCHAR')]::VARIANT v)
----
[INTEGER, NULL, VARCHAR]	ARRAY(3)

query II
SELECT v, v.t::TYPE FROM (SELECT {'filename': 'f.csv', 't': make_type('BIGINT')}::VARIANT v)
----
{'filename': f.csv, 't': BIGINT}	BIGINT

query I
SELECT CAST(union_value(t := make_type('INTEGER'))::UNION(i INTEGER, t TYPE) AS VARIANT)
----
INTEGER

query I
SELECT CAST(union_value(t := make_type('INTEGER'))::UNION(i INTEGER, t TYPE) AS UNION(i BIGINT, t VARIANT))
----
INTEGER

# TYPE values can not be cast to other types
statement error
SELECT make_type('INTEGER')::VARIANT::INTEGER
----
Conversion Error

query I
SELECT TRY_CAST(make_type('INTEGER')::VARIANT AS INTEGER)
----
NULL

statement error
SELECT 42::VARIANT::TYPE
----
Conversion Error

# comparisons
query III
SELECT make_type('INTEGER')::VARIANT = make_type('INTEGER')::VARIANT,
       make_type('INTEGER')::VARIANT = make_type('BIGINT')::VARIANT,
       make_type('INTEGER')::VARIANT = 'INTEGER'::VARIANT
----
true	false	false

query I
SELECT count(DISTINCT v) FROM (VALUES (make_type('INTEGER')::VARIANT), (make_type('BIGINT')::VARIANT), (make_type('INTEGER')::VARIANT)) t(v)
----
2

query I
SELECT variant_contains([make_type('INTEGER'), make_type('VARCHAR')]::VARIANT, [make_type('VARCHAR')]::VARIANT)
----
true

# storage - see variant_type_shredding.test for how the column is shredded
statement ok
SET variant_minimum_shredding_size = 0;

statement ok
CREATE TABLE t(v VARIANT);

statement ok
INSERT INTO t SELECT (CASE WHEN i % 2 = 0 THEN make_type('INTEGER') ELSE get_type(['x']) END)::VARIANT FROM range(3000) t(i);

statement ok
INSERT INTO t VALUES (NULL), (42), ({'t': make_type('DOUBLE')});

statement ok
CHECKPOINT;

restart

query II
SELECT v::VARCHAR, count(*) FROM t GROUP BY ALL ORDER BY ALL
----
42	1
INTEGER	1500
VARCHAR[]	1500
{'t': DOUBLE}	1
NULL	1

query I
SELECT count(*) FROM t WHERE TRY_CAST(v AS TYPE) = get_type(['x'])
----
1500

# a column of only TYPE values
statement ok
SET variant_minimum_shredding_size = 0;

statement ok
CREATE TABLE only_types AS SELECT (CASE WHEN i % 100 = 0 THEN NULL ELSE make_type('DATE') END)::VARIANT v FROM range(3000) t(i);

statement ok
CHECKPOINT;

restart

query III
SELECT count(*), count(v), count(*) FILTER (WHERE v::TYPE = make_type('DATE')) FROM only_types
----
3000	2970	2970

require json

query I
SELECT {'t': get_type([1])}::VARIANT::JSON
----
{"t":"INTEGER[]"}

# Parquet VARIANT has no TYPE
require parquet

statement error
COPY (SELECT make_type('INTEGER')::VARIANT v) TO '{TEMP_DIR}/variant_type.parquet'
----
Can't convert VARIANT of type 'TYPE' to Parquet VARIANT
