# name: test/sql/connect/connect_duplicate_column_names.test
# description: Duplicate column names in a query forwarded over CONNECT
# group: [connect]

require quack

require httpfs

statement ok
CALL quack_serve(token='test_token');

statement ok
ATTACH 'quack:localhost' AS qk (TOKEN 'test_token');

statement ok
CONNECT qk;

# the forwarded query is bound as a table function, and a binding cannot hold duplicate names
statement error
SELECT 2 AS x, 3 AS x;
----
<REGEX>:Binder Error:.*duplicate column name.*

statement ok
DISCONNECT;

# the very same query binds locally
query II
SELECT 2 AS x, 3 AS x;
----
2	3
