# name: test/sql/settings/setting_preserve_identifier_case.test
# description: Test preserve_identifier_case setting
# group: [settings]

query I
SELECT value FROM duckdb_settings() WHERE name='preserve_identifier_case'
----
on

# 'on' preserves the case as written
statement ok
CREATE SCHEMA MySchema;

statement ok
CREATE TABLE MySchema.Integers(I INTEGER);

query III
SELECT duckdb_tables.schema_name, duckdb_tables.table_name, column_name FROM duckdb_tables JOIN duckdb_columns USING (table_oid);
----
MySchema	Integers	I

statement ok
DROP SCHEMA MySchema CASCADE

# 'lowercase' lowercases non-quoted identifiers
statement ok
SET preserve_identifier_case TO 'lowercase';

query I
SELECT value FROM duckdb_settings() WHERE name='preserve_identifier_case'
----
lowercase

statement ok
CREATE SCHEMA MySchema;

statement ok
CREATE TABLE MySchema.Integers(I INTEGER);

query III
SELECT duckdb_tables.schema_name, duckdb_tables.table_name, column_name FROM duckdb_tables JOIN duckdb_columns USING (table_oid);
----
myschema	integers	i

statement ok
DROP SCHEMA myschema CASCADE

# 'uppercase' uppercases non-quoted identifiers
statement ok
SET preserve_identifier_case TO 'uppercase';

statement ok
CREATE SCHEMA MySchema;

statement ok
CREATE TABLE MySchema.Integers(I INTEGER);

query III
SELECT duckdb_tables.schema_name, duckdb_tables.table_name, column_name FROM duckdb_tables JOIN duckdb_columns USING (table_oid);
----
MYSCHEMA	INTEGERS	I

statement ok
DROP SCHEMA MYSCHEMA CASCADE

# quoted identifiers are preserved exactly regardless of the mode
statement ok
CREATE TABLE "QuotedName"("MixedCol" INTEGER);

query II
SELECT duckdb_tables.table_name, column_name FROM duckdb_tables JOIN duckdb_columns USING (table_oid);
----
QuotedName	MixedCol

statement ok
DROP TABLE "QuotedName"

# string literals are not folded
query I
SELECT 'MyString';
----
MyString

# the boolean spellings are still accepted for backwards compatibility
statement ok
SET preserve_identifier_case TO true;

statement ok
CREATE TABLE MyTable(i INTEGER);

query I
SELECT table_name FROM duckdb_tables;
----
MyTable

statement ok
DROP TABLE MyTable

statement ok
SET preserve_identifier_case TO false;

statement ok
CREATE TABLE MyTable(i INTEGER);

query I
SELECT table_name FROM duckdb_tables;
----
mytable

statement ok
DROP TABLE mytable

# every spelling the BOOLEAN cast accepts still works, not just true/false
foreach truthy 1 't' 'yes' 'y' 'TRUE'

statement ok
SET preserve_identifier_case TO {truthy};

statement ok
CREATE TABLE MyTable(i INTEGER);

query I
SELECT table_name FROM duckdb_tables;
----
MyTable

statement ok
DROP TABLE MyTable

endloop

foreach falsy 0 'f' 'no' 'n' 'FALSE'

statement ok
SET preserve_identifier_case TO {falsy};

statement ok
CREATE TABLE MyTable(i INTEGER);

query I
SELECT table_name FROM duckdb_tables;
----
mytable

statement ok
DROP TABLE mytable

endloop

# the 'preserve'/'lower'/'upper' aliases are accepted as well
statement ok
SET preserve_identifier_case TO 'upper';

statement ok
CREATE TABLE MyTable(i INTEGER);

query I
SELECT table_name FROM duckdb_tables;
----
MYTABLE

statement ok
DROP TABLE MYTABLE

statement ok
SET preserve_identifier_case TO 'preserve';

statement ok
CREATE TABLE MyTable(i INTEGER);

query I
SELECT table_name FROM duckdb_tables;
----
MyTable

statement ok
DROP TABLE MyTable

# RESET restores the default
statement ok
SET preserve_identifier_case TO 'uppercase';

statement ok
RESET preserve_identifier_case;

query I
SELECT value FROM duckdb_settings() WHERE name='preserve_identifier_case'
----
on

statement error
SET preserve_identifier_case TO 'bogus';
----
<REGEX>:.*Unrecognized parameter for option preserve_identifier_case "bogus", expected one of: on, lowercase, uppercase.*

statement error
SET preserve_identifier_case TO NULL;
----
<REGEX>:.*preserve_identifier_case setting cannot be NULL.*
