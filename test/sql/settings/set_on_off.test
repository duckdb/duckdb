# name: test/sql/settings/set_on_off.test
# description: Settings can be set to ON and OFF, like in Postgres
# group: [settings]

statement ok
SET enable_progress_bar = on

query I
SELECT current_setting('enable_progress_bar')
----
true

statement ok
SET enable_progress_bar TO OFF

query I
SELECT current_setting('enable_progress_bar')
----
false

statement ok
SET SESSION enable_progress_bar = ON

query I
SELECT current_setting('enable_progress_bar')
----
true

# Other values get the text, like for any other bare word
statement ok
SET VARIABLE my_var = on

query I
SELECT getvariable('my_var')
----
on

statement ok
SET VARIABLE my_var = off

query I
SELECT getvariable('my_var')
----
off
