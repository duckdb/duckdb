# name: test/sql/settings/setting_capitalize_identifier.test
# description: Test capitalize_identifier setting
# group: [settings]

query I
SELECT value FROM duckdb_settings() WHERE name='capitalize_identifier'
----
false

# capitalize_identifier has no effect while preserve_identifier_case is true
statement ok
SET capitalize_identifier TO true;

query I
SELECT value FROM duckdb_settings() WHERE name='capitalize_identifier'
----
true

statement ok
CREATE SCHEMA MySchema;

statement ok
CREATE TABLE MySchema.Integers(i INTEGER);

query III
SELECT duckdb_tables.schema_name, duckdb_tables.table_name, column_name FROM duckdb_tables JOIN duckdb_columns USING (table_oid);
----
MySchema	Integers	i

statement ok
DROP SCHEMA MySchema CASCADE

# with preserve_identifier_case=false, capitalize_identifier uppercases non-quoted identifiers
statement ok
SET preserve_identifier_case TO false;

statement ok
CREATE SCHEMA MySchema;

statement ok
CREATE TABLE MySchema.Integers(i INTEGER);

query III
SELECT duckdb_tables.schema_name, duckdb_tables.table_name, column_name FROM duckdb_tables JOIN duckdb_columns USING (table_oid);
----
MYSCHEMA	INTEGERS	I

statement ok
DROP SCHEMA MYSCHEMA CASCADE

# quoted identifiers are still preserved exactly
statement ok
CREATE TABLE "QuotedName"("MixedCol" INTEGER);

query II
SELECT duckdb_tables.table_name, column_name FROM duckdb_tables JOIN duckdb_columns USING (table_oid);
----
QuotedName	MixedCol

statement ok
DROP TABLE "QuotedName"

# with capitalize_identifier back to false, preserve_identifier_case=false lowercases as before
statement ok
SET capitalize_identifier TO false;

statement ok
CREATE SCHEMA MySchema;

statement ok
CREATE TABLE MySchema.Integers(i INTEGER);

query III
SELECT duckdb_tables.schema_name, duckdb_tables.table_name, column_name FROM duckdb_tables JOIN duckdb_columns USING (table_oid);
----
myschema	integers	i
