# name: test/sql/function/list/aggregates/sum_no_overflow.test
# description: Test the sum_no_overflow aggregate function
# group: [aggregates]

# binding sum_no_overflow by name delegates to the regular sum
query I
SELECT sum_no_overflow(42)
----
42

query I
SELECT sum_no_overflow(42.5)
----
42.5

query II
SELECT typeof(sum_no_overflow(42::BIGINT)), typeof(sum_no_overflow(42.5))
----
HUGEINT	DECIMAL(38,1)

query I
SELECT sum_no_overflow(i::SMALLINT) FROM range(10) t(i)
----
45

# without statistics that prove it cannot overflow, it sums like the regular sum
query II
SELECT sum_no_overflow(x), sum(x) FROM (VALUES (9223372036854775807::BIGINT), (9223372036854775807::BIGINT)) t(x)
----
18446744073709551614	18446744073709551614

query I
SELECT sum_no_overflow(x) FROM (VALUES ((-9223372036854775808)::BIGINT), ((-9223372036854775808)::BIGINT)) t(x)
----
-18446744073709551616

query I
SELECT sum_no_overflow(x) FROM (VALUES (2147483647::INTEGER), (2147483647::INTEGER), (2147483647::INTEGER)) t(x)
----
6442450941

query I
SELECT finalize(sum_no_overflow(x) EXPORT_STATE) FROM (VALUES (9223372036854775807::BIGINT), (9223372036854775807::BIGINT)) t(x)
----
18446744073709551614

query I
SELECT sum_no_overflow(NULL::BIGINT)
----
NULL

query I
SELECT sum_no_overflow(NULL)
----
NULL

# the states of a NULL literal and of other arguments come from the same sum
query I
SELECT finalize(combine(sum_no_overflow(NULL) EXPORT_STATE, sum_no_overflow(1::BIGINT) EXPORT_STATE))
----
1

query I
SELECT finalize(combine(sum_no_overflow(abs(NULL::BIGINT)) EXPORT_STATE, sum_no_overflow(1::BIGINT) EXPORT_STATE))
----
1

query I
SELECT finalize(combine(sum_no_overflow(abs(NULL::INTEGER)) EXPORT_STATE, sum_no_overflow(1::INTEGER) EXPORT_STATE))
----
1

query I
SELECT list_aggregate([9223372036854775807, 9223372036854775807]::BIGINT[], 'sum_no_overflow')
----
18446744073709551614

query I
SELECT sum_no_overflow(x) OVER () FROM (VALUES (9223372036854775807::BIGINT), (9223372036854775807::BIGINT)) t(x) LIMIT 1
----
18446744073709551614

# a call by name exports the states of the regular sum
query I
SELECT finalize(combine(sum_no_overflow(1::INTEGER) EXPORT_STATE, sum(1::INTEGER) EXPORT_STATE))
----
2
