# name: test/sql/function/list/lambdas/properties_dictionary.test
# description: Test list lambda properties with dictionary vectors
# group: [lambdas]

require no_latest_storage

load {TEST_DIR}/list_lambda_properties_dictionary.db readwrite v1.0.0

statement ok
SET lambda_syntax='DISABLE_SINGLE_ARROW'

statement ok
PRAGMA force_compression='dictionary'

statement ok
CREATE TABLE list_lambda_dictionary_tbl AS
	SELECT CASE WHEN i % 2 = 0 THEN 'x' ELSE 'yy' END s FROM range(10000) tbl(i)

statement ok
CREATE SEQUENCE list_lambda_dictionary_seq START 1

restart

query I
SELECT count(*) > 0
FROM pragma_storage_info('list_lambda_dictionary_tbl')
WHERE segment_type ILIKE 'VARCHAR' AND compression = 'Dictionary'
----
true

# Volatile lambda bodies must execute once per row, not once per dictionary entry.
query I
SELECT count(DISTINCT list_transform(
	[0], lambda x: nextval('list_lambda_dictionary_seq') * 10 + length(s)
)[1])
FROM list_lambda_dictionary_tbl
----
10000
