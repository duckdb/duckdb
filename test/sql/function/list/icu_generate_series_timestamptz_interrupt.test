# name: test/sql/function/list/icu_generate_series_timestamptz_interrupt.test
# description: Counting the elements of a TIMESTAMPTZ range with billions of steps stops at the statement timeout
# group: [list]

require icu

statement ok
SET Calendar = 'gregorian';

statement ok
SET TimeZone = 'America/Los_Angeles';

statement ok
SET max_execution_time = 500;

# the list would have more than 2^32 elements: without an interrupt check the statement only fails after counting them
statement error
SELECT generate_series(c0, c1, c2) FROM (VALUES ('1970-01-01 00:00:00'::TIMESTAMPTZ, '2000-02-29 12:34:56.789012'::TIMESTAMPTZ, INTERVAL '1 microsecond')) t(c0, c1, c2);
----
Query exceeded maximum execution time

statement error
SELECT range(c0, c1, c2) FROM (VALUES ('2000-02-29 12:34:56.789012'::TIMESTAMPTZ, '1970-01-01 00:00:00'::TIMESTAMPTZ, INTERVAL '-1 microsecond')) t(c0, c1, c2);
----
Query exceeded maximum execution time

statement ok
RESET max_execution_time;

# short ranges are unaffected
query I
SELECT len(generate_series(c0, c1, c2)) FROM (VALUES ('2021-03-14 02:30:00'::TIMESTAMPTZ, '2021-03-14 02:30:01'::TIMESTAMPTZ, INTERVAL '1 microsecond')) t(c0, c1, c2);
----
1000001
