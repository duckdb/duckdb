# name: test/sql/function/numeric/test_fdiv_fmod.test
# description: Test floored division and modulus
# group: [numeric]

statement ok
SET ieee_floating_point_ops=false;

statement ok
CREATE TABLE rs(x DOUBLE, y INTEGER)

statement ok
INSERT INTO rs VALUES (10, 3),(10,-3),(-10,3),(-10,-3),(0,1),(1,1),(NULL,10),(10,NULL),(NULL,NULL)

query I
SELECT fmod(x, y) FROM rs
----
1
-2
2
-1
0
0
NULL
NULL
NULL

query I
SELECT fdiv(x, y) FROM rs
----
3
-4
-4
3
0
1
NULL
NULL
NULL

# division by zero is an error when IEEE behavior is disabled
statement error
SELECT fmod(42, 0)
----
<REGEX>:.*Division by zero.*

statement error
SELECT fdiv(42, 0)
----
<REGEX>:.*Division by zero.*

# unless null_on_division_by_zero is set
statement ok
SET null_on_division_by_zero=true;

# fmod by 0 results in NULL: should be NaN (if supported)
query I
SELECT fmod(42, 0)
----
NULL

# fmod 0 by 0 results in NULL: should be NaN (if supported)
query I
SELECT fmod(0, 0)
----
NULL

# fdiv by 0 results in NULL: should be Inf (if supported)
query I
SELECT fdiv(42, 0)
----
NULL

# fdiv by 0 results in NULL: should be -Inf (if supported)
query I
SELECT fdiv(-42, 0)
----
NULL

# fdiv 0 by 0 results in NULL: should be NaN (if supported)
query I
SELECT fdiv(0, 0)
----
NULL

statement ok
SET null_on_division_by_zero=false;

query R
SELECT fmod(12.3456789, 5)
----
2.345679

query I
SELECT fdiv(12.3456789, 5)
----
2

query R
SELECT fmod(3, 2.1)
----
0.900000

query I
SELECT fdiv(3, 2.1)
----
1

# fmod numerical stability tests
query R
SELECT fmod(1e16, 3.0)
----
1.0

query R
SELECT fmod(-1e16, -3.0)
----
-1.0

query R
SELECT fmod(9007199254740993::BIGINT, 3::BIGINT)
----
0.0

# Infinite dividends match the previous fmod expression.
query I
SELECT bool_and(isnan(fmod(x, y)) IS TRUE AND fmod(x, y) IS NOT DISTINCT FROM (x - y * floor(x / y)))
FROM (VALUES ('Infinity'::DOUBLE, 3.0), ('-Infinity'::DOUBLE, 3.0)) AS t(x, y)
----
1

# Infinite divisors match the previous fmod expression for both signs.
query I
SELECT bool_and(isnan(fmod(x, y)) IS TRUE AND fmod(x, y) IS NOT DISTINCT FROM (x - y * floor(x / y)))
FROM (VALUES (5.0, 'Infinity'::DOUBLE), (-5.0, 'Infinity'::DOUBLE),
             (5.0, '-Infinity'::DOUBLE), (-5.0, '-Infinity'::DOUBLE)) AS t(x, y)
----
1

# NaN in either argument matches the previous fmod expression.
query I
SELECT bool_and(isnan(fmod(x, y)) IS TRUE AND fmod(x, y) IS NOT DISTINCT FROM (x - y * floor(x / y)))
FROM (VALUES ('NaN'::DOUBLE, 3.0), (5.0, 'NaN'::DOUBLE)) AS t(x, y)
----
1

