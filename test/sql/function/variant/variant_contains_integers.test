# name: test/sql/function/variant/variant_contains_integers.test
# description: Test variant_contains on integers of different widths and signs, and on integers against DECIMAL and BIGNUM
# group: [variant]

# The limits of 64-bit integers are equal to the same value in a wider type, and a negative value is not equal to the
# unsigned value with the same bits.
query IIIII
SELECT variant_contains((-9223372036854775808)::BIGINT::VARIANT, (-9223372036854775808)::HUGEINT::VARIANT),
       variant_contains(18446744073709551615::UBIGINT::VARIANT, 18446744073709551615::HUGEINT::VARIANT),
       variant_contains(18446744073709551615::UBIGINT::VARIANT, (-1)::BIGINT::VARIANT),
       variant_contains((-1)::TINYINT::VARIANT, 255::UTINYINT::VARIANT),
       variant_contains(255::UTINYINT::VARIANT, (-1)::TINYINT::VARIANT);
----
true	true	false	false	false

# The limits of 128-bit integers.
query IIIII
SELECT variant_contains('170141183460469231731687303715884105727'::HUGEINT::VARIANT,
                        '170141183460469231731687303715884105727'::UHUGEINT::VARIANT),
       variant_contains('-170141183460469231731687303715884105728'::HUGEINT::VARIANT,
                        '170141183460469231731687303715884105728'::UHUGEINT::VARIANT),
       variant_contains('340282366920938463463374607431768211455'::UHUGEINT::VARIANT, (-1)::HUGEINT::VARIANT),
       variant_contains('340282366920938463463374607431768211455'::UHUGEINT::VARIANT,
                        '340282366920938463463374607431768211455'::BIGNUM::VARIANT),
       variant_contains(18446744073709551616::HUGEINT::VARIANT, 0::BIGINT::VARIANT);
----
true	false	false	true	false

# Zero has no sign, and a value is not equal to its negation.
query IIII
SELECT variant_contains(0::TINYINT::VARIANT, 0::UHUGEINT::VARIANT),
       variant_contains(0::BIGINT::VARIANT, (-0.00)::DECIMAL(3, 2)::VARIANT),
       variant_contains((-5)::SMALLINT::VARIANT, 5::SMALLINT::VARIANT),
       variant_contains((-5)::SMALLINT::VARIANT, (-5)::HUGEINT::VARIANT);
----
true	true	false	true

# One needle is compared with every element: an integer, a DECIMAL and a BIGNUM needle in an array of integers, an
# integer needle in an array of DECIMAL values, and a DOUBLE, which is not a NUMBER.
query IIIIIII
SELECT variant_contains([1, 2, 3]::BIGINT[]::VARIANT, 2::UTINYINT::VARIANT),
       variant_contains([1, 2, 3]::BIGINT[]::VARIANT, 2.00::DECIMAL(5, 2)::VARIANT),
       variant_contains([1, 2, 3]::BIGINT[]::VARIANT, 2.50::DECIMAL(5, 2)::VARIANT),
       variant_contains([1, 2, 3]::BIGINT[]::VARIANT, 3::BIGNUM::VARIANT),
       variant_contains([1.0, 2.0, 3.5]::DECIMAL(4, 1)[]::VARIANT, 2::INTEGER::VARIANT),
       variant_contains([1.0, 2.0, 3.5]::DECIMAL(4, 1)[]::VARIANT, 3::INTEGER::VARIANT),
       variant_contains([1, 2, 3]::BIGINT[]::VARIANT, 2::DOUBLE::VARIANT);
----
true	true	false	true	true	false	false

# Every element of an array needle is compared with haystack elements of several NUMBER types.
statement ok
CREATE TABLE mixed AS
SELECT [1::TINYINT::VARIANT, 2.5::DECIMAL(3, 1)::VARIANT, 3::BIGNUM::VARIANT, 4::UHUGEINT::VARIANT]::VARIANT AS v;

query IIII
SELECT variant_contains(v, [4, 3, 1]::SMALLINT[]::VARIANT),
       variant_contains(v, [2.5, 4.0]::DECIMAL(3, 1)[]::VARIANT),
       variant_contains(v, [1, 2]::SMALLINT[]::VARIANT),
       variant_contains([1, 2]::INTEGER[]::VARIANT, [2, 2, 1, 1]::UBIGINT[]::VARIANT)
FROM mixed;
----
true	true	false	true

# Needles of different types on the rows of one vector.
query II
SELECT needle::VARCHAR, variant_contains([10, 20, 30]::INTEGER[]::VARIANT, needle)
FROM (VALUES (20::TINYINT::VARIANT), (20.0::DECIMAL(4, 1)::VARIANT), (21::BIGINT::VARIANT), (30::BIGNUM::VARIANT),
             (20.5::DECIMAL(4, 1)::VARIANT), ('20'::VARIANT), (10::UHUGEINT::VARIANT)) needles(needle);
----
20	true
20.0	true
21	false
30	true
20.5	false
20	false
10	true
