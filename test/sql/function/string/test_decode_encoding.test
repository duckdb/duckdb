# name: test/sql/function/string/test_decode_encoding.test
# description: Test the encoding scalar functions
# group: [string]

query I
SELECT system.encodings."latin-1"('caf\xe9'::BLOB)
----
café

query I
SELECT system.encodings."utf-16"('a\x00\xe9\x00\x3d\xd8\x00\xde'::BLOB)
----
aé😀

query I
SELECT system.encodings."utf-16"(NULL::BLOB)
----
NULL

query I
SELECT SYSTEM.ENCODINGS."LATIN-1"(''::BLOB)
----
(empty)

statement error
SELECT system.encodings."latin-1"('\x85'::BLOB)
----
File is not latin-1 encoded

statement error
SELECT system.encodings."utf-16"('a'::BLOB)
----
Input is not valid UTF-16

# streaming overload: an incomplete trailing character is not consumed
query I
SELECT system.encodings."utf-16"('a\x00\xe9'::BLOB, false)
----
{'decoded': a, 'consumed': 2}

query I
SELECT system.encodings."utf-16"('a\x00\x3d\xd8'::BLOB, false)
----
{'decoded': a, 'consumed': 2}

statement error
SELECT system.encodings."utf-16"('a\x00\xe9'::BLOB, true)
----
Input is not valid UTF-16

# the CSV reader finds encodings through the catalog
statement error
SELECT * FROM read_csv('data/csv/test/date.csv', encoding='no-such-encoding')
----
The CSV Reader does not support the encoding

# an unknown encoding named like a function of another extension (inet) does not autoload that extension
statement error
SELECT * FROM read_csv('data/csv/test/date.csv', encoding='broadcast')
----
The CSV Reader does not support the encoding

query I
SELECT count(*) FROM duckdb_extensions() WHERE extension_name = 'inet' AND loaded
----
0

# encodings live in their own schema, not in the search path
statement error
SELECT "latin-1"('a'::BLOB)
----
Catalog Error

query I
SELECT count(*) FROM duckdb_functions() WHERE schema_name = 'encodings' AND function_name = 'utf-16'
----
3

# encode and decode take the name of an encoding
query I
SELECT encode('café', 'latin-1')
----
caf\xE9

query I
SELECT decode('caf\xe9'::BLOB, 'latin-1')
----
café

query I
SELECT decode(encode('aé😀', 'utf-16'), 'UTF-16')
----
aé😀

query I
SELECT encode('aé', 'utf-16')
----
a\x00\xE9\x00

query I
SELECT decode('caf\xc3\xa9'::BLOB, 'utf-8')
----
café

query I
SELECT encode('café', 'utf-8')
----
caf\xC3\xA9

query I
SELECT encode(NULL, 'latin-1') IS NULL
----
true

query II
SELECT s, decode(encode(s, 'latin-1'), 'latin-1') = s FROM (VALUES ('abc'), ('ÿ'), ('')) t(s) ORDER BY s
----
(empty)	true
abc	true
ÿ	true

# the system.encodings functions are overloaded for both directions
query I
SELECT system.encodings."latin-1"('é')
----
\xE9

# the error options of decode still work
query I
SELECT decode('a\xff'::BLOB, 'replace')
----
a?

statement error
SELECT encode('€', 'latin-1')
----
Could not encode the character

statement error
SELECT decode('\x85'::BLOB, 'latin-1')
----
File is not latin-1 encoded

statement error
SELECT encode('a', 'no-such-encoding')
----
Unknown encoding "no-such-encoding"

statement error
SELECT decode('a'::BLOB, 'no-such-encoding')
----
Unknown encoding "no-such-encoding"

# the encoding can be a prepared statement parameter
statement ok
PREPARE encode_with AS SELECT encode('café', $1)

query I
EXECUTE encode_with('latin-1')
----
caf\xE9

statement ok
PREPARE decode_with AS SELECT decode('caf\xe9'::BLOB, $1)

query I
EXECUTE decode_with('latin-1')
----
café

query I
SELECT encode('a', NULL) IS NULL
----
true

statement error
SELECT encode('a', e) FROM (VALUES ('latin-1')) t(e)
----
the encoding must be a constant

# non-ASCII characters at every offset relative to the ASCII fast path word boundaries
query I
SELECT count(*) FROM range(0, 25) t(n), range(0, 25) t2(m)
WHERE decode(unhex(repeat('61', n) || 'E9' || repeat('62', m)), 'latin-1') <> repeat('a', n) || 'é' || repeat('b', m)
----
0

query I
SELECT count(*) FROM range(0, 25) t(n), range(0, 25) t2(m)
WHERE decode(unhex(repeat('6100', n) || 'E900' || repeat('6200', m)), 'utf-16') <> repeat('a', n) || 'é' || repeat('b', m)
----
0

query I
SELECT count(*) FROM range(0, 25) t(n), range(0, 25) t2(m)
WHERE decode(unhex(repeat('6100', n) || '3DD800DE' || repeat('6200', m)), 'utf-16') <> repeat('a', n) || '😀' || repeat('b', m)
----
0

# a latin-1 control character (0x80-0x9F) anywhere in the input is rejected
query I
SELECT count(*) FROM range(0, 25) t(n)
WHERE try(decode(unhex(repeat('61', n) || '9F'), 'latin-1')) IS NOT NULL
----
0

# the streaming overload leaves a trailing incomplete character unconsumed at every offset
query I
SELECT count(*) FROM range(0, 25) t(n)
WHERE system.encodings."utf-16"(unhex(repeat('6100', n) || '3DD8'), false) <> {'decoded': repeat('a', n), 'consumed': 2 * n}
----
0
