# name: test/sql/function/operator/test_modulo_minimum.test
# description: The minimum of a signed integer type modulo minus one is zero
# group: [operator]

query IIIII
SELECT (-128)::TINYINT % (-1)::TINYINT, (-32768)::SMALLINT % (-1)::SMALLINT, (-2147483648)::INTEGER % (-1)::INTEGER, (-9223372036854775808)::BIGINT % (-1)::BIGINT, (-170141183460469231731687303715884105728)::HUGEINT % (-1)::HUGEINT
----
0	0	0	0	0

query IIIII
SELECT mod((-128)::TINYINT, (-1)::TINYINT), mod((-32768)::SMALLINT, (-1)::SMALLINT), mod((-2147483648)::INTEGER, (-1)::INTEGER), mod((-9223372036854775808)::BIGINT, (-1)::BIGINT), mod((-170141183460469231731687303715884105728)::HUGEINT, (-1)::HUGEINT)
----
0	0	0	0	0

statement ok
CREATE TABLE integers AS SELECT * FROM (VALUES (-2147483648, -1), (-2147483648, 3), (7, -1), (NULL, -1)) t(i, j)

query II
SELECT i % j, mod(i, j) FROM integers
----
0	0
-2	-2
0	0
NULL	NULL

statement error
SELECT i // j FROM integers
----
Overflow in division

query II
SELECT h % -1, h % 7 FROM (VALUES ((-170141183460469231731687303715884105728)::HUGEINT), (NULL)) t(h)
----
0	-2
NULL	NULL

statement ok
SET error_on_division_by_zero = false

query III
SELECT i % j, i % 0, mod(i, j) FROM integers
----
0	NULL	0
-2	NULL	-2
0	NULL	0
NULL	NULL	NULL

statement error
SELECT (-170141183460469231731687303715884105728)::HUGEINT // (-1)::HUGEINT
----
Overflow in division

query IIII
SELECT h % -1, mod(h, -1), h % 0, mod(h, 0) FROM (VALUES ((-170141183460469231731687303715884105728)::HUGEINT), (NULL)) t(h)
----
0	0	NULL	NULL
NULL	NULL	NULL	NULL
