# name: test/sql/function/date/test_date_part_cache.test
# description: year/month/day share one lookup cache: column, constant and hive file pruning evaluation agree
# group: [date]

require parquet

statement ok
CREATE TABLE dates AS SELECT d::DATE AS d FROM (VALUES ('-infinity'), ('1500-06-15'), ('1969-12-31'), ('1970-01-01'), ('2024-02-29'), ('2050-12-30'), ('2050-12-31'), ('9999-12-31'), ('infinity'), (NULL)) t(d);

# the cache covers 1970-01-01 up to and including 2050-12-30
query TIIIIII
SELECT d, year(d), month(d), day(d), year(d::TIMESTAMP), month(d::TIMESTAMP), day(d::TIMESTAMP) FROM dates ORDER BY d NULLS LAST;
----
-infinity	NULL	NULL	NULL	NULL	NULL	NULL
1500-06-15	1500	6	15	1500	6	15
1969-12-31	1969	12	31	1969	12	31
1970-01-01	1970	1	1	1970	1	1
2024-02-29	2024	2	29	2024	2	29
2050-12-30	2050	12	30	2050	12	30
2050-12-31	2050	12	31	2050	12	31
9999-12-31	9999	12	31	9999	12	31
infinity	NULL	NULL	NULL	NULL	NULL	NULL
NULL	NULL	NULL	NULL	NULL	NULL	NULL

# constant arguments
query IIIIII
SELECT year(DATE '1969-12-31'), month(DATE '2050-12-30'), day(DATE '2050-12-31'), day(TIMESTAMP '2050-12-30 23:59:59'), year(DATE 'infinity'), month(NULL::DATE);
----
1969	12	31	30	NULL	NULL

# every day in and around the cache matches the uncached computation
query II
SELECT count(*), count(*) FILTER (year(d) = date_part(['year', 'month', 'day'], d).year AND month(d) = date_part(['year', 'month', 'day'], d).month AND day(d) = date_part(['year', 'month', 'day'], d).day AND day(d::TIMESTAMP) = dayofmonth(d::TIMESTAMP))
FROM (SELECT range::DATE AS d FROM range(DATE '1960-01-01', DATE '2061-01-01', INTERVAL 1 DAY));
----
36891	36891

# hive partitions 2050-12-28 to 2051-01-03, one row each (v = 0 to 6), pruned by cached date parts
statement ok
COPY (SELECT DATE '2050-12-28' + i::INTEGER AS date, i AS v FROM range(7) t(i)) TO '{TEST_DIR}/date_part_cache_hive' (FORMAT parquet, PARTITION_BY (date));

query I
SELECT list(v ORDER BY v) FROM read_parquet('{TEST_DIR}/date_part_cache_hive/*/*.parquet', hive_partitioning=true) WHERE day(date) = 31;
----
[3]

query I
SELECT list(v ORDER BY v) FROM read_parquet('{TEST_DIR}/date_part_cache_hive/*/*.parquet', hive_partitioning=true) WHERE month(date) IN (1, 2);
----
[4, 5, 6]

query I
SELECT list(v ORDER BY v) FROM read_parquet('{TEST_DIR}/date_part_cache_hive/*/*.parquet', hive_partitioning=true) WHERE year(date) != 2050;
----
[4, 5, 6]

query I
SELECT list(v ORDER BY v) FROM read_parquet('{TEST_DIR}/date_part_cache_hive/*/*.parquet', hive_partitioning=true) WHERE year(date) * 100 + month(date) = 205012 AND day(date) > 29;
----
[2, 3]
