# name: test/sql/function/generic/least_greatest_interval.test
# description: Test LEAST/GREATEST on INTERVAL follows the normalized INTERVAL comparison order
# group: [generic]

# 1 month is 30 days and 1 day is 24 hours
query IIII
SELECT least(INTERVAL 1 MONTH, INTERVAL 31 DAY), greatest(INTERVAL 1 MONTH, INTERVAL 31 DAY),
       least(INTERVAL 25 HOUR, INTERVAL 1 DAY), greatest(INTERVAL 25 HOUR, INTERVAL 1 DAY)
----
1 month	31 days	1 day	25:00:00

# equal intervals return the first argument
query II
SELECT least(INTERVAL 30 DAY, INTERVAL 1 MONTH), least(INTERVAL 1 MONTH, INTERVAL 30 DAY)
----
30 days	1 month

statement ok
CREATE TABLE tbl AS SELECT * FROM (VALUES
	(INTERVAL 1 MONTH, INTERVAL 31 DAY),
	(INTERVAL 25 HOUR, INTERVAL 1 DAY),
	(NULL, INTERVAL 2 DAY),
	(INTERVAL '-1 month', INTERVAL '-29 days')
) v(a, b);

query II
SELECT least(a, b), greatest(a, b) FROM tbl
----
1 month	31 days
1 day	25:00:00
2 days	2 days
-1 month	-29 days

# INTERVAL statistics use the normalized order, so the result must agree with them
statement ok
CREATE TABLE stats_tbl AS SELECT INTERVAL 1 MONTH AS a, INTERVAL 31 DAY AS b;

query I
SELECT count(*) FROM stats_tbl WHERE least(a, b) = INTERVAL 1 MONTH
----
1

query I
SELECT count(*) FROM stats_tbl WHERE greatest(a, b) = INTERVAL 31 DAY
----
1
