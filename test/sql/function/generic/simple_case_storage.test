# name: test/sql/function/generic/simple_case_storage.test
# description: Simple CASE catalog compatibility and rendering across restart
# group: [generic]

load {TEST_DIR}/case_v21.db readwrite v2.1.0

statement ok
CREATE SEQUENCE s

statement ok
CREATE MACRO classify(x) AS CASE x WHEN < 1, > 2 THEN 0 WHEN 1 THEN 1 ELSE 2 END

statement ok
CREATE VIEW v AS SELECT CASE nextval('s') % 2 WHEN 0, 1 THEN 42 ELSE -1 END AS result

statement ok
CREATE VIEW named AS SELECT CASE i WHEN 1 THEN 2 ELSE 0 END FROM (VALUES (1)) t(i)

statement ok
CREATE VIEW dependent AS SELECT "CASE  WHEN ((i = 1)) THEN (2) ELSE 0 END" AS result FROM named

# Generated lambda inputs can capture a CHECK column without changing its scope.
statement ok
CREATE TABLE checked(__case_operand INT, CHECK(CASE random() WHEN -1 THEN false WHEN -2 THEN false ELSE __case_operand > 0 END))

statement ok
INSERT INTO checked VALUES (42)

statement error
INSERT INTO checked VALUES (-1)
----
CHECK constraint failed


restart

query II
SELECT result, classify(2) FROM v
----
42	2

query I
SELECT currval('s')
----
1

query I
SELECT result FROM dependent
----
2

query I
SELECT sql LIKE '%CASE (i) WHEN (1)%' FROM duckdb_views() WHERE view_name='named'
----
true

statement ok
ATTACH '{TEST_DIR}/case_v20.db' AS legacy (STORAGE_VERSION 'v2.0.0')

statement ok
CREATE VIEW legacy.single AS SELECT CASE 1 WHEN > 0 THEN 42 END

statement ok
CREATE VIEW legacy.dependent AS SELECT "CASE  WHEN ((1 > 0)) THEN (42) ELSE NULL END" AS result FROM legacy.single

statement error
CREATE VIEW legacy.multi AS SELECT CASE i WHEN 0 THEN 'a' WHEN 1 THEN 'b' END FROM range(5) t(i)
----
multiple comparisons requires storage version v2.1.0

statement error
CREATE MACRO legacy.multi(x) AS CASE x WHEN 1, 2 THEN 42 END
----
multiple comparisons requires storage version v2.1.0

statement error
CREATE TABLE legacy.bad(i INT DEFAULT CASE 1 WHEN 1, 2 THEN 42 END)
----
multiple comparisons requires storage version v2.1.0

statement ok
DETACH legacy

statement ok
ATTACH '{TEST_DIR}/case_v20.db' AS legacy

query I
SELECT * FROM legacy.dependent
----
42

query I
SELECT count(*) FROM duckdb_views() WHERE database_name='legacy' AND view_name='multi'
----
0
