# name: test/sql/function/generic/least_greatest_unsigned.test
# description: Test LEAST/GREATEST on unsigned integer types
# group: [generic]

# mix values below and above the signed range of the same width
query IIIII
SELECT LEAST(200::UTINYINT, 1::UTINYINT, 128::UTINYINT), LEAST(65535::USMALLINT, 1::USMALLINT, 32768::USMALLINT),
       LEAST(4294967295::UINTEGER, 1::UINTEGER, 2147483648::UINTEGER),
       LEAST(18446744073709551615::UBIGINT, 1::UBIGINT, 9223372036854775808::UBIGINT),
       LEAST(340282366920938463463374607431768211455::UHUGEINT, 1::UHUGEINT, 170141183460469231731687303715884105728::UHUGEINT)
----
1	1	1	1	1

query IIIII
SELECT GREATEST(1::UTINYINT, 255::UTINYINT, 127::UTINYINT), GREATEST(1::USMALLINT, 65535::USMALLINT, 32767::USMALLINT),
       GREATEST(1::UINTEGER, 4294967295::UINTEGER, 2147483647::UINTEGER),
       GREATEST(1::UBIGINT, 18446744073709551615::UBIGINT, 9223372036854775807::UBIGINT),
       GREATEST(1::UHUGEINT, 340282366920938463463374607431768211455::UHUGEINT, 170141183460469231731687303715884105727::UHUGEINT)
----
255	65535	4294967295	18446744073709551615	340282366920938463463374607431768211455

query IIIII
SELECT LEAST(NULL, 5::UTINYINT, NULL), GREATEST(NULL, 5::USMALLINT), LEAST(5::UINTEGER, NULL),
       GREATEST(NULL::UBIGINT, NULL::UBIGINT), LEAST(NULL::UHUGEINT, NULL)
----
5	5	5	NULL	NULL

statement ok
CREATE TABLE tbl AS SELECT * FROM (VALUES
	(1::UTINYINT, 1::USMALLINT, 1::UINTEGER, 1::UBIGINT, 1::UHUGEINT),
	(NULL, 65535, NULL, 18446744073709551615, NULL),
	(255, NULL, 4294967295, NULL, 340282366920938463463374607431768211455),
	(0, 0, 0, 0, 0)
) v(u8, u16, u32, u64, u128);

query IIIIIIIIII
SELECT LEAST(u8, 128::UTINYINT), GREATEST(u8, 128::UTINYINT),
       LEAST(u16, 32768::USMALLINT), GREATEST(u16, 32768::USMALLINT),
       LEAST(u32, 2147483648::UINTEGER), GREATEST(u32, 2147483648::UINTEGER),
       LEAST(u64, 9223372036854775808::UBIGINT), GREATEST(u64, 9223372036854775808::UBIGINT),
       LEAST(u128, 170141183460469231731687303715884105728::UHUGEINT), GREATEST(u128, 170141183460469231731687303715884105728::UHUGEINT)
FROM tbl
----
1	128	1	32768	1	2147483648	1	9223372036854775808	1	170141183460469231731687303715884105728
128	128	32768	65535	2147483648	2147483648	9223372036854775808	18446744073709551615	170141183460469231731687303715884105728	170141183460469231731687303715884105728
128	255	32768	32768	2147483648	4294967295	9223372036854775808	9223372036854775808	170141183460469231731687303715884105728	340282366920938463463374607431768211455
0	128	0	32768	0	2147483648	0	9223372036854775808	0	170141183460469231731687303715884105728

# column vs column, both nullable
query II
SELECT LEAST(u64, u128), GREATEST(u8, u16, u32) FROM tbl
----
1	1
18446744073709551615	65535
340282366920938463463374607431768211455	4294967295
0	0
