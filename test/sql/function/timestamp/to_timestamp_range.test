# name: test/sql/function/timestamp/to_timestamp_range.test
# description: to_timestamp rejects epoch seconds below the smallest timestamp
# group: [timestamp]

query I
SELECT to_timestamp(-9223372022400)
----
290309-12-22 (BC) 00:00:00+00

statement error
SELECT to_timestamp(-9223372022400.01)
----
Conversion Error: Epoch seconds out of range for TIMESTAMP WITH TIME ZONE

statement error
SELECT to_timestamp(-9223372030000)
----
Conversion Error: Epoch seconds out of range for TIMESTAMP WITH TIME ZONE

statement error
SELECT to_timestamp(-9223372036854.775)
----
Conversion Error: Epoch seconds out of range for TIMESTAMP WITH TIME ZONE

statement error
SELECT to_timestamp(x) FROM (VALUES (0), (-9223372030000)) t(x)
----
Conversion Error: Epoch seconds out of range for TIMESTAMP WITH TIME ZONE
