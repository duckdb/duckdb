# name: test/sql/function/language_function/language_function_replace_errors.test
# description: Errors and expansion limits of a language member's replacement
# group: [language_function]

# Language function tests manage their own storage version (persistent entries need v2.1.0+)
require noforcestorage

require skip_reload

require allow_unsigned_extensions

statement ok
LOAD '{BUILD_DIRECTORY}/test/extension/language_function_demo.duckdb_extension';

statement ok
CREATE TABLE t(i INTEGER);

statement ok
INSERT INTO t VALUES (1), (2);

# a bind error in the replacement points at the call, not at an offset into the generated text
statement ok
CREATE FUNCTION f_badref(x) LANGUAGE testlang AS 'sql:x + no_such_col';

statement error
SELECT 1, f_badref(i) FROM t;
----
<REGEX>:.*Referenced column "no_such_col" not found.*LINE 1: SELECT 1, f_badref\(i\) FROM t;\n {18}\^.*

statement ok
CREATE FUNCTION f_badtable(x) LANGUAGE testlang AS 'sql:(SELECT x FROM no_such_table)';

statement error
SELECT 1, f_badtable(i) FROM t;
----
<REGEX>:.*Table with name no_such_table does not exist.*LINE 1: SELECT 1, f_badtable\(i\) FROM t;\n {18}\^.*

# the language's note is appended to a bind error of its replacement
statement ok
CREATE FUNCTION f_noted(x) LANGUAGE testlang AS 'note:generated by f_noted|x + no_such_col';

statement error
SELECT f_noted(i) FROM t;
----
<REGEX>:.*Referenced column "no_such_col" not found.*generated by f_noted.*

# ... but not to an error raised at execution
statement ok
CREATE FUNCTION f_noted_runtime(x) LANGUAGE testlang AS 'note:generated by f_noted_runtime|error(x)';

statement error
SELECT f_noted_runtime('boom');
----
<!REGEX>:.*generated by f_noted_runtime.*

# an argument the replacement uses raises its own bind error, the same as a macro argument
statement ok
CREATE FUNCTION f_use(x) LANGUAGE testlang AS 'sql:x';

statement ok
CREATE MACRO m_use(x) AS x;

statement error
SELECT m_use(no_such_col);
----
<REGEX>:.*Referenced column "no_such_col" was not found because the FROM clause is missing.*

statement error
SELECT f_use(no_such_col);
----
<REGEX>:.*Referenced column "no_such_col" was not found because the FROM clause is missing.*

# a callback error surfaces as raised
statement ok
CREATE FUNCTION f_raise() LANGUAGE testlang AS 'error:refused';

statement error
SELECT f_raise();
----
<REGEX>:.*Binder Error: testlang: refused.*

# a replacement that does not parse, or is not exactly one expression
statement ok
CREATE FUNCTION f_unparsable() LANGUAGE testlang AS 'sql:1 +';

statement error
SELECT f_unparsable();
----
<REGEX>:.*The replacement for "f_unparsable" returned by language "testlang" does not parse.*

statement ok
CREATE FUNCTION f_two() LANGUAGE testlang AS 'sql:1, 2';

statement error
SELECT f_two();
----
<REGEX>:.*must be exactly one expression.*

# a replacement is parsed with the builtin parser options, not the session's
statement ok
CREATE FUNCTION f_div(x) LANGUAGE testlang AS 'sql:x / 2';

statement ok
SET integer_division = true;

query II
SELECT 3 / 2, f_div(3);
----
1	1.5

statement ok
RESET integer_division;

# a function that is not declared as a language is not one
statement error
CREATE FUNCTION f_lower(x) LANGUAGE lower AS 'x';
----
<REGEX>:.*Function "lower" is not a function language.*

statement error
CREATE FUNCTION f_plain(x) LANGUAGE testlang_plain AS 'x';
----
<REGEX>:.*Function "testlang_plain" is not a function language.*

# expansion recursion stops at max_expression_depth like a recursive macro, bounded by an execution time limit. An
# explicit limit keeps the recursion clear of a 1 MB main-thread stack (Windows)
statement ok
SET max_execution_time = 60000;

statement ok
SET max_expression_depth = 250;

statement ok
CREATE MACRO m_rec(x) AS x;

statement ok
CREATE OR REPLACE MACRO m_rec(x) AS m_rec(x);

statement ok
CREATE FUNCTION f_rec(x) LANGUAGE testlang AS 'sql:f_rec(x)';

statement error
SELECT m_rec(1);
----
<REGEX>:.*Max expression depth limit of 250 exceeded.*

statement error
SELECT f_rec(1);
----
<REGEX>:.*Max expression depth limit of 250 exceeded.*

statement error
SELECT f_rec(i) FROM t;
----
<REGEX>:.*Max expression depth limit of 250 exceeded.*

# ... inside a scalar subquery, where each expansion level binds a new subquery
statement ok
CREATE FUNCTION f_rec_subquery(x) LANGUAGE testlang AS 'sql:(SELECT f_rec_subquery(x))';

statement error
SELECT f_rec_subquery(1);
----
<REGEX>:.*Max expression depth limit of 250 exceeded.*

statement ok
SET max_expression_depth = 50;

statement error
SELECT f_rec(1);
----
<REGEX>:.*Max expression depth limit of 50 exceeded.*

statement error
SELECT f_rec_subquery(1);
----
<REGEX>:.*Max expression depth limit of 50 exceeded.*

statement ok
SET max_expression_depth = 250;

# expansion driven by a constant argument terminates
statement ok
CREATE FUNCTION f_countdown(x) LANGUAGE testlang AS 'countdown';

query I
SELECT f_countdown(5);
----
15

statement error
SELECT f_countdown(i) FROM t;
----
<REGEX>:.*Max expression depth limit of 250 exceeded.*

# a recursive call inside the argument of the replacement stops at the depth limit too, with and without a callback
# reading its arguments
statement ok
CREATE MACRO m_rec_arg(x) AS x;

statement ok
CREATE OR REPLACE MACRO m_rec_arg(x) AS m_rec_arg(m_rec_arg(x));

statement error
SELECT m_rec_arg(1);
----
<REGEX>:.*Max expression depth limit of 250 exceeded.*

statement ok
CREATE FUNCTION f_rec_arg(x) LANGUAGE testlang AS 'sql:f_rec_arg(f_rec_arg(x))';

statement error
SELECT f_rec_arg(1);
----
<REGEX>:.*Max expression depth limit of 250 exceeded.*

statement ok
CREATE FUNCTION f_rec_arg_read(x) LANGUAGE testlang AS 'probe:f_rec_arg_read(f_rec_arg_read(x))';

statement error
SELECT f_rec_arg_read(1);
----
<REGEX>:.*Max expression depth limit of 250 exceeded.*

# nested calls cost about as much as nested macros: an untyped member's arguments are not bound before the language
# reads them, a typed member's are bound once for member selection like a typed macro's

statement ok
RESET max_expression_depth;

statement ok
SET max_execution_time = 5000;

statement ok
CREATE MACRO m_id(x) AS x;

statement ok
CREATE FUNCTION f_id(x) LANGUAGE testlang AS 'arg:0';

statement ok
CREATE FUNCTION f_id_sql(x) LANGUAGE testlang AS 'sql:x';

query II
SELECT m_id(m_id(m_id(m_id(m_id(m_id(m_id(m_id(m_id(m_id(m_id(m_id(m_id(m_id(m_id(m_id(m_id(m_id(m_id(m_id(m_id(m_id(m_id(m_id(1)))))))))))))))))))))))),
       f_id(f_id(f_id(f_id(f_id(f_id(f_id(f_id(f_id(f_id(f_id(f_id(f_id(f_id(f_id(f_id(f_id(f_id(f_id(f_id(f_id(f_id(f_id(f_id(1))))))))))))))))))))))));
----
1	1

query I
SELECT f_id_sql(f_id_sql(f_id_sql(f_id_sql(f_id_sql(f_id_sql(f_id_sql(f_id_sql(f_id_sql(f_id_sql(f_id_sql(f_id_sql(f_id_sql(f_id_sql(f_id_sql(f_id_sql(f_id_sql(f_id_sql(f_id_sql(f_id_sql(f_id_sql(f_id_sql(f_id_sql(f_id_sql(1))))))))))))))))))))))));
----
1

statement ok
CREATE MACRO m_id_typed(x INTEGER) AS x;

statement ok
CREATE FUNCTION f_id_typed(x INTEGER) LANGUAGE testlang AS 'arg:0';

query II
SELECT m_id_typed(m_id_typed(m_id_typed(m_id_typed(m_id_typed(m_id_typed(m_id_typed(m_id_typed(m_id_typed(m_id_typed(m_id_typed(1))))))))))),
       f_id_typed(f_id_typed(f_id_typed(f_id_typed(f_id_typed(f_id_typed(f_id_typed(f_id_typed(f_id_typed(f_id_typed(f_id_typed(1)))))))))));
----
1	1

# a replacement cannot reference the caller's prepared statement parameters, like a macro body
statement ok
CREATE FUNCTION f_param() LANGUAGE testlang AS 'sql:$1';

statement ok
CREATE FUNCTION f_param_subquery() LANGUAGE testlang AS 'sql:(SELECT ?)';

statement error
PREPARE p_param AS SELECT f_param();
----
<REGEX>:.*The replacement for "f_param" returned by language "testlang" contains a prepared statement parameter.*

statement error
PREPARE p_param AS SELECT f_param_subquery();
----
<REGEX>:.*The replacement for "f_param_subquery" returned by language "testlang" contains a prepared statement parameter.*

# ... while a parameter in an argument is the caller's own
statement ok
CREATE FUNCTION f_arg_param(x) LANGUAGE testlang AS 'sql:x + 1';

statement ok
PREPARE p_arg_param AS SELECT f_arg_param(?::INTEGER);

query I
EXECUTE p_arg_param(41);
----
42

# a callback that reads its argument binds it once more per call: nested reading calls grow like nested typed
# macros, whose member selection binds each argument as well. The exponential cases use depths that stay far inside
# the limit in assertion builds
statement ok
CREATE FUNCTION f_read(x) LANGUAGE testlang AS 'probe:x';

statement ok
CREATE FUNCTION f_read_typed(x INTEGER) LANGUAGE testlang AS 'probe:x';

query II
SELECT f_read(f_read(f_read(f_read(f_read(f_read(f_read(f_read(f_read(f_read(1)))))))))),
       m_id_typed(m_id_typed(m_id_typed(m_id_typed(m_id_typed(m_id_typed(m_id_typed(m_id_typed(m_id_typed(m_id_typed(1))))))))));
----
1	1

query II
SELECT f_read_typed(f_read_typed(f_read_typed(f_read_typed(f_read_typed(f_read_typed(f_read_typed(1))))))),
       m_id_typed(m_id_typed(m_id_typed(m_id_typed(m_id_typed(m_id_typed(m_id_typed(1)))))));
----
1	1

# the walk that points a replacement at the call visits a nested modifier once, so a replacement nesting them costs
# what the same query costs. Binding nested LIMIT subqueries is itself exponential in core, so the depth stays low
statement ok
CREATE FUNCTION f_deep_limit() LANGUAGE testlang AS 'sql:(SELECT 1 LIMIT (SELECT 1 LIMIT (SELECT 1 LIMIT (SELECT 1 LIMIT (SELECT 1 LIMIT (SELECT 1 LIMIT (SELECT 1 LIMIT (SELECT 1 LIMIT (SELECT 1 LIMIT (SELECT 1 LIMIT 1))))))))))';

query I
SELECT f_deep_limit();
----
1

query I
SELECT (SELECT 1 LIMIT (SELECT 1 LIMIT (SELECT 1 LIMIT (SELECT 1 LIMIT (SELECT 1 LIMIT (SELECT 1 LIMIT (SELECT 1 LIMIT (SELECT 1 LIMIT (SELECT 1 LIMIT (SELECT 1 LIMIT 1))))))))));
----
1

# the walk runs before the replacement binds, and the outermost select list fails to bind before its ORDER BY does,
# so this shows the cost of the walk alone: linear, while a duplicate visit of each node's modifiers doubles it per
# level. The walk is not interruptible: the macro calls in the select list check the execution time limit after it,
# a binder checks it every 256 macro expansions
statement ok
CREATE FUNCTION f_deep_order() LANGUAGE testlang AS 'sql:(SELECT [m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(1), m_id(no_such_col)] ORDER BY (SELECT 1 ORDER BY (SELECT 1 ORDER BY (SELECT 1 ORDER BY (SELECT 1 ORDER BY (SELECT 1 ORDER BY (SELECT 1 ORDER BY (SELECT 1 ORDER BY (SELECT 1 ORDER BY (SELECT 1 ORDER BY (SELECT 1 ORDER BY (SELECT 1 ORDER BY (SELECT 1 ORDER BY (SELECT 1 ORDER BY (SELECT 1 ORDER BY (SELECT 1 ORDER BY (SELECT 1 ORDER BY (SELECT 1 ORDER BY (SELECT 1 ORDER BY (SELECT 1 ORDER BY (SELECT 1 ORDER BY (SELECT 1 ORDER BY (SELECT 1 ORDER BY (SELECT 1 ORDER BY (SELECT 1 ORDER BY (SELECT 1 ORDER BY (SELECT 1 ORDER BY (SELECT 1 ORDER BY random()))))))))))))))))))))))))))))';

