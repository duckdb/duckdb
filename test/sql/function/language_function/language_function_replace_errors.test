----
<REGEX>:.*Referenced column "no_such_col" was not found.*

# ... and a parameter in any modifier of a replacement is still found
statement ok
CREATE FUNCTION f_limit_param() LANGUAGE testlang AS 'sql:(SELECT 1 LIMIT $1)';

statement ok
CREATE FUNCTION f_offset_param() LANGUAGE testlang AS 'sql:(SELECT 1 LIMIT 1 OFFSET $1)';

statement ok
CREATE FUNCTION f_order_param() LANGUAGE testlang AS 'sql:(SELECT 1 AS c ORDER BY $1)';

statement ok
CREATE FUNCTION f_distinct_param() LANGUAGE testlang AS 'sql:(SELECT DISTINCT ON ($1) 1)';

statement ok
CREATE FUNCTION f_cte_param() LANGUAGE testlang AS 'sql:(WITH w AS (SELECT $1 AS c) SELECT c FROM w)';

statement error
PREPARE p_limit AS SELECT f_limit_param();
----
<REGEX>:.*The replacement for "f_limit_param" returned by language "testlang" contains a prepared statement parameter.*

statement error
PREPARE p_offset AS SELECT f_offset_param();
----
<REGEX>:.*contains a prepared statement parameter.*

statement error
PREPARE p_order AS SELECT f_order_param();
----
<REGEX>:.*contains a prepared statement parameter.*

statement error
PREPARE p_distinct AS SELECT f_distinct_param();
----
<REGEX>:.*contains a prepared statement parameter.*

statement error
PREPARE p_cte AS SELECT f_cte_param();
----
<REGEX>:.*contains a prepared statement parameter.*

# D: an UNPIVOT entry of a replacement is an expression like any other
statement ok
CREATE FUNCTION f_unpivot_param() LANGUAGE testlang AS 'sql:(SELECT v FROM (SELECT 1 AS a) UNPIVOT (v FOR n IN (a + $1)))';

statement error
PREPARE p_unpivot AS SELECT $1::INTEGER AS supplied, f_unpivot_param();
----
<REGEX>:.*The replacement for "f_unpivot_param" returned by language "testlang" contains a prepared statement parameter.*

# ... and a parameter in an UNPIVOT entry of a replacement is substituted like one anywhere else: an UNPIVOT entry
# accepts one column, which the substituted argument satisfies
statement ok
CREATE FUNCTION f_unpivot(x) LANGUAGE testlang AS 'sql:(SELECT max(v) FROM (SELECT 1 AS a, 2 AS b) UNPIVOT (v FOR n IN (a + x, b + x)))';

query I
SELECT f_unpivot(10);
----
12

# a NEAREST ranking expression of a replacement is an expression like any other
statement ok
CREATE FUNCTION f_nearest_param() LANGUAGE testlang AS 'sql:(SELECT t.v FROM (VALUES (0)) q(x) JOIN (VALUES (1), (10)) t(v) NEAREST 1 BY DISTANCE abs(t.v - $1))';

statement error
PREPARE p_nearest AS SELECT $1::INTEGER AS supplied, f_nearest_param();
----
<REGEX>:.*The replacement for "f_nearest_param" returned by language "testlang" contains a prepared statement parameter.*

# ... and a parameter in it is substituted, by a language replacement and by a plain macro body
statement ok
CREATE FUNCTION f_nearest(x) LANGUAGE testlang AS 'sql:(SELECT t.v FROM (VALUES (0)) q(z) JOIN (VALUES (1), (10)) t(v) NEAREST 1 BY DISTANCE abs(t.v - x))';

statement ok
CREATE MACRO m_nearest(x) AS (SELECT t.v FROM (VALUES (0)) q(z) JOIN (VALUES (1), (10)) t(v) NEAREST 1 BY DISTANCE abs(t.v - x));

query III
SELECT f_nearest(9), m_nearest(9), m_nearest(2);
----
10	10	1

# renamed parameters must be distinct, one per parameter
statement ok
CREATE FUNCTION f_dup_names(a, b) LANGUAGE testlang AS 'names:p,P|p';

