# name: test/sql/secrets/secret_scope_boundary.test
# description: A secret scope must only match on a path separator boundary
# group: [secrets]

require noforcestorage

statement ok
CREATE TEMPORARY SECRET s1 (TYPE http, SCOPE 'https://scope_a');

statement ok
CREATE TEMPORARY SECRET s2 (TYPE http, SCOPE 'https://unrelated');

# the scope matches the prefix exactly
query I
SELECT name FROM which_secret('https://scope_a', 'http');
----
s1

# the scope matches paths below the prefix
query I
SELECT name FROM which_secret('https://scope_a/some/key', 'http');
----
s1

# the scope must NOT match a sibling with the same character prefix
query I
SELECT count(*) FROM which_secret('https://scope_a_evil/some/key', 'http');
----
0

query I
SELECT count(*) FROM which_secret('https://scope_abc', 'http');
----
0

# a scope that already ends in a separator keeps matching paths below it
statement ok
CREATE TEMPORARY SECRET s3 (TYPE http, SCOPE 'https://bucket/');

query I
SELECT name FROM which_secret('https://bucket/key', 'http');
----
s3

# a scope that ends in another separator also matches paths continuing after it
statement ok
CREATE TEMPORARY SECRET s4 (TYPE http, SCOPE 'scheme:');

query I
SELECT name FROM which_secret('scheme:host:1234', 'http');
----
s4
