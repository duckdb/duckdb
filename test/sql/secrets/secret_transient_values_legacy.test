# name: test/sql/secrets/secret_transient_values_legacy.test
# description: Test secrets written before transient values existed, which persist both the recipe
#              and the values it produced
# group: [secrets]

require notmingw

require skip_reload

require allow_unsigned_extensions

require-env TEST_PERSISTENT_SECRETS_AVAILABLE

statement ok
LOAD '{BUILD_DIRECTORY}/test/extension/loadable_secret_refresh_demo.duckdb_extension';

# The provider's counters are process-wide, start from a known point
statement ok
SELECT refresh_demo_reset()

statement ok
SET secret_directory='{TEST_DIR}/secret_transient_values_legacy'

# Emulate a version that predates transient values: the provider produces a token but does not
# declare it transient, so it is persisted alongside the recipe that could re-derive it
statement ok
SELECT refresh_demo_set_declares_transient(false)

statement ok
CREATE PERSISTENT SECRET legacy (
    TYPE refresh_demo,
    SCOPE 'demo://',
    ACCOUNT 'my_account',
    REFRESH_INFO MAP {'account': 'my_account'}
)

statement ok
SELECT refresh_demo_set_declares_transient(true)

restart

statement ok
LOAD '{BUILD_DIRECTORY}/test/extension/loadable_secret_refresh_demo.duckdb_extension';

statement ok
SET secret_directory='{TEST_DIR}/secret_transient_values_legacy'

# The value was persisted, so it comes back with the secret and is used as it is
query II
SELECT secret_string LIKE '%token=token_1%', secret_string LIKE '%refresh_info%'
FROM duckdb_secrets(redact=false) WHERE name='legacy'
----
true	true

# Using it must NOT re-derive: nothing is declared transient, so nothing is missing
statement ok
SELECT name FROM which_secret('demo://bucket/file', 'refresh_demo')

query I
SELECT refresh_demo_derivations()
----
1

query I
SELECT secret_string LIKE '%token=token_1%' FROM duckdb_secrets(redact=false) WHERE name='legacy'
----
true

# Rejecting the value still refreshes it, and the re-derived value shadows the persisted one
statement ok
SELECT refresh_demo_invalidate('demo://bucket/file')

statement ok
SELECT name FROM which_secret('demo://bucket/file', 'refresh_demo')

query II
SELECT refresh_demo_derivations(), secret_string LIKE '%token=token_2%'
FROM duckdb_secrets(redact=false) WHERE name='legacy'
----
2	true

# The secret file is never rewritten, so a restart brings back the value it was created with:
# a secret written by an older version does not migrate itself
restart

statement ok
LOAD '{BUILD_DIRECTORY}/test/extension/loadable_secret_refresh_demo.duckdb_extension';

statement ok
SET secret_directory='{TEST_DIR}/secret_transient_values_legacy'

query I
SELECT secret_string LIKE '%token=token_1%' FROM duckdb_secrets(redact=false) WHERE name='legacy'
----
true

# Recreating it adopts the new behaviour: the value stops being persisted
statement ok
CREATE OR REPLACE PERSISTENT SECRET legacy (
    TYPE refresh_demo,
    SCOPE 'demo://',
    ACCOUNT 'my_account',
    REFRESH_INFO MAP {'account': 'my_account'}
)

restart

statement ok
LOAD '{BUILD_DIRECTORY}/test/extension/loadable_secret_refresh_demo.duckdb_extension';

statement ok
SET secret_directory='{TEST_DIR}/secret_transient_values_legacy'

query I
SELECT secret_string LIKE '%token=%' FROM duckdb_secrets(redact=false) WHERE name='legacy'
----
false
