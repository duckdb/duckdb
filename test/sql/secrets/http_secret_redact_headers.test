# name: test/sql/secrets/http_secret_redact_headers.test
# description: The extra HTTP headers of http secrets are redacted
# group: [secrets]

statement ok
CREATE SECRET s2 (TYPE http, EXTRA_HTTP_HEADERS MAP {'Authorization': 'Bearer abc123', 'X-Api-Key': 'key456'}, BEARER_TOKEN 'tok789');

query I
SELECT secret_string FROM duckdb_secrets() WHERE name = 's2';
----
name=s2;type=http;provider=config;serializable=true;scope;bearer_token=redacted;extra_http_headers=redacted
