# name: test/sql/secrets/secret_transient_values.test
# description: Test that secret values declared transient are derived on demand instead of persisted
# group: [secrets]

require notmingw

require skip_reload

require allow_unsigned_extensions

require-env TEST_PERSISTENT_SECRETS_AVAILABLE

statement ok
LOAD '{BUILD_DIRECTORY}/test/extension/loadable_secret_refresh_demo.duckdb_extension';

# The provider's counters are process-wide, start from a known point
statement ok
SELECT refresh_demo_reset()

statement ok
SET secret_directory='{TEST_DIR}/secret_transient_values'

# The provider hands out a token that has never been seen before on every derivation
statement ok
CREATE PERSISTENT SECRET s1 (
    TYPE refresh_demo,
    SCOPE 'demo://',
    ACCOUNT 'my_account',
    REFRESH_INFO MAP {'account': 'my_account'}
)

query I
SELECT secret_string LIKE '%token=token_1%' FROM duckdb_secrets(redact=false) WHERE name='s1'
----
true

# The configured value is persisted, the derived one is not
query I
SELECT secret_string LIKE '%account=my_account%' FROM duckdb_secrets(redact=false) WHERE name='s1'
----
true

restart

statement ok
LOAD '{BUILD_DIRECTORY}/test/extension/loadable_secret_refresh_demo.duckdb_extension';

statement ok
SET secret_directory='{TEST_DIR}/secret_transient_values'

# After a restart the secret is read back from storage without its transient value: listing the
# secret must not derive one, only using it may
query II
SELECT secret_string LIKE '%account=my_account%', secret_string LIKE '%token=%'
FROM duckdb_secrets(redact=false) WHERE name='s1'
----
true	false

# Using the secret derives the missing value
query I
SELECT name FROM which_secret('demo://bucket/file', 'refresh_demo')
----
s1

query I
SELECT secret_string LIKE '%token=%' FROM duckdb_secrets(redact=false) WHERE name='s1'
----
true

# ... and derives it exactly once: a second use reuses what the first one derived. The count is
# process-wide and a restart reopens the database without restarting the process, so it still
# includes the derivation that happened when the secret was created
statement ok
SELECT name FROM which_secret('demo://bucket/file', 'refresh_demo')

query I
SELECT refresh_demo_derivations()
----
2

# Rejecting the derived value causes exactly one re-derivation on the next use
statement ok
SELECT refresh_demo_invalidate('demo://bucket/file')

statement ok
SELECT name FROM which_secret('demo://bucket/file', 'refresh_demo')

query I
SELECT refresh_demo_derivations()
----
3

statement ok
SELECT name FROM which_secret('demo://bucket/file', 'refresh_demo')

query I
SELECT refresh_demo_derivations()
----
3

# A failing derivation errors rather than handing out a value the backend has rejected
statement ok
SELECT refresh_demo_invalidate('demo://bucket/file')

statement ok
SELECT refresh_demo_set_fails(true)

statement error
SELECT name FROM which_secret('demo://bucket/file', 'refresh_demo')
----
<REGEX>:.*derivation failed on purpose.*

# The secret stays marked, so the next use retries instead of serving the rejected value
statement ok
SELECT refresh_demo_set_fails(false)

statement ok
SELECT name FROM which_secret('demo://bucket/file', 'refresh_demo')

query I
SELECT refresh_demo_derivations()
----
4

# The transient value never reaches the secret storage, not even after being re-derived
statement ok
CREATE OR REPLACE PERSISTENT SECRET s2 (
    TYPE refresh_demo,
    SCOPE 'other://',
    REFRESH_INFO MAP {'account': 'second'}
)

restart

statement ok
LOAD '{BUILD_DIRECTORY}/test/extension/loadable_secret_refresh_demo.duckdb_extension';

statement ok
SET secret_directory='{TEST_DIR}/secret_transient_values'

query I
SELECT count(*) FROM duckdb_secrets(redact=false) WHERE secret_string LIKE '%token=%'
----
0
