# name: test/sql/projection/test_simple_projection.test
# description: Test simple projection statements
# group: [projection]

# create table
statement ok
CREATE TABLE a (i integer, j integer);

# scan empty table
query II
SELECT i, j FROM a;
----

query II
SELECT * FROM a;
----

# insertion: 1 affected row
query I
INSERT INTO a VALUES (42, 84);
----
1

query II
SELECT * FROM a;
----
42	84

# name alias
query II
SELECT x, y FROM a i1(x, y);
----
42	84

# partial name alias
query II
SELECT x, j FROM a i1(x);
----
42	84

# an alias that clashes with a remaining column renames that column
query II
SELECT j, j_1 FROM a i1(j);
----
42	84

query I
SELECT column_name FROM (DESCRIBE SELECT * FROM a i1(J));
----
J
j_1

statement error
SELECT * FROM a i1(x, y, z);
----
<REGEX>:Binder Error:.*has 2 columns available but 3 columns specified.*

# multiple insertions
statement ok
CREATE TABLE test (a INTEGER, b INTEGER);

statement ok
INSERT INTO test VALUES (11, 22), (12, 21), (13, 22)

# multiple projections
query II
SELECT a, b FROM test;
----
11	22
12	21
13	22

# basic expressions and filters
query II
SELECT a + 2, b FROM test WHERE a = 11;
----
13	22

query II
SELECT a + 2, b FROM test WHERE a = 12;
----
14	21

# casts
query T
SELECT cast(a AS VARCHAR) FROM test;
----
11
12
13

query I
SELECT cast(cast(a AS VARCHAR) as INTEGER) FROM test;
----
11
12
13

