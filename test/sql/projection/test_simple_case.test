# name: test/sql/projection/test_simple_case.test
# description: Test simple CASE expressions
# group: [projection]

# A simple CASE operand is evaluated once per input row.
statement ok
CREATE SEQUENCE simple_case_seq START 1

query I
SELECT count(*) FROM (
	SELECT CASE nextval('simple_case_seq') % 3
		WHEN 0 THEN 'zero'
		WHEN 1 THEN 'one'
		WHEN 2 THEN 'two'
		ELSE 'other'
	END AS result
	FROM range(10000)
) WHERE result = 'other'
----
0

# Existing comparison binding supplies NULL, coercion, and collation semantics.
query T
SELECT CASE NULL WHEN NULL THEN 'hit' ELSE 'miss' END
----
miss

query T
SELECT CASE 1 WHEN '1' THEN 'hit' ELSE 'miss' END
----
hit

query T
SELECT CASE 'ABC' COLLATE nocase WHEN 'abc' THEN 'hit' ELSE 'miss' END
----
hit

# Simple CASE retains its historical implicit result-column name.
query I
SELECT "CASE  WHEN ((1 = 1)) THEN (2) ELSE NULL END"
FROM (SELECT CASE 1 WHEN 1 THEN 2 END)
----
2

query I
SELECT simple_case_alias FROM (SELECT CASE 1 WHEN 1 THEN 2 END AS simple_case_alias)
----
2

query I
SELECT CASE (SELECT 2) WHEN 1 THEN 1 WHEN 2 THEN 2 ELSE 0 END
----
2

# Volatile branches of a deterministic simple CASE remain visible to the optimizer.
query II
SELECT count(*) FILTER (WHERE a = b), count(*)
FROM (
	SELECT
		CASE 1 WHEN 1 THEN random() ELSE 0 END a,
		CASE 1 WHEN 1 THEN random() ELSE 0 END b
	FROM range(10000)
)
----
0	10000

# The generated lambda parameter must not shadow a user column.
query I
SELECT CASE i WHEN 1 THEN __duckdb_simple_case_subject ELSE 0 END
FROM (VALUES (1, 42), (2, 99)) tbl(i, __duckdb_simple_case_subject)
ORDER BY i
----
42
0

# The internal invoke call cannot be shadowed by a user macro.
statement ok
CREATE SEQUENCE invoke_shadow_seq START 1

statement ok
CREATE VIEW invoke_shadow_view AS
	SELECT CASE nextval('invoke_shadow_seq') WHEN 1 THEN 42 ELSE 0 END

statement ok
CREATE MACRO invoke(x, y) AS 999

query I
SELECT CASE 1 WHEN 1 THEN 42 ELSE 0 END
----
42

query I
SELECT * FROM invoke_shadow_view
----
42

# CASE bodies that cannot execute inside a lambda keep working for deterministic operands.
query I
SELECT CASE 1 WHEN 1 THEN (SELECT 2) ELSE 0 END
----
2

query I
SELECT CASE 1 WHEN 1 THEN unnest([2]) ELSE unnest([3]) END
----
2

# Eligibility is determined after macro expansion.
statement ok
CREATE MACRO simple_case_subquery() AS (SELECT 2)

query I
SELECT CASE 1 WHEN 1 THEN simple_case_subquery() ELSE 0 END
----
2

statement ok
CREATE MACRO simple_case_unnest() AS unnest([2])

query I
SELECT CASE 1 WHEN 1 THEN simple_case_unnest() ELSE 0 END
----
2

statement ok
PREPARE simple_case_parameter AS
	SELECT CASE $1 WHEN 1 THEN simple_case_subquery() WHEN 2 THEN 3 ELSE 0 END

query I
EXECUTE simple_case_parameter(1)
----
2

# A single comparison contains only one operand reference and does not require invoke.
statement ok
CREATE SEQUENCE simple_case_single_subquery_seq START 1

query I
SELECT CASE nextval('simple_case_single_subquery_seq') WHEN 1 THEN (SELECT 2) ELSE 0 END
----
2

statement ok
CREATE SEQUENCE simple_case_single_unnest_seq START 1

query I
SELECT CASE nextval('simple_case_single_unnest_seq') WHEN 1 THEN unnest([2]) ELSE unnest([3]) END
----
2

statement ok
CREATE SEQUENCE simple_case_single_macro_subquery_seq START 1

query I
SELECT CASE nextval('simple_case_single_macro_subquery_seq') WHEN 1 THEN simple_case_subquery() ELSE 0 END
----
2

statement ok
CREATE SEQUENCE simple_case_single_macro_unnest_seq START 1

query I
SELECT CASE nextval('simple_case_single_macro_unnest_seq') WHEN 1 THEN simple_case_unnest() ELSE 0 END
----
2

# Do not silently use repeated-evaluation semantics for multiple comparisons.
statement error
SELECT CASE random() WHEN 0 THEN (SELECT 2) WHEN 1 THEN 3 ELSE 0 END
----
Binder Error: Simple CASE expressions with a volatile operand and a subquery or UNNEST in a branch are not supported

statement error
SELECT CASE random() WHEN 0 THEN unnest([2]) WHEN 1 THEN 3 ELSE 0 END
----
Binder Error: Simple CASE expressions with a volatile operand and a subquery or UNNEST in a branch are not supported

statement error
SELECT CASE random() WHEN 0 THEN simple_case_subquery() WHEN 1 THEN 3 ELSE 0 END
----
Binder Error: Simple CASE expressions with a volatile operand and a subquery or UNNEST in a branch are not supported

statement error
SELECT CASE random() WHEN 0 THEN simple_case_unnest() WHEN 1 THEN 3 ELSE 0 END
----
Binder Error: Simple CASE expressions with a volatile operand and a subquery or UNNEST in a branch are not supported

# Aggregate and window expressions can be captured when a volatile operand requires invoke.
statement ok
CREATE SEQUENCE simple_case_capture_seq START 1

query I
SELECT CASE nextval('simple_case_capture_seq') % 1 WHEN 0 THEN sum(i) ELSE 0 END FROM range(3) tbl(i)
----
3

query I
SELECT CASE nextval('simple_case_capture_seq') % 1 WHEN 0 THEN row_number() OVER () ELSE 0 END FROM range(3) tbl(i)
----
1
2
3

# The parsed operand survives current-format storage and is lowered again after restart.
load {TEST_DIR}/simple_case_storage.db

statement ok
CREATE SEQUENCE stored_simple_case_seq START 1

statement ok
CREATE VIEW stored_simple_case AS
	SELECT CASE nextval('stored_simple_case_seq') % 3
		WHEN 0 THEN 'zero'
		WHEN 1 THEN 'one'
		WHEN 2 THEN 'two'
		ELSE 'other'
	END AS result
	FROM range(10000)

statement ok
CREATE VIEW stored_simple_case_name AS SELECT CASE 1 WHEN 1 THEN 2 END

restart

query I
SELECT count(*) FROM stored_simple_case WHERE result = 'other'
----
0

query I
SELECT "CASE  WHEN ((1 = 1)) THEN (2) ELSE NULL END" FROM stored_simple_case_name
----
2

# Old storage versions receive the historical searched-CASE representation.
statement ok
ATTACH '{TEST_DIR}/simple_case_legacy.db' AS legacy (STORAGE_VERSION 'v1.5.0')

statement ok
CREATE TABLE legacy.simple_case_input AS SELECT * FROM range(2) tbl(i)

statement ok
CREATE SEQUENCE legacy.simple_case_seq START 3

statement ok
CREATE VIEW legacy.simple_case AS
	SELECT i, CASE nextval('legacy.simple_case_seq') % 3
		WHEN 0 THEN 'zero'
		WHEN 1 THEN 'one'
		WHEN 2 THEN 'two'
		ELSE 'other'
	END AS result
	FROM legacy.simple_case_input

statement ok
DETACH legacy

statement ok
ATTACH '{TEST_DIR}/simple_case_legacy.db' AS legacy

# Lossy legacy serialization deliberately retains the behavior of old DuckDB versions.
query IT
SELECT i, result FROM legacy.simple_case ORDER BY i
----
0	zero
1	other
