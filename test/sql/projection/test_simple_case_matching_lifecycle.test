# name: test/sql/projection/test_simple_case_matching_lifecycle.test
# description: Expression matching preserves binding phases, duplicate policies, and query scopes
# group: [projection]

# DISTINCT and ORDER BY resolve exact expressions before the SELECT list is bound.
statement ok
CREATE SEQUENCE matching_distinct_seq

query I
SELECT DISTINCT ON (CASE nextval('matching_distinct_seq')%2 WHEN 0 THEN 0 ELSE 1 END)
       CASE nextval('matching_distinct_seq')%2 WHEN 0 THEN 0 ELSE 1 END AS k
FROM range(4) ORDER BY CASE nextval('matching_distinct_seq')%2 WHEN 0 THEN 0 ELSE 1 END
----
0
1

query I
SELECT currval('matching_distinct_seq')
----
4

# Ordinary SELECT permits duplicate expressions, while a set operation reports ambiguity.
query II
SELECT i+0 AS a, i+0 AS b FROM range(3) t(i) ORDER BY i+0 DESC
----
2	2
1	1
0	0

statement error
SELECT i+0 AS a, i+0 AS b FROM range(3) t(i)
UNION ALL SELECT 3, 4 ORDER BY i+0
----
Ambiguous reference to column

# An exact match takes precedence over another compatible output, in either spelling.
query II
SELECT CASE i WHEN 1 THEN 1 ELSE 0 END AS a, CASE WHEN i=1 THEN 1 ELSE 0 END AS b
FROM range(2) t(i) UNION ALL SELECT -1, 9
ORDER BY CASE i WHEN 1 THEN 1 ELSE 0 END
----
-1	9
0	0
1	1

query II
SELECT CASE i WHEN 1 THEN 1 ELSE 0 END AS a, CASE WHEN i=1 THEN 1 ELSE 0 END AS b
FROM range(2) t(i) UNION ALL SELECT -1, 9
ORDER BY CASE WHEN i=1 THEN 1 ELSE 0 END
----
0	0
1	1
-1	9

# An error after registering an outer aggregate unwinds all nested binding scopes.
statement error
SELECT (SELECT CASE sum(i) WHEN 1 THEN 1 WHEN 2 THEN 2 ELSE missing END)
FROM range(3) t(i)
----
Referenced column "missing" not found

query I
SELECT (SELECT CASE sum(i) WHEN 3 THEN 8 WHEN 4 THEN 9 ELSE 0 END) AS k
FROM range(3) t(i) UNION ALL SELECT 10
ORDER BY (SELECT CASE WHEN sum(i)=3 THEN 8 WHEN sum(i)=4 THEN 9 ELSE 0 END)
----
8
10

# MATCH_RECOGNIZE binds DEFINE and MEASURES in separate SELECT scopes.
query II
SELECT k, k_copy FROM (VALUES (1), (2), (3)) t(i) MATCH_RECOGNIZE (
    ORDER BY i
    MEASURES CASE sum(A.i) WHEN 6 THEN 10 WHEN 7 THEN 20 ELSE 30 END AS k, k+1 AS k_copy
    ONE ROW PER MATCH PATTERN (A+)
    DEFINE A AS CASE count(A.i) WHEN 1 THEN true WHEN 2 THEN true ELSE A.i=3 END
)
----
10	11

statement ok
CREATE SEQUENCE matching_measure_seq

query I
SELECT k FROM (VALUES (1), (2)) t(i) MATCH_RECOGNIZE (
    ORDER BY i
    MEASURES CASE sum(nextval('matching_measure_seq')) WHEN -1 THEN 10 WHEN -2 THEN 20 ELSE 30 END AS k
    ONE ROW PER MATCH PATTERN (A+) DEFINE A AS true
)
----
30

query I
SELECT currval('matching_measure_seq')
----
2

# Duplicate inferred groups retain last-exact and first-compatible lookup precedence.
statement ok
CREATE SEQUENCE matching_inferred_exact_seq

query II
SELECT CASE i WHEN 0 THEN nextval('matching_inferred_exact_seq') ELSE 0 END AS a,
       CASE i WHEN 0 THEN nextval('matching_inferred_exact_seq') ELSE 0 END AS b
FROM range(1) t(i) GROUP BY ALL
HAVING CASE i WHEN 0 THEN nextval('matching_inferred_exact_seq') ELSE 0 END = 2
----
1	2

query I
SELECT currval('matching_inferred_exact_seq')
----
2

statement ok
CREATE SEQUENCE matching_inferred_compatible_seq

query II
SELECT CASE i WHEN 0 THEN nextval('matching_inferred_compatible_seq') ELSE 0 END AS a,
       CASE i WHEN 0 THEN nextval('matching_inferred_compatible_seq') ELSE 0 END AS b
FROM range(1) t(i) GROUP BY ALL
HAVING CASE WHEN i=0 THEN nextval('matching_inferred_compatible_seq') ELSE 0 END = 1
----
1	2

query I
SELECT currval('matching_inferred_compatible_seq')
----
2

# A collation's synthesized first() still reads a materialized group value.
statement ok
CREATE SEQUENCE matching_collated_seq

query I
SELECT CASE ((nextval('matching_collated_seq')*0+i*0)::VARCHAR COLLATE nocase)
       WHEN '0' THEN 1 WHEN '1' THEN 2 ELSE 3 END AS k
FROM range(3) t(i) GROUP BY ((nextval('matching_collated_seq')*0+i*0)::VARCHAR COLLATE nocase)
UNION ALL SELECT 9
ORDER BY CASE WHEN ((nextval('matching_collated_seq')*0+i*0)::VARCHAR COLLATE nocase)='0' THEN 1
              WHEN ((nextval('matching_collated_seq')*0+i*0)::VARCHAR COLLATE nocase)='1' THEN 2 ELSE 3 END
----
1
9

query I
SELECT currval('matching_collated_seq')
----
6
