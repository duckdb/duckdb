# name: test/sql/logging/http_request_log_redaction.test
# description: HTTP request logging redacts headers unless explicitly enabled
# group: [logging]

require httpfs

require noforcestorage

require skip_reload

statement ok
CALL enable_logging('HTTP', storage = 'memory');

statement ok
SET http_retries = 0;

statement ok
CREATE SECRET http_log_headers (
    TYPE HTTP,
    SCOPE 'http://localhost:2338/',
    EXTRA_HTTP_HEADERS MAP {
        'aUtHoRiZaTiOn': 'dummy-authorization',
        'Cookie': 'dummy-cookie',
        'x-amz-security-token': 'dummy-token',
        'X-Custom': 'dummy-custom',
        'ETag': 'dummy-etag',
        'AcCePt': 'text/csv',
        'AcCePt-EnCoDiNg': 'gzip'
    }
);

# Failed requests must also redact sensitive headers while preserving allowed protocol metadata.
statement error
FROM 'http://localhost:2338/header-redaction.csv';
----

query TT rowsort
SELECT entry.key, entry.value
FROM duckdb_logs_parsed('HTTP'), UNNEST(map_entries(request.headers)) AS headers(entry)
WHERE lower(entry.key) IN ('authorization', 'cookie', 'x-amz-security-token', 'x-custom', 'etag', 'accept', 'accept-encoding');
----
AcCePt	text/csv
AcCePt-EnCoDiNg	gzip
Cookie	redacted
ETag	redacted
X-Custom	redacted
aUtHoRiZaTiOn	redacted
x-amz-security-token	redacted

statement ok
SET redact_sensitive_logs = false;

statement ok
CALL truncate_duckdb_logs();

statement error
FROM 'http://localhost:2338/header-redaction.csv';
----

query TT rowsort
SELECT entry.key, entry.value
FROM duckdb_logs_parsed('HTTP'), UNNEST(map_entries(request.headers)) AS headers(entry)
WHERE lower(entry.key) IN ('authorization', 'cookie', 'x-amz-security-token', 'x-custom', 'etag', 'accept', 'accept-encoding');
----
AcCePt	text/csv
AcCePt-EnCoDiNg	gzip
Cookie	dummy-cookie
ETag	dummy-etag
X-Custom	dummy-custom
aUtHoRiZaTiOn	dummy-authorization
x-amz-security-token	dummy-token

statement ok
RESET redact_sensitive_logs;

query I
SELECT current_setting('redact_sensitive_logs');
----
true

statement ok
CALL truncate_duckdb_logs();

statement error
FROM 'http://localhost:2338/header-redaction.csv';
----

query I
SELECT count(*) > 0 AND bool_and(entry.value = 'redacted')
FROM duckdb_logs_parsed('HTTP'), UNNEST(map_entries(request.headers)) AS headers(entry)
WHERE lower(entry.key) = 'authorization';
----
true
