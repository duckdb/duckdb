# name: test/sql/logging/logging_non_queryable_storage.test
# description: Report an error when the default log sink cannot be queried
# group: [logging]

require noforcestorage

# a stdout default log sink, while logging is off
statement ok
CALL enable_logging(type := 'stdout');

statement ok
CALL disable_logging();

statement error
SELECT * FROM duckdb_logs();
----
Invalid Configuration Error: Log sink 'default' is a 'stdout' log sink, which cannot be read. To read log entries, store them in a log sink of their own, e.g. CALL enable_log_sink('my_logs', type := 'memory')

statement error
SELECT * FROM duckdb_log_contexts();
----
Invalid Configuration Error: Log sink 'default' is a 'stdout' log sink, which cannot be read. To read log entries, store them in a log sink of their own, e.g. CALL enable_log_sink('my_logs', type := 'memory')

statement error
SELECT * FROM duckdb_logs(denormalized_table = true);
----
Invalid Configuration Error: Log sink 'default' is a 'stdout' log sink, which cannot be read. To read log entries, store them in a log sink of their own, e.g. CALL enable_log_sink('my_logs', type := 'memory')

statement error
SELECT * FROM duckdb_logs;
----
Invalid Configuration Error: Log sink 'default' is a 'stdout' log sink, which cannot be read. To read log entries, store them in a log sink of their own, e.g. CALL enable_log_sink('my_logs', type := 'memory')

statement ok
CALL enable_logging(type := 'memory');

statement ok
CALL disable_logging();

statement ok
CALL truncate_duckdb_logs();

# A queryable sink can be empty without producing an error.
query I
SELECT count(*) FROM duckdb_logs();
----
0

query I
SELECT count(*) FROM duckdb_log_contexts();
----
0

statement ok
CALL enable_logging('QueryLog');

statement ok
SELECT 42;

statement ok
CALL disable_logging();

query I
SELECT count(*) FROM duckdb_logs() WHERE message = 'SELECT 42;';
----
1

query I
SELECT count(*) FROM duckdb_logs(denormalized_table = true) WHERE message = 'SELECT 42;';
----
1
