# name: test/sql/logging/logging_types.test
# group: [logging]

require noforcestorage

statement ok
CALL enable_logging('FileSystem');

statement ok
copy (select 1 as a) to '{TEST_DIR}/par.csv'

statement ok
FROM '{TEST_DIR}/par.csv'

query IIIIIIII
SELECT type, log_level, scope, fs, parse_filename(path), op, bytes, pos
FROM duckdb_logs_parsed('FileSystem')
WHERE op != 'WRITE'
ORDER BY timestamp
----
FileSystem	TRACE	CONNECTION	LocalFileSystem	par.csv	OPEN	NULL	NULL
FileSystem	TRACE	CONNECTION	LocalFileSystem	par.csv	CLOSE	NULL	NULL
FileSystem	TRACE	CONNECTION	LocalFileSystem	par.csv	OPEN	NULL	NULL
FileSystem	TRACE	CONNECTION	LocalFileSystem	par.csv	READ	4	0
FileSystem	TRACE	CONNECTION	LocalFileSystem	par.csv	CLOSE	NULL	NULL

query IIIIIIIII
SELECT type, log_level, scope, fs, parse_filename(path), op, sum(bytes), min(pos), max(pos + bytes)
FROM duckdb_logs_parsed('FileSystem')
WHERE op = 'WRITE'
GROUP BY ALL
----
FileSystem	TRACE	CONNECTION	LocalFileSystem	par.csv	WRITE	4	0	4

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging('QueryLog');

statement ok
SELECT 'hallo' as value;

query IIII
SELECT type, log_level, scope, message FROM duckdb_logs_parsed('QueryLog') ORDER BY timestamp
----
QueryLog	INFO	CONNECTION	SELECT 'hallo' as value;

statement ok
SELECT type, log_level, scope, message FROM duckdb_logs WHERE type='QueryLog';

# the checkpoint and transaction log types can be selected and parsed
statement ok
CALL enable_logging(log_types := ['Checkpoint', 'Transaction']);

query II
SELECT current_setting('enabled_log_types').split(',').list_sort(), current_setting('logging_level')
----
[Checkpoint, Transaction]	DEBUG

statement ok
ATTACH '{TEST_DIR}/logging_types_checkpoint.db' AS checkpointed;

statement ok
CREATE OR REPLACE TABLE checkpointed.numbers AS SELECT range AS n FROM range(10);

statement ok
CHECKPOINT checkpointed;

query III
SELECT DISTINCT log_level, database, "table" FROM duckdb_logs_parsed('Checkpoint') WHERE database = 'checkpointed'
----
DEBUG	checkpointed	numbers

# the type of the log entry is 'type', the one of the transaction 'type_1'
query II
SELECT DISTINCT log_level, type_1 FROM duckdb_logs_parsed('Transaction') WHERE database = 'checkpointed' AND type_1 = 'Start Checkpoint'
----
DEBUG	Start Checkpoint
