# name: test/sql/logging/secret_query_log_redaction.test
# description: Secret creation is redacted in query logs and query log files
# group: [logging]

require noforcestorage

require skip_reload

# The test runner permits unredacted secrets at database creation.
statement ok
CALL enable_logging('QueryLog', storage = 'memory');

statement ok
CREATE SECRET log_unredacted (TYPE HTTP, BEARER_TOKEN 'dummy-unredacted-token');

query T
SELECT message FROM duckdb_logs WHERE type = 'QueryLog' AND starts_with(message, 'CREATE SECRET log_unredacted');
----
CREATE SECRET log_unredacted (TYPE HTTP, BEARER_TOKEN 'dummy-unredacted-token');

statement ok
CALL disable_logging();

statement ok
SET allow_unredacted_secrets = false;

# Verification can replace the parsed statement before it reaches the logger.
foreach verification NONE COPY_STATEMENT REPARSE_STATEMENT

statement ok
SET debug_verify_statement = '{verification}';

statement ok
CALL truncate_duckdb_logs();

statement ok
CALL enable_logging('QueryLog', storage = 'memory');

statement ok
SET log_query_path = '{TEST_DIR}/secret_query_{verification}.log';

statement ok
CREATE SECRET log_secret_{verification} (
    TYPE HTTP,
    PROVIDER CONFIG,
    SCOPE 'https://dummy-scope.example/',
    BEARER_TOKEN 'dummy-original-token',
    EXTRA_HTTP_HEADERS MAP {'Authorization': 'dummy-header-token'}
);

statement ok
CREATE OR REPLACE SECRET log_secret_{verification} (TYPE HTTP, BEARER_TOKEN 'dummy-replacement-token', SCOPE 'https://dummy-scope.example/');

statement ok
EXPLAIN CREATE SECRET log_explained_{verification} (TYPE HTTP, BEARER_TOKEN 'dummy-explain-token');

# Binding errors occur after query logging, so these statements must also be redacted.
statement error
CREATE SECRET log_invalid_{verification} (TYPE HTTP, UNKNOWN_OPTION 'dummy-invalid-token');
----
Unknown parameter "unknown_option"

query I
select  42 /* keep formatting */ AS answer;
----
42

statement ok
PREPARE ordinary_query AS SELECT $1;

query T
EXECUTE ordinary_query('ordinary-value');
----
ordinary-value

statement ok
SET log_query_path = '';

statement ok
CALL disable_logging();

# Secret statements are replaced as a whole, including EXPLAIN and binding failures.
query I
SELECT count(*) FROM duckdb_logs WHERE type = 'QueryLog' AND message = 'redacted';
----
4

query I
SELECT count(*) FROM duckdb_logs
WHERE type = 'QueryLog' AND (
    contains(message, 'dummy-') OR contains(message, 'log_secret_')
    OR contains(message, 'log_explained_') OR contains(message, 'log_invalid_')
);
----
0

# Unchanged SQL keeps its original whitespace and comments.
query I
SELECT count(*) FROM duckdb_logs WHERE type = 'QueryLog' AND message = 'select  42 /* keep formatting */ AS answer;';
----
1

query I
SELECT count(*) FROM duckdb_logs WHERE type = 'QueryLog' AND message IN (
    'PREPARE ordinary_query AS SELECT $1;',
    'EXECUTE ordinary_query(''ordinary-value'');'
);
----
2

query I
SELECT count(*) FROM read_text('{TEST_DIR}/secret_query_{verification}.log'),
UNNEST(string_split(content, chr(10))) AS lines(message)
WHERE message = 'redacted';
----
4

query IIIII
SELECT NOT contains(content, 'dummy-'), NOT contains(content, 'log_secret_'),
       contains(content, 'select  42 /* keep formatting */ AS answer;'),
       contains(content, 'PREPARE ordinary_query AS SELECT $1;'),
       contains(content, 'EXECUTE ordinary_query(''ordinary-value'');')
FROM read_text('{TEST_DIR}/secret_query_{verification}.log');
----
true	true	true	true	true

# Logging must not change the actual secret's scope.
query T
SELECT scope[1] FROM duckdb_secrets() WHERE name = 'log_secret_{verification}';
----
https://dummy-scope.example/

endloop

statement ok
RESET debug_verify_statement;
