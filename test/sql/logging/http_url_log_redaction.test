# name: test/sql/logging/http_url_log_redaction.test
# description: Core HTTP logging redacts URL query strings and fragments
# group: [logging]

require noforcestorage

require skip_reload

statement ok
SET extension_directory = '{TEST_DIR}/http_url_log_redaction';

statement ok
SET autoload_known_extensions = false;

statement ok
SET autoinstall_known_extensions = false;

statement ok
CALL enable_logging('HTTP', storage = 'memory');

# INSTALL over HTTP uses core's built-in client without HTTPFS. GitHub answers with a 301 to the same
# url over HTTPS, which the installer follows, so every INSTALL logs the supplied url and the url of the
# redirect hop (the hop is requested, but may not be logged, when HTTPS is unavailable). No extension is
# installed either way. The redirect keeps the query of the supplied url; the fragment is never sent to
# the server, so the hop after a url with a fragment has none. Every logged url must be redacted.
foreach redact true false

statement ok
SET redact_http_logs = {redact};

# URLs without sensitive components retain the host and path.
statement ok
CALL truncate_duckdb_logs();

statement maybe
INSTALL 'http://github.com/duckdb/duckdb';
----

query I
SELECT count(*) > 0 AND bool_and(request.url IN (
    'http://github.com/duckdb/duckdb',
    'https://github.com/duckdb/duckdb'))
FROM duckdb_logs_parsed('HTTP');
----
true

# Redact the entire query, including unknown keys and values containing '@'.
statement ok
CALL truncate_duckdb_logs();

statement maybe
INSTALL 'http://github.com/duckdb/duckdb?custom_token=dummy-token&email=dummy@example.com';
----

query I
SELECT count(*) > 0 AND bool_and(request.url IN (
    CASE WHEN {redact}
        THEN 'http://github.com/duckdb/duckdb?redacted'
        ELSE 'http://github.com/duckdb/duckdb?custom_token=dummy-token&email=dummy@example.com'
    END,
    CASE WHEN {redact}
        THEN 'https://github.com/duckdb/duckdb?redacted'
        ELSE 'https://github.com/duckdb/duckdb?custom_token=dummy-token&email=dummy@example.com'
    END))
FROM duckdb_logs_parsed('HTTP');
----
true

# Fragments in the supplied URL can contain credentials.
statement ok
CALL truncate_duckdb_logs();

statement maybe
INSTALL 'http://github.com/duckdb/duckdb#dummy-token';
----

query I
SELECT count(*) > 0 AND bool_and(request.url IN (
    CASE WHEN {redact}
        THEN 'http://github.com/duckdb/duckdb#redacted'
        ELSE 'http://github.com/duckdb/duckdb#dummy-token'
    END,
    'https://github.com/duckdb/duckdb'))
FROM duckdb_logs_parsed('HTTP');
----
true

# Redact the query and any following fragment together.
statement ok
CALL truncate_duckdb_logs();

statement maybe
INSTALL 'http://github.com/duckdb/duckdb?token=dummy-token#dummy-fragment';
----

query I
SELECT count(*) > 0 AND bool_and(request.url IN (
    CASE WHEN {redact}
        THEN 'http://github.com/duckdb/duckdb?redacted'
        ELSE 'http://github.com/duckdb/duckdb?token=dummy-token#dummy-fragment'
    END,
    CASE WHEN {redact}
        THEN 'https://github.com/duckdb/duckdb?redacted'
        ELSE 'https://github.com/duckdb/duckdb?token=dummy-token'
    END))
FROM duckdb_logs_parsed('HTTP');
----
true

# A question mark inside a fragment must not leave the fragment exposed.
statement ok
CALL truncate_duckdb_logs();

statement maybe
INSTALL 'http://github.com/duckdb/duckdb#dummy-fragment?token=dummy-token';
----

query I
SELECT count(*) > 0 AND bool_and(request.url IN (
    CASE WHEN {redact}
        THEN 'http://github.com/duckdb/duckdb#redacted'
        ELSE 'http://github.com/duckdb/duckdb#dummy-fragment?token=dummy-token'
    END,
    'https://github.com/duckdb/duckdb'))
FROM duckdb_logs_parsed('HTTP');
----
true

# An '@' in the path is not userinfo.
statement ok
CALL truncate_duckdb_logs();

statement maybe
INSTALL 'http://github.com/duckdb/duckdb@dummy';
----

query I
SELECT count(*) > 0 AND bool_and(request.url IN (
    'http://github.com/duckdb/duckdb@dummy',
    'https://github.com/duckdb/duckdb@dummy'))
FROM duckdb_logs_parsed('HTTP');
----
true

# Encoded delimiters in the path do not begin a query or fragment.
statement ok
CALL truncate_duckdb_logs();

statement maybe
INSTALL 'http://github.com/duckdb/duckdb%3Fdummy%23dummy%40dummy';
----

query I
SELECT count(*) > 0 AND bool_and(request.url IN (
    'http://github.com/duckdb/duckdb%3Fdummy%23dummy%40dummy',
    'https://github.com/duckdb/duckdb%3Fdummy%23dummy%40dummy'))
FROM duckdb_logs_parsed('HTTP');
----
true

# An empty query still retains its delimiter and gets a redaction marker. The redirect may or may not
# keep the empty query.
statement ok
CALL truncate_duckdb_logs();

statement maybe
INSTALL 'http://github.com/duckdb/duckdb?';
----

query I
SELECT count(*) > 0 AND bool_and(request.url IN (
    CASE WHEN {redact}
        THEN 'http://github.com/duckdb/duckdb?redacted'
        ELSE 'http://github.com/duckdb/duckdb?'
    END,
    CASE WHEN {redact}
        THEN 'https://github.com/duckdb/duckdb?redacted'
        ELSE 'https://github.com/duckdb/duckdb?'
    END,
    'https://github.com/duckdb/duckdb'))
FROM duckdb_logs_parsed('HTTP');
----
true

endloop

statement ok
RESET redact_http_logs;
