# name: test/sql/logging/logging_multiple_sinks.test
# description: Enable log sinks next to the default log sink with enable_log_sink and read them with duckdb_logs(name)
# group: [logging]

# enabling a log sink turns logging on
query I
SELECT current_setting('enable_logging')::BOOLEAN
----
false

statement ok
CALL enable_log_sink('memory')

query I
SELECT current_setting('enable_logging')::BOOLEAN
----
true

# the sink named 'memory' is a memory sink of its own, the default log sink only receives the log entries once
# logging is enabled with enable_logging or SET enable_logging
statement ok
SELECT write_log('once')

query I
SELECT count(*) FROM duckdb_logs('memory') WHERE message = 'once'
----
1

query I
SELECT count(*) FROM duckdb_logs(sink := 'memory') WHERE message = 'once'
----
1

query I
SELECT count(*) FROM duckdb_logs WHERE message = 'once'
----
0

query I
SELECT count(*) FROM duckdb_logs('default') WHERE message = 'once'
----
0

# duckdb_log_sinks lists the default log sink first, then the named sinks by name, with the options the user set
query IIII
SELECT name, type, map_keys(config), active FROM duckdb_log_sinks()
----
default	memory	[]	false
memory	memory	[]	true

statement ok
SET enable_logging = true

statement ok
SELECT write_log('to both')

query I
SELECT count(*) FROM duckdb_logs WHERE message = 'to both'
----
1

query I
SELECT count(*) FROM duckdb_logs('memory') WHERE message = 'to both'
----
1

# a NULL sink is the default log sink
query I
SELECT count(*) FROM duckdb_logs(NULL) WHERE message = 'to both'
----
1

query II
SELECT name, active FROM duckdb_log_sinks()
----
default	true
memory	true

# duckdb_logs has the context of the log entries, denormalized_table=false leaves it out
query II
SELECT scope IS NOT NULL, message FROM duckdb_logs('memory') WHERE message = 'to both'
----
true	to both

statement error
SELECT scope FROM duckdb_logs('memory', denormalized_table=false)
----
Referenced column "scope" not found

# without a type the name is the type, an unknown name does not create a sink
statement error
CALL enable_log_sink('audit')
----
Log sink 'audit' is not yet registered

statement error
CALL enable_log_sink('file')
----
The 'file' log sink requires a path, e.g. CALL enable_log_sink('file', config={path: 'log.csv'})

statement error
CALL enable_log_sink('')
----
The log sink name cannot be empty

statement error
CALL enable_log_sink(NULL)
----
The log sink name cannot be NULL

statement error
CALL enable_log_sink('stdout', config=42)
----
enable_log_sink: config must be a struct

statement error
CALL enable_log_sink('stdout', config=NULL)
----
enable_log_sink: config must be a struct

# the config is passed as a struct, enable_logging's sink_* shortcuts are not parameters of enable_log_sink
statement error
CALL enable_log_sink('stdout', sink_path='log.csv')
----
Invalid named parameter

# the default log sink belongs to enable_logging
statement error
CALL enable_log_sink('default')
----
The 'default' log sink is the one enable_logging configures

statement error
CALL enable_log_sink('DEFAULT', type='memory')
----
The 'default' log sink is the one enable_logging configures

statement error
CALL disable_log_sink('default')
----
The 'default' log sink cannot be disabled

# a sink that is not enabled cannot be disabled or read
statement ok
CALL disable_log_sink('memory')

statement error
CALL disable_log_sink('memory')
----
Log sink 'memory' is not enabled. The default log sink is a 'memory' log sink, its name is 'default'

statement error
SELECT * FROM duckdb_logs('memory')
----
Log sink 'memory' is not enabled. The default log sink is a 'memory' log sink, its name is 'default'

statement error
CALL disable_log_sink('stdout')
----
Log sink 'stdout' is not enabled

statement error
SELECT * FROM duckdb_logs('stdout')
----
Log sink 'stdout' is not enabled

statement error
SELECT * FROM duckdb_logs('unknown')
----
Log sink 'unknown' does not exist

statement error
SELECT * FROM duckdb_log_contexts('unknown')
----
Log sink 'unknown' does not exist

# a stdout sink cannot be read
statement ok
CALL enable_log_sink('STDOUT')

query II
SELECT name, type FROM duckdb_log_sinks()
----
default	memory
stdout	stdout

statement error
SELECT count(*) FROM duckdb_logs('stdout')
----
Log sink 'stdout' does not support this query

statement error
SELECT count(*) FROM duckdb_log_contexts('stdout')
----
Log sink 'stdout' does not support this query

statement error
SELECT count(*) FROM duckdb_logs('stdout', denormalized_table=true)
----
Log sink 'stdout' does not support this query

# sink names are case insensitive
statement ok
CALL disable_log_sink('Stdout')

statement error
CALL disable_log_sink('stdout')
----
Log sink 'stdout' is not enabled

query II
SELECT name, type FROM duckdb_log_sinks()
----
default	memory

# while logging is disabled no sink receives the log entries
statement ok
CALL enable_log_sink('errors', type='memory')

statement ok
CALL disable_logging()

query II
SELECT name, active FROM duckdb_log_sinks()
----
default	false
errors	false

# enabling a sink turns logging on again, without the default log sink
statement ok
CALL disable_log_sink('errors')

statement ok
CALL enable_log_sink('errors', type='memory')

query II
SELECT name, active FROM duckdb_log_sinks()
----
default	false
errors	true

# disabling the last sink that receives the log entries turns logging off
statement ok
CALL disable_log_sink('errors')

query I
SELECT current_setting('enable_logging')::BOOLEAN
----
false
