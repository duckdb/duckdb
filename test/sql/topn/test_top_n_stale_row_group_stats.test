# name: test/sql/topn/test_top_n_stale_row_group_stats.test
# description: LIMIT pruning must not treat stale row-group bounds as live rows
# group: [topn]

require no_alternative_verify

load {TEST_DIR}/top_n_stale_row_group_stats_main.duckdb

statement ok
SET threads TO 1

statement ok
ATTACH '{TEST_DIR}/top_n_stale_row_group_stats_delete.duckdb' AS db_delete (ROW_GROUP_SIZE 2048)

statement ok
CREATE TABLE db_delete.t AS
SELECT i AS id, CASE WHEN i < 2048 AND i % 2 = 0 THEN NULL ELSE i END AS k FROM range(6144) r(i)

restart

statement ok
ATTACH '{TEST_DIR}/top_n_stale_row_group_stats_delete.duckdb' AS db_delete

statement ok
SET threads TO 1

statement ok
DELETE FROM db_delete.t WHERE id < 2048

query I
SELECT k FROM db_delete.t ORDER BY k LIMIT 1
----
2048

query I
SELECT k FROM db_delete.t ORDER BY k LIMIT 3
----
2048
2049
2050

statement ok
ATTACH '{TEST_DIR}/top_n_stale_row_group_stats_update_null.duckdb' AS db_update_null (ROW_GROUP_SIZE 2048)

statement ok
CREATE TABLE db_update_null.t AS
SELECT i AS id, CASE WHEN i < 2048 AND i % 2 = 0 THEN NULL ELSE i END AS k FROM range(6144) r(i)

restart

statement ok
ATTACH '{TEST_DIR}/top_n_stale_row_group_stats_update_null.duckdb' AS db_update_null

statement ok
SET threads TO 1

statement ok
UPDATE db_update_null.t SET k = NULL WHERE id < 2048

query I
SELECT k FROM db_update_null.t ORDER BY k LIMIT 1
----
2048

query I
SELECT k FROM db_update_null.t ORDER BY k LIMIT 3
----
2048
2049
2050

query I
SELECT k FROM db_update_null.t ORDER BY k NULLS FIRST LIMIT 1 OFFSET 2047
----
NULL

statement ok
SET disabled_optimizers = 'row_group_pruner'

query I
SELECT k FROM db_update_null.t ORDER BY k NULLS FIRST LIMIT 1 OFFSET 2047
----
NULL

statement ok
RESET disabled_optimizers

query I
SELECT k FROM db_update_null.t ORDER BY k NULLS LAST LIMIT 1 OFFSET 1
----
2049

statement ok
SET disabled_optimizers = 'row_group_pruner'

query I
SELECT k FROM db_update_null.t ORDER BY k NULLS LAST LIMIT 1 OFFSET 1
----
2049

statement ok
RESET disabled_optimizers

statement ok
ATTACH '{TEST_DIR}/top_n_stale_row_group_stats_overlap_delete.duckdb' AS db_overlap_delete (ROW_GROUP_SIZE 2048)

statement ok
CREATE TABLE db_overlap_delete.t AS
SELECT i AS id, (CASE WHEN i = 9 THEN 5 WHEN i < 2048 THEN 0 ELSE 3 END)::BIGINT AS k
FROM range(4096) r(i)

restart

statement ok
ATTACH '{TEST_DIR}/top_n_stale_row_group_stats_overlap_delete.duckdb' AS db_overlap_delete

statement ok
SET threads TO 1

statement ok
DELETE FROM db_overlap_delete.t WHERE id = 9

query I
SELECT k FROM db_overlap_delete.t ORDER BY k DESC LIMIT 1
----
3

statement ok
ATTACH '{TEST_DIR}/top_n_stale_row_group_stats_overlap_update.duckdb' AS db_overlap_update (ROW_GROUP_SIZE 2048)

statement ok
CREATE TABLE db_overlap_update.t AS
SELECT i AS id, (CASE WHEN i = 9 THEN 5 WHEN i < 2048 THEN 0 ELSE 3 END)::BIGINT AS k
FROM range(4096) r(i)

restart

statement ok
ATTACH '{TEST_DIR}/top_n_stale_row_group_stats_overlap_update.duckdb' AS db_overlap_update

statement ok
SET threads TO 1

statement ok
BEGIN TRANSACTION

statement ok
UPDATE db_overlap_update.t SET k = 0 WHERE id = 9

query I
SELECT k FROM db_overlap_update.t ORDER BY k DESC LIMIT 1
----
3

statement ok
COMMIT

statement ok
SET threads TO 1

statement ok
ATTACH '{TEST_DIR}/top_n_stale_row_group_stats_partial_delete.duckdb' AS db_partial (ROW_GROUP_SIZE 2048)

statement ok
CREATE TABLE db_partial.t AS
SELECT i AS id, CASE WHEN i < 2048 AND i % 2 = 0 THEN NULL ELSE i END AS k FROM range(6144) r(i)

statement ok
DELETE FROM db_partial.t WHERE id < 1024

query I
SELECT k FROM db_partial.t ORDER BY k LIMIT 1
----
1025

restart

statement ok
ATTACH '{TEST_DIR}/top_n_stale_row_group_stats_partial_delete.duckdb' AS db_partial

statement ok
SET threads TO 1

query I
SELECT k FROM db_partial.t ORDER BY k LIMIT 1
----
1025

statement ok
ATTACH ':memory:' AS mem

statement ok
CREATE TABLE mem.unchanged AS SELECT i AS id, i AS k FROM range(1228800) r(i)

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'}

query II
EXPLAIN ANALYZE SELECT k FROM mem.unchanged ORDER BY k LIMIT 200000
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 2 / 10.*245,760 rows.*

statement ok
CREATE TABLE mem.sparse_delete AS SELECT i AS id, i AS k FROM range(1228800) r(i)

statement ok
DELETE FROM mem.sparse_delete WHERE id % 122880 = 7

query II
EXPLAIN ANALYZE SELECT k FROM mem.sparse_delete ORDER BY k LIMIT 200000
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 2 / 10.*245,758 rows.*
