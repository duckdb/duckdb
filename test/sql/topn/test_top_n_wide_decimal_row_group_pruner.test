# name: test/sql/topn/test_top_n_wide_decimal_row_group_pruner.test
# description: Row group reordering and pruning on DECIMALs wider than 38 digits (BIGNUM statistics)
# group: [topn]

load {TEST_DIR}/top_n_wide_decimal.db

# wide decimal columns need the latest storage version
statement ok
ATTACH '{TEST_DIR}/top_n_wide_decimal_wd.db' AS wd (STORAGE_VERSION 'latest');

statement ok
CREATE TABLE wd.t(d DECIMAL(40,0));

statement ok
INSERT INTO wd.t VALUES (NULL), (1);

query I
SELECT d FROM wd.t ORDER BY d LIMIT 1;
----
1

query I
SELECT d FROM wd.t ORDER BY d DESC LIMIT 1;
----
1

query I
SELECT d FROM wd.t ORDER BY d NULLS FIRST LIMIT 1;
----
NULL

query I
SELECT d FROM wd.t ORDER BY d DESC NULLS LAST LIMIT 1 OFFSET 1;
----
NULL

# several row groups of 40-digit values with NULLs sprinkled in
statement ok
CREATE TABLE wd.wide AS
SELECT CASE WHEN i % 100000 = 99999 THEN NULL ELSE ('1' || lpad(i::VARCHAR, 39, '0'))::DECIMAL(40,0) END AS d
FROM range(500000) r(i);

query I
SELECT d FROM wd.wide ORDER BY d LIMIT 2;
----
1000000000000000000000000000000000000000
1000000000000000000000000000000000000001

query I
SELECT d FROM wd.wide ORDER BY d DESC LIMIT 2;
----
1000000000000000000000000000000000499998
1000000000000000000000000000000000499997

query I
SELECT d FROM wd.wide ORDER BY d NULLS FIRST LIMIT 6;
----
NULL
NULL
NULL
NULL
NULL
1000000000000000000000000000000000000000

query I
SELECT d FROM wd.wide ORDER BY d DESC NULLS FIRST LIMIT 6;
----
NULL
NULL
NULL
NULL
NULL
1000000000000000000000000000000000499998

# an offset that crosses a row group boundary
query I
SELECT d FROM wd.wide ORDER BY d LIMIT 1 OFFSET 122880;
----
1000000000000000000000000000000000122881

query I
SELECT d FROM wd.wide ORDER BY d DESC LIMIT 1 OFFSET 122880;
----
1000000000000000000000000000000000377117

query I
SELECT d FROM wd.wide ORDER BY d NULLS FIRST LIMIT 2 OFFSET 4;
----
NULL
1000000000000000000000000000000000000000

# values beyond 77 digits make the row group bounds inexact
statement ok
CREATE TABLE wd.huge AS
SELECT repeat(((i % 9) + 1)::VARCHAR, 90)::DECIMAL(100,0) AS d
FROM range(300000) r(i);

query I
SELECT d FROM wd.huge ORDER BY d LIMIT 1;
----
111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111

query I
SELECT d FROM wd.huge ORDER BY d DESC LIMIT 1;
----
999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999

query I
SELECT d FROM wd.huge ORDER BY d LIMIT 1 OFFSET 200000;
----
666666666666666666666666666666666666666666666666666666666666666666666666666666666666666666

# the same queries on checkpointed statistics
restart

statement ok
ATTACH '{TEST_DIR}/top_n_wide_decimal_wd.db' AS wd;

query I
SELECT d FROM wd.wide ORDER BY d LIMIT 1 OFFSET 122880;
----
1000000000000000000000000000000000122881

query I
SELECT d FROM wd.wide ORDER BY d DESC LIMIT 1 OFFSET 122880;
----
1000000000000000000000000000000000377117

query I
SELECT d FROM wd.wide ORDER BY d NULLS FIRST LIMIT 6;
----
NULL
NULL
NULL
NULL
NULL
1000000000000000000000000000000000000000

query I
SELECT d FROM wd.huge ORDER BY d LIMIT 1;
----
111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111

query I
SELECT d FROM wd.huge ORDER BY d DESC LIMIT 1 OFFSET 50000;
----
888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888
