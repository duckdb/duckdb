# name: test/sql/cascade/decorrelation.test
# description: Apply elimination must agree with DuckDB's own decorrelation
# group: [cascade]

# These cases only mean something when the cascade optimizer is the one planning
# the query. Without the switches DuckDB's FlattenDependentJoins runs instead and
# the file would merely re-check DuckDB's own path, so skip rather than pretend.
require-env DUCKDB_CASCADE 1

require-env DUCKDB_CASCADE_KEEP_APPLY 1

statement ok
CREATE TABLE t(a INTEGER, b INTEGER);

statement ok
INSERT INTO t VALUES (1, 10), (2, 20), (3, 30), (4, NULL);

# s deliberately holds a NULL in the correlation column: EXISTS has to treat that
# comparison as "no match", not as unknown, or the marker comes out NULL.
statement ok
CREATE TABLE s(a INTEGER);

statement ok
INSERT INTO s VALUES (1), (1), (3), (NULL);

# a correlated predicate lifted into a MARK join
query I
SELECT a FROM t WHERE EXISTS (SELECT 1 FROM s WHERE s.a = t.a) ORDER BY a;
----
1
3

# the same marker negated
query I
SELECT a FROM t WHERE NOT EXISTS (SELECT 1 FROM s WHERE s.a = t.a) ORDER BY a;
----
2
4

# the marker as a value: false, never NULL
query II
SELECT a, EXISTS (SELECT 1 FROM s WHERE s.a = t.a) FROM t ORDER BY a;
----
1	true
2	false
3	true
4	false

# no correlation at all
query I
SELECT a FROM t WHERE EXISTS (SELECT 1 FROM s WHERE s.a = 1) ORDER BY a;
----
1
2
3
4

query I
SELECT a FROM t WHERE a IN (SELECT a FROM s) ORDER BY a;
----
1
3

# a NULL in the list makes NOT IN three-valued, so nothing survives
query I
SELECT a FROM t WHERE a NOT IN (SELECT a FROM s) ORDER BY a;
----

# a correlated IN: the ANY comparison against the subquery's output becomes one
# more join condition. Unlike EXISTS it keeps its three-valued marker, so the
# join stays a MARK join
query I
SELECT a FROM t WHERE a IN (SELECT s.a FROM s WHERE s.a = t.a) ORDER BY a;
----
1
3

query I
SELECT a FROM t WHERE a NOT IN (SELECT s.a FROM s WHERE s.a = t.a) ORDER BY a;
----
2
4

query I
SELECT a FROM t WHERE a <> ALL (SELECT s.a FROM s WHERE s.a = t.a) ORDER BY a;
----
2
4

# a correlated scalar subquery: the subquery is re-grouped by the correlated
# column and read through a SINGLE join, so an outer row with no group - and an
# outer value that matches nothing because the comparison is three-valued - both
# come out NULL
query II
SELECT a, (SELECT max(s.a) FROM s WHERE s.a = t.a) FROM t ORDER BY a;
----
1	1
2	NULL
3	3
4	NULL

# sum over an empty input is NULL, which the join already produces
query II
SELECT a, (SELECT sum(s.a) FROM s WHERE s.a = t.a) FROM t ORDER BY a;
----
1	2
2	NULL
3	3
4	NULL

# count over an empty input is 0 while the join hands back NULL. Identity (9) of
# Galindo-Legaria & Joshi covers this by grouping the OUTER side over a left outer
# join, so an outer row with no match still has a group, and by re-expressing
# count(*) over the correlated column, which is NULL on that padded row.
query II
SELECT a, (SELECT count(*) FROM s WHERE s.a = t.a) FROM t ORDER BY a;
----
1	2
2	0
3	1
4	0

query II
SELECT a, (SELECT min(s.a) FROM s WHERE s.a = t.a) FROM t ORDER BY a;
----
1	1
2	NULL
3	3
4	NULL

# a non-equality correlation: identity (9) only needs the predicate to decide which
# inner rows each group sees, so any comparison form works
query II
SELECT a, (SELECT count(*) FROM s WHERE s.a < t.a) FROM t ORDER BY a;
----
1	0
2	2
3	2
4	3

# the compared column lives inside a derived table, so it has to be projected out
# of the body before the join can reach it
query II
SELECT a, (SELECT count(*) FROM (SELECT s.a FROM s WHERE s.a = t.a) q) FROM t ORDER BY a;
----
1	2
2	0
3	1
4	0

# A NULL in the OUTER correlation column must match nothing. The scalar path keeps
# the user's comparison as written - it is not made NULL-safe - so the left outer
# join supplies the padded row and max/sum come from the empty input rather than
# from an inner row whose column is also NULL.
statement ok
CREATE TABLE tn(a INTEGER, b INTEGER);

statement ok
INSERT INTO tn VALUES (NULL, 10), (1, 20);

statement ok
CREATE TABLE sn(a INTEGER, b INTEGER);

statement ok
INSERT INTO sn VALUES (NULL, 5), (1, 7);

query II
SELECT a, (SELECT max(sn.b) FROM sn WHERE sn.a = tn.a) FROM tn ORDER BY a NULLS LAST;
----
1	7
NULL	NULL

query II
SELECT a, (SELECT sum(sn.b) FROM sn WHERE sn.a = tn.a) FROM tn ORDER BY a NULLS LAST;
----
1	7
NULL	NULL

query II
SELECT a, (SELECT count(*) FROM sn WHERE sn.a = tn.a) FROM tn ORDER BY a NULLS LAST;
----
1	1
NULL	0


# The outer relation may contain duplicate rows. Section 3.2 pushes the GroupBy
# below the outer join, so the outer join hands each outer row its own result and
# duplicates are preserved. Grouping the outer side - identity (9) - would fold the
# duplicates into one group and both lose rows and count each other's matches.
statement ok
CREATE TABLE tdup(a INTEGER, b INTEGER);

statement ok
INSERT INTO tdup VALUES (1, 10), (1, 10), (2, 20);

statement ok
CREATE TABLE sdup(a INTEGER, b INTEGER);

statement ok
INSERT INTO sdup VALUES (1, 100), (1, 200), (3, 300);

query III
SELECT a, b, (SELECT count(*) FROM sdup WHERE sdup.a = tdup.a) FROM tdup ORDER BY a, b;
----
1	10	2
1	10	2
2	20	0

query III
SELECT a, b, (SELECT max(sdup.b) FROM sdup WHERE sdup.a = tdup.a) FROM tdup ORDER BY a, b;
----
1	10	200
1	10	200
2	20	NULL

# The pushed-down plan must agree with the outerjoin/aggregate strategy on the
# aggregate whose empty-input answer is not NULL: count returns 0, not NULL.
query III
SELECT a, b, (SELECT sum(sdup.b) FROM sdup WHERE sdup.a = tdup.a) FROM tdup ORDER BY a, b;
----
1	10	300
1	10	300
2	20	NULL

# A predicate whose sub-query operand is not an equality against an outer-only
# expression cannot have its GroupBy pushed below the outerjoin - the outer row
# does not determine the sub-query column - so it keeps identity (9), which
# inherits the paper's precondition that the outer grouping columns form a key.
# The duplicate outer rows above therefore have to survive this path as well.
query III
SELECT a, (SELECT count(*) FROM sdup WHERE sdup.b > tdup.a * 100), (SELECT max(sdup.b) FROM sdup WHERE sdup.b <> tdup.a) FROM tdup ORDER BY a;
----
1	2	300
1	2	300
2	1	300

# Section 3.2 is more faithful than identity (9) exactly where agg(empty) and
# agg({null}) disagree, because a non-matching outer row produces no group at all
# and the outerjoin - not the aggregate - supplies the NULL. list is the clear case:
# identity (9) would aggregate the padded row into [NULL]; the answer must be NULL,
# because the sub-query saw no rows. The same data checks the ordinary edges: an
# empty inner table, and a group whose only inputs are NULL.
statement ok
CREATE TABLE tedge(a INTEGER, b INTEGER);

statement ok
INSERT INTO tedge VALUES (1, 10), (2, NULL), (NULL, 30);

statement ok
CREATE TABLE sedge(a INTEGER, b INTEGER);

statement ok
INSERT INTO sedge VALUES (1, NULL), (1, NULL), (2, 5);

query II
SELECT a, (SELECT list(sedge.b) FROM sedge WHERE sedge.a = tedge.a) FROM tedge ORDER BY a NULLS LAST;
----
1	[NULL, NULL]
2	[5]
NULL	NULL

query II
SELECT a, (SELECT sum(sedge.b) FROM sedge WHERE sedge.a = tedge.a) FROM tedge ORDER BY a NULLS LAST;
----
1	NULL
2	5
NULL	NULL

query II
SELECT a, (SELECT avg(sedge.b) FROM sedge WHERE sedge.a = tedge.a) FROM tedge ORDER BY a NULLS LAST;
----
1	NULL
2	5.0
NULL	NULL

query II
SELECT a, (SELECT count(DISTINCT sedge.b) FROM sedge WHERE sedge.a = tedge.a) FROM tedge ORDER BY a NULLS LAST;
----
1	0
2	1
NULL	0

# An inner table with no rows at all: count is 0, everything else is NULL.
statement ok
CREATE TABLE sempty(a INTEGER, b INTEGER);

query II
SELECT a, (SELECT count(*) FROM sempty WHERE sempty.a = tedge.a) FROM tedge ORDER BY a NULLS LAST;
----
1	0
2	0
NULL	0

query II
SELECT a, (SELECT max(sempty.b) FROM sempty WHERE sempty.a = tedge.a) FROM tedge ORDER BY a NULLS LAST;
----
1	NULL
2	NULL
NULL	NULL

# Rules (3) and (4) as a framework: a correlated predicate travels up through the
# sub-query's body - a filter contributing it, a projection exposing the columns it
# reads - and the WHERE semantics of those predicates have to survive the move.
statement ok
CREATE TABLE tdq(a INTEGER, b INTEGER);

statement ok
INSERT INTO tdq VALUES (1,10),(2,20),(3,30),(4,NULL);

statement ok
CREATE TABLE sdq(a INTEGER, b INTEGER);

statement ok
INSERT INTO sdq VALUES (1,10),(1,20),(3,30),(NULL,5);

# A correlated body predicate lifted out of a derived table. The predicate is a WHERE
# condition, so UNKNOWN means "no row", and NOT EXISTS must keep an outer row whose
# comparison is against NULL. As a join condition an UNKNOWN would instead make the
# marker three-valued and NOT of NULL would drop that row, so non-equality predicates are
# lifted two-valued, while equalities keep their shape as the join's hash key.
query I
SELECT a FROM tdq WHERE NOT EXISTS (SELECT 1 FROM (SELECT sdq.a FROM sdq WHERE sdq.b < tdq.b) q WHERE q.a = tdq.a) ORDER BY a;
----
1
2
3
4

# Its EXISTS counterpart, over the same derived table.
query I
SELECT a FROM tdq WHERE EXISTS (SELECT 1 FROM (SELECT sdq.a FROM sdq WHERE sdq.b <= tdq.b) q WHERE q.a = tdq.a) ORDER BY a;
----
1
3

# A correlated predicate under a derived table whose projection exposes two columns: the
# projection has to expose what the filter below it reads, level by level.
query I
SELECT a FROM tdq WHERE EXISTS (SELECT 1 FROM (SELECT sdq.a, sdq.b FROM sdq WHERE sdq.b <= tdq.b) q WHERE q.a = tdq.a) ORDER BY a;
----
1
3

# IN over a derived table with an equality body - the correlation itself - which is the
# shape DuckDB's own decorrelation also produces.
query I
SELECT a FROM tdq WHERE a IN (SELECT q.a FROM (SELECT sdq.a FROM sdq WHERE sdq.a = tdq.a) q) ORDER BY a;
----
1
3

# NOT IN over the same shape: the marker stays three-valued, because the IN comparison
# itself is what carries the unknown.
query I
SELECT a FROM tdq WHERE a NOT IN (SELECT q.a FROM (SELECT sdq.a FROM sdq WHERE sdq.a = tdq.a) q) ORDER BY a;
----
2
4

# A correlated *body* predicate under IN/ANY is refused rather than answered: the marker
# has to see the sub-query's rows filtered by the body while still seeing the unknown of a
# comparison against NULL, and no static join condition reproduces both.
statement error
SELECT a FROM tdq WHERE a IN (SELECT sdq.a FROM sdq WHERE sdq.b < tdq.b) ORDER BY a;
----
