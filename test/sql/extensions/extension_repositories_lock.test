# name: test/sql/extensions/extension_repositories_lock.test
# description: Trusted extension repositories cannot be modified while the configuration is locked
# group: [extensions]

statement ok
SET extension_repository_directory='{TEST_DIR}/extension_repositories_lock'

statement ok
SET allow_extension_repositories='allowed'

# create a repository before locking the configuration
statement ok
CREATE EXTENSION REPOSITORY acme WITH PREFIX 'http://extensions.acme.com' USING PUBLIC KEY ''

statement ok
SET lock_configuration=true

# adding a repository would add a new trusted signing key, so it is blocked by the configuration lock
statement error
CREATE EXTENSION REPOSITORY evil WITH PREFIX 'http://evil.com' USING PUBLIC KEY ''
----
<REGEX>:Invalid Input Error.*configuration has been locked.*

# removing a repository is blocked as well
statement error
DROP EXTENSION REPOSITORY acme
----
<REGEX>:Invalid Input Error.*configuration has been locked.*

# the repository that existed before the lock is unaffected
query I
SELECT repository_name FROM duckdb_extension_repositories() WHERE type='USER_PROVIDED'
----
acme
