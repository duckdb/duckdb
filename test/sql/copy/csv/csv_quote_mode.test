# name: test/sql/copy/csv/csv_quote_mode.test
# description: Test quote_mode 'lines': a line break ends the record even inside quotes, an unclosed quote reads NULL
# group: [csv]

# a quoted value holding a line break, and a quote that is never closed
statement ok
COPY (SELECT * FROM (VALUES ('1,"a'), ('b",7'), ('2,ok,8')) t(line)) TO '{TEST_DIR}/quote_mode_newline.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

# the default reads the quoted line break as one record of two, and needs parallel=false to pad
query I
SELECT count(*) FROM read_csv('{TEST_DIR}/quote_mode_newline.csv', columns={'id': 'VARCHAR', 'val': 'VARCHAR', 'n': 'VARCHAR'}, delim=',', quote='"', escape='\', strict_mode=false, null_padding=true, header=false, auto_detect=false, parallel=false);
----
2

# quote_mode 'lines': the line break ends the record, the open quote reads its field as NULL, and the next line is
# its own record
query TTT
SELECT * FROM read_csv('{TEST_DIR}/quote_mode_newline.csv', columns={'id': 'VARCHAR', 'val': 'VARCHAR', 'n': 'VARCHAR'}, delim=',', quote='"', escape='\', quote_mode='lines', null_padding=true, header=false, auto_detect=false) ORDER BY id NULLS FIRST;
----
1	NULL	NULL
2	ok	8
b"	7	NULL

# an unclosed quote in the record's last field needs no null padding
statement ok
COPY (SELECT * FROM (VALUES ('1,"abc'), ('2,ok')) t(line)) TO '{TEST_DIR}/quote_mode_last.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query IT
SELECT * FROM read_csv('{TEST_DIR}/quote_mode_last.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR'}, delim=',', quote='"', escape='\', quote_mode='lines', header=false, auto_detect=false) ORDER BY id;
----
1	NULL
2	ok

# a closed quoted value on one line reads as always
statement ok
COPY (SELECT * FROM (VALUES ('3,"q uoted",9'), ('4,"a""b",10')) t(line)) TO '{TEST_DIR}/quote_mode_closed.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query ITI
SELECT * FROM read_csv('{TEST_DIR}/quote_mode_closed.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR', 'n': 'INTEGER'}, delim=',', quote='"', escape='"', quote_mode='lines', header=false, auto_detect=false) ORDER BY id;
----
3	q uoted	9
4	a"b	10

# '\r\n' line breaks end the record inside quotes as well
statement ok
COPY (SELECT '1,"a' || chr(13) || chr(10) || '2,ok' AS line) TO '{TEST_DIR}/quote_mode_crlf.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query IT
SELECT * FROM read_csv('{TEST_DIR}/quote_mode_crlf.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR'}, delim=',', quote='"', escape='\', quote_mode='lines', new_line='\r\n', header=false, auto_detect=false) ORDER BY id;
----
1	NULL
2	ok

# a projection that skips the unterminated field reads without an error
query I
SELECT id FROM read_csv('{TEST_DIR}/quote_mode_last.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR'}, delim=',', quote='"', escape='\', quote_mode='lines', header=false, auto_detect=false) ORDER BY id;
----
1
2

# together with escape_mode 'opencsv': a quote opened after an inert escape is unclosed, so the field is NULL
statement ok
COPY (SELECT * FROM (VALUES ('1,\"abc'), ('2,ok')) t(line)) TO '{TEST_DIR}/quote_mode_opencsv.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query IT
SELECT * FROM read_csv('{TEST_DIR}/quote_mode_opencsv.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR'}, delim=',', quote='"', escape='\', escape_mode='opencsv', quote_mode='lines', header=false, auto_detect=false) ORDER BY id;
----
1	NULL
2	ok

# an invalid quote_mode is refused
statement error
SELECT * FROM read_csv('{TEST_DIR}/quote_mode_last.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR'}, quote_mode='banana', header=false);
----
'banana' is not accepted as a quote_mode

# a record that ends inside an open quote is not strict
statement error
SELECT * FROM read_csv('{TEST_DIR}/quote_mode_last.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR'}, quote_mode='lines', strict_mode=true, header=false);
----
QUOTE_MODE 'lines' is not supported when STRICT_MODE is manually set to true

# quote_mode is a read option: the CSV writer does not accept it
statement error
COPY (SELECT 1) TO '{TEST_DIR}/quote_mode_write.csv' (FORMAT csv, QUOTE_MODE 'lines');
----
<REGEX>:.*quote_mode.*
