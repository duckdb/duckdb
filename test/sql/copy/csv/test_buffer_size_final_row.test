# name: test/sql/copy/csv/test_buffer_size_final_row.test
# description: Regression test for duckdb/duckdb#25825: read_csv with an explicit buffer_size silently
#              dropped the final row of the file when that row exceeded buffer_size, instead of raising
#              the proper Maximum line size error. Setting buffer_size also lowers max_line_size to the
#              same value, so every buffer size below the oversized row's length must raise an error -
#              never return a short result. The buffer sizes below exercise both shapes of the bug: the
#              oversized row starting exactly at a scanner boundary, and the row spanning three or more
#              buffers (which the two-buffer over-buffer protocol cannot represent).
# group: [csv]

statement ok
COPY (SELECT * FROM (VALUES (1, '2'), (3, '4'), (5, '666666666666666666')) t(a, b)) TO '{TEST_DIR}/bs_final_row.csv' (HEADER);

# Without buffer_size the file reads correctly
query I
SELECT count(*) FROM read_csv('{TEST_DIR}/bs_final_row.csv', header=true);
----
3

# buffer_size large enough to hold the longest row: all three rows are returned
query I
SELECT count(*) FROM read_csv('{TEST_DIR}/bs_final_row.csv', header=true, buffer_size=21);
----
3

query I
SELECT count(*) FROM read_csv('{TEST_DIR}/bs_final_row.csv', header=true, buffer_size=21, parallel=false);
----
3

# Smaller buffer sizes: the final row exceeds max_line_size (which follows buffer_size), so reading
# must raise the Maximum line size error instead of silently dropping the row
statement error
SELECT count(*) FROM read_csv('{TEST_DIR}/bs_final_row.csv', header=true, buffer_size=11);
----
Maximum line size of 11 bytes exceeded

statement error
SELECT count(*) FROM read_csv('{TEST_DIR}/bs_final_row.csv', header=true, buffer_size=12);
----
Maximum line size of 12 bytes exceeded

statement error
SELECT count(*) FROM read_csv('{TEST_DIR}/bs_final_row.csv', header=true, buffer_size=13);
----
Maximum line size of 13 bytes exceeded

statement error
SELECT count(*) FROM read_csv('{TEST_DIR}/bs_final_row.csv', header=true, buffer_size=16);
----
Maximum line size of 16 bytes exceeded

statement error
SELECT count(*) FROM read_csv('{TEST_DIR}/bs_final_row.csv', header=true, buffer_size=17);
----
Maximum line size of 17 bytes exceeded

statement error
SELECT count(*) FROM read_csv('{TEST_DIR}/bs_final_row.csv', header=true, buffer_size=20);
----
Maximum line size of 20 bytes exceeded
