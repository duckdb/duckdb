# name: test/sql/copy/csv/csv_comment_line_feed_crlf.test
# description: The row after a comment that ends in a line feed keeps its first byte in a file with \r\n line breaks
# group: [csv]

# a,b\r\n
# #c\n
# xyz,d\r\n
# 1,2\r\n
statement ok
COPY (SELECT 'a,b' || chr(13) || chr(10) || '#c' || chr(10) || 'xyz,d' || chr(13) || chr(10) || '1,2' || chr(13)) TO '{TEST_DIR}/comment_line_feed_crlf.csv' (HEADER false, QUOTE '', DELIM '|');

query II
FROM read_csv('{TEST_DIR}/comment_line_feed_crlf.csv', comment = '#');
----
xyz	d
1	2

query II
FROM read_csv('{TEST_DIR}/comment_line_feed_crlf.csv', auto_detect = false, delim = ',', quote = '', escape = '', new_line = '\r\n', comment = '#', header = true, columns = {'a': 'VARCHAR', 'b': 'VARCHAR'});
----
xyz	d
1	2

foreach parallel true false

loop buffer_size 11 31

query II
FROM read_csv('{TEST_DIR}/comment_line_feed_crlf.csv', auto_detect = false, delim = ',', quote = '', escape = '', new_line = '\r\n', comment = '#', header = true, columns = {'a': 'VARCHAR', 'b': 'VARCHAR'}, buffer_size = {buffer_size}, parallel = {parallel});
----
xyz	d
1	2

endloop

endloop

# a comment that ends in \r\n, as before
statement ok
COPY (SELECT 'a,b' || chr(13) || chr(10) || '#c' || chr(13) || chr(10) || 'xyz,d' || chr(13) || chr(10) || '1,2' || chr(13)) TO '{TEST_DIR}/comment_crlf.csv' (HEADER false, QUOTE '', DELIM '|');

query II
FROM read_csv('{TEST_DIR}/comment_crlf.csv', comment = '#');
----
xyz	d
1	2

# 201 rows, every third row is followed by a comment that ends in a line feed: the line feed can start a buffer
statement ok
COPY (SELECT string_agg('row' || i || ',v' || i || chr(13) || chr(10) || CASE WHEN i % 3 = 0 THEN '#comment number ' || i || chr(10) ELSE '' END, '') || 'row200,v200' || chr(13) FROM range(200) t(i)) TO '{TEST_DIR}/comments_line_feed_crlf.csv' (HEADER false, QUOTE '', DELIM '|');

loop buffer_size 21 81

query III
SELECT count(*), count(DISTINCT a), count(DISTINCT b) FROM read_csv('{TEST_DIR}/comments_line_feed_crlf.csv', auto_detect = false, delim = ',', quote = '', escape = '', new_line = '\r\n', comment = '#', header = false, columns = {'a': 'VARCHAR', 'b': 'VARCHAR'}, buffer_size = {buffer_size}, parallel = false);
----
201	201	201

endloop
