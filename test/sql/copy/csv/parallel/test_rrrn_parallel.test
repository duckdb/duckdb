# name: test/sql/copy/csv/parallel/test_rrrn_parallel.test
# description: Test parallel CSV reader handles \r\r\n line endings without duplicate rows (issue #25164)
# group: [parallel]

require notwindows

# Generate a CSV file with \r\r\n line endings on the fly using chr(13)+chr(10) and COPY BLOB.
# The file has 252 data rows (ids 0..251) with \r\r\n line endings, totaling 2561 bytes.
# With buffer_size=1024, bytes_per_thread=256, so the \r\r\n of row 251 straddles
# the 256-byte chunk boundary (bytes 2558-2560), which previously triggered duplicate rows.

statement ok
COPY (
    SELECT ('id,val' || chr(13) || chr(13) || chr(10) ||
        string_agg(CAST(id AS VARCHAR) || ',x' || CAST(id AS VARCHAR) || chr(13) || chr(13) || chr(10), '')
    )::BLOB
    FROM generate_series(0, 251) t(id)
) TO '{TEST_DIR}/rrrn_test.csv' (FORMAT BLOB);

# Force parallelism
statement ok
PRAGMA verify_parallelism

# Test that parallel reading produces correct row count
# and no duplicate rows. Sequential mode serves as the baseline.
query II
SELECT
    (SELECT COUNT(*) FROM read_csv('{TEST_DIR}/rrrn_test.csv',
        auto_detect=false, header=true, delim=',',
        columns={'id':'BIGINT','val':'VARCHAR'},
        strict_mode=false, ignore_errors=true,
        buffer_size=1024, parallel=true)) AS parallel_count,
    (SELECT COUNT(*) FROM read_csv('{TEST_DIR}/rrrn_test.csv',
        auto_detect=false, header=true, delim=',',
        columns={'id':'BIGINT','val':'VARCHAR'},
        strict_mode=false, ignore_errors=true,
        buffer_size=1024, parallel=false)) AS sequential_count
----
252	252

# Verify no duplicate rows exist in parallel mode
query I
SELECT COUNT(*) FROM (
    SELECT id, COUNT(*) AS cnt
    FROM read_csv('{TEST_DIR}/rrrn_test.csv',
        auto_detect=false, header=true, delim=',',
        columns={'id':'BIGINT','val':'VARCHAR'},
        strict_mode=false, ignore_errors=true,
        buffer_size=1024, parallel=true)
    GROUP BY id
    HAVING cnt > 1
)
----
0

# Also test with default buffer size
query I
SELECT COUNT(*) FROM read_csv('{TEST_DIR}/rrrn_test.csv',
    auto_detect=false, header=true, delim=',',
    columns={'id':'BIGINT','val':'VARCHAR'},
    strict_mode=false, ignore_errors=true,
    parallel=true)
----
252
