# name: test/sql/copy/csv/test_csv_null_dialect_options.test
# description: A NULL dialect option is the same as not passing it - it is auto-detected, as sep=None does in pandas
# group: [csv]

query IIII
FROM read_csv('{DATA_DIR}/csv/pipe_delim.csv', delim := NULL)
----
1	2	3	4

query IIII
FROM read_csv('{DATA_DIR}/csv/pipe_delim.csv', sep := NULL)
----
1	2	3	4

query I
SELECT Delimiter FROM sniff_csv('{DATA_DIR}/csv/pipe_delim.csv', delim := NULL)
----
|

# an empty delimiter is still "no delimiter": every line is a single column
query I
FROM read_csv('{DATA_DIR}/csv/pipe_delim.csv', delim := '', header := false, auto_detect := false, columns := {'line': 'VARCHAR'})
----
one|two|three|four
1|2|3|4

# quote
query I
FROM read_csv('{DATA_DIR}/csv/quoted_values_delimited.csv', quote := NULL) LIMIT 1
----
value1;value2;value3

query III
FROM read_csv('{DATA_DIR}/csv/quoted_values_delimited.csv', quote := '') LIMIT 1
----
"value1	value2	value3"

# comment
statement ok
COPY (SELECT l FROM (VALUES (1, 'a,b'), (2, '1,2'), (3, '# note'), (4, '3,4')) t(i, l) ORDER BY i) TO '{TEST_DIR}/comment.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '', DELIM '|');

query II
FROM read_csv('{TEST_DIR}/comment.csv', comment := NULL)
----
1	2
3	4

query I
SELECT count(*) FROM read_csv('{TEST_DIR}/comment.csv', comment := '')
----
3

# escape
statement ok
COPY (SELECT l FROM (VALUES (1, 'a,b'), (2, '"x\"y",1'), (3, '"z",2')) t(i, l) ORDER BY i) TO '{TEST_DIR}/escape.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '', DELIM '|');

query II
FROM read_csv('{TEST_DIR}/escape.csv', escape := NULL)
----
x"y	1
z	2

query II
FROM read_csv('{TEST_DIR}/escape.csv', escape := '')
----
"x\"y"	1
"z"	2
