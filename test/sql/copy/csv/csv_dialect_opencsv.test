# name: test/sql/copy/csv/csv_dialect_opencsv.test
# description: Test dialect 'opencsv' with OpenCSVSerde escapes and line records
# group: [csv]

# a file whose second line ends in an escape character
statement ok
COPY (SELECT * FROM (VALUES ('1,\'), ('2,b'), ('3,c')) t(line)) TO '{TEST_DIR}/dialect_rows.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

# the standard dialect applies the escape to the line break and joins the second row to the first
query I
SELECT count(*) FROM read_csv('{TEST_DIR}/dialect_rows.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR'}, delim=',', quote='"', escape='\', strict_mode=false, null_padding=true, header=false, auto_detect=false);
----
2

# the inert escape leaves an empty field, which the dialect reads as an empty string, as OpenCSVSerde does
query IT
SELECT id, concat('<', val, '>') FROM read_csv('{TEST_DIR}/dialect_rows.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR'}, delim=',', quote='"', escape='\', dialect='opencsv', header=false, auto_detect=false) ORDER BY id;
----
1	<>
2	<b>
3	<c>

# the escape is inert at the start of a field and escapes only the quote and escape characters within one
statement ok
COPY (SELECT * FROM (VALUES
    ('1,a\,7'),
    ('2,a\x,8'),
    ('3,a\\b,9'),
    ('4,"a\"b",10'),
    ('5,c\'),
    ('6,\\x,12'),
    ('7,\"a,b",13')
) t(line)) TO '{TEST_DIR}/dialect_fields.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

# the escape never escapes the separator (1) and drops before ordinary characters (2)
# an escaped escape or quote is kept (3, 4) and a trailing escape drops with missing fields NULL (5)
# leading escapes are inert (6) and a quote after one opens a quoted field with the quote kept as a literal (7)
query ITI
SELECT * FROM read_csv('{TEST_DIR}/dialect_fields.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR', 'n': 'INTEGER'}, delim=',', quote='"', escape='\', dialect='opencsv', null_padding=true, header=false, auto_detect=false) ORDER BY id;
----
1	a	7
2	ax	8
3	a\b	9
4	a"b	10
5	c	NULL
6	x	12
7	"a,b	13

# a quoted value after an inert escape holds no escapes and converts into a typed column
statement ok
COPY (SELECT * FROM (VALUES ('\"123"'), ('456')) t(line)) TO '{TEST_DIR}/dialect_typed.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query I
SELECT * FROM read_csv('{TEST_DIR}/dialect_typed.csv', columns={'v': 'INTEGER'}, delim=',', quote='"', escape='\', dialect='opencsv', header=false, auto_detect=false) ORDER BY v;
----
123
456

# the sniffer reads a trailing field of only inert escapes as the empty last value
statement ok
COPY (SELECT 'a,\' AS line) TO '{TEST_DIR}/dialect_sniff.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query T
SELECT * FROM read_csv('{TEST_DIR}/dialect_sniff.csv', columns={'a': 'VARCHAR'}, delim=',', quote='"', escape='\', dialect='opencsv', header=false);
----
a

# a quoted value holding a line break, and a quote that is never closed
statement ok
COPY (SELECT * FROM (VALUES ('1,"a'), ('b",7'), ('2,ok,8')) t(line)) TO '{TEST_DIR}/dialect_newline.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

# the standard dialect reads the quoted line break as one record of two, and needs parallel=false to pad
query I
SELECT count(*) FROM read_csv('{TEST_DIR}/dialect_newline.csv', columns={'id': 'VARCHAR', 'val': 'VARCHAR', 'n': 'VARCHAR'}, delim=',', quote='"', escape='\', strict_mode=false, null_padding=true, header=false, auto_detect=false, parallel=false);
----
2

# under the dialect each line is its own record and a field left open by a quote reads as NULL
query TTT
SELECT * FROM read_csv('{TEST_DIR}/dialect_newline.csv', columns={'id': 'VARCHAR', 'val': 'VARCHAR', 'n': 'VARCHAR'}, delim=',', quote='"', escape='\', dialect='opencsv', null_padding=true, header=false, auto_detect=false) ORDER BY id NULLS FIRST;
----
NULL	NULL	NULL
1	NULL	NULL
2	ok	8

# an unclosed quote in the record's last field needs no null padding
statement ok
COPY (SELECT * FROM (VALUES ('1,"abc'), ('2,ok')) t(line)) TO '{TEST_DIR}/dialect_last.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query IT
SELECT * FROM read_csv('{TEST_DIR}/dialect_last.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR'}, delim=',', quote='"', escape='\', dialect='opencsv', header=false, auto_detect=false) ORDER BY id;
----
1	NULL
2	ok

# a projection that skips the unterminated field reads without an error
query I
SELECT id FROM read_csv('{TEST_DIR}/dialect_last.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR'}, delim=',', quote='"', escape='\', dialect='opencsv', header=false, auto_detect=false) ORDER BY id;
----
1
2

# a closed quoted value on one line reads as always, with the escape defaulting to backslash
statement ok
COPY (SELECT * FROM (VALUES ('3,"q uoted",9'), ('4,"a""b",10')) t(line)) TO '{TEST_DIR}/dialect_closed.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query ITI
SELECT * FROM read_csv('{TEST_DIR}/dialect_closed.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR', 'n': 'INTEGER'}, delim=',', quote='"', dialect='opencsv', header=false, auto_detect=false) ORDER BY id;
----
3	q uoted	9
4	a"b	10

# the delimiter, quote and escape characters must differ, and opencsv has no comments
statement error
SELECT * FROM read_csv('{TEST_DIR}/dialect_closed.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR', 'n': 'INTEGER'}, quote='"', escape='"', dialect='opencsv', header=false);
----
DIALECT 'opencsv' requires the delimiter, quote and escape characters to differ

statement error
SELECT * FROM read_csv('{TEST_DIR}/dialect_closed.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR', 'n': 'INTEGER'}, comment='#', dialect='opencsv', header=false);
----
DIALECT 'opencsv' does not support a comment character

# '\r\n' line breaks end the record inside quotes as well
statement ok
COPY (SELECT '1,"a' || chr(13) || chr(10) || '2,ok' AS line) TO '{TEST_DIR}/dialect_crlf.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query IT
SELECT * FROM read_csv('{TEST_DIR}/dialect_crlf.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR'}, delim=',', quote='"', escape='\', dialect='opencsv', new_line='\r\n', header=false, auto_detect=false) ORDER BY id;
----
1	NULL
2	ok

# an invalid dialect is refused with the accepted values
statement error
SELECT * FROM read_csv('{TEST_DIR}/dialect_last.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR'}, dialect='banana', header=false);
----
'banana' is not accepted as a dialect

# OpenCSVSerde reading is not strict
statement error
SELECT * FROM read_csv('{TEST_DIR}/dialect_last.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR'}, dialect='opencsv', strict_mode=true, header=false);
----
DIALECT 'opencsv' is not supported when STRICT_MODE is manually set to true

# COPY FROM accepts the dialect
statement ok
CREATE TABLE dialect_rows (id INTEGER, val VARCHAR);

statement ok
COPY dialect_rows FROM '{TEST_DIR}/dialect_rows.csv' (DELIM ',', QUOTE '"', ESCAPE '\', DIALECT 'opencsv', HEADER false);

query IT
SELECT id, concat('<', val, '>') FROM dialect_rows ORDER BY id;
----
1	<>
2	<b>
3	<c>

# dialect is a read option that the CSV writer does not accept
statement error
COPY dialect_rows TO '{TEST_DIR}/dialect_write.csv' (FORMAT csv, DIALECT 'opencsv');
----
<REGEX>:.*dialect.*

# a doubled quote inside a quoted value is one quote, also with the '\' escape, and both forms mix
statement ok
COPY (SELECT * FROM (VALUES ('5,"a""b",11'), ('6,"a\"b""c",12'), ('7,"a""",13')) t(line)) TO '{TEST_DIR}/dialect_doubled.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query ITI
SELECT * FROM read_csv('{TEST_DIR}/dialect_doubled.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR', 'n': 'INTEGER'}, delim=',', quote='"', escape='\', dialect='opencsv', header=false, auto_detect=false) ORDER BY id;
----
5	a"b	11
6	a"b"c	12
7	a"	13

# a doubled quote in an unquoted field is one quote too, and an unclosed lone quote reads the field as NULL
statement ok
COPY (SELECT * FROM (VALUES ('8,a""b,14'), ('9,a"b,15'), ('10,a""b""c,16'), ('11,a"",17')) t(line)) TO '{TEST_DIR}/dialect_field_doubled.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query ITI
SELECT * FROM read_csv('{TEST_DIR}/dialect_field_doubled.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR', 'n': 'INTEGER'}, delim=',', quote='"', escape='\', dialect='opencsv', header=false, auto_detect=false) ORDER BY id;
----
8	a"b	14
9	NULL	NULL
10	a"b"c	16
11	a"	17

# missing trailing fields are NULL without setting null_padding, as the dialect implies it
statement ok
COPY (SELECT * FROM (VALUES ('1,a'), ('2,b,8')) t(line)) TO '{TEST_DIR}/dialect_padding.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query ITI
SELECT * FROM read_csv('{TEST_DIR}/dialect_padding.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR', 'n': 'INTEGER'}, delim=',', quote='"', dialect='opencsv', header=false, auto_detect=false) ORDER BY id;
----
1	a	NULL
2	b	8

# a NUL byte is data
statement ok
COPY (SELECT '1,a' || chr(0) || 'b,7' AS line) TO '{TEST_DIR}/dialect_nul.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query III
SELECT id, length(val), n FROM read_csv('{TEST_DIR}/dialect_nul.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR', 'n': 'INTEGER'}, delim=',', quote='"', dialect='opencsv', header=false, auto_detect=false);
----
1	3	7

# a fully empty line is skipped, where OpenCSVSerde reads a row of one empty field, a known divergence
statement ok
COPY (SELECT * FROM (VALUES ('1,a,7'), (''), ('2,b,8')) t(line)) TO '{TEST_DIR}/dialect_empty_line.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query I
SELECT count(*) FROM read_csv('{TEST_DIR}/dialect_empty_line.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR', 'n': 'INTEGER'}, delim=',', quote='"', dialect='opencsv', header=false, auto_detect=false);
----
2

# a quote in the middle of a field is a kept literal away from the line start and separators, dropped next to them
statement ok
COPY (SELECT * FROM (VALUES ('12,a"b"c,18'), ('13,"a"b,19'), ('14,a"b" x,20'), ('30,filler one,98'), ('31,filler two,99')) t(line)) TO '{TEST_DIR}/dialect_embedded.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query ITI
SELECT * FROM read_csv('{TEST_DIR}/dialect_embedded.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR', 'n': 'INTEGER'}, delim=',', quote='"', escape='\', dialect='opencsv', header=false, auto_detect=false) ORDER BY id;
----
12	a"b"c	18
13	a"b	19
14	a"b" x	20
30	filler one	98
31	filler two	99

# the same file read over tiny buffers, so the toggled fields cross buffer boundaries
query ITI
SELECT * FROM read_csv('{TEST_DIR}/dialect_embedded.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR', 'n': 'INTEGER'}, delim=',', quote='"', escape='\', dialect='opencsv', header=false, auto_detect=false, buffer_size=61) ORDER BY id;
----
12	a"b"c	18
13	a"b	19
14	a"b" x	20
30	filler one	98
31	filler two	99

# an unclosed quoted section in the middle of the record reads its field as NULL and pads the rest
statement ok
COPY (SELECT * FROM (VALUES ('15,q"r,21'), ('16,ok,22'), ('17,z"')) t(line)) TO '{TEST_DIR}/dialect_toggled.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query ITI
SELECT * FROM read_csv('{TEST_DIR}/dialect_toggled.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR', 'n': 'INTEGER'}, delim=',', quote='"', escape='\', dialect='opencsv', header=false, auto_detect=false) ORDER BY id;
----
15	NULL	NULL
16	ok	22
17	NULL	NULL

# an escape inside a toggled-open section still escapes the quote
statement ok
COPY (SELECT '18,a"b\"c"d,24' AS line) TO '{TEST_DIR}/dialect_toggled_escape.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query ITI
SELECT * FROM read_csv('{TEST_DIR}/dialect_toggled_escape.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR', 'n': 'INTEGER'}, delim=',', quote='"', escape='\', dialect='opencsv', header=false, auto_detect=false);
----
18	a"b"c"d	24

# a quote within the line's first three characters is dropped, so the first field reads differently
statement ok
COPY (SELECT * FROM (VALUES ('a"b"c,30,1'), ('x,a"b"c,2'), (',x"y"z,28')) t(line)) TO '{TEST_DIR}/dialect_gate.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query TTT
SELECT * FROM read_csv('{TEST_DIR}/dialect_gate.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'}, delim=',', quote='"', escape='\', dialect='opencsv', header=false, auto_detect=false) ORDER BY c;
----
ab"c	30	1
x	a"b"c	2
(empty)	xy"z	28

# a kept literal discards a field of only whitespace before it, and a quote next to separator or line end drops
statement ok
COPY (SELECT * FROM (VALUES ('20,  "ws",26'), ('21,a"b",27')) t(line)) TO '{TEST_DIR}/dialect_ws.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query ITI
SELECT * FROM read_csv('{TEST_DIR}/dialect_ws.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR', 'n': 'INTEGER'}, delim=',', quote='"', escape='\', dialect='opencsv', header=false, auto_detect=false) ORDER BY id;
----
20	ws	26
21	a"b	27

# after a doubled quote in a plain field opencsv's field flag is off, making the escape inert and its field NULL
statement ok
COPY (SELECT * FROM (VALUES ('22,b ""\"x,29'), ('23,ok,31')) t(line)) TO '{TEST_DIR}/dialect_field_flag.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query ITI
SELECT * FROM read_csv('{TEST_DIR}/dialect_field_flag.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR', 'n': 'INTEGER'}, delim=',', quote='"', escape='\', dialect='opencsv', header=false, auto_detect=false) ORDER BY id;
----
22	NULL	NULL
23	ok	31

# a doubled quote directly inside a quoted section leaves the flag on at the close, so there the escape escapes
statement ok
COPY (SELECT '24,"a"""\"x,32' AS line) TO '{TEST_DIR}/dialect_field_flag_on.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query ITI
SELECT * FROM read_csv('{TEST_DIR}/dialect_field_flag_on.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR', 'n': 'INTEGER'}, delim=',', quote='"', escape='\', dialect='opencsv', header=false, auto_detect=false);
----
24	a"""x	32

# the position rule counts UTF-16 units, so a four-byte character counts as two and its quote is still dropped
statement ok
COPY (SELECT chr(65536) || '"x"y,5,1' AS line) TO '{TEST_DIR}/dialect_units.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query TTT
SELECT a = chr(65536) || 'x"y', b, c FROM read_csv('{TEST_DIR}/dialect_units.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'}, delim=',', quote='"', escape='\', dialect='opencsv', header=false, auto_detect=false);
----
true	5	1

# a file that ends inside an open quote without a final line break reads that field as NULL
query ITI
SELECT * FROM read_csv('data/csv/opencsv_unclosed_eof.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR', 'c': 'INTEGER'}, delim=',', quote='"', escape='\', dialect='opencsv', header=false, auto_detect=false) ORDER BY a;
----
1	ok	2
3	NULL	NULL

# fields beyond the last column are ignored, also when one of them holds an unclosed quote
statement ok
COPY (SELECT * FROM (VALUES ('1,2,"x'), ('3,4'), ('5,6,extra')) t(line)) TO '{TEST_DIR}/dialect_extra.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query II
SELECT * FROM read_csv('{TEST_DIR}/dialect_extra.csv', columns={'a': 'INTEGER', 'b': 'INTEGER'}, delim=',', quote='"', escape='\', dialect='opencsv', header=false, auto_detect=false) ORDER BY a;
----
1	2
3	4
5	6

# a lone carriage return ends the record even inside quotes, as Hive's line reading splits it
statement ok
COPY (SELECT '1,"x' || chr(13) || 'y",7' || chr(13) || chr(10) || '2,ok,8' || chr(13) || chr(10) AS line) TO '{TEST_DIR}/dialect_lone_cr.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query TTT
SELECT * FROM read_csv('{TEST_DIR}/dialect_lone_cr.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'}, delim=',', quote='"', escape='\', dialect='opencsv', new_line='\r\n', header=false, auto_detect=false) ORDER BY a NULLS FIRST;
----
NULL	NULL	NULL
1	NULL	NULL
2	ok	8

# the same with '\n' line breaks
statement ok
COPY (SELECT '1,"ab' || chr(13) || 'cd"' || chr(10) || '2,x' AS line) TO '{TEST_DIR}/dialect_cr_data.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query TT
SELECT * FROM read_csv('{TEST_DIR}/dialect_cr_data.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR'}, delim=',', quote='"', escape='\', dialect='opencsv', new_line='\n', header=false, auto_detect=false) ORDER BY a NULLS FIRST;
----
NULL	NULL
1	NULL
2	x

# an escape directly before the line break inside quotes still ends the record
statement ok
COPY (SELECT * FROM (VALUES ('1,"ab\'), ('3,ok')) t(line)) TO '{TEST_DIR}/dialect_escape_eol.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query IT
SELECT * FROM read_csv('{TEST_DIR}/dialect_escape_eol.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR'}, delim=',', quote='"', escape='\', dialect='opencsv', header=false, auto_detect=false) ORDER BY a;
----
1	NULL
3	ok

# a quoted field of one doubled quote is one quote
statement ok
COPY (SELECT '25,"""",33' AS line) TO '{TEST_DIR}/dialect_pure_doubled.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query ITI
SELECT * FROM read_csv('{TEST_DIR}/dialect_pure_doubled.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR', 'n': 'INTEGER'}, delim=',', quote='"', escape='\', dialect='opencsv', header=false, auto_detect=false);
----
25	"	33

# a separator of more than one byte is one character to the embedded quote rule
statement ok
COPY (SELECT * FROM (VALUES ('¦a"b"c'), ('a¦"x¦"y¦b')) t(line)) TO '{TEST_DIR}/dialect_wide_delim.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query TTT
SELECT * FROM read_csv('{TEST_DIR}/dialect_wide_delim.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'}, delim='¦', quote='"', escape='\', dialect='opencsv', header=false, auto_detect=false) ORDER BY a;
----
(empty)	ab"c	NULL
a	x¦y	b

# a large file of open and closed quoted fields over small buffers and several threads
statement ok
SET threads=4;

statement ok
COPY (SELECT CASE WHEN i % 7 = 0 THEN i || ',"open ' || i ELSE i || ',"clo\"sed' || i || '""x",' || i END AS line FROM range(2000) t(i)) TO '{TEST_DIR}/dialect_stress.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query IIII
SELECT count(*), count(b), count(*) FILTER (b = 'clo"sed' || a || '"x'), count(c) FROM read_csv('{TEST_DIR}/dialect_stress.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR', 'c': 'INTEGER'}, delim=',', quote='"', escape='\', dialect='opencsv', header=false, auto_detect=false, buffer_size=701, max_line_size=500);
----
2000	1714	1714	1714

# a field whose normalized text fits the column type converts, wherever the buffer boundary falls
statement ok
COPY (SELECT * FROM (VALUES ('"1"23'), ('12'), ('456')) t(line)) TO '{TEST_DIR}/dialect_typed_embedded.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

foreach bsz 10 11 12 2000000

query I
SELECT * FROM read_csv('{TEST_DIR}/dialect_typed_embedded.csv', columns={'a': 'INTEGER'}, delim=',', quote='"', escape='\', dialect='opencsv', header=false, auto_detect=false, parallel=false, buffer_size={bsz}, max_line_size=9) ORDER BY a;
----
12
123
456

endloop

# a conversion error in a value crossing the buffer boundary does not swallow the following row
statement ok
COPY (SELECT * FROM (VALUES ('12'), ('4x5'), ('456'), ('789')) t(line)) TO '{TEST_DIR}/dialect_span_error.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query I
SELECT * FROM read_csv('{TEST_DIR}/dialect_span_error.csv', columns={'a': 'INTEGER'}, delim=',', quote='"', escape='\', dialect='opencsv', header=false, auto_detect=false, parallel=false, ignore_errors=true, buffer_size=8, max_line_size=7) ORDER BY a;
----
12
456
789

# the delimiter prefix of a separator wider than one byte stays out of the field crossing the boundary
statement ok
COPY (SELECT * FROM (VALUES (repeat('x', 58)), ('ab"x"¦z')) t(line)) TO '{TEST_DIR}/dialect_wide_boundary.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query TT
SELECT * FROM read_csv('{TEST_DIR}/dialect_wide_boundary.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR'}, delim='¦', quote='"', escape='\', dialect='opencsv', header=false, auto_detect=false, parallel=false, buffer_size=61) ORDER BY b NULLS FIRST;
----
xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx	NULL
abx	z

statement ok
COPY (SELECT * FROM (VALUES (repeat('x', 60)), ('¦a"b"c')) t(line)) TO '{TEST_DIR}/dialect_wide_boundary2.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query TT
SELECT * FROM read_csv('{TEST_DIR}/dialect_wide_boundary2.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR'}, delim='¦', quote='"', escape='\', dialect='opencsv', header=false, auto_detect=false, parallel=false, buffer_size=61) ORDER BY b NULLS FIRST;
----
xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx	NULL
(empty)	ab"c

# a user NULL string compares against the normalized text, with the field counting as quoted for allow_quoted_nulls
statement ok
COPY (SELECT * FROM (VALUES ('1,"N\ULL"'), ('2,"NULL"'), ('3,NULL')) t(line)) TO '{TEST_DIR}/dialect_nullstr.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query ITI
SELECT a, b, b IS NULL FROM read_csv('{TEST_DIR}/dialect_nullstr.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR'}, delim=',', quote='"', escape='\', dialect='opencsv', nullstr='NULL', allow_quoted_nulls=false, header=false, auto_detect=false) ORDER BY a;
----
1	NULL	false
2	NULL	false
3	NULL	true

# an explicit empty NULL string is honored rather than replaced by the dialect's empty string reading
query II
SELECT a, b IS NULL FROM read_csv('{TEST_DIR}/dialect_padding.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR', 'n': 'INTEGER'}, delim=',', quote='"', dialect='opencsv', nullstr='', header=false, auto_detect=false) ORDER BY a;
----
1	false
2	false

# whitespace is what Java reads as whitespace, so an em space before a kept literal quote is discarded too
statement ok
COPY (SELECT 'xx,' || chr(8195) || '"a",z' AS line) TO '{TEST_DIR}/dialect_uni_ws.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query TTT
SELECT * FROM read_csv('{TEST_DIR}/dialect_uni_ws.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'}, delim=',', quote='"', escape='\', dialect='opencsv', header=false, auto_detect=false);
----
xx	a	z

# a NUL byte is not a separator, as opencsv refuses it
statement error
SELECT * FROM read_csv('{TEST_DIR}/dialect_rows.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR'}, delim=chr(0), dialect='opencsv', header=false, auto_detect=false);
----
DIALECT 'opencsv' requires a delimiter

# the normalized text of each field is copied out of the shared scratch buffer before the next field reuses or grows it
statement ok
COPY (SELECT * FROM (VALUES
    ('abcdefghijkl\mnopqrstuvwxyz'),
    ('b \"quoted\" part of a value'),
    ('c\\d\\e\\f long escaped value'),
    ('d 0123456\789 numbers here'),
    (repeat('x', 40) || '\' || repeat('y', 40) || '\"' || repeat('z', 20)),
    ('e value after\ the growth')
) t(line)) TO '{TEST_DIR}/dialect_scratch.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

# buffers of 110 to 150 bytes make the long value or its neighbours cross a boundary, the last size holds the file
foreach bsz 110 120 150 2000000

query T
SELECT * FROM read_csv('{TEST_DIR}/dialect_scratch.csv', columns={'v': 'VARCHAR'}, delim=',', quote='"', escape='\',
    dialect='opencsv', header=false, auto_detect=false, parallel=false, buffer_size={bsz}) ORDER BY v;
----
abcdefghijklmnopqrstuvwxyz
b "quoted" part of a value
c\d\e\f long escaped value
d 0123456789 numbers here
e value after the growth
xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"zzzzzzzzzzzzzzzzzzzz

endloop
