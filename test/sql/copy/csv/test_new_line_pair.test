# name: test/sql/copy/csv/test_new_line_pair.test
# description: A \r\n in the new_line list is one record terminator next to \r and \n, also across buffer boundaries
# group: [csv]

# a single column file, where an empty line is a NULL row
statement ok
COPY (SELECT ('a' || chr(13) || chr(10) || 'b' || chr(13) || chr(10)
|| 'c')::BLOB) TO '{TEST_DIR}/pair_crlf.csv' (FORMAT BLOB)

query I
FROM read_csv('{TEST_DIR}/pair_crlf.csv', columns = {'a': 'VARCHAR'}, header = false, new_line = ['\n', '\r', '\r\n'],
auto_detect = false)
----
a
b
c

statement ok
COPY (SELECT ('a' || chr(13) || chr(10) || 'b' || chr(13) || chr(10) || 'c' || chr(13)
|| chr(10))::BLOB) TO '{TEST_DIR}/pair_crlf_trail.csv' (FORMAT BLOB)

query I
FROM read_csv('{TEST_DIR}/pair_crlf_trail.csv', columns = {'a': 'VARCHAR'}, header = false,
new_line = ['\n', '\r', '\r\n'], auto_detect = false)
----
a
b
c

# the lenient preset on a CRLF file COPY wrote
statement ok
COPY (SELECT 'a' || chr(13) || chr(10) || 'b' || chr(13) || chr(10)
|| 'c') TO '{TEST_DIR}/pair_review.csv' (HEADER false, QUOTE '', ESCAPE '')

query II
SELECT count(*), count(x) FROM read_csv('{TEST_DIR}/pair_review.csv', columns={'x': 'VARCHAR'}, header=false,
auto_detect=false, escape_mode='anywhere', new_line=['\n', '\r', '\r\n'], ignore_extra_columns=true,
allow_unescaped_quotes=true, unterminated_quote='value')
----
3	3

# a pair behind a line feed, which the detection picks, keeps its line feed out of the next value
statement ok
COPY (SELECT 'a' || chr(10) || 'b' || chr(13) || chr(10) || 'c') TO '{TEST_DIR}/pair_lfcrlf.csv' (HEADER false,
QUOTE '', ESCAPE '')

query II
SELECT x, strlen(x) FROM read_csv('{TEST_DIR}/pair_lfcrlf.csv', columns={'x': 'VARCHAR'}, header=false,
auto_detect=false, quote='"', escape='\', parallel=false, new_line=['\n', '\r\n'])
----
a	1
b	1
c	1

# every listed line break ends a record once
statement ok
COPY (SELECT ('a' || chr(13) || 'b' || chr(13) || chr(10) || 'c' || chr(10) || 'd' || chr(13) || chr(10)
|| 'e')::BLOB) TO '{TEST_DIR}/pair_mixed.csv' (FORMAT BLOB)

query I
FROM read_csv('{TEST_DIR}/pair_mixed.csv', columns = {'a': 'VARCHAR'}, header = false, new_line = ['\n', '\r', '\r\n'],
auto_detect = false)
