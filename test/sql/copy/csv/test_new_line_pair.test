# files of mixed line breaks read the same rows for every buffer size, in parallel and single threaded
statement ok
PRAGMA verify_parallelism

statement ok
COPY (
    SELECT string_agg(lpad(CAST(id AS VARCHAR), 4, '0') || ',v' ||
        CASE id % 5 WHEN 0 THEN chr(10) WHEN 1 THEN chr(13) || chr(10) WHEN 2 THEN chr(13)
             WHEN 3 THEN chr(13) || chr(13) || chr(10) ELSE chr(13) || chr(10) END, '' ORDER BY id)::BLOB
    FROM generate_series(1, 60) t(id)
) TO '{TEST_DIR}/pair_mix_two.csv' (FORMAT BLOB)

statement ok
COPY (
    SELECT string_agg(lpad(CAST(id AS VARCHAR), 4, '0') ||
        CASE id % 4 WHEN 0 THEN chr(10) WHEN 1 THEN chr(13) || chr(10) WHEN 2 THEN chr(13) ELSE chr(13) || chr(10) END,
        '' ORDER BY id)::BLOB
    FROM generate_series(1, 60) t(id)
) TO '{TEST_DIR}/pair_mix_one.csv' (FORMAT BLOB)

# a Windows checkout of a line feed file
statement ok
COPY (
    SELECT string_agg(lpad(CAST(id AS VARCHAR), 4, '0') || chr(13) || chr(10), '' ORDER BY id)::BLOB
    FROM generate_series(1, 60) t(id)
) TO '{TEST_DIR}/pair_crlf_one.csv' (FORMAT BLOB)

# rows ending in a carriage return and a pair, an empty line each
statement ok
COPY (
    SELECT string_agg(lpad(CAST(id AS VARCHAR), 4, '0') || chr(13) || chr(13) || chr(10), '' ORDER BY id)::BLOB
    FROM generate_series(1, 60) t(id)
) TO '{TEST_DIR}/pair_rrn_one.csv' (FORMAT BLOB)

# a line feed file with five empty lines, read with the whole list
statement ok
COPY (
    SELECT string_agg(lpad(CAST(id AS VARCHAR), 4, '0') || chr(10) || CASE WHEN id % 12 = 0 THEN chr(10) ELSE '' END,
        '' ORDER BY id)::BLOB
    FROM generate_series(1, 60) t(id)
) TO '{TEST_DIR}/pair_lf_one.csv' (FORMAT BLOB)

