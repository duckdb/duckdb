new_line = ['\n', '\r', '\r\n'], buffer_size = {buffer_size})
----
p
q
ab\
z
c

endloop

# an escaped carriage return is data when the pair is not in the list, the line feed ends the row
statement ok
COPY (SELECT encode('p' || chr(10) || 'q' || chr(10) || 'ab\' || chr(13) || chr(10) || 'z' || chr(10) || 'c'
|| chr(10))) TO '{TEST_DIR}/pair_escaped_cr_lf_only.csv' (FORMAT BLOB)

loop buffer_size 7 11

query I
SELECT replace(replace(a, chr(10), '<LF>'), chr(13), '<CR>') FROM read_csv('{TEST_DIR}/pair_escaped_cr_lf_only.csv',
