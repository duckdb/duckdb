# an escaped line break at the start of a buffer continues the value
statement ok
COPY (SELECT encode('p' || chr(10) || 'q' || chr(10) || 'abc\' || chr(13) || chr(10) || 'z' || chr(10) || 'c'
|| chr(10))) TO '{TEST_DIR}/pair_escaped_crlf.csv' (FORMAT BLOB)

query I
SELECT replace(replace(a, chr(10), '<LF>'), chr(13), '<CR>') FROM read_csv('{TEST_DIR}/pair_escaped_crlf.csv',
columns = {'a': 'VARCHAR'}, header = false, auto_detect = false, escape = '\', escape_mode = 'anywhere',
new_line = ['\n', '\r\n'], buffer_size = 9)
----
p
q
abc<CR><LF>z
c

statement ok
COPY (SELECT encode('p' || chr(13) || chr(10) || 'q' || chr(13) || chr(10) || '123\' || chr(13) || chr(10) || '"b'
|| chr(13) || chr(10) || 'c' || chr(13) || chr(10) || 'd' || chr(13)
|| chr(10))) TO '{TEST_DIR}/pair_escaped_crlf_quote.csv' (FORMAT BLOB)

