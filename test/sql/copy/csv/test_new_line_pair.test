# an escaped escape before the line break does not escape it, also when a buffer end splits the two
statement ok
COPY (SELECT encode('p' || chr(10) || 'q' || chr(10) || 'abcd\\' || chr(10) || 'z' || chr(10) || 'c'
|| chr(10))) TO '{TEST_DIR}/pair_escaped_escape.csv' (FORMAT BLOB)

loop buffer_size 9 10

query I
FROM read_csv('{TEST_DIR}/pair_escaped_escape.csv', columns = {'a': 'VARCHAR'}, header = false, auto_detect = false,
escape = '\', escape_mode = 'anywhere', new_line = ['\n', '\r', '\r\n'], buffer_size = {buffer_size})
----
p
q
abcd\
z
c

endloop

# an escaped escape before a pair, the pair ends the row
statement ok
COPY (SELECT encode('p' || chr(10) || 'q' || chr(10) || 'ab\\' || chr(13) || chr(10) || 'z' || chr(10) || 'c'
|| chr(10))) TO '{TEST_DIR}/pair_escaped_escape_crlf.csv' (FORMAT BLOB)

loop buffer_size 8 12

