# the space delimiter keeps its meaning under the field quote rules
statement ok
COPY (SELECT 'a  b' AS line) TO '{TEST_DIR}/rule_space_delim.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query TTT
FROM read_csv('{TEST_DIR}/rule_space_delim.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'}, header=false, auto_detect=false, delim=' ', quote='"', escape='\', null_padding=true, embedded_quotes='doubled');
----
a	NULL	b

# an overlong encoding is invalid utf8 rather than whitespace in the toggle pass
statement error
FROM read_csv('data/csv/overlong_space.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR', 'c': 'INTEGER'}, header=false, auto_detect=false, quote='"', escape='\', embedded_quotes='toggle');
----
<REGEX>:.*(Invalid unicode|not utf-8).*

# a new_line list reads every listed line break as a record boundary
statement ok
COPY (SELECT 'a,b' || chr(13) || chr(10) || '1,2' || chr(10) || '3,4' || chr(13) || '5,6' || chr(13) || chr(10) AS line) TO '{TEST_DIR}/rule_mixed.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query I
SELECT count(*) FROM read_csv('{TEST_DIR}/rule_mixed.csv', header=true, new_line=['\n', '\r', '\r\n'], columns={'a': 'INTEGER', 'b': 'INTEGER'}, auto_detect=false);
----
3

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_mixed.csv', header=true, new_line='\r\n', columns={'a': 'INTEGER', 'b': 'INTEGER'}, auto_detect=false);
----
<REGEX>:.*invalid state.*

# a line break outside the list stays an invalid state
statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_mixed.csv', header=true, new_line=['\n', '\r\n'], columns={'a': 'INTEGER', 'b': 'INTEGER'}, auto_detect=false);
----
<REGEX>:.*invalid state.*

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_mixed.csv', header=true, new_line=['\r\n'], columns={'a': 'INTEGER', 'b': 'INTEGER'}, auto_detect=false);
----
<REGEX>:.*invalid state.*

# a one element list reads as the plain option
statement ok
COPY (SELECT 7 a, 8 b) TO '{TEST_DIR}/rule_single_rn.csv' (FORMAT csv, HEADER false, NEW_LINE '\r\n');

query II
SELECT * FROM read_csv('{TEST_DIR}/rule_single_rn.csv', columns={'a': 'INTEGER', 'b': 'INTEGER'}, header=false, auto_detect=false, new_line=['\r\n']);
----
7	8

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_mixed.csv', new_line=['\n', '\t']);
----
This is not accepted as a newline: \t

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_mixed.csv', new_line=[]);
----
NEW_LINE requires at least one line break in its list

# ignore_extra_columns reads fields beyond the last column as ignored
statement ok
COPY (SELECT '1,x,extra' AS line) TO '{TEST_DIR}/rule_extra.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query IT
SELECT * FROM read_csv('{TEST_DIR}/rule_extra.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR'}, delim=',', header=false, auto_detect=false, ignore_extra_columns=true);
----
1	x

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_extra.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR'}, delim=',', header=false, auto_detect=false);
