# name: test/sql/copy/csv/test_csv_rule_options.test
# description: The individual parsing rule options behind the CSV dialects
# group: [csv]

statement ok
COPY (SELECT * FROM (VALUES ('1,a\,7'), ('2,a\x,8'), ('3,c\')) t(line)) TO '{TEST_DIR}/rule_escape.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

# unquoted_escapes lets the escape work outside quoted values, escaping any character after it
query TTT
SELECT a, replace(b, chr(10), '<nl>'), c FROM read_csv('{TEST_DIR}/rule_escape.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'}, delim=',', quote='"', escape='\', header=false, auto_detect=false, null_padding=true, unquoted_escapes=true, mixed_line_breaks=true, ignore_extra_columns=true, allow_unescaped_quotes=true, allow_unterminated_quotes=true, parallel=false) ORDER BY a;
----
1	a,7	NULL
2	ax	8
3	c<nl>	NULL

# with escape_quotes_only the escape keeps the delimiter and line break active, as it only escapes specials
query TTT
SELECT * FROM read_csv('{TEST_DIR}/rule_escape.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'}, delim=',', quote='"', escape='\', header=false, auto_detect=false, null_padding=true, mixed_line_breaks=true, ignore_extra_columns=true, allow_unescaped_quotes=true, allow_unterminated_quotes=true, unquoted_escapes=true, escape_quotes_only=true) ORDER BY a;
----
1	a	7
2	ax	8
3	c	NULL

# without unquoted_escapes the escape is data outside quotes, the default
query TTT
SELECT * FROM read_csv('{TEST_DIR}/rule_escape.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'}, delim=',', quote='"', escape='\', header=false, auto_detect=false, null_padding=true, mixed_line_breaks=true, ignore_extra_columns=true, allow_unescaped_quotes=true, allow_unterminated_quotes=true, unquoted_escapes=false) ORDER BY a;
----
1	a\	7
2	a\x	8
3	c\	NULL

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_escape.csv', quote='"', escape='"', unquoted_escapes=true, escape_quotes_only=true);
----
ESCAPE_QUOTES_ONLY requires an ESCAPE character other than the QUOTE character

# line_records ends the record on a line break even inside quotes, on its own
statement ok
COPY (SELECT * FROM (VALUES ('1,"x'), ('y",2'), ('3,ok,4')) t(line)) TO '{TEST_DIR}/rule_lines.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query TTT
SELECT * FROM read_csv('{TEST_DIR}/rule_lines.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'}, delim=',', quote='"', escape='\', header=false, auto_detect=false, null_padding=true, unquoted_escapes=true, mixed_line_breaks=true, ignore_extra_columns=true, allow_unescaped_quotes=true, allow_unterminated_quotes=true, line_records=true) ORDER BY a;
----
1	NULL	NULL
3	ok	4
y"	2	NULL

# doubled_quotes collapses a doubled quote with an unrelated escape, in and outside quoted values
statement ok
COPY (SELECT * FROM (VALUES ('1,"a""b"'), ('2,p""q')) t(line)) TO '{TEST_DIR}/rule_doubled.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query TT
SELECT a, b FROM read_csv('{TEST_DIR}/rule_doubled.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR'}, delim=',', quote='"', escape='\', header=false, auto_detect=false, unquoted_escapes=true, mixed_line_breaks=true, ignore_extra_columns=true, allow_unescaped_quotes=true, allow_unterminated_quotes=true, doubled_quotes=true) ORDER BY a;
----
1	a"b
2	p"q

# without doubled_quotes a doubled quote under embedded_quotes is two toggles, each kept by the position rule
statement ok
COPY (SELECT '1,a""b,2' AS line) TO '{TEST_DIR}/rule_two_toggles.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query ITI
SELECT * FROM read_csv('{TEST_DIR}/rule_two_toggles.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR', 'c': 'INTEGER'}, delim=',', quote='"', escape='\', header=false, auto_detect=false, embedded_quotes=true, line_records=true, null_padding=true);
----
1	a""b	2

# embedded_quotes applies opencsv's embedded quote rule on its own
statement ok
COPY (SELECT '1,a"b"c,2' AS line) TO '{TEST_DIR}/rule_embedded.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query TTT
SELECT * FROM read_csv('{TEST_DIR}/rule_embedded.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'}, delim=',', quote='"', escape='\', header=false, auto_detect=false, unquoted_escapes=true, mixed_line_breaks=true, ignore_extra_columns=true, allow_unescaped_quotes=true, allow_unterminated_quotes=true, embedded_quotes=true, doubled_quotes=true);
----
1	a"b"c	2

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_embedded.csv', quote='"', escape='"', embedded_quotes=true);
----
EMBEDDED_QUOTES requires a QUOTE character other than the ESCAPE character

# mixed_line_breaks reads any line break as a record boundary, also in strict mode
statement ok
COPY (SELECT 'a,b' || chr(13) || chr(10) || '1,2' || chr(10) || '3,4' || chr(13) || '5,6' || chr(13) || chr(10) AS line) TO '{TEST_DIR}/rule_mixed.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query I
SELECT count(*) FROM read_csv('{TEST_DIR}/rule_mixed.csv', header=true, new_line='\r\n', columns={'a': 'INTEGER', 'b': 'INTEGER'}, auto_detect=false, mixed_line_breaks=true);
----
3

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_mixed.csv', header=true, new_line='\r\n', columns={'a': 'INTEGER', 'b': 'INTEGER'}, auto_detect=false);
----
<REGEX>:.*invalid state.*

# ignore_extra_columns reads fields beyond the last column as ignored, also in strict mode
statement ok
COPY (SELECT '1,x,extra' AS line) TO '{TEST_DIR}/rule_extra.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query IT
SELECT * FROM read_csv('{TEST_DIR}/rule_extra.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR'}, delim=',', header=false, auto_detect=false, ignore_extra_columns=true);
----
1	x

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_extra.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR'}, delim=',', header=false, auto_detect=false);
----
<REGEX>:.*Expected Number of Columns.*

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_extra.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR'}, delim=',', header=false, auto_detect=false, ignore_extra_columns=false);
----
<REGEX>:.*Expected Number of Columns.*

# allow_unescaped_quotes reads content after a closing quote as in unstrict parsing, also in strict mode
statement ok
COPY (SELECT '1,"a"x,2' AS line) TO '{TEST_DIR}/rule_unescaped.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query ITI
SELECT * FROM read_csv('{TEST_DIR}/rule_unescaped.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR', 'c': 'INTEGER'}, delim=',', header=false, auto_detect=false, allow_unescaped_quotes=true);
----
1	a	2

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_unescaped.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR', 'c': 'INTEGER'}, delim=',', header=false, auto_detect=false);
----
<REGEX>:.*(invalid state|unterminated quote).*

# allow_unterminated_quotes reads a quote that never closes as a value, also in strict mode
statement ok
COPY (SELECT '1,"abc' AS line) TO '{TEST_DIR}/rule_unterminated.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query IT
SELECT * FROM read_csv('{TEST_DIR}/rule_unterminated.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR'}, delim=',', header=false, auto_detect=false, allow_unterminated_quotes=true, parallel=false);
----
1	abc

# COPY FROM reads the rule options, the writer refuses them
statement ok
CREATE TABLE rule_rows (a VARCHAR, b VARCHAR, c VARCHAR);

statement ok
COPY rule_rows FROM '{TEST_DIR}/rule_escape.csv' (DELIM ',', QUOTE '"', ESCAPE '\', HEADER false, MIXED_LINE_BREAKS true, IGNORE_EXTRA_COLUMNS true, ALLOW_UNESCAPED_QUOTES true, ALLOW_UNTERMINATED_QUOTES true, NULL_PADDING true, AUTO_DETECT false, UNQUOTED_ESCAPES true, ESCAPE_QUOTES_ONLY true);

query I
SELECT count(*) FROM rule_rows;
----
3

statement error
COPY rule_rows TO '{TEST_DIR}/rule_out.csv' (UNQUOTED_ESCAPES true, ESCAPE_QUOTES_ONLY true);
----
<REGEX>:.*not supported for writing.*
