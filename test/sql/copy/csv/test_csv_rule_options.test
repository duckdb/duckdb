# name: test/sql/copy/csv/test_csv_rule_options.test
# description: The individual parsing rule options behind the CSV dialects
# group: [csv]

statement ok
COPY (SELECT * FROM (VALUES ('1,a\,7'), ('2,a\x,8'), ('3,c\')) t(line)) TO '{TEST_DIR}/rule_escape.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

# escape_mode anywhere lets the escape work outside quoted values, escaping any character after it
query TTT
SELECT a, replace(b, chr(10), '<nl>'), c FROM read_csv('{TEST_DIR}/rule_escape.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'}, delim=',', quote='"', escape='\', header=false, auto_detect=false, null_padding=true, escape_mode='anywhere', new_line=['\n', '\r', '\r\n'], ignore_extra_columns=true, allow_unescaped_quotes=true, unterminated_quote='value', parallel=false) ORDER BY a;
----
1	a,7	NULL
2	ax	8
3	c<nl>	NULL

# escape_mode quotes_only keeps the delimiter and line break active, as the escape only escapes specials
query TTT
SELECT * FROM read_csv('{TEST_DIR}/rule_escape.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'}, delim=',', quote='"', escape='\', header=false, auto_detect=false, null_padding=true, new_line=['\n', '\r', '\r\n'], ignore_extra_columns=true, allow_unescaped_quotes=true, unterminated_quote='value', escape_mode='quotes_only') ORDER BY a;
----
1	a	7
2	ax	8
3	c	NULL

# escape_mode quoted reads the escape as data outside quotes, the default
query TTT
SELECT * FROM read_csv('{TEST_DIR}/rule_escape.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'}, delim=',', quote='"', escape='\', header=false, auto_detect=false, null_padding=true, new_line=['\n', '\r', '\r\n'], ignore_extra_columns=true, allow_unescaped_quotes=true, unterminated_quote='value', escape_mode='quoted') ORDER BY a;
----
1	a\	7
2	a\x	8
3	c\	NULL

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_escape.csv', quote='"', escape='"', escape_mode='quotes_only');
----
ESCAPE_MODE 'quotes_only' requires an ESCAPE character other than the QUOTE character

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_escape.csv', escape_mode='sometimes');
----
ESCAPE_MODE must be quoted, anywhere or quotes_only

# unterminated_quote null_at_line_end ends the record on a line break even inside quotes
statement ok
COPY (SELECT * FROM (VALUES ('1,"x'), ('y",2'), ('3,ok,4')) t(line)) TO '{TEST_DIR}/rule_lines.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query TTT
SELECT * FROM read_csv('{TEST_DIR}/rule_lines.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'}, delim=',', quote='"', escape='\', header=false, auto_detect=false, null_padding=true, escape_mode='anywhere', new_line=['\n', '\r', '\r\n'], ignore_extra_columns=true, allow_unescaped_quotes=true, unterminated_quote='null_at_line_end') ORDER BY a;
----
1	NULL	NULL
3	ok	4
y"	2	NULL

# the field left open counts toward the column check
statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_lines.csv', columns={'a': 'VARCHAR'}, delim=',', quote='"', escape='\', header=false, auto_detect=false, unterminated_quote='null_at_line_end');
----
<REGEX>:.*Expected Number of Columns.*

# embedded_quotes doubled collapses a doubled quote with an unrelated escape, in and outside quoted values
statement ok
COPY (SELECT * FROM (VALUES ('1,"a""b"'), ('2,p""q')) t(line)) TO '{TEST_DIR}/rule_doubled.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query TT
SELECT a, b FROM read_csv('{TEST_DIR}/rule_doubled.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR'}, delim=',', quote='"', escape='\', header=false, auto_detect=false, escape_mode='anywhere', new_line=['\n', '\r', '\r\n'], ignore_extra_columns=true, allow_unescaped_quotes=true, unterminated_quote='value', embedded_quotes='doubled') ORDER BY a;
----
1	a"b
2	p"q

# under the toggle alone a doubled quote is two toggles, each kept by the position rule
statement ok
COPY (SELECT '1,a""b,2' AS line) TO '{TEST_DIR}/rule_two_toggles.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query ITI
SELECT * FROM read_csv('{TEST_DIR}/rule_two_toggles.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR', 'c': 'INTEGER'}, delim=',', quote='"', escape='\', header=false, auto_detect=false, embedded_quotes='toggle', unterminated_quote='null_at_line_end', null_padding=true);
----
1	a""b	2

# embedded_quotes doubled_toggle applies opencsv's embedded quote rule
statement ok
COPY (SELECT '1,a"b"c,2' AS line) TO '{TEST_DIR}/rule_embedded.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query TTT
SELECT * FROM read_csv('{TEST_DIR}/rule_embedded.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'}, delim=',', quote='"', escape='\', header=false, auto_detect=false, escape_mode='anywhere', new_line=['\n', '\r', '\r\n'], ignore_extra_columns=true, allow_unescaped_quotes=true, unterminated_quote='value', embedded_quotes='doubled_toggle');
----
1	a"b"c	2

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_embedded.csv', quote='"', escape='"', embedded_quotes='toggle');
----
EMBEDDED_QUOTES requires a QUOTE character other than the ESCAPE character

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_embedded.csv', embedded_quotes='twice');
----
EMBEDDED_QUOTES must be none, doubled, toggle or doubled_toggle

# the toggle leaves the escape alone under the default escape rule
statement ok
COPY (SELECT * FROM (VALUES ('xx,a\b"c"d,z'), ('xx,a\b,z')) t(line)) TO '{TEST_DIR}/rule_toggle_escape.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query T
SELECT b FROM read_csv('{TEST_DIR}/rule_toggle_escape.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'}, header=false, auto_detect=false, quote='"', escape='\', embedded_quotes='toggle') ORDER BY ALL;
----
a\b
a\b"c"d

# a toggled quote reads across line breaks unless the line rule is on
statement ok
COPY (SELECT * FROM (VALUES ('1,a"'), ('b"'), ('2,c')) t(line)) TO '{TEST_DIR}/rule_toggle_nl.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query TT
SELECT x, replace(y, chr(10), '<LF>') FROM read_csv('{TEST_DIR}/rule_toggle_nl.csv', columns={'x': 'VARCHAR', 'y': 'VARCHAR'}, header=false, auto_detect=false, quote='"', escape='\', null_padding=true, embedded_quotes='toggle', parallel=false) ORDER BY x;
----
1	a"<LF>b
2	c

# the space delimiter keeps its meaning under the field quote rules
statement ok
COPY (SELECT 'a  b' AS line) TO '{TEST_DIR}/rule_space_delim.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query TTT
FROM read_csv('{TEST_DIR}/rule_space_delim.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'}, header=false, auto_detect=false, delim=' ', quote='"', escape='\', null_padding=true, embedded_quotes='doubled');
----
a	NULL	b

# an overlong encoding is invalid utf8 rather than whitespace in the toggle pass
statement error
FROM read_csv('data/csv/overlong_space.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR', 'c': 'INTEGER'}, header=false, auto_detect=false, quote='"', escape='\', embedded_quotes='toggle');
----
<REGEX>:.*(Invalid unicode|not utf-8).*

# a new_line list reads every listed line break as a record boundary
statement ok
COPY (SELECT 'a,b' || chr(13) || chr(10) || '1,2' || chr(10) || '3,4' || chr(13) || '5,6' || chr(13) || chr(10) AS line) TO '{TEST_DIR}/rule_mixed.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query I
SELECT count(*) FROM read_csv('{TEST_DIR}/rule_mixed.csv', header=true, new_line=['\n', '\r', '\r\n'], columns={'a': 'INTEGER', 'b': 'INTEGER'}, auto_detect=false);
----
3

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_mixed.csv', header=true, new_line='\r\n', columns={'a': 'INTEGER', 'b': 'INTEGER'}, auto_detect=false);
----
<REGEX>:.*invalid state.*

# a line break outside the list stays an invalid state
statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_mixed.csv', header=true, new_line=['\n', '\r\n'], columns={'a': 'INTEGER', 'b': 'INTEGER'}, auto_detect=false);
----
<REGEX>:.*invalid state.*

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_mixed.csv', header=true, new_line=['\r\n'], columns={'a': 'INTEGER', 'b': 'INTEGER'}, auto_detect=false);
----
<REGEX>:.*invalid state.*

# a one element list reads as the plain option
statement ok
COPY (SELECT 7 a, 8 b) TO '{TEST_DIR}/rule_single_rn.csv' (FORMAT csv, HEADER false, NEW_LINE '\r\n');

query II
SELECT * FROM read_csv('{TEST_DIR}/rule_single_rn.csv', columns={'a': 'INTEGER', 'b': 'INTEGER'}, header=false, auto_detect=false, new_line=['\r\n']);
----
7	8

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_mixed.csv', new_line=['\n', '\t']);
----
This is not accepted as a newline: \t

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_mixed.csv', new_line=[]);
----
NEW_LINE requires at least one line break in its list

# ignore_extra_columns reads fields beyond the last column as ignored
statement ok
COPY (SELECT '1,x,extra' AS line) TO '{TEST_DIR}/rule_extra.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query IT
SELECT * FROM read_csv('{TEST_DIR}/rule_extra.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR'}, delim=',', header=false, auto_detect=false, ignore_extra_columns=true);
----
1	x

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_extra.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR'}, delim=',', header=false, auto_detect=false);
----
<REGEX>:.*Expected Number of Columns.*

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_extra.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR'}, delim=',', header=false, auto_detect=false, ignore_extra_columns=false);
----
<REGEX>:.*Expected Number of Columns.*

# allow_unescaped_quotes reads content after a closing quote as in unstrict parsing
statement ok
COPY (SELECT '1,"a"x,2' AS line) TO '{TEST_DIR}/rule_unescaped.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query ITI
SELECT * FROM read_csv('{TEST_DIR}/rule_unescaped.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR', 'c': 'INTEGER'}, delim=',', header=false, auto_detect=false, allow_unescaped_quotes=true);
----
1	a	2

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_unescaped.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR', 'c': 'INTEGER'}, delim=',', header=false, auto_detect=false);
----
<REGEX>:.*(invalid state|unterminated quote).*

# unterminated_quote value reads a quote that never closes as a value
statement ok
COPY (SELECT '1,"abc' AS line) TO '{TEST_DIR}/rule_unterminated.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query IT
SELECT * FROM read_csv('{TEST_DIR}/rule_unterminated.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR'}, delim=',', header=false, auto_detect=false, unterminated_quote='value', parallel=false);
----
1	abc

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_unterminated.csv', unterminated_quote='maybe');
----
UNTERMINATED_QUOTE must be error, value or null_at_line_end

# COPY FROM reads the rule options, the writer refuses them
statement ok
CREATE TABLE rule_rows (a VARCHAR, b VARCHAR, c VARCHAR);

statement ok
COPY rule_rows FROM '{TEST_DIR}/rule_escape.csv' (DELIM ',', QUOTE '"', ESCAPE '\', HEADER false, NEW_LINE ['\n', '\r', '\r\n'], IGNORE_EXTRA_COLUMNS true, ALLOW_UNESCAPED_QUOTES true, UNTERMINATED_QUOTE 'value', NULL_PADDING true, AUTO_DETECT false, ESCAPE_MODE 'quotes_only');

query I
SELECT count(*) FROM rule_rows;
----
3

statement error
COPY rule_rows TO '{TEST_DIR}/rule_out.csv' (ESCAPE_MODE 'quotes_only');
----
<REGEX>:.*not supported for writing.*

# the writer takes a single line break only
statement error
COPY rule_rows TO '{TEST_DIR}/rule_out.csv' (NEW_LINE ['\n', '\r']);
----
<REGEX>:.*single argument.*

# an empty line whose line break starts a buffer does not shift the embedded quote position of the next row
statement ok
COPY (FROM (VALUES (repeat('x', 31)), (''), ('ab"c"d')) t(a)) TO '{TEST_DIR}/rule_empty_line_buffer_start.csv' (HEADER false, QUOTE '', ESCAPE '', NEW_LINE '\r\n');

foreach buffer_size 32 2000000

query T
SELECT a FROM read_csv('{TEST_DIR}/rule_empty_line_buffer_start.csv', columns={'a': 'VARCHAR'}, header=false, auto_detect=false, quote='"', escape='\', embedded_quotes='toggle', new_line='\r\n', buffer_size={buffer_size}, parallel=false);
----
xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NULL
abc"d

endloop
