# allow_unescaped_quotes reads content after a closing quote as in unstrict parsing
statement ok
COPY (SELECT '1,"a"x,2' AS line) TO '{TEST_DIR}/rule_unescaped.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query ITI
SELECT * FROM read_csv('{TEST_DIR}/rule_unescaped.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR', 'c': 'INTEGER'}, delim=',', header=false, auto_detect=false, allow_unescaped_quotes=true);
----
1	a	2

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_unescaped.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR', 'c': 'INTEGER'}, delim=',', header=false, auto_detect=false);
----
<REGEX>:.*(invalid state|unterminated quote).*

# unterminated_quote value reads a quote that never closes as a value
statement ok
COPY (SELECT '1,"abc' AS line) TO '{TEST_DIR}/rule_unterminated.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query IT
SELECT * FROM read_csv('{TEST_DIR}/rule_unterminated.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR'}, delim=',', header=false, auto_detect=false, unterminated_quote='value', parallel=false);
----
1	abc

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_unterminated.csv', unterminated_quote='maybe');
----
UNTERMINATED_QUOTE must be error, value or null_at_line_end

# COPY FROM reads the rule options, the writer refuses them
statement ok
CREATE TABLE rule_rows (a VARCHAR, b VARCHAR, c VARCHAR);

statement ok
COPY rule_rows FROM '{TEST_DIR}/rule_escape.csv' (DELIM ',', QUOTE '"', ESCAPE '\', HEADER false, NEW_LINE ['\n', '\r', '\r\n'], IGNORE_EXTRA_COLUMNS true, ALLOW_UNESCAPED_QUOTES true, UNTERMINATED_QUOTE 'value', NULL_PADDING true, AUTO_DETECT false, ESCAPE_MODE 'quotes_only');

query I
SELECT count(*) FROM rule_rows;
----
3

statement error
COPY rule_rows TO '{TEST_DIR}/rule_out.csv' (ESCAPE_MODE 'quotes_only');
----
<REGEX>:.*not supported for writing.*

# the writer takes a single line break only
statement error
COPY rule_rows TO '{TEST_DIR}/rule_out.csv' (NEW_LINE ['\n', '\r']);
----
<REGEX>:.*single argument.*

# an empty line whose line break starts a buffer does not shift the embedded quote position of the next row
statement ok
COPY (FROM (VALUES (repeat('x', 31)), (''), ('ab"c"d')) t(a)) TO '{TEST_DIR}/rule_empty_line_buffer_start.csv' (HEADER false, QUOTE '', ESCAPE '', NEW_LINE '\r\n');

foreach buffer_size 32 2000000

query T
SELECT a FROM read_csv('{TEST_DIR}/rule_empty_line_buffer_start.csv', columns={'a': 'VARCHAR'}, header=false, auto_detect=false, quote='"', escape='\', embedded_quotes='toggle', new_line='\r\n', buffer_size={buffer_size}, parallel=false);
----
xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NULL
abc"d

endloop
