statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_toggle_eof_buffers.csv', columns={'v': 'VARCHAR'}, header=false, auto_detect=false, quote='"', escape='\', embedded_quotes='toggle', buffer_size=8, parallel={parallel});
