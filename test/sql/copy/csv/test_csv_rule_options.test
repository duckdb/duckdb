# name: test/sql/copy/csv/test_csv_rule_options.test
# description: The individual parsing rule options behind the CSV dialects
# group: [csv]

statement ok
COPY (SELECT * FROM (VALUES ('1,a\,7'), ('2,a\x,8'), ('3,c\')) t(line)) TO '{TEST_DIR}/rule_escape.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

# escape_mode anywhere keeps a plain quote as data when it escapes the delimiter
statement ok
COPY (SELECT '1,a\,b"c' AS line) TO '{TEST_DIR}/rule_escape_quote.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query T
SELECT b FROM read_csv('{TEST_DIR}/rule_escape_quote.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR'}, header=false, auto_detect=false, quote='"', escape='\', escape_mode='anywhere');
----
a,b"c

# an escape leading NULL string matches literally when the escape only works inside quotes
statement ok
COPY (SELECT * FROM (VALUES ('1,\N'), ('2,x')) t(line)) TO '{TEST_DIR}/rule_nullstr_escape.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query IT
SELECT a, b IS NULL FROM read_csv('{TEST_DIR}/rule_nullstr_escape.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR'}, header=false, auto_detect=false, quote='"', escape='\', nullstr='\N') ORDER BY a;
----
1	true
2	false

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_nullstr_escape.csv', new_line=NULL::VARCHAR[]);
----
This is not accepted as a newline

# escape_mode anywhere lets the escape work outside quoted values, escaping any character after it
query TTT
SELECT a, replace(b, chr(10), '<nl>'), c FROM read_csv('{TEST_DIR}/rule_escape.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'}, delim=',', quote='"', escape='\', header=false, auto_detect=false, null_padding=true, escape_mode='anywhere', new_line=['\n', '\r', '\r\n'], ignore_extra_columns=true, allow_unescaped_quotes=true, unterminated_quote='value', parallel=false) ORDER BY a;
----
1	a,7	NULL
2	ax	8
3	c<nl>	NULL

# escape_mode quotes_only keeps the delimiter and line break active, as the escape only escapes specials
query TTT
SELECT * FROM read_csv('{TEST_DIR}/rule_escape.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'}, delim=',', quote='"', escape='\', header=false, auto_detect=false, null_padding=true, new_line=['\n', '\r', '\r\n'], ignore_extra_columns=true, allow_unescaped_quotes=true, unterminated_quote='value', escape_mode='quotes_only') ORDER BY a;
----
1	a	7
2	ax	8
3	c	NULL

# escape_mode quoted reads the escape as data outside quotes, the default
query TTT
SELECT * FROM read_csv('{TEST_DIR}/rule_escape.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'}, delim=',', quote='"', escape='\', header=false, auto_detect=false, null_padding=true, new_line=['\n', '\r', '\r\n'], ignore_extra_columns=true, allow_unescaped_quotes=true, unterminated_quote='value', escape_mode='quoted') ORDER BY a;
----
1	a\	7
2	a\x	8
3	c\	NULL

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_escape.csv', quote='"', escape='"', escape_mode='quotes_only');
----
ESCAPE_MODE 'quotes_only' requires an ESCAPE character other than the QUOTE character

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_escape.csv', escape_mode='sometimes');
----
ESCAPE_MODE must be quoted, anywhere or quotes_only

# unterminated_quote null_at_line_end ends the record on a line break even inside quotes
statement ok
COPY (SELECT * FROM (VALUES ('1,"x'), ('y",2'), ('3,ok,4')) t(line)) TO '{TEST_DIR}/rule_lines.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query TTT
SELECT * FROM read_csv('{TEST_DIR}/rule_lines.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'}, delim=',', quote='"', escape='\', header=false, auto_detect=false, null_padding=true, escape_mode='anywhere', new_line=['\n', '\r', '\r\n'], ignore_extra_columns=true, allow_unescaped_quotes=true, unterminated_quote='null_at_line_end') ORDER BY a;
----
1	NULL	NULL
3	ok	4
y"	2	NULL

# the field left open counts toward the column check
statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_lines.csv', columns={'a': 'VARCHAR'}, delim=',', quote='"', escape='\', header=false, auto_detect=false, unterminated_quote='null_at_line_end');
----
<REGEX>:.*Expected Number of Columns.*

# embedded_quotes doubled collapses a doubled quote with an unrelated escape, in and outside quoted values
statement ok
COPY (SELECT * FROM (VALUES ('1,"a""b"'), ('2,p""q')) t(line)) TO '{TEST_DIR}/rule_doubled.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query TT
SELECT a, b FROM read_csv('{TEST_DIR}/rule_doubled.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR'}, delim=',', quote='"', escape='\', header=false, auto_detect=false, embedded_quotes='doubled') ORDER BY a;
----
1	a"b
2	p"q

# an escape that does not work in a plain field stays data when a quote sends the field through unescaping
statement ok
COPY (SELECT * FROM (VALUES ('1,a\b""c'), ('2,ab\c"'), ('3,"a\"b""c"'), ('4,a\""b')) t(line)) TO '{TEST_DIR}/rule_doubled_escape.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

foreach buffer_size 12 13 2000000

foreach parallel true false

query IT
SELECT a, b FROM read_csv('{TEST_DIR}/rule_doubled_escape.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR'}, header=false, auto_detect=false, quote='"', escape='\', embedded_quotes='doubled', new_line='\n', buffer_size={buffer_size}, parallel={parallel}) ORDER BY a;
----
1	a\b"c
2	ab\c"
3	a"b"c
4	a\"b

endloop

endloop

query IT
SELECT a, b FROM read_csv('{TEST_DIR}/rule_doubled_escape.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR'}, header=false, auto_detect=false, quote='"', escape='\', embedded_quotes='doubled', unterminated_quote='null_at_line_end') WHERE a = 2;
----
2	ab\c"

# where the escape works outside quotes it is consumed there
foreach escape_mode anywhere quotes_only

query IT
SELECT a, b FROM read_csv('{TEST_DIR}/rule_doubled_escape.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR'}, header=false, auto_detect=false, quote='"', escape='\', escape_mode='{escape_mode}', embedded_quotes='doubled') WHERE a < 4 ORDER BY a;
----
1	ab"c
2	abc"
3	a"b"c

endloop

# without an escape character a NUL byte in a field with a doubled quote is data
statement ok
COPY (SELECT 'a' || chr(0) || 'b""c' AS line) TO '{TEST_DIR}/rule_doubled_nul.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query IT
SELECT length(v), v = 'a' || chr(0) || 'b"c' FROM read_csv('{TEST_DIR}/rule_doubled_nul.csv', columns={'v': 'VARCHAR'}, header=false, auto_detect=false, quote='"', escape='', embedded_quotes='doubled');
----
5	true

# a lone quote under doubled stays data, also when a line rule reads open quotes as NULL
statement ok
COPY (SELECT * FROM (VALUES ('1,ab"'), ('2,c')) t(line)) TO '{TEST_DIR}/rule_doubled_lone.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query IT
SELECT a, b FROM read_csv('{TEST_DIR}/rule_doubled_lone.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR'}, header=false, auto_detect=false, quote='"', escape='\', embedded_quotes='doubled', unterminated_quote='null_at_line_end') ORDER BY a;
----
1	ab"
2	c

query IT
SELECT a, b FROM read_csv('{TEST_DIR}/rule_doubled_lone.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR'}, header=false, auto_detect=false, quote='"', escape='\', embedded_quotes='doubled') ORDER BY a;
----
1	ab"
2	c

query TT
SELECT a, b FROM read_csv('{TEST_DIR}/rule_doubled.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR'}, delim=',', quote='"', escape='\', header=false, auto_detect=false, escape_mode='anywhere', new_line=['\n', '\r', '\r\n'], ignore_extra_columns=true, allow_unescaped_quotes=true, unterminated_quote='value', embedded_quotes='doubled') ORDER BY a;
----
1	a"b
2	p"q

# without an escape character a doubled quote collapses too, wherever a buffer boundary falls in its field
statement ok
COPY (SELECT * FROM (VALUES ('p'), ('q'), ('abcd""e'), ('z')) t(line)) TO '{TEST_DIR}/rule_doubled_boundary.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

foreach buffer_size 8 64

query T
SELECT * FROM read_csv('{TEST_DIR}/rule_doubled_boundary.csv', columns={'v': 'VARCHAR'}, header=false, auto_detect=false, quote='"', escape='', embedded_quotes='doubled', new_line='\n', buffer_size={buffer_size}, parallel=false);
----
p
q
abcd"e
z

endloop

loop prefix 1 8

statement ok
COPY (SELECT encode(repeat('p', {prefix}) || chr(10) || 'ab""c' || chr(10) || 'z' || chr(10))) TO '{TEST_DIR}/rule_doubled_buffers.csv' (FORMAT BLOB);

foreach embedded_quotes doubled toggle doubled_toggle

foreach parallel true false

query T
SELECT * FROM read_csv('{TEST_DIR}/rule_doubled_buffers.csv', columns={'v': 'VARCHAR'}, header=false, auto_detect=false, quote='"', escape='', embedded_quotes='{embedded_quotes}', new_line='\n', buffer_size=8, parallel={parallel}) WHERE v NOT LIKE 'p%';
----
ab"c
z

endloop

endloop

endloop

# under the toggle alone a doubled quote is two toggles, each kept by the position rule
statement ok
COPY (SELECT '1,a""b,2' AS line) TO '{TEST_DIR}/rule_two_toggles.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query ITI
SELECT * FROM read_csv('{TEST_DIR}/rule_two_toggles.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR', 'c': 'INTEGER'}, delim=',', quote='"', escape='\', header=false, auto_detect=false, embedded_quotes='toggle', unterminated_quote='null_at_line_end', null_padding=true);
----
1	a""b	2

# embedded_quotes doubled_toggle applies opencsv's embedded quote rule
statement ok
COPY (SELECT '1,a"b"c,2' AS line) TO '{TEST_DIR}/rule_embedded.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query TTT
SELECT * FROM read_csv('{TEST_DIR}/rule_embedded.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'}, delim=',', quote='"', escape='\', header=false, auto_detect=false, escape_mode='anywhere', new_line=['\n', '\r', '\r\n'], ignore_extra_columns=true, allow_unescaped_quotes=true, unterminated_quote='value', embedded_quotes='doubled_toggle');
----
1	a"b"c	2

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_embedded.csv', quote='"', escape='"', embedded_quotes='toggle');
----
EMBEDDED_QUOTES requires a QUOTE character other than the ESCAPE character

statement error
SELECT * FROM read_csv('{TEST_DIR}/rule_embedded.csv', embedded_quotes='twice');
----
EMBEDDED_QUOTES must be none, doubled, toggle or doubled_toggle

# the toggle reads escapes inside its quotes under every escape rule
statement ok
COPY (SELECT 'xx,a"\"b",z' AS line) TO '{TEST_DIR}/rule_toggle_quoted_escape.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query TTT
SELECT * FROM read_csv('{TEST_DIR}/rule_toggle_quoted_escape.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'}, header=false, auto_detect=false, quote='"', escape='\', embedded_quotes='toggle');
----
xx	a""b	z

# the toggle leaves the escape alone under the default escape rule
statement ok
COPY (SELECT * FROM (VALUES ('xx,a\b"c"d,z'), ('xx,a\b,z')) t(line)) TO '{TEST_DIR}/rule_toggle_escape.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query T
SELECT b FROM read_csv('{TEST_DIR}/rule_toggle_escape.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'}, header=false, auto_detect=false, quote='"', escape='\', embedded_quotes='toggle') ORDER BY ALL;
----
a\b
a\b"c"d

# a toggled quote reads across line breaks unless the line rule is on
statement ok
COPY (SELECT * FROM (VALUES ('1,a"'), ('b"'), ('2,c')) t(line)) TO '{TEST_DIR}/rule_toggle_nl.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query TT
SELECT x, replace(y, chr(10), '<LF>') FROM read_csv('{TEST_DIR}/rule_toggle_nl.csv', columns={'x': 'VARCHAR', 'y': 'VARCHAR'}, header=false, auto_detect=false, quote='"', escape='\', null_padding=true, embedded_quotes='toggle', parallel=false) ORDER BY x;
----
1	a"<LF>b
2	c

# a toggle section left open at the end of the file is an unterminated quote, with or without a final line break
statement ok
COPY (SELECT encode('x' || chr(10) || 'a"')) TO '{TEST_DIR}/rule_toggle_eof.csv' (FORMAT BLOB);

statement ok
COPY (SELECT encode('x' || chr(10) || 'a"' || chr(10))) TO '{TEST_DIR}/rule_toggle_eof_nl.csv' (FORMAT BLOB);

foreach embedded_quotes toggle doubled_toggle

foreach file rule_toggle_eof.csv rule_toggle_eof_nl.csv

statement error
SELECT * FROM read_csv('{TEST_DIR}/{file}', columns={'v': 'VARCHAR'}, header=false, auto_detect=false, quote='"', escape='\', embedded_quotes='{embedded_quotes}');
----
Value with unterminated quote found

foreach parallel true false

query T
SELECT * FROM read_csv('{TEST_DIR}/{file}', columns={'v': 'VARCHAR'}, header=false, auto_detect=false, quote='"', escape='\', embedded_quotes='{embedded_quotes}', ignore_errors=true, parallel={parallel});
----
x

query T
SELECT * FROM read_csv('{TEST_DIR}/{file}', columns={'v': 'VARCHAR'}, header=false, auto_detect=false, quote='"', escape='\', embedded_quotes='{embedded_quotes}', unterminated_quote='null_at_line_end', parallel={parallel});
----
x
NULL

endloop

endloop

# read as a value the field left open keeps its text
query T
SELECT * FROM read_csv('{TEST_DIR}/rule_toggle_eof.csv', columns={'v': 'VARCHAR'}, header=false, auto_detect=false, quote='"', escape='\', embedded_quotes='{embedded_quotes}', unterminated_quote='value');
----
x
a

endloop

