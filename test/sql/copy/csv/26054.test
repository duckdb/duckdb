# name: test/sql/copy/csv/26054.test
# description: Test nullstr length guard in too-many-columns exception paths (issue #26054)
# group: [csv]

# an over-value that is exactly the nullstr is NULL, so the row is still accepted
statement ok
COPY (SELECT 'val1' AS a, 'val2' AS b, 'ABCDEFGHIJKLMNOPQRSTU' AS extra FROM range(1, 3) t(i)) TO '{TEST_DIR}/26054_exact.csv' (HEADER false);

query II
FROM read_csv('{TEST_DIR}/26054_exact.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR'}, nullstr='ABCDEFGHIJKLMNOPQRSTU', strict_mode=true, auto_detect=false, header=false);
----
val1	val2
val1	val2

# an over-value that is only a prefix of the nullstr is not NULL
statement ok
COPY (SELECT 'val1' AS a, 'val2' AS b, 'ABC' AS extra FROM range(1, 2) t(i)) TO '{TEST_DIR}/26054_prefix.csv' (HEADER false);

statement error
FROM read_csv('{TEST_DIR}/26054_prefix.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR'}, nullstr='ABCDEFGHIJKLMNOPQRSTU', strict_mode=true, auto_detect=false, header=false);
----
Expected Number of Columns: 2 Found: 3

# an over-value longer than the nullstr sharing its prefix is not NULL; IsValueNull used to read past the sentinel buffer here
statement ok
COPY (SELECT 'val1' AS a, 'val2' AS b, 'ABCDEFGHIJKLMNOPQRSTUEXTRA' AS extra FROM range(1, 2) t(i)) TO '{TEST_DIR}/26054_longer.csv' (HEADER false);

statement error
FROM read_csv('{TEST_DIR}/26054_longer.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR'}, nullstr='ABCDEFGHIJKLMNOPQRSTU', strict_mode=true, auto_detect=false, header=false);
----
Expected Number of Columns: 2 Found: 3

# the length check applies per nullstr entry
statement ok
COPY (SELECT 'val1' AS a, 'val2' AS b, 'ZZZ' AS extra FROM range(1, 2) t(i)) TO '{TEST_DIR}/26054_list_exact.csv' (HEADER false);

query II
FROM read_csv('{TEST_DIR}/26054_list_exact.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR'}, nullstr=['ZZZ', 'ABCDEFGHIJKLMNOPQRSTU'], strict_mode=true, auto_detect=false, header=false);
----
val1	val2

statement ok
COPY (SELECT 'val1' AS a, 'val2' AS b, 'ZZ' AS extra FROM range(1, 2) t(i)) TO '{TEST_DIR}/26054_list_prefix.csv' (HEADER false);

statement error
FROM read_csv('{TEST_DIR}/26054_list_prefix.csv', columns={'a': 'VARCHAR', 'b': 'VARCHAR'}, nullstr=['ZZZ', 'ABCDEFGHIJKLMNOPQRSTU'], strict_mode=true, auto_detect=false, header=false);
----
Expected Number of Columns: 2 Found: 3
