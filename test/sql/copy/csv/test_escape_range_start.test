# name: test/sql/copy/csv/test_escape_range_start.test
# description: A scanner starting behind escapes reads its first bytes the way the scanner before it left them
# group: [csv]

statement ok
SET threads = 4

# an odd run of escapes, longer than any cached tail, escapes the pair a buffer end splits, the pair is data
statement ok
COPY (SELECT repeat('p' || chr(10), 2041) || 'abcd' || repeat('\', 4105) || chr(13) || chr(10) || 'x' || chr(10)
|| 'z') TO '{TEST_DIR}/escape_run_pair.csv' (HEADER false, QUOTE '', ESCAPE '')

query II
SELECT count(*), count(*) FILTER (WHERE a = 'x') FROM read_csv('{TEST_DIR}/escape_run_pair.csv',
columns = {'a': 'VARCHAR'}, header = false, auto_detect = false, quote = '', escape = '\', escape_mode = 'anywhere',
new_line = ['\n', '\r\n'], buffer_size = 8192, max_line_size = 8192)
----
2043	0

query II
SELECT count(*), count(*) FILTER (WHERE a = 'x') FROM read_csv('{TEST_DIR}/escape_run_pair.csv',
columns = {'a': 'VARCHAR'}, header = false, auto_detect = false, quote = '', escape = '\', escape_mode = 'anywhere',
new_line = ['\n', '\r\n'], buffer_size = 8192, max_line_size = 8192, parallel = false)
----
2043	0

