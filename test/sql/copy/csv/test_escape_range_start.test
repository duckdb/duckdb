(HEADER false, QUOTE '', ESCAPE '')

query I
SELECT string_agg(a, ',' ORDER BY a) FROM read_csv('{TEST_DIR}/escape_comment_start.csv', columns = {'a': 'VARCHAR'},
header = false, auto_detect = false, quote = '', escape = '\', escape_mode = 'anywhere', comment = '#', buffer_size = 8,
max_line_size = 8)
