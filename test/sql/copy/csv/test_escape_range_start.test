# a byte order mark before a quoted value is skipped when the end of the first buffer is read, as the scanner skips it
statement ok
COPY (SELECT encode(chr(65279) || '"aaaaaaaaaa#\' || chr(10) || 'x"')) TO '{TEST_DIR}/escape_bom_quoted.csv'
(FORMAT BLOB)

query II
SELECT count(*), count(*) FILTER (WHERE a = 'x"') FROM read_csv('{TEST_DIR}/escape_bom_quoted.csv',
