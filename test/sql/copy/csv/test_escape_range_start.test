# a quote inside a field that toggles the quote state right before a buffer end
statement ok
COPY (SELECT encode('pppppppppppp' || chr(10) || 'aa"' || chr(10) || 'x""' || chr(10) || 'z"' || chr(10) || 'y'
|| chr(10))) TO '{TEST_DIR}/escape_field_quote.csv' (FORMAT BLOB)

query II
