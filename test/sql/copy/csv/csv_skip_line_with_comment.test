# name: test/sql/copy/csv/csv_skip_line_with_comment.test
# description: A header or skipped line that ends in a comment is counted as a line, whatever stands before the comment
# group: [csv]

# the comment of the header follows a delimiter
# a;b;#x
# 1;2;
# 4;5;
statement ok
COPY (SELECT 'a;b;#x' || chr(10) || '1;2;' || chr(10) || '4;5;') TO '{TEST_DIR}/header_comment_after_delimiter.csv' (HEADER false, QUOTE '', DELIM '|');

query III
FROM read_csv('{TEST_DIR}/header_comment_after_delimiter.csv', delim = ';', comment = '#', header = true);
----
1	2	NULL
4	5	NULL

query III
FROM read_csv('{TEST_DIR}/header_comment_after_delimiter.csv', auto_detect = false, delim = ';', comment = '#', header = true, columns = {'a': 'BIGINT', 'b': 'BIGINT', 'c': 'VARCHAR'});
----
1	2	NULL
4	5	NULL

# the same line, skipped
query III
FROM read_csv('{TEST_DIR}/header_comment_after_delimiter.csv', auto_detect = false, delim = ';', comment = '#', header = false, skip = 1, columns = {'a': 'BIGINT', 'b': 'BIGINT', 'c': 'VARCHAR'});
----
1	2	NULL
4	5	NULL

# the comment of the header follows a quoted value
# "a";"b"#x
# 1;2
# 4;5
statement ok
COPY (SELECT '"a";"b"#x' || chr(10) || '1;2' || chr(10) || '4;5') TO '{TEST_DIR}/header_comment_after_quote.csv' (HEADER false, QUOTE '', DELIM '|');

query II
FROM read_csv('{TEST_DIR}/header_comment_after_quote.csv', auto_detect = false, delim = ';', quote = '"', comment = '#', header = true, columns = {'a': 'BIGINT', 'b': 'BIGINT'});
----
1	2
4	5

# a line that starts with the comment is not a line to skip
# #x
# a;b
# 1;2
# 4;5
statement ok
COPY (SELECT '#x' || chr(10) || 'a;b' || chr(10) || '1;2' || chr(10) || '4;5') TO '{TEST_DIR}/comment_line_before_header.csv' (HEADER false, QUOTE '', DELIM '|');

query II
FROM read_csv('{TEST_DIR}/comment_line_before_header.csv', auto_detect = false, delim = ';', comment = '#', header = true, columns = {'a': 'BIGINT', 'b': 'BIGINT'});
----
1	2
4	5

# the comment of the header follows a value and runs over the end of a buffer
# # comment
# a;b#12;#
# 1;3#5;7
# 6;7
loop buffer_size 11 40

query II
FROM read_csv('{DATA_DIR}/csv/comments/mid_line_header.csv', auto_detect = false, delim = ';', quote = '', escape = '', new_line = '\n', comment = '#', header = true, columns = {'a': 'BIGINT', 'b': 'BIGINT'}, max_line_size = 11, buffer_size = {buffer_size}, parallel = false);
----
1	3
6	7

endloop
