# name: test/sql/copy/csv/unquoted_escape/identical.test
# description: Ensure that the identical quote & escape case works as before and is not affected by the handling of unquoted escaped values.
# group: [unquoted_escape]

query TT
SELECT concat('#', columns(*), '#') FROM read_csv('{DATA_DIR}/csv/unquoted_escape/identical.csv', quote = '"', escape = '"', sep = ',', unquoted_escapes=true, new_line=['\n', '\r', '\r\n'], ignore_extra_columns=true, allow_unescaped_quotes=true, allow_unterminated_quotes=true);
----
##	#a""b#
#c""d#	##
#ef,"gh"#	##
##	#"ij",kl#
#mn"#	#op""#