# name: test/sql/copy/parquet/read_ahead/readahead_memory_limit.test
# description: In automatic mode the read-ahead backlog is bounded by the memory limit, so a copy that fits without read-ahead also fits with it
# group: [read_ahead]

require parquet

statement ok
COPY (SELECT md5(i::VARCHAR)::UUID::VARCHAR AS v, md5((-i)::VARCHAR)::UUID AS u FROM range(1000000) t(i)) TO '{TEST_DIR}/readahead_memory_limit.parquet'

statement ok
SET threads=16

statement ok
SET memory_limit='100MB'

statement ok
SET read_ahead_depth=0

statement ok
COPY '{TEST_DIR}/readahead_memory_limit.parquet' TO '{TEST_DIR}/readahead_memory_limit_off.parquet'

statement ok
SET read_ahead_depth=-1

statement ok
COPY '{TEST_DIR}/readahead_memory_limit.parquet' TO '{TEST_DIR}/readahead_memory_limit_auto.parquet'

statement ok
SET memory_limit='2GB'

query II
SELECT count(*), count(DISTINCT v) FROM '{TEST_DIR}/readahead_memory_limit_auto.parquet'
----
1000000	1000000

query I
SELECT count(*) FROM (
	SELECT * FROM '{TEST_DIR}/readahead_memory_limit.parquet'
	EXCEPT
	SELECT * FROM '{TEST_DIR}/readahead_memory_limit_auto.parquet'
)
----
0
