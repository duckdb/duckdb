# name: test/sql/copy/parquet/read_ahead/readahead_file_descriptor_limit_threads.test
# description: The file descriptor bound holds with many threads and with concurrent scans
# group: [read_ahead]

require parquet

require skip_reload

statement ok
SET async_threads=72

foreach suffix a b

statement ok
COPY (SELECT i % 64 AS p, i AS v FROM range(65536) t(i))
TO '{TEST_DIR}/readahead_fd_threads_{suffix}' (FORMAT parquet, PARTITION_BY (p))

endloop

statement ok
SET debug_file_descriptor_limit=64

statement ok
CREATE MACRO peak_open_handles() AS TABLE
WITH events AS (
	SELECT timestamp, CASE op WHEN 'OPEN' THEN 1 ELSE -1 END AS delta
	FROM duckdb_logs_parsed('FileSystem')
	WHERE op IN ('OPEN', 'CLOSE') AND path LIKE '%readahead_fd_threads%'
)
SELECT max(open_handles) AS peak
FROM (SELECT sum(delta) OVER (ORDER BY timestamp, delta DESC ROWS UNBOUNDED PRECEDING) AS open_handles FROM events)

# A single scan with many threads must respect the descriptor budget.
statement ok
SET threads=16

statement ok
CALL enable_logging('FileSystem')

query I
SELECT count(*) FROM read_parquet('{TEST_DIR}/readahead_fd_threads_a/**/*.parquet')
----
65536

statement ok
CALL disable_logging()

query I
SELECT peak < 32 FROM peak_open_handles()
----
true

statement ok
CALL truncate_duckdb_logs()

# Concurrent scans share the same process-wide budget.
statement ok
SET threads=8

statement ok
CALL enable_logging('FileSystem')

query I
SELECT count(*) FROM (
	SELECT v FROM read_parquet('{TEST_DIR}/readahead_fd_threads_a/**/*.parquet')
	UNION ALL
	SELECT v FROM read_parquet('{TEST_DIR}/readahead_fd_threads_b/**/*.parquet')
)
----
131072

statement ok
CALL disable_logging()

query I
SELECT peak < 32 FROM peak_open_handles()
----
true
