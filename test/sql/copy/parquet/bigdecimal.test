# name: test/sql/copy/parquet/bigdecimal.test
# description: Read a file created by Google BigQuery with a BIGDECIMAL column (i.e. DECIMAL(77,38))
# group: [parquet]

require parquet

# the column is read exactly as a wide decimal
query I
SELECT typeof(bigdec) FROM '{DATA_DIR}/parquet-testing/bigdecimal.parquet' LIMIT 1
----
DECIMAL(77,38)

query I
FROM '{DATA_DIR}/parquet-testing/bigdecimal.parquet'
----
0.50000000000000000000000000000000000000
-0.50000000000000000000000000000000000000
123456789123456789123456789.12345678912345678912345678900000000000
-123456789123456789123456789.12345678912345678912345678900000000000
578960446186580977117854925043439539266.34992332820282019728792003956564819967
-578960446186580977117854925043439539266.34992332820282019728792003956564819968

query I
SELECT bigdec::DOUBLE FROM '{DATA_DIR}/parquet-testing/bigdecimal.parquet'
----
0.5
-0.5
1.2345678912345679e+26
-1.2345678912345679e+26
5.7896044618658096e+38
-5.7896044618658096e+38
