# name: test/sql/copy/parquet/parquet_nan.test
# description: Read a parquet file with an invalid float value (infinity)
# group: [parquet]

require parquet

query TTT
select * from parquet_scan('{DATA_DIR}/parquet-testing/nan-float.parquet') order by 1
----
-1	foo	1
2.5	baz	1
inf	bar	0

foreach source parquet_scan('{DATA_DIR}/parquet-testing/arrow_nan.parquet') parquet_scan('{DATA_DIR}/parquet-testing/arrow_nan.parquet',can_have_nan=true)

query II
select * from {source} where f='nan';
----
nan	nan

query II
select * from {source} where f>10;
----
nan	nan

query II
select * from {source} where d='nan';
----
nan	nan

query II
select * from {source} where d>10;
----
nan	nan

query II
SELECT sum(isnan(f)::INT), sum(isnan(d)::INT)
FROM {source}
----
1	1

endloop
