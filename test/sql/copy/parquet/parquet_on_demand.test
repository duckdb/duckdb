# name: test/sql/copy/parquet/parquet_on_demand.test
# description: Parquet on-demand reads use caching or bounded buffering, including through the deprecated setting
# group: [parquet]

require parquet

require no_alternative_verify

statement ok
SET threads=1

statement ok
SET read_ahead_depth=0

statement ok
SET parquet_metadata_cache=false

# Small pages expose unbuffered reads; the file spans several demand buffers.
statement ok
CREATE TABLE demand_input AS SELECT hash(i) AS a FROM range(327680) t(i)

statement ok
COPY demand_input TO '{TEST_DIR}/demand.parquet'
(COMPRESSION UNCOMPRESSED, ROW_GROUP_SIZE 327680, DATA_PAGE_SIZE_LIMIT 4096)

statement ok
CALL enable_logging('FileSystem', storage='memory')

# Exercise global cache disable, file exclusion, and usable cache without redundant combinations.
foreach mode disabled excluded enabled

statement ok
SET enable_external_file_cache=('${mode}' != 'disabled')

statement ok
SET cache_local_files=('${mode}' = 'enabled')

statement ok
CALL truncate_duckdb_logs()

query I
SELECT sum(a) = (SELECT sum(a) FROM demand_input)
FROM read_parquet('{TEST_DIR}/demand.parquet', prefetch_strategy='on_demand')
----
true

# Both paths batch small reads; only uncached files use the 1,000,000-byte demand buffer.
query II
SELECT count(*) BETWEEN 1 AND 249 AND max(bytes) <= 1000000,
       bool_or(bytes = 1000000) = ('${mode}' != 'enabled')
FROM duckdb_logs_parsed('FileSystem')
WHERE path LIKE '%/demand.parquet' AND op = 'READ'
----
true	true

endloop

# The deprecated alias survives serialization and selects demand buffering instead of whole-group prefetch.
query I
SELECT count(*) FROM duckdb_settings(deprecated := true) WHERE name = 'disable_parquet_prefetching'
----
1

statement ok
SET disable_parquet_prefetching=true

statement ok
SET enable_external_file_cache=false

statement ok
SET debug_verify_serializer=true

statement ok
CALL truncate_duckdb_logs()

query I
SELECT sum(a) = (SELECT sum(a) FROM demand_input) FROM read_parquet('{TEST_DIR}/demand.parquet')
----
true

query I
SELECT bool_or(bytes = 1000000) AND max(bytes) <= 1000000 AND count(*) < 250
FROM duckdb_logs_parsed('FileSystem')
WHERE path LIKE '%/demand.parquet' AND op = 'READ'
----
true

statement ok
SET debug_verify_serializer=false

statement ok
RESET disable_parquet_prefetching

# A page larger than the demand buffer must still be read completely.
statement ok
COPY demand_input TO '{TEST_DIR}/demand_large_page.parquet'
(COMPRESSION UNCOMPRESSED, ROW_GROUP_SIZE 327680, DATA_PAGE_SIZE_LIMIT 4194304)

query I
SELECT sum(a) = (SELECT sum(a) FROM demand_input)
FROM read_parquet('{TEST_DIR}/demand_large_page.parquet', prefetch_strategy='on_demand')
----
true

# Preserve the malformed-offset workaround and exercise buffering a file smaller than the buffer.
query I
SELECT count(*) FROM (
    SELECT * FROM read_parquet('{DATA_DIR}/parquet-testing/incorrect_index_page_offsets.parquet',
                              prefetch_strategy='on_demand')
    EXCEPT ALL SELECT * FROM '{DATA_DIR}/parquet-testing/incorrect_index_page_offsets.parquet'
) differences
----
0
