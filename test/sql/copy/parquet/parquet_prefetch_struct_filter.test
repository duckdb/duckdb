# name: test/sql/copy/parquet/parquet_prefetch_struct_filter.test
# description: A filter on a struct field only counts the fields it reads towards the initial filter cost
# group: [parquet]

require parquet

require vector_size 2048

statement ok
SET threads=1

statement ok
SET read_ahead_depth=1

# s.login is cheap to read, s.url makes the whole struct expensive
# the only match is in the second row group, and the min/max of s.login does not prune the first one
statement ok
COPY (
    SELECT {'login': CASE WHEN i = 3000 THEN 'gharlan' WHEN i % 2 = 0 THEN 'aaa' ELSE 'zzz' END,
            'url': md5(i::VARCHAR) || md5((i + 1)::VARCHAR)} AS s,
        {'body': md5((i + 2)::VARCHAR) || md5((i + 3)::VARCHAR)} AS p,
        md5((i + 4)::VARCHAR) || md5((i + 5)::VARCHAR) || md5((i + 6)::VARCHAR) || md5((i + 7)::VARCHAR) AS payload
    FROM range(4096) t(i)
) TO '{TEST_DIR}/struct_filter.parquet'
    (ROW_GROUP_SIZE 2048, COMPRESSION 'uncompressed', WRITE_BLOOM_FILTER FALSE)

# the same data with login as a top-level column
statement ok
COPY (
    SELECT s.login AS login, {'url': s.url} AS s, p, payload FROM read_parquet('{TEST_DIR}/struct_filter.parquet')
) TO '{TEST_DIR}/flat_filter.parquet'
    (ROW_GROUP_SIZE 2048, COMPRESSION 'uncompressed', WRITE_BLOOM_FILTER FALSE)

query III
SELECT s.login, s.url = md5('3000') || md5('3001'), length(payload)
FROM read_parquet('{TEST_DIR}/struct_filter.parquet') WHERE s.login = 'gharlan'
----
gharlan	true	128

statement ok
CALL enable_logging('ParquetPrefetch')

statement ok
SELECT bit_xor(hash(login, s, p, payload)) FROM read_parquet('{TEST_DIR}/flat_filter.parquet') WHERE login = 'gharlan'

query ITT
SELECT row_group_id, fully_filtered, strategy FROM duckdb_logs_parsed('ParquetPrefetch')
WHERE file_path LIKE '%flat_filter.parquet' ORDER BY row_group_id
----
0	true	prefetch_filters
1	false	prefetch_filters

statement ok
CALL truncate_duckdb_logs()

# only s.login counts towards the filter cost, so the first row group is read filter first, like the flat column
# struct columns are fetched with the other columns after the filter, including p
statement ok
SELECT bit_xor(hash(s, p, payload)) FROM read_parquet('{TEST_DIR}/struct_filter.parquet') WHERE s.login = 'gharlan'

query ITTT
SELECT row_group_id, fully_filtered, strategy, prefetch_groups FROM duckdb_logs_parsed('ParquetPrefetch')
WHERE file_path LIKE '%struct_filter.parquet' ORDER BY row_group_id
----
0	true	prefetch_filters	[[s.login, s.url], [p.body, payload]]
1	false	prefetch_filters	[[s.login, s.url], [p.body, payload]]

statement ok
CALL truncate_duckdb_logs()

# s.url is expensive, so the first row group is still read whole
statement ok
SELECT bit_xor(hash(s, p, payload)) FROM read_parquet('{TEST_DIR}/struct_filter.parquet')
WHERE s.url NOT LIKE '%not-in-hex%'

query ITT
SELECT row_group_id, fully_filtered, strategy FROM duckdb_logs_parsed('ParquetPrefetch')
WHERE file_path LIKE '%struct_filter.parquet' ORDER BY row_group_id
----
0	false	whole_group
1	false	whole_group
