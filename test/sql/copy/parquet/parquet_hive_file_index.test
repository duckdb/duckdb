# name: test/sql/copy/parquet/parquet_hive_file_index.test
# description: file_index is the index of the file in the file list, also when filters prune files
# group: [parquet]

require parquet

statement ok
COPY (SELECT * FROM (VALUES (0, 10), (1, 20), (2, 30)) t(part, x)) TO '__TEST_DIR__/file_index_hive' (FORMAT PARQUET, PARTITION_BY (part));

statement ok
COPY (SELECT * FROM (VALUES (0, 10), (1, 20), (2, 30)) t(part, x)) TO '__TEST_DIR__/file_index_hive_csv' (FORMAT CSV, PARTITION_BY (part));

query III
SELECT file_index, part, x FROM read_parquet('__TEST_DIR__/file_index_hive/*/*.parquet', hive_partitioning = true) ORDER BY file_index
----
0	0	10
1	1	20
2	2	30

query III
SELECT file_index, part, x FROM read_parquet(['__TEST_DIR__/file_index_hive/part=0/*.parquet', '__TEST_DIR__/file_index_hive/part=1/*.parquet', '__TEST_DIR__/file_index_hive/part=2/*.parquet'], hive_partitioning = true) WHERE part = 1
----
1	1	20

query II
SELECT file_index, x FROM read_parquet('__TEST_DIR__/file_index_hive/*/*.parquet', hive_partitioning = true, filename = true) WHERE filename LIKE '%part=2%'
----
2	30

query II
SELECT file_index, x FROM read_parquet('__TEST_DIR__/file_index_hive/*/*.parquet', hive_partitioning = true) WHERE part = 1 AND file_index = 1
----
1	20

query II
SELECT file_index, x FROM read_parquet('__TEST_DIR__/file_index_hive/*/*.parquet', hive_partitioning = true) WHERE part >= 1 ORDER BY ALL
----
1	20
2	30

query II
SELECT file_index, x FROM read_parquet(['__TEST_DIR__/file_index_hive/part=0/*.parquet', '__TEST_DIR__/file_index_hive/part=1/*.parquet', '__TEST_DIR__/file_index_hive/part=2/*.parquet'], hive_partitioning = true, union_by_name = true) WHERE part = 2
----
2	30

query II
SELECT file_index, x FROM read_parquet(['__TEST_DIR__/file_index_hive/part=0/*.parquet', '__TEST_DIR__/file_index_hive/part=1/*.parquet', '__TEST_DIR__/file_index_hive/part=1/*.parquet'], hive_partitioning = true) WHERE part = 1 ORDER BY ALL
----
1	20
2	20

query II
SELECT file_index, x FROM read_csv(['__TEST_DIR__/file_index_hive_csv/part=0/*.csv', '__TEST_DIR__/file_index_hive_csv/part=1/*.csv', '__TEST_DIR__/file_index_hive_csv/part=2/*.csv'], hive_partitioning = true) WHERE part = 2
----
2	30

statement ok
PREPARE file_index_of_part AS SELECT file_index FROM read_parquet('__TEST_DIR__/file_index_hive/*/*.parquet', hive_partitioning = true) WHERE part = $1;

query I
EXECUTE file_index_of_part(2);
----
2

# files pruned by a join filter at run time, after a filter pruned files when binding
statement ok
SET disabled_optimizers = 'statistics_propagation,join_order,build_side_probe_side';

statement ok
CREATE TABLE selected AS SELECT 2 AS part;

query III
SELECT file_index, part, x FROM read_parquet('__TEST_DIR__/file_index_hive/*/*.parquet', hive_partitioning = true) JOIN selected USING (part) WHERE part >= 1
----
2	2	30
