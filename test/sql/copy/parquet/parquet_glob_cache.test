# name: test/sql/copy/parquet/parquet_glob_cache.test
# description: Test usage of metadata cache in multi-file scans
# group: [parquet]

require parquet

statement ok
SET parquet_metadata_cache=true;

# first read reads the parquet files
query II
EXPLAIN select count(*) from parquet_scan('{DATA_DIR}/parquet-testing/glob/*')
----
physical_plan	<REGEX>:.*PARQUET_SCAN.*

query I
select count(*) from parquet_scan('{DATA_DIR}/parquet-testing/glob/*')
----
2

# second read uses the metadata cache
query II
EXPLAIN select count(*) from parquet_scan('{DATA_DIR}/parquet-testing/glob/*')
----
physical_plan	<!REGEX>:.*PARQUET_SCAN.*

query I
select count(*) from parquet_scan('{DATA_DIR}/parquet-testing/glob/*')
----
2

# issue #22679: explicit file lists should retain the metadata needed to validate cached footers
statement ok
COPY (SELECT i AS x FROM range(100) t(i)) TO '{TEMP_DIR}/cache_list_1.parquet';

statement ok
COPY (SELECT i + 100 AS x FROM range(100) t(i)) TO '{TEMP_DIR}/cache_list_2.parquet';

# populate the metadata cache for both files
query I
SELECT count(*) FROM read_parquet(['{TEMP_DIR}/cache_list_1.parquet', '{TEMP_DIR}/cache_list_2.parquet']);
----
200

# min/max/count can be answered entirely from the validated cached metadata
query II
EXPLAIN ANALYZE SELECT min(x), max(x), count(*)
FROM read_parquet(['{TEMP_DIR}/cache_list_1.parquet', '{TEMP_DIR}/cache_list_2.parquet']);
----
analyzed_plan	<!REGEX>:.*READ_PARQUET.*

query III
SELECT min(x), max(x), count(*)
FROM read_parquet(['{TEMP_DIR}/cache_list_1.parquet', '{TEMP_DIR}/cache_list_2.parquet']);
----
0	199	200

# cached statistics must follow the per-file column mapping: columns are matched by name, not by position
statement ok
COPY (SELECT 1 AS x, 100 AS y) TO '{TEMP_DIR}/stats_order_a.parquet';

statement ok
COPY (SELECT 200 AS y, 2 AS x) TO '{TEMP_DIR}/stats_order_b.parquet';

query I
SELECT count(*) FROM read_parquet(['{TEMP_DIR}/stats_order_a.parquet', '{TEMP_DIR}/stats_order_b.parquet']);
----
2

query IIIII
SELECT min(x), max(x), min(y), max(y), count(*)
FROM read_parquet(['{TEMP_DIR}/stats_order_a.parquet', '{TEMP_DIR}/stats_order_b.parquet']);
----
1	2	100	200	2

# cached statistics must follow the cast to the scan type
statement ok
COPY (SELECT '10' AS x) TO '{TEMP_DIR}/stats_type_a.parquet';

statement ok
COPY (SELECT 9 AS x) TO '{TEMP_DIR}/stats_type_b.parquet';

query I
SELECT count(*) FROM read_parquet(['{TEMP_DIR}/stats_type_a.parquet', '{TEMP_DIR}/stats_type_b.parquet']);
----
2

query III
SELECT min(x), max(x), count(*)
FROM read_parquet(['{TEMP_DIR}/stats_type_a.parquet', '{TEMP_DIR}/stats_type_b.parquet']);
----
10	9	2

# files missing a column contribute NULLs, not the statistics of another column
statement ok
COPY (SELECT 300 AS y) TO '{TEMP_DIR}/stats_missing_c.parquet';

query I
SELECT count(*) FROM read_parquet(['{TEMP_DIR}/stats_order_a.parquet', '{TEMP_DIR}/stats_missing_c.parquet'], union_by_name=true);
----
2

query IIIII
SELECT min(x), max(x), min(y), max(y), count(*)
FROM read_parquet(['{TEMP_DIR}/stats_order_a.parquet', '{TEMP_DIR}/stats_missing_c.parquet'], union_by_name=true);
----
1	1	100	300	2
