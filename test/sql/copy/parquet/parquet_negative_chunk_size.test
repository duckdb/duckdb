# name: test/sql/copy/parquet/parquet_negative_chunk_size.test
# description: Parquet files with a negative column chunk size are rejected when the metadata is read
# group: [parquet]

require parquet

statement error
SELECT count(*), min(COLUMNS(*)), max(COLUMNS(*)) FROM read_parquet('data/parquet-testing/broken/neg_compressed_size.parquet');
----
column chunk has a negative offset or size

statement error
SELECT * FROM parquet_metadata('data/parquet-testing/broken/neg_compressed_size.parquet');
----
column chunk has a negative offset or size

# the database is still usable afterwards
query I
SELECT 42
----
42
