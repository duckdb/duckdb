# name: test/sql/copy/parquet/list_contains_row_group_pruning.test
# description: Parquet list_contains prunes row groups when the needle is outside child min/max
# group: [parquet]

require parquet

statement ok
COPY (SELECT [i] AS l FROM range(6144) t(i))
TO '{TEST_DIR}/list_contains_row_group_pruning.parquet' (FORMAT PARQUET, ROW_GROUP_SIZE 2048);

query II
EXPLAIN ANALYZE SELECT count(*) FROM '{TEST_DIR}/list_contains_row_group_pruning.parquet'
WHERE list_contains(l, 3000);
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

query I
SELECT count(*) FROM '{TEST_DIR}/list_contains_row_group_pruning.parquet' WHERE list_contains(l, 3000);
----
1

# Zero-padded so lexicographic min/max matches numeric order
statement ok
COPY (SELECT [lpad(i::VARCHAR, 4, '0')] AS l FROM range(6144) t(i))
TO '{TEST_DIR}/list_contains_string_row_group_pruning.parquet' (FORMAT PARQUET, ROW_GROUP_SIZE 2048);

query II
EXPLAIN ANALYZE SELECT count(*) FROM '{TEST_DIR}/list_contains_string_row_group_pruning.parquet'
WHERE list_contains(l, '3000');
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

query I
SELECT count(*) FROM '{TEST_DIR}/list_contains_string_row_group_pruning.parquet' WHERE list_contains(l, '3000');
----
1
