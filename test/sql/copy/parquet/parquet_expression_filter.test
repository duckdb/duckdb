# name: test/sql/copy/parquet/parquet_expression_filter.test
# description: Test expression filters on Parquet
# group: [parquet]

require parquet

statement ok
CREATE TABLE tbl AS
SELECT i, 'thisisalongstring'||(i%5000)::VARCHAR AS str
FROM range(100000) t(i);

statement ok
COPY tbl TO '{TEST_DIR}/parquet_expr.parquet'

statement ok
CREATE VIEW parq AS FROM '{TEST_DIR}/parquet_expr.parquet'

query I
SELECT COUNT(*) FROM parq
WHERE least(str, 'thisisalongstring50') = str
----
88940

query I
SELECT COUNT(*) FROM parq
WHERE least(str, 'thisisalongstring50') = str AND str >= 'this'
----
88940

query I
SELECT COUNT(*) FROM parq
WHERE least(str, 'thisisalongstring50') = str AND str >= 'thisisalongstring2000' AND str <= 'thisisalongstring4000'
----
44460

# Keep a dense selection when another filtered column uses decoded dictionaries.
query I
SELECT
    (SELECT count(*) FROM parq WHERE i >= 33333 AND least(str, 'thisisalongstring50') = str)
    =
    (SELECT count(*) FROM tbl WHERE i >= 33333 AND least(str, 'thisisalongstring50') = str)
----
true

query I
SELECT
    (SELECT sum(i) FROM parq WHERE i >= 33333 AND least(str, 'thisisalongstring50') = str)
    =
    (SELECT sum(i) FROM tbl WHERE i >= 33333 AND least(str, 'thisisalongstring50') = str)
----
true
