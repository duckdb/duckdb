# name: test/sql/copy/parquet/parquet_nan_default.test
# description: Default Parquet reads must account for NaNs excluded from finite statistics
# group: [parquet]

require parquet

# Generated by generate_nullable_nan in data/parquet-testing/pyarrow-generate-parquet.py
# using PyArrow 25.0.1: FLOAT and DOUBLE [1, NaN, NULL], min=max=1, null_count=1.
# A DuckDB-written fixture omits these extrema and would miss this regression.
query TTTI rowsort
SELECT path_in_schema, stats_min, stats_max, stats_null_count
FROM parquet_metadata('{DATA_DIR}/parquet-testing/arrow_nullable_nan.parquet')
----
d	1.0	1.0	1
f	1.0	1.0	1

# Serialised plans must retain the new runtime default despite the historical wire default.
foreach verify false true

statement ok
SET debug_verify_serializer={verify}

foreach source read_parquet('{DATA_DIR}/parquet-testing/arrow_nullable_nan.parquet') parquet_scan('{DATA_DIR}/parquet-testing/arrow_nullable_nan.parquet') '{DATA_DIR}/parquet-testing/arrow_nullable_nan.parquet'

foreach column f d

query R
SELECT {column} FROM {source} WHERE {column} = 1
----
1.0

query R
SELECT {column} FROM {source} WHERE {column} != 1
----
nan

query R
SELECT {column} FROM {source} WHERE {column} < 1
----

query R
SELECT {column} FROM {source} WHERE {column} <= 1
----
1.0

query R
SELECT {column} FROM {source} WHERE {column} > 1
----
nan

query R rowsort
SELECT {column} FROM {source} WHERE {column} >= 1
----
1.0
nan

query R
SELECT {column} FROM {source} WHERE {column} < 2
----
1.0

query R
SELECT {column} FROM {source} WHERE {column} = 'nan'
----
nan

query R
SELECT {column} FROM {source} WHERE isnan({column})
----
nan

query R
SELECT {column} FROM {source} WHERE {column} IS NULL
----
NULL

query R rowsort
SELECT {column} FROM {source} WHERE {column} IS NOT NULL
----
1.0
nan

endloop

endloop

endloop

statement ok
SET debug_verify_serializer=false

# Exercise the pushed row-group filter without file-level statistics propagation.
statement ok
SET disabled_optimizers='statistics_propagation'

foreach column f d

query R
SELECT {column} FROM '{DATA_DIR}/parquet-testing/arrow_nullable_nan.parquet' WHERE {column} != 1
----
nan

query R
SELECT {column} FROM '{DATA_DIR}/parquet-testing/arrow_nullable_nan.parquet' WHERE {column} > 1
----
nan

query R
SELECT {column} FROM '{DATA_DIR}/parquet-testing/arrow_nullable_nan.parquet' WHERE {column} <= 1
----
1.0

endloop

statement ok
SET disabled_optimizers=''
