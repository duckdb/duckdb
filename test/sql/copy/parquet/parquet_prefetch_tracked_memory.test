# name: test/sql/copy/parquet/parquet_prefetch_tracked_memory.test
# description: Parquet prefetch must materialize into buffer tracked memory
# group: [parquet]

require parquet

# this test calibrates exact memory-fit boundaries (the prefetch span must not fit, the synchronous
# reads must fit), alternative-verify builds shift both sides of that margin
require no_alternative_verify

# small data pages keep a single page's decode memory far below the prefetched span
statement ok
copy (select range i from range(16000000)) to '{TEST_DIR}/prefetch_tracked_big.parquet' (ROW_GROUP_SIZE 16000000, data_page_size_limit 1048576);

# prefetch pins the full ~64MB row group span on top of the decode memory, so it OOMs where sync reads fit
statement ok
set memory_limit='32mb';

statement error
select count(*), sum(i) from '{TEST_DIR}/prefetch_tracked_big.parquet';
----
Out of Memory

# disabling prefetching reads the file in small synchronous chunks, which fits in the memory limit
statement ok
set disable_parquet_prefetching=true;

query II
select count(*), sum(i) from '{TEST_DIR}/prefetch_tracked_big.parquet';
----
16000000	127999992000000
