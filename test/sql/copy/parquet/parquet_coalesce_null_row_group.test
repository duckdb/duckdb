# name: test/sql/copy/parquet/parquet_coalesce_null_row_group.test
# description: A row group in which the first COALESCE argument is all NULL is pruned on the remaining arguments
# group: [parquet]

require parquet

# the row group boundaries below assume the default vector size
require vector_size 2048

statement ok
SET threads = 1;

# row group 0 holds 0 - 2047 without NULLs, row group 1 only NULLs: it has no min/max
statement ok
COPY (SELECT CASE WHEN i < 2048 THEN i END AS n FROM range(4096) t(i)) TO '{TEST_DIR}/coalesce_null_row_group.parquet' (ROW_GROUP_SIZE 2048);

# coalesce(n, -1) is -1 in row group 1
query II
EXPLAIN ANALYZE SELECT count(*) FROM '{TEST_DIR}/coalesce_null_row_group.parquet' WHERE coalesce(n, -1) = 5000;
----
analyzed_plan	<REGEX>:(?s).*Row Groups Scanned: 0 / 2.*

query I
SELECT count(*) FROM '{TEST_DIR}/coalesce_null_row_group.parquet' WHERE coalesce(n, -1) = 5000;
----
0

query II
EXPLAIN ANALYZE SELECT count(*) FROM '{TEST_DIR}/coalesce_null_row_group.parquet' WHERE coalesce(n, -1) = -1;
----
analyzed_plan	<REGEX>:(?s).*Row Groups Scanned: 1 / 2.*

query I
SELECT count(*) FROM '{TEST_DIR}/coalesce_null_row_group.parquet' WHERE coalesce(n, -1) = -1;
----
2048

query I
SELECT count(*) FROM '{TEST_DIR}/coalesce_null_row_group.parquet' WHERE coalesce(n, -1) BETWEEN 1000 AND 1999;
----
1000
