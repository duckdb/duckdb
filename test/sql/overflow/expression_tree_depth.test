 + x FROM integers
----
Parser Error: Max expression depth limit of 250 exceeded.

# Deeply nested expressions must not overflow the C stack. They are rejected at the parser/binder
# interface (Parser::ParseTopLevelStatement) before any recursive binder pass walks them, so every
# clause raises the depth limit instead of crashing. Each nests far past the point where a recursive
# walk would overflow. Using query() keeps the literal out of this file.
statement ok
CREATE TABLE deep_t(x INTEGER)

statement ok
SET max_expression_depth=1000

# select list
statement error
FROM query('SELECT ' || repeat('abs(', 20000) || '1' || repeat(')', 20000))
----
<REGEX>:.*Max expression depth limit of 1000 exceeded.*

# a STAR nested deep inside an expression
statement error
FROM query('SELECT ' || repeat('abs(', 20000) || 'COLUMNS(*)' || repeat(')', 20000) || ' FROM deep_t')
----
<REGEX>:.*Max expression depth limit of 1000 exceeded.*

# WHERE
statement error
FROM query('SELECT 1 FROM deep_t WHERE ' || repeat('abs(', 20000) || '1' || repeat(')', 20000) || ' > 0')
----
<REGEX>:.*Max expression depth limit of 1000 exceeded.*

# GROUP BY
statement error
FROM query('SELECT 1 FROM deep_t GROUP BY ' || repeat('abs(', 20000) || '1' || repeat(')', 20000))
----
<REGEX>:.*Max expression depth limit of 1000 exceeded.*

# HAVING
statement error
FROM query('SELECT 1 FROM deep_t GROUP BY x HAVING ' || repeat('abs(', 20000) || '1' || repeat(')', 20000) || ' > 0')
----
<REGEX>:.*Max expression depth limit of 1000 exceeded.*

# QUALIFY
statement error
FROM query('SELECT 1 FROM deep_t QUALIFY ' || repeat('abs(', 20000) || '1' || repeat(')', 20000) || ' > 0')
----
<REGEX>:.*Max expression depth limit of 1000 exceeded.*

# ORDER BY
statement error
FROM query('SELECT 1 FROM deep_t ORDER BY ' || repeat('abs(', 20000) || '1' || repeat(')', 20000))
----
<REGEX>:.*Max expression depth limit of 1000 exceeded.*

# nested list form, GROUP BY [[[ ... ]]]
statement error
FROM query('SELECT 1 FROM deep_t GROUP BY ' || repeat('[', 20000) || '1' || repeat(']', 20000))
----
<REGEX>:.*Max expression depth limit of 1000 exceeded.*
