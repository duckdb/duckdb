# name: test/sql/parser/test_columns_lists.test
# description: Test the columns expression with list comprehension
# group: [parser]

statement ok
CREATE TABLE integers AS SELECT 42 i, 84 j UNION ALL SELECT 13, 14

query II
SELECT COLUMNS([x for x in *]) FROM integers
----
42	84
13	14

query I
SELECT COLUMNS([x for x in (*) if x <> 'i']) FROM integers
----
84
14

# short-hand, allow directly specifying the lambda
query I
SELECT COLUMNS(lambda x: x <> 'i') FROM integers
----
84
14

query I
SELECT COLUMNS([x for x in (*) if x SIMILAR TO 'i']) FROM integers
----
42
13

query I
SELECT COLUMNS(['i', 'i']) FROM integers
----
42
13

query I
SELECT COLUMNS(list_concat(['i'], ['i'])) FROM integers
----
42
13

# star with exclude
query I
SELECT COLUMNS([x for x in (* EXCLUDE (i))]) FROM integers
----
84
14

# multiple columns that are the same works
query I
SELECT COLUMNS(['i']) + COLUMNS(['i']) FROM integers
----
84
26

# columns must be returned as strings
statement error
SELECT COLUMNS([i, j]) FROM integers
----
COLUMNS expression can only contain lambda parameters

# nested columns
statement error
SELECT COLUMNS([x for x in COLUMNS(*)]) FROM integers
----
COLUMNS expression is not allowed inside another COLUMNS expression

statement error
SELECT COLUMNS(COLUMNS(*)) FROM integers
----
COLUMNS expression is not allowed inside another COLUMNS expression

statement error
SELECT * + 42 FROM integers
----
cannot be applied to a star expression

# empty lambda
statement error
SELECT COLUMNS([x for x in (*) if x = 'k']) FROM integers
----
resulted in an empty set of columns

# columns that are not found
statement error
SELECT COLUMNS(['k']) FROM integers
----
not found in the FROM clause

# COLUMNS and joins
query I rowsort
SELECT COLUMNS([x for x in (*) if x LIKE 'i']) FROM integers i1 JOIN integers i2 USING (i)
----
13
42

query II rowsort
SELECT COLUMNS([x for x in (*) if x LIKE 'i']) FROM integers i1 JOIN integers i2 ON (i1.i=i2.i)
----
13	13
42	42

# wrong parameter type
statement error
SELECT COLUMNS([43]) FROM integers
----
VARCHAR argument

statement error
SELECT COLUMNS([NULL]) FROM integers
----
VARCHAR argument

statement error
SELECT COLUMNS([]::VARCHAR[]) FROM integers
----
empty set of columns

statement error
SELECT COLUMNS(NULL::VARCHAR[]) FROM integers
----
empty set of columns

statement error
SELECT COLUMNS(NULL::VARCHAR) FROM integers
----
does not support NULL

# different columns
statement error
SELECT COLUMNS(['i']) + COLUMNS(['j']) FROM integers
----
Multiple different STAR/COLUMNS in the same expression are not supported

# star with replace
statement error
SELECT COLUMNS([x for x in (* REPLACE (i AS i))]) FROM integers
----
only allowed as the root element

# Qualified stars retain their relation when used as lists of column names.
query I
SELECT COLUMNS([x FOR x IN c.* IF x LIKE 'b'])
FROM (SELECT 0 a, 1 b) c CROSS JOIN (SELECT 2 b) d
----
1

query I
SELECT COLUMNS([x FOR x IN c.* IF x LIKE 'b'])
FROM (SELECT 2 b) d CROSS JOIN (SELECT 0 a, 1 b) c
----
1

# Separate COLUMNS expressions may select from different relations.
query II
SELECT current_b, previous_b FROM (
    SELECT COLUMNS([x FOR x IN c.* IF x LIKE 'b']) AS 'current_\0',
           COLUMNS([x FOR x IN d.* IF x LIKE 'b']) AS 'previous_\0'
    FROM (SELECT 0 a, 1 b) c CROSS JOIN (SELECT 2 b) d
)
----
1	2

# Repeated stars from the same relation compare identifiers case-insensitively.
query I
SELECT COLUMNS([x FOR x IN "C table".* IF x LIKE 'b'] || [x FOR x IN "c TABLE".* IF x LIKE 'b'])
FROM (SELECT 0 a, 1 b) "C table" CROSS JOIN (SELECT 2 b) d
----
1

# Unqualified stars and literal lists still select matching names from all relations.
query II
SELECT COLUMNS([x FOR x IN * IF x LIKE 'b'] || [x FOR x IN * IF x LIKE 'b'])
FROM (SELECT 1 b) c CROSS JOIN (SELECT 2 b) d
----
1	2

query II
SELECT COLUMNS(['b']) FROM (SELECT 1 b) c CROSS JOIN (SELECT 2 b) d
----
1	2

# Different scopes within one COLUMNS expression are rejected in either order.
statement error
SELECT COLUMNS([x FOR x IN c.*] || [x FOR x IN d.*])
FROM (SELECT 1 b) c CROSS JOIN (SELECT 2 b) d
----
COLUMNS cannot combine stars from different relations

statement error
SELECT COLUMNS([x FOR x IN d.*] || [x FOR x IN c.*])
FROM (SELECT 1 b) c CROSS JOIN (SELECT 2 b) d
----
COLUMNS cannot combine stars from different relations

statement error
SELECT COLUMNS([x FOR x IN c.*] || [x FOR x IN *])
FROM (SELECT 1 b) c CROSS JOIN (SELECT 2 b) d
----
COLUMNS cannot mix qualified and unqualified stars

statement error
SELECT COLUMNS([x FOR x IN *] || [x FOR x IN c.*])
FROM (SELECT 1 b) c CROSS JOIN (SELECT 2 b) d
----
COLUMNS cannot mix qualified and unqualified stars

# All resulting names resolve within the selected relation, including literal names.
query II
SELECT COLUMNS([x FOR x IN (c.* EXCLUDE (b))] || ['b'])
FROM (SELECT 0 a, 1 b) c CROSS JOIN (SELECT 2 b) d
----
0	1

query I
SELECT COLUMNS([replace(x, 'b', 'z') FOR x IN c.*])
FROM (SELECT 1 b, 4 z) c CROSS JOIN (SELECT 3 z) d
----
4

statement error
SELECT COLUMNS([x FOR x IN c.*] || ['z'])
FROM (SELECT 1 b) c CROSS JOIN (SELECT 2 z) d
----
Column "z" was selected but was not found

statement error
SELECT COLUMNS([x FOR x IN c.* IF x LIKE 'z'])
FROM (SELECT 1 b) c CROSS JOIN (SELECT 2 z) d
----
resulted in an empty set of columns

# Struct fields must not select unrelated top-level columns with the same name.
query I
SELECT COLUMNS([x FOR x IN s.* IF x LIKE 'b'])
FROM (SELECT {'a': 0, 'b': 1} s, 2 b) t
----
1

# A qualified USING column retains the value from its own side of an outer join.
query I rowsort
SELECT COLUMNS([x FOR x IN c.* IF x LIKE 'b'])
FROM (SELECT 1 b) c FULL JOIN (SELECT 2 b) d USING (b)
----
1
NULL

# WHERE must not test the nullability of another relation's columns.
query II
SELECT c.b, d.b
FROM (SELECT 1 b) c CROSS JOIN (SELECT NULL::INTEGER b) d
WHERE COLUMNS([x FOR x IN c.* IF x LIKE 'b']) IS NOT NULL
----
1	NULL

# Unpacking must not introduce arguments from another relation.
query I
SELECT coalesce(*COLUMNS([x FOR x IN c.* IF x LIKE 'b']))
FROM (SELECT NULL::INTEGER b) c CROSS JOIN (SELECT 2 b) d
----
NULL
