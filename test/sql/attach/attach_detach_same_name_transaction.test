statement ok
BEGIN

statement ok
ATTACH ':memory:' AS a

statement ok
DETACH a

statement ok
ATTACH ':memory:' AS a

statement ok
CREATE TABLE a.tbl AS SELECT 2 AS i

query I
SELECT * FROM a.tbl
----
2

statement ok
COMMIT

query I
SELECT * FROM a.tbl
----
