# name: test/sql/attach/attach_detach_same_name_transaction.test
# description: Attach a database under the name of a database detached in the same transaction
# group: [attach]

statement ok
BEGIN

statement ok
ATTACH ':memory:' AS a

statement ok
DETACH a

statement ok
ATTACH ':memory:' AS a

statement ok
CREATE TABLE a.tbl AS SELECT 2 AS i

query I
SELECT * FROM a.tbl
----
2

statement ok
COMMIT

query I
SELECT * FROM a.tbl
----
2

# a database the transaction has done work on (changes or reads) cannot be detached, so its name is never freed
statement ok
BEGIN

statement ok
ATTACH '{TEST_DIR}/detach_same_name_modified.db' AS b

statement ok
CREATE TABLE b.tbl AS SELECT 1 AS i

statement error
DETACH b
----
outstanding work

statement ok
ROLLBACK

statement ok
BEGIN

statement ok
ATTACH '{TEST_DIR}/detach_same_name_read.db' AS c

statement ok
CREATE TABLE c.tbl AS SELECT 1 AS i

statement ok
COMMIT

statement ok
BEGIN

query I
SELECT * FROM c.tbl
----
1

statement error
DETACH c
----
outstanding work

statement ok
ROLLBACK
