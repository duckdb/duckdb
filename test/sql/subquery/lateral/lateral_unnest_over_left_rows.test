6	2

# the same without the filter pushdown and when the optimizer run is skipped: a filter on the left columns above the
# join would then stay above the UNNEST and no longer guard the list
statement ok
SET enable_optimizer = true;

statement ok
SET disabled_optimizers = 'filter_pushdown';

