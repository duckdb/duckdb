logical_opt	<!REGEX>:(?s).*(CTE Name|Join Type).*

# The shapes that keep the general decorrelation

# 17 WITH ORDINALITY
query II
EXPLAIN SELECT id, u.v, u.o FROM t CROSS JOIN UNNEST([a, b, c]) WITH ORDINALITY AS u(v, o);
----
logical_opt	<REGEX>:(?s).*CTE Name.*Join Type: INNER.*

# 18 LEFT JOIN LATERAL
query II
EXPLAIN SELECT id, u.v FROM t LEFT JOIN UNNEST(list_reverse(l)) AS u(v) ON true;
----
logical_opt	<REGEX>:(?s).*CTE Name.*Join Type.*

query II
EXPLAIN SELECT id, v FROM t LEFT JOIN LATERAL (SELECT unnest([a, b, c]) AS v) ON true;
----
logical_opt	<REGEX>:(?s).*CTE Name.*Join Type.*

# 20 a lateral aggregate
query II
EXPLAIN SELECT id, s FROM t, LATERAL (SELECT sum(v) AS s FROM UNNEST([a, b, c]) AS u(v));
----
logical_opt	<REGEX>:(?s).*CTE Name.*Join Type.*

# 25 a volatile expression
query II
EXPLAIN SELECT id, v FROM t, UNNEST([a, (random() * 0)::INTEGER]) AS u(v);
----
logical_opt	<REGEX>:(?s).*CTE Name.*Join Type: INNER.*

# 28 a list computed with a subquery, and a list that reads a column of an enclosing query
query II
EXPLAIN SELECT id, v FROM t, UNNEST((SELECT list(n.v ORDER BY n.v) FROM names n WHERE n.v <= t.a)) AS u(v);
----
logical_opt	<REGEX>:(?s).*CTE Name.*Join Type: INNER.*

query II
EXPLAIN SELECT id, (SELECT sum(v + q.k) FROM (SELECT 100 AS k) q, UNNEST([q.k, t.a]) AS u(v)) FROM t;
----
logical_opt	<REGEX>:(?s).*CTE Name.*Join Type.*

# 30 a lateral subquery with a projection and an expression that can raise an error: a filter on the left columns
# above the join guards that expression
query II
EXPLAIN SELECT id, k FROM t, LATERAL (SELECT k * 2 AS k FROM (SELECT v + a AS k FROM (SELECT unnest([b, c]) AS v) WHERE v > 5) WHERE k < 45);
----
logical_opt	<REGEX>:(?s).*CTE Name.*Join Type: INNER.*

query II
EXPLAIN SELECT id, v FROM guarded, LATERAL (SELECT unnest(CAST(s AS INTEGER[])) AS v) WHERE s LIKE '[%' AND CAST(CAST(v AS VARCHAR) AS INTEGER) > 1;
----
logical_opt	<REGEX>:(?s).*CTE Name.*Join Type: INNER.*

# 31 a lateral limit
query II
EXPLAIN SELECT id, v FROM t, LATERAL (SELECT * FROM UNNEST([a, b, c]) AS u(v) ORDER BY v DESC LIMIT 1);
----
logical_opt	<REGEX>:(?s).*CTE Name.*Join Type.*

# with the unnest rewriter disabled the lateral join is decorrelated the general way
statement ok
SET disabled_optimizers = 'unnest_rewriter';

query II
EXPLAIN SELECT id, u.v FROM t CROSS JOIN UNNEST([a, b, c]) AS u(v);
----
logical_opt	<REGEX>:(?s).*CTE Name.*Join Type: INNER.*

query II
EXPLAIN SELECT id, v FROM t, LATERAL (SELECT unnest([a, b, c]) AS v);
----
logical_opt	<REGEX>:(?s).*CTE Name.*Join Type: INNER.*

query II
SELECT id, u.v FROM t CROSS JOIN UNNEST([a, b]) AS u(v) WHERE id > 4 ORDER BY ALL
----
5	7
5	7
6	1
6	2

statement ok
SET disabled_optimizers = '';

# and so it is with the optimizer disabled
statement ok
SET enable_optimizer = false;

statement ok
SET explain_output = 'physical_only';

query II
EXPLAIN SELECT id, u.v FROM t CROSS JOIN UNNEST([a, b, c]) AS u(v);
