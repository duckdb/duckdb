# name: test/sql/subquery/lateral/asof_join_lateral.test
# description: ASOF and POSITIONAL joins with a LATERAL (correlated) right side
# group: [lateral]

statement ok
CREATE TABLE t(id INT, v INT);

statement ok
INSERT INTO t VALUES (1, 11), (2, 22), (3, 33);

statement ok
CREATE TABLE u(id INT, v INT);

statement ok
INSERT INTO u VALUES (1, 10), (1, 11), (1, 12), (2, 20), (2, 21);

# the reproducer from the issue: only the closest match per left row
query IIII
SELECT * FROM (VALUES (1, 11)) t(id, v)
ASOF JOIN LATERAL (SELECT * FROM (VALUES (1, 10), (1, 11)) u(id, v) WHERE u.id <= t.id) s
ON t.id = s.id AND t.v >= s.v;
----
1	11	1	11

# an ASOF JOIN with a correlated right side keeps the ASOF match
foreach threshold 0 32

statement ok
SET asof_loop_join_threshold = {threshold};

query IIII
SELECT * FROM t ASOF JOIN LATERAL (SELECT * FROM u WHERE u.id <= t.id) s
ON t.id = s.id AND t.v >= s.v ORDER BY ALL;
----
1	11	1	11
2	22	2	21

# the same query without a correlation yields the same result
query IIII
SELECT * FROM t ASOF JOIN (SELECT * FROM u) s
ON t.id = s.id AND t.v >= s.v ORDER BY ALL;
----
1	11	1	11
2	22	2	21

# with a LIMIT in the correlated input
query IIII
SELECT t.id, t.v, s.id, s.v FROM t
ASOF JOIN LATERAL (SELECT * FROM u WHERE u.id = t.id ORDER BY v ASC LIMIT 1) s
ON t.id = s.id AND t.v >= s.v ORDER BY ALL;
----
1	11	1	10
2	22	2	20

endloop

statement ok
RESET asof_loop_join_threshold;

# ASOF LEFT keeps unmatched left rows
query IIII
SELECT * FROM t ASOF LEFT JOIN LATERAL (SELECT * FROM u WHERE u.id <= t.id) s
ON t.id = s.id AND t.v >= s.v ORDER BY ALL;
----
1	11	1	11
2	22	2	21
3	33	NULL	NULL

# ASOF LEFT with an empty correlated candidate set
query IIII
SELECT * FROM t ASOF LEFT JOIN LATERAL (SELECT * FROM u WHERE u.id < t.id AND u.v < 0) s
ON t.id = s.id AND t.v >= s.v ORDER BY ALL;
----
1	11	NULL	NULL
2	22	NULL	NULL
3	33	NULL	NULL

# a correlation on an equality filter keeps the ASOF match
query IIII
SELECT t.id, t.v, s.id, s.v FROM t
ASOF JOIN LATERAL (SELECT * FROM u WHERE u.id = t.id) s
ON t.id = s.id AND t.v >= s.v ORDER BY ALL;
----
1	11	1	11
2	22	2	21

# a correlation on an inequality filter is not the ASOF inequality
query IIII
SELECT t.id, t.v, s.id, s.v FROM t
ASOF JOIN LATERAL (SELECT * FROM u WHERE u.id >= t.id) s
ON t.id = s.id AND t.v >= s.v ORDER BY ALL;
----
1	11	1	11
2	22	2	21

# duplicate left rows keep their multiplicity
query IIII
SELECT * FROM (SELECT * FROM t UNION ALL SELECT * FROM t) t
ASOF JOIN LATERAL (SELECT * FROM u WHERE u.id <= t.id) s
ON t.id = s.id AND t.v >= s.v ORDER BY ALL;
----
1	11	1	11
1	11	1	11
2	22	2	21
2	22	2	21

# NULL correlation keys do not match
statement ok
CREATE TABLE tn(id INT, v INT);

statement ok
INSERT INTO tn VALUES (NULL, 5), (2, 22);

query IIII
SELECT * FROM tn ASOF LEFT JOIN LATERAL (SELECT * FROM u WHERE u.id <= tn.id) s
ON tn.id = s.id AND tn.v >= s.v ORDER BY ALL;
----
2	22	2	21
NULL	5	NULL	NULL

# the Deliminator cannot preserve ASOF matching, so ASOF laterals always use the CTE path
statement ok
SET delim_join_as_cte=false;

query IIII
SELECT * FROM t ASOF LEFT JOIN LATERAL (SELECT * FROM u WHERE u.id <= t.id) s
ON t.id = s.id AND t.v >= s.v ORDER BY ALL;
----
1	11	1	11
2	22	2	21
3	33	NULL	NULL

statement ok
RESET delim_join_as_cte;

# nested inside a correlated subquery
query II
SELECT o.k, q.n FROM (VALUES (1), (3)) o(k), LATERAL (
    SELECT count(*) AS n
    FROM u
    ASOF JOIN LATERAL (SELECT * FROM u u2 WHERE u2.id <= u.id) s ON u.id = s.id AND u.v >= s.v
    WHERE u.id <= o.k
) q ORDER BY ALL;
----
1	3
3	5

# invalid ASOF conditions are still reported at bind time
statement error
SELECT * FROM t ASOF JOIN LATERAL (SELECT * FROM u WHERE u.id <= t.id) s ON t.id = s.id;
----
Binder Error: Missing ASOF JOIN inequality

statement error
SELECT * FROM t ASOF JOIN LATERAL (SELECT * FROM u WHERE u.id <= t.id) s
ON t.id = s.id AND t.v >= s.v AND t.id >= s.id;
----
Binder Error: Multiple ASOF JOIN inequalities

# a POSITIONAL join cannot be correlated, as its row pairing would be undefined
statement error
SELECT * FROM t POSITIONAL JOIN LATERAL (SELECT * FROM u WHERE u.id <= t.id) s;
----
Binder Error: POSITIONAL JOIN with a LATERAL reference is not supported
