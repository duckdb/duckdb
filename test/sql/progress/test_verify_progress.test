# name: test/sql/progress/test_verify_progress.test
# description: Test the debug_verify_progress setting
# group: [progress]

statement ok
SET threads=1

statement error
SET debug_verify_progress='unknown'
----
<REGEX>:.*unrecognized value "unknown" for enum "DebugProgressVerification".*

statement ok
CREATE TABLE integers AS SELECT i FROM range(500000) t(i)

statement ok
SET debug_verify_progress='error'

statement ok
SET debug_verify_progress_ignore=''

# a sequential scan feeding an ungrouped aggregate reports correct progress
query I
SELECT sum(i) FROM integers
----
124999750000

# range and generate_series report progress
query I
SELECT sum(i) FROM range(500000) t(i)
----
124999750000

query I
SELECT count(*) FROM generate_series(TIMESTAMP '2000-01-01', TIMESTAMP '2001-01-01', INTERVAL 1 MINUTE)
----
527041

# recursive CTEs do not report progress - this fails the query in error mode
statement error
WITH RECURSIVE t(i) AS (SELECT * FROM range(100000) UNION ALL SELECT i + 100000 FROM t WHERE i < 400000) SELECT sum(i) FROM t
----
<REGEX>:Invalid Input Error: Progress verification failed:.*UNSUPPORTED_SOURCE \[REC_CTE\] in pipeline REC_CTE -> UNGROUPED_AGGREGATE.*debug_verify_progress_ignore='UNSUPPORTED_SOURCE:REC_CTE'.*

# violations can be ignored per invariant and operator, per operator, or per invariant
foreach ignore UNSUPPORTED_SOURCE:REC_CTE unsupported_source:rec_cte *:REC_CTE UNSUPPORTED_SOURCE STALLED,UNSUPPORTED_SOURCE:REC_CTE

statement ok
SET debug_verify_progress_ignore='{ignore}'

query I
WITH RECURSIVE t(i) AS (SELECT * FROM range(100000) UNION ALL SELECT i + 100000 FROM t WHERE i < 400000) SELECT sum(i) FROM t
----
124999750000

endloop

# other invariants or operators are not ignored
foreach ignore UNSUPPORTED_SINK:REC_CTE UNSUPPORTED_SOURCE:SEQ_SCAN STALLED

statement ok
SET debug_verify_progress_ignore='{ignore}'

statement error
WITH RECURSIVE t(i) AS (SELECT * FROM range(100000) UNION ALL SELECT i + 100000 FROM t WHERE i < 400000) SELECT sum(i) FROM t
----
<REGEX>:.*UNSUPPORTED_SOURCE \[REC_CTE\].*

endloop

statement ok
SET debug_verify_progress_ignore=''

# small pipelines are not checked
query I
SELECT sum(i) FROM range(1000) t(i)
----
499500

# pipelines that stop early (e.g. because of a LIMIT) are not required to complete
query I
SELECT max(i) FROM (SELECT i FROM integers WHERE i % 2 = 0 LIMIT 5000)
----
9998

# in log mode, violations are logged instead of failing the query
statement ok
SET debug_verify_progress='log'

statement ok
CALL enable_logging('ProgressVerification')

query I
WITH RECURSIVE t(i) AS (SELECT * FROM range(100000) UNION ALL SELECT i + 100000 FROM t WHERE i < 400000) SELECT sum(i) FROM t
----
124999750000

query III
SELECT invariant, operator, pipeline FROM duckdb_logs_parsed('ProgressVerification')
----
UNSUPPORTED_SOURCE	REC_CTE	REC_CTE -> UNGROUPED_AGGREGATE

statement ok
SET debug_verify_progress='none'

statement ok
CALL truncate_duckdb_logs()

query I
WITH RECURSIVE t(i) AS (SELECT * FROM range(100000) UNION ALL SELECT i + 100000 FROM t WHERE i < 400000) SELECT sum(i) FROM t
----
124999750000

query I
SELECT count(*) FROM duckdb_logs_parsed('ProgressVerification')
----
0
