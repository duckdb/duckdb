# name: test/sql/aggregate/aggregates/sum_no_overflow_fallible.test
# description: sum_no_overflow bound by name has no statistics proof for its int64 accumulator
# group: [aggregates]

# Name binding delegates to the regular sum and swaps in the checked no-overflow implementation, so the
# EXPLAIN (SQL) export renders the checked HUGEINT sum, which no longer raises. These raising
# fixtures are excluded from the explain_sql verification config for that reason.

statement ok
CREATE TABLE big AS SELECT 999999999999999999::DECIMAL(18,0) AS d, 9223372036854775807 - i AS b, 999999999::DECIMAL(9,0) AS d9, i % 10 AS g FROM range(100) t(i);

loop serializer 0 2

statement ok
SET debug_verify_serializer = {serializer};

statement error
SELECT sum_no_overflow(9223372036854775807::BIGINT) FROM range(2);
----
Overflow in sum_no_overflow

statement error
SELECT sum_no_overflow(b) FROM big;
----
Overflow in sum_no_overflow

# an INT64-backed DECIMAL raises instead of wrapping
statement error
SELECT sum_no_overflow(d) FROM big;
----
Overflow in sum_no_overflow

statement error
SELECT sum_no_overflow(d) FROM big GROUP BY g;
----
Overflow in sum_no_overflow

# combining states raises as well
statement error
SELECT finalize(combine_aggr(s)) FROM (SELECT sum_no_overflow(d) EXPORT_STATE AS s FROM big WHERE b > 9223372036854775797 GROUP BY g);
----
Overflow in sum_no_overflow

query I
SELECT finalize(combine_aggr(s)) FROM (SELECT sum_no_overflow(d) EXPORT_STATE AS s FROM big WHERE b > 9223372036854775797 GROUP BY g HAVING g < 5);
----
4999999999999999995

# sums that fit are exact
query II
SELECT sum_no_overflow(d), typeof(sum_no_overflow(d)) FROM big WHERE b > 9223372036854775798;
----
8999999999999999991	DECIMAL(38,0)

query II
SELECT sum_no_overflow(d9), typeof(sum_no_overflow(d9)) FROM big;
----
99999999900	DECIMAL(38,0)

endloop
