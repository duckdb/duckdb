# name: test/sql/aggregate/aggregates/approx_top_k.test
# description: Test approx top K operator
# group: [aggregates]

statement ok
CREATE TABLE integers AS SELECT i%5 as even_groups, log(1 + i*i)::int as skewed_groups  FROM range(10000) t(i);

# select all groups
query I
SELECT list_sort(approx_top_k(even_groups, 10)) FROM integers
----
[0, 1, 2, 3, 4]

# select a subset of the groups
# they should be ordered from most frequent to least frequent
query I
SELECT approx_top_k(skewed_groups, 5) FROM integers
----
[8, 7, 6, 5, 4]

# varchars
query I
SELECT approx_top_k(concat('this is a long prefix', skewed_groups::VARCHAR), 5) FROM integers
----
[this is a long prefix8, this is a long prefix7, this is a long prefix6, this is a long prefix5, this is a long prefix4]

# lists
query I
SELECT approx_top_k([skewed_groups], 5) FROM integers
----
[[8], [7], [6], [5], [4]]

# structs
query I
SELECT approx_top_k({'i': skewed_groups}, 5) FROM integers
----
[{'i': 8}, {'i': 7}, {'i': 6}, {'i': 5}, {'i': 4}]

statement error
select approx_top_k(i, 0) from range(5) t(i)
----
k value must be > 0

statement error
select approx_top_k(i, -1) from range(5) t(i)
----
k value must be > 0

statement error
select approx_top_k(i, 999999999999999) from range(5) t(i)
----
k value must be < 1000000

statement error
select approx_top_k(i, NULL) from range(5) t(i)
----
NULL

# ordered approx_top_k with grouping - the sorted aggregate wrapper finalizes one group at a time at increasing
# offsets, so ApproxTopKFinalize must honor a non-zero offset (regression: it used to crash on the second group)
statement ok
CREATE TABLE ordered_groups AS SELECT (i % 8)::TINYINT AS g, i AS v FROM range(4000) t(i);

query I
SELECT count(*) FROM (
    SELECT g, list_sort(approx_top_k(v, 5 ORDER BY v)) AS ordered,
              list_sort(approx_top_k(v, 5)) AS unordered
    FROM ordered_groups GROUP BY g
) WHERE ordered IS DISTINCT FROM unordered;
----
0

query I
SELECT g FROM (SELECT g, approx_top_k(v, 3 ORDER BY v DESC) k FROM ordered_groups GROUP BY g)
WHERE len(k) <> 3;
----

statement error
SELECT approx_top_k(x, k) actual
FROM (VALUES
  (1, 100, 1),
  (2,   1, 2),
  (3,  50, 3),
  (4,   2, 1),
  (5,  49, 2)
) AS t(id, x, k)
----
Binder Error: The "k" argument in function "approx_top_k" must be a constant expression

statement error
SELECT id,
       approx_top_k(x, k) OVER (
         ORDER BY id
         ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
         EXCLUDE CURRENT ROW
       ) AS actual
FROM (VALUES
  (1, 100, 1),
  (2,   1, 2),
  (3,  50, 3),
  (4,   2, 1),
  (5,  49, 2)
) AS t(id, x, k)
ORDER BY id;
----
Binder Error: The "k" argument in function "approx_top_k" must be a constant expression

# combining partial states that are not full adds nothing for the values a state lacks:
# per group, 0 occurs 5 times and every other value once
statement ok
SET threads=4;

query I
SELECT count(*) FROM (
	SELECT g, approx_top_k(v, 1) a
	FROM (SELECT i % 100000 g, CASE WHEN (i // 100000) < 5 THEN 0 ELSE i // 100000 END v FROM range(1600000) r(i))
	GROUP BY g
) WHERE a != [0];
----
0

# the state lives in the aggregate's arena: strings are copied into it, and an evicted value leaves the fixed
# lookup table without growing it
statement ok
SET threads=1;

# per group, value v occurs v + 1 times: at most 3 * k distinct values, so the result is exact
statement ok
CREATE TABLE exact AS
SELECT g, (g * 1000 + v)::VARCHAR || '_a_long_string_suffix' AS s
FROM range(10) t1(g), range(20) t2(v), LATERAL range(v + 1) t3(r);

query I
SELECT count(*) FROM (
	SELECT g, approx_top_k(s, 10) AS approx FROM exact GROUP BY g
) a JOIN (
	SELECT g, list(s ORDER BY c DESC)[1:10] AS expected FROM (SELECT g, s, count(*) c FROM exact GROUP BY g, s) GROUP BY g
) e USING (g)
WHERE approx = expected;
----
10

# many distinct values per group: values are evicted and re-inserted, the heavy hitters are found
query II
SELECT g, list_sort(list_filter(approx_top_k(v, 3), lambda e: e >= 1000000)) FROM (
	SELECT i % 4 AS g, CASE WHEN i % 10 < 3 THEN i % 10 + 1000000 ELSE i END AS v FROM range(200000) r(i)
) GROUP BY g ORDER BY g;
----
0	[1000000, 1000002]
1	[1000001]
2	[1000000, 1000002]
3	[1000001]

query I
SELECT approx_top_k(s, 2) FROM (
	SELECT CASE WHEN i % 3 = 0 THEN 'heavy hitter number one!' WHEN i % 5 = 0 THEN 'the second heavy hitter' ELSE md5(i::VARCHAR) END AS s
	FROM range(100000) r(i)
);
----
[heavy hitter number one!, the second heavy hitter]

# groups without values give NULL
query II
SELECT g, approx_top_k(v, 2) FILTER (WHERE v <> 5) FROM (VALUES (1, 5), (1, 5), (1, 6), (2, 5), (3, NULL)) t(g, v) GROUP BY g ORDER BY g;
----
1	[6]
2	NULL
3	NULL

# more groups than the perfect hash table handles, combined across two threads
statement ok
SET threads=2;

query I
SELECT count(*) FROM (
	SELECT i % 10000 AS g, approx_top_k(i % 10000 % 3, 3) AS x FROM range(100000) r(i) GROUP BY g
) WHERE x != [g % 3];
----
0
