# name: test/sql/aggregate/aggregates/minmax_n_int128.test
# description: Test min/max with n on types stored as 128-bit integers
# group: [aggregates]

query II
SELECT min(v, 3), max(v, 3)
FROM (VALUES ('-170141183460469231731687303715884105728'::HUGEINT), ('170141183460469231731687303715884105727'::HUGEINT),
             (0::HUGEINT), (NULL), (-1::HUGEINT), (18446744073709551616::HUGEINT)) t(v);
----
[-170141183460469231731687303715884105728, -1, 0]	[170141183460469231731687303715884105727, 18446744073709551616, 0]

query II
SELECT min(v, 2), max(v, 2)
FROM (VALUES (99999999999999999999999999999999999.99::DECIMAL(38,2)), (-99999999999999999999999999999999999.99::DECIMAL(38,2)),
             (0.01::DECIMAL(38,2)), (NULL), (-0.01::DECIMAL(38,2))) t(v);
----
[-99999999999999999999999999999999999.99, -0.01]	[99999999999999999999999999999999999.99, 0.01]

# UUIDs on both sides of the most significant bit
query II
SELECT min(v, 2), max(v, 2)
FROM (VALUES ('80000000-0000-0000-0000-000000000000'::UUID), ('7fffffff-ffff-ffff-ffff-ffffffffffff'::UUID),
             ('ffffffff-ffff-ffff-ffff-ffffffffffff'::UUID), (NULL), ('00000000-0000-0000-0000-000000000000'::UUID)) t(v);
----
[00000000-0000-0000-0000-000000000000, 7fffffff-ffff-ffff-ffff-ffffffffffff]	[ffffffff-ffff-ffff-ffff-ffffffffffff, 80000000-0000-0000-0000-000000000000]

statement ok
CREATE TABLE tbl AS
SELECT i % 7 AS g,
       CASE WHEN i % 11 = 0 THEN NULL ELSE (hash(i)::HUGEINT - 9223372036854775808) * hash(i + 1)::HUGEINT END AS h,
       CASE WHEN i % 13 = 0 THEN NULL ELSE ((hash(i) % 2000000000000)::DECIMAL(38,2) - 10000000000)::DECIMAL(38,2) END AS d38,
       CASE WHEN i % 17 = 0 THEN NULL ELSE md5(i::VARCHAR)::UUID END AS u
FROM range(3000) t(i);

foreach col h d38 u

foreach n 1 5 1000

query I
SELECT count(*) FROM (
	(SELECT g, min({col}, {n}) FROM tbl GROUP BY g
	 EXCEPT SELECT g, list({col} ORDER BY {col})[1:{n}] FROM tbl WHERE {col} IS NOT NULL GROUP BY g)
	UNION ALL
	(SELECT g, list({col} ORDER BY {col})[1:{n}] FROM tbl WHERE {col} IS NOT NULL GROUP BY g
	 EXCEPT SELECT g, min({col}, {n}) FROM tbl GROUP BY g)
	UNION ALL
	(SELECT g, max({col}, {n}) FROM tbl GROUP BY g
	 EXCEPT SELECT g, list({col} ORDER BY {col} DESC)[1:{n}] FROM tbl WHERE {col} IS NOT NULL GROUP BY g)
	UNION ALL
	(SELECT g, list({col} ORDER BY {col} DESC)[1:{n}] FROM tbl WHERE {col} IS NOT NULL GROUP BY g
	 EXCEPT SELECT g, max({col}, {n}) FROM tbl GROUP BY g)
)
----
0

endloop

endloop
