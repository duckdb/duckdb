# name: test/sql/aggregate/aggregates/test_minmax_subquery_collation.test
# description: Test min/max over nested values computed by subqueries without collation (Issue #28551)
# group: [aggregates]

statement ok
CREATE TABLE a (x INTEGER);

statement ok
INSERT INTO a VALUES (1), (2);

query I
SELECT min((SELECT [1])) FROM a;
----
[1]

query I
SELECT max((SELECT {'k': x})) FROM a;
----
{'k': 2}

query I
SELECT min(CASE WHEN EXISTS (SELECT 1) THEN [x] END) FROM a;
----
[1]
