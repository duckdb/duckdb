# name: test/sql/aggregate/aggregates/skewness_fallible.test
# description: skewness validates its finalize result and must be registered as fallible
# group: [aggregates]

# the non-finite result check raises as a regular error

statement error
SELECT skewness(x) FROM (VALUES (0.0), (1e150), (2e150)) t(x);
----
SKEW is out of range!

# the fallible registration is read by the EXPLAIN (SQL) pivot default export

statement ok
SET pivot_filter_threshold=0;

statement error
EXPLAIN (SQL) FROM (VALUES ('g','p',1.0),('h','q',2.0)) t(g,k,v)
PIVOT (skewness(v) FOR k IN ('p','q'));
----
A volatile or fallible PIVOT default must be evaluated before query execution

statement ok
RESET pivot_filter_threshold;

# the scalarized window form keeps working under dictionary vector verification

statement ok
SET debug_verify_vector='dictionary_expression';

query I rowsort
SELECT skewness(x) OVER (ROWS BETWEEN CURRENT ROW AND CURRENT ROW) FROM (VALUES (1.0), (2.0)) t(x);
----
NULL
NULL

statement ok
RESET debug_verify_vector;

# valid aggregation is unaffected

query I
SELECT round(skewness(x), 4) FROM (VALUES (1.0), (2.0), (10.0)) t(x);
----
1.6523
