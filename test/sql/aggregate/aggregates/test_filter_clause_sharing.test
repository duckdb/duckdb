# multiple filtered aggregates, one FILTER per key as a PIVOT produces them
statement ok
CREATE OR REPLACE TABLE many AS SELECT (i % 16)::INTEGER AS k, ((i // 16) % 10)::INTEGER AS g, (hash(i) % 1000)::INTEGER AS v FROM range(2240) tbl(i)

statement ok
CREATE MACRO filtered(aggr, n) AS list_aggregate(list_transform(range(n), lambda i: format(aggr || ' FILTER (WHERE k = {})', i)), 'string_agg', ', ')

# ungrouped: the columns hold the per-key results of a GROUP BY
query I
SELECT [*COLUMNS(*)] = (SELECT list(m ORDER BY k) FROM (SELECT k, max(v) m FROM many GROUP BY k)) FROM query('SELECT ' || filtered('max(v)', 16) || ' FROM many')
----
true

query I
SELECT [*COLUMNS(*)] = (SELECT list(d ORDER BY k) FROM (SELECT k, count(DISTINCT v) d FROM many WHERE k < 8 GROUP BY k)) FROM query('SELECT ' || filtered('count(DISTINCT v)', 8) || ' FROM many')
----
true

query III
SELECT list_sum(l), list_min(l), len(l) FROM (SELECT [*COLUMNS(*)] AS l FROM query('SELECT ' || filtered('count(*)', 16) || ' FROM many'))
----
2240	140	16

# grouped: perfect hash and hash aggregate
foreach threshold 0 32

statement ok
SET perfect_ht_threshold={threshold}

query I
WITH f AS (SELECT g, [*COLUMNS(* EXCLUDE g)] AS l FROM query('SELECT g, ' || filtered('max(v)', 16) || ' FROM many GROUP BY g')), r AS (SELECT g, list(m ORDER BY k) AS l FROM (SELECT g, k, max(v) m FROM many GROUP BY g, k) GROUP BY g) SELECT count(*) FROM f JOIN r USING (g, l)
----
10

# two aggregates per filter
query I
WITH f AS (SELECT g, [*COLUMNS(* EXCLUDE g)] AS l FROM query('SELECT g, ' || filtered('max(v)', 16) || ', ' || filtered('sum(v)', 16) || ' FROM many GROUP BY g')), r AS (SELECT g, list(x ORDER BY n, k) AS l FROM (SELECT g, k, 0 AS n, max(v) AS x FROM many GROUP BY g, k UNION ALL SELECT g, k, 1, sum(v) FROM many GROUP BY g, k) GROUP BY g) SELECT count(*) FROM f JOIN r USING (g, l)
----
10

query I
WITH f AS (SELECT g, [*COLUMNS(* EXCLUDE g)] AS l FROM query('SELECT g, ' || filtered('count(DISTINCT v)', 8) || ' FROM many GROUP BY g')), r AS (SELECT g, list(d ORDER BY k) AS l FROM (SELECT g, k, count(DISTINCT v) d FROM many WHERE k < 8 GROUP BY g, k) GROUP BY g) SELECT count(*) FROM f JOIN r USING (g, l)
----
10

query I
SELECT count(*) FROM (SELECT g, [*COLUMNS(* EXCLUDE g)] AS l FROM query('SELECT g, ' || filtered('count(*)', 16) || ' FROM many GROUP BY g')) WHERE list_sum(l) = 224 AND list_min(l) = 14 AND len(l) = 16
----
10

endloop

# a filter that requires ordered execution is evaluated serially
statement ok
SET threads=1

statement ok
CREATE TABLE ordered_input AS SELECT i FROM range(8192) t(i)

statement ok
SET threads=8

statement ok
CREATE SEQUENCE seq

query I
SELECT count(*) FILTER (WHERE nextval('seq') = i + 1) FROM ordered_input
----
8192
