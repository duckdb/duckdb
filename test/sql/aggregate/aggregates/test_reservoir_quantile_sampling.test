# name: test/sql/aggregate/aggregates/test_reservoir_quantile_sampling.test
# description: reservoir_quantile samples from the whole input and not only the first rows
# group: [aggregates]

query I
SELECT reservoir_quantile(x, 0.5) BETWEEN 400000 AND 600000 FROM range(1000000) t(x);
----
true

query I
SELECT reservoir_quantile(x, 0.5, 1000) BETWEEN 400000 AND 600000 FROM range(1000000) t(x);
----
true

query I
SELECT list_aggregate(reservoir_quantile(x, [0.1, 0.9], 1000), 'min') > 50000 AND
       list_aggregate(reservoir_quantile(x, [0.1, 0.9], 1000), 'max') > 800000 FROM range(1000000) t(x);
----
true

# inputs smaller than the reservoir are not sampled
query I
SELECT reservoir_quantile(x, 0.5) FROM range(10) t(x);
----
4

# the samples are those of BaseReservoirSampling
query I
SELECT reservoir_quantile(x, 0.5, 20) FROM range(100000) t(x);
----
47533

# finalizing does not reorder the sample: a running window streams, and equals the aggregate over the whole prefix
query II
EXPLAIN SELECT reservoir_quantile(x, 0.5) OVER (ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) FROM range(10) t(x);
----
physical_plan	<REGEX>:.*Streaming Window.*

query II
SELECT r = (SELECT reservoir_quantile(x, 0.5, 20) FROM range(2000) t(x)), l = (SELECT reservoir_quantile(x, [0.25, 0.75], 20) FROM range(2000) t(x))
FROM (SELECT x, reservoir_quantile(x, 0.5, 20) OVER w r, reservoir_quantile(x, [0.25, 0.75], 20) OVER w l FROM range(2000) t(x) WINDOW w AS (ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW))
WHERE x = 1999;
----
true	true
