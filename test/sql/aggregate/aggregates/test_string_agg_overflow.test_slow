# name: test/sql/aggregate/aggregates/test_string_agg_overflow.test_slow
# description: STRING_AGG allocation size overflow
# group: [aggregates]

require ram 16gb

statement ok
SET threads=1;

query I
SELECT length(string_agg(s, ''))
FROM (SELECT repeat('A', 100000000) AS s FROM range(30)) t;
----
3000000000
