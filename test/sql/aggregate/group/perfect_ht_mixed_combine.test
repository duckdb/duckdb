# name: test/sql/aggregate/group/perfect_ht_mixed_combine.test
# description: Combine perfect hash lists and string minima under a small memory limit
# group: [group]

statement ok
SET threads = 1

# Exercise the native string combine with two nonempty local tables.
statement ok
SET debug_verify_aggregate_state_export = false

statement ok
SET memory_limit = '3MB'

# The second UNION branch supplies a new, non-inline minimum for each group.
query II
SELECT sum(len(xs)), count(*) FILTER (WHERE v = repeat('a', 16385)) FROM (
    SELECT (i % 12)::UTINYINT AS g, list(hash(i)) AS xs,
           min(CASE WHEN i < 12 THEN 'z' WHEN i BETWEEN 32768 AND 32779 THEN repeat('a', 16385) END) AS v
    FROM (SELECT * FROM range(32768) UNION ALL SELECT * FROM range(32768, 65536)) t(i)
    GROUP BY g
)
----
65536	12
