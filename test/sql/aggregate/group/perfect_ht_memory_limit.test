# name: test/sql/aggregate/group/perfect_ht_memory_limit.test
# description: Perfect hash and radix hash aggregate states respect the memory limit
# group: [group]

statement ok
SET explain_output='physical_only';

statement ok
SET threads=1

statement ok
SET temp_directory=''

statement ok
SET max_temp_directory_size='0B'

statement ok
CREATE TABLE t AS SELECT i::UTINYINT AS g, i FROM range(16) t(i)

# Single-result string minima can retain a wide value per group on either path.
statement ok
CREATE VIEW totals AS SELECT count(*) AS groups, sum(length(v)) AS bytes
FROM (SELECT min(repeat('x', 2000000) || i::VARCHAR) AS v FROM t GROUP BY g) grouped

foreach threshold 0 12

statement ok
SET perfect_ht_threshold={threshold}

statement ok
SET memory_limit='16MB'

onlyif threshold=0
query II
EXPLAIN (FORMAT JSON) SELECT * FROM totals
----
physical_plan	<REGEX>:(?s).*"name": "HASH_GROUP_BY".*

onlyif threshold=12
query II
EXPLAIN (FORMAT JSON) SELECT * FROM totals
----
physical_plan	<REGEX>:(?s).*"name": "PERFECT_HASH_GROUP_BY".*

# The sixteen minima retain 32 MB of strings.
statement error
SELECT * FROM totals
----
Out of Memory

statement ok
SET memory_limit='256MB'

query II
SELECT * FROM totals
----
16	32000022

endloop
