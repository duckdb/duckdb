# name: test/sql/aggregate/group/aggregate_combine_grow_arena.test
# description: Grow arena-backed aggregate states copied from another hash table
# group: [group]

statement ok
SET threads = 4

statement ok
PRAGMA verify_parallelism

query I
SELECT sum(list_sum(top2))
FROM (
    SELECT i % 50000 AS g, arg_max(i, i, 2) AS top2
    FROM range(100000) t(i)
    GROUP BY g
)
----
4999950000

statement ok
CREATE TABLE adopt AS SELECT i % 20000 AS g, md5((CASE WHEN i // 20000 < 2 THEN -1 ELSE i % 37 END)::VARCHAR) AS s FROM range(100000) r(i);

query I
SELECT count(*) FROM (
    SELECT DISTINCT g, histogram(s) OVER (PARTITION BY g) h, mode(s) OVER (PARTITION BY g) m FROM adopt
) w JOIN (SELECT g, histogram(s) h, mode(s) m FROM adopt GROUP BY g) a USING (g)
WHERE w.h != a.h OR w.m != a.m
----
0
