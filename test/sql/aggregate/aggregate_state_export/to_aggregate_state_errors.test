# name: test/sql/aggregate/aggregate_state_export/to_aggregate_state_errors.test
# description: Validate malformed signatures and ordered aggregate state metadata
# group: [aggregate_state_export]

statement error
SELECT to_aggregate_state(0::HUGEINT, 'sum', [NULL]);
----
signature cannot contain NULL values

statement error
SELECT to_aggregate_state(0::HUGEINT, 'sum', [42]);
----
signature must be a list of types

statement error
SELECT to_aggregate_state([{'v0': 1}], 'list', ['INTEGER'], NULL, NULL);
----
ordered aggregate state must have at least one ORDER BY key

statement error
SELECT to_aggregate_state([{'v0': 1}], 'list', ['INTEGER'], NULL, 42);
----
ORDER BY argument must be a list

statement error
SELECT to_aggregate_state(
    [{'v0': 1}], 'list', ['INTEGER'], NULL,
    [NULL::STRUCT("column" UINTEGER, "order" VARCHAR)]
);
----
each ORDER BY entry must be a

statement error
SELECT to_aggregate_state(
    [{'v0': 1}], 'list', ['INTEGER'], NULL,
    [{'column': NULL::UINTEGER, 'order': 'ASC NULLS LAST'}]
);
----
each ORDER BY entry must have a non-NULL

statement error
SELECT to_aggregate_state(
    [{'v0': 1}], 'list', ['INTEGER'], NULL,
    [{'column': 0::UINTEGER, 'order': NULL::VARCHAR}]
);
----
each ORDER BY entry must have a non-NULL

statement error
SELECT to_aggregate_state(
    [1, 2], 'list', ['INTEGER'], NULL,
    [{'column': 0::UINTEGER, 'order': 'ASC NULLS LAST'}]
);
----
ordered aggregate state value must be a LIST of STRUCTs


# signatures that do not match or do not bind
statement error
SELECT to_aggregate_state(1e300, 'sum', ['FLOAT']);
----
Binder Error: Type mismatch for exported aggregate sum

statement error
SELECT to_aggregate_state(NULL, 'lttb', ['TIME', 'DOUBLE', 'BIGINT']);
----
Binder Error: Could not re-bind exported aggregate lttb

# an aggregate without arguments has no ordered state
statement error
SELECT finalize(to_aggregate_state([{'v0': 1}], 'count', [], NULL, [{'column': 0, 'order': 'ASC NULLS FIRST'}]));
----
has no arguments and cannot have an ordered aggregate state

query I
SELECT finalize(count(ORDER BY i) EXPORT_STATE) FROM range(3) t(i);
----
3

# the buffered argument columns are cast to the argument types
query I
SELECT finalize(to_aggregate_state([{'v0': 3, 'v1': 2}, {'v0': 1, 'v1': 2}], 'approx_top_k', ['INTEGER', 'BIGINT'], NULL, [{'column': 0, 'order': 'ASC NULLS FIRST'}]));
----
[1, 3]

statement error
SELECT finalize(to_aggregate_state([{'v0': 1}], 'approx_top_k', ['INTEGER', 'BIGINT'], NULL, [{'column': 0, 'order': 'ASC NULLS FIRST'}]));
----
argument count 2 exceeds the number of state columns (1)

# invalid approx_top_k states
statement error
SELECT finalize(to_aggregate_state({'k': 3, 'values': [{'value': 5, 'count': NULL}], 'filter': list_resize([]::UBIGINT[], 128, 0)}, 'approx_top_k', ['INTEGER', 'BIGINT']));
----
the state counts cannot be NULL

statement error
SELECT finalize(to_aggregate_state({'k': 3, 'values': [{'value': 5, 'count': 0}], 'filter': list_resize([]::UBIGINT[], 128, 0)}, 'approx_top_k', ['INTEGER', 'BIGINT']));
----
the state values must have a count > 0

statement error
SELECT finalize(to_aggregate_state({'k': NULL, 'values': [], 'filter': []}, 'approx_top_k', ['INTEGER', 'BIGINT']));
----
the k, values and filter cannot be NULL

statement error
SELECT finalize(to_aggregate_state({'k': 3, 'values': [{'value': 5, 'count': 1}], 'filter': list_resize([NULL]::UBIGINT[], 128, NULL)}, 'approx_top_k', ['INTEGER', 'BIGINT']));
----
the filter values cannot be NULL

query I
SELECT finalize(to_aggregate_state({'k': 3, 'values': [{'value': 5, 'count': 2}, {'value': 7, 'count': 1}], 'filter': list_resize([]::UBIGINT[], 128, 0)}, 'approx_top_k', ['INTEGER', 'BIGINT']));
----
[5, 7]
