# name: test/sql/aggregate/variant/variant_group_structure_shredded.test
# description: Test variant_group_structure with shredded VARIANT values
# group: [variant]

require json

load {TEST_DIR}/variant_group_structure_shredded.db readwrite v1.5.0

statement ok
SET variant_minimum_shredding_size = 0;

statement ok
SET force_variant_shredding = 'STRUCT(a INTEGER, b VARCHAR[], obj STRUCT(x INTEGER), d DECIMAL(8,2))';

statement ok
CREATE TABLE variants(id INTEGER, g INTEGER, v VARIANT);

statement ok
INSERT INTO variants VALUES
	-- partially shredded
	(1, 1, {'z': true, 'a': 1, 'b': ['duck', 'goose'], 'obj': {'x': 10, 'y': 'x'}, 'd': 1.5::DECIMAL(8,2)}::VARIANT),
	-- VARIANT_NULL
	(2, 1, {'a': 10, 'b': NULL, 'obj': NULL}::VARIANT),
	-- missing values in shredded schema, and a value with a different type than the shredded schema
	(3, 1, {'a': 20, 'd': 2::BIGINT}::VARIANT),
	-- root with different type than shredded schema
	(4, 2, 42::VARIANT),
	-- SQL-NULL
	(5, 2, NULL::VARIANT),
	-- values with different types than shredded schema
	(6, 3, {'a': 'duck', 'b': [1, 2], 'obj': [true, false]}::VARIANT),
	-- array elements that are partially shredded
	(7, 3, {'b': ['duck', NULL]}::VARIANT),
	(8, 4, NULL::VARIANT);

statement ok
CHECKPOINT;

restart

query I
SELECT DISTINCT vector_type(v) FROM variants;
----
SHREDDED_VECTOR

query II
SELECT g, variant_group_structure(v)::JSON FROM variants GROUP BY g ORDER BY g;
----
1	{"a":"INT32","b":["VARCHAR"],"d":"DECIMAL(21,2)","obj":{"x":"INT32","y":"VARCHAR"},"z":"BOOLEAN"}
2	"INT32"
3	{"a":"VARCHAR","b":["VARIANT"],"obj":["BOOLEAN"]}
4	"NULL"

query I
SELECT variant_group_structure(v)::JSON FROM variants WHERE g IN (1, 3);
----
{"a":"VARIANT","b":["VARIANT"],"d":"DECIMAL(21,2)","obj":"VARIANT","z":"BOOLEAN"}

query I
SELECT variant_group_structure(v)::JSON FROM variants;
----
"VARIANT"

query I
SELECT '[' || variant_group_structure(v)::JSON::VARCHAR || ']' = variant_structure(list(v)::VARIANT)::JSON::VARCHAR
FROM variants WHERE g = 1;
----
true
