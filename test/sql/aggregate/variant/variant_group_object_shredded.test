# name: test/sql/aggregate/variant/variant_group_object_shredded.test
# description: Test variant_group_object with shredded VARIANT inputs
# group: [variant]

statement ok
SET variant_minimum_shredding_size = 0;

statement ok
SET force_variant_shredding = 'STRUCT(b INTEGER, a INTEGER)';

statement ok
ATTACH '{TEMP_DIR}/variant_group_object_shredded.db' AS persisted;

statement ok
CREATE TABLE persisted.shredded_values(id INTEGER, k VARCHAR, v VARIANT);

statement ok
INSERT INTO persisted.shredded_values VALUES
    (1, 'first', {'a': 1, 'b': 2}::VARIANT),
    (2, 'second', {'a': 3}::VARIANT),
    (3, 'null_root', NULL::VARIANT),
    (4, 'scalar', 42::VARIANT);

statement ok
CHECKPOINT;

restart

query I
SELECT DISTINCT vector_type(v) FROM persisted.shredded_values;
----
SHREDDED_VECTOR

query I
SELECT variant_comparator(variant_group_object(k, v)) = variant_comparator({
    'first': {'a': 1, 'b': 2},
    'second': {'a': 3},
    'null_root': NULL,
    'scalar': 42
}::VARIANT)
FROM persisted.shredded_values;
----
true
