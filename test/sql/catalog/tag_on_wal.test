# name: test/sql/catalog/tag_on_wal.test
# description: Persist catalog and column tags through WAL replay and checkpoints
# group: [catalog]

load {TEST_DIR}/tag_on_wal.db

statement ok
SET checkpoint_threshold = '10.0 GB';

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
CREATE TABLE tagged_table(i INTEGER);

statement ok
INSERT INTO tagged_table VALUES (42), (84);

statement ok
CREATE VIEW tagged_view AS SELECT i AS vi FROM tagged_table;

statement ok
TAG ON TABLE tagged_table SET ('owner' = 'storage', 'classification' = 'internal');

statement ok
TAG ON COLUMN tagged_table.i SET ('unit' = 'count', 'pii' = 'false');

statement ok
TAG ON VIEW tagged_view SET ('owner' = 'reporting');

statement ok
TAG ON COLUMN tagged_view.vi SET ('semantic_type' = 'measure');

# Replay the tag alterations from the WAL
restart

query II
SELECT tags['owner'], tags['classification'] FROM duckdb_tables() WHERE table_name = 'tagged_table';
----
storage	internal

query II
SELECT tags['unit'], tags['pii'] FROM duckdb_columns()
WHERE table_name = 'tagged_table' AND column_name = 'i';
----
count	false

query I
SELECT tags['owner'] FROM duckdb_views() WHERE view_name = 'tagged_view';
----
reporting

query I
SELECT tags['semantic_type'] FROM duckdb_columns()
WHERE table_name = 'tagged_view' AND column_name = 'vi';
----
measure

query I rowsort
SELECT i FROM tagged_table;
----
42
84

statement ok
TAG ON TABLE tagged_table UNSET ('classification');

statement ok
TAG ON COLUMN tagged_table.i UNSET ('pii');

statement ok
CHECKPOINT;

# Read object, table-column, and view-column tags from the native checkpoint
restart

query II
SELECT tags['owner'], tags['classification'] FROM duckdb_tables() WHERE table_name = 'tagged_table';
----
storage	NULL

query II
SELECT tags['unit'], tags['pii'] FROM duckdb_columns()
WHERE table_name = 'tagged_table' AND column_name = 'i';
----
count	NULL

query I
SELECT tags['semantic_type'] FROM duckdb_columns()
WHERE table_name = 'tagged_view' AND column_name = 'vi';
----
measure

query I rowsort
SELECT i FROM tagged_table;
----
42
84
