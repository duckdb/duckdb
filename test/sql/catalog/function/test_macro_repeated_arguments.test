# name: test/sql/catalog/function/test_macro_repeated_arguments.test
# description: Arguments of macro parameters that are used multiple times are evaluated once
# group: [function]

statement ok
CREATE MACRO f(x) AS x || x;

# every level of nesting doubles the size of the result, but not the size of the expression
query I
SELECT length(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f('ab')))))))))))))))))))))))));
----
33554432

query I
SELECT f(f(i::VARCHAR)) FROM range(3) t(i) ORDER BY ALL
----
0000
1111
2222

# volatile arguments are evaluated once
statement ok
CREATE MACRO twice(x) AS [x, x];

query I
SELECT count(*) FROM (SELECT twice(random()) AS l FROM range(100)) WHERE l[1] = l[2]
----
100

# in WHERE, GROUP BY and ORDER BY
query II
SELECT f(i::VARCHAR || '-') AS k, count(*) FROM range(6) t(i) WHERE f((i % 3)::VARCHAR) <> '11' GROUP BY k ORDER BY f(k) DESC
----
5-5-	1
3-3-	1
2-2-	1
0-0-	1

# parameters that are used once, or with constant or column arguments, are substituted
statement ok
CREATE MACRO g(a, b, c) AS a + a + b + c * c;

query I
SELECT g(i + 1, i * 10, 3) FROM range(3) t(i) ORDER BY ALL
----
11
23
35

# nested macros and lambdas in the body
statement ok
CREATE MACRO h(x, y) AS list_transform(x, lambda e: e + y + y);

query I
SELECT h([1, 2], g(i + 1, 0, 0)) FROM range(2) t(i) ORDER BY ALL
----
[5, 6]
[9, 10]

query I
SELECT list_transform([1, 2], lambda e: f((e + 1)::VARCHAR))
----
[22, 33]

# bodies that cannot be evaluated in a lambda substitute the argument
statement ok
CREATE MACRO avg2(x) AS sum(x) / count(x);

query I
SELECT avg2(i + 1) FROM range(4) t(i)
----
2.5

statement ok
CREATE MACRO sub(x) AS (SELECT x + x);

query I
SELECT sub(i + 1) FROM range(3) t(i) ORDER BY ALL
----
2
4
6

statement ok
CREATE MACRO agg_macro(x) AS avg2(x) + avg2(x);

query I
SELECT agg_macro(i + 1) FROM range(4) t(i)
----
5.0

# prepared statement parameters
statement ok
PREPARE p AS SELECT f(f($1::VARCHAR))

query I
EXECUTE p(7)
----
7777
