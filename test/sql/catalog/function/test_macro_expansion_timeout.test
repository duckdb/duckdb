# name: test/sql/catalog/function/test_macro_expansion_timeout.test
# description: max_execution_time interrupts the expansion of nested macros
# group: [function]

statement ok
CREATE MACRO f(x) AS x || x;

query I
SELECT length(f(f(f('ab'))));
----
16

statement ok
SET max_execution_time=100;

statement error
SELECT length(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f('ab')))))))))))))))))))))))));
----
Query exceeded maximum execution time
