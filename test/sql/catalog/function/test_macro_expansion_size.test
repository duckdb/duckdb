# name: test/sql/catalog/function/test_macro_expansion_size.test
# description: max_macro_expansion_size bounds the expansion of nested macros
# group: [function]

statement ok
CREATE MACRO f(x) AS x || x;

query I
SELECT length(f(f(f('ab'))));
----
16

# every level of nesting doubles the size of the expanded expression
statement error
SELECT length(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f(f('ab')))))))))))))))))))))))));
----
Max macro expansion size of 100000 exceeded

statement ok
SET max_macro_expansion_size=10

statement error
SELECT length(f(f(f('ab'))));
----
Max macro expansion size of 10 exceeded

statement ok
SET max_macro_expansion_size=50

query I
SELECT length(f(f(f('ab'))));
----
16

# the size is counted over the entire query, including subqueries
statement error
SELECT length(f(f(f('ab')))), (SELECT length(f(f(f('ab')))))
----
Max macro expansion size of 50 exceeded

statement ok
RESET max_macro_expansion_size

query I
SELECT length(f(f(f(f(f(f(f(f(f(f('ab')))))))))));
----
2048
