# name: test/sql/catalog/sequence/sequence_empty_name.test
# description: Sequence functions with an empty sequence name raise a catalog error
# group: [sequence]

statement error
SELECT nextval('');
----
Catalog Error

statement error
SELECT currval('');
----
Catalog Error

statement error
