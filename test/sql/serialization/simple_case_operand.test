# name: test/sql/serialization/simple_case_operand.test
# description: Binary bound plans preserve shared simple CASE operands
# group: [serialization]

statement ok
SET storage_compatibility_version = 'v2.1.0';

statement ok
SET debug_verify_serializer = true;

statement ok
SET threads = 1;

statement ok
CREATE SEQUENCE s;

# The verifier replaces the bound plan with its deserialized copy before execution.
query I
SELECT CASE nextval('s') % 4 WHEN 1 THEN 10 WHEN 2 THEN 20 WHEN 3 THEN 30 WHEN 0 THEN 40 ELSE -1 END
FROM range(4) t(i) ORDER BY i;
----
10
20
30
40

query I
SELECT currval('s');
----
4

statement ok
CREATE SEQUENCE subquery_seq;

query I
SELECT CASE (SELECT nextval('subquery_seq')) WHEN 1 THEN 10 WHEN 2 THEN 20 ELSE -1 END FROM range(4);
----
10
10
10
10

query I
SELECT currval('subquery_seq');
----
1

statement ok
SET storage_compatibility_version = 'v2.0.0';

statement error
SELECT CASE nextval('s') WHEN 5 THEN 10 WHEN 6 THEN 20 END;
----
A bound plan with a shared CASE operand requires storage version v2.1.0 or newer

query I
SELECT currval('s');
----
4

# A repeatable operand still round-trips through v2.0.
query I
SELECT CASE i WHEN 1 THEN 10 WHEN 2 THEN 20 ELSE 0 END FROM range(3) t(i) ORDER BY i;
----
0
10
20
