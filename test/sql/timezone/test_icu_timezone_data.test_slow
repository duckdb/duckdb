# name: test/sql/timezone/test_icu_timezone_data.test_slow
# description: Verify the built-in time zone data against ICU
# group: [timezone]

require icu

# For every known time zone, this compares the offsets that the built-in implementation reports
# against the ones that ICU reports. Both the offsets at an instant and the offsets at a local
# (wall clock) time are compared, for all the ways in which an ambiguous local time can be
# resolved. The instants are a coarse sweep over the years 1600-2400 together with a dense sweep
# around every transition of the zone.
query IIIIIII
FROM icu_timezone_verify()
----

statement ok
FROM pg_timezone_names()
