# name: test/sql/timezone/test_icu_calendar_coptic.test
# description: The Coptic and Ethiopic calendars
# group: [timezone]

require icu

statement ok
SET TimeZone='UTC'

# coptic
statement ok
SET Calendar='coptic'

query IIIIII
SELECT ts, year(ts), month(ts), day(ts), era(ts), dayofyear(ts) FROM (VALUES
  ('2024-06-15 12:00:00+00'::TIMESTAMPTZ), ('0284-08-29 12:00:00+00'), ('0283-08-29 12:00:00+00'),
  ('1970-01-01 00:00:00+00'), ('2024-09-10 12:00:00+00'), ('2024-09-11 12:00:00+00'),
  ('2023-09-11 12:00:00+00'), ('2027-09-11 12:00:00+00'), ('0001-01-01 12:00:00+00')) t(ts)
----
1740-10-08 12:00:00+00	1740	10	8	1	278
0001-01-01 12:00:00+00	1	1	1	1	1
0002-13-06 (BC) 12:00:00+00	2	13	6	0	366
1686-04-23 00:00:00+00	1686	4	23	1	113
1740-13-05 12:00:00+00	1740	13	5	1	365
1741-01-01 12:00:00+00	1741	1	1	1	1
1739-13-06 12:00:00+00	1739	13	6	1	366
1743-13-06 12:00:00+00	1743	13	6	1	366
0284-05-08 (BC) 12:00:00+00	284	5	8	0	128

query I
SELECT make_timestamptz(1740, 13, 5, 12, 0, 0.0, 'UTC')
----
1740-13-05 12:00:00+00

query I
SELECT make_timestamptz(1739, 13, 6, 12, 0, 0.0, 'UTC')
----
1739-13-06 12:00:00+00

query I
SELECT make_timestamptz(1740, 13, 6, 12, 0, 0.0, 'UTC')
----
1741-01-01 12:00:00+00

query I
SELECT make_timestamptz(1740, 1, 1, 0, 0, 0.0, 'UTC')
----
1740-01-01 00:00:00+00

query I
SELECT make_timestamptz(1, 1, 1, 0, 0, 0.0, 'UTC')
----
0001-01-01 00:00:00+00

statement error
SELECT '2024-06-15 12:00:00+00'::TIMESTAMPTZ + INTERVAL 1 MONTH
----
Not implemented Error: INTERVALs do not work with 13 month calendars. Try using DATE_DIFF instead.

statement error
SELECT '2024-06-15 12:00:00+00'::TIMESTAMPTZ + INTERVAL 13 MONTH
----
Not implemented Error: INTERVALs do not work with 13 month calendars. Try using DATE_DIFF instead.

statement error
SELECT '2024-06-15 12:00:00+00'::TIMESTAMPTZ + INTERVAL 1 YEAR
----
Not implemented Error: INTERVALs do not work with 13 month calendars. Try using DATE_DIFF instead.

query I
SELECT date_trunc('year', '2024-06-15 12:00:00+00'::TIMESTAMPTZ)
----
1740-01-01 00:00:00+00

query I
SELECT date_trunc('month', '2024-06-15 12:00:00+00'::TIMESTAMPTZ)
----
1740-10-01 00:00:00+00

query I
SELECT date_trunc('quarter', '2024-06-15 12:00:00+00'::TIMESTAMPTZ)
----
1740-10-01 00:00:00+00

query I
SELECT date_trunc('decade', '2024-06-15 12:00:00+00'::TIMESTAMPTZ)
----
1740-01-01 00:00:00+00

query I
SELECT last_day('2024-06-15 12:00:00+00'::TIMESTAMPTZ)
----
2024-07-07

query I
SELECT last_day('2024-09-05 12:00:00+00'::TIMESTAMPTZ)
----
2024-09-05

query I
SELECT date_diff('year', '1900-06-15 12:00:00+00'::TIMESTAMPTZ, '2024-06-15 12:00:00+00'::TIMESTAMPTZ)
----
124

query I
SELECT date_diff('month', '2023-06-15 12:00:00+00'::TIMESTAMPTZ, '2024-06-15 12:00:00+00'::TIMESTAMPTZ)
----
13

statement error
SELECT age('2024-06-15 12:00:00+00'::TIMESTAMPTZ, '1900-06-15 12:00:00+00'::TIMESTAMPTZ)
----
Not implemented Error: INTERVALs do not work with 13 month calendars. Try using DATE_DIFF instead.

query I
SELECT date_part(['year','month','day','era','dayofyear','week','isoyear'], '2024-06-15 12:00:00+00'::TIMESTAMPTZ)
----
{'year': 1740, 'month': 10, 'day': 8, 'era': 1, 'dayofyear': 278, 'week': 40, 'isoyear': 1740}

query I
SELECT * FROM generate_series('2024-09-05 12:00:00+00'::TIMESTAMPTZ, '2024-09-15 12:00:00+00'::TIMESTAMPTZ, INTERVAL 2 DAY)
----
1740-12-30 12:00:00+00
1740-13-02 12:00:00+00
1740-13-04 12:00:00+00
1741-01-01 12:00:00+00
1741-01-03 12:00:00+00
1741-01-05 12:00:00+00

# ethiopic
statement ok
SET Calendar='ethiopic'

query IIIIII
SELECT ts, year(ts), month(ts), day(ts), era(ts), dayofyear(ts) FROM (VALUES
  ('2024-06-15 12:00:00+00'::TIMESTAMPTZ), ('0008-08-29 12:00:00+00'), ('0007-08-29 12:00:00+00'),
  ('1970-01-01 00:00:00+00'), ('2024-09-10 12:00:00+00'), ('2024-09-11 12:00:00+00'),
  ('0001-01-01 12:00:00+00'), ('5500-01-01 (BC) 12:00:00+00')) t(ts)
----
2016-10-08 12:00:00+00	2016	10	8	1	278
0001-01-03 12:00:00+00	1	1	3	1	3
0001-01-02 (BC) 12:00:00+00	5500	1	2	0	2
1962-04-23 00:00:00+00	1962	4	23	1	113
2016-13-05 12:00:00+00	2016	13	5	1	365
2017-01-01 12:00:00+00	2017	1	1	1	1
0008-05-08 (BC) 12:00:00+00	5493	5	8	0	128
5508-06-19 (BC) 12:00:00+00	-7	6	19	0	169

query I
SELECT make_timestamptz(2016, 13, 5, 12, 0, 0.0, 'UTC')
----
2016-13-05 12:00:00+00

query I
SELECT make_timestamptz(2016, 1, 1, 0, 0, 0.0, 'UTC')
----
2016-01-01 00:00:00+00

statement error
SELECT '2024-06-15 12:00:00+00'::TIMESTAMPTZ + INTERVAL 1 YEAR
----
Not implemented Error: INTERVALs do not work with 13 month calendars. Try using DATE_DIFF instead.

query I
SELECT date_trunc('year', '2024-06-15 12:00:00+00'::TIMESTAMPTZ)
----
2016-01-01 00:00:00+00

query I
SELECT last_day('2024-09-05 12:00:00+00'::TIMESTAMPTZ)
----
2024-09-05

query I
SELECT date_diff('year', '1900-06-15 12:00:00+00'::TIMESTAMPTZ, '2024-06-15 12:00:00+00'::TIMESTAMPTZ)
----
124

query I
SELECT date_part(['year','month','day','era','dayofyear','week','isoyear'], '2024-06-15 12:00:00+00'::TIMESTAMPTZ)
----
{'year': 2016, 'month': 10, 'day': 8, 'era': 1, 'dayofyear': 278, 'week': 40, 'isoyear': 2016}

# ethiopic amete alem
statement ok
SET Calendar='ethiopic-amete-alem'

query IIIIII
SELECT ts, year(ts), month(ts), day(ts), era(ts), dayofyear(ts) FROM (VALUES
  ('2024-06-15 12:00:00+00'::TIMESTAMPTZ), ('0008-08-29 12:00:00+00'), ('0007-08-29 12:00:00+00'),
  ('1970-01-01 00:00:00+00'), ('0001-01-01 12:00:00+00'), ('5500-01-01 (BC) 12:00:00+00')) t(ts)
----
7516-10-08 12:00:00+00	7516	10	8	0	278
5501-01-03 12:00:00+00	5501	1	3	0	3
5500-01-02 12:00:00+00	5500	1	2	0	2
7462-04-23 00:00:00+00	7462	4	23	0	113
5493-05-08 12:00:00+00	5493	5	8	0	128
0008-06-19 (BC) 12:00:00+00	-7	6	19	0	169

query I
SELECT make_timestamptz(7516, 13, 5, 12, 0, 0.0, 'UTC')
----
7516-13-05 12:00:00+00

query I
SELECT make_timestamptz(7516, 1, 1, 0, 0, 0.0, 'UTC')
----
7516-01-01 00:00:00+00

statement error
SELECT '2024-06-15 12:00:00+00'::TIMESTAMPTZ + INTERVAL 1 YEAR
----
Not implemented Error: INTERVALs do not work with 13 month calendars. Try using DATE_DIFF instead.

query I
SELECT date_trunc('year', '2024-06-15 12:00:00+00'::TIMESTAMPTZ)
----
7516-01-01 00:00:00+00

query I
SELECT date_diff('year', '1900-06-15 12:00:00+00'::TIMESTAMPTZ, '2024-06-15 12:00:00+00'::TIMESTAMPTZ)
----
124

query I
SELECT date_part(['year','month','day','era','dayofyear','week','isoyear'], '2024-06-15 12:00:00+00'::TIMESTAMPTZ)
----
{'year': 7516, 'month': 10, 'day': 8, 'era': 0, 'dayofyear': 278, 'week': 40, 'isoyear': 7516}

