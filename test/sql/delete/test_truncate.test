# name: test/sql/delete/test_truncate.test
# description: Test truncate
# group: [delete]

statement ok
CREATE TABLE a(i INTEGER);

statement ok
INSERT INTO a VALUES (42);

query I
TRUNCATE TABLE a
----
1

# delete everything
statement ok
TRUNCATE a

query I
SELECT COUNT(*) FROM a;
----
0

statement ok
INSERT INTO a VALUES (42);

query I
SELECT COUNT(*) FROM a;
----
1

# now test rollback of deletion
statement ok
BEGIN TRANSACTION

statement ok
TRUNCATE a

query I
SELECT COUNT(*) FROM a;
----
0

statement ok
ROLLBACK

query I
SELECT COUNT(*) FROM a;
----
1

statement ok
INSERT INTO a VALUES (42);

# the alias is accepted and ignored
statement ok
TRUNCATE a AS ignored_alias

query I
SELECT COUNT(*) FROM a;
----
0

statement ok
INSERT INTO a VALUES (42);

# CASCADE and RESTRICT are accepted and ignored
statement ok
TRUNCATE a CASCADE

query I
SELECT COUNT(*) FROM a;
----
0

statement ok
INSERT INTO a VALUES (42);

statement ok
TRUNCATE TABLE a ignored_alias RESTRICT

query I
SELECT COUNT(*) FROM a;
----
0

# CASCADE does not truncate referencing tables
statement ok
CREATE TABLE pk(i INTEGER PRIMARY KEY);

statement ok
CREATE TABLE fk(i INTEGER REFERENCES pk(i));

statement ok
INSERT INTO pk VALUES (1);

statement ok
INSERT INTO fk VALUES (1);

statement error
TRUNCATE pk CASCADE
----
Violates foreign key constraint

query I
SELECT COUNT(*) FROM fk;
----
1
