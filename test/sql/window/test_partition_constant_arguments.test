# name: test/sql/window/test_partition_constant_arguments.test
# description: Test "partition-constant" arguments in a window
# group: [window]

query II
SELECT i, 
	MIN(i, i // 13 + 1) OVER (
		PARTITION BY i // 13
		ORDER BY i
	) AS window_result
FROM range(17) AS t(i)
ORDER BY i;
