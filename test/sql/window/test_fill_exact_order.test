# name: test/sql/window/test_fill_exact_order.test
# description: FILL preserves integer and temporal order keys before computing their differences
# group: [window]

require 64bit

# Nearby timestamps must remain distinct at the upper finite boundary.
query III
WITH data AS (
	SELECT make_timestamp(9223372036854775800 + x) AS t,
		CASE WHEN x IN (0, 6) THEN make_timestamp(9223372036854775800 + x) END AS y
	FROM (VALUES (0), (3), (6)) positions(x)
)
SELECT epoch_us(t), epoch_us(fill(y ORDER BY t) OVER ()),
	epoch_us(fill(y ORDER BY t DESC) OVER ()) FROM data ORDER BY t;
----
9223372036854775800	9223372036854775800	9223372036854775800
9223372036854775803	9223372036854775803	9223372036854775803
9223372036854775806	9223372036854775806	9223372036854775806

# Every wide physical representation preserves nearby keys in either direction.
foreach type BIGINT UBIGINT HUGEINT UHUGEINT DECIMAL(38,0)

query III
WITH data AS (
	SELECT x, (9223372036854775800::HUGEINT + x)::{type} AS k,
		CASE WHEN x IN (0, 6) THEN x END AS y
	FROM (VALUES (0), (3), (6)) positions(x)
)
SELECT x, fill(y ORDER BY k) OVER (), fill(y ORDER BY k DESC) OVER () FROM data ORDER BY x;
----
0	0	0
3	3	3
6	6	6

endloop

# A ratio that rounds to an endpoint still preserves representable boundary values.
query IIIII
WITH data(g, x, b, u) AS (VALUES
	(0, 0::UHUGEINT, 0::BIGINT, 0::UBIGINT),
	(0, '170141183460469231731687303715884105728'::UHUGEINT,
		9223372036854775807::BIGINT, 18446744073709551615::UBIGINT),
	(0, '170141183460469231731687303715884105729'::UHUGEINT, NULL::BIGINT, NULL::UBIGINT),
	(1, 0::UHUGEINT, NULL::BIGINT, NULL::UBIGINT),
	(1, 1::UHUGEINT, 9223372036854775807::BIGINT, 18446744073709551615::UBIGINT),
	(1, '170141183460469231731687303715884105729'::UHUGEINT, 0::BIGINT, 0::UBIGINT),
	(2, 0::UHUGEINT, NULL::BIGINT, NULL::UBIGINT),
	(2, 1::UHUGEINT, '-9223372036854775808'::BIGINT, 0::UBIGINT),
	(2, '170141183460469231731687303715884105729'::UHUGEINT,
		0::BIGINT, 18446744073709551615::UBIGINT),
	(3, 0::UHUGEINT, 0::BIGINT, 18446744073709551615::UBIGINT),
	(3, '170141183460469231731687303715884105728'::UHUGEINT,
		'-9223372036854775808'::BIGINT, 0::UBIGINT),
	(3, '170141183460469231731687303715884105729'::UHUGEINT, NULL::BIGINT, NULL::UBIGINT)
)
SELECT g, fill(b ORDER BY x) OVER (PARTITION BY g), fill(b ORDER BY x DESC) OVER (PARTITION BY g),
	fill(u ORDER BY x) OVER (PARTITION BY g), fill(u ORDER BY x DESC) OVER (PARTITION BY g)
FROM data QUALIFY b IS NULL ORDER BY g;
----
0	9223372036854775807	9223372036854775807	18446744073709551615	18446744073709551615
1	9223372036854775807	9223372036854775807	18446744073709551615	18446744073709551615
2	-9223372036854775808	-9223372036854775808	0	0
3	-9223372036854775808	-9223372036854775808	0	0

# Half-unit extrapolation preserves ties-to-even for the original integer offset.
query IIIII
WITH cases(g, span, excess, denominator) AS (VALUES
	(0, 4611686018427387904::BIGINT, 18446744073709551616::UHUGEINT,
		'170141183460469231731687303715884105728'::UHUGEINT),
	(1, 6917529027641081856::BIGINT, 36893488147419103232::UHUGEINT,
		'170141183460469231731687303715884105728'::UHUGEINT),
	(2, 5764607523034234880::BIGINT, 73786976294838206464::UHUGEINT,
		'170141183460469231731687303715884105728'::UHUGEINT),
	(3, 4611686018427387905::BIGINT, 18446744073709551616::UHUGEINT,
		'170141183460469231768580791863303208960'::UHUGEINT)
), data AS (
	SELECT g, i, CASE WHEN i = 0 THEN 0::UHUGEINT WHEN i = 1 THEN denominator
		ELSE denominator + excess END AS x,
		CASE WHEN i = 0 THEN 0::BIGINT WHEN i = 1 THEN span END AS increasing,
		CASE WHEN i = 0 THEN span WHEN i = 1 THEN 0::BIGINT END AS decreasing
	FROM cases, (VALUES (0), (1), (2)) positions(i)
)
SELECT g, fill(increasing ORDER BY x) OVER (PARTITION BY g),
	fill(increasing ORDER BY x DESC) OVER (PARTITION BY g),
	fill(decreasing ORDER BY x) OVER (PARTITION BY g),
	fill(decreasing ORDER BY x DESC) OVER (PARTITION BY g)
FROM data QUALIFY i = 2 ORDER BY g;
----
0	4611686018427387904	4611686018427387904	0	0
1	6917529027641081858	6917529027641081858	-2	-2
2	5764607523034234882	5764607523034234882	-2	-2
3	4611686018427387906	4611686018427387906	0	0

# A tiny extrapolation can overflow when the value span covers the entire 128-bit domain.
query IIIII
WITH data(g, x, h, u) AS (VALUES
	(0, 0::UHUGEINT, '-170141183460469231731687303715884105728'::HUGEINT, 0::UHUGEINT),
	(0, '170141183460469231731687303715884105728'::UHUGEINT,
		'170141183460469231731687303715884105727'::HUGEINT,
		'340282366920938463463374607431768211455'::UHUGEINT),
	(0, '170141183460469231731687303715884105729'::UHUGEINT, NULL::HUGEINT, NULL::UHUGEINT),
	(1, 0::UHUGEINT, NULL::HUGEINT, NULL::UHUGEINT),
	(1, 1::UHUGEINT, '170141183460469231731687303715884105727'::HUGEINT,
		'340282366920938463463374607431768211455'::UHUGEINT),
	(1, '170141183460469231731687303715884105729'::UHUGEINT,
		'-170141183460469231731687303715884105728'::HUGEINT, 0::UHUGEINT),
	(2, 0::UHUGEINT, NULL::HUGEINT, NULL::UHUGEINT),
	(2, 1::UHUGEINT, '-170141183460469231731687303715884105728'::HUGEINT, 0::UHUGEINT),
	(2, '170141183460469231731687303715884105729'::UHUGEINT,
		'170141183460469231731687303715884105727'::HUGEINT,
		'340282366920938463463374607431768211455'::UHUGEINT),
	(3, 0::UHUGEINT, '170141183460469231731687303715884105727'::HUGEINT,
		'340282366920938463463374607431768211455'::UHUGEINT),
	(3, '170141183460469231731687303715884105728'::UHUGEINT,
		'-170141183460469231731687303715884105728'::HUGEINT, 0::UHUGEINT),
	(3, '170141183460469231731687303715884105729'::UHUGEINT, NULL::HUGEINT, NULL::UHUGEINT)
)
SELECT g, fill(h ORDER BY x) OVER (PARTITION BY g), fill(h ORDER BY x DESC) OVER (PARTITION BY g),
	fill(u ORDER BY x) OVER (PARTITION BY g), fill(u ORDER BY x DESC) OVER (PARTITION BY g)
FROM data QUALIFY h IS NULL ORDER BY g;
----
0	NULL	NULL	NULL	NULL
1	NULL	NULL	NULL	NULL
2	NULL	NULL	NULL	NULL
3	NULL	NULL	NULL	NULL

# FLOAT extrapolation retains its existing infinity result beyond the finite range.
query I
SELECT isinf(fill(y ORDER BY x) OVER ())
FROM (VALUES (0, 0::FLOAT), (1, '3.4028234663852886e38'::FLOAT), (2, NULL::FLOAT)) data(x, y)
QUALIFY x = 2;
----
true

foreach type FLOAT DOUBLE

query III
WITH data AS (
	SELECT x, (9223372036854775800::BIGINT + x) AS k,
		CASE WHEN x IN (0, 6) THEN x::{type} END AS y
	FROM (VALUES (0), (3), (6)) positions(x)
)
SELECT x, fill(y ORDER BY k) OVER (), fill(y ORDER BY k DESC) OVER () FROM data ORDER BY x;
----
0	0	0
3	3	3
6	6	6

endloop

query III
WITH data AS (
	SELECT x, (922337203685477000::HUGEINT + x)::DECIMAL(18,0) AS k,
		CASE WHEN x IN (0, 6) THEN x END AS y
	FROM (VALUES (0), (3), (6)) positions(x)
)
SELECT x, fill(y ORDER BY k) OVER (), fill(y ORDER BY k DESC) OVER () FROM data ORDER BY x;
----
0	0	0
3	3	3
6	6	6

# Signed order differences may span all 128 bits.
query III
WITH data AS (
	SELECT x, CASE WHEN x IN (
		'-170141183460469231731687303715884105728'::HUGEINT,
		'170141183460469231731687303715884105727'::HUGEINT) THEN x END AS y
	FROM (VALUES ('-170141183460469231731687303715884105728'::HUGEINT),
		(-1::HUGEINT), (0::HUGEINT), (1::HUGEINT),
		('170141183460469231731687303715884105727'::HUGEINT)) positions(x)
)
SELECT x, fill(y ORDER BY x) OVER (), fill(y ORDER BY x DESC) OVER () FROM data ORDER BY x;
----
-170141183460469231731687303715884105728	-170141183460469231731687303715884105728	-170141183460469231731687303715884105728
-1	-1	-1
0	0	0
1	1	1
170141183460469231731687303715884105727	170141183460469231731687303715884105727	170141183460469231731687303715884105727

# Unsigned order differences also cover the entire domain.
query III
WITH data AS (
	SELECT x, CASE WHEN x IN (0::UHUGEINT, '340282366920938463463374607431768211455'::UHUGEINT)
		THEN x END AS y
	FROM (VALUES (0::UHUGEINT), (1::UHUGEINT),
		('170141183460469231731687303715884105728'::UHUGEINT),
		('340282366920938463463374607431768211454'::UHUGEINT),
		('340282366920938463463374607431768211455'::UHUGEINT)) positions(x)
)
SELECT x, fill(y ORDER BY x) OVER (), fill(y ORDER BY x DESC) OVER () FROM data ORDER BY x;
----
0	0	0
1	1	1
170141183460469231731687303715884105728	170141183460469231731687303715884105728	170141183460469231731687303715884105728
340282366920938463463374607431768211454	340282366920938463463374607431768211454	340282366920938463463374607431768211454
340282366920938463463374607431768211455	340282366920938463463374607431768211455	340282366920938463463374607431768211455

# Full-width ratios floor non-integral products without an overflowing intermediate.
query IIIIII
WITH data AS (
	SELECT x, CASE WHEN x = 0 THEN '-170141183460469231731687303715884105728'::HUGEINT
		WHEN x = '340282366920938463463374607431768211455'::UHUGEINT
		THEN '170141183460469231731687303715884105725'::HUGEINT END AS a,
		CASE WHEN x = 0 THEN '170141183460469231731687303715884105725'::HUGEINT
		WHEN x = '340282366920938463463374607431768211455'::UHUGEINT
		THEN '-170141183460469231731687303715884105728'::HUGEINT END AS b,
		CASE WHEN x = 0 THEN 7::UHUGEINT
		WHEN x = '340282366920938463463374607431768211455'::UHUGEINT
		THEN '340282366920938463463374607431768211444'::UHUGEINT END AS c
	FROM (VALUES (0::UHUGEINT), (1::UHUGEINT), ('18446744073709551629'::UHUGEINT),
		('170141183460469231731687303715884105745'::UHUGEINT),
		('340282366920938463463374607431768211454'::UHUGEINT),
		('340282366920938463463374607431768211455'::UHUGEINT)) positions(x)
)
SELECT x, fill(a ORDER BY x) OVER (), fill(a ORDER BY x DESC) OVER (),
	fill(b ORDER BY x) OVER (), fill(b ORDER BY x DESC) OVER (), fill(c ORDER BY x) OVER ()
FROM data ORDER BY x;
----
0	-170141183460469231731687303715884105728	-170141183460469231731687303715884105728	170141183460469231731687303715884105725	170141183460469231731687303715884105725	7
1	-170141183460469231731687303715884105728	-170141183460469231731687303715884105728	170141183460469231731687303715884105724	170141183460469231731687303715884105724	7
18446744073709551629	-170141183460469231713240559642174554100	-170141183460469231713240559642174554100	170141183460469231713240559642174554096	170141183460469231713240559642174554096	18446744073709551635
170141183460469231731687303715884105745	15	15	-19	-19	170141183460469231731687303715884105742
340282366920938463463374607431768211454	170141183460469231731687303715884105724	170141183460469231731687303715884105724	-170141183460469231731687303715884105728	-170141183460469231731687303715884105728	340282366920938463463374607431768211443
340282366920938463463374607431768211455	170141183460469231731687303715884105725	170141183460469231731687303715884105725	-170141183460469231731687303715884105728	-170141183460469231731687303715884105728	340282366920938463463374607431768211444

# A 64-bit unsigned denominator can exceed INT64_MAX without a floating point cast.
query I
SELECT fill(y ORDER BY x) OVER () FROM (VALUES
	(0::UBIGINT, 0::BIGINT), (1::UBIGINT, NULL::BIGINT),
	(9223372036854775808::UBIGINT, 9223372036854775807::BIGINT)
) data(x, y) QUALIFY x = 1;
----
0

# Decimal scale is shared by all keys and cancels in the exact ratio.
query III
WITH data AS (
	SELECT x, '99999999999999999999999999999999.999990'::DECIMAL(38,6)
		+ x * '0.000001'::DECIMAL(7,6) AS k,
		CASE WHEN x IN (0, 6) THEN x END AS y
	FROM (VALUES (0), (3), (6)) positions(x)
)
SELECT x, fill(y ORDER BY k) OVER (), fill(y ORDER BY k DESC) OVER () FROM data ORDER BY x;
----
0	0	0
3	3	3
6	6	6

# Exact order differences also preserve the slope for extrapolation.
query III
WITH data AS (
	SELECT x, (9223372036854775800::BIGINT + x) AS k,
		CASE WHEN x IN (2, 4) THEN x END AS y
	FROM range(7) positions(x)
)
SELECT x, fill(y ORDER BY k) OVER (), fill(y ORDER BY k DESC) OVER () FROM data ORDER BY x;
----
0	0	0
1	1	1
2	2	2
3	3	3
4	4	4
5	5	5
6	6	6
