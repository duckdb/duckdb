# Test shift down
query TT
EXPLAIN
SELECT i, LAG(i, 1) OVER() AS i1
FROM range(3000) tbl(i)
WHERE i % 2 = 0
QUALIFY i1 <> i - 2
----
physical_plan	<REGEX>:.*STREAMING_WINDOW.*

query TT
SELECT i, LAG(i, 1) OVER() AS i1
FROM range(3000) tbl(i)
