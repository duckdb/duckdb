# name: test/sql/window/test_frame_analysis.test
# description: Test IGNORE NULLS window syntax
# group: [window]

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

statement ok
PRAGMA explain_output = PHYSICAL_ONLY;

#
# Table 4
#
# Note that cases iii-iv are not yet supported because we don't have UCC detection
# Note also that ii is not possible with [W] == 0 because only one EXCLUDE clause is allowed

statement ok
create table t as from values
	(0, 0, 10, 'a'),
	(1, 0, 11, 'b'),
	(2, 1, 12, 'c'),
	(3, 1, 13, 'd')
	w(u, p, o, a)
;

#
# [W] == 0
#

# count(a), count(*) 
query II
explain
select count(a) over ia, count(*) over ia
from t
window ia as (rows between current row and current row exclude current row)
----
physical_plan	<!REGEX>:.*WINDOW.*

query II
select count(a) over ia, count(*) over ia
from t
window ia as (rows between current row and current row exclude current row)
----
0	0
0	0
0	0
0	0

query II
explain
select count(a) over ib, count(*) over ib
from t
window ib as (rows between 0 preceding and 0 following exclude current row)
----
physical_plan	<!REGEX>:.*WINDOW.*

query II
select count(a) over ib, count(*) over ib
from t
window ib as (rows between 0 preceding and 0 following exclude current row)
----
0	0
0	0
0	0
0	0

# any other

# 0 arguments
foreach func rank dense_rank cume_dist percent_rank

query II
explain
select {func}() over ia
from t
window ia as (rows between current row and current row exclude current row)
----
physical_plan	<!REGEX>:.*WINDOW.*

query I
