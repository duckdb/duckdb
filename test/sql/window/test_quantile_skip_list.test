# name: test/sql/window/test_quantile_skip_list.test
# description: Test quantile window functions using the skip-list accelerator
# group: [window]

statement ok
SET debug_window_mode='window';

# Widely separated constant frame bounds select the skip-list implementation.
# Moving the frame exercises incremental removal and insertion, including NULL values.
query IIRIR
WITH t(i, v) AS (
	SELECT i, CASE WHEN i = 3 THEN NULL ELSE i * 10 END
	FROM range(12) r(i)
)
SELECT i,
	quantile_disc(v, 0.5) OVER w,
	quantile_cont(v, 0.5) OVER w,
	quantile_disc(v, [0.25, 0.75]) OVER w,
	mad(v) OVER w
FROM t
WINDOW w AS (ORDER BY i ROWS BETWEEN 10 PRECEDING AND 1 PRECEDING)
ORDER BY i;
----
0	NULL	NULL	NULL	NULL
1	0	0.0	[0, 0]	0.0
2	0	5.0	[0, 10]	5.0
3	10	10.0	[0, 20]	10.0
4	10	10.0	[0, 20]	10.0
5	10	15.0	[0, 20]	10.0
6	20	20.0	[10, 40]	20.0
7	20	30.0	[10, 50]	20.0
8	40	40.0	[10, 60]	20.0
9	40	45.0	[10, 60]	25.0
10	50	50.0	[20, 70]	30.0
11	60	60.0	[40, 80]	20.0
