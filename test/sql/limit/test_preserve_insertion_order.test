# name: test/sql/limit/test_preserve_insertion_order.test
# description: Test limit with preserve insertion order disabled
# group: [limit]

statement ok
SET preserve_insertion_order=false

statement ok
CREATE TABLE integers AS SELECT 1 AS i FROM range(1000000) t(i)

query III
SELECT MIN(i), MAX(i), COUNT(*) FROM integers
----
1	1	1000000

query I
SELECT * FROM integers LIMIT 5
----
1
1
1
1
1

statement ok
CREATE TABLE integers2 AS SELECT * FROM range(1000000) tbl(i)

query III
SELECT MIN(i), MAX(i), COUNT(*) FROM integers2
----
0	999999	1000000

# we need a rowsort here because we don't preserve insertion order
# note that rowsort is a string-based sort
query I rowsort
SELECT * FROM integers2 WHERE i IN (337, 195723, 442578, 994375)
----
195723
337
442578
994375

# when insertion order is disabled, there is no guarantee on which tuples come out of a LIMIT clause
# for the LIMIT test select everything
query I rowsort
SELECT * FROM integers2 WHERE i IN (337, 195723, 442578, 994375) LIMIT 4
----
195723
337
442578
994375

# OFFSET on an unordered input is intended here
statement ok
SET warnings_as_errors=false

query I
SELECT * FROM integers LIMIT 5 OFFSET 500000
----
1
1
1
1
1

# no worker threads: the client thread runs the 4 tasks of each pipeline one after another
statement ok
SET threads=4

statement ok
SET external_threads=4

# a LIMIT expression is evaluated once, not once per thread
statement ok
CREATE SEQUENCE seq

query I
SELECT count(*) FROM (SELECT i FROM integers2 LIMIT (CASE WHEN nextval('seq') = 1 THEN 5 ELSE 0 END));
----
5

query I
SELECT currval('seq')
----
1

# in-memory tables: storage I/O can block a task and resume it out of order
statement ok
ATTACH ':memory:' AS mem

statement ok
USE mem

# 40 row groups with scattered keys; only the first 3 row groups have a matching key
statement ok
CREATE TABLE events AS SELECT i, (i * 2654435761) % 4294967296 AS k FROM range(40 * 122880) t(i);

statement ok
CREATE TABLE chosen AS SELECT (i * 122880 * 2654435761) % 4294967296 AS k FROM range(3) t(i);

# a reached parallel STREAMING_LIMIT stops the scan in every task, also in tasks without a match
query II
EXPLAIN ANALYZE SELECT i FROM events SEMI JOIN chosen USING (k) LIMIT 1;
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: [0-9] / 40.*

# the LIMIT that finishes the recursive step must not stop the next iteration
query I
WITH RECURSIVE r(n) AS (SELECT i FROM range(1000) t(i) UNION ALL SELECT n + 1000 FROM (SELECT n FROM r WHERE n < 50000 LIMIT 500)) SELECT count(*) FROM r
----
26000
