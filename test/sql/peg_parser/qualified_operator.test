# name: test/sql/peg_parser/qualified_operator.test
# description: Test analyze and vacuum statements in peg parser
# group: [peg_parser]

query I
select 1 OPERATOR(main.+) 2;
----
3

statement ok
create schema "schema.with.dot";

statement ok
create macro "schema.with.dot"."+"(a, b) as a + b;

query I
select 1 OPERATOR("schema.with.dot".+) 2;
----
3

statement error
select 1 OPERATOR(foo.bar.main.+) 2;
----
Parser Error: Too many identifiers found
