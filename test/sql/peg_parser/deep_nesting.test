# name: test/sql/peg_parser/deep_nesting.test
# description: Test deeply nested input with the heap-based PEG parser
# group: [peg_parser]

statement ok
SET debug_heap_based_parser=true;

statement ok
SET max_expression_depth=1000000;

query I
FROM query('SELECT ' || repeat('(', 10000) || '1' || repeat(')', 10000));
----
1

# Exercise nested list expressions at increasing depths. Keep the maximum
# depth bounded so failures are reported through max_expression_depth.
statement ok
SET max_expression_depth=1000;

foreach depth 1 10 100 500

query I
FROM query('SELECT (' || repeat('[', {depth}) || '1' || repeat(']', {depth}) || ') IS NOT NULL');
----
1

endloop

# Array type modifiers use a different transformation path.
query I
FROM query('SELECT (NULL::INT' || repeat('[]', 999) || ') IS NULL');
----
true

statement error
FROM query('SELECT (NULL::INT' || repeat('[]', 10000) || ') IS NULL');
----
<REGEX>:.*Max expression depth limit of 1000 exceeded.*
