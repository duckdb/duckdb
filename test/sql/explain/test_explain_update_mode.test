# name: test/sql/explain/test_explain_update_mode.test
# description: EXPLAIN shows whether an UPDATE runs in place or as a DELETE + INSERT, one section per rule
# group: [explain]

# 1. The rule: an UPDATE is a DELETE + INSERT if it writes a column that has an index or a list-like type

# a written column with a PRIMARY KEY
statement ok
CREATE TABLE pk (id INTEGER PRIMARY KEY, v INTEGER);

query II
EXPLAIN UPDATE pk SET id = 1
----
physical_plan	<REGEX>:.*Table: .*\.pk .*Update Mode: Delete \+ Insert.*

# an index on a column that is not written does not matter
query II
EXPLAIN UPDATE pk SET v = 1
----
physical_plan	<REGEX>:.*Table: .*\.pk .*Update Mode: In Place.*

# UNIQUE
statement ok
CREATE TABLE uq (a INTEGER UNIQUE, v INTEGER);

query II
EXPLAIN UPDATE uq SET a = 1
----
physical_plan	<REGEX>:.*Update Mode: Delete \+ Insert.*

# FOREIGN KEY: the referencing column has an index
statement ok
CREATE TABLE fk (p INTEGER REFERENCES pk(id), v INTEGER);

query II
EXPLAIN UPDATE fk SET p = 1
----
physical_plan	<REGEX>:.*Update Mode: Delete \+ Insert.*

query II
EXPLAIN UPDATE fk SET v = 1
----
physical_plan	<REGEX>:.*Update Mode: In Place.*

# CREATE INDEX, also on a column that is only part of a multi-column index
statement ok
CREATE TABLE ix (a INTEGER, b INTEGER, v INTEGER);

statement ok
CREATE INDEX ix_ab ON ix(a, b);

query II
EXPLAIN UPDATE ix SET b = 1
----
physical_plan	<REGEX>:.*Update Mode: Delete \+ Insert.*

query II
EXPLAIN UPDATE ix SET v = 1
----
physical_plan	<REGEX>:.*Update Mode: In Place.*

# an expression index counts for every column it references
statement ok
CREATE TABLE ex (a INTEGER, v INTEGER);

statement ok
CREATE INDEX ex_idx ON ex((a + 1));

query II
EXPLAIN UPDATE ex SET a = 1
----
physical_plan	<REGEX>:.*Update Mode: Delete \+ Insert.*

query II
EXPLAIN UPDATE ex SET v = 1
----
physical_plan	<REGEX>:.*Update Mode: In Place.*

# an index on a generated column counts for the columns it is computed from
statement ok
CREATE TABLE gen (a INTEGER, b INTEGER GENERATED ALWAYS AS (a + 1), v INTEGER);

statement ok
CREATE INDEX gen_idx ON gen(b);

query II
EXPLAIN UPDATE gen SET a = 1
----
physical_plan	<REGEX>:.*Update Mode: Delete \+ Insert.*

query II
EXPLAIN UPDATE gen SET v = 1
----
physical_plan	<REGEX>:.*Update Mode: In Place.*

# LIST, ARRAY, MAP, UNION, VARIANT, GEOMETRY and GEOGRAPHY, or a STRUCT containing one, cannot be updated in place
# (a TEMP table, as test configs with an older storage version cannot store VARIANT or GEOGRAPHY)
statement ok
CREATE TEMP TABLE ty (l INTEGER[], ar INTEGER[2], m MAP(INTEGER, INTEGER), un UNION(i INTEGER, s VARCHAR), va VARIANT,
    geom GEOMETRY, geog GEOGRAPHY, sl STRUCT(x INTEGER[]), ss STRUCT(x INTEGER, y VARCHAR), sss STRUCT(x STRUCT(y INTEGER)));

query II
EXPLAIN UPDATE ty SET l = [1]
----
physical_plan	<REGEX>:.*Update Mode: Delete \+ Insert.*

query II
EXPLAIN UPDATE ty SET ar = [1, 2]
----
physical_plan	<REGEX>:.*Update Mode: Delete \+ Insert.*

query II
EXPLAIN UPDATE ty SET m = MAP {1: 1}
----
physical_plan	<REGEX>:.*Update Mode: Delete \+ Insert.*

query II
EXPLAIN UPDATE ty SET un = 1
----
physical_plan	<REGEX>:.*Update Mode: Delete \+ Insert.*

query II
EXPLAIN UPDATE ty SET va = 1
----
physical_plan	<REGEX>:.*Update Mode: Delete \+ Insert.*

query II
EXPLAIN UPDATE ty SET geom = NULL
----
physical_plan	<REGEX>:.*Update Mode: Delete \+ Insert.*

query II
EXPLAIN UPDATE ty SET geog = NULL
----
physical_plan	<REGEX>:.*Update Mode: Delete \+ Insert.*

query II
EXPLAIN UPDATE ty SET sl = {'x': [1]}
----
physical_plan	<REGEX>:.*Update Mode: Delete \+ Insert.*

query II
EXPLAIN UPDATE ty SET ss = {'x': 1, 'y': 'a'}
----
physical_plan	<REGEX>:.*Update Mode: In Place.*

query II
EXPLAIN UPDATE ty SET sss = {'x': {'y': 1}}
----
physical_plan	<REGEX>:.*Update Mode: In Place.*

# a setting forces DELETE + INSERT
statement ok
CREATE TABLE n (a INTEGER, v INTEGER);

query II
EXPLAIN UPDATE n SET a = 1
----
physical_plan	<REGEX>:.*Update Mode: In Place.*

statement ok
SET debug_force_update_to_del_and_insert = true;

query II
EXPLAIN UPDATE n SET a = 1
----
physical_plan	<REGEX>:.*Update Mode: Delete \+ Insert.*

statement ok
RESET debug_force_update_to_del_and_insert;

# 2. Statements that write more columns than listed

statement ok
CREATE TABLE t (id INTEGER PRIMARY KEY, name VARCHAR, v INTEGER);

statement ok
CREATE INDEX t_name ON t(name);

statement ok
CREATE TABLE s (id INTEGER, name VARCHAR, v INTEGER);

# MERGE UPDATE without a SET list, or UPDATE SET *, writes every column by position, including the key
query II
EXPLAIN MERGE INTO t USING s ON t.id = s.id WHEN MATCHED THEN UPDATE
----
physical_plan	<REGEX>:.*Update Mode: Delete \+ Insert.*

query II
EXPLAIN MERGE INTO t USING s ON t.id = s.id WHEN MATCHED THEN UPDATE SET *
----
physical_plan	<REGEX>:.*Update Mode: Delete \+ Insert.*

query II
EXPLAIN MERGE INTO n USING n AS src ON n.a = src.a WHEN MATCHED THEN UPDATE
----
physical_plan	<REGEX>:.*Update Mode: In Place.*

# MERGE UPDATE BY NAME writes every column of the source
query II
EXPLAIN MERGE INTO t USING (SELECT 1 AS id, 2 AS v) src ON t.id = src.id WHEN MATCHED THEN UPDATE BY NAME
----
physical_plan	<REGEX>:.*Update Mode: Delete \+ Insert.*

query II
EXPLAIN MERGE INTO t USING (SELECT 1 AS v) src ON t.id = src.v WHEN MATCHED THEN UPDATE BY NAME
----
physical_plan	<REGEX>:.*Update Mode: In Place.*

# INSERT OR REPLACE writes every inserted column except the key, here also the indexed name
query II
EXPLAIN INSERT OR REPLACE INTO t VALUES (1, 'a', 5)
----
physical_plan	<REGEX>:.*Update Mode: Delete \+ Insert.*

query II
EXPLAIN INSERT OR REPLACE INTO t BY NAME SELECT 1 AS id, 5 AS v
----
physical_plan	<REGEX>:.*Update Mode: In Place.*

# ON CONFLICT DO UPDATE writes exactly the listed columns
query II
EXPLAIN INSERT INTO t VALUES (1, 'a', 5) ON CONFLICT (id) DO UPDATE SET v = excluded.v
----
physical_plan	<REGEX>:.*Update Mode: In Place.*

query II
EXPLAIN INSERT INTO t VALUES (1, 'a', 5) ON CONFLICT (id) DO UPDATE SET name = excluded.name
----
physical_plan	<REGEX>:.*Update Mode: Delete \+ Insert.*

# ON CONFLICT DO NOTHING does not update at all
query II
EXPLAIN INSERT INTO t VALUES (1, 'a', 5) ON CONFLICT DO NOTHING
----
physical_plan	<!REGEX>:.*Update.*

# RETURNING writes every column, also in MERGE and ON CONFLICT DO UPDATE
query II
EXPLAIN UPDATE t SET v = 1 RETURNING v
----
physical_plan	<REGEX>:.*Update Mode: Delete \+ Insert.*

query II
EXPLAIN INSERT INTO t VALUES (1, 'a', 5) ON CONFLICT (id) DO UPDATE SET v = excluded.v RETURNING v
----
physical_plan	<REGEX>:.*Update Mode: Delete \+ Insert.*

query II
EXPLAIN MERGE INTO t USING s ON t.id = s.id WHEN MATCHED THEN UPDATE SET v = s.v RETURNING v
----
physical_plan	<REGEX>:.*Update Mode: Delete \+ Insert.*

query II
EXPLAIN UPDATE n SET v = 1 RETURNING v
----
physical_plan	<REGEX>:.*Update Mode: In Place.*

statement ok
CREATE TABLE nl (a INTEGER, l INTEGER[]);

query II
EXPLAIN UPDATE nl SET a = 1 RETURNING a
----
physical_plan	<REGEX>:.*Update Mode: Delete \+ Insert.*

# an UPDATE trigger that fires acts like RETURNING (TEMP tables, as triggers also need a newer storage version)
statement ok
CREATE TEMP TABLE audit (msg VARCHAR);

statement ok
CREATE TEMP TABLE trg_pk (id INTEGER PRIMARY KEY, v INTEGER);

statement ok
CREATE TRIGGER trg_pk_upd AFTER UPDATE ON trg_pk FOR EACH STATEMENT INSERT INTO audit VALUES ('upd');

query II
EXPLAIN UPDATE trg_pk SET v = 1
----
physical_plan	<REGEX>:.*Update Mode: Delete \+ Insert.*

statement ok
CREATE TEMP TABLE trg_n (a INTEGER, v INTEGER);

statement ok
CREATE TRIGGER trg_n_upd AFTER UPDATE ON trg_n FOR EACH STATEMENT INSERT INTO audit VALUES ('upd');

query II
EXPLAIN UPDATE trg_n SET v = 1
----
physical_plan	<REGEX>:.*Update Mode: In Place.*

# an INSERT trigger does the same to ON CONFLICT DO UPDATE
statement ok
CREATE TEMP TABLE trg_ins (id INTEGER PRIMARY KEY, v INTEGER);

query II
EXPLAIN INSERT INTO trg_ins VALUES (1, 1) ON CONFLICT (id) DO UPDATE SET v = excluded.v
----
physical_plan	<REGEX>:.*Update Mode: In Place.*

statement ok
CREATE TRIGGER trg_ins_ins AFTER INSERT ON trg_ins FOR EACH STATEMENT INSERT INTO audit VALUES ('ins');

query II
EXPLAIN INSERT INTO trg_ins VALUES (1, 1) ON CONFLICT (id) DO UPDATE SET v = excluded.v
----
physical_plan	<REGEX>:.*Update Mode: Delete \+ Insert.*

# a trigger on UPDATE OF other columns does not fire, so it adds nothing
statement ok
CREATE TEMP TABLE trg_of (id INTEGER PRIMARY KEY, v INTEGER);

statement ok
CREATE TRIGGER trg_of_upd AFTER UPDATE OF id ON trg_of FOR EACH STATEMENT INSERT INTO audit VALUES ('upd');

query II
EXPLAIN UPDATE trg_of SET v = 1
----
physical_plan	<REGEX>:.*Update Mode: In Place.*

# a CHECK over two or more columns adds all of them to every UPDATE, even one that writes none of them
statement ok
CREATE TABLE chk (a INTEGER, b INTEGER, c INTEGER, CHECK (a <= b));

query II
EXPLAIN UPDATE chk SET c = 1
----
physical_plan	<REGEX>:.*Update Mode: In Place.*

statement ok
CREATE INDEX chk_b ON chk(b);

query II
EXPLAIN UPDATE chk SET c = 1
----
physical_plan	<REGEX>:.*Update Mode: Delete \+ Insert.*

statement ok
CREATE TABLE chk_list (a INTEGER, c INTEGER, l INTEGER[], CHECK (a <= len(l)));

query II
EXPLAIN UPDATE chk_list SET c = 1
----
physical_plan	<REGEX>:.*Update Mode: Delete \+ Insert.*

# a one-column CHECK adds nothing
statement ok
CREATE TABLE chk_one (a INTEGER UNIQUE, c INTEGER, CHECK (a > 0));

query II
EXPLAIN UPDATE chk_one SET c = 1
----
physical_plan	<REGEX>:.*Update Mode: In Place.*

# 3. Only the column list matters, not the values: SET id = id moves the row

query II
EXPLAIN UPDATE pk SET id = id
----
physical_plan	<REGEX>:.*Update Mode: Delete \+ Insert.*

statement ok
INSERT INTO pk VALUES (1, 1), (2, 2);

statement ok
BEGIN

statement ok
UPDATE pk SET v = v + 1 WHERE id = 1;

statement ok
UPDATE pk SET id = id WHERE id = 2;

# in the same transaction, the in-place update kept rowid 0 and the DELETE + INSERT gave id 2 a new rowid
query II
SELECT id, rowid < 2 FROM pk ORDER BY id
----
1	true
2	false

statement ok
ROLLBACK

# 4. MERGE decides per WHEN MATCHED clause; the plan shows the clauses in order

query II
EXPLAIN (FORMAT JSON) MERGE INTO t USING s ON t.id = s.id
    WHEN MATCHED AND t.name IS DISTINCT FROM s.name THEN UPDATE SET name = s.name, v = s.v
    WHEN MATCHED THEN UPDATE SET v = s.v
----
physical_plan	<REGEX>:.*"name": "UPDATE".*"Update Mode": "Delete \+ Insert".*"name": "UPDATE".*"Update Mode": "In Place".*
