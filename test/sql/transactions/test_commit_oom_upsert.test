# name: test/sql/transactions/test_commit_oom_upsert.test
# description: A COMMIT of a DELETE + INSERT upsert that runs out of memory fails closed
# group: [transactions]

require no_alternative_verify

require skip_reload

require no_force_storage

require vector_size 2048

# No spilling: the commit-time append must fail once memory_limit is reached.
statement ok
SET temp_directory = '';

statement ok
SET threads = 1;

statement ok
CREATE TABLE upsert (k INTEGER PRIMARY KEY, payload VARCHAR);

statement ok
INSERT INTO upsert SELECT i, 'x' FROM range(1000) r(i);

statement ok
BEGIN;

statement ok
DELETE FROM upsert WHERE k < 10;

statement ok
INSERT INTO upsert SELECT i, repeat('y', 1000) FROM range(0, 10) r(i) UNION ALL SELECT i, repeat('y', 1000) FROM range(1000, 51000) r(i);

# Local storage holds ~52MB; copying it into the table at commit does not fit.
statement ok
SET memory_limit = '90MB';

statement error
COMMIT;
----
Failed to flush table

# The partially published rows and index keys must never become visible.
statement error
SELECT count(*) FROM upsert;
----
<REGEX>:.*invalidated.*
