# name: test/sql/transactions/join_transaction_concurrent_append_scan.test_slow
# description: Connections of one shared transaction scan a table while others append small batches with NULL values to it
# group: [transactions]

statement ok
CREATE TABLE tbl(i BIGINT, s VARCHAR, d DOUBLE, l INTEGER[], b BOOLEAN);

statement ok
BEGIN TRANSACTION

statement ok
SET VARIABLE txid = share_transaction()

set variable txid <variable:txid>

concurrentloop threadid 0 8

statement ok
JOIN TRANSACTION '{txid}'

loop r 0 100

# small batches: the validity masks and strings of the last segment are written by many appends
statement ok
INSERT INTO tbl SELECT CASE WHEN range % 3 = 0 THEN NULL ELSE range END, CASE WHEN range % 5 = 0 THEN NULL ELSE 'v' || range END, CASE WHEN range % 7 = 0 THEN NULL ELSE range::DOUBLE END, CASE WHEN range % 4 = 0 THEN NULL ELSE [range] END, range % 2 = 0 FROM range(37)

# readers scan the segments that are being appended to
statement ok
SELECT count(i), count(s), count(d), count(l), count(b), sum(i), max(s), sum(d), sum(len(l)), count(*) FILTER (b) FROM tbl

statement ok
SELECT * FROM tbl WHERE i IS NULL AND s IS NOT NULL LIMIT 5

query I
SELECT count(*) >= 37 * ({r} + 1) FROM tbl
----
true

endloop

statement ok
COMMIT

endloop

query IIIIII
SELECT count(*), count(i), count(s), count(d), count(l), count(b) FROM tbl
----
29600	19200	23200	24800	21600	29600

statement ok
COMMIT

query IIIIII
SELECT count(*), count(i), count(s), count(d), count(l), count(b) FROM tbl
----
29600	19200	23200	24800	21600	29600
