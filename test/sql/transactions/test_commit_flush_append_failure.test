# name: test/sql/transactions/test_commit_flush_append_failure.test
# description: A failed commit-time flush reverts the copy-path append; a merge-path failure invalidates
# group: [transactions]

require no_force_storage

# Copy path: appends to a non-empty table are copied row by row at commit.

statement ok
CREATE TABLE pk (k INTEGER PRIMARY KEY, v VARCHAR);

statement ok
INSERT INTO pk VALUES (1, 'a'), (2, 'b');

statement ok
BEGIN;

statement ok
INSERT INTO pk VALUES (3, 'c'), (4, 'd');

statement ok
SET debug_force_flush_append_failure = true;

statement error
COMMIT;
----
Forced flush append failure

statement ok
SET debug_force_flush_append_failure = false;

query II
SELECT count(*), max(k) FROM pk;
----
2	2

# The reverted keys must not remain in the index.
statement ok
INSERT INTO pk VALUES (3, 'c2'), (4, 'd2');

statement error
INSERT INTO pk VALUES (3, 'dup');
----
violates primary key constraint

statement ok
CHECKPOINT;

query II
SELECT count(*), max(k) FROM pk;
----
4	4

# Merge path: appends to an empty in-memory table are merged directly. The merge consumes the
# transaction-local rows, so a failure on this path cannot be reverted and invalidates the
# database. This must remain the last scenario in this file.

statement ok
CREATE TABLE m (k INTEGER PRIMARY KEY, v VARCHAR);

statement ok
BEGIN;

statement ok
INSERT INTO m VALUES (1, 'a'), (2, 'b');

statement ok
SET debug_force_flush_append_failure = true;

statement error
COMMIT;
----
Failed to flush table

statement error
SELECT count(*) FROM pk;
----
<REGEX>:.*invalidated.*
