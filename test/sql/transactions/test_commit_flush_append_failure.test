# name: test/sql/transactions/test_commit_flush_append_failure.test
# description: A failure of the commit-time table append reverts the table and index appends
# group: [transactions]

require no_force_storage

# Copy path: appends to a non-empty table are copied row by row at commit.

statement ok
CREATE TABLE pk (k INTEGER PRIMARY KEY, v VARCHAR);

statement ok
INSERT INTO pk VALUES (1, 'a'), (2, 'b');

statement ok
BEGIN;

statement ok
INSERT INTO pk VALUES (3, 'c'), (4, 'd');

statement ok
SET debug_force_flush_append_failure = true;

statement error
COMMIT;
----
Forced flush append failure

statement ok
SET debug_force_flush_append_failure = false;

query II
SELECT count(*), max(k) FROM pk;
----
2	2

# The reverted keys must not remain in the index.
statement ok
INSERT INTO pk VALUES (3, 'c2'), (4, 'd2');

statement error
INSERT INTO pk VALUES (3, 'dup');
----
violates primary key constraint

# Merge path: appends to an empty in-memory table are merged directly.

statement ok
CREATE TABLE m (k INTEGER PRIMARY KEY, v VARCHAR);

statement ok
BEGIN;

statement ok
INSERT INTO m VALUES (1, 'a'), (2, 'b');

statement ok
SET debug_force_flush_append_failure = true;

statement error
COMMIT;
----
Forced flush append failure

statement ok
SET debug_force_flush_append_failure = false;

query I
SELECT count(*) FROM m;
----
0

statement ok
INSERT INTO m VALUES (1, 'a'), (2, 'b');

# Merge path: a bulk append of at least one full row group is also merged directly.

statement ok
BEGIN;

statement ok
INSERT INTO m SELECT i, 'x' FROM range(3, 130003) r(i);

statement ok
SET debug_force_flush_append_failure = true;

statement error
COMMIT;
----
Forced flush append failure

statement ok
SET debug_force_flush_append_failure = false;

query I
SELECT count(*) FROM m;
----
2

# All bulk keys must be insertable again.
statement ok
INSERT INTO m SELECT i, 'x' FROM range(3, 130003) r(i);

query II
SELECT count(*), count(DISTINCT k) FROM m;
----
130002	130002

statement error
INSERT INTO m VALUES (1500, 'dup');
----
violates primary key constraint

statement ok
CHECKPOINT;

query I
SELECT count(*) FROM m;
----
130002
