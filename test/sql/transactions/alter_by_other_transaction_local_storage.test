# name: test/sql/transactions/alter_by_other_transaction_local_storage.test
# description: A transaction with local changes keeps using its version of a table that another transaction altered
# group: [transactions]

statement ok
CREATE TABLE t(i INTEGER, j INTEGER);

statement ok con2
BEGIN TRANSACTION

statement ok con2
INSERT INTO t VALUES (1, 1)

statement ok con1
BEGIN TRANSACTION

statement ok con1
ALTER TABLE t ADD COLUMN k INTEGER

query II con2
SELECT * FROM t
----
1	1

statement error con2
INSERT INTO t VALUES (2, 2)
----
<REGEX>:.*Transaction conflict.*altered by a different transaction.*

statement ok con1
COMMIT

statement ok con2
ROLLBACK
