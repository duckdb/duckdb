# name: test/sql/transactions/test_update_null_conflict.test
# description: Concurrent updates of the same row conflict when one of them sets the value to NULL
# group: [transactions]

statement ok
SET immediate_transaction_mode=true

statement ok
CREATE TABLE t(id INTEGER, i INTEGER, s VARCHAR, j INTEGER);

statement ok
INSERT INTO t VALUES (1, 3, 'three', 0), (2, 4, 'four', 0);

# a value update followed by a NULL update of the same row
statement ok con1
BEGIN

statement ok con1
UPDATE t SET i = 5 WHERE id = 1

statement ok con2
BEGIN

statement error con2
UPDATE t SET i = NULL, j = i WHERE id = 1
----
Conflict on update

statement ok con2
ROLLBACK

statement ok con1
COMMIT

query IIII
SELECT * FROM t ORDER BY id
----
1	5	three	0
2	4	four	0

# the same for strings
statement ok con1
BEGIN

statement ok con1
UPDATE t SET s = 'five' WHERE id = 1

statement ok con2
BEGIN

statement error con2
UPDATE t SET s = NULL WHERE id = 1
----
Conflict on update

statement ok con2
ROLLBACK

statement ok con1
COMMIT

# a NULL update followed by a value update of the same row
statement ok con1
BEGIN

statement ok con1
UPDATE t SET i = NULL WHERE id = 2

statement ok con2
BEGIN

statement error con2
UPDATE t SET i = 6 WHERE id = 2
----
Conflict on update

statement ok con2
ROLLBACK

statement ok con1
COMMIT

query IIII
SELECT * FROM t ORDER BY id
----
1	5	five	0
2	NULL	four	0

# a NULL update of another row does not conflict
statement ok con1
BEGIN

statement ok con1
UPDATE t SET i = 7 WHERE id = 1

statement ok con2
BEGIN

statement ok con2
UPDATE t SET i = NULL WHERE id = 2

statement ok con1
COMMIT

statement ok con2
COMMIT

# a NULL update after a value update that committed after the transaction started
statement ok con1
BEGIN

statement ok con2
BEGIN

statement ok con1
UPDATE t SET i = 10 WHERE id = 1

statement ok con1
COMMIT

statement error con2
UPDATE t SET i = NULL WHERE id = 1
----
Conflict on update

statement ok con2
ROLLBACK

# a NULL update after a committed value update does not conflict
statement ok con1
UPDATE t SET i = 8 WHERE id = 1

statement ok con2
UPDATE t SET i = NULL WHERE id = 1

query IIII
SELECT * FROM t ORDER BY id
----
1	NULL	five	0
2	NULL	four	0

# a transaction sets its own update to NULL
statement ok con1
BEGIN

statement ok con1
UPDATE t SET i = 9 WHERE id = 1

statement ok con1
UPDATE t SET i = NULL WHERE id = 1

statement ok con1
COMMIT

query IIII
SELECT * FROM t ORDER BY id
----
1	NULL	five	0
2	NULL	four	0

# an update that sets only some of the rows to NULL, in the second vector
statement ok
CREATE TABLE big AS SELECT i AS id, i AS v FROM range(5000) r(i);

statement ok con1
BEGIN

statement ok con1
UPDATE big SET v = -1 WHERE id = 4000

statement ok con2
BEGIN

statement error con2
UPDATE big SET v = CASE WHEN id % 2 = 0 THEN NULL ELSE v + 1 END WHERE id >= 3000
----
Conflict on update

statement ok con2
ROLLBACK

statement ok con1
COMMIT

query III
SELECT count(*), count(v), sum(v) FROM big
----
5000	5000	12493499

# a struct field set to NULL
statement ok
CREATE TABLE st(id INTEGER, s STRUCT(a INTEGER, b VARCHAR));

statement ok
INSERT INTO st VALUES (1, {'a': 1, 'b': 'one'}), (2, {'a': 1, 'b': 'one'});

statement ok con1
BEGIN

statement ok con1
UPDATE st SET s = {'a': 2, 'b': 'one'} WHERE id = 1

statement ok con2
BEGIN

statement error con2
UPDATE st SET s = {'a': NULL, 'b': 'one'} WHERE id = 1
----
Conflict on update

statement ok con2
ROLLBACK

statement ok con1
COMMIT

# a struct set to NULL
statement ok con1
BEGIN

statement ok con1
UPDATE st SET s = {'a': 2, 'b': 'one'} WHERE id = 2

statement ok con2
BEGIN

statement error con2
UPDATE st SET s = NULL WHERE id = 2
----
Conflict on update

statement ok con2
ROLLBACK

statement ok con1
COMMIT

query II
SELECT * FROM st ORDER BY id
----
1	{'a': 2, 'b': one}
2	{'a': 2, 'b': one}
