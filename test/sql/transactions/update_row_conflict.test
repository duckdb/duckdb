# name: test/sql/transactions/update_row_conflict.test
# description: Concurrent writes of the same row conflict, whichever columns they change
# group: [transactions]

require vector_size 2048

# appends continue the last row group
statement ok
SET debug_skip_checkpoint_on_commit = true;

statement ok
CREATE TABLE t1 (id INTEGER, a INTEGER, b INTEGER);

statement ok
INSERT INTO t1 SELECT i, 0, 0 FROM range(4) t(i);

# updates of different columns of the same row
statement ok con1
BEGIN

statement ok con2
BEGIN

statement ok con1
UPDATE t1 SET a = 1 WHERE id = 1

statement error con2
UPDATE t1 SET b = 2 WHERE id = 1
----
Conflict on update

statement ok con2
ROLLBACK

# a different row of the same vector does not conflict
statement ok con2
UPDATE t1 SET b = 2 WHERE id = 2

statement ok con1
COMMIT

# a stale snapshot conflicts with the committed update of another column
statement ok con2
BEGIN

query III con2
SELECT * FROM t1 WHERE id = 3
----
3	0	0

statement ok con1
UPDATE t1 SET a = 3 WHERE id = 3

statement error con2
UPDATE t1 SET b = 3 WHERE id = 3
----
Conflict on update

statement ok con2
ROLLBACK

# an update that leaves the values unchanged writes the row as well
statement ok con1
BEGIN

statement ok con1
UPDATE t1 SET a = a WHERE id = 0

statement error con2
DELETE FROM t1 WHERE id = 0
----
Conflict on tuple deletion

statement ok con1
ROLLBACK

query III
SELECT * FROM t1 ORDER BY id
----
0	0	0
1	1	0
2	0	2
3	3	0

# a rollback restores the previous update of the row, which an older snapshot still does not see
statement ok
CREATE TABLE t2 (id INTEGER, a INTEGER, b INTEGER);

statement ok
INSERT INTO t2 SELECT i, 0, 0 FROM range(10) t(i);

statement ok con3
BEGIN

query I con3
SELECT count(*) FROM t2
----
10

statement ok con1
UPDATE t2 SET a = 1 WHERE id = 7

statement ok con2
BEGIN

statement ok con2
UPDATE t2 SET a = 2 WHERE id = 7

statement ok con2
ROLLBACK

statement error con3
UPDATE t2 SET b = 3 WHERE id = 7
----
Conflict on update

statement ok con3
ROLLBACK

# the same when updates mark all rows of the vector at once
statement ok
CREATE TABLE t2b (id INTEGER, a INTEGER, b INTEGER);

statement ok
INSERT INTO t2b SELECT i, 0, 0 FROM range(10) t(i);

statement ok con3
BEGIN

query I con3
SELECT count(*) FROM t2b
----
10

statement ok con1
UPDATE t2b SET a = a + 1

statement ok con2
BEGIN

statement ok con2
UPDATE t2b SET a = a + 1

statement ok con2
ROLLBACK

statement error con3
DELETE FROM t2b WHERE id = 3
----
Conflict on tuple deletion

statement ok con3
ROLLBACK

query II
SELECT sum(a), sum(b) FROM t2b
----
10	0

# an update of all rows of a vector does not mark the rows appended to it later
statement ok
CREATE TABLE t3 (id INTEGER, a INTEGER);

statement ok
INSERT INTO t3 SELECT i, 0 FROM range(100) t(i);

statement ok con1
BEGIN

statement ok con1
UPDATE t3 SET a = 1

statement ok con2
INSERT INTO t3 VALUES (100, 0)

statement ok con2
DELETE FROM t3 WHERE id = 100

statement error con2
DELETE FROM t3 WHERE id = 50
----
Conflict on tuple deletion

statement ok con1
COMMIT

query II
SELECT count(*), sum(a) FROM t3
----
100	100

# an update of all rows, then of some rows again within the same transaction, commits and rolls back as one
statement ok
CREATE TABLE t4 AS SELECT i AS id, 0 AS a FROM range(5000) t(i);

statement ok con3
BEGIN

query I con3
SELECT count(*) FROM t4
----
5000

statement ok con4
BEGIN

query I con4
SELECT count(*) FROM t4
----
5000

statement ok con1
BEGIN

statement ok con1
UPDATE t4 SET a = 1

statement ok con1
UPDATE t4 SET a = 2 WHERE id % 3 = 0

statement ok con1
ROLLBACK

statement ok con1
BEGIN

statement ok con1
UPDATE t4 SET a = 1

statement ok con1
UPDATE t4 SET a = 2 WHERE id % 3 = 0

statement ok con1
COMMIT

# rows in every vector, including the partial last one, conflict for the older snapshot
statement error con3
DELETE FROM t4 WHERE id = 4999
----
Conflict on tuple deletion

statement ok con3
ROLLBACK

statement error con4
UPDATE t4 SET a = 3 WHERE id = 10
----
Conflict on update

statement ok con4
ROLLBACK

query III
SELECT count(*), count(*) FILTER (a = 1), count(*) FILTER (a = 2) FROM t4
----
5000	3333	1667

# once every transaction sees the updates, writes of the rows no longer conflict
statement ok
UPDATE t4 SET a = 0 WHERE id % 2 = 0

statement ok
DELETE FROM t4 WHERE id % 4 = 1

query I
SELECT count(*) FROM t4
----
3750

# rolled back writers are forgotten while another transaction keeps updating the row group
statement ok
CREATE TABLE t5 AS SELECT i AS id, 0 AS a FROM range(100) t(i);

statement ok con3
BEGIN

statement ok con3
UPDATE t5 SET a = 1 WHERE id = 0

loop i 0 100

statement ok con1
BEGIN

statement ok con1
UPDATE t5 SET a = 2 WHERE id = 1

statement ok con1
ROLLBACK

endloop

statement error con2
UPDATE t5 SET a = 3 WHERE id = 0
----
Conflict on update

statement ok con2
UPDATE t5 SET a = 3 WHERE id = 1

statement ok con3
COMMIT

query II
SELECT id, a FROM t5 WHERE id < 2 ORDER BY id
----
0	1
1	3

# a rolled back writer that updated the row twice falls back to the row's earlier writer as well
statement ok
CREATE TABLE t6 AS SELECT i AS id, 0 AS a FROM range(10) t(i);

statement ok con3
BEGIN

query I con3
SELECT count(*) FROM t6
----
10

statement ok con1
UPDATE t6 SET a = 1 WHERE id = 7

statement ok con2
BEGIN

statement ok con2
UPDATE t6 SET a = 2 WHERE id = 7

statement ok con2
UPDATE t6 SET a = 3 WHERE id = 7

statement ok con2
ROLLBACK

statement error con3
UPDATE t6 SET a = 4 WHERE id = 7
----
Conflict on update

statement ok con3
ROLLBACK

# the same when another transaction updates the vector before the writer rolls back
statement ok con3
BEGIN

query I con3
SELECT count(*) FROM t6
----
10

statement ok con1
UPDATE t6 SET a = 5 WHERE id = 7

statement ok con2
BEGIN

statement ok con2
UPDATE t6 SET a = 6 WHERE id = 7

statement ok con1
UPDATE t6 SET a = 7 WHERE id = 8

statement ok con2
ROLLBACK

statement error con3
UPDATE t6 SET a = 8 WHERE id = 7
----
Conflict on update

statement ok con3
ROLLBACK

query II
SELECT id, a FROM t6 WHERE id >= 7 ORDER BY id
----
7	5
8	7
9	0

# a rolled back delete of rows that the transaction updated falls back to the rows' earlier writers as well
statement ok
CREATE TABLE t7 AS SELECT i AS id, 0 AS a FROM range(10) t(i);

statement ok con3
BEGIN

query I con3
SELECT count(*) FROM t7
----
10

statement ok con1
UPDATE t7 SET a = 1 WHERE id = 7

statement ok con2
BEGIN

statement ok con2
UPDATE t7 SET a = 2 WHERE id IN (3, 5, 7)

statement ok con2
DELETE FROM t7 WHERE id IN (3, 5, 7)

statement ok con2
ROLLBACK

statement ok con3
DELETE FROM t7 WHERE id = 5

statement error con3
DELETE FROM t7 WHERE id = 7
----
Conflict on tuple deletion

statement ok con3
ROLLBACK

query I
UPDATE t7 SET a = 3 WHERE id IN (3, 5, 7)
----
3

query II
SELECT id, a FROM t7 WHERE id IN (3, 5, 7) ORDER BY id
----
3	3
5	3
7	3

# a failed commit leaves no writer of the rows behind
statement ok con3
BEGIN

query I con3
SELECT count(*) FROM t6
----
10

statement ok
SET debug_force_commit_failure = true;

statement ok con2
BEGIN

statement ok con2
UPDATE t6 SET a = 9 WHERE id = 4

statement error con2
COMMIT
----
Forced commit failure

statement ok
SET debug_force_commit_failure = false;

statement ok con3
UPDATE t6 SET a = 10 WHERE id = 4

statement ok con3
COMMIT

query II
SELECT id, a FROM t6 WHERE id = 4
----
4	10
