# name: test/sql/transactions/update_marker_deleted_rows.test
# description: An update of all rows of a vector that are not deleted keeps the deleted rows in the vector's mask
# group: [transactions]

require vector_size 2048

load {TEST_DIR}/update_marker_deleted_rows.db

statement ok
SET debug_skip_checkpoint_on_commit = true;

# deletes loaded from disk: each vector holds them in its mask
statement ok
CREATE TABLE t1 AS SELECT i AS id, 0 AS a FROM range(4096) t(i);

statement ok
DELETE FROM t1 WHERE id % 10 = 0;

statement ok
CHECKPOINT;

restart

statement ok con1
BEGIN

query II con1
SELECT COUNT(*), SUM(a) FROM t1
----
3686	0

statement ok
UPDATE t1 SET a = 1;

query II
SELECT COUNT(*), SUM(a) FROM t1
----
3686	3686

# an older snapshot still reads the old values and conflicts with the update
query II con1
SELECT COUNT(*), SUM(a) FROM t1
----
3686	0

statement error con1
UPDATE t1 SET a = 2 WHERE id = 1
----
Conflict on update

statement ok con1
ROLLBACK

# a rolled back update of all rows that are not deleted
statement ok
BEGIN

statement ok
UPDATE t1 SET a = 5;

statement ok
ROLLBACK

query II
SELECT COUNT(*), SUM(a) FROM t1
----
3686	3686

statement ok
UPDATE t1 SET a = 2 WHERE id = 1;

statement ok
DELETE FROM t1 WHERE id = 2;

query II
SELECT COUNT(*), SUM(a) FROM t1
----
3685	3686

statement ok
CHECKPOINT;

restart

query II
SELECT COUNT(*), SUM(a) FROM t1
----
3685	3686

# the mask holds the uncommitted deletes of another transaction, as many rows as the update writes
statement ok
CREATE TABLE t2 AS SELECT i AS id, 0 AS a FROM range(2048) t(i);

statement ok con2
BEGIN

statement ok con2
DELETE FROM t2 WHERE id % 2 = 0

statement ok
UPDATE t2 SET a = 1 WHERE id % 2 = 1;

statement ok con2
ROLLBACK

query II
SELECT COUNT(*), SUM(a) FROM t2
----
2048	1024

statement ok
UPDATE t2 SET a = 2 WHERE id = 0;

statement ok
UPDATE t2 SET a = 2 WHERE id = 1;

query II
SELECT COUNT(*), SUM(a) FROM t2
----
2048	1027

# the same, but the deletes commit
statement ok
CREATE TABLE t3 AS SELECT i AS id, 0 AS a FROM range(2048) t(i);

statement ok con2
BEGIN

statement ok con2
DELETE FROM t3 WHERE id % 2 = 0

statement ok
UPDATE t3 SET a = 1 WHERE id % 2 = 1;

statement ok con2
COMMIT

query II
SELECT COUNT(*), SUM(a) FROM t3
----
1024	1024

statement ok
UPDATE t3 SET a = 2 WHERE id = 1;

query II
SELECT COUNT(*), SUM(a) FROM t3
----
1024	1025

# one transaction deletes rows of a vector and then updates all others, rolled back and committed
statement ok
CREATE TABLE t4 AS SELECT i AS id, 0 AS a FROM range(2048) t(i);

statement ok
BEGIN

statement ok
DELETE FROM t4 WHERE id % 3 = 0;

statement ok
UPDATE t4 SET a = 1;

query II
SELECT COUNT(*), SUM(a) FROM t4
----
1365	1365

statement ok
ROLLBACK

query II
SELECT COUNT(*), SUM(a) FROM t4
----
2048	0

statement ok
BEGIN

statement ok
DELETE FROM t4 WHERE id % 3 = 0;

statement ok
UPDATE t4 SET a = 1;

statement ok
COMMIT

query II
SELECT COUNT(*), SUM(a) FROM t4
----
1365	1365

statement ok
UPDATE t4 SET a = 2 WHERE id = 1;

query II
SELECT COUNT(*), SUM(a) FROM t4
----
1365	1366

# one transaction updates all rows that are not deleted and then deletes some of them, rolled back and committed
statement ok
CREATE TABLE t5 AS SELECT i AS id, 0 AS a FROM range(2048) t(i);

statement ok
DELETE FROM t5 WHERE id % 3 = 0;

statement ok
CHECKPOINT;

restart

statement ok
BEGIN

statement ok
UPDATE t5 SET a = 1;

statement ok
DELETE FROM t5 WHERE id % 3 = 1;

query II
SELECT COUNT(*), SUM(a) FROM t5
----
682	682

statement ok
ROLLBACK

query II
SELECT COUNT(*), SUM(a) FROM t5
----
1365	0

statement ok
BEGIN

statement ok
UPDATE t5 SET a = 1;

statement ok
DELETE FROM t5 WHERE id % 3 = 1;

statement ok
COMMIT

query II
SELECT COUNT(*), SUM(a) FROM t5
----
682	682

statement ok
CHECKPOINT;

restart

query II
SELECT COUNT(*), SUM(a) FROM t5
----
682	682
