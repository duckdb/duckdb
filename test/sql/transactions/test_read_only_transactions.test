# name: test/sql/transactions/test_read_only_transactions.test
# description: Test read only transactions
# group: [transactions]

statement ok
CREATE TABLE a(i INTEGER)

statement ok
INSERT INTO a VALUES (42)

statement ok
BEGIN TRANSACTION READ ONLY

# we can read from the database
query I
SELECT * FROM a
----
42

# we cannot modify the database in a read-only transaction
statement error
INSERT INTO a VALUES (48)
----
transaction is launched in read-only mode

statement ok
COMMIT

statement ok
CREATE SEQUENCE read_only_sequence

query I
SELECT nextval('read_only_sequence')
----
1

statement ok
PREPARE read_value AS SELECT $1

statement ok
BEGIN TRANSACTION READ ONLY

# Scalar expressions evaluated during binding must also respect the transaction's write restrictions.
statement error
EXECUTE read_value(nextval('read_only_sequence'))
----
transaction is launched in read-only mode

statement ok
ROLLBACK

statement ok
BEGIN TRANSACTION READ ONLY

statement error
SELECT * FROM range(nextval('read_only_sequence'))
----
transaction is launched in read-only mode

statement ok
ROLLBACK

query I
SELECT currval('read_only_sequence')
----
1
