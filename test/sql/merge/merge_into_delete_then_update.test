# name: test/sql/merge/merge_into_delete_then_update.test
# description: Test MERGE INTO updating a target row that another action of the same MERGE deleted
# group: [merge]

statement ok
CREATE TABLE src AS SELECT * FROM (VALUES (5, 1), (5, 2)) v(id, k);

# updating the primary key deletes the row and inserts it again, fetching the old row for the index
statement ok
CREATE TABLE pk(id INTEGER PRIMARY KEY, a INTEGER);

statement ok
INSERT INTO pk SELECT i, 0 FROM range(10) r(i);

statement error
MERGE INTO pk USING src ON pk.id = src.id
WHEN MATCHED AND src.k = 1 THEN UPDATE SET id = 100
WHEN MATCHED THEN UPDATE SET id = 200;
----
Conflict on update

query III
SELECT count(*), max(id), sum(a) FROM pk
----
10	9	0

# updating a list column deletes the row and inserts it again, without fetching it
statement ok
CREATE TABLE lt AS SELECT i id, [0] l FROM range(10) r(i);

statement error
MERGE INTO lt USING src ON lt.id = src.id
WHEN MATCHED AND src.k = 1 THEN UPDATE SET l = [1]
WHEN MATCHED THEN UPDATE SET l = [2];
----
Conflict on update

query II
SELECT count(*), count(*) FILTER (WHERE l = [0]) FROM lt
----
10	10

# the two source rows of a target row are in different row groups
statement ok
CREATE TABLE big(id INTEGER PRIMARY KEY, a INTEGER);

statement ok
INSERT INTO big SELECT i, 0 FROM range(130000) r(i);

statement error
MERGE INTO big USING (SELECT i % 130000 id, i // 130000 k FROM range(260000) r(i)) s ON big.id = s.id
WHEN MATCHED AND s.k = 0 THEN UPDATE SET id = big.id + 1000000
WHEN MATCHED THEN UPDATE SET id = big.id + 2000000;
----
Conflict on update

# target rows that the transaction inserted itself
statement ok
BEGIN

statement ok
INSERT INTO pk SELECT i, 0 FROM range(10, 20) r(i);

statement error
MERGE INTO pk USING (SELECT 12 id, i k FROM range(2) r(i)) s ON pk.id = s.id
WHEN MATCHED AND s.k = 0 THEN UPDATE SET id = 100
WHEN MATCHED THEN UPDATE SET id = 200;
----
Conflict on update

statement ok
ROLLBACK

statement ok
BEGIN

statement ok
INSERT INTO lt SELECT i, [0] FROM range(10, 20) r(i);

statement error
MERGE INTO lt USING (SELECT 12 id, i k FROM range(2) r(i)) s ON lt.id = s.id
WHEN MATCHED AND s.k = 0 THEN UPDATE SET l = [1]
WHEN MATCHED THEN UPDATE SET l = [2];
----
Conflict on update

statement ok
ROLLBACK

# a row updated by an earlier statement of the transaction can be deleted and inserted again
statement ok
BEGIN

statement ok
UPDATE pk SET a = 9 WHERE id = 5

query I
MERGE INTO pk USING src ON pk.id = src.id
WHEN MATCHED AND src.k = 1 THEN UPDATE SET id = 100;
----
1

query III
SELECT count(*), max(id), sum(a) FROM pk
----
10	100	9

statement ok
ROLLBACK

# a DELETE and an in-place UPDATE of the same row conflict only if the delete runs first, otherwise the delete wins
statement ok
CREATE TABLE t AS SELECT i id, 0 a FROM range(10) r(i);

statement ok
BEGIN

statement maybe
MERGE INTO t USING src ON t.id = src.id
WHEN MATCHED AND src.k = 1 THEN DELETE
WHEN MATCHED THEN UPDATE SET a = src.k;
----
Conflict on update

statement ok
ROLLBACK

query II
SELECT count(*), sum(a) FROM t
----
10	0
