# name: test/sql/merge/merge_into_delete_then_update.test
# description: Test MERGE INTO where several WHEN MATCHED actions modify the same target row
# group: [merge]

statement ok
CREATE TABLE t AS SELECT i id, 0 a FROM range(10) r(i);

statement ok
CREATE TABLE src AS SELECT * FROM (VALUES (5, 1), (5, 2)) v(id, k);

# an in-place update of a row that a DELETE action of the same MERGE removed
statement error
MERGE INTO t USING src ON t.id = src.id
WHEN MATCHED AND src.k = 1 THEN DELETE
WHEN MATCHED THEN UPDATE SET a = src.k;
----
Cannot update a row that the same statement already deleted

# the MERGE is rolled back and the database stays usable
query II
SELECT count(*), sum(a) FROM t
----
10	0

statement error
MERGE INTO t USING src ON t.id = src.id
WHEN MATCHED AND src.k = 2 THEN DELETE
WHEN MATCHED THEN UPDATE SET a = src.k;
----
Cannot update a row that the same statement already deleted

query II
SELECT count(*), sum(a) FROM t
----
10	0

# an update that lands before the delete of the same row is not detected: the delete wins
statement ok
BEGIN

query I
MERGE INTO t USING src ON t.id = src.id
WHEN MATCHED AND src.k = 2 THEN UPDATE SET a = src.k
WHEN MATCHED THEN DELETE;
----
2

query II
SELECT count(*), sum(a) FROM t
----
9	0

statement ok
ROLLBACK

# deleting a row twice, or updating it twice, does not conflict
statement ok
BEGIN

query I
MERGE INTO t USING src ON t.id = src.id
WHEN MATCHED AND src.k = 1 THEN DELETE
WHEN MATCHED THEN DELETE;
----
2

query I
SELECT count(*) FROM t
----
9

query I
MERGE INTO t USING (SELECT 6 id, i k FROM range(2) r(i)) s ON t.id = s.id
WHEN MATCHED AND s.k = 0 THEN UPDATE SET a = 10
WHEN MATCHED THEN UPDATE SET a = 20;
----
2

query I
SELECT a IN (10, 20) FROM t WHERE id = 6
----
true

statement ok
ROLLBACK

# DO NOTHING does not modify the target row
query I
MERGE INTO t USING src ON t.id = src.id
WHEN MATCHED AND src.k = 1 THEN DO NOTHING
WHEN MATCHED THEN UPDATE SET a = src.k;
----
1

# a single action can match a target row several times
query I
MERGE INTO t USING src ON t.id = src.id
WHEN MATCHED THEN UPDATE SET a = 3;
----
2

# updating the primary key deletes the row and inserts it again
statement ok
CREATE TABLE pk(id INTEGER PRIMARY KEY, a INTEGER);

statement ok
INSERT INTO pk SELECT i, 0 FROM range(10) r(i);

statement error
MERGE INTO pk USING src ON pk.id = src.id
WHEN MATCHED AND src.k = 1 THEN DELETE
WHEN MATCHED THEN UPDATE SET id = 100;
----
Cannot update a row that the same statement already deleted

statement error
MERGE INTO pk USING src ON pk.id = src.id
WHEN MATCHED AND src.k = 1 THEN UPDATE SET id = 100
WHEN MATCHED THEN UPDATE SET a = src.k;
----
Cannot update a row that the same statement already deleted

query III
SELECT count(*), max(id), sum(a) FROM pk
----
10	9	0

# updating a list column deletes the row and inserts it again, without fetching it
statement ok
CREATE TABLE lt AS SELECT i id, [0] l FROM range(10) r(i);

statement error
MERGE INTO lt USING src ON lt.id = src.id
WHEN MATCHED AND src.k = 1 THEN DELETE
WHEN MATCHED THEN UPDATE SET l = [src.k];
----
Cannot update a row that the same statement already deleted

query II
SELECT count(*), count(*) FILTER (WHERE id = 5) FROM lt
----
10	1

# target rows spanning several row groups
statement ok
CREATE TABLE big AS SELECT i id, 0 a FROM range(300000) r(i);

query I
MERGE INTO big USING (SELECT i id FROM range(300000) r(i) WHERE i % 3 = 0) s ON big.id = s.id
WHEN MATCHED AND s.id % 2 = 0 THEN UPDATE SET a = 1
WHEN MATCHED THEN UPDATE SET a = 1;
----
100000

# the two source rows of a target row are far apart
statement error
MERGE INTO big USING (SELECT i % 150000 id, i // 150000 k FROM range(300000) r(i)) s ON big.id = s.id
WHEN MATCHED AND s.k = 0 THEN DELETE
WHEN MATCHED THEN UPDATE SET a = 2;
----
Cannot update a row that the same statement already deleted

query II
SELECT count(*), sum(a) FROM big
----
300000	100000

# the error aborts an explicit transaction
statement ok
BEGIN

statement error
MERGE INTO t USING src ON t.id = src.id
WHEN MATCHED AND src.k = 1 THEN DELETE
WHEN MATCHED THEN UPDATE SET a = src.k;
----
Cannot update a row that the same statement already deleted

statement error
SELECT count(*) FROM t
----
transaction is aborted

statement ok
ROLLBACK

# a row updated by an earlier statement of the transaction can be deleted or updated again
statement ok
BEGIN

statement ok
UPDATE t SET a = 9 WHERE id = 5

query I
MERGE INTO t USING src ON t.id = src.id
WHEN MATCHED AND src.k = 1 THEN DELETE;
----
1

query I
SELECT count(*) FROM t WHERE id = 5
----
0

statement ok
UPDATE pk SET a = 9 WHERE id = 5

query I
MERGE INTO pk USING src ON pk.id = src.id
WHEN MATCHED AND src.k = 1 THEN UPDATE SET id = 100;
----
1

query III
SELECT count(*), max(id), sum(a) FROM pk
----
10	100	9

statement ok
ROLLBACK

# a row deleted by an earlier statement of the transaction is not matched
statement ok
BEGIN

statement ok
DELETE FROM t WHERE id = 5

query I
MERGE INTO t USING src ON t.id = src.id
WHEN MATCHED AND src.k = 1 THEN DELETE
WHEN MATCHED THEN UPDATE SET a = src.k;
----
0

statement ok
ROLLBACK

# target rows that the transaction inserted itself
statement ok
BEGIN

statement ok
INSERT INTO pk SELECT i, 0 FROM range(10, 20) r(i);

statement error
MERGE INTO pk USING (SELECT 12 id, i k FROM range(2) r(i)) s ON pk.id = s.id
WHEN MATCHED AND s.k = 0 THEN DELETE
WHEN MATCHED THEN UPDATE SET id = 100;
----
Cannot update a row that the same statement already deleted

statement ok
ROLLBACK

statement ok
BEGIN

statement ok
INSERT INTO lt SELECT i, [0] FROM range(10, 20) r(i);

statement error
MERGE INTO lt USING (SELECT 12 id, i k FROM range(2) r(i)) s ON lt.id = s.id
WHEN MATCHED AND s.k = 0 THEN DELETE
WHEN MATCHED THEN UPDATE SET l = [s.k];
----
Cannot update a row that the same statement already deleted

statement ok
ROLLBACK

# an in-place update of a transaction-local row that the MERGE deleted is skipped
statement ok
BEGIN

statement ok
INSERT INTO t SELECT i, 0 FROM range(10, 20) r(i);

query I
MERGE INTO t USING (SELECT 12 id, i k FROM range(2) r(i)) s ON t.id = s.id
WHEN MATCHED AND s.k = 0 THEN DELETE
WHEN MATCHED THEN UPDATE SET a = 4;
----
2

query II
SELECT count(*), sum(a) FROM t
----
19	3

statement ok
ROLLBACK
