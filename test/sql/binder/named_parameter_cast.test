# name: test/sql/binder/named_parameter_cast.test
# description: A named table function parameter reaches its parameter by an implicit cast, extension casts included
# group: [binder]

require icu

statement ok
SET TimeZone='America/Los_Angeles';

statement ok
COPY (SELECT 42 AS a) TO '__TEST_DIR__/named_parameter_cast.csv' (HEADER false);

# -----------------------------------------------------------------------------
# A named argument is matched to its parameter the same way a positional one is: by an implicit cast. There is no
# implicit cast from TIMESTAMPTZ to VARCHAR, so this is refused rather than silently stringified.
#

statement error
SELECT column_name FROM (DESCRIBE SELECT * FROM read_csv('__TEST_DIR__/named_parameter_cast.csv', names => [TIMESTAMPTZ '2024-01-01 12:00:00+00']));
----
<REGEX>:.*No function matches.*"names" := TIMESTAMP WITH TIME ZONE\[\].*

# -----------------------------------------------------------------------------
# Spelling the cast out reaches ICU's TIMESTAMPTZ -> VARCHAR cast, which prints in the session time zone
#

query I
SELECT column_name FROM (DESCRIBE SELECT * FROM read_csv('__TEST_DIR__/named_parameter_cast.csv', names => [TIMESTAMPTZ '2024-01-01 12:00:00+00'::VARCHAR]));
----
2024-01-01 04:00:00-08
