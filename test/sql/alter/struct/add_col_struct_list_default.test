# name: test/sql/alter/struct/add_col_struct_list_default.test
# description: Adding a LIST or MAP field to a struct with a struct as its DEFAULT is rejected
# group: [struct]

# ALTER TABLE passes the DEFAULT of the new field to remap_struct, where {list: ...} and {key: ..., value: ...}
# are defaults for the children of a list or map that has a source
statement ok
CREATE TABLE tbl AS SELECT i AS id, {a: i} AS s FROM range(1, 4) t(i);

statement error
ALTER TABLE tbl ADD COLUMN s.l INT[] DEFAULT {list: 1};
----
<REGEX>:Binder Error:.*Default value for l is a struct.*'INTEGER\[\]' is not mapped to a source.*

statement error
ALTER TABLE tbl ADD COLUMN s.m MAP(INT, INT) DEFAULT {key: 1, value: 2};
----
<REGEX>:Binder Error:.*Default value for m is a struct.*'MAP\(INTEGER, INTEGER\)' is not mapped to a source.*

# the table is unchanged
query II
SELECT id, s FROM tbl ORDER BY id;
----
1	{'a': 1}
2	{'a': 2}
3	{'a': 3}

# this succeeded on an empty table, where the scan produces no struct to fill
statement ok
CREATE TABLE empty_tbl (s STRUCT(a INT));

statement error
ALTER TABLE empty_tbl ADD COLUMN s.l INT[] DEFAULT {list: 1};
----
<REGEX>:Binder Error:.*Default value for l is a struct.*not mapped to a source.*
