# name: test/sql/alter/add_col/test_add_col_distinct_stats.test
# description: ADD COLUMN must build the distinct count statistics of the new column
# group: [add_col]

statement ok
CREATE TABLE t AS SELECT range AS i FROM range(100000);

statement ok
CREATE SEQUENCE seq;

# IF NOT EXISTS fills the column with the default directly instead of through an UPDATE
# 2000 distinct values in a scrambled order (7919 is coprime with 2000), using only built-in functions
# because the default expression is replayed from the WAL before extensions are loaded
statement ok
ALTER TABLE t ADD COLUMN IF NOT EXISTS u VARCHAR DEFAULT (nextval('seq') * 7919 % 2000)::VARCHAR;

query I
SELECT s.approx_unique BETWEEN 1000 AND 10000 FROM (SELECT stats(u) s FROM t LIMIT 1);
----
true

# appended rows must extend the distinct count instead of replacing it
statement ok
INSERT INTO t SELECT 100000 + range, (nextval('seq') * 7919 % 2000)::VARCHAR FROM range(10);

query I
SELECT s.approx_unique BETWEEN 1000 AND 10000 FROM (SELECT stats(u) s FROM t LIMIT 1);
----
true
