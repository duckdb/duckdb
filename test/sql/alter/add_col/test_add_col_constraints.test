# name: test/sql/alter/add_col/test_add_col_constraints.test
# description: Test unsupported constraints on ALTER TABLE ADD COLUMN
# group: [add_col]

statement ok
CREATE TABLE test(i INTEGER)

statement ok
CREATE TABLE parent(i INTEGER PRIMARY KEY)

statement error
ALTER TABLE test ADD COLUMN not_null_col INTEGER NOT NULL
----
Parser Error: Adding columns with NOT NULL constraints is not supported yet

statement error
ALTER TABLE test ADD COLUMN unique_col INTEGER UNIQUE
----
Parser Error: Adding columns with UNIQUE constraints is not supported yet

statement error
ALTER TABLE test ADD COLUMN primary_key_col INTEGER PRIMARY KEY
----
Parser Error: Adding columns with PRIMARY KEY constraints is not supported yet

statement error
ALTER TABLE test ADD COLUMN check_col INTEGER CHECK (check_col > 0)
----
Parser Error: Adding columns with CHECK constraints is not supported yet

statement error
ALTER TABLE test ADD COLUMN foreign_key_col INTEGER REFERENCES parent(i)
----
Parser Error: Adding columns with FOREIGN KEY constraints is not supported yet

statement error
ALTER TABLE test ADD COLUMN deferred_unique_col INTEGER UNIQUE DEFERRED
----
Parser Error: Adding columns with UNIQUE constraints is not supported yet

statement error
ALTER TABLE test ADD COLUMN deferred_primary_key_col INTEGER PRIMARY KEY DEFERRED
----
Parser Error: Adding columns with PRIMARY KEY constraints is not supported yet

query I
SELECT count(*) FROM pragma_table_info('test')
----
1
