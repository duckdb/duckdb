# name: test/sql/alter/alter_type/alter_type_distinct_stats.test
# description: ALTER COLUMN SET DATA TYPE must carry the distinct count statistics over to the new column
# group: [alter_type]

statement ok
PRAGMA explain_output='optimized_only';

# 2000 distinct values in a pseudo-random order
statement ok
CREATE TABLE c AS SELECT hash(range) % 2000 AS v FROM range(100000);

statement ok
ALTER TABLE c ALTER COLUMN v SET DATA TYPE VARCHAR USING v::VARCHAR;

query II
EXPLAIN (FORMAT JSON) SELECT v FROM c GROUP BY v;
----
logical_opt	<REGEX>:.*"Groups":\s*"v",[^}]*"Estimated Cardinality":\s*"[0-9]{4}".*

# appended rows must extend the distinct count instead of replacing it
statement ok
INSERT INTO c SELECT (hash(range) % 2000)::VARCHAR FROM range(100);

query II
EXPLAIN (FORMAT JSON) SELECT v FROM c GROUP BY v;
----
logical_opt	<REGEX>:.*"Groups":\s*"v",[^}]*"Estimated Cardinality":\s*"[0-9]{4}".*

query I
SELECT COUNT(DISTINCT v) FROM c;
----
2000

# key columns of a join altered on both sides
statement ok
CREATE TABLE a AS SELECT uuid()::VARCHAR AS id, range % 30 AS lang FROM range(100000);

statement ok
CREATE TABLE b AS SELECT a.id AS a_id, r.range AS x FROM a, range(5) r;

query II
EXPLAIN (FORMAT JSON) SELECT id FROM a GROUP BY id;
----
logical_opt	<REGEX>:.*"Groups":\s*"id",[^}]*"Estimated Cardinality":\s*"[0-9]{5}".*

query II
EXPLAIN (FORMAT JSON) SELECT a.lang, COUNT(*) FROM a JOIN b ON a.id = b.a_id GROUP BY a.lang;
----
logical_opt	<REGEX>:.*"Conditions":\s*"[^"]*",[^}]*"Estimated Cardinality":\s*"[0-9]{5,7}".*

statement ok
BEGIN;

statement ok
ALTER TABLE a ALTER COLUMN id SET DATA TYPE UUID USING id::UUID;

statement ok
INSERT INTO a SELECT uuid(), range % 30 FROM range(100);

statement ok
COMMIT;

statement ok
BEGIN;

statement ok
ALTER TABLE b ALTER COLUMN a_id SET DATA TYPE UUID USING a_id::UUID;

statement ok
INSERT INTO b SELECT id, 99 FROM a LIMIT 100;

statement ok
COMMIT;

query II
EXPLAIN (FORMAT JSON) SELECT id FROM a GROUP BY id;
----
logical_opt	<REGEX>:.*"Groups":\s*"id",[^}]*"Estimated Cardinality":\s*"[0-9]{5}".*

query II
EXPLAIN (FORMAT JSON) SELECT a_id FROM b GROUP BY a_id;
----
logical_opt	<REGEX>:.*"Groups":\s*"a_id",[^}]*"Estimated Cardinality":\s*"[0-9]{5,6}".*

query II
EXPLAIN (FORMAT JSON) SELECT a.lang, COUNT(*) FROM a JOIN b ON a.id = b.a_id GROUP BY a.lang;
----
logical_opt	<REGEX>:.*"Conditions":\s*"[^"]*",[^}]*"Estimated Cardinality":\s*"[0-9]{5,7}".*

query I
SELECT COUNT(*) FROM a JOIN b ON a.id = b.a_id;
----
500100
