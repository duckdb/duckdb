# name: test/sql/alter/alter_type/test_alter_type_deleted_rows_persistent.test
# description: ALTER TYPE skips permanently deleted rows after checkpoint and restart
# group: [alter_type]

load {TEST_DIR}/alter_type_deleted.db

statement ok
CREATE TABLE t(v VARCHAR)

statement ok
INSERT INTO t VALUES ('1'), ('2'), ('x')

statement ok
DELETE FROM t WHERE v = 'x'

statement ok
CHECKPOINT

restart

statement ok
ALTER TABLE t ALTER v TYPE INTEGER

query I
SELECT v FROM t ORDER BY v
----
1
2

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE wal_alter(v VARCHAR)

statement ok
INSERT INTO wal_alter VALUES ('1'), ('2'), ('x')

statement ok
DELETE FROM wal_alter WHERE v = 'x'

statement ok
ALTER TABLE wal_alter ALTER v TYPE INTEGER

restart

query IT
SELECT v, typeof(v) FROM wal_alter ORDER BY v
----
1	INTEGER
2	INTEGER
