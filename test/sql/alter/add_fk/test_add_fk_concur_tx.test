# con1's ALTER fails due to outstanding updates
#---------------------------------------------------------------------------

statement ok con1
CREATE TABLE pk7 (id INTEGER PRIMARY KEY)

statement ok con1
INSERT INTO pk7 VALUES (1), (2), (3)

statement ok con1
CREATE TABLE fk7 (id INTEGER, val INTEGER)

statement ok con1
INSERT INTO fk7 VALUES (1, 1), (2, 2)

statement ok con1
BEGIN TRANSACTION

statement ok con2
BEGIN TRANSACTION

statement ok con2
UPDATE fk7 SET val = 3 WHERE id = 2

statement error con1
ALTER TABLE fk7 ADD FOREIGN KEY (val) REFERENCES pk7(id)
----
<REGEX>:TransactionContext Error.*outstanding updates.*

statement ok con2
COMMIT

statement ok con1
ROLLBACK

query II con1
SELECT id, val FROM fk7 ORDER BY id
----
1	1
2	3

statement ok con1
DROP TABLE fk7

statement ok con1
DROP TABLE pk7

