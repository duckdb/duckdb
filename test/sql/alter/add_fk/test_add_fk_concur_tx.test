#---------------------------------------------------------------------------

statement ok con1
CREATE TABLE pk5 (id INTEGER PRIMARY KEY)

statement ok con1
INSERT INTO pk5 VALUES (1), (2), (3)

statement ok con1
CREATE TABLE fk5 (id INTEGER, val INTEGER)

statement ok con1
