#---------------------------------------------------------------------------
# Scenario 6: con2 UPDATE FK column to a valid value
# con1's alter failed due to outstanding updates
#---------------------------------------------------------------------------

statement ok con1
CREATE TABLE pk6 (id INTEGER PRIMARY KEY)

statement ok con1
INSERT INTO pk6 VALUES (1), (2), (3)

statement ok con1
CREATE TABLE fk6 (id INTEGER, val INTEGER)

statement ok con1
INSERT INTO fk6 VALUES (1, 1), (2, 2)

statement ok con1
BEGIN TRANSACTION

statement ok con2
BEGIN TRANSACTION

statement ok con2
UPDATE fk6 SET val = 3 WHERE id = 2

statement error con1
ALTER TABLE fk6 ADD FOREIGN KEY (val) REFERENCES pk6(id)
----
<REGEX>:TransactionContext Error.*outstanding updates.*

statement ok con1
ROLLBACK

statement ok con2
COMMIT

query I con1
SELECT COUNT(*) FROM fk6
----
2

statement ok con1
DROP TABLE fk6

statement ok con1
DROP TABLE pk6

#---------------------------------------------------------------------------
