# name: test/sql/alter/add_fk/test_add_fk_concur_tx.test
# description: Concurrent transaction tests for ALTER TABLE ADD FOREIGN KEY
# group: [add_fk]

#---------------------------------------------------------------------------
# Scenario 1: Update AFTER alter. con1 alters first (uncommitted); con2 then
# attempts DML on the altered entry and must fail because the catalog entry
# has been altered.
#---------------------------------------------------------------------------

statement ok con1
CREATE TABLE pk1 (id INTEGER PRIMARY KEY)

statement ok con1
INSERT INTO pk1 VALUES (1), (2), (3)

statement ok con1
CREATE TABLE fk1 (id INTEGER, val INTEGER)

statement ok con1
INSERT INTO fk1 VALUES (1, 1)

statement ok con1
BEGIN TRANSACTION

statement ok con2
BEGIN TRANSACTION

statement ok con1
ALTER TABLE fk1 ADD CONSTRAINT fk1_fk FOREIGN KEY (val) REFERENCES pk1(id)

statement error con2
INSERT INTO fk1 VALUES (2, 2)
----

statement ok con1
COMMIT

statement ok con2
ROLLBACK

query I con1
SELECT COUNT(*) FROM fk1
----
1

statement ok con1
DROP TABLE fk1

statement ok con1
DROP TABLE pk1

#---------------------------------------------------------------------------
# All subsequent scenarios: alter AFTER update. For each con2 DML, both
# commit orderings are exercised (con1 commits first, then con2 commits first).
#---------------------------------------------------------------------------

#---------------------------------------------------------------------------
# Scenario 2: con2 INSERT valid FK row, con1 commits first.
# con2's commit fails because the catalog entry was altered under it.
#---------------------------------------------------------------------------

statement ok con1
CREATE TABLE pk2 (id INTEGER PRIMARY KEY)

statement ok con1
INSERT INTO pk2 VALUES (1), (2), (3)

statement ok con1
CREATE TABLE fk2 (id INTEGER, val INTEGER)

statement ok con1
INSERT INTO fk2 VALUES (1, 1)

statement ok con1
BEGIN TRANSACTION

statement ok con2
BEGIN TRANSACTION

statement ok con2
INSERT INTO fk2 VALUES (2, 2)

statement ok con1
ALTER TABLE fk2 ADD FOREIGN KEY (val) REFERENCES pk2(id)

statement ok con1
COMMIT

statement error con2
COMMIT
----

query I con1
SELECT COUNT(*) FROM fk2
----
1

statement ok con1
DROP TABLE fk2

statement ok con1
DROP TABLE pk2

#---------------------------------------------------------------------------
# Scenario 3: con2 INSERT valid FK row, con2 commits first.
# Both transactions succeed; row count reflects both inserts.
#---------------------------------------------------------------------------

statement ok con1
CREATE TABLE pk3 (id INTEGER PRIMARY KEY)

statement ok con1
INSERT INTO pk3 VALUES (1), (2), (3)

statement ok con1
CREATE TABLE fk3 (id INTEGER, val INTEGER)

statement ok con1
INSERT INTO fk3 VALUES (1, 1)

statement ok con1
BEGIN TRANSACTION

statement ok con2
BEGIN TRANSACTION

statement ok con2
INSERT INTO fk3 VALUES (2, 2)

statement ok con2
COMMIT

statement ok con1
ALTER TABLE fk3 ADD FOREIGN KEY (val) REFERENCES pk3(id)

statement ok con1
COMMIT

query I con1
SELECT COUNT(*) FROM fk3
----
2

statement ok con1
DROP TABLE fk3

statement ok con1
DROP TABLE pk3

#---------------------------------------------------------------------------
