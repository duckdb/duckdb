#---------------------------------------------------------------------------
# Scenario 14: con2 DELETE a PK row that a committed FK row references,
# con1 commits first. con1's ALTER succeeds on its snapshot; con2's commit
# must fail because it would create a dangling FK reference.
#---------------------------------------------------------------------------

statement ok con1
CREATE TABLE pk14 (id INTEGER PRIMARY KEY)

statement ok con1
INSERT INTO pk14 VALUES (1), (2), (3)

statement ok con1
CREATE TABLE fk14 (id INTEGER, val INTEGER)

statement ok con1
INSERT INTO fk14 VALUES (1, 1), (2, 2)

statement ok con1
BEGIN TRANSACTION

statement ok con2
BEGIN TRANSACTION

statement ok con2
DELETE FROM pk14 WHERE id = 3

statement ok con1
ALTER TABLE fk14 ADD FOREIGN KEY (val) REFERENCES pk14(id)

statement ok con1
COMMIT

statement error con2
COMMIT
----
<REGEX>:TransactionContext Error.*

query I con1
SELECT COUNT(*) FROM pk14
----
3

statement ok con1
DROP TABLE fk14

statement ok con1
DROP TABLE pk14

#---------------------------------------------------------------------------
# Scenario 15: con2 DELETE an unreferenced PK row, con2 commits first.
# Safe: the deleted PK row is not referenced by any FK row. Both commit.
#---------------------------------------------------------------------------

statement ok con1
CREATE TABLE pk15 (id INTEGER PRIMARY KEY)

statement ok con1
INSERT INTO pk15 VALUES (1), (2), (3)

statement ok con1
CREATE TABLE fk15 (id INTEGER, val INTEGER)

statement ok con1
INSERT INTO fk15 VALUES (1, 1), (2, 2)

statement ok con1
BEGIN TRANSACTION

statement ok con2
BEGIN TRANSACTION

statement ok con2
DELETE FROM pk15 WHERE id = 3

statement ok con1
ALTER TABLE fk15 ADD FOREIGN KEY (val) REFERENCES pk15(id)

statement error con2
COMMIT
----
<REGEX>:TransactionContext Error.*another transaction has no changes this table.*

statement ok con1
COMMIT

query I con1
SELECT COUNT(*) FROM pk15
----
3

statement ok con1
DROP TABLE fk15

statement ok con1
DROP TABLE pk15

#---------------------------------------------------------------------------
# Scenario 16: con2 DELETE a PK row that a committed FK row references,
# con2 commits first. con1's ALTER must fail because the FK table has a
# dangling reference in the new snapshot.
#---------------------------------------------------------------------------

statement ok con1
CREATE TABLE pk16 (id INTEGER PRIMARY KEY)

statement ok con1
INSERT INTO pk16 VALUES (1), (2), (3)

statement ok con1
CREATE TABLE fk16 (id INTEGER, val INTEGER)

statement ok con1
INSERT INTO fk16 VALUES (1, 1), (2, 2), (3, 3)

statement ok con1
BEGIN TRANSACTION

statement ok con2
BEGIN TRANSACTION

statement ok con2
DELETE FROM pk16 WHERE id = 3

statement ok con2
COMMIT

statement error con1
ALTER TABLE fk16 ADD FOREIGN KEY (val) REFERENCES pk16(id)
----
<REGEX>:Constraint Error.*

statement ok con1
ROLLBACK

query I con1
SELECT COUNT(*) FROM pk16
----
2

query I con1
SELECT COUNT(*) FROM fk16
----
3

statement ok con1
DROP TABLE fk16

statement ok con1
DROP TABLE pk16

