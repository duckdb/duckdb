INSERT INTO pk4 VALUES (1), (2), (3)

statement ok con1
CREATE TABLE fk4 (id INTEGER, val INTEGER)

statement ok con1
INSERT INTO fk4 VALUES (1, 1)

statement ok con1
BEGIN TRANSACTION

statement ok con2
BEGIN TRANSACTION

statement ok con2
INSERT INTO fk4 VALUES (2, 999)

statement ok con1
ALTER TABLE fk4 ADD FOREIGN KEY (val) REFERENCES pk4(id)

statement ok con1
COMMIT

statement error con2
COMMIT
----

query I con1
SELECT COUNT(*) FROM fk4
----
1

statement ok con1
DROP TABLE fk4

statement ok con1
DROP TABLE pk4

