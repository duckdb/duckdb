# name: test/sql/alter/add_unique/test_add_unique.test
# description: ALTER TABLE ADD UNIQUE must enforce uniqueness
# group: [add_unique]

statement ok
CREATE TABLE t(c INT);

statement ok
INSERT INTO t VALUES (1);

statement ok
ALTER TABLE t ADD UNIQUE (c);

statement error
INSERT INTO t VALUES (1);
----
<REGEX>:Constraint Error.*Duplicate key "c: 1" violates unique constraint.*

statement ok
CREATE TABLE d(i INT);

statement ok
INSERT INTO d VALUES (1), (1);

statement error
ALTER TABLE d ADD UNIQUE (i);
----
<REGEX>:Constraint Error.*contains duplicates on indexed column.*

statement ok
CREATE TABLE r(i INT);

statement ok
BEGIN;

statement ok
ALTER TABLE r ADD UNIQUE (i);

statement ok
ROLLBACK;

statement ok
INSERT INTO r VALUES (1), (1);

# cannot add a UNIQUE constraint on a generated column
statement ok
CREATE TABLE g(a INT, g INT GENERATED ALWAYS AS (a + 1));

statement error
ALTER TABLE g ADD UNIQUE (g);
----
<REGEX>:Binder Error.*cannot create a UNIQUE constraint on a generated column: g.*

statement error
ALTER TABLE g ADD PRIMARY KEY (g);
----
<REGEX>:Binder Error.*cannot create a PRIMARY KEY on a generated column: g.*

# a UNIQUE constraint on the same set of columns already exists
statement ok
CREATE TABLE dup(i INT, j INT);

statement ok
ALTER TABLE dup ADD UNIQUE (i);

statement error
ALTER TABLE dup ADD UNIQUE (i);
----
<REGEX>:Catalog Error.*table "dup" already has the constraint UNIQUE\(i\).*

statement ok
ALTER TABLE dup ADD UNIQUE (i, j);

statement error
ALTER TABLE dup ADD UNIQUE (j, i);
----
<REGEX>:Catalog Error.*table "dup" already has the constraint UNIQUE\(i, j\).*

# a PRIMARY KEY on the columns of an existing UNIQUE constraint is allowed
statement ok
ALTER TABLE dup ADD PRIMARY KEY (i);

statement error
INSERT INTO dup VALUES (1, 1), (1, 2);
----
<REGEX>:Constraint Error.*Duplicate key.*

# a UNIQUE constraint declared inline counts as well
statement ok
CREATE TABLE dup_inline(i INT UNIQUE);

statement error
ALTER TABLE dup_inline ADD UNIQUE (i);
----
<REGEX>:Catalog Error.*table "dup_inline" already has the constraint UNIQUE.*
