# name: test/sql/alter/add_pk/add_constraint_local_changes.test
# description: ADD PRIMARY KEY / NOT NULL / UNIQUE on a table with transaction-local changes
# group: [add_pk]

statement ok
CREATE TABLE tbl(i INTEGER, j INTEGER);

statement ok
INSERT INTO tbl VALUES (1, 1);

statement ok
BEGIN TRANSACTION

statement ok
INSERT INTO tbl SELECT range + 10, range FROM range(5000)

statement ok
ALTER TABLE tbl ADD PRIMARY KEY (i)

# the local rows are covered by the new constraint: the violation is found at commit
statement ok
INSERT INTO tbl VALUES (11, 0)

statement error
COMMIT
----
<REGEX>:.*duplicate key.*

query II
SELECT count(*), sum(i) FROM tbl
----
1	1

statement ok
BEGIN TRANSACTION

statement ok
INSERT INTO tbl SELECT range + 10, range FROM range(5000)

statement ok
ALTER TABLE tbl ADD PRIMARY KEY (i)

# more rows after the ALTER, then ADD COLUMN on top of the new version
statement ok
INSERT INTO tbl SELECT range + 100000, range FROM range(100)

statement ok
ALTER TABLE tbl ADD COLUMN k INTEGER DEFAULT 7

statement ok
INSERT INTO tbl VALUES (-1, -1, 8)

query IIII
SELECT count(*), sum(i), sum(k), count(*) FILTER (k = 8) FROM tbl
----
5102	22552450	35715	1

statement ok
COMMIT

query IIII
SELECT count(*), sum(j), count(DISTINCT i), count(*) FILTER (k = 8) FROM tbl
----
5102	12502450	5102	1

statement error
INSERT INTO tbl VALUES (-1, 0, 0)
----
<REGEX>:.*Constraint Error.*

# NOT NULL and UNIQUE on local changes
statement ok
CREATE TABLE tbl2(a INTEGER, b INTEGER);

statement ok
BEGIN TRANSACTION

statement ok
INSERT INTO tbl2 SELECT range, range FROM range(3000)

statement ok
ALTER TABLE tbl2 ALTER a SET NOT NULL

statement error
INSERT INTO tbl2 VALUES (NULL, 1)
----
<REGEX>:.*Constraint Error.*

statement ok
ROLLBACK

statement ok
BEGIN TRANSACTION

statement ok
INSERT INTO tbl2 SELECT range, range FROM range(3000)

statement ok
ALTER TABLE tbl2 ALTER a SET NOT NULL

statement ok
INSERT INTO tbl2 VALUES (5000, 5000)

statement ok
COMMIT

query II
SELECT count(*), sum(a) FROM tbl2
----
3001	4503500
