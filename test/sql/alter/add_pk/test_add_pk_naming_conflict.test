# name: test/sql/alter/add_pk/test_add_pk_naming_conflict.test
# description: Test that explicit index names do not conflict with the names of constraint-backed indexes.
# group: [add_pk]

load {TEST_DIR}/test_add_pk_naming_conflict.db

statement ok
CREATE TABLE tbl (i INTEGER);

statement ok
INSERT INTO tbl VALUES (1);

statement ok
CREATE INDEX PRIMARY_tbl_i ON tbl(i);

# The index name does not matter, but the catalog dependency prevents altering a table with an index on it.
statement error
ALTER TABLE tbl ADD PRIMARY KEY (i);
----
<REGEX>:Dependency Error.*depend on it.*

restart

statement error
ALTER TABLE tbl ADD PRIMARY KEY (i);
----
<REGEX>:Dependency Error.*depend on it.*

# Let's do it the other way around now.

statement ok
CREATE TABLE test (i INTEGER)

statement ok
INSERT INTO test VALUES (1);

statement ok
ALTER TABLE test ADD PRIMARY KEY (i);

statement ok
CREATE INDEX PRIMARY_test_i ON test(i);

query TT
SELECT table_name, index_name FROM duckdb_indexes() WHERE table_name = 'test';
----
test	PRIMARY_test_i

statement error
INSERT INTO test VALUES (1);
----
<REGEX>:Constraint Error.*violates primary key constraint.*

restart

statement error
INSERT INTO test VALUES (1);
----
<REGEX>:Constraint Error.*violates primary key constraint.*

# Dropping the explicit index keeps the primary key.
statement ok
DROP INDEX PRIMARY_test_i;

statement error
INSERT INTO test VALUES (1);
----
<REGEX>:Constraint Error.*violates primary key constraint.*

statement ok
CHECKPOINT;

restart

query I
SELECT count(*) FROM duckdb_indexes() WHERE table_name = 'test';
----
0

statement error
INSERT INTO test VALUES (1);
----
<REGEX>:Constraint Error.*violates primary key constraint.*
