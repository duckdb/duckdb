# name: test/sql/alter/add_pk/test_add_pk_naming_conflict.test
# description: Test adding a PRIMARY KEY to a table that already has an index with that name.
# group: [add_pk]

load {TEST_DIR}/test_add_pk_naming_conflict.db

statement ok
CREATE TABLE tbl (i INTEGER);

statement ok
INSERT INTO tbl VALUES (1);

statement ok
CREATE INDEX PRIMARY_tbl_i ON tbl(i);

# The explicit index blocks ALTER TABLE regardless of its name.
statement error
ALTER TABLE tbl ADD PRIMARY KEY (i);
----
<REGEX>:Dependency Error.*Cannot alter entry "tbl" because there are entries that depend on it.*

restart

statement error
ALTER TABLE tbl ADD PRIMARY KEY (i);
----
<REGEX>:Dependency Error.*Cannot alter entry "tbl" because there are entries that depend on it.*

# Let's do it the other way around now.

statement ok
CREATE TABLE test (i INTEGER)

statement ok
INSERT INTO test VALUES (1);

statement ok
ALTER TABLE test ADD PRIMARY KEY (i);

# Constraint index names are not identifiers, so an explicit index can reuse them.
statement ok
CREATE INDEX PRIMARY_test_i ON test(i);
