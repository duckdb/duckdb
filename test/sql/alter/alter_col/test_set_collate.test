# name: test/sql/alter/alter_col/test_set_collate.test
# description: Test COLLATE in alter column statement
# group: [alter_col]

statement ok
CREATE TABLE t(id INT, s VARCHAR);

statement ok
INSERT INTO t VALUES (1, 'hello'), (2, 'HELLO'), (3, 'World');

statement ok
ALTER TABLE t ALTER COLUMN s TYPE VARCHAR COLLATE nocase;

query I
SELECT id FROM t WHERE s = 'hello' ORDER BY id
----
1
2

query T
SELECT s FROM t ORDER BY s, id
----
hello
HELLO
World

# COLLATE combined with USING
statement ok
ALTER TABLE t ALTER COLUMN id TYPE VARCHAR COLLATE nocase USING 'x' || id::VARCHAR;

query I
SELECT count(*) FROM t WHERE id = 'X1'
----
1

statement error
ALTER TABLE t ALTER COLUMN s TYPE INTEGER COLLATE nocase;
----
Only VARCHAR columns can have collations!

statement error
ALTER TABLE t ALTER COLUMN s COLLATE nocase;
----
Parser Error

statement error
ALTER TABLE t ALTER COLUMN s TYPE COLLATE nocase USING s;
----
Parser Error

statement error
ALTER TABLE t ALTER COLUMN s TYPE VARCHAR COLLATE nonexistent_collation;
----
<REGEX>:.*Catalog Error.*nonexistent_collation.*
