# name: test/sql/pragma/profiling/test_secret_profiling_redaction.test
# description: Secret statements are replaced with a placeholder in profiling output without changing execution
# group: [profiling]

require noforcestorage

require skip_reload

# The test runner permits unredacted secrets at database creation.
statement ok
CALL enable_profiling(format = 'json', coverage = 'all', save_location = '{TEST_DIR}/secret_unredacted.json');

statement ok
CREATE SECRET profile_unredacted (TYPE HTTP, BEARER_TOKEN 'dummy-unredacted-token');

statement ok
CALL disable_profiling();

query I
SELECT contains(content, 'dummy-unredacted-token') FROM read_text('{TEST_DIR}/secret_unredacted.json');
----
true

statement ok
SET allow_unredacted_secrets = false;

foreach format json html

statement ok
CALL enable_profiling(format = '{format}', coverage = 'all', save_location = '{TEST_DIR}/secret_profile.{format}');

statement ok
CREATE OR REPLACE SECRET profiled_secret (
    TYPE HTTP,
    PROVIDER CONFIG,
    SCOPE 'https://dummy-scope.example/',
    BEARER_TOKEN 'dummy-profile-token',
    EXTRA_HTTP_HEADERS MAP {'Authorization': 'dummy-header-token'}
);

statement ok
CALL disable_profiling();

query III
SELECT NOT contains(content, 'dummy-'), contains(content, 'redacted'), NOT contains(content, 'profiled_secret')
FROM read_text('{TEST_DIR}/secret_profile.{format}');
----
true	true	true

# Rendering the profile must not change the secret that was created.
query T
SELECT scope[1] FROM duckdb_secrets() WHERE name = 'profiled_secret';
----
https://dummy-scope.example/

endloop

query I
SELECT contains(content, '"sql": "redacted"') FROM read_text('{TEST_DIR}/secret_profile.json');
----
true

# EXPLAIN ANALYZE enables profiling even when ordinary profiling is disabled.
query TT
EXPLAIN (ANALYZE, FORMAT JSON) CREATE SECRET profile_explained (TYPE HTTP, BEARER_TOKEN 'dummy-explain-token');
----
analyzed_plan	<REGEX>:.*"sql": "redacted".*

# Unaffected queries retain their original text in the SQL metric.
statement ok
CALL enable_profiling(format = 'json', save_location = '{TEST_DIR}/ordinary_profile.json');

query I
select  42 /* preserve formatting */ AS answer;
----
42

statement ok
CALL disable_profiling();

query I
SELECT contains(content, 'select  42 /* preserve formatting */ AS answer;')
FROM read_text('{TEST_DIR}/ordinary_profile.json');
----
true
