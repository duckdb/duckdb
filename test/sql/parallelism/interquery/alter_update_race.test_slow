# name: test/sql/parallelism/interquery/alter_update_race.test_slow
# description: An update of a row conflicts with an update in flight while ALTER TABLE ran
# group: [interquery]

load {TEST_DIR}/alter_update_race.db

# writing 'y' evaluates a slow CHECK constraint, which keeps the UPDATE in flight while ALTER runs
statement ok
CREATE TABLE t (id INTEGER, a VARCHAR CHECK (a <> 'y' OR md5(repeat(a, 50000000)) <> ''))

statement ok
INSERT INTO t SELECT i, 'x' FROM range(10) r(i)

# a transaction logs the value it writes, so the log holds the updates that committed
statement ok
CREATE TABLE committed (a VARCHAR)

# reopened, the row group has no version info
restart

# load column a, so that ALTER shares it with the new table
statement ok
SELECT sum(length(a) + id) FROM t

concurrentloop threadid 0 2

statement ok
BEGIN

onlyif threadid=0
statement maybe
UPDATE t SET a = 'y' WHERE id = 5
----
Conflict on update

# both threads sleep: thread 1 alters the table while the update of thread 0 is in flight
sleep 20 milliseconds

onlyif threadid=1
statement maybe
ALTER TABLE t ADD COLUMN c INTEGER
----
<REGEX>:.*(onflict|aborted).*

# both threads sleep: thread 1 updates the row once the update of thread 0 is done
sleep 1 second

onlyif threadid=1
statement maybe
UPDATE t SET a = 'z' WHERE id = 5
----
<REGEX>:.*(onflict|aborted).*

onlyif threadid=1
statement maybe
INSERT INTO committed VALUES ('z')
----
aborted

onlyif threadid=1
statement maybe
COMMIT
----
<REGEX>:.*(onflict|aborted|altered).*

# both threads sleep: thread 0 commits after thread 1
sleep 1 second

onlyif threadid=0
statement maybe
INSERT INTO committed VALUES ('y')
----
aborted

onlyif threadid=0
statement maybe
COMMIT
----
<REGEX>:.*(onflict|aborted|altered).*

endloop

# at most one of the updates commits, and the row holds its value
query I
SELECT count(*) <= 1 FROM committed
----
true

query I
SELECT a = coalesce((SELECT max(a) FROM committed), 'x') FROM t WHERE id = 5
----
true
