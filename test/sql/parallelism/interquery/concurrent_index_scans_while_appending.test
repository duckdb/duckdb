# name: test/sql/parallelism/interquery/concurrent_index_scans_while_appending.test
# description: Test concurrent index scans while appending
# group: [interquery]

statement ok
CREATE TABLE integers(i INTEGER PRIMARY KEY, payload BIGINT USING COMPRESSION UNCOMPRESSED)

statement ok
INSERT INTO integers SELECT i, i * 3 FROM range(10000) r(i);

concurrentloop threadid 0 20

statement ok
SET index_scan_percentage = 1.0;

statement ok
SET index_scan_max_count = 0;

loop i 0 20

onlyif threadid=0
statement ok
INSERT INTO integers
SELECT i, i * 3 FROM range(10000 + {i} * 100, 10100 + {i} * 100) r(i);

endloop

loop i 0 100

skipif threadid=0
statement ok
SELECT * FROM integers WHERE i={i} * ({threadid} * 300);

endloop

loop i 0 20

# 9983 creates 17 hits in the initial tail vector while concurrent appends extend that vector.
skipif threadid=0
query IIIIII
SELECT bool_and(payload = i * 3),
       count(*) = count(DISTINCT i),
       min(i) = 9983,
       max(i) BETWEEN 9999 AND 11999,
       count(*) = max(i) - min(i) + 1,
       sum(i) = (min(i) + max(i)) * count(*) / 2
FROM integers WHERE i >= 9983 AND i < 12000;
----
true	true	true	true	true	true

endloop

endloop

query II
SELECT COUNT(*), SUM(i) FROM integers
----
12000	71994000
