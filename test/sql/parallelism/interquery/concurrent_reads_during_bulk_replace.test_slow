# name: test/sql/parallelism/interquery/concurrent_reads_during_bulk_replace.test_slow
# description: Concurrent readers never see the rows of a bulk insert before its transaction commits
# group: [interquery]

load {TEST_DIR}/concurrent_reads_during_bulk_replace.db

# keep the commits free of automatic checkpoints
statement ok
SET checkpoint_threshold = '10GB';

# with one thread, inserts mark their rows with the transaction id from the start
statement ok
SET threads = 4;

statement ok
CREATE TABLE t AS SELECT range AS id FROM range(250000);

statement ok
CREATE TABLE s AS SELECT range AS id FROM range(250000);

statement ok
CHECKPOINT

# batch inserts and parallel inserts
foreach preserve_insertion_order true false

statement ok
SET preserve_insertion_order = {preserve_insertion_order};

concurrentloop threadid 0 2

loop i 0 20

onlyif threadid=0
statement ok
BEGIN

onlyif threadid=0
statement ok
DELETE FROM t

onlyif threadid=0
statement ok
INSERT INTO t SELECT * FROM s

onlyif threadid=0
statement ok
COMMIT

loop j 0 20

onlyif threadid=1
query II
SELECT count(*), count(DISTINCT id) FROM t
----
250000	250000

endloop

endloop

endloop

endloop

query II
SELECT count(*), count(DISTINCT id) FROM t
----
250000	250000
