# name: test/sql/constraints/foreignkey/test_fk_column_count.test
# description: Column-level foreign keys must reference as many columns as they have referencing columns
# group: [foreignkey]

statement ok
CREATE TABLE composite_pk(a INTEGER, b INTEGER, PRIMARY KEY(a, b));

statement error
CREATE TABLE child(x INTEGER REFERENCES composite_pk(a, b));
----
Failed to create foreign key: number of referencing (x) and referenced columns (a,b) differ

statement ok
CREATE TABLE single_pk(a INTEGER PRIMARY KEY, b INTEGER);

statement error
CREATE TABLE child(x INTEGER REFERENCES single_pk(a, b));
----
Failed to create foreign key: number of referencing (x) and referenced columns (a,b) differ

# self-references take the same path
statement error
CREATE TABLE self_ref(a INTEGER, b INTEGER, x INTEGER REFERENCES self_ref(a, b), PRIMARY KEY(a, b));
----
Failed to create foreign key: number of referencing (x) and referenced columns (a,b) differ

statement ok
CREATE TABLE child(x INTEGER REFERENCES single_pk(a));
