# name: test/sql/constraints/deferred/test_deferred_alter.test
# description: Adding deferred constraints to tables with committed and local rows
# group: [deferred]

statement ok
CREATE TABLE existing(i INTEGER);

statement ok
INSERT INTO existing VALUES (1), (1);

statement error
ALTER TABLE existing ADD UNIQUE(i) DEFERRED;
----
Data contains duplicates on indexed column(s)

statement ok
CREATE TABLE valid(i INTEGER);

statement ok
INSERT INTO valid VALUES (1), (2);

statement ok
ALTER TABLE valid ADD UNIQUE(i) DEFERRED;

statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO valid VALUES (2);

statement error
COMMIT;
----
Failed to commit: PRIMARY KEY or UNIQUE constraint violation: duplicate key

statement ok
CREATE TABLE altered_in_transaction(i INTEGER);

statement ok
INSERT INTO altered_in_transaction VALUES (1);

statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO altered_in_transaction VALUES (2);

statement ok
ALTER TABLE altered_in_transaction ADD UNIQUE(i) DEFERRED;

statement ok
DELETE FROM altered_in_transaction WHERE i = 1;

statement ok
INSERT INTO altered_in_transaction VALUES (1);

statement ok
COMMIT;

query I rowsort
SELECT i FROM altered_in_transaction;
----
1
2

statement ok
CREATE TABLE local_duplicates(i INTEGER);

statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO local_duplicates VALUES (1), (1);

statement ok
ALTER TABLE local_duplicates ADD UNIQUE(i) DEFERRED;

statement error
COMMIT;
----
Failed to commit: PRIMARY KEY or UNIQUE constraint violation: duplicate key

statement ok
INSERT INTO local_duplicates VALUES (1);

statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO local_duplicates VALUES (1);

statement ok
ALTER TABLE local_duplicates ADD UNIQUE(i) DEFERRED;

statement error
COMMIT;
----
Failed to commit: PRIMARY KEY or UNIQUE constraint violation: duplicate key

query I
SELECT count(*) FROM local_duplicates;
----
1

# the local duplicates can still be resolved before the commit
statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO local_duplicates VALUES (2), (2);

statement ok
ALTER TABLE local_duplicates ADD UNIQUE(i) DEFERRED;

statement ok
DELETE FROM local_duplicates WHERE rowid = (SELECT max(rowid) FROM local_duplicates);

statement ok
COMMIT;

query I rowsort
SELECT i FROM local_duplicates;
----
1
2

statement ok
CREATE TABLE local_nulls(i INTEGER);

statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO local_nulls VALUES (NULL);

statement error
ALTER TABLE local_nulls ADD PRIMARY KEY(i) DEFERRED;
----
NOT NULL constraint failed

statement ok
ROLLBACK;
