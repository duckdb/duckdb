# name: test/sql/constraints/deferred/test_deferred_syntax.test
# description: Test parsing DEFERRED primary key and unique constraints
# group: [deferred]

# Deferred constraints must remain deferred after copying or reparsing the statement.
foreach mode NONE COPY_STATEMENT REPARSE_STATEMENT

statement ok
SET debug_verify_statement='{mode}'

statement error
CREATE TABLE deferred_column_unique(i INTEGER UNIQUE DEFERRED);
----
Not implemented Error: Deferred UNIQUE constraints are not implemented yet

statement error
CREATE TABLE deferred_column_primary_key(i INTEGER PRIMARY KEY DEFERRED);
----
Not implemented Error: Deferred PRIMARY KEY constraints are not implemented yet

statement error
CREATE TABLE deferred_table_unique(i INTEGER, UNIQUE(i) DEFERRED);
----
Not implemented Error: Deferred UNIQUE constraints are not implemented yet

statement error
CREATE TABLE deferred_table_primary_key(i INTEGER, PRIMARY KEY(i) DEFERRED);
----
Not implemented Error: Deferred PRIMARY KEY constraints are not implemented yet

# Keep the deferred modifier attached to the correct constraint on the same column.
statement error
CREATE TABLE mixed_unique(i INTEGER PRIMARY KEY UNIQUE DEFERRED);
----
Not implemented Error: Deferred UNIQUE constraints are not implemented yet

statement error
CREATE TABLE mixed_primary_key(i INTEGER UNIQUE PRIMARY KEY DEFERRED);
----
Not implemented Error: Deferred PRIMARY KEY constraints are not implemented yet

statement ok
RESET debug_verify_statement

endloop
