# name: test/sql/constraints/deferred/test_alter_constraint_timing.test
# description: Test constraint timing when adding constraints to existing columns
# group: [deferred]

statement ok
CREATE TABLE timing_test(i INTEGER, j INTEGER);

statement error
ALTER TABLE timing_test ADD UNIQUE(i) DEFERRED;
----
Not implemented Error: Deferred UNIQUE constraints are not implemented yet

statement error
ALTER TABLE timing_test ADD PRIMARY KEY(j) DEFERRED;
----
Not implemented Error: Deferred PRIMARY KEY constraints are not implemented yet

statement ok
ALTER TABLE timing_test ADD UNIQUE(i) IMMEDIATE;

statement ok
ALTER TABLE timing_test ADD PRIMARY KEY(j) IMMEDIATE;

query I rowsort
SELECT constraint_text FROM duckdb_constraints() WHERE table_name = 'timing_test' AND constraint_type <> 'NOT NULL';
----
PRIMARY KEY(j) IMMEDIATE
UNIQUE(i) IMMEDIATE
