# name: test/sql/constraints/deferred/test_deferred_compatibility.test
# description: Deferred keys cannot be foreign key or conflict targets
# group: [deferred]

statement ok
CREATE TABLE parent(i INTEGER PRIMARY KEY DEFERRED, j INTEGER UNIQUE DEFERRED);

statement error
CREATE TABLE child(i INTEGER REFERENCES parent(i));
----
the referenced PRIMARY KEY or UNIQUE constraint cannot be DEFERRED

statement error
CREATE TABLE child(i INTEGER REFERENCES parent(j));
----
the referenced PRIMARY KEY or UNIQUE constraint cannot be DEFERRED

statement error
CREATE TABLE child(i INTEGER REFERENCES parent);
----
the referenced PRIMARY KEY or UNIQUE constraint cannot be DEFERRED

statement error
INSERT INTO parent VALUES (1, 1) ON CONFLICT (i) DO NOTHING;
----
DEFERRED PRIMARY KEY or UNIQUE constraints cannot be ON CONFLICT targets

statement error
INSERT INTO parent VALUES (1, 1) ON CONFLICT (j) DO NOTHING;
----
DEFERRED PRIMARY KEY or UNIQUE constraints cannot be ON CONFLICT targets

statement error
INSERT OR IGNORE INTO parent VALUES (1, 1);
----
DEFERRED PRIMARY KEY or UNIQUE constraints cannot be ON CONFLICT targets

statement error
INSERT OR REPLACE INTO parent VALUES (1, 1);
----
DEFERRED PRIMARY KEY or UNIQUE constraints cannot be ON CONFLICT targets

statement ok
CREATE TABLE mixed(i INTEGER UNIQUE DEFERRED, j INTEGER UNIQUE);

statement ok
INSERT INTO mixed VALUES (1, 1);

# without a conflict target, the deferred constraint would be a conflict target
statement error
INSERT OR IGNORE INTO mixed VALUES (2, 1);
----
DEFERRED PRIMARY KEY or UNIQUE constraints cannot be ON CONFLICT targets

statement error
INSERT OR REPLACE INTO mixed VALUES (2, 1);
----
DEFERRED PRIMARY KEY or UNIQUE constraints cannot be ON CONFLICT targets

statement error
INSERT INTO mixed VALUES (2, 1) ON CONFLICT DO NOTHING;
----
DEFERRED PRIMARY KEY or UNIQUE constraints cannot be ON CONFLICT targets

statement ok
INSERT INTO mixed VALUES (2, 1) ON CONFLICT (j) DO NOTHING;

query I
SELECT count(*) FROM mixed;
----
1

statement ok
INSERT INTO mixed VALUES (2, 2) ON CONFLICT (j) DO NOTHING;

# the deferred constraint is not a conflict target, but it is still validated at commit
statement error
INSERT INTO mixed VALUES (2, 3) ON CONFLICT (j) DO NOTHING;
----
Failed to commit: PRIMARY KEY or UNIQUE constraint violation: duplicate key

statement ok
INSERT INTO mixed VALUES (3, 2) ON CONFLICT (j) DO UPDATE SET i = 3;

query II rowsort
SELECT i, j FROM mixed;
----
1	1
3	2

statement error
INSERT INTO mixed VALUES (4, 2) ON CONFLICT (j) DO UPDATE SET i = 1;
----
Failed to commit: PRIMARY KEY or UNIQUE constraint violation: duplicate key

statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO mixed VALUES (1, 3) ON CONFLICT (j) DO NOTHING;

statement ok
DELETE FROM mixed WHERE j = 1;

statement ok
COMMIT;

query II rowsort
SELECT i, j FROM mixed;
----
1	3
3	2

statement error
INSERT INTO mixed VALUES (1, 3) ON CONFLICT (i) DO NOTHING;
----
DEFERRED PRIMARY KEY or UNIQUE constraints cannot be ON CONFLICT targets

statement ok
CREATE TABLE existing(i INTEGER);

statement ok
INSERT INTO existing VALUES (1), (1);

statement error
ALTER TABLE existing ADD UNIQUE(i) DEFERRED;
----
Data contains duplicates on indexed column(s)

statement ok
CREATE TABLE valid(i INTEGER);

statement ok
INSERT INTO valid VALUES (1), (2);

statement ok
ALTER TABLE valid ADD UNIQUE(i) DEFERRED;

statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO valid VALUES (2);

statement error
COMMIT;
----
Failed to commit: PRIMARY KEY or UNIQUE constraint violation: duplicate key

statement ok
CREATE TABLE altered_in_transaction(i INTEGER);

statement ok
INSERT INTO altered_in_transaction VALUES (1);

statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO altered_in_transaction VALUES (2);

statement ok
ALTER TABLE altered_in_transaction ADD UNIQUE(i) DEFERRED;

statement ok
DELETE FROM altered_in_transaction WHERE i = 1;

statement ok
INSERT INTO altered_in_transaction VALUES (1);

statement ok
COMMIT;

query I rowsort
SELECT i FROM altered_in_transaction;
----
1
2

statement ok
CREATE TABLE local_duplicates(i INTEGER);

statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO local_duplicates VALUES (1), (1);

statement ok
ALTER TABLE local_duplicates ADD UNIQUE(i) DEFERRED;

statement error
COMMIT;
----
Failed to commit: PRIMARY KEY or UNIQUE constraint violation: duplicate key

statement ok
INSERT INTO local_duplicates VALUES (1);

statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO local_duplicates VALUES (1);

statement ok
ALTER TABLE local_duplicates ADD UNIQUE(i) DEFERRED;

statement error
COMMIT;
----
Failed to commit: PRIMARY KEY or UNIQUE constraint violation: duplicate key

query I
SELECT count(*) FROM local_duplicates;
----
1

# the local duplicates can still be resolved before the commit
statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO local_duplicates VALUES (2), (2);

statement ok
ALTER TABLE local_duplicates ADD UNIQUE(i) DEFERRED;

statement ok
DELETE FROM local_duplicates WHERE rowid = (SELECT max(rowid) FROM local_duplicates);

statement ok
COMMIT;

query I rowsort
SELECT i FROM local_duplicates;
----
1
2

statement ok
CREATE TABLE local_nulls(i INTEGER);

statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO local_nulls VALUES (NULL);

statement error
ALTER TABLE local_nulls ADD PRIMARY KEY(i) DEFERRED;
----
NOT NULL constraint failed

statement ok
ROLLBACK;
