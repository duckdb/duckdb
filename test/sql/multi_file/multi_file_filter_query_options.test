# name: test/sql/multi_file/multi_file_filter_query_options.test
# description: Test describing the rows of a file to scan with a query in its open options
# group: [multi_file]

require parquet

statement ok
COPY (SELECT i a FROM range(10) t(i)) TO '{TEST_DIR}/filter_query_options_data.parquet'

statement ok
COPY (SELECT i a FROM range(10000) t(i)) TO '{TEST_DIR}/filter_query_options_large.parquet'

statement ok
COPY (SELECT 'x' file_path, pos FROM (VALUES (2::BIGINT), (5), (9)) t(pos)) TO '{TEST_DIR}/filter_query_options_del.parquet'

statement ok
COPY (SELECT 'x' file_path, pos, snapshot_id AS _ducklake_internal_snapshot_id FROM (VALUES (1::BIGINT, 1::BIGINT), (4, 3), (7, 5)) t(pos, snapshot_id)) TO '{TEST_DIR}/filter_query_options_del_snap.parquet'

# no query at all
query I
SELECT count(*) FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_data.parquet'}])
----
10

### a BIT value is a bitmap of the rows to scan

query I
SELECT a FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_data.parquet', 'filter_query': 'SELECT ''0101000001''::BIT'}])
----
1
3
9

# rows past the end of the bitmap are not scanned
query I
SELECT a FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_data.parquet', 'filter_query': 'SELECT ''111''::BIT'}])
----
0
1
2

# bitmaps can be combined in the query
query I
SELECT a FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_data.parquet', 'filter_query': 'SELECT ~(''0100100000''::BIT | ''0000000010''::BIT)'}])
----
0
2
3
5
6
7
9

query I
SELECT a FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_data.parquet', 'filter_query': 'SELECT bit_or(set_bit(bitstring(''0'', 10), x, 1)) FROM unnest([1, 4, 8]) t(x)'}])
----
1
4
8

# several bitmaps are combined
query I
SELECT a FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_data.parquet', 'filter_query': 'SELECT * FROM (VALUES (''1000000000''::BIT), (''0000000001''::BIT))'}])
----
0
9

# no bitmap
query I
SELECT count(*) FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_data.parquet', 'filter_query': 'SELECT NULL::BIT'}])
----
0

query I
SELECT count(*) FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_data.parquet', 'filter_query': 'SELECT ''1''::BIT WHERE false'}])
----
0

# a bitmap that scans all rows of a vector, or all but a few
query II
SELECT count(*), sum(a) FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_large.parquet', 'filter_query': 'SELECT ~bitstring(''0'', 10000)'}])
----
10000	49995000

query II
SELECT count(*), sum(a) FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_large.parquet', 'filter_query': 'SELECT ~set_bit(bitstring(''0'', 10000), 5000, 1)'}])
----
9999	49990000

query II
SELECT count(*), sum(a) FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_large.parquet', 'filter_query': 'SELECT ~set_bit(bitstring(''0'', 9999), 3, 1)'}])
----
9998	49984998

statement error
SELECT a FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_data.parquet', 'filter_query': 'SELECT * FROM (VALUES (''10''::BIT), (''100''::BIT))'}])
----
bitmaps of different sizes

### two BIGINT columns are the ranges of rows to scan

query I
SELECT a FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_data.parquet', 'filter_query': 'SELECT 2::BIGINT AS row_start, 5::BIGINT AS row_end'}])
----
2
3
4

# ranges can be in any order, overlap and touch
query I
SELECT a FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_data.parquet', 'filter_query': 'SELECT * FROM (VALUES (6::BIGINT, 8::BIGINT), (0::BIGINT, 2::BIGINT), (1::BIGINT, 3::BIGINT), (3::BIGINT, 4::BIGINT))'}])
----
0
1
2
3
6
7

# a NULL start is the start of the file and a NULL end the end of the file
query I
SELECT a FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_data.parquet', 'filter_query': 'SELECT * FROM (VALUES (NULL::BIGINT, 2::BIGINT), (7::BIGINT, NULL::BIGINT))'}])
----
0
1
7
8
9

query I
SELECT count(*) FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_data.parquet', 'filter_query': 'SELECT NULL::BIGINT, NULL::BIGINT'}])
----
10

# the end of the range truncates the file
query I
SELECT count(*) FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_data.parquet', 'filter_query': 'SELECT 0::BIGINT, 6::BIGINT'}])
----
6

# empty ranges, reversed ranges and ranges past the end of the file
query I
SELECT a FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_data.parquet', 'filter_query': 'SELECT * FROM (VALUES (3::BIGINT, 3::BIGINT), (6::BIGINT, 4::BIGINT), (-5::BIGINT, 1::BIGINT), (8::BIGINT, 100::BIGINT), (200::BIGINT, 300::BIGINT))'}])
----
0
8
9

query I
SELECT count(*) FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_data.parquet', 'filter_query': 'SELECT 1::BIGINT, 2::BIGINT WHERE false'}])
----
0

# counts are not answered from the metadata of the file
query I
SELECT count(*) FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_data.parquet', 'filter_query': 'SELECT 1::BIGINT, 3::BIGINT'}])
----
2

# the ranges between deleted positions
query I
SELECT a FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_data.parquet', 'filter_query': 'WITH deleted AS (SELECT DISTINCT unnest([5, 2, 9, 2])::BIGINT AS pos) SELECT coalesce(lag(pos) OVER (ORDER BY pos) + 1, 0) AS row_start, pos AS row_end FROM deleted UNION ALL SELECT coalesce(max(pos) + 1, 0), NULL::BIGINT FROM deleted'}])
----
0
1
3
4
6
7
8

# no deleted positions: all of the file
query I
SELECT count(*) FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_data.parquet', 'filter_query': 'WITH deleted AS (SELECT 1::BIGINT AS pos WHERE false) SELECT coalesce(lag(pos) OVER (ORDER BY pos) + 1, 0) AS row_start, pos AS row_end FROM deleted UNION ALL SELECT coalesce(max(pos) + 1, 0), NULL::BIGINT FROM deleted'}])
----
10

# a delete file
query I
SELECT a FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_data.parquet', 'filter_query': 'WITH deleted AS (SELECT DISTINCT pos FROM read_parquet(''{TEST_DIR}/filter_query_options_del.parquet'')) SELECT coalesce(lag(pos) OVER (ORDER BY pos) + 1, 0) AS row_start, pos AS row_end FROM deleted UNION ALL SELECT coalesce(max(pos) + 1, 0), NULL::BIGINT FROM deleted'}])
----
0
1
3
4
6
7
8

# a delete file with snapshot ids, filtered to a snapshot, next to deletes that apply in every snapshot
query I
SELECT a FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_data.parquet', 'filter_query': 'WITH deleted AS (SELECT DISTINCT pos FROM (SELECT pos FROM read_parquet(''{TEST_DIR}/filter_query_options_del_snap.parquet'') WHERE _ducklake_internal_snapshot_id <= 3 UNION ALL SELECT 9::BIGINT)) SELECT coalesce(lag(pos) OVER (ORDER BY pos) + 1, 0) AS row_start, pos AS row_end FROM deleted UNION ALL SELECT coalesce(max(pos) + 1, 0), NULL::BIGINT FROM deleted'}])
----
0
2
3
5
6
7
8

# ranges span several vectors
query II
SELECT count(*), sum(a) FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_large.parquet', 'filter_query': 'SELECT * FROM (VALUES (0::BIGINT, 5000::BIGINT), (7000::BIGINT, NULL::BIGINT))'}])
----
8000	37996000

query II
SELECT count(*), sum(a) FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_large.parquet', 'filter_query': 'SELECT 1000::BIGINT, 1010::BIGINT'}])
----
10	10045

### errors

statement error
SELECT * FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_data.parquet', 'filter_query': 'SELECT * FROM read_parquet(''{TEST_DIR}/does_not_exist.parquet'')'}])
----
Failed to read the filter query of file

# row ids are not a result of a query
statement error
SELECT a FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_data.parquet', 'filter_query': 'SELECT 7'}])
----
must return a BIT, or two BIGINT columns

statement error
SELECT a FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_data.parquet', 'filter_query': 'SELECT 1::INTEGER, 2::INTEGER'}])
----
must return a BIT, or two BIGINT columns

statement error
SELECT a FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_options_data.parquet', 'filter_query': 'SELECT 1, 2, 3'}])
----
must return a BIT, or two BIGINT columns
