{{'x': 1}={'p': 1, 'n': NULL}}	{{'x': 1}={'p': 1, 'n': NULL}}

# with a default that is not NULL the mapping gives the default and the cast NULL
statement ok
SET VARIABLE map_schema = MAP {
	'kn': {name: 'kn', type: 'MAP(STRUCT(x INTEGER), STRUCT(p BIGINT, n BIGINT))', default_value: NULL, children: MAP {
		'key': {name: 'key', type: 'STRUCT(x INTEGER)', default_value: NULL, children: NULL},
		'value': {name: 'value', type: 'STRUCT(p BIGINT, n BIGINT)', default_value: NULL, children: MAP {
			'p': {name: 'p', type: 'BIGINT', default_value: NULL, children: NULL},
			'zz': {name: 'n', type: 'BIGINT', default_value: 7, children: NULL}}}}}
};

statement error
SELECT kn FROM more_duckdb();
----
<REGEX>:Binder Error:.*the map has to be cast as a whole, which does not map its value the way the schema declares it.*

query I
SELECT kn FROM more_parquet();
----
{{'x': 1}={'p': 1, 'n': 7}}

# a subset of the fields of a struct key can make keys equal. The cast of the map checks its keys, the mapping
# does not
statement ok
SET VARIABLE map_schema = MAP {
	'kc': {name: 'kc', type: 'MAP(STRUCT(p INTEGER), STRUCT(x INTEGER))', default_value: NULL, children: MAP {
		'key': {name: 'key', type: 'STRUCT(p INTEGER)', default_value: NULL, children: MAP {
			'p': {name: 'p', type: 'INTEGER', default_value: NULL, children: NULL}}},
		'value': {name: 'value', type: 'STRUCT(x INTEGER)', default_value: NULL, children: NULL}}}
};

statement error
SELECT kc FROM more_duckdb();
----
<REGEX>:Conversion Error:.*Map keys must be unique.*

query II
SELECT map_keys(kc), map_values(kc) FROM more_parquet();
----
[{'p': 1}, {'p': 1}]	[{'x': 1}, {'x': 2}]

# a list value with a text element and a map value with a text value: the mapping casts them as well
statement ok
SET VARIABLE map_schema = MAP {
	'tl': {name: 'tl', type: 'MAP(STRUCT(x INTEGER), STRUCT(a BIGINT)[])', default_value: NULL, children: MAP {
		'key': {name: 'key', type: 'STRUCT(x INTEGER)', default_value: NULL, children: NULL},
		'value': {name: 'value', type: 'STRUCT(a BIGINT)[]', default_value: NULL, children: MAP {
			'list': {name: 'element', type: 'STRUCT(a BIGINT)', default_value: NULL, children: MAP {
				'a': {name: 'a', type: 'BIGINT', default_value: NULL, children: NULL}}}}}}},
	'tm': {name: 'tm', type: 'MAP(STRUCT(x INTEGER), MAP(VARCHAR, STRUCT(a BIGINT)))', default_value: NULL, children: MAP {
		'key': {name: 'key', type: 'STRUCT(x INTEGER)', default_value: NULL, children: NULL},
		'value': {name: 'value', type: 'MAP(VARCHAR, STRUCT(a BIGINT))', default_value: NULL, children: MAP {
			'key': {name: 'key', type: 'VARCHAR', default_value: NULL, children: NULL},
			'value': {name: 'value', type: 'STRUCT(a BIGINT)', default_value: NULL, children: MAP {
				'a': {name: 'a', type: 'BIGINT', default_value: NULL, children: NULL}}}}}}}
};

