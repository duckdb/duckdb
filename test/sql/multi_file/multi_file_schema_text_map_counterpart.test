----
<REGEX>:Binder Error:.*Can't remap type UNION\(v INTEGER, w VARCHAR\).*

# without declared children the map is cast
statement ok
SET VARIABLE map_schema = MAP {
	'ka': {name: 'ka', type: 'MAP(STRUCT(x INTEGER), STRUCT(p INTEGER))', default_value: NULL, children: NULL},
	'ku': {name: 'ku', type: 'MAP(STRUCT(x INTEGER), UNION(v INTEGER, w VARCHAR))', default_value: NULL, children: NULL}
};

