# the key of the inner map under an identifier the file does not have, default NULL: the inner map is not read as
# declared, which is the binder error of the cast map. A Parquet file raises the error of the key default
statement ok
SET VARIABLE map_schema = MAP {
	'tm': {name: 'tm', type: 'MAP(STRUCT(x INTEGER), MAP(VARCHAR, STRUCT(a BIGINT)))', default_value: NULL, children: MAP {
		'key': {name: 'key', type: 'STRUCT(x INTEGER)', default_value: NULL, children: NULL},
		'value': {name: 'value', type: 'MAP(VARCHAR, STRUCT(a BIGINT))', default_value: NULL, children: MAP {
			'zz': {name: 'key', type: 'VARCHAR', default_value: NULL, children: NULL},
			'value': {name: 'value', type: 'STRUCT(a BIGINT)', default_value: NULL, children: NULL}}}}}
};

statement error
SELECT tm FROM more_duckdb();
----
<REGEX>:Binder Error:.*the map has to be cast as a whole, which does not map its value the way the schema declares it.*

statement error
SELECT tm FROM more_parquet();
----
<REGEX>:Invalid Input Error:.*'key' of MAP did not map to a value and the registered DEFAULT is NULL.*

# an ARRAY field or a UNION in the other component: remap_struct indexes the whole type of a column it remaps and
# does not know their children, so the mapping cannot be bound, whether the field is declared or not
statement ok
SET VARIABLE map_schema = MAP {
	'ka': {name: 'ka', type: 'MAP(STRUCT(x INTEGER), STRUCT(p INTEGER))', default_value: NULL, children: MAP {
		'key': {name: 'key', type: 'STRUCT(x INTEGER)', default_value: NULL, children: NULL},
		'value': {name: 'value', type: 'STRUCT(p INTEGER)', default_value: NULL, children: MAP {
			'p': {name: 'p', type: 'INTEGER', default_value: NULL, children: NULL}}}}}
};

statement error
SELECT ka FROM more_duckdb();
----
<REGEX>:Binder Error:.*the map has to be cast as a whole, which does not map its value the way the schema declares it.*

statement error
SELECT ka FROM more_shaped();
----
<REGEX>:Binder Error:.*Can't remap type INTEGER\[2\].*

