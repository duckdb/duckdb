# the cast map in a struct, in a list and in a map: the levels above are mapped
statement ok
SET VARIABLE map_schema = MAP {
	's': {name: 's', type: 'STRUCT(m MAP(STRUCT(x INTEGER), STRUCT(q VARCHAR, p BIGINT)), rb INTEGER)', default_value: NULL, children: MAP {
		'm': {name: 'm', type: 'MAP(STRUCT(x INTEGER), STRUCT(q VARCHAR, p BIGINT))', default_value: NULL, children: MAP {
			'key': {name: 'key', type: 'STRUCT(x INTEGER)', default_value: NULL, children: NULL},
			'value': {name: 'value', type: 'STRUCT(q VARCHAR, p BIGINT)', default_value: NULL, children: MAP {
				'q': {name: 'q', type: 'VARCHAR', default_value: NULL, children: NULL},
				'p': {name: 'p', type: 'BIGINT', default_value: NULL, children: NULL}}}}},
		'b': {name: 'rb', type: 'INTEGER', default_value: NULL, children: NULL}}},
	'l': {name: 'l', type: 'MAP(STRUCT(x INTEGER), STRUCT(q VARCHAR, p BIGINT))[]', default_value: NULL, children: MAP {
		'list': {name: 'element', type: 'MAP(STRUCT(x INTEGER), STRUCT(q VARCHAR, p BIGINT))', default_value: NULL, children: MAP {
			'key': {name: 'key', type: 'STRUCT(x INTEGER)', default_value: NULL, children: NULL},
			'value': {name: 'value', type: 'STRUCT(q VARCHAR, p BIGINT)', default_value: NULL, children: MAP {
				'q': {name: 'q', type: 'VARCHAR', default_value: NULL, children: NULL},
				'p': {name: 'p', type: 'BIGINT', default_value: NULL, children: NULL}}}}}}},
	'mm': {name: 'mm', type: 'MAP(VARCHAR, MAP(STRUCT(x INTEGER), STRUCT(q VARCHAR, p BIGINT)))', default_value: NULL, children: MAP {
		'key': {name: 'key', type: 'VARCHAR', default_value: NULL, children: NULL},
		'value': {name: 'value', type: 'MAP(STRUCT(x INTEGER), STRUCT(q VARCHAR, p BIGINT))', default_value: NULL, children: MAP {
			'key': {name: 'key', type: 'STRUCT(x INTEGER)', default_value: NULL, children: NULL},
			'value': {name: 'value', type: 'STRUCT(q VARCHAR, p BIGINT)', default_value: NULL, children: MAP {
				'q': {name: 'q', type: 'VARCHAR', default_value: NULL, children: NULL},
				'p': {name: 'p', type: 'BIGINT', default_value: NULL, children: NULL}}}}}}}
};

