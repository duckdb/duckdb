	'ta': {name: 'ta', type: 'MAP(VARCHAR, STRUCT(a INTEGER[2]))', default_value: NULL, children: MAP {
		'key': {name: 'key', type: 'VARCHAR', default_value: NULL, children: NULL},
		'value': {name: 'value', type: 'STRUCT(a INTEGER[2])', default_value: NULL, children: MAP {
			'a': {name: 'a', type: 'INTEGER[2]', default_value: NULL, children: NULL}}}}}
};

