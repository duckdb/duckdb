	'ku': {name: 'ku', type: 'MAP(STRUCT(x INTEGER), UNION(v INTEGER, w VARCHAR))', default_value: NULL, children: MAP {
		'key': {name: 'key', type: 'STRUCT(x INTEGER)', default_value: NULL, children: NULL},
		'value': {name: 'value', type: 'UNION(v INTEGER, w VARCHAR)', default_value: NULL, children: NULL}}}
};

