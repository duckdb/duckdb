	'kw': {name: 'kw', type: 'MAP(STRUCT(x INTEGER), STRUCT(p TINYINT))', default_value: NULL, children: MAP {
		'key': {name: 'key', type: 'STRUCT(x INTEGER)', default_value: NULL, children: NULL},
		'value': {name: 'value', type: 'STRUCT(p TINYINT)', default_value: NULL, children: MAP {
