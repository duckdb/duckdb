{k={'a': [1, 2]}}

# a NULL-typed key beside a text value, as for a map that is empty in every row: the map is cast. A Parquet file
# takes the NULL default for the key, which is not allowed
statement ok
ATTACH '{TEMP_DIR}/text_counterpart_null_key.db' AS file_db;

statement ok
CREATE TABLE file_db.tbl AS SELECT MAP {}::MAP("NULL", VARCHAR) AS m;

statement ok
DETACH file_db;

statement ok
COPY (SELECT MAP {}::MAP("NULL", STRUCT(a BIGINT)) AS m) TO '{TEMP_DIR}/text_counterpart_null_key.parquet';

statement ok
SET VARIABLE map_schema = MAP {
	'm': {name: 'm', type: 'MAP(VARCHAR, STRUCT(a BIGINT))', default_value: NULL, children: MAP {
		'key': {name: 'key', type: 'VARCHAR', default_value: NULL, children: NULL},
		'value': {name: 'value', type: 'STRUCT(a BIGINT)', default_value: NULL, children: NULL}}}
};

query I
SELECT m FROM read_duckdb('{TEMP_DIR}/text_counterpart_null_key.db', schema = getvariable('map_schema'));
----
{}

