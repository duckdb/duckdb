# a NULL-typed field of the file is NULL for the mapping and for the cast: renamed, or under an identifier the file
# does not have with a NULL default
statement ok
SET VARIABLE map_schema = MAP {
	'kn': {name: 'kn', type: 'MAP(STRUCT(x INTEGER), STRUCT(p BIGINT, rn BIGINT))', default_value: NULL, children: MAP {
		'key': {name: 'key', type: 'STRUCT(x INTEGER)', default_value: NULL, children: NULL},
		'value': {name: 'value', type: 'STRUCT(p BIGINT, rn BIGINT)', default_value: NULL, children: MAP {
			'p': {name: 'p', type: 'BIGINT', default_value: NULL, children: NULL},
			'n': {name: 'rn', type: 'BIGINT', default_value: NULL, children: NULL}}}}}
};

