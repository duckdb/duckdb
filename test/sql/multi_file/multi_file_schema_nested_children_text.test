# protection: without declared children the Parquet list is cast as a whole
query II
SELECT lj, lv FROM read_parquet('{TEMP_DIR}/nested_text.parquet', schema = MAP {
	'lj': {name: 'lj', type: 'STRUCT(a BIGINT, b BIGINT)[]', default_value: NULL, children: NULL},
	'lv': {name: 'lv', type: 'STRUCT(a BIGINT, b BIGINT)[]', default_value: NULL, children: NULL}
});
----
[{'a': 1, 'b': 2}, {'a': 3, 'b': 4}]	[{'a': 1, 'b': 2}, NULL]