# name: test/sql/multi_file/multi_file_delete_options.test
# description: Test describing deleted rows with the open options of a file
# group: [multi_file]

require parquet

statement ok
COPY (SELECT i a FROM range(10) t(i)) TO '{TEST_DIR}/delete_options_data.parquet'

statement ok
COPY (SELECT 'x' file_path, pos FROM (VALUES (2::BIGINT), (5), (9)) t(pos)) TO '{TEST_DIR}/delete_options_del.parquet'

statement ok
COPY (SELECT 'x' file_path, pos, snapshot_id AS _ducklake_internal_snapshot_id FROM (VALUES (1::BIGINT, 1::BIGINT), (4, 3), (7, 5)) t(pos, snapshot_id)) TO '{TEST_DIR}/delete_options_del_snap.parquet'

# deleted positions given by a query
query I
SELECT a FROM read_parquet([{'filename': '{TEST_DIR}/delete_options_data.parquet', 'delete_query': 'SELECT unnest([0, 3, 4]) AS pos'}])
----
1
2
5
6
7
8
9

# unsorted and duplicate positions
query I
SELECT a FROM read_parquet([{'filename': '{TEST_DIR}/delete_options_data.parquet', 'delete_query': 'SELECT unnest([8, 1, 8]) AS pos'}])
----
0
2
3
4
5
6
7
9

# max_row_count truncates the file
query I
SELECT count(*) FROM read_parquet([{'filename': '{TEST_DIR}/delete_options_data.parquet', 'max_row_count': 6::UBIGINT}])
----
6

# a delete file
query I
SELECT a FROM read_parquet([{'filename': '{TEST_DIR}/delete_options_data.parquet', 'delete_query': 'SELECT * FROM read_parquet(''{TEST_DIR}/delete_options_del.parquet'')'}])
----
0
1
3
4
6
7
8

# a delete file with snapshot ids, filtered to a snapshot by the query
query I
SELECT a FROM read_parquet([{'filename': '{TEST_DIR}/delete_options_data.parquet', 'delete_query': 'SELECT pos FROM read_parquet(''{TEST_DIR}/delete_options_del_snap.parquet'') WHERE _ducklake_internal_snapshot_id <= 3'}])
----
0
2
3
5
6
7
8
9

# deletes from several sources
query I
SELECT a FROM read_parquet([{'filename': '{TEST_DIR}/delete_options_data.parquet', 'delete_query': 'SELECT pos FROM read_parquet(''{TEST_DIR}/delete_options_del_snap.parquet'') WHERE _ducklake_internal_snapshot_id <= 3 UNION ALL SELECT 9::BIGINT'}])
----
0
2
3
5
6
7
8

# counts are not answered from the metadata of the file
query I
SELECT count(*) FROM read_parquet([{'filename': '{TEST_DIR}/delete_options_data.parquet', 'delete_query': 'SELECT unnest([1, 2]) AS pos'}])
----
8

# no deletes at all
query I
SELECT count(*) FROM read_parquet([{'filename': '{TEST_DIR}/delete_options_data.parquet'}])
----
10

# a query without deletes
query I
SELECT count(*) FROM read_parquet([{'filename': '{TEST_DIR}/delete_options_data.parquet', 'delete_query': 'SELECT 0::BIGINT AS pos WHERE false'}])
----
10

statement error
SELECT * FROM read_parquet([{'filename': '{TEST_DIR}/delete_options_data.parquet', 'delete_query': 'SELECT * FROM read_parquet(''{TEST_DIR}/does_not_exist.parquet'')'}])
----
Failed to read the deletes of file

statement error
SELECT a FROM read_parquet([{'filename': '{TEST_DIR}/delete_options_data.parquet', 'delete_query': 'SELECT 42 AS something_else'}])
----
must return a "pos" column

# scan the rows of the delete query instead of the other rows
query I
SELECT a FROM read_parquet([{'filename': '{TEST_DIR}/delete_options_data.parquet', 'delete_query': 'SELECT unnest([7, 2, 5, 2]) AS pos', 'scan_deleted_rows': true}])
----
2
5
7

query I
SELECT count(*) FROM read_parquet([{'filename': '{TEST_DIR}/delete_options_data.parquet', 'delete_query': 'SELECT * FROM read_parquet(''{TEST_DIR}/delete_options_del.parquet'')', 'scan_deleted_rows': true}])
----
3

# the rows of the query at or past max_row_count are not part of the file
query I
SELECT a FROM read_parquet([{'filename': '{TEST_DIR}/delete_options_data.parquet', 'delete_query': 'SELECT unnest([1, 4, 8]) AS pos', 'scan_deleted_rows': true, 'max_row_count': 5::UBIGINT}])
----
1
4

query I
SELECT a FROM read_parquet([{'filename': '{TEST_DIR}/delete_options_data.parquet', 'delete_query': 'SELECT 3::BIGINT AS pos', 'scan_deleted_rows': false}])
----
0
1
2
4
5
6
7
8
9

statement error
SELECT a FROM read_parquet([{'filename': '{TEST_DIR}/delete_options_data.parquet', 'scan_deleted_rows': true}])
----
requires a "delete_query"
