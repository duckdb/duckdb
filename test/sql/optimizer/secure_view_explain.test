# name: test/sql/optimizer/secure_view_explain.test
# description: Test that EXPLAIN and EXPLAIN ANALYZE do not expose the internals of a secure view
# group: [optimizer]

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

statement ok
CREATE TABLE hidden_table AS SELECT i, i % 10 AS j, ('hidden' || i) AS s FROM range(10000) t(i);

statement ok
CREATE TABLE other AS SELECT i, i * 2 AS k FROM range(500) t(i);

# a view whose body contains a scan, a filter, a join and an aggregate - none of which may show up in any plan
statement ok
CREATE SECURE VIEW secure_view AS
    SELECT hidden_table.j, count(*) AS c, max(other.k) AS mk
    FROM hidden_table JOIN other ON hidden_table.i = other.i
    WHERE hidden_table.j <> 7
    GROUP BY hidden_table.j;

statement ok
CREATE VIEW regular_view AS
    SELECT hidden_table.j, count(*) AS c, max(other.k) AS mk
    FROM hidden_table JOIN other ON hidden_table.i = other.i
    WHERE hidden_table.j <> 7
    GROUP BY hidden_table.j;

# the regular view exposes its internals
query II
EXPLAIN SELECT * FROM regular_view WHERE c > 0
----
physical_plan	<REGEX>:[\s\S]*hidden_table[\s\S]*

# the secure view exposes nothing but its own name
query II
EXPLAIN SELECT * FROM secure_view WHERE c > 0
----
physical_plan	<REGEX>:[\s\S]*SECURE_VIEW[\s\S]*View: secure_view[\s\S]*

query II
EXPLAIN SELECT * FROM secure_view WHERE c > 0
----
physical_plan	<!REGEX>:[\s\S]*(hidden_table|HASH_JOIN|HASH_GROUP_BY|SEQ_SCAN|TABLE_SCAN|other)[\s\S]*

# ... in the unoptimized and optimized logical plans too
statement ok
SET explain_output='all'

query II
EXPLAIN SELECT * FROM secure_view WHERE c > 0
----
logical_plan	<!REGEX>:[\s\S]*(hidden_table|COMPARISON_JOIN|AGGREGATE|GET|other)[\s\S]*
logical_opt	<!REGEX>:[\s\S]*(hidden_table|COMPARISON_JOIN|AGGREGATE|GET|other)[\s\S]*
physical_plan	<!REGEX>:[\s\S]*(hidden_table|HASH_JOIN|HASH_GROUP_BY|SEQ_SCAN|other)[\s\S]*

statement ok
SET explain_output='physical_only'

# ... and in every other output format
query II
EXPLAIN (FORMAT json) SELECT * FROM secure_view WHERE c > 0
----
physical_plan	<!REGEX>:[\s\S]*(hidden_table|HASH_JOIN|HASH_GROUP_BY|SEQ_SCAN|TABLE_SCAN|other)[\s\S]*

query II
EXPLAIN (FORMAT json) SELECT * FROM secure_view WHERE c > 0
----
physical_plan	<REGEX>:[\s\S]*"name": "SECURE_VIEW"[\s\S]*"children": \[\][\s\S]*

query II
EXPLAIN (FORMAT yaml) SELECT * FROM secure_view WHERE c > 0
----
physical_plan	<!REGEX>:[\s\S]*(hidden_table|HASH_JOIN|HASH_GROUP_BY|SEQ_SCAN|TABLE_SCAN|other)[\s\S]*

query II
EXPLAIN (FORMAT graphviz) SELECT * FROM secure_view WHERE c > 0
----
physical_plan	<!REGEX>:[\s\S]*(hidden_table|HASH_JOIN|HASH_GROUP_BY|SEQ_SCAN|TABLE_SCAN|other)[\s\S]*

query II
EXPLAIN (FORMAT mermaid) SELECT * FROM secure_view WHERE c > 0
----
physical_plan	<!REGEX>:[\s\S]*(hidden_table|HASH_JOIN|HASH_GROUP_BY|SEQ_SCAN|TABLE_SCAN|other)[\s\S]*

# EXPLAIN ANALYZE must not expose the internals either - in any format
query II
EXPLAIN ANALYZE SELECT * FROM secure_view WHERE c > 0
----
analyzed_plan	<!REGEX>:[\s\S]*(hidden_table|HASH_JOIN|HASH_GROUP_BY|SEQ_SCAN|TABLE_SCAN|other)[\s\S]*

query II
EXPLAIN ANALYZE SELECT * FROM secure_view WHERE c > 0
----
analyzed_plan	<REGEX>:[\s\S]*SECURE_VIEW[\s\S]*View: secure_view[\s\S]*

query II
EXPLAIN ANALYZE (FORMAT json) SELECT * FROM secure_view WHERE c > 0
----
analyzed_plan	<!REGEX>:[\s\S]*(hidden_table|HASH_JOIN|HASH_GROUP_BY|SEQ_SCAN|TABLE_SCAN|"other")[\s\S]*

# the timings and metrics of the operators inside the view are reported on the secure view node itself, so the
# secure view accounts for all rows produced inside it rather than reporting nothing
query II
EXPLAIN ANALYZE (FORMAT json) SELECT * FROM secure_view WHERE c > 0
----
analyzed_plan	<REGEX>:[\s\S]*"type": "SECURE_VIEW"[\s\S]*

statement ok
CREATE SECURE VIEW counting_view AS SELECT * FROM hidden_table WHERE j = 3;

# the view returns 1000 rows, so a secure view that only reported its own metrics would show "1,000 rows". Reporting
# more than that proves the metrics of the operators inside the view were folded into the secure view node.
query II
EXPLAIN ANALYZE SELECT * FROM counting_view
----
analyzed_plan	<REGEX>:[\s\S]*SECURE_VIEW[\s\S]* [2-9],[0-9]{3} rows[\s\S]*

# results are unaffected
query III
SELECT * FROM secure_view WHERE j = 1 ORDER BY j
----
1	50	982

query I
SELECT count(*) FROM counting_view
----
1000
