# name: test/sql/optimizer/variant_cast_pushdown_discrepancies.test
# description: Reproduce differences between pushed-down casts and VARIANT cast semantics
# group: [optimizer]

require parquet

# These expectations document current discrepancies, not the desired cast semantics.
# The same logical VARIANT should cast identically regardless of pushdown or storage layout.
load {TEST_DIR}/variant_cast_pushdown_discrepancies.db readwrite v1.5.0

statement ok
SET variant_minimum_shredding_size = 0;

statement ok
CREATE TABLE cast_cases AS
SELECT {
    'leading_zero': '001',
    'fractional': '1.5',
    'boolean_digit': '1',
    'datetime': '2026-01-01 12:34:56',
    'enum_value': 'foo',
    'union_value': 42::INTEGER
}::VARIANT AS v;

statement ok
COPY cast_cases TO '{TEST_DIR}/variant_cast_shredded.parquet'
(SHREDDING {'v': 'STRUCT(leading_zero VARCHAR, fractional VARCHAR, boolean_digit VARCHAR, datetime VARCHAR, enum_value VARCHAR, union_value INTEGER)'});

statement ok
COPY cast_cases TO '{TEST_DIR}/variant_cast_unshredded.parquet'
(SHREDDING {'v': 'NULL'});

statement ok
CHECKPOINT;

# Reopen so native scans read the persisted shredded representation.
restart

foreach SOURCE cast_cases read_parquet('{TEST_DIR}/variant_cast_shredded.parquet')

# Keep CAST and TRY_CAST in separate queries: shared references can inhibit cast pushdown.

# 1. The pushed VARCHAR -> INTEGER cast accepts leading zeros; the VARIANT cast rejects them.
statement ok
SET disabled_optimizers = '';

query I
SELECT v.leading_zero::INTEGER FROM {SOURCE};
----
1

# TRY_CAST preserves VARIANT semantics even with the optimizer enabled.
query I
SELECT TRY_CAST(v.leading_zero AS INTEGER) FROM {SOURCE};
----
NULL

statement ok
SET disabled_optimizers = 'unused_columns';

statement error
SELECT v.leading_zero::INTEGER FROM {SOURCE};
----
Can't convert VARIANT(VARCHAR) value '001' to 'INTEGER'

# 2. The pushed VARCHAR -> INTEGER cast rounds fractional text; the VARIANT cast rejects it.
statement ok
SET disabled_optimizers = '';

query I
SELECT v.fractional::INTEGER FROM {SOURCE};
----
2

query I
SELECT TRY_CAST(v.fractional AS INTEGER) FROM {SOURCE};
----
NULL

statement ok
SET disabled_optimizers = 'unused_columns';

statement error
SELECT v.fractional::INTEGER FROM {SOURCE};
----
Can't convert VARIANT(VARCHAR) value '1.5' to 'INTEGER'

# 3. The pushed VARCHAR -> BOOLEAN cast accepts '1'; the VARIANT cast rejects it.
statement ok
SET disabled_optimizers = '';

query I
SELECT v.boolean_digit::BOOLEAN FROM {SOURCE};
----
true

statement ok
SET disabled_optimizers = 'unused_columns';

statement error
SELECT v.boolean_digit::BOOLEAN FROM {SOURCE};
----
Can't convert VARIANT(VARCHAR) value '1' to 'BOOLEAN'

# 4. Leading zeros also succeed through the pushed DOUBLE cast but fail through VARIANT.
statement ok
SET disabled_optimizers = '';

query R
SELECT v.leading_zero::DOUBLE FROM {SOURCE};
----
1.0

statement ok
SET disabled_optimizers = 'unused_columns';

statement error
SELECT v.leading_zero::DOUBLE FROM {SOURCE};
----
Can't convert VARIANT(VARCHAR) value '001' to 'DOUBLE'

# 5. The pushed VARCHAR -> DATE cast accepts the time suffix; the VARIANT cast rejects it.
statement ok
SET disabled_optimizers = '';

query T
SELECT v.datetime::DATE FROM {SOURCE};
----
2026-01-01

statement ok
SET disabled_optimizers = 'unused_columns';

statement error
SELECT v.datetime::DATE FROM {SOURCE};
----
Can't convert VARIANT(VARCHAR) value '2026-01-01 12:34:56' to 'DATE'

# 6. Pushdown reaches a supported VARCHAR -> ENUM cast, although VARIANT -> ENUM is unsupported.
statement ok
SET disabled_optimizers = '';

query T
SELECT CAST(v.enum_value AS ENUM('foo', 'bar')) FROM {SOURCE};
----
foo

statement ok
SET disabled_optimizers = 'unused_columns';

statement error
SELECT CAST(v.enum_value AS ENUM('foo', 'bar')) FROM {SOURCE};
----
Unimplemented type for cast (VARIANT -> ENUM('foo', 'bar'))

# 7. Pushdown wraps INTEGER in a UNION, although the VARIANT cast rejects UNION targets.
statement ok
SET disabled_optimizers = '';

query T
SELECT CAST(v.union_value AS UNION(a INTEGER)) FROM {SOURCE};
----
42

statement ok
SET disabled_optimizers = 'unused_columns';

statement error
SELECT CAST(v.union_value AS UNION(a INTEGER)) FROM {SOURCE};
----
Can't convert VARIANT to 'UNION(a INTEGER)'

endloop

# Unshredded Parquet keeps the VARIANT cast in both optimizer modes.
# All seven casts fail, unlike the enabled casts on the same values in shredded storage.
foreach DISABLED_OPTIMIZERS '' 'unused_columns'

statement ok
SET disabled_optimizers = {DISABLED_OPTIMIZERS};

statement error
SELECT v.leading_zero::INTEGER FROM read_parquet('{TEST_DIR}/variant_cast_unshredded.parquet');
----
Can't convert VARIANT(VARCHAR) value '001' to 'INTEGER'

statement error
SELECT v.fractional::INTEGER FROM read_parquet('{TEST_DIR}/variant_cast_unshredded.parquet');
----
Can't convert VARIANT(VARCHAR) value '1.5' to 'INTEGER'

statement error
SELECT v.boolean_digit::BOOLEAN FROM read_parquet('{TEST_DIR}/variant_cast_unshredded.parquet');
----
Can't convert VARIANT(VARCHAR) value '1' to 'BOOLEAN'

statement error
SELECT v.leading_zero::DOUBLE FROM read_parquet('{TEST_DIR}/variant_cast_unshredded.parquet');
----
Can't convert VARIANT(VARCHAR) value '001' to 'DOUBLE'

statement error
SELECT v.datetime::DATE FROM read_parquet('{TEST_DIR}/variant_cast_unshredded.parquet');
----
Can't convert VARIANT(VARCHAR) value '2026-01-01 12:34:56' to 'DATE'

statement error
SELECT CAST(v.enum_value AS ENUM('foo', 'bar')) FROM read_parquet('{TEST_DIR}/variant_cast_unshredded.parquet');
----
Unimplemented type for cast (VARIANT -> ENUM('foo', 'bar'))

statement error
SELECT CAST(v.union_value AS UNION(a INTEGER)) FROM read_parquet('{TEST_DIR}/variant_cast_unshredded.parquet');
----
Can't convert VARIANT to 'UNION(a INTEGER)'

endloop

statement ok
RESET disabled_optimizers;
