# Aliases retain the bound single-value identity property.
query II
EXPLAIN SELECT count(*) FROM (SELECT arbitrary(k) AS k FROM nodes GROUP BY id) s JOIN edges e ON s.k = e.k;
----
logical_opt	<REGEX>:(?s).*Comparison Join[^~]*~100,000 rows.*

query II
EXPLAIN SELECT count(*) FROM (SELECT last(k) AS k FROM nodes GROUP BY id) s JOIN edges e ON s.k = e.k;
----
logical_opt	<REGEX>:(?s).*Comparison Join[^~]*~100,000 rows.*

query II
EXPLAIN SELECT count(*) FROM (SELECT any_value(k) AS k FROM nodes GROUP BY id) s JOIN edges e ON s.k = e.k;
----
logical_opt	<REGEX>:(?s).*Comparison Join[^~]*~100,000 rows.*

# A unique grouping key does not stop arg_min from rejecting a NULL selector.
query II
EXPLAIN SELECT count(*)
FROM (SELECT arg_min(x, p) AS k FROM unique_list_values GROUP BY id) l
JOIN (SELECT arg_min(x, p) AS k FROM unique_list_values_right GROUP BY id) r ON l.k = r.k;
----
logical_opt	<REGEX>:(?s).*Comparison Join[^~]*~8 rows.*

query II
EXPLAIN SELECT count(*)
FROM (SELECT min_by(x, p) AS k FROM unique_list_values GROUP BY id) l
JOIN (SELECT min_by(x, p) AS k FROM unique_list_values_right GROUP BY id) r ON l.k = r.k;
----
logical_opt	<REGEX>:(?s).*Comparison Join[^~]*~8 rows.*

query II
EXPLAIN SELECT count(*)
FROM (SELECT max_by(x, p) AS k FROM unique_list_values GROUP BY id) l
JOIN (SELECT max_by(x, p) AS k FROM unique_list_values_right GROUP BY id) r ON l.k = r.k;
----
logical_opt	<REGEX>:(?s).*Comparison Join[^~]*~8 rows.*

query I
SELECT count(*)
FROM (SELECT arg_min(x, p) AS k FROM unique_list_values GROUP BY id) l
JOIN (SELECT arg_min(x, p) AS k FROM unique_list_values_right GROUP BY id) r ON l.k = r.k;
----
0

# A CTAS input has no certified key, but first(x) still selects from the input domain.
statement ok
CREATE TABLE unconstrained_values AS SELECT * FROM unique_list_values;

statement ok
CREATE TABLE unconstrained_values_right AS SELECT * FROM unique_list_values;

statement ok
ANALYZE;

query II
EXPLAIN SELECT count(*)
FROM (SELECT first(x) AS k FROM unconstrained_values GROUP BY id) l
JOIN (SELECT first(x) AS k FROM unconstrained_values_right GROUP BY id) r ON l.k = r.k;
----
logical_opt	<REGEX>:(?s).*Comparison Join[^~]*~32 rows.*

query I
SELECT count(*)
FROM (SELECT first(x) AS k FROM unconstrained_values GROUP BY id) l
JOIN (SELECT first(x) AS k FROM unconstrained_values_right GROUP BY id) r ON l.k = r.k;
----
32

# Non-null immediate UNIQUE keys provide the same proof as a primary key.
statement ok
CREATE TABLE nonnull_unique(id INTEGER UNIQUE NOT NULL, x INTEGER);

statement ok
INSERT INTO nonnull_unique SELECT id, x FROM unique_list_values;

statement ok
CREATE TABLE nullable_unique(id INTEGER UNIQUE, x INTEGER);

statement ok
INSERT INTO nullable_unique SELECT CASE WHEN id < 2 THEN NULL ELSE id END, x FROM unique_list_values;

statement ok
CREATE TABLE composite_unique(a INTEGER NOT NULL, b INTEGER NOT NULL, x INTEGER, UNIQUE(a, b));

statement ok
INSERT INTO composite_unique SELECT id % 2, id // 2, x FROM unique_list_values;

statement ok
ANALYZE;

query II
EXPLAIN (FORMAT JSON) SELECT count(*)
FROM (SELECT min(x) AS k FROM nonnull_unique GROUP BY id) l
JOIN (SELECT min(x) AS k FROM nonnull_unique GROUP BY id) r ON l.k = r.k;
----
logical_opt	<REGEX>:(?s).*"Join Type": "INNER",\s*"Conditions": "\(k = k\)",\s*"Estimated Cardinality": "32".*

# UNIQUE accepts both NULL keys, which GROUP BY combines into one group.
query II
EXPLAIN (FORMAT JSON) SELECT count(*)
FROM (SELECT first(x ORDER BY x) AS k FROM nullable_unique GROUP BY id) l
JOIN (SELECT first(x ORDER BY x) AS k FROM nullable_unique GROUP BY id) r ON l.k = r.k;
----
logical_opt	<REGEX>:(?s).*"Join Type": "INNER",\s*"Conditions": "\(k = k\)",\s*"Estimated Cardinality": "6".*

query I
SELECT count(*)
FROM (SELECT first(x ORDER BY x) AS k FROM nullable_unique GROUP BY id) l
JOIN (SELECT first(x ORDER BY x) AS k FROM nullable_unique GROUP BY id) r ON l.k = r.k;
----
25

# A composite key must be completely covered by the grouping expressions.
query II
EXPLAIN (FORMAT JSON) SELECT count(*)
FROM (SELECT min(x) AS k FROM composite_unique GROUP BY a, b) l
JOIN (SELECT min(x) AS k FROM composite_unique GROUP BY a, b) r ON l.k = r.k;
----
logical_opt	<REGEX>:(?s).*"Join Type": "INNER",\s*"Conditions": "\(k = k\)",\s*"Estimated Cardinality": "32".*

query II
EXPLAIN (FORMAT JSON) SELECT count(*)
FROM (SELECT min(x) AS k FROM composite_unique GROUP BY a) l
JOIN (SELECT min(x) AS k FROM composite_unique GROUP BY a) r ON l.k = r.k;
----
logical_opt	<REGEX>:(?s).*"Join Type": "INNER",\s*"Conditions": "\(k = k\)",\s*"Estimated Cardinality": "2".*

# Casting a key to BOOLEAN can merge distinct key values.
query II
EXPLAIN SELECT count(*)
FROM (SELECT min(x) AS k FROM unique_list_values GROUP BY CAST(id AS BOOLEAN)) l
JOIN (SELECT min(x) AS k FROM unique_list_values_right GROUP BY CAST(id AS BOOLEAN)) r ON l.k = r.k;
----
logical_opt	<REGEX>:(?s).*Comparison Join[^~]*~4 rows.*

# TRY_CAST can turn distinct key values into NULL and cannot certify uniqueness.
query II
EXPLAIN SELECT count(*)
FROM (SELECT min(x) AS k FROM unique_list_values GROUP BY TRY_CAST(id AS TINYINT)) l
JOIN (SELECT min(x) AS k FROM unique_list_values_right GROUP BY TRY_CAST(id AS TINYINT)) r ON l.k = r.k;
----
logical_opt	<REGEX>:(?s).*Comparison Join[^~]*~4 rows.*

# Joins can multiply a key's rows and must invalidate the singleton proof.
query II
EXPLAIN SELECT count(*)
FROM (SELECT min(v.x) AS k FROM unique_list_values v CROSS JOIN range(2) t(i) GROUP BY v.id) l
JOIN (SELECT min(v.x) AS k FROM unique_list_values_right v CROSS JOIN range(2) t(i) GROUP BY v.id) r ON l.k = r.k;
----
logical_opt	<REGEX>:(?s).*Comparison Join[^~]*~8 rows.*

query I
SELECT count(*)
FROM (SELECT min(v.x) AS k FROM unique_list_values v CROSS JOIN range(2) t(i) GROUP BY v.id) l
JOIN (SELECT min(v.x) AS k FROM unique_list_values_right v CROSS JOIN range(2) t(i) GROUP BY v.id) r ON l.k = r.k;
----
32

# The ordered rewrite must retain identity on the bound expression only.
query II
EXPLAIN SELECT count(*)
FROM (SELECT first(x ORDER BY p) AS k FROM unique_list_values GROUP BY id) l
JOIN (SELECT last(x ORDER BY p) AS k FROM unique_list_values_right GROUP BY id) r ON l.k = r.k;
----
logical_opt	<REGEX>:(?s).*Comparison Join[^~]*~32 rows.*

query II
EXPLAIN SELECT count(*)
FROM (SELECT any_value(x ORDER BY p) AS k FROM unique_list_values GROUP BY id) l
JOIN (SELECT any_value(x ORDER BY p) AS k FROM unique_list_values_right GROUP BY id) r ON l.k = r.k;
----
logical_opt	<REGEX>:(?s).*Comparison Join[^~]*~32 rows.*

query II
EXPLAIN SELECT count(*)
FROM (SELECT arg_min_null(x, p) AS k FROM unique_list_values GROUP BY id) l
JOIN (SELECT arg_max_null(x, p) AS k FROM unique_list_values_right GROUP BY id) r ON l.k = r.k;
----
logical_opt	<REGEX>:(?s).*Comparison Join[^~]*~8 rows.*

# Every group selects the common value from an otherwise larger input domain.
statement ok
CREATE TABLE biased_nodes AS
SELECT g::INT AS g, p::INT AS p, CASE WHEN p = 0 THEN 0 ELSE 2 * g + 1 END::INT AS k
FROM range(4) g_values(g), range(2) p_values(p);

statement ok
CREATE TABLE biased_edges AS SELECT ((i % 3) * 3)::INT AS k FROM range(12) t(i);

statement ok
ANALYZE;

query II
EXPLAIN SELECT count(*)
FROM (SELECT DISTINCT ON (g) k FROM biased_nodes ORDER BY g, p) s
JOIN biased_edges e ON s.k = e.k;
----
logical_opt	<REGEX>:(?s).*Comparison Join[^~]*~16 rows.*

query I
SELECT count(*)
FROM (SELECT DISTINCT ON (g) k FROM biased_nodes ORDER BY g, p) s
JOIN biased_edges e ON s.k = e.k;
----
16

# Computed CTE keys remain ineligible even when each group contains one row.
statement ok
CREATE TABLE ids_left AS SELECT i::INT AS id FROM range(8) t(i);

statement ok
CREATE TABLE ids_right AS SELECT i::INT AS id FROM range(4) t(i);

statement ok
ANALYZE;

query II
EXPLAIN (FORMAT JSON)
WITH lhs AS MATERIALIZED (SELECT id, id % 2 AS k FROM ids_left),
     rhs AS MATERIALIZED (SELECT id % 2 AS k FROM ids_right)
SELECT count(*) FROM (SELECT min(k) AS k FROM lhs GROUP BY id) s JOIN rhs r ON s.k = r.k;
----
logical_opt	<REGEX>:(?s).*"Join Type": "INNER",\s*"Conditions": "\(k = k\)",\s*"Estimated Cardinality": "8".*

query I
WITH lhs AS MATERIALIZED (SELECT id, id % 2 AS k FROM ids_left),
     rhs AS MATERIALIZED (SELECT id % 2 AS k FROM ids_right)
SELECT count(*) FROM (SELECT min(k) AS k FROM lhs GROUP BY id) s JOIN rhs r ON s.k = r.k;
----
16

# Ordinary injective casts retain the singleton proof.
query II
EXPLAIN SELECT count(*), sum(l.z + r.z)
FROM (SELECT min(x) AS k, max(id) AS z FROM unique_list_values GROUP BY id::BIGINT) l
JOIN (SELECT min(x) AS k, max(id) AS z FROM unique_list_values_right GROUP BY id::BIGINT) r USING (k);
----
logical_opt	<REGEX>:(?s).*Comparison Join[^~]*~32 rows.*

query II
SELECT count(*), sum(l.z + r.z)
FROM (SELECT min(x) AS k, max(id) AS z FROM unique_list_values GROUP BY id::BIGINT) l
JOIN (SELECT min(x) AS k, max(id) AS z FROM unique_list_values_right GROUP BY id::BIGINT) r USING (k);
----
32	224

# Common-subplan extraction retains the domains in a self join as well.
query II
EXPLAIN (FORMAT JSON) SELECT count(*), sum(l.z + r.z)
FROM (SELECT min(x) AS k, max(id) AS z FROM unique_list_values GROUP BY id::BIGINT) l
JOIN (SELECT min(x) AS k, max(id) AS z FROM unique_list_values GROUP BY id::BIGINT) r USING (k);
----
logical_opt	<REGEX>:(?s).*"Join Type": "INNER",\s*"Conditions": "\(k = k\)",\s*"Estimated Cardinality": "32".*

# Successful strict narrowing casts are injective too.
query II
EXPLAIN SELECT count(*), sum(l.z + r.z)
FROM (SELECT min(x) AS k, max(id) AS z FROM unique_list_values GROUP BY id::TINYINT) l
JOIN (SELECT min(x) AS k, max(id) AS z FROM unique_list_values_right GROUP BY id::TINYINT) r USING (k);
----
logical_opt	<REGEX>:(?s).*Comparison Join[^~]*~32 rows.*

statement ok
CREATE TABLE overflowing_keys(id INTEGER PRIMARY KEY, x INTEGER);

statement ok
INSERT INTO overflowing_keys VALUES (128, 0), (129, 1);

statement error
SELECT first(x) FROM overflowing_keys GROUP BY id::TINYINT;
----
out of range

# Both overflowing TRY_CAST keys become NULL and form one group.
query II
EXPLAIN (FORMAT JSON) SELECT count(*)
FROM (SELECT first(x ORDER BY id) AS k FROM overflowing_keys GROUP BY TRY_CAST(id AS TINYINT)) l
JOIN (SELECT first(x ORDER BY id) AS k FROM overflowing_keys GROUP BY TRY_CAST(id AS TINYINT)) r USING (k);
----
logical_opt	<REGEX>:(?s).*"Join Type": "INNER",\s*"Conditions": "\(k = k\)",\s*"Estimated Cardinality": "1".*

query I
SELECT count(*)
FROM (SELECT first(x ORDER BY id) AS k FROM overflowing_keys GROUP BY TRY_CAST(id AS TINYINT)) l
JOIN (SELECT first(x ORDER BY id) AS k FROM overflowing_keys GROUP BY TRY_CAST(id AS TINYINT)) r USING (k);
----
1

# Keep the grouping sets in a single aggregate to exercise the singleton check.
statement ok
SET disabled_optimizers='grouping_sets';

# A subtotal can combine distinct primary keys.
query II
EXPLAIN SELECT count(*)
FROM (SELECT first(x ORDER BY id) AS k FROM unique_list_values GROUP BY GROUPING SETS ((id), ())) l
JOIN (SELECT first(x ORDER BY id) AS k FROM unique_list_values_right GROUP BY GROUPING SETS ((id), ())) r USING (k);
----
logical_opt	<REGEX>:(?s).*Comparison Join[^~]*~8 rows.*

query I
SELECT count(*)
FROM (SELECT first(x ORDER BY id) AS k FROM unique_list_values GROUP BY GROUPING SETS ((id), ())) l
JOIN (SELECT first(x ORDER BY id) AS k FROM unique_list_values_right GROUP BY GROUPING SETS ((id), ())) r USING (k);
----
41

# Repeated grouping sets emit each key twice.
query II
EXPLAIN SELECT count(*)
FROM (SELECT min(x) AS k FROM unique_list_values GROUP BY GROUPING SETS ((id), (id))) l
JOIN (SELECT min(x) AS k FROM unique_list_values_right GROUP BY GROUPING SETS ((id), (id))) r USING (k);
----
logical_opt	<REGEX>:(?s).*Comparison Join[^~]*~8 rows.*

query I
SELECT count(*)
FROM (SELECT min(x) AS k FROM unique_list_values GROUP BY GROUPING SETS ((id), (id))) l
JOIN (SELECT min(x) AS k FROM unique_list_values_right GROUP BY GROUPING SETS ((id), (id))) r USING (k);
----
128

statement ok
RESET disabled_optimizers;

# The grouping alias can coexist with another projection of its source key.
query II
EXPLAIN SELECT count(*), sum(l.z + r.z)
FROM (SELECT min(x) AS k, max(id) AS z
      FROM (SELECT id::BIGINT AS gid, id, x FROM unique_list_values) p GROUP BY gid) l
JOIN (SELECT min(x) AS k, max(id) AS z
      FROM (SELECT id::BIGINT AS gid, id, x FROM unique_list_values_right) p GROUP BY gid) r USING (k);
----
logical_opt	<REGEX>:(?s).*Comparison Join[^~]*~32 rows.*

query II
EXPLAIN SELECT count(*), sum(l.z + r.z)
FROM (SELECT min(x) AS k, max(id) AS z
      FROM (SELECT id AS gid, id, x FROM unique_list_values) p GROUP BY gid) l
JOIN (SELECT min(x) AS k, max(id) AS z
      FROM (SELECT id AS gid, id, x FROM unique_list_values_right) p GROUP BY gid) r USING (k);
----
logical_opt	<REGEX>:(?s).*Comparison Join[^~]*~32 rows.*

query II
EXPLAIN SELECT count(*), sum(l.z + r.z)
FROM (SELECT min(x) AS k, max(id) AS z FROM unique_list_values GROUP BY id::BIGINT::HUGEINT) l
JOIN (SELECT min(x) AS k, max(id) AS z FROM unique_list_values_right GROUP BY id::BIGINT::HUGEINT) r USING (k);
----
logical_opt	<REGEX>:(?s).*Comparison Join[^~]*~32 rows.*

# Retain a window output so pruning cannot remove the window boundary.
query II
EXPLAIN SELECT count(*), sum(l.z + r.z), sum(l.w + r.w)
FROM (SELECT min(x) AS k, max(id) AS z, max(rn) AS w
      FROM (SELECT *, row_number() OVER (ORDER BY x, id DESC) AS rn FROM unique_list_values) p GROUP BY id) l
JOIN (SELECT min(x) AS k, max(id) AS z, max(rn) AS w
      FROM (SELECT *, row_number() OVER (ORDER BY x, id DESC) AS rn FROM unique_list_values_right) p GROUP BY id) r USING (k);
----
logical_opt	<REGEX>:(?s).*Comparison Join[^~]*~32 rows.*Window.*

query III
SELECT count(*), sum(l.z + r.z), sum(l.w + r.w)
FROM (SELECT min(x) AS k, max(id) AS z, max(rn) AS w
      FROM (SELECT *, row_number() OVER (ORDER BY x, id DESC) AS rn FROM unique_list_values) p GROUP BY id) l
JOIN (SELECT min(x) AS k, max(id) AS z, max(rn) AS w
      FROM (SELECT *, row_number() OVER (ORDER BY x, id DESC) AS rn FROM unique_list_values_right) p GROUP BY id) r USING (k);
----
32	224	288

# Temporary tables support deferred constraints with v1 storage.
# Keep this last so earlier cases can still exercise forced restarts.
statement ok
CREATE TEMP TABLE deferred_unique(id INTEGER PRIMARY KEY DEFERRED, x INTEGER);

statement ok
INSERT INTO deferred_unique SELECT id, x FROM unique_list_values;

statement ok
ANALYZE deferred_unique;

# Deferred keys do not certify singleton groups.
query II
EXPLAIN (FORMAT JSON) SELECT count(*)
FROM (SELECT min(x) AS k FROM deferred_unique GROUP BY id) l
JOIN (SELECT min(x) AS k FROM deferred_unique GROUP BY id) r ON l.k = r.k;
