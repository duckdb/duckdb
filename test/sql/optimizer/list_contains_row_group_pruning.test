# name: test/sql/optimizer/list_contains_row_group_pruning.test
# description: list_contains prunes row groups when the needle is outside child min/max
# group: [optimizer]

statement ok
ATTACH '{TEST_DIR}/list_contains_row_group_pruning.duckdb' AS db (ROW_GROUP_SIZE 2048);

statement ok
USE db;

statement ok
CREATE TABLE lists AS
SELECT [i] AS l
FROM range(6144) tbl(i);

query II
EXPLAIN ANALYZE SELECT count(*) FROM lists WHERE list_contains(l, 3000);
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

query I
SELECT count(*) FROM lists WHERE list_contains(l, 3000);
----
1

query I
SELECT count(*) FROM lists WHERE list_position(l, 3000) IS NOT NULL;
----
1

query II
EXPLAIN ANALYZE SELECT count(*) FROM lists WHERE list_position(l, 3000) IS NOT NULL;
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

query II
EXPLAIN ANALYZE SELECT count(*) FROM lists WHERE contains(l, 3000);
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

# FILTER_FALSE_OR_NULL can still prune a row group
statement ok
CREATE TABLE nullable_lists AS
SELECT CASE WHEN i % 100 = 0 THEN NULL ELSE [i] END AS l
FROM range(6144) tbl(i);

query I
SELECT count(*) FROM nullable_lists WHERE list_contains(l, 3001);
----
1

query II
EXPLAIN ANALYZE SELECT count(*) FROM nullable_lists WHERE list_contains(l, 3001);
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

# Preserve lossy intermediate casts when deriving needle statistics
statement ok
CREATE TABLE cast_lists AS
SELECT [3000::DOUBLE] AS l
FROM range(6144);

# Zero-padded so lexicographic min/max matches numeric order
statement ok
CREATE TABLE string_lists AS
SELECT [lpad(i::VARCHAR, 4, '0')] AS l
FROM range(6144) tbl(i);

query II
EXPLAIN ANALYZE SELECT count(*) FROM string_lists WHERE list_contains(l, '3000');
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

query I
SELECT count(*) FROM string_lists WHERE list_contains(l, '3000');
----
1

query II
EXPLAIN ANALYZE SELECT count(*) FROM string_lists WHERE contains(l, '3000');
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

# Exercise string-stat pruning for BLOB values
statement ok
CREATE TABLE blob_lists AS
SELECT [lpad(i::VARCHAR, 4, '0')::BLOB] AS l
FROM range(6144) tbl(i);

query II
EXPLAIN ANALYZE SELECT count(*) FROM blob_lists WHERE list_contains(l, '3000'::BLOB);
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

query I
SELECT count(*) FROM blob_lists WHERE list_contains(l, '3000'::BLOB);
----
1

# Truncated BLOB statistics remain conservative bounds and can prune disjoint ranges
statement ok
CREATE TABLE long_blob_lists AS
SELECT [(lpad(i::VARCHAR, 4, '0') || repeat('x', 20))::BLOB] AS l
FROM range(6144) tbl(i);

query II
EXPLAIN ANALYZE SELECT count(*) FROM long_blob_lists
WHERE list_contains(l, ('3000' || repeat('x', 20))::BLOB);
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

query I
SELECT count(*) FROM long_blob_lists WHERE list_contains(l, ('3000' || repeat('x', 20))::BLOB);
----
1

# Truncated string statistics cannot prove that the ranges do not overlap
statement ok
CREATE TABLE long_string_lists AS
SELECT [repeat('a', 20) || lpad(i::VARCHAR, 4, '0')] AS l
FROM range(6144) tbl(i);

query I
SELECT count(*) FROM long_string_lists WHERE list_contains(l, repeat('a', 20) || '3000');
----
1

query II
EXPLAIN ANALYZE SELECT count(*) FROM long_string_lists
WHERE list_contains(l, repeat('a', 20) || '9999');
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 3 / 3.*

query I
SELECT count(*) FROM long_string_lists WHERE list_contains(l, repeat('a', 20) || '9999');
----
0

# The next-prefix upper bound can overlap a needle that is larger than the actual max
query II
EXPLAIN ANALYZE SELECT count(*) FROM long_string_lists
WHERE list_contains(l, repeat('a', 19) || 'b');
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 3 / 3.*

query I
SELECT count(*) FROM long_string_lists WHERE list_contains(l, repeat('a', 19) || 'b');
----
0
