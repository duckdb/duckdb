# name: test/sql/optimizer/is_not_null_all_null_row_group_pruning.test
# description: IS NULL / IS NOT NULL prune row groups whose stored stats prove the group is all-NULL or all-non-NULL
# group: [optimizer]

statement ok
ATTACH '{TEST_DIR}/is_not_null_pruning.duckdb' AS db (ROW_GROUP_SIZE 2048);

statement ok
USE db;

# 6144 rows -> 3 row groups of 2048.
# Row group 0: x = 0..2047     (all non-null)
# Row group 1: x = NULL        (entirely NULL)
# Row group 2: x = 4096..6143  (all non-null)
statement ok
CREATE TABLE t AS
SELECT CASE WHEN range // 2048 = 1 THEN NULL ELSE range END::INTEGER AS x
FROM range(6144);

statement ok
CHECKPOINT;

# correctness sanity checks

query III
SELECT count(*) FILTER (WHERE x IS NULL),
       count(*) FILTER (WHERE x IS NOT NULL),
       sum(x)
FROM t;
----
2048	4096	12580864

# --- IS NULL: only the all-NULL row group survives (2 all-non-null groups pruned) ---
# sum(x) is used to force a real scan; a bare count(*) filter can be answered from
# stats alone and would not exercise the row-group pruning path.
query II
EXPLAIN ANALYZE SELECT sum(x) FROM t WHERE x IS NULL;
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

# --- IS NOT NULL: the all-NULL row group is pruned ---
query II
EXPLAIN ANALYZE SELECT sum(x) FROM t WHERE x IS NOT NULL;
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 2 / 3.*

# --- correctness of the pruned answers must match the un-pruned ones ---

query I
SELECT sum(x) FROM t WHERE x IS NULL;
----
NULL

query I
SELECT sum(x) FROM t WHERE x IS NOT NULL;
----
12580864
