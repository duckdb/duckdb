# the second iteration runs the chain with the join order optimizer disabled, so both plans must agree
statement ok
SET disabled_optimizers='join_order'

endloop

statement ok
SET disabled_optimizers=''

# a chain that keeps its first value: the result survives the depth at which join order optimization stops
