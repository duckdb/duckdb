# name: test/sql/optimizer/window_fusion.test
# description: Test basic window fusion rewrites
# group: [optimizer]

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

statement ok
SET explain_output = 'physical_only';

# Streaming Windows should use fusion
query II
explain
SELECT id
FROM range(100) tbl(id)
QUALIFY row_number() OVER() = 1
----
physical_plan	<REGEX>:.*FILTER.*STREAMING_WINDOW.*Limit.*

query I
SELECT id
FROM range(100) tbl(id)
QUALIFY row_number() OVER() = 1
----
0

# Don't trash shared buffers from a materialized CTE
statement ok
SET threads=1;

query I
WITH c AS MATERIALIZED (
	SELECT i FROM range(10) t(i)
)
(
	SELECT i 
	FROM c 
	QUALIFY row_number() OVER () = 1 
	LIMIT 2
)
UNION ALL
(
	SELECT i 
	FROM c 
	LIMIT 5
);
----
0
0
1
2
3
4

statement ok
RESET threads;

# The later RowNumberRewriter discards the fused limit on base-table scans
statement ok
CREATE TABLE plain AS FROM range(10_000) tbl(i);

query II
EXPLAIN
SELECT i 
FROM plain
QUALIFY row_number() OVER () <= 1;
----
physical_plan	<!REGEX>:.*WINDOW.*

# Single Partitions should use fusion
query II
explain
SELECT id
FROM range(100) tbl(id)
QUALIFY row_number() OVER(ORDER BY id DESC) = 1
----
physical_plan	<REGEX>:.*FILTER.*WINDOW.*Limit.*

query I
SELECT id
FROM range(100) tbl(id)
QUALIFY row_number() OVER(ORDER BY id DESC) = 1
----
99

# Single partitions with relatively high N should use truncation successfully
query II
explain
WITH q AS (
	SELECT id
	FROM range(10000) tbl(id)
	QUALIFY row_number() OVER(ORDER BY id DESC) < 700
)
SELECT min(id), max(id), count(*)
FROM q
----
physical_plan	<REGEX>:.*FILTER.*WINDOW.*Limit.*

query III
WITH q AS (
	SELECT id
	FROM range(100000) tbl(id)
	QUALIFY row_number() OVER(ORDER BY id DESC) < 6000
)
SELECT min(id), max(id), count(*)
FROM q
----
94001	99999	5999

