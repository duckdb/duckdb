# name: test/sql/optimizer/window_fusion.test
# description: Test basic window fusion rewrites
# group: [optimizer]

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

statement ok
SET explain_output = 'physical_only';

#
# Streaming
#
query II
explain
SELECT id
FROM range(100) tbl(id)
QUALIFY row_number() OVER() = 1
----
physical_plan	<REGEX>:.*FILTER.*STREAMING_WINDOW.*Limit.*

query I
SELECT id
FROM range(100) tbl(id)
QUALIFY row_number() OVER() = 1
----
0

# The later RowNumberRewriter should not discard the fused limit on base-table scans
statement ok
CREATE TABLE plain AS FROM range(10_000) tbl(i);

query II
EXPLAIN
SELECT i 
FROM plain
QUALIFY row_number() OVER () <= 1;
----
physical_plan	<REGEX>:.*FILTER.*STREAMING_WINDOW.*Limit.*

#
# Single Partitions 
#

# Single threaded issues
statement ok
SET threads=1;

# Don't trash shared buffers from a materialized CTE
query I
WITH c AS MATERIALIZED (
	SELECT i FROM range(10) t(i)
)
(
	SELECT i 
	FROM c 
	QUALIFY row_number() OVER () = 1 
	LIMIT 2
)
UNION ALL
(
	SELECT i 
	FROM c 
	LIMIT 5
);
----
0
0
1
2
3
4

# Correctly append when the collection has finished appending.
statement ok
SET threads=1

query I
SELECT count(*)
FROM (
    SELECT i FROM range(200000) t(i)
    QUALIFY row_number() OVER (ORDER BY i DESC) <= 6000
);
----
6000

statement ok
RESET threads;

# Single Partitions should use fusion when TopN is disabled
statement ok
SET disabled_optimizers='top_n_window_elimination';

query II
explain
SELECT id
FROM range(100) tbl(id)
QUALIFY row_number() OVER(ORDER BY id DESC) = 1
----
physical_plan	<REGEX>:.*FILTER.*WINDOW.*Limit.*

query I
SELECT id
FROM range(100) tbl(id)
QUALIFY row_number() OVER(ORDER BY id DESC) = 1
----
99

# Single partitions with relatively high N should use truncation successfully
query II
explain
WITH q AS (
	SELECT id
	FROM range(10000) tbl(id)
	QUALIFY row_number() OVER(ORDER BY id DESC) < 700
)
SELECT min(id), max(id), count(*)
FROM q
----
physical_plan	<REGEX>:.*FILTER.*WINDOW.*Limit.*

query III
WITH q AS (
	SELECT id
	FROM range(100000) tbl(id)
	QUALIFY row_number() OVER(ORDER BY id DESC) < 6000
)
SELECT min(id), max(id), count(*)
FROM q
----
94001	99999	5999

statement ok
RESET disabled_optimizers;

# UCC Equivalence

statement ok
CREATE TABLE ucc(id INTEGER PRIMARY KEY, payload VARCHAR, grp INTEGER);

statement ok
INSERT INTO ucc VALUES (3, 'c', 1), (1, 'a', 2), (2, NULL, 1), (5, 'a', NULL), (4, 'b', 2);

foreach ranker rank dense_rank

query III
FROM ucc
QUALIFY {ranker}() OVER (ORDER BY id) = 1
----
1	a	2

query II
EXPLAIN
FROM ucc
QUALIFY {ranker}() OVER (ORDER BY id) = 1
----
physical_plan	<REGEX>:.*FILTER.*WINDOW.*Limit.*

query II
EXPLAIN
FROM plain
QUALIFY {ranker}() OVER (ORDER BY i) = 1
----
physical_plan	<!REGEX>:.*FILTER.*WINDOW.*Limit.*

endloop

# BETWEEN Support
query II
EXPLAIN
FROM ucc
QUALIFY row_number() OVER (ORDER BY id) BETWEEN 2 AND 4
----
physical_plan	<REGEX>:.*FILTER.*WINDOW.*Limit.*

query III
FROM ucc
QUALIFY row_number() OVER (ORDER BY id) BETWEEN 2 AND 4
----
2	NULL	1
3	c	1
4	b	2

# ORDER BY required
query II
EXPLAIN
SELECT count(*) FROM (
    SELECT i FROM range(10) t(i)
    QUALIFY rank() OVER (PARTITION BY i % 2) = 1
);
----
physical_plan	<!REGEX>:.*FILTER.*WINDOW.*Limit.*

query I
SELECT count(*) FROM (
    SELECT i FROM range(10) t(i)
    QUALIFY rank() OVER (PARTITION BY i % 2) = 1
);
----
10

#
# TopN vs Fusion
#

# Fusion does not yet support partitioning
query II
EXPLAIN
SELECT g, s
FROM (
    SELECT i % 10 AS g, i::VARCHAR AS s
    FROM range(10000) t(i)
)
QUALIFY row_number() OVER (PARTITION BY g ORDER BY s) = 1;
----
physical_plan	<!REGEX>:.*WINDOW.*

statement ok
CREATE OR REPLACE TABLE int_str_500 AS (
	SELECT i, i::VARCHAR AS v
	FROM range(500_000) tbl(i)
);

statement ok
CREATE OR REPLACE TABLE int_str_100 AS (
	FROM int_str_500
	WHERE i < 100_000
);

# Fusion is better for non-numeric keys
query II
EXPLAIN
FROM int_str_500
QUALIFY row_number() OVER (ORDER BY v DESC) < 10;
----
physical_plan	<REGEX>:.*FILTER.*WINDOW.*Limit.*

query II
EXPLAIN
FROM int_str_500
QUALIFY row_number() OVER (ORDER BY i DESC) < 10;
----
physical_plan	<!REGEX>:.*WINDOW.*

# Fusion is better for large ranges
query II
EXPLAIN
FROM int_str_500
QUALIFY row_number() OVER (ORDER BY i DESC) < 6000;
----
physical_plan	<REGEX>:.*FILTER.*WINDOW.*Limit.*

query II
EXPLAIN
FROM int_str_500
QUALIFY row_number() OVER (ORDER BY i DESC) < 4000;
----
physical_plan	<!REGEX>:.*WINDOW.*

# TopN is better for k == 1
query II
EXPLAIN
FROM int_str_500
QUALIFY row_number() OVER (ORDER BY i DESC) = 1;
----
physical_plan	<!REGEX>:.*WINDOW.*

# TopN is better for small cardinalities
query II
EXPLAIN
FROM int_str_500
QUALIFY row_number() OVER (ORDER BY i DESC) < 6000;
----
physical_plan	<REGEX>:.*FILTER.*WINDOW.*Limit.*

query II
EXPLAIN
FROM int_str_100
QUALIFY row_number() OVER (ORDER BY i DESC) < 4000;
----
physical_plan	<!REGEX>:.*WINDOW.*
