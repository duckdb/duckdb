query II
SELECT count(*), sum(x9.a) FROM u x0, u x1, t x2, t x3, t x4, u x5, t x6, u x7, u x8, u x9 WHERE x1.b = x0.a AND x2.a = x0.a AND x3.a = x0.b AND x4.b = x0.b AND x5.a = x0.b AND x6.b = x0.b AND x7.b = x0.b AND x8.b = x0.a AND x9.a = x0.a;
