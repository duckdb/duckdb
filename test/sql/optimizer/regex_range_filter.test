# name: test/sql/optimizer/regex_range_filter.test
# description: Test range filters derived from full regular-expression matches
# group: [optimizer]

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

statement ok
PRAGMA explain_output = 'OPTIMIZED_ONLY';

statement ok
CREATE TABLE regex_values(s VARCHAR);

statement ok
INSERT INTO regex_values VALUES ('foo'), ('food'), ('bar'), (NULL);

# Keep the derived range as a separate filter so it is visible in the logical plan.
statement ok
SET disabled_optimizers = 'filter_pushdown';

query II
EXPLAIN SELECT s FROM regex_values WHERE regexp_full_match(s, 'foo');
----
logical_opt	<REGEX>:(?s).*regexp_full_match.*s >= 'foo'::BLOB.*s <= 'foo'::BLOB.*

statement ok
SET disabled_optimizers = '';

query T
SELECT s FROM regex_values WHERE regexp_full_match(s, 'foo');
----
foo

# the derived BLOB range pushed into a VARCHAR scan must not be checked against the VARCHAR zonemap
statement ok
CREATE TABLE t0(a INT, c VARCHAR);

statement ok
INSERT INTO t0 VALUES (1, 'a'), (2, 'b');

statement ok
CREATE TABLE t1(a INT);

statement ok
INSERT INTO t1 VALUES (1);

query ITI
SELECT * FROM t1 JOIN t0 USING (a) FULL JOIN t1 x ON t0.a <> x.a WHERE t0.c SIMILAR TO 'a';
----
1	a	NULL

query ITI
SELECT * FROM t1 JOIN t0 USING (a) FULL JOIN t1 x ON t0.a <> x.a WHERE regexp_full_match(t0.c, 'a.*');
----
1	a	NULL
