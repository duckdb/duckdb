# name: test/sql/optimizer/secure_view_pushdown.test
# description: Test that secure views act as an optimization barrier
# group: [optimizer]

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

statement ok
CREATE TABLE integers AS SELECT i, i % 10 AS j FROM range(10000) t(i);

statement ok
CREATE VIEW regular_view AS SELECT * FROM integers;

statement ok
CREATE SECURE VIEW secure_view AS SELECT * FROM integers;

# in a regular view the filter is pushed into the table scan
query II
EXPLAIN SELECT * FROM regular_view WHERE i = 42
----
physical_plan	<!REGEX>:[\s\S]*FILTER[\s\S]*

query II
EXPLAIN SELECT * FROM regular_view WHERE i = 42
----
physical_plan	<REGEX>:[\s\S]*Filters: i = 42[\s\S]*

# in a secure view the filter remains on top of the view
query II
EXPLAIN SELECT * FROM secure_view WHERE i = 42
----
physical_plan	<REGEX>:[\s\S]*FILTER[\s\S]*

query II
EXPLAIN SELECT * FROM secure_view WHERE i = 42
----
physical_plan	<!REGEX>:[\s\S]*Filters:[\s\S]*

# the LOGICAL_SECURE_VIEW node is visible in the optimized logical plan
statement ok
SET explain_output='optimized_only'

query II
EXPLAIN SELECT * FROM secure_view WHERE i = 42
----
logical_opt	<REGEX>:[\s\S]*SECURE_VIEW[\s\S]*secure_view[\s\S]*

query II
EXPLAIN SELECT * FROM regular_view WHERE i = 42
----
logical_opt	<!REGEX>:[\s\S]*SECURE_VIEW[\s\S]*

statement ok
SET explain_output='physical_only'

# blocking pushdown does not change the results
query II
SELECT * FROM secure_view WHERE i = 42
----
42	2

query I
SELECT count(*) FROM secure_view WHERE j = 3
----
1000

# secure views work with the optimizer disabled entirely
statement ok
PRAGMA disable_optimizer

query II
SELECT * FROM secure_view WHERE i = 42
----
42	2

statement ok
PRAGMA enable_optimizer

# filters are still pushed down *within* the view definition itself. The plan of the view is hidden (see
# secure_view_explain.test), so this is observable through the row count the secure view reports for its contents:
# with the filter pushed into the scan only a handful of rows are produced inside the view, whereas an unpushed
# filter would make the scan report all 10000.
statement ok
CREATE SECURE VIEW filtered_secure_view AS SELECT * FROM integers WHERE i = 42;

query II
EXPLAIN ANALYZE SELECT * FROM filtered_secure_view
----
analyzed_plan	<REGEX>:[\s\S]*SECURE_VIEW[\s\S]*

query II
EXPLAIN ANALYZE SELECT * FROM filtered_secure_view
----
analyzed_plan	<!REGEX>:[\s\S]*[0-9],[0-9]{3} rows[\s\S]*

query II
SELECT * FROM filtered_secure_view
----
42	2
