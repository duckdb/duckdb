# name: test/sql/optimizer/monotone_preimage_tz.test
# description: Monotone preimage bounds on the edge of the TIMESTAMP WITH TIME ZONE domain
# group: [optimizer]

require icu

statement ok
PRAGMA explain_output = OPTIMIZED_ONLY;

statement ok
SET TimeZone = 'UTC';

# TIMESTAMP WITH TIME ZONE shares the int64 domain of TIMESTAMP: the smallest and largest finite values
# (make_timestamptz(INT64_MIN + 2) / make_timestamptz(INT64_MAX - 1)) are valid rows that a rewritten
# comparison must keep, and a bound on the domain edge is written against the ±infinity sentinel
statement ok
CREATE TABLE edge_tz(t TIMESTAMPTZ);

statement ok
INSERT INTO edge_tz VALUES
  (make_timestamptz(-9223372036854775806)), ('2000-01-01'), (make_timestamptz(9223372036854775806)),
  ('-infinity'), ('infinity'), (NULL);

query I
SELECT count(*) FROM edge_tz WHERE epoch(t) > -9223372036854775807;
----
3

query I
SELECT count(*) FROM edge_tz WHERE epoch(t) < 9223372036854775807;
----
3

query I
SELECT count(*) FROM edge_tz WHERE epoch_us(t) >= -9223372036854775806;
----
3

query I
SELECT count(*) FROM edge_tz WHERE epoch_us(t) > -9223372036854775806;
----
2

statement ok
EXPLAIN SELECT count(*) FROM edge_tz WHERE epoch(t) > -9223372036854775807;

statement ok
EXPLAIN ANALYZE SELECT count(*) FROM edge_tz WHERE epoch(t) < 9223372036854775807;

statement ok
EXPLAIN SELECT count(*) FROM edge_tz WHERE epoch_us(t) > -9223372036854775806;
