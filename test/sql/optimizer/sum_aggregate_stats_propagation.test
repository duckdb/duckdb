----
-99	0	-495000

query II
EXPLAIN SELECT sum(s) FROM tshn HAVING sum(s) > 0;
----
physical_plan	<REGEX>:.*Empty Result.*

query I
SELECT count(*) FROM (SELECT sum(s) AS r FROM tshn HAVING sum(s) > 0);
----
0

query I
SELECT sum(s) FROM tshn HAVING sum(s) < 0;
----
-495000

