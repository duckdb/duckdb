# name: test/sql/optimizer/sparse_update_segment_pruning.test
# description: Segment pruning with sparse updates
# group: [optimizer]

require json

require no_force_storage

require vector_size 2048

statement ok
SET threads = 1

statement ok
SET initial_column_segment_size = 2048

statement ok
SET wal_autocheckpoint = '1TB'

statement ok
CREATE TABLE events AS
SELECT i, TIMESTAMP '2020-01-01' + i * INTERVAL 1 SECOND AS ts
FROM range(100000) t(i)

statement ok
UPDATE events SET ts = TIMESTAMP '2100-01-01' WHERE i = 1

statement ok
PRAGMA enable_profiling = 'json'

statement ok
PRAGMA profiling_output = '{TEST_DIR}/sparse_update_profile.json'

statement ok
SET tracked_metrics = ['query.total_rows_scanned']

query I
SELECT count(*) FROM events WHERE ts >= TIMESTAMP '2099-01-01'
----
1

statement ok
PRAGMA disable_profiling

query I
SELECT query.total_rows_scanned BETWEEN 1 AND 99999
FROM '{TEST_DIR}/sparse_update_profile.json'
----
true
