# name: test/sql/optimizer/multi_column_expression_stats_pruning.test
# description: Use row-group statistics for multi-column expressions
# group: [optimizer]

statement ok
ATTACH '{TEST_DIR}/multi_column_expression_stats_pruning.duckdb' AS db (ROW_GROUP_SIZE 2048);

statement ok
USE db;

statement ok
CREATE TABLE t AS
SELECT range::INTEGER AS a,
       (range + 10000)::INTEGER AS b,
       5000::BIGINT AS c,
       range::VARCHAR AS s,
       (range + 10000)::VARCHAR AS s2,
       CASE WHEN range < 4096 THEN range ELSE NULL END::INTEGER AS nullable_a,
       CASE WHEN range % 2 = 0 THEN NULL ELSE range END::INTEGER AS mixed_nullable
FROM range(6144);

statement ok
CHECKPOINT;

# Functions with statistics callbacks
query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE greatest(a, b) > 15000;
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

query I
SELECT count(*) FROM t WHERE greatest(a, b) > 15000;
----
1143

query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE least(a, b) > 5000;
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

query I
SELECT count(*) FROM t WHERE least(a, b) > 5000;
----
1143

# Single-column expressions retain scan pushdown
query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE greatest(a, 0) > 5000;
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

query I
SELECT count(*) FROM t WHERE greatest(a, 0) > 5000;
----
1143

# Casts with propagated statistics
query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE CAST(a AS BIGINT) > c;
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

# Column-to-column comparisons can be composed with OR
query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE a > b OR a > c;
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

query I
SELECT count(*) FROM t WHERE a > b OR a > c;
----
1143

query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE a > TRY_CAST(c AS INTEGER);
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

# Nested conjunctions composed from supported predicates
query II
EXPLAIN ANALYZE
SELECT count(*) FROM t
WHERE (greatest(a, b) > 15000 AND a < 6000) OR CAST(a AS BIGINT) > c;
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

query I
SELECT count(*) FROM t
WHERE (greatest(a, b) > 15000 AND a < 6000) OR CAST(a AS BIGINT) > c;
----
1143

# Nullable inputs preserve greatest/least semantics
query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE greatest(nullable_a, b) > 15000;
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

query I
SELECT count(*) FROM t WHERE greatest(nullable_a, b) > 15000;
----
1143

query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE least(nullable_a, b) > 5000;
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

query I
SELECT count(*) FROM t WHERE least(nullable_a, b) > 5000;
----
2048

# A statistics callback can decline to produce statistics at runtime
query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE greatest(s, s) > s2;
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 3 / 3.*

# TRUE_OR_NULL in an OR child must not prune matching non-NULL rows
query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE mixed_nullable < b OR a < 0;
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 3 / 3.*

query I
SELECT count(*) FROM t WHERE mixed_nullable < b OR a < 0;
----
3072

# Throwing and volatile expressions are not admitted for row-group pruning
query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE CAST(c AS INTEGER) < a;
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 3 / 3.*

query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE random() + a > c;
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 3 / 3.*
