# name: test/sql/optimizer/null_check_statistics_propagation.test
# description: Statistics must not fold IS (NOT) NULL over a child that is volatile or can throw
# group: [optimizer]

statement ok
CREATE TABLE t AS SELECT 300::INTEGER i;

# The multiplication overflows - folding the NULL check to a constant would suppress the error
statement error
SELECT (i * i * i * i * i) IS NOT NULL FROM t;
----
<REGEX>:.*Overflow in multiplication.*

statement error
SELECT (i * i * i * i * i) IS NULL FROM t;
----
<REGEX>:.*Overflow in multiplication.*

# The cast in "CAST(<oversized literal> AS VARIANT) IS NOT NULL" throws for the same reason, but
# that query needs more than 4 GB of memory so it cannot be tested here

# Do not change the number of volatile function evaluations
statement ok
CREATE SEQUENCE s;

query I
SELECT nextval('s') IS NOT NULL FROM t;
----
true

query I
SELECT currval('s');
----
1

# Children that cannot throw are still folded
query II
EXPLAIN SELECT i IS NOT NULL FROM t;
----
physical_plan	<REGEX>:.*Projections: true.*

query I
SELECT i IS NOT NULL FROM t;
----
true

query I
SELECT i IS NULL FROM t;
----
false

# Throwing children must stay in the plan even for empty inputs
statement ok
CREATE TABLE empty(i INTEGER);

query II
EXPLAIN SELECT (i * i * i * i * i) IS NOT NULL FROM empty;
----
physical_plan	<!REGEX>:.*Projections: true.*

query I
SELECT (i * i * i * i * i) IS NOT NULL FROM empty;
----

# Non-throwing list extraction can still be folded for all-NULL inputs
statement ok
CREATE TABLE all_null_list AS SELECT NULL::INTEGER[] AS l;

query II
EXPLAIN SELECT list_extract(l, 1) IS NULL FROM all_null_list;
----
physical_plan	<REGEX>:.*Projections: true.*

query I
SELECT list_extract(l, 1) IS NULL FROM all_null_list;
----
true

query II
EXPLAIN SELECT list_extract(l, 1) IS NOT NULL FROM all_null_list;
----
physical_plan	<REGEX>:.*Projections: false.*

query I
SELECT list_extract(l, 1) IS NOT NULL FROM all_null_list;
----
false

# A NULL result does not make evaluation of a throwing index safe
statement ok
CREATE TABLE null_elements AS SELECT [NULL]::INTEGER[] l, 'bad'::VARCHAR s;

foreach extract list_extract array_extract

statement error
SELECT {extract}(l, s::BIGINT) IS NULL FROM null_elements;
----
Could not convert string 'bad' to INT64

statement error
SELECT {extract}(l, s::BIGINT) IS NOT NULL FROM null_elements;
----
Could not convert string 'bad' to INT64

endloop

# NULL result statistics must not discard evaluation of a volatile index either
query I
SELECT list_extract(l, nextval('s')) IS NULL FROM null_elements;
----
true

query I
SELECT currval('s');
----
2
