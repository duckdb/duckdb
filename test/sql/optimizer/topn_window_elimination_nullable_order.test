# name: test/sql/optimizer/topn_window_elimination_nullable_order.test
# description: top_n_window_elimination must keep NULL-keyed rows when ROW_NUMBER orders by a nullable expression (issue #23677)
# group: [optimizer]

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY);

statement ok
INSERT INTO t VALUES (1), (2), (3);

# Verbatim reproducer from the issue. A compound ORDER BY expression (NULLIF) can produce NULLs even
# though id is NOT NULL, so the rewrite must use the nulls-last aggregate variant and keep the
# NULL-keyed row (3) instead of dropping it.
query II
SELECT id, ROW_NUMBER() OVER (ORDER BY NULLIF(id % 3, 0) DESC NULLS LAST) AS rn
FROM t
QUALIFY rn <= 3
ORDER BY rn;
----
2	1
1	2
3	3

# Same bug with a PARTITION BY (the rewrite is active per partition).
statement ok
CREATE TABLE t2(g INTEGER, id INTEGER);

statement ok
INSERT INTO t2 VALUES (1,1),(1,2),(1,3),(2,4),(2,5),(2,6);

query III
SELECT g, id, ROW_NUMBER() OVER (PARTITION BY g ORDER BY NULLIF(id % 3, 0) DESC NULLS LAST) AS rn
FROM t2
QUALIFY rn <= 3
ORDER BY g, rn;
----
1	2	1
1	1	2
1	3	3
2	5	1
2	4	2
2	6	3

# The optimized results must match the results with the rewrite disabled.
statement ok
SET disabled_optimizers = 'top_n_window_elimination'

query III
SELECT g, id, ROW_NUMBER() OVER (PARTITION BY g ORDER BY NULLIF(id % 3, 0) DESC NULLS LAST) AS rn
FROM t2
QUALIFY rn <= 3
ORDER BY g, rn;
----
1	2	1
1	1	2
1	3	3
2	5	1
2	4	2
2	6	3

# ASC with NULLS LAST takes the arg_min nulls-last variant through the same guard.
query II
SELECT id, ROW_NUMBER() OVER (ORDER BY NULLIF(id % 3, 0) ASC NULLS LAST) AS rn
FROM t
QUALIFY rn <= 3
ORDER BY rn;
----
1	1
2	2
3	3

# Payload-free projection: only the row number is projected, exercising the synthesized argument.
query I
SELECT ROW_NUMBER() OVER (ORDER BY NULLIF(id % 3, 0) DESC NULLS LAST) AS rn
FROM t
QUALIFY rn <= 3
ORDER BY rn;
----
1
2
3

# N=1 keeps a non-NULL-keyed winner and still goes through the guarded path.
query II
SELECT id, ROW_NUMBER() OVER (ORDER BY NULLIF(id % 3, 0) DESC NULLS LAST) AS rn
FROM t
QUALIFY rn <= 1
ORDER BY rn;
----
2	1
