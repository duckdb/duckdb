# name: test/sql/prepared/prepare_query_function_parameters.test
# description: Parameters inside the SQL string of query() are rejected in prepared statements
# group: [prepared]

statement ok
SET VARIABLE n = 10

# outside PREPARE a $variable inside query() falls back to the variable
query I
SELECT * FROM query('SELECT $n')
----
10

# inside PREPARE the parameter can never receive a value, so it is rejected up front
statement error
PREPARE stmt AS SELECT * FROM query('SELECT $n')
----
Prepared statement parameters are not supported inside query(): use getvariable()

statement error
PREPARE stmt AS SELECT * FROM query('SELECT $1')
----
Prepared statement parameters are not supported inside query()

statement error
PREPARE stmt AS SELECT * FROM query('SELECT ?')
----
Prepared statement parameters are not supported inside query()

# getvariable is the supported way to read a variable inside query()
statement ok
PREPARE stmt_getvariable AS SELECT * FROM query('SELECT getvariable(''n'')')

query I
EXECUTE stmt_getvariable
----
10

statement ok
SET VARIABLE n = 20

query I
EXECUTE stmt_getvariable
----
20

# parameters outside the string keep working alongside query()
statement ok
PREPARE stmt_outer AS SELECT $n, * FROM query('SELECT 1')

query II
EXECUTE stmt_outer
----
20	1

query II
EXECUTE stmt_outer(n := 5)
----
5	1

# query_table shares the check
statement ok
CREATE TABLE t AS SELECT 1 AS i

statement ok
PREPARE stmt_table AS SELECT * FROM query_table('t')

query I
EXECUTE stmt_table
----
1
