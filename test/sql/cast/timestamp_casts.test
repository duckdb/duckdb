# name: test/sql/cast/timestamp_casts.test
# description: Test the TIMESTAMP cast functions
# group: [cast]

statement ok
CREATE TABLE tss AS 
	FROM VALUES ('2026-04-09 11:48:07.123456'::TIMESTAMP) tbl(t);

query I
select t::TIMESTAMP_NS from tss;
----
2026-04-09 11:48:07.123456

query I
select t::TIMESTAMP from tss;
----
2026-04-09 11:48:07.123456

query I
select t::TIMESTAMP_MS from tss;
----
2026-04-09 11:48:07.123

query I
select t::TIMESTAMP_S from tss;
----
2026-04-09 11:48:07

query I
select t::DATE from tss;
----
2026-04-09

query I
SELECT TRY_CAST(TIMESTAMP '2262-04-11 23:47:16.854776' AS TIMESTAMP_NS);
----
NULL

statement error
SELECT CAST(TIMESTAMP '2262-04-11 23:47:16.854776' AS TIMESTAMP_NS);
----
Could not convert Timestamp to higher precision.

statement error
SELECT CAST(TIMESTAMP '2262-04-11 23:47:16.854776' AS TIMESTAMPTZ_NS);
----
Could not convert Timestamp to higher precision.

statement error
SELECT CAST(TIMESTAMPTZ '2262-04-11 23:47:16.854776+00' AS TIMESTAMP_NS);
----
Could not convert Timestamp to higher precision.

statement error
SELECT CAST(TIMESTAMPTZ '2262-04-11 23:47:16.854776+00' AS TIMESTAMPTZ_NS);
----
Could not convert Timestamp to higher precision.

statement error
SELECT CAST(TIMESTAMP_MS '2262-04-11 23:47:16.855' AS TIMESTAMP_NS);
----
Could not convert Timestamp to higher precision.

statement error
SELECT CAST(TIMESTAMP_MS '2262-04-11 23:47:16.855' AS TIMESTAMPTZ_NS);
----
Could not convert Timestamp to higher precision.

statement error
SELECT CAST(TIMESTAMP_S '2262-04-12 00:00:00' AS TIMESTAMP_NS);
----
Could not convert Timestamp to higher precision.

statement error
SELECT CAST(TIMESTAMP_S '2262-04-12 00:00:00' AS TIMESTAMPTZ_NS);
----
Could not convert Timestamp to higher precision.

statement error
SELECT CAST(TIMESTAMP 'infinity' AS TIME);
----
Can't get TIME of infinite TIMESTAMP

statement error
SELECT CAST(TIMESTAMP 'infinity' AS TIMETZ);
----
Can't get TIME of infinite TIMESTAMP

statement error
SELECT CAST(TIMESTAMPTZ 'infinity' AS TIMETZ);
----
Can't get TIME of infinite TIMESTAMP

statement error
SELECT CAST('infinity'::TIMESTAMPTZ_NS AS TIMETZ);
----
Can't get TIME of infinite TIMESTAMP

statement error
SELECT CAST(TIMESTAMP_MS 'infinity' AS TIME);
----
Can't get TIME of infinite TIMESTAMP

statement error
SELECT CAST('infinity'::TIMESTAMP_NS AS TIME);
----
Can't get TIME of infinite TIMESTAMP

statement error
SELECT CAST(TIMESTAMP_S 'infinity' AS TIME);
----
Can't get TIME of infinite TIMESTAMP

statement error
SELECT CAST('infinity'::TIMESTAMP_NS AS TIME_NS);
----
Can't get TIME_NS of infinite TIMESTAMP

query II
SELECT
	CAST('1970-01-01 23:59:59.999999999'::TIMESTAMP_NS AS DATE),
	TRY_CAST('1970-01-01 23:59:59.999999999'::TIMESTAMP_NS AS DATE)
----
1970-01-02	1970-01-02

query IIIIIIIII
SELECT
	TRY_CAST(TIMESTAMP 'infinity' AS TIME) IS NULL,
	TRY_CAST(TIMESTAMP 'infinity' AS TIMETZ) IS NULL,
	TRY_CAST(TIMESTAMPTZ 'infinity' AS TIMETZ) IS NULL,
	TRY_CAST('infinity'::TIMESTAMP_NS AS TIME) IS NULL,
	TRY_CAST('infinity'::TIMESTAMP_NS AS TIME_NS) IS NULL,
	TRY_CAST('infinity'::TIMESTAMPTZ_NS AS TIMETZ) IS NULL,
	TRY_CAST(TIMESTAMPTZ '2262-04-11 23:47:16.854776+00' AS TIMESTAMP_NS) IS NULL,
	TRY_CAST(TIMESTAMP_MS '2262-04-11 23:47:16.855' AS TIMESTAMP_NS) IS NULL,
	TRY_CAST(TIMESTAMP_S '2262-04-12 00:00:00' AS TIMESTAMP_NS) IS NULL
----
true	true	true	true	true	true	true	true	true

query II
SELECT
	CAST('1970-01-01 23:59:59.999999999+00'::TIMESTAMPTZ_NS AS TIMETZ),
	TRY_CAST('1970-01-01 23:59:59.999999999+00'::TIMESTAMPTZ_NS AS TIMETZ)
----
00:00:00+00	00:00:00+00

# TIMESTAMPTZ (us) -> TIMESTAMPTZ_NS was unimplemented (#25334)
query I
SELECT typeof(CAST(now() AS TIMESTAMPTZ_NS));
----
TIMESTAMPTZ_NS

# Microsecond parts are scaled to nanoseconds, not truncated
query II
SELECT
	CAST(TIMESTAMPTZ '2026-01-01 12:34:56.123456+00' AS TIMESTAMPTZ_NS),
	CAST(TIMESTAMPTZ '2026-01-01 12:34:56.123456+00' AS TIMESTAMPTZ_NS) = '2026-01-01 12:34:56.123456000+00'::TIMESTAMPTZ_NS;
----
2026-01-01 12:34:56.123456+00	true

query I
SELECT CAST(TIMESTAMPTZ '2026-01-01 12:34:56.123456+00' AS TIMESTAMPTZ_NS) =
       CAST(TIMESTAMPTZ '2026-01-01 12:34:56.123456+00'::VARCHAR AS TIMESTAMPTZ_NS);
----
true

statement ok
CREATE TABLE tstz_us AS
	FROM VALUES
		(1, TIMESTAMPTZ '2026-01-01 12:34:56.123456+00'),
		(2, TIMESTAMPTZ '1970-01-01 00:00:00.000001+00'),
		(3, TIMESTAMPTZ '1969-12-31 23:59:59.999999+00'),
		(4, TIMESTAMPTZ '1900-06-15 08:00:00.5+00'),
		(5, TIMESTAMPTZ '2262-04-11 23:47:16.854775+00'),
		(6, TIMESTAMPTZ 'infinity'),
		(7, TIMESTAMPTZ '-infinity'),
		(8, NULL)
	tbl(i, t);

query III
SELECT i, t::TIMESTAMPTZ_NS, t::TIMESTAMPTZ_NS::TIMESTAMPTZ = t
FROM tstz_us
ORDER BY i;
----
1	2026-01-01 12:34:56.123456+00	true
2	1970-01-01 00:00:00.000001+00	true
3	1969-12-31 23:59:59.999999+00	true
4	1900-06-15 08:00:00.5+00	true
5	2262-04-11 23:47:16.854775+00	true
6	infinity	true
7	-infinity	true
8	NULL	NULL

# ±infinity stay infinite
query IIII
SELECT
	CAST(TIMESTAMPTZ 'infinity' AS TIMESTAMPTZ_NS),
	CAST(TIMESTAMPTZ '-infinity' AS TIMESTAMPTZ_NS),
	CAST(TIMESTAMPTZ 'infinity' AS TIMESTAMPTZ_NS) = 'infinity'::TIMESTAMPTZ_NS,
	CAST(TIMESTAMPTZ '-infinity' AS TIMESTAMPTZ_NS) = '-infinity'::TIMESTAMPTZ_NS;
----
infinity	-infinity	true	true

query II
SELECT
	TRY_CAST(TIMESTAMPTZ 'infinity' AS TIMESTAMPTZ_NS),
	TRY_CAST(TIMESTAMPTZ '-infinity' AS TIMESTAMPTZ_NS);
----
infinity	-infinity

query I
SELECT TRY_CAST(TIMESTAMPTZ '2262-04-11 23:47:16.854776+00' AS TIMESTAMPTZ_NS);
----
NULL

# The same conversions with ICU loaded and a non-UTC time zone
require icu

statement ok
SET Calendar = 'gregorian';

statement ok
SET TimeZone = 'America/Los_Angeles';

query I
SELECT typeof(CAST(now() AS TIMESTAMPTZ_NS));
----
TIMESTAMPTZ_NS

# The instant is unchanged; only the display follows the session zone (PST and PDT)
query III
SELECT i, t::TIMESTAMPTZ_NS, t::TIMESTAMPTZ_NS::TIMESTAMPTZ = t
FROM tstz_us
ORDER BY i;
----
1	2026-01-01 04:34:56.123456-08	true
2	1969-12-31 16:00:00.000001-08	true
3	1969-12-31 15:59:59.999999-08	true
4	1900-06-15 00:00:00.5-08	true
5	2262-04-11 16:47:16.854775-07	true
6	infinity	true
7	-infinity	true
8	NULL	NULL

query II
SELECT
	CAST(TIMESTAMPTZ '2026-07-01 12:34:56.654321+00' AS TIMESTAMPTZ_NS),
	CAST(TIMESTAMPTZ '2026-07-01 12:34:56.654321+00' AS TIMESTAMPTZ_NS) = '2026-07-01 12:34:56.654321000+00'::TIMESTAMPTZ_NS;
----
2026-07-01 05:34:56.654321-07	true

query I
SELECT CAST(TIMESTAMPTZ '2026-07-01 12:34:56.654321+00' AS TIMESTAMPTZ_NS) =
       CAST(TIMESTAMPTZ '2026-07-01 12:34:56.654321+00'::VARCHAR AS TIMESTAMPTZ_NS);
----
true

statement ok
SET TimeZone = 'Asia/Kathmandu';

query II
SELECT
	CAST(TIMESTAMPTZ '2026-01-01 12:34:56.123456+00' AS TIMESTAMPTZ_NS),
	CAST(TIMESTAMPTZ '2026-01-01 12:34:56.123456+00' AS TIMESTAMPTZ_NS) = '2026-01-01 12:34:56.123456000+00'::TIMESTAMPTZ_NS;
----
2026-01-01 18:19:56.123456+05:45	true

query IIII
SELECT
	CAST(TIMESTAMPTZ 'infinity' AS TIMESTAMPTZ_NS),
	CAST(TIMESTAMPTZ '-infinity' AS TIMESTAMPTZ_NS),
	TRY_CAST(TIMESTAMPTZ 'infinity' AS TIMESTAMPTZ_NS),
	TRY_CAST(TIMESTAMPTZ '-infinity' AS TIMESTAMPTZ_NS);
----
infinity	-infinity	infinity	-infinity

query I
SELECT TRY_CAST(TIMESTAMPTZ '2262-04-11 23:47:16.854776+00' AS TIMESTAMPTZ_NS);
----
NULL

statement error
SELECT CAST(TIMESTAMPTZ '2262-04-11 23:47:16.854776+00' AS TIMESTAMPTZ_NS);
----
Could not convert Timestamp to higher precision.
