# name: test/sql/cast/cast_sign_only_whitespace.test
# description: a sign followed only by whitespace is not a number
# group: [cast]

statement ok
PRAGMA enable_verification

query IIII
SELECT TRY_CAST('- ' AS BIGINT), TRY_CAST('+ ' AS INTEGER), TRY_CAST('-\t' AS SMALLINT), TRY_CAST('-  ' AS HUGEINT)
----
NULL	NULL	NULL	NULL

query II
SELECT TRY_CAST('- ' AS DECIMAL(10,2)), TRY_CAST('+ ' AS DECIMAL(18,3))
----
NULL	NULL

statement error
SELECT '- '::BIGINT
----
<REGEX>:Conversion Error.*

statement error
SELECT '+ '::DECIMAL(10,2)
----
<REGEX>:Conversion Error.*

# a sign with digits and trailing whitespace is still accepted
query III
SELECT '-1 '::BIGINT, '+2  '::INTEGER, '-3.50 '::DECIMAL(10,2)
----
-1	2	-3.50

# leading whitespace before the sign is still accepted, a sign alone is still rejected
query II
SELECT ' -4'::INTEGER, TRY_CAST('-' AS INTEGER)
----
-4	NULL
