SELECT CAST('1.5e-5' AS DECIMAL(5,5));
----
.00002

query I
SELECT CAST('1.4e-5' AS DECIMAL(5,5));
----
.00001

query I
SELECT CAST('1e-100' AS DECIMAL(5,5));
----
.00000

query I
SELECT CAST('-1e-100' AS DECIMAL(5,5));
----
.00000

query I
SELECT CAST('1e-32767' AS DECIMAL(5,5));
----
.00000

query I
SELECT CAST('123456e-6' AS DECIMAL(5,5));
----
.12346

query I
SELECT CAST('-123455e-6' AS DECIMAL(5,5));
----
-.12346

query I
SELECT CAST('999994e-6' AS DECIMAL(5,5));
----
.99999

query I
SELECT CAST('14e-1' AS DECIMAL(1,0));
----
1

query I
SELECT CAST('15e-1' AS DECIMAL(1,0));
----
2

