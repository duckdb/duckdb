# ==================================================================================================
# Exponent: positive exponent when the storage type is full
# Decimals that do not fit the storage type are dropped while the digits are read, before the exponent is known.
# A positive exponent moves digits across the decimal point, so dropped digits can end up inside the result or
# decide how it is rounded. These are values that look like the above but have so many digits that the type fills up.
# ==================================================================================================

query I
SELECT CAST('5.9999999999E1' AS DECIMAL(4,2));
----
60.00

query I
SELECT CAST('-5.9999999999E1' AS DECIMAL(4,2));
----
-60.00

query I
SELECT CAST('5.9999999999999999999E1' AS DECIMAL(4,2));
----
60.00

