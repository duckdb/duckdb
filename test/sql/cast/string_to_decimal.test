# ==================================================================================================
# Exponent: extreme exponent values
# The exponent is parsed as an int16, so +-32767 are the largest usable magnitudes and anything beyond is a
# parse error. Huge negative exponents give zero (the division loop exits early), huge positive ones overflow
# unless the mantissa is zero.
# ==================================================================================================

query I
SELECT CAST('1e-100' AS DECIMAL(6,5));
----
0.00000

query I
SELECT CAST('1e-32767' AS DECIMAL(6,5));
----
0.00000

query I
SELECT CAST('1e-32768' AS DECIMAL(6,5));
----
0.00000

