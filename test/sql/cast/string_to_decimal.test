# ==================================================================================================
# More decimals than the storage type can hold
# HandleDecimal stops storing digits once the physical type is full (digit_count + decimal_count reaches the
# maximum digits of int16/int32/int64/int128), but the first surplus digit must still decide the rounding.
# One block per tier, with surplus digits that round down, round up, and round out of range.
# ==================================================================================================

query I
SELECT CAST('0.12344' AS DECIMAL(4,4));
----
.1234

