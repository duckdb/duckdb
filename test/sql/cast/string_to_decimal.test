# ==================================================================================================
# Negative exponent with a mantissa wider than width - scale
# The mantissa has more integer digits than the type has room for, but the exponent moves them behind the decimal
# point (and the surplus is rounded).
# ==================================================================================================

query I
SELECT CAST('10e-6' AS DECIMAL(5,5));
----
.00001

query I
SELECT CAST('12e-5' AS DECIMAL(5,4));
----
0.0001

query I
SELECT CAST('15e-5' AS DECIMAL(5,4));
----
0.0002

query I
SELECT CAST('-15e-5' AS DECIMAL(5,4));
----
-0.0002

query I
SELECT CAST('1234e-4' AS DECIMAL(4,2));
----
0.12

query I
SELECT CAST('1234e-3' AS DECIMAL(4,2));
----
1.23

query I
SELECT CAST('12345678e-4' AS DECIMAL(9,4));
----
1234.5678

query I
SELECT CAST('12345678e-12' AS DECIMAL(9,9));
----
.000012346

query I
SELECT CAST('12345678901234567e-9' AS DECIMAL(18,9));
----
12345678.901234567

query I
SELECT CAST('12345678901234567e-17' AS DECIMAL(18,18));
----
.123456789012345670

query I
SELECT CAST('1234567890123456789e-10' AS DECIMAL(19,10));
----
123456789.0123456789

query I
SELECT CAST('1234567890123456789012345678901234567e-19' AS DECIMAL(38,19));
----
123456789012345678.9012345678901234567

query I
SELECT CAST('1234567890123456789012345678901234567e-38' AS DECIMAL(38,38));
----
.01234567890123456789012345678901234567

query I
SELECT CAST('-1234567890123456789012345678901234567e-38' AS DECIMAL(38,38));
----
-.01234567890123456789012345678901234567

# ==================================================================================================
# Negative exponent: rounding and zero results
# The same rounding rules as for plain decimals (half away from zero on the first dropped digit), applied when the
# exponent drops digits of a mantissa that does not fit before. Includes results that round to zero, and exponents
# so negative that the whole mantissa disappears.
# ==================================================================================================

query I
SELECT CAST('4e-6' AS DECIMAL(5,5));
----
.00000

query I
SELECT CAST('5e-6' AS DECIMAL(5,5));
----
.00001

query I
SELECT CAST('-5e-6' AS DECIMAL(5,5));
----
-.00001

