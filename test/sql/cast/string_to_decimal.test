query I
SELECT CAST('1e-100' AS DECIMAL(38,38));
----
.00000000000000000000000000000000000000

# ==================================================================================================
# Negative exponent: the scaled intermediate would overflow the storage type
# A parser that scales the mantissa up to the target scale and then divides by the exponent needs an intermediate
# (e.g. 99999 * 10^5) that does not fit the physical type even though the result does.
# ==================================================================================================

query I
SELECT CAST('999e-4' AS DECIMAL(4,4));
----
.0999

query I
SELECT CAST('99999e-5' AS DECIMAL(5,5));
----
.99999

query I
SELECT CAST('-99999e-5' AS DECIMAL(5,5));
----
-.99999

query I
SELECT CAST('99999e-6' AS DECIMAL(7,7));
----
.0999990

query I
SELECT CAST('9e-1' AS DECIMAL(9,9));
----
.900000000

query I
SELECT CAST('99999999999e-10' AS DECIMAL(18,10));
----
9.9999999999

query I
SELECT CAST('999999999999999e-18' AS DECIMAL(18,18));
----
.000999999999999999

query I
SELECT CAST('9e-1' AS DECIMAL(18,18));
----
.900000000000000000

query I
SELECT CAST('9999999999999999999e-19' AS DECIMAL(19,19));
----
.9999999999999999999

query I
SELECT CAST('999999999999999999999999999999e-30' AS DECIMAL(38,30));
----
0.999999999999999999999999999999

query I
SELECT CAST('9e-1' AS DECIMAL(38,38));
----
.90000000000000000000000000000000000000

query I
SELECT CAST('2e-38' AS DECIMAL(38,38));
----
.00000000000000000000000000000000000002

# ==================================================================================================
# Negative exponent when the mantissa fills the whole storage type
# The mantissa uses every digit that the physical type can hold (4 / 9 / 18 / 38 digits). Digits that are dropped
# because the type is full can no longer decide the rounding, so these are the hardest negative-exponent inputs;
# the last block has a surplus decimal that rounds up or down on a digit the type could not store.
# ==================================================================================================

query I
SELECT CAST('1234e-2' AS DECIMAL(4,2));
----
12.34

query I
SELECT CAST('-1234e-2' AS DECIMAL(4,2));
----
