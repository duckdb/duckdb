# ==================================================================================================
# Limits of the physical storage types
# DECIMAL is stored as int16 (width 1-4), int32 (5-9), int64 (10-18) or int128 (19-38). Values just around the
# maximum of each storage type, and digit strings that are longer than the type can hold, must be
# accepted exactly when they fit the declared width.
# ==================================================================================================

query I
SELECT CAST('9999' AS DECIMAL(4,0));
----
9999

query I
SELECT CAST('-9999' AS DECIMAL(4,0));
----
-9999

statement error
SELECT CAST('10000' AS DECIMAL(4,0));
----
Conversion Error: Could not convert string "10000" to DECIMAL(4,0)

statement error
SELECT CAST('32767' AS DECIMAL(4,0));
----
Conversion Error: Could not convert string "32767" to DECIMAL(4,0)

statement error
SELECT CAST('32768' AS DECIMAL(4,0));
----
Conversion Error: Could not convert string "32768" to DECIMAL(4,0)

