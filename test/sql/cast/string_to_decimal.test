# ==================================================================================================
# Scale equal to the width (no integer digits) and scale zero
# DECIMAL(w,w) only holds values in (-1, 1), so any non-zero integer digit is out of range, and rounding
# can push the value to +-1.0. DECIMAL(w,0) is the opposite extreme. Tested at every tier boundary.
# ==================================================================================================

query I
SELECT CAST('0.1' AS DECIMAL(1,1));
----
.1

query I
SELECT CAST('-.9' AS DECIMAL(1,1));
----
-.9

query I
SELECT CAST('0.1' AS DECIMAL(1,1));
----
.1

statement error
SELECT CAST('1' AS DECIMAL(1,1));
----
Conversion Error: Could not convert string "1" to DECIMAL(1,1)

statement error
SELECT CAST('0.95' AS DECIMAL(1,1));
----
Conversion Error: Could not convert string "0.95" to DECIMAL(1,1)

