# ==================================================================================================
# Exponent: negative exponents whose mantissa fits the width
# A negative exponent divides the value again. These all have a mantissa that fits in 'width - scale' integer
# digits: division with and without rounding (positive and negative values), and the early exit once the
# result is zero.
# ==================================================================================================

query I
SELECT CAST('1e-1' AS DECIMAL(5,2));
----
0.10

