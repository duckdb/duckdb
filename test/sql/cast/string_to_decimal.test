# ==================================================================================================
# Exponent: zero and positive exponents
# HandleExponent with exponent 0 (rounding is then done by Finalize) and exponent > 0 (trailing zeros are
# appended, so the width check applies). e/E, optional '+', leading zeros in the exponent, a zero mantissa,
# and results that overflow the width.
# ==================================================================================================

query I
SELECT CAST('1e0' AS DECIMAL(1,0));
----
1

