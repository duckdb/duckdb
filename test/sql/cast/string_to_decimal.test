# ==================================================================================================
# Exponent: surplus decimals versus the exponent
# When the mantissa has more decimals than the scale, a positive exponent consumes them first. HandleExponent
# then either truncates the remaining surplus (and rounds on the last removed digit), or - if the exponent is
# larger - appends zeros. Scale 2 throughout, one type per storage tier.
# ==================================================================================================

query I
SELECT CAST('1.2345e1' AS DECIMAL(4,2));
----
12.35

query I
SELECT CAST('1.2344e1' AS DECIMAL(4,2));
