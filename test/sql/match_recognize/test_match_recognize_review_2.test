# name: test/sql/match_recognize/test_match_recognize_review_2.test
# description: MATCH_RECOGNIZE cases from the second review round
# group: [match_recognize]

statement ok
pragma threads=1;

# Cycle detection over a nullable repetition. Matching a row opens a scope of its own, so an
# alternative left behind under an earlier one has to see the marks that scope had taken: without
# them it walks the empty loop again, matches the same row again, and never stops.
query I
FROM range(1) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n
    PATTERN ((A*)* B)
    DEFINE A AS true, B AS FIRST(A.x) < 0
)
----

query I
FROM range(1) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n
    PATTERN ((A+)* B)
    DEFINE A AS true, B AS FIRST(A.x) < 0
)
----

query I
FROM range(4) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n
    PATTERN ((A*)* B)
    DEFINE A AS x < 2, B AS FIRST(A.x) = 0
)
----
3

# a reluctant nullable repetition takes the way out first, and still may not spin in the loop
query I
FROM range(3) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n
    PATTERN ((A*?)*? B)
    DEFINE A AS true, B AS FIRST(A.x) < 0
)
----

# backtracking after rows have been matched still finds the alternative that works
query I
FROM (VALUES (1), (2)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n
    PATTERN ((A | B) C)
    DEFINE A AS false, B AS true, C AS FIRST(B.x) IS NOT NULL
)
----
2

# A measure may be called after a column of the input. The projections below the output refer to the
# measure by a name of its own, so the reference cannot find the input column instead.
query I
FROM (VALUES (10), (20)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES sum(x) AS x
    PATTERN (A+)
)
----
30

query II
FROM (VALUES (10), (20)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES sum(x) AS x
    ALL ROWS PER MATCH PATTERN (A+)
)
----
10	10
20	30

# the columns a clause needs are named after the clause, so an input column of the shape they used to
# have is left alone
query I
FROM (VALUES (10, 99), (20, 99)) t(x, __mr_win_0) MATCH_RECOGNIZE (
    ORDER BY x MEASURES PREV(x) AS p
    PATTERN (A)
)
----
NULL
10

query I
FROM (VALUES (10, 99), (20, 99)) t(x, __mr_nav_0) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n
    PATTERN (A+) DEFINE A AS FIRST(x) = 10
)
----
2

query I
FROM (VALUES (10, 99), (20, 99)) t(x, __mr_match_number) MATCH_RECOGNIZE (
    ORDER BY x MEASURES MATCH_NUMBER() AS m
    PATTERN (A+)
)
----
1

# Two of the input's tables can have a column of the same name, and a reference qualified with one of
# them means that one. The clause is evaluated above a subquery of the input, so the reference is
# computed where the input still is one rather than reduced to a bare column name.
query II
FROM (VALUES (10)) t1(x) JOIN (VALUES (20)) t2(x) ON true
MATCH_RECOGNIZE (
    MEASURES t1.x AS ax, t2.x AS bx PATTERN (Z)
)
----
10	20

query I
FROM (VALUES (10)) t1(x) JOIN (VALUES (20)) t2(x) ON true
MATCH_RECOGNIZE (
    MEASURES count(*) AS n PATTERN (Z) DEFINE Z AS t2.x > 15
)
----
1

query I
FROM (VALUES (10)) t1(x) JOIN (VALUES (20)) t2(x) ON true
MATCH_RECOGNIZE (
    MEASURES count(*) AS n PATTERN (Z) DEFINE Z AS t1.x > 15
)
----

# a qualifier only names the table; everything behind it navigates into the column
query I
FROM (VALUES ({'v': 10}, 99)) t(x, v) MATCH_RECOGNIZE (
    MEASURES t.x.v AS s PATTERN (A)
)
----
10

query I
FROM (VALUES ({'v': 10}, 99)) t(x, v) MATCH_RECOGNIZE (
    MEASURES count(*) AS n PATTERN (A) DEFINE A AS t.x.v = 10
)
----
1

query I
FROM (VALUES ({'v': 10}), ({'v': 20})) t(x) MATCH_RECOGNIZE (
    ORDER BY x.v MEASURES LAST(A.x.v) AS s PATTERN (A+)
)
----
20

# partitioning and ordering are bound where the input still is one, and report the name they spelled
query I
FROM (VALUES (10), (20)) t(x) MATCH_RECOGNIZE (
    ORDER BY t.x MEASURES sum(x) AS s PATTERN (A+)
)
----
30

query II
FROM (VALUES (10, 'a'), (20, 'a')) t(x, g) MATCH_RECOGNIZE (
    PARTITION BY t.g ORDER BY t.x MEASURES sum(x) AS s PATTERN (A+)
)
----
a	30

# a name the input's tables and the pattern share is the pattern variable's
query I
FROM (VALUES (10), (20)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES LAST(t.x) AS s PATTERN (t+) DEFINE t AS x > 0
)
----
20

# The filter of an aggregate says which of the match's rows it sees, so it reads the match the way
# every other MEASURES expression does.
query I
FROM (VALUES (10), (20)) t(x) MATCH_RECOGNIZE (
    ORDER BY x
    MEASURES sum(x) FILTER (WHERE CLASSIFIER()='A') AS s
    PATTERN (A B)
)
----
10

query I
FROM (VALUES (10), (20)) t(x) MATCH_RECOGNIZE (
    ORDER BY x
    MEASURES sum(CASE WHEN CLASSIFIER()='A' THEN x END) AS s
    PATTERN (A B)
)
----
10

query I
FROM (VALUES (10), (20), (30)) t(x) MATCH_RECOGNIZE (
    ORDER BY x
    MEASURES sum(x) FILTER (WHERE MATCH_NUMBER() = 1) AS s
    PATTERN (A+)
)
----
60

# a variable named in a filter scopes the aggregate the way one named in an argument does
query I
FROM (VALUES (10), (20)) t(x) MATCH_RECOGNIZE (
    ORDER BY x
    MEASURES sum(x) FILTER (WHERE B.x > 15) AS s
    PATTERN (A B) DEFINE B AS x > 15
)
----
20

statement error
FROM (VALUES (10), (20)) t(x) MATCH_RECOGNIZE (
    ORDER BY x
    MEASURES sum(A.x) FILTER (WHERE B.x > 15) AS s
    PATTERN (A B) DEFINE B AS x > 15
)
----
reads the rows of one pattern variable

# A navigation offset is a constant, and NULL is not one of the constants it can be. Both clauses
# turn it away the same way rather than reading it as a number.
statement error
FROM (VALUES (10), (20)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES FIRST(x, NULL) AS s PATTERN (A+)
)
----
must be a non-negative integer, not NULL

statement error
FROM (VALUES (10), (20)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n PATTERN (A+) DEFINE A AS FIRST(x, NULL) > 0
)
----
must be a non-negative integer, not NULL

statement error
FROM (VALUES (10), (20)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES LAST(x, -1) AS s PATTERN (A+)
)
----
must be a non-negative integer

query I
FROM (VALUES (10), (20)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES FIRST(x, 1) AS s PATTERN (A+)
)
----
20

# An aggregate reached through a macro is still an aggregate over the rows of the match.
statement ok
CREATE MACRO my_sum(v) AS sum(v);

query I
FROM (VALUES (10), (20)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES my_sum(x) AS s PATTERN (A+)
)
----
30

query I
FROM (VALUES (10), (20)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES my_sum(B.x) AS s PATTERN (A B) DEFINE B AS x > 15
)
----
20

statement ok
CREATE MACRO add_one(v) AS v + 1;

query I
FROM (VALUES (10), (20)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES add_one(FIRST(x)) AS s PATTERN (A+)
)
----
11

statement ok
CREATE MACRO agg_pair(a, b) AS sum(a) + sum(b);

statement error
FROM (VALUES (10), (20)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES agg_pair(x, x) AS s PATTERN (A+)
)
----
exactly one aggregate function

# The memberships of the rows in overlapping matches are held in blocks that count against the memory
# limit, so a pattern that produces far more of them than there are rows fails rather than growing
# outside it.
statement ok
SET memory_limit='20MB';

statement error
SELECT count(*) FROM range(1500) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n
    AFTER MATCH SKIP TO NEXT ROW PATTERN (A+)
);
----
Out of Memory Error

statement ok
RESET memory_limit;

query I
SELECT count(*) FROM range(1500) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n
    AFTER MATCH SKIP TO NEXT ROW PATTERN (A+)
);
----
1500

# navigation nested behind another function is still nested navigation
statement error
FROM (VALUES (10), (20)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n
    PATTERN (A+) DEFINE A AS FIRST(abs(LAST(x))) > 0
)
----
Nested row pattern navigation is not supported
