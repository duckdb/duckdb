# name: test/sql/match_recognize/test_match_recognize_review.test
# description: MATCH_RECOGNIZE cases that used to give a wrong answer or an internal error
# group: [match_recognize]

statement ok
pragma threads=1;

# a state that failed under one set of matched rows can succeed under another, so a condition that
# navigates the match cannot leave that state recorded as a dead end for the alternative beside it
query I
FROM (VALUES (1), (2)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n
    PATTERN ((A | B) C)
    DEFINE A AS true, B AS true, C AS FIRST(B.x) IS NOT NULL
)
----
2

# the same pattern with the shared symbol written out per alternative has always worked
query I
FROM (VALUES (1), (2)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n
    PATTERN (A C | B C)
    DEFINE A AS true, B AS true, C AS FIRST(B.x) IS NOT NULL
)
----
2

# a state a failed attempt walked past the end of its partition is the first row of the next one, and
# what it was recorded under does not hold there
query I
SELECT count(*)
FROM (VALUES (0::BIGINT), (11::BIGINT)) t(p) MATCH_RECOGNIZE (
    PARTITION BY p MEASURES count(*) AS n
    PATTERN (A? B)
    DEFINE A AS true, B AS p % 2 = 1
)
----
1

query I
SELECT count(*)
FROM (VALUES (0::BIGINT), (11::BIGINT)) t(p) MATCH_RECOGNIZE (
    PARTITION BY p MEASURES count(*) AS n
    PATTERN (A? B)
    DEFINE A AS false, B AS p % 2 = 1
)
----
1

# an aggregate over a pattern variable reads the rows that variable matched. Passing the other rows in
# as NULL is not the same thing: an aggregate that keeps NULLs, or an argument that replaces them,
# would see them.
query III
FROM (VALUES (1), (2)) t(x) MATCH_RECOGNIZE (
    ORDER BY x
    MEASURES list(A.x) AS xs, count(A.x) AS n, sum(coalesce(A.x, 100)) AS s
    PATTERN (A B)
)
----
[1]	1	1

# an aggregate reads the rows of one variable
statement error
FROM (VALUES (1), (2)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES sum(A.x + B.x) AS s PATTERN (A B)
)
----
<REGEX>:Binder Error:.*aggregate in MEASURES reads the rows of one pattern variable.*

# the matcher's state is not part of the result, so a second clause over the first sees only x
query II
SELECT column_name, column_type FROM (DESCRIBE FROM (VALUES (1), (2)) t(x) MATCH_RECOGNIZE (
    ORDER BY x ALL ROWS PER MATCH PATTERN (A+)
))
----
x	INTEGER

query I
FROM (VALUES (1), (2)) t(x) MATCH_RECOGNIZE (
    ORDER BY x ALL ROWS PER MATCH PATTERN (A+)
) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n PATTERN (B)
)
----
1
1

# a condition decides whether a row is the variable, so it has to produce a boolean
query I
FROM (VALUES (1)) t(x) MATCH_RECOGNIZE (
    MEASURES count(*) AS n PATTERN (A) DEFINE A AS NULL
)
----

query I
FROM (VALUES (1)) t(x) MATCH_RECOGNIZE (
    MEASURES count(*) AS n PATTERN (A) DEFINE A AS x
)
----
1

statement error
FROM (VALUES (1)) t(x) MATCH_RECOGNIZE (
    MEASURES count(*) AS n PATTERN (A) DEFINE A AS 'nope'
)
----
<REGEX>:Conversion Error:.*

# the window function the clause is planned as is not one to call
statement error
SELECT "match_recognize"(1) OVER ()
----
<REGEX>:Binder Error:.*cannot be used directly.*

# a condition that reads MATCH_NUMBER() has no answer until there is a candidate match to read it
# from, so it must not be evaluated as the rows arrive
query I
FROM (VALUES (1)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n
    PATTERN (A) DEFINE A AS CAST(1.0 / MATCH_NUMBER() AS INTEGER) = 1
)
----
1

# an ordered aggregate keeps its own ordering
query I
FROM (VALUES (1), (2), (3)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES list(x ORDER BY x DESC) AS xs PATTERN (A+)
)
----
[3, 2, 1]

query I
FROM (VALUES (1), (2), (3)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES list(A.x ORDER BY A.x DESC) AS xs PATTERN (A+)
)
----
[3, 2, 1]

# a variable the PATTERN only mentions is still a variable, so a condition may name it
query I
FROM (VALUES (1), (2)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n PATTERN (A B) DEFINE B AS B.x > A.x
)
----
2

query I
FROM (VALUES (1), (2)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n PATTERN (A B) DEFINE A AS true, B AS B.x > A.x
)
----
2

# an empty match covers no rows, so a measure has none to read a column from
query II
FROM (VALUES (1)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES x AS bare, LAST(x) AS navigated
    PATTERN (A*) DEFINE A AS false
)
----
NULL	NULL

# count() over an empty match is still 0 rather than NULL
query II
FROM (VALUES (1)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n, MATCH_NUMBER() AS mn
    PATTERN (A*) DEFINE A AS false
)
----
0	1

# a repetition of a subpattern that has to match n rows can only be reached as often as the rows allow
query I
SELECT count(*) FROM range(700) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n PATTERN ((A{700}){700})
)
----
0

statement error
FROM range(700) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n PATTERN ((((A?){700}){700}){3})
)
----
<REGEX>:Invalid Input Error:.*compiles to more than.*instructions.*

# the record the matcher keeps counts against the memory limit
statement ok
SET memory_limit='20MB';

statement error
FROM range(700) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n PATTERN (((A?){700}){700})
)
----
<REGEX>:Out of Memory Error:.*

statement ok
RESET memory_limit;

# matching is interruptible
statement ok
SET max_execution_time=50;

statement error
FROM range(15000) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n PATTERN (A+ B) DEFINE B AS MATCH_NUMBER() < 0
)
----
<REGEX>:INTERRUPT Error:.*

statement error
FROM range(15000) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n PATTERN (A+ B) DEFINE B AS FIRST(x) < 0
)
----
<REGEX>:INTERRUPT Error:.*

statement ok
SET max_execution_time=0;

# the alias list renames the columns, as it does for any other table reference
query I
SELECT n FROM (VALUES (1), (2)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS c PATTERN (A+)
) mr(n)
----
2

statement error
SELECT n FROM (VALUES (1), (2)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS c PATTERN (A+)
) mr(n, too, many)
----
<REGEX>:Binder Error:.*columns available but.*columns specified.*

# what is in front of a column is a table to strip only if the input has one by that name; anything
# else is navigation into the column and has to survive
query I
FROM (VALUES ({'v': 1})) t(x) MATCH_RECOGNIZE (
    MEASURES x.v AS v PATTERN (A)
)
----
1

query I
FROM (VALUES ({'v': 1}), ({'v': 2})) t(x) MATCH_RECOGNIZE (
    MEASURES count(*) AS n PATTERN (A+) DEFINE A AS x.v > 0
)
----
2

statement ok
CREATE TABLE qualified(x INTEGER);

statement ok
INSERT INTO qualified VALUES (1), (2);

query I
FROM qualified q MATCH_RECOGNIZE (
    ORDER BY x MEASURES max(q.x) AS m PATTERN (A+) DEFINE A AS q.x > 0
)
----
2

query I
FROM qualified MATCH_RECOGNIZE (
    ORDER BY x MEASURES max(qualified.x) AS m PATTERN (A+) DEFINE A AS qualified.x > 0
)
----
2
