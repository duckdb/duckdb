# name: test/sql/match_recognize/test_match_recognize_review_3.test
# description: MATCH_RECOGNIZE cases from the third review round
# group: [match_recognize]

statement ok
pragma threads=1;

# An offset counts rows within the match, so it is compared against how many there are rather than
# added to one end first: added first it wraps and lands back inside the match.
statement error
FROM (VALUES (1), (2), (3)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES x AS s PATTERN (A)
    DEFINE A AS FIRST(x, 18446744073709551615) IS NOT NULL
)
----
larger than any match can have rows

statement error
FROM (VALUES (1), (2), (3)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES x AS s PATTERN (A)
    DEFINE A AS LAST(x, 18446744073709551615) IS NOT NULL
)
----
larger than any match can have rows

# the two clauses turn away the same offsets
statement error
FROM (VALUES (1), (2), (3)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES FIRST(x, 18446744073709551615) AS s PATTERN (A+)
)
----
larger than any match can have rows

# the largest offset either clause accepts is still an offset no match reaches
query I
FROM (VALUES (1), (2), (3)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES x AS s PATTERN (A)
    DEFINE A AS FIRST(x, 9223372036854775806) IS NOT NULL
)
----

query II
FROM (VALUES (1), (2), (3)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES FIRST(x, 9223372036854775806) AS f, LAST(x, 9223372036854775806) AS l
    PATTERN (A+)
)
----
NULL	NULL

# offset zero is the end it counts from
query II
FROM (VALUES (1), (2), (3)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES FIRST(x, 0) AS f, LAST(x, 0) AS l PATTERN (A+)
)
----
1	3

query II
FROM (VALUES (1), (2), (3)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES FIRST(x, 1) AS f, LAST(x, 1) AS l PATTERN (A+)
)
----
2	2

# an offset past the end of the match reports nothing rather than a row outside it
query II
FROM (VALUES (1), (2), (3)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES FIRST(x, 5) AS f, LAST(x, 5) AS l PATTERN (A+)
)
----
NULL	NULL

query I
FROM (VALUES (1), (2), (3)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n PATTERN (A+)
    DEFINE A AS FIRST(x, 1) IS NULL OR FIRST(x, 1) = 2
)
----
3

query I
FROM (VALUES (1), (2), (3)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n PATTERN (A+)
    DEFINE A AS LAST(x, 1) IS NULL OR LAST(x, 1) < x
)
----
3

# an offset within a variable's own rows is bounded by how many of them there are
query I
FROM (VALUES (1), (2), (3), (4)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n PATTERN (A+)
    DEFINE A AS FIRST(A.x, 2) IS NULL OR FIRST(A.x, 2) = 3
)
----
4
