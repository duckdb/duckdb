# name: test/sql/match_recognize/test_match_recognize_oracle.test
# description: MATCH_RECOGNIZE results checked against Oracle
# group: [match_recognize]

# Every expected result below was produced by Oracle AI Database 26ai Free (23.26.3.0.0) running the
# query above it, unchanged. The clause order is Oracle's fixed one and nothing engine specific
# appears in the queries, so the same text runs on both and a difference in the output would be a
# difference in the implementations rather than in how the question was asked.
#
# The data is small enough to check by hand: AAA walks down, up, along a plateau, down, up, a second
# plateau, then spikes, so one partition carries falls, rises, ties and reversals. BBB carries a tie
# and a NULL.

statement ok
pragma threads=1;

statement ok
CREATE TABLE ticks (sym VARCHAR(4), ts INTEGER, price INTEGER);

statement ok
CREATE TABLE evt (g INTEGER, seq INTEGER, c VARCHAR(1));

statement ok
INSERT INTO ticks VALUES
    ('AAA', 1, 10),
    ('AAA', 2, 8),
    ('AAA', 3, 6),
    ('AAA', 4, 9),
    ('AAA', 5, 12),
    ('AAA', 6, 12),
    ('AAA', 7, 7),
    ('AAA', 8, 5),
    ('AAA', 9, 9),
    ('AAA', 10, 9),
    ('AAA', 11, 3),
    ('AAA', 12, 15),
    ('BBB', 1, 5),
    ('BBB', 2, 4),
    ('BBB', 3, 4),
    ('BBB', 4, 6),
    ('BBB', 5, NULL),
    ('BBB', 6, 7);

statement ok
INSERT INTO evt VALUES (1, 1, 'a'), (1, 2, 'a'), (1, 3, 'b'), (1, 4, 'a'), (1, 5, 'c'), (2, 1, 'b'), (2, 2, 'b'), (2, 3, 'b'), (3, 1, 'a');

# v shape
query TIIII
SELECT sym, start_ts, bottom_ts, end_ts, len
FROM ticks MATCH_RECOGNIZE (
  PARTITION BY sym ORDER BY ts
  MEASURES FIRST(ts) AS start_ts, LAST(DOWN.ts) AS bottom_ts, LAST(ts) AS end_ts, COUNT(*) AS len
  ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
  PATTERN (STRT DOWN+ UP+)
  DEFINE DOWN AS price < PREV(price), UP AS price > PREV(price)
) ORDER BY sym, start_ts
----
AAA	1	3	5	5
AAA	6	8	9	4
AAA	10	11	12	3

# greedy giveback
query TII
SELECT sym, first_ts, len
FROM ticks MATCH_RECOGNIZE (
  PARTITION BY sym ORDER BY ts
  MEASURES FIRST(ts) AS first_ts, COUNT(*) AS len
  ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
  PATTERN (A+ B B)
  DEFINE A AS price > 0, B AS price > 0
) ORDER BY sym, first_ts
----
AAA	1	12
BBB	1	4

# greedy star then symbol
query TII
SELECT sym, first_ts, len
FROM ticks MATCH_RECOGNIZE (
  PARTITION BY sym ORDER BY ts
  MEASURES FIRST(ts) AS first_ts, COUNT(*) AS len
  ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
  PATTERN (A* B)
  DEFINE A AS price >= 9, B AS price < 9
) ORDER BY sym, first_ts
----
AAA	1	2
AAA	3	1
AAA	4	4
AAA	8	1
AAA	9	3
BBB	1	1
BBB	2	1
BBB	3	1
BBB	4	1
BBB	6	1

# empty matches star
query IIITI
SELECT g, seq, mno, cls, len
FROM evt MATCH_RECOGNIZE (
  PARTITION BY g ORDER BY seq
  MEASURES MATCH_NUMBER() AS mno, CLASSIFIER() AS cls, COUNT(*) AS len
  ALL ROWS PER MATCH
  PATTERN (Z*)
  DEFINE Z AS c = 'z'
) ORDER BY g, seq
----
1	1	1	NULL	0
1	2	2	NULL	0
1	3	3	NULL	0
1	4	4	NULL	0
1	5	5	NULL	0
2	1	1	NULL	0
2	2	2	NULL	0
2	3	3	NULL	0
3	1	1	NULL	0

# empty matches one row
query III
SELECT g, mno, len
FROM evt MATCH_RECOGNIZE (
  PARTITION BY g ORDER BY seq
  MEASURES MATCH_NUMBER() AS mno, COUNT(*) AS len
  ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
  PATTERN (Z*)
  DEFINE Z AS c = 'z'
) ORDER BY g, mno
----
1	1	0
1	2	0
1	3	0
1	4	0
1	5	0
2	1	0
2	2	0
2	3	0
3	1	0

# optional tail
query III
SELECT g, first_seq, len
FROM evt MATCH_RECOGNIZE (
  PARTITION BY g ORDER BY seq
  MEASURES FIRST(seq) AS first_seq, COUNT(*) AS len
  ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
  PATTERN (A B?)
  DEFINE A AS c = 'a', B AS c = 'b'
) ORDER BY g, first_seq
----
1	1	1
1	2	2
1	4	1
3	1	1

# alternation prefers left
query IIT
SELECT g, seq, cls
FROM evt MATCH_RECOGNIZE (
  PARTITION BY g ORDER BY seq
  MEASURES CLASSIFIER() AS cls
  ALL ROWS PER MATCH
  PATTERN ((X | Y)+)
  DEFINE X AS c IN ('a','b','c'), Y AS c IN ('a','b','c')
) ORDER BY g, seq
----
1	1	X
1	2	X
1	3	X
1	4	X
1	5	X
2	1	X
2	2	X
2	3	X
3	1	X

# alternation prefers right
query IIT
SELECT g, seq, cls
FROM evt MATCH_RECOGNIZE (
  PARTITION BY g ORDER BY seq
  MEASURES CLASSIFIER() AS cls
  ALL ROWS PER MATCH
  PATTERN ((Y | X)+)
  DEFINE X AS c IN ('a','b','c'), Y AS c IN ('a','b','c')
) ORDER BY g, seq
----
1	1	Y
1	2	Y
1	3	Y
1	4	Y
1	5	Y
2	1	Y
2	2	Y
2	3	Y
3	1	Y

# skip past last row
query IIII
SELECT g, mno, first_seq, len
FROM evt MATCH_RECOGNIZE (
  PARTITION BY g ORDER BY seq
  MEASURES MATCH_NUMBER() AS mno, FIRST(seq) AS first_seq, COUNT(*) AS len
  ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
  PATTERN (A A)
  DEFINE A AS c IN ('a','b','c')
) ORDER BY g, mno
----
1	1	1	2
1	2	3	2
2	1	1	2

# skip to next row
query IIII
SELECT g, mno, first_seq, len
FROM evt MATCH_RECOGNIZE (
  PARTITION BY g ORDER BY seq
