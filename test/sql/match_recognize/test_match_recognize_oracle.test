# running vs final
query TIIIII
SELECT sym, ts, run_cnt, fin_cnt, run_max, fin_max
FROM ticks MATCH_RECOGNIZE (
  PARTITION BY sym ORDER BY ts
  MEASURES RUNNING COUNT(*) AS run_cnt, FINAL COUNT(*) AS fin_cnt,
           RUNNING MAX(price) AS run_max, FINAL MAX(price) AS fin_max
  ALL ROWS PER MATCH
  PATTERN (A+)
  DEFINE A AS price > 0
) ORDER BY sym, ts
----
AAA	1	1	12	10	15
AAA	2	2	12	10	15
AAA	3	3	12	10	15
AAA	4	4	12	10	15
AAA	5	5	12	12	15
AAA	6	6	12	12	15
AAA	7	7	12	12	15
AAA	8	8	12	12	15
AAA	9	9	12	12	15
AAA	10	10	12	12	15
AAA	11	11	12	12	15
AAA	12	12	12	15	15
BBB	1	1	4	5	6
BBB	2	2	4	5	6
BBB	3	3	4	5	6
BBB	4	4	4	6	6
BBB	6	1	1	7	7

# navigation first last offsets
query TIIII
SELECT sym, f0, f1, l0, l1
FROM ticks MATCH_RECOGNIZE (
  PARTITION BY sym ORDER BY ts
  MEASURES FIRST(price, 0) AS f0, FIRST(price, 1) AS f1,
           LAST(price, 0) AS l0, LAST(price, 1) AS l1
  ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
  PATTERN (A{4})
  DEFINE A AS price > 0
) ORDER BY sym, f0, f1
----
AAA	9	9	15	3
AAA	10	8	9	6
AAA	12	12	5	7
BBB	5	4	6	4

