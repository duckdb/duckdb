1	2	2	2
1	3	3	2
1	4	4	2
2	1	1	2
2	2	2	2

# skip to last var
query TIII
SELECT sym, mno, first_ts, len
FROM ticks MATCH_RECOGNIZE (
  PARTITION BY sym ORDER BY ts
  MEASURES MATCH_NUMBER() AS mno, FIRST(ts) AS first_ts, COUNT(*) AS len
  ONE ROW PER MATCH AFTER MATCH SKIP TO LAST DOWN
  PATTERN (STRT DOWN+ UP+)
  DEFINE DOWN AS price < PREV(price), UP AS price > PREV(price)
) ORDER BY sym, mno
