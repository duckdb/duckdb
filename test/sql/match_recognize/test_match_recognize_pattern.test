# name: test/sql/match_recognize/test_match_recognize_pattern.test
# description: MATCH_RECOGNIZE PATTERN semantics - quantifiers, alternation, grouping
# group: [match_recognize]

statement ok
pragma threads=1;

statement ok
create table seq(i integer, v integer);

# A holds on offsets 0,1,3,4,5 and B holds on offset 2
statement ok
insert into seq values (1,1),(2,1),(3,0),(4,1),(5,1),(6,1);

# a single symbol matches one row at a time, so every A row starts its own match
query I
SELECT x FROM seq MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (A) DEFINE A as v=1, B as v=0
) ORDER BY x
----
1
2
4
5
6

# + is greedy: 0-1 stops at the B row, 3-5 runs to the end
query III
SELECT i, __pattern_window.match_start, __pattern_window.match_end FROM seq MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x ALL ROWS PER MATCH PATTERN (A+) DEFINE A as v=1, B as v=0
) ORDER BY i
----
1	0	1
2	0	1
4	3	5
5	3	5
6	3	5

# a pattern that can match nothing produces an empty match where no rows fit, here at the B row
query I
SELECT x FROM seq MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (A*) DEFINE A as v=1, B as v=0
) ORDER BY x
----
2
3
6

# repeating a symbol is the same as an exact quantifier; the overlapping 4-5 match is dropped
query I
SELECT x FROM seq MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (A A) DEFINE A as v=1, B as v=0
) ORDER BY x
----
2
5

query I
SELECT x FROM seq MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (A{2}) DEFINE A as v=1, B as v=0
) ORDER BY x
----
2
5

# only 3,4,5 are three consecutive A rows
query I
SELECT x FROM seq MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (A{3}) DEFINE A as v=1, B as v=0
) ORDER BY x
----
6

query I
SELECT x FROM seq MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (A{2,3}) DEFINE A as v=1, B as v=0
) ORDER BY x
----
2
6

query I
SELECT x FROM seq MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (A{1,}) DEFINE A as v=1, B as v=0
) ORDER BY x
----
2
6

# capping the match at two rows leaves offset 5 free to start its own match
query I
SELECT x FROM seq MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (A{,2}) DEFINE A as v=1, B as v=0
) ORDER BY x
----
2
3
5
6

# ? takes the symbol or leaves it out, so like A* it still matches nothing at the B row
query I
SELECT x FROM seq MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (A?) DEFINE A as v=1, B as v=0
) ORDER BY x
----
1
2
3
4
5
6

query I
SELECT x FROM seq MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (A{0,1}) DEFINE A as v=1, B as v=0
) ORDER BY x
----
1
2
3
4
5
6

# an optional tail is taken where it fits and skipped where it does not: only the match starting at
# offset 1 is followed by a B row
query I
SELECT x FROM seq MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (A B?) DEFINE A as v=1, B as v=0
) ORDER BY x
----
1
3
4
5
6

query II
SELECT i, __pattern_window.classifier FROM seq MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x ALL ROWS PER MATCH PATTERN (A B?) DEFINE A as v=1, B as v=0
) ORDER BY i
----
1	A
2	A
3	B
4	A
5	A
6	A

# a group takes the quantifier as a whole, so the B A pair is matched or skipped together
query I
SELECT x FROM seq MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (A (B A)?) DEFINE A as v=1, B as v=0
) ORDER BY x
----
1
4
5
6

# concatenation
query III
SELECT i, __pattern_window.match_start, __pattern_window.match_end FROM seq MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x ALL ROWS PER MATCH PATTERN (A B) DEFINE A as v=1, B as v=0
) ORDER BY i
----
2	1	2
3	1	2

query I
SELECT x FROM seq MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (B A) DEFINE A as v=1, B as v=0
) ORDER BY x
----
4

query I
SELECT x FROM seq MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (A B A) DEFINE A as v=1, B as v=0
) ORDER BY x
----
4

# a greedy prefix still lets the following symbol match
query I
SELECT x FROM seq MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (A* B) DEFINE A as v=1, B as v=0
) ORDER BY x
----
3

query I
SELECT x FROM seq MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (A+ B A+) DEFINE A as v=1, B as v=0
) ORDER BY x
----
6

# alternation covers every row, and is order independent
query I
SELECT x FROM seq MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (A | B) DEFINE A as v=1, B as v=0
) ORDER BY x
----
1
2
3
4
5
6

query I
SELECT x FROM seq MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (B | A) DEFINE A as v=1, B as v=0
) ORDER BY x
----
1
2
3
4
5
6

# an unquantified group matches exactly once, so grouping does not change the meaning
query I
SELECT x FROM seq MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN ((A) (B)) DEFINE A as v=1, B as v=0
) ORDER BY x
----
3

query I
SELECT x FROM seq MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN ((A B)) DEFINE A as v=1, B as v=0
) ORDER BY x
----
3

query I
SELECT x FROM seq MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN ((A)(B)(A)) DEFINE A as v=1, B as v=0
) ORDER BY x
----
4

query I
SELECT x FROM seq MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (((A))) DEFINE A as v=1, B as v=0
) ORDER BY x
----
1
2
4
5
6

# a symbol used in the pattern but not defined is implicitly true
query I
SELECT x FROM seq MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (B Z) DEFINE A as v=1, B as v=0
) ORDER BY x
----
4

# quantified groups and nested alternation parse and plan
statement ok
SELECT count(*) FROM seq MATCH_RECOGNIZE(
    MEASURES i AS x PATTERN ((A (B A)*){1,2}) DEFINE A as v=1, B as v=0
)

statement ok
SELECT count(*) FROM seq MATCH_RECOGNIZE(
    MEASURES i AS x PATTERN (((A | B) | A)+ | (B A)) DEFINE A as v=1, B as v=0
)

statement ok
SELECT count(*) FROM seq MATCH_RECOGNIZE(
    MEASURES i AS x PATTERN (A+ B* A{1,2} B{3,} A{,4}) DEFINE A as v=1, B as v=0
)

# A greedy quantifier has to give back as many rows as the rest of the pattern needs, not just one.
# All but the first of these need it to give back two or more. Grouping the tail must not change the
# answer either: parentheses do not change the language a pattern matches.

statement ok
create table five as select i::integer as i, 'a' as v from range(0,5) g(i);

query II
SELECT count(*), max(len) FROM five MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A+ B)
    DEFINE A AS A.v = 'a', B AS B.v = 'a', C AS C.v = 'a'
)
----
1	5

query II
SELECT count(*), max(len) FROM five MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A+ B B)
    DEFINE A AS A.v = 'a', B AS B.v = 'a', C AS C.v = 'a'
)
----
1	5

query II
SELECT count(*), max(len) FROM five MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A+ B B B)
    DEFINE A AS A.v = 'a', B AS B.v = 'a', C AS C.v = 'a'
)
----
1	5

query II
SELECT count(*), max(len) FROM five MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A+ B C)
    DEFINE A AS A.v = 'a', B AS B.v = 'a', C AS C.v = 'a'
)
----
1	5

query II
SELECT count(*), max(len) FROM five MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A+ B+ C)
    DEFINE A AS A.v = 'a', B AS B.v = 'a', C AS C.v = 'a'
)
----
1	5

query II
SELECT count(*), max(len) FROM five MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A* B B)
    DEFINE A AS A.v = 'a', B AS B.v = 'a', C AS C.v = 'a'
)
----
1	5

query II
SELECT count(*), max(len) FROM five MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A{2,4} B B)
    DEFINE A AS A.v = 'a', B AS B.v = 'a', C AS C.v = 'a'
)
----
1	5

query II
SELECT count(*), max(len) FROM five MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A+ (B C))
    DEFINE A AS A.v = 'a', B AS B.v = 'a', C AS C.v = 'a'
)
----
1	5

query II
SELECT count(*), max(len) FROM five MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN ((A|B)+ C)
    DEFINE A AS A.v = 'a', B AS B.v = 'a', C AS C.v = 'a'
)
----
1	5

query II
SELECT count(*), max(len) FROM five MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A B+ C C)
    DEFINE A AS A.v = 'a', B AS B.v = 'a', C AS C.v = 'a'
)
----
1	5

# the same thing where the variables overlap on real data rather than matching everything: RISE
# takes the whole climb and then has to give two rows back, one for PEAK and one for DROP
statement ok
create table climbs(day integer, level integer);

statement ok
insert into climbs values (1,40),(2,55),(3,61),(4,67),(5,79),(6,40),(7,49),(8,64),(9,76),(10,79);

query III
SELECT count(*), max(first_day), max(len) FROM climbs MATCH_RECOGNIZE(
    ORDER BY day MEASURES FIRST(day) AS first_day, count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (RISE+ PEAK DROP)
    DEFINE RISE AS RISE.level > PREV(RISE.level), PEAK AS true,
           DROP AS DROP.level < PREV(DROP.level)
)
----
1	2	5

query III
SELECT count(*), max(first_day), max(len) FROM climbs MATCH_RECOGNIZE(
    ORDER BY day MEASURES FIRST(day) AS first_day, count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (RISE+ (PEAK DROP))
    DEFINE RISE AS RISE.level > PREV(RISE.level), PEAK AS true,
           DROP AS DROP.level < PREV(DROP.level)
)
----
1	2	5

# Pattern variables are identifiers, so they are written and matched the way every other identifier
# in DuckDB is: case-insensitively, and quoted when they need to be.

statement ok
create table lbl(i integer, v integer, a integer);

statement ok
insert into lbl values (1,1,10),(2,2,20),(3,1,30);

# a quoted variable keeps the spelling it was written with, and that is what CLASSIFIER() reports
query II
SELECT i, __pattern_window.classifier FROM lbl MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x ALL ROWS PER MATCH PATTERN ("lo"+) DEFINE "lo" AS "lo".v > 0
) ORDER BY i
----
1	lo
2	lo
3	lo

# the pattern and the definition do not have to agree on case
query I
SELECT x FROM lbl MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (A+) DEFINE a AS a.v = 1
) ORDER BY x
----
1
3

# quoting also allows a name that is not an identifier on its own
query II
SELECT i, __pattern_window.classifier FROM lbl MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x ALL ROWS PER MATCH PATTERN ("up down"+) DEFINE "up down" AS "up down".v > 1
) ORDER BY i
----
2	up down

# a variable may be named after one of the input's columns: the qualifier says which is meant, so
# a.a reads column a on the rows variable a matched
query II
SELECT i, av FROM lbl MATCH_RECOGNIZE(
    ORDER BY i MEASURES a.a AS av ALL ROWS PER MATCH PATTERN (a+) DEFINE a AS a.a > 10
) ORDER BY i
----
2	20
3	30

# a SUBSET name is an identifier too
query I
SELECT n FROM lbl MATCH_RECOGNIZE(
    ORDER BY i MEASURES last("u".v) AS n PATTERN ("x" "y") SUBSET "u" = ("x", "y")
    DEFINE "x" AS "x".v = 1, "y" AS "y".v = 2
)
----
2

# A quantifier is greedy: it takes as many repetitions as it can and gives them back only when the
# rest of the pattern needs them. A trailing ? reverses that - it takes as few as it can and only
# takes more when the rest of the pattern does not fit otherwise.

statement ok
create table abc(i integer, c varchar);

statement ok
insert into abc values (1,'a'),(2,'a'),(3,'a'),(4,'b');

query II
SELECT count(*), max(len) FROM abc MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A+ B) DEFINE A AS c='a', B AS true
)
----
1	4

# one A, then B takes the row after it, twice over
query II
SELECT count(*), max(len) FROM abc MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A+? B) DEFINE A AS c='a', B AS true
)
----
2	2

query II
SELECT count(*), max(len) FROM abc MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A* B) DEFINE A AS c='a', B AS true
)
----
1	4

# no A at all, so every row is a match of its own
query II
SELECT count(*), max(len) FROM abc MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A*? B) DEFINE A AS c='a', B AS true
)
----
4	1

query II
SELECT count(*), max(len) FROM abc MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A{1,3}) DEFINE A AS c='a'
)
----
1	3

# the lower bound is still a floor: it takes one and stops
query II
SELECT count(*), max(len) FROM abc MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A{1,3}?) DEFINE A AS c='a'
)
----
3	1

# ?? is the optional quantifier made reluctant, which prefers leaving it out
query II
SELECT count(*), max(len) FROM abc MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A?? B) DEFINE A AS c='a', B AS true
)
----
4	1

# a reluctant quantifier still has to reach the end of the pattern, so it gives ground when the
# tail cannot be satisfied any other way
query II
SELECT count(*), max(len) FROM abc MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A+? C) DEFINE A AS c='a', C AS c='b'
)
----
1	4

# PERMUTE(A, B) stands for every order its parts can be matched in, tried in the order the list is
# written: PERMUTE(A, B) is (A B | B A), so A B is preferred where both fit.

statement ok
create table perm(i integer, c varchar);

statement ok
insert into perm values (1,'b'),(2,'a'),(3,'c'),(4,'a'),(5,'b');

query II
SELECT count(*), max(len) FROM perm MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (PERMUTE(A, B)) DEFINE A AS c='a', B AS c='b'
)
----
2	2

# which is exactly the alternation it stands for
query II
SELECT count(*), max(len) FROM perm MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN ((A B) | (B A)) DEFINE A AS c='a', B AS c='b'
)
----
2	2

# three parts reach every arrangement, so b a c matches as B A C
query II
SELECT i, __pattern_window.classifier FROM perm MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x ALL ROWS PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (PERMUTE(A, B, C)) DEFINE A AS c='a', B AS c='b', C AS c='c'
) ORDER BY i
----
1	B
2	A
3	C

# where more than one arrangement fits, the one listed first wins
query II
SELECT i, __pattern_window.classifier FROM perm MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x ALL ROWS PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (PERMUTE(A, B)) DEFINE A AS true, B AS true
) ORDER BY i
----
1	A
2	B
3	A
4	B

query II
SELECT i, __pattern_window.classifier FROM perm MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x ALL ROWS PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (PERMUTE(B, A)) DEFINE A AS true, B AS true
) ORDER BY i
----
1	B
2	A
3	B
4	A

# a part may be a pattern rather than a bare variable, and the whole may be quantified
query II
SELECT count(*), max(len) FROM perm MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (PERMUTE(A B, C)) DEFINE A AS c='a', B AS c='b', C AS c='c'
)
----
1	3

query II
SELECT count(*), max(len) FROM perm MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (PERMUTE(A, B)+) DEFINE A AS c='a', B AS c='b'
)
----
2	2

# PERMUTE is not a reserved word, so it remains available as a pattern variable
query I
SELECT count(*) FROM perm MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS n PATTERN (PERMUTE) DEFINE PERMUTE AS c='a'
)
----
2

# ^ and $ hold at the ends of the partition and take no row of their own, so they say where a match
# may begin and end rather than what it matches.

statement ok
create table anch(p integer, i integer, c varchar);

statement ok
insert into anch values (1,1,'a'),(1,2,'a'),(1,3,'a'),(2,4,'a'),(2,5,'a');

query II
SELECT count(*), max(len) FROM anch MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (^ A+) DEFINE A AS c='a'
)
----
1	5

query II
SELECT count(*), max(len) FROM anch MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A+ $) DEFINE A AS c='a'
)
----
1	5

# a fixed length that cannot reach both ends at once has nowhere to sit
query II
SELECT count(*), max(len) FROM anch MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (^ A{2} $) DEFINE A AS c='a'
)
----
0	NULL

# the ends are the partition's, not the input's
query II
SELECT p, len FROM anch MATCH_RECOGNIZE(
    PARTITION BY p ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (^ A+ $) DEFINE A AS c='a'
) ORDER BY p
----
1	3
2	2

query II
SELECT p, len FROM anch MATCH_RECOGNIZE(
    PARTITION BY p ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (^ A{2}) DEFINE A AS c='a'
) ORDER BY p
----
1	2
2	2

# a match begins at a row, and there is no row past the last one to begin at, so an anchor alone at
# the end has nowhere to happen
query II
SELECT count(*), max(len) FROM anch MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN ($) DEFINE A AS c='a'
)
----
0	NULL

# PERMUTE stands for the alternation of every order of its parts, taken in the order the list is
# written. That is not how it happens to be built here, it is what it means, so the two spellings
# have to answer the same question - including which arrangement wins where more than one fits.
#
# Over the four rows below, A holds on 2,3,4 and B on 1,2,4, and of the six arrangements only the
# third and fourth can start at row 1. The third is the one the list order asks for, and it is the
# only one where the reluctant C?? has to give up what it prefers: matching nothing would put A on
# row 2 and the trailing B on row 3, which is not a B, so taking the C shifts the rest along and it
# fits. Oracle answers the fourth for the PERMUTE and the third for the same six written out, which
# are different rows from the same engine for what is meant to be the same pattern.

statement ok
create table perm3(i integer, v integer);

statement ok
insert into perm3 values (1,0),(2,1),(3,2),(4,1);

query IT
SELECT i, cls FROM perm3 MATCH_RECOGNIZE(
    ORDER BY i MEASURES CLASSIFIER() AS cls
    ALL ROWS PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (PERMUTE(A, B C??, B))
    DEFINE A AS A.v > 0, B AS B.v < 2, C AS 1 = 1
) ORDER BY i
----
1	B
2	C
3	A
4	B

query IT
SELECT i, cls FROM perm3 MATCH_RECOGNIZE(
    ORDER BY i MEASURES CLASSIFIER() AS cls
    ALL ROWS PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (  (A) (B C??) (B)
             | (A) (B) (B C??)
             | (B C??) (A) (B)
             | (B C??) (B) (A)
             | (B) (A) (B C??)
             | (B) (B C??) (A) )
    DEFINE A AS A.v > 0, B AS B.v < 2, C AS 1 = 1
) ORDER BY i
----
1	B
2	C
3	A
4	B

# the same pattern with a greedy quantifier, where nothing has to be given up. Oracle agrees here,
# which is what says the reluctance is the part it does not carry through an arrangement.
query IT
SELECT i, cls FROM perm3 MATCH_RECOGNIZE(
    ORDER BY i MEASURES CLASSIFIER() AS cls
    ALL ROWS PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (PERMUTE(A, B C?, B))
    DEFINE A AS A.v > 0, B AS B.v < 2, C AS 1 = 1
) ORDER BY i
----
1	B
2	C
3	A
4	B
