# name: test/sql/match_recognize/test_match_recognize_backtracking.test
# description: MATCH_RECOGNIZE pattern algebra - quantifiers, alternation preference and backtracking
# group: [match_recognize]

# A PATTERN is a regular expression over pattern variables, so the shapes that pin down a regex
# engine pin this down too: nested quantifiers, a quantifier that can match nothing, which branch of
# an alternation wins, and how much a greedy quantifier has to give back for the rest to fit. Each
# case below is a string of single letter rows, one row per character, with a variable per letter.

statement ok
pragma threads=1;

statement ok
create table rows_aaaaa(i integer, c varchar);

statement ok
insert into rows_aaaaa values (0,'a'),(1,'a'),(2,'a'),(3,'a'),(4,'a');

statement ok
create table rows_aaab(i integer, c varchar);

statement ok
insert into rows_aaab values (0,'a'),(1,'a'),(2,'a'),(3,'b');

statement ok
create table rows_abcd(i integer, c varchar);

statement ok
insert into rows_abcd values (0,'a'),(1,'b'),(2,'c'),(3,'d');

statement ok
create table rows_aaa(i integer, c varchar);

statement ok
insert into rows_aaa values (0,'a'),(1,'a'),(2,'a');

statement ok
create table rows_aaaa(i integer, c varchar);

statement ok
insert into rows_aaaa values (0,'a'),(1,'a'),(2,'a'),(3,'a');

statement ok
create table rows_b(i integer, c varchar);

statement ok
insert into rows_b values (0,'b');

statement ok
create table rows_aab(i integer, c varchar);

statement ok
insert into rows_aab values (0,'a'),(1,'a'),(2,'b');

statement ok
create table rows_abab(i integer, c varchar);

statement ok
insert into rows_abab values (0,'a'),(1,'b'),(2,'a'),(3,'b');

statement ok
create table rows_ab(i integer, c varchar);

statement ok
insert into rows_ab values (0,'a'),(1,'b');

statement ok
create table rows_aa(i integer, c varchar);

statement ok
insert into rows_aa values (0,'a'),(1,'a');

statement ok
create table rows_a(i integer, c varchar);

statement ok
insert into rows_a values (0,'a');

statement ok
create table rows_abac(i integer, c varchar);

statement ok
insert into rows_abac values (0,'a'),(1,'b'),(2,'a'),(3,'c');

# a star inside a star: the inner one can match nothing, which must not loop
query III
SELECT count(*), min(len), max(len) FROM rows_aaaaa MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN ((A*)*)
    DEFINE A AS A.c = 'a', B AS B.c = 'b', C AS C.c = 'c', D AS D.c = 'd'
)
----
1	5	5

query III
SELECT count(*), min(len), max(len) FROM rows_aaaaa MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN ((A+)+)
    DEFINE A AS A.c = 'a', B AS B.c = 'b', C AS C.c = 'c', D AS D.c = 'd'
)
----
1	5	5

# the left alternative is preferred, so this is five single repetitions
query III
SELECT count(*), min(len), max(len) FROM rows_aaaaa MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN ((A|A A)+)
    DEFINE A AS A.c = 'a', B AS B.c = 'b', C AS C.c = 'c', D AS D.c = 'd'
)
----
1	5	5

query III
SELECT count(*), min(len), max(len) FROM rows_aaaaa MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A{2,4})
    DEFINE A AS A.c = 'a', B AS B.c = 'b', C AS C.c = 'c', D AS D.c = 'd'
)
----
1	4	4

query III
SELECT count(*), min(len), max(len) FROM rows_aaab MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A{0,3} B)
    DEFINE A AS A.c = 'a', B AS B.c = 'b', C AS C.c = 'c', D AS D.c = 'd'
)
----
1	4	4

# preference is per alternation, not longest overall: A wins, then B C D has to
query III
SELECT count(*), min(len), max(len) FROM rows_abcd MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN ((A|A B)(C|B C D))
    DEFINE A AS A.c = 'a', B AS B.c = 'b', C AS C.c = 'c', D AS D.c = 'd'
)
----
1	4	4

# n optional repetitions followed by n mandatory ones - the shape that makes a
# backtracking engine try every split
query III
SELECT count(*), min(len), max(len) FROM rows_aaa MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN ((A{0,1}){3} A{3})
    DEFINE A AS A.c = 'a', B AS B.c = 'b', C AS C.c = 'c', D AS D.c = 'd'
)
----
1	3	3

query III
SELECT count(*), min(len), max(len) FROM rows_aaaa MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN ((A{0,1}){4} A{4})
    DEFINE A AS A.c = 'a', B AS B.c = 'b', C AS C.c = 'c', D AS D.c = 'd'
)
----
1	4	4

query III
SELECT count(*), min(len), max(len) FROM rows_b MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A* B)
    DEFINE A AS A.c = 'a', B AS B.c = 'b', C AS C.c = 'c', D AS D.c = 'd'
)
----
1	1	1

# three stars over the same rows: only the first can take any
query III
SELECT count(*), min(len), max(len) FROM rows_aaa MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A* A* A*)
    DEFINE A AS A.c = 'a', B AS B.c = 'b', C AS C.c = 'c', D AS D.c = 'd'
)
----
1	3	3

query III
SELECT count(*), min(len), max(len) FROM rows_aaaaa MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN ((A|A){5})
    DEFINE A AS A.c = 'a', B AS B.c = 'b', C AS C.c = 'c', D AS D.c = 'd'
)
----
1	5	5

query III
SELECT count(*), min(len), max(len) FROM rows_aab MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN ((A|A B) B{0,1})
    DEFINE A AS A.c = 'a', B AS B.c = 'b', C AS C.c = 'c', D AS D.c = 'd'
)
----
2	1	2

query III
SELECT count(*), min(len), max(len) FROM rows_abab MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN ((A B){2})
    DEFINE A AS A.c = 'a', B AS B.c = 'b', C AS C.c = 'c', D AS D.c = 'd'
)
----
1	4	4

query III
SELECT count(*), min(len), max(len) FROM rows_abab MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN ((A B)+)
    DEFINE A AS A.c = 'a', B AS B.c = 'b', C AS C.c = 'c', D AS D.c = 'd'
)
----
1	4	4

query III
SELECT count(*), min(len), max(len) FROM rows_aab MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A{1,2} A{1,2} B)
    DEFINE A AS A.c = 'a', B AS B.c = 'b', C AS C.c = 'c', D AS D.c = 'd'
)
----
1	3	3

query III
SELECT count(*), min(len), max(len) FROM rows_ab MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN ((A{0,1} B)|(A B))
    DEFINE A AS A.c = 'a', B AS B.c = 'b', C AS C.c = 'c', D AS D.c = 'd'
)
----
1	2	2

query III
SELECT count(*), min(len), max(len) FROM rows_aaab MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN ((A+)+ B)
    DEFINE A AS A.c = 'a', B AS B.c = 'b', C AS C.c = 'c', D AS D.c = 'd'
)
----
1	4	4

# the same pattern with nothing to end on: every way of splitting the run fails
query III
SELECT count(*), min(len), max(len) FROM rows_aaaa MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN ((A+)+ B)
    DEFINE A AS A.c = 'a', B AS B.c = 'b', C AS C.c = 'c', D AS D.c = 'd'
)
----
0	NULL	NULL

query III
SELECT count(*), min(len), max(len) FROM rows_ab MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN ((A|A B))
    DEFINE A AS A.c = 'a', B AS B.c = 'b', C AS C.c = 'c', D AS D.c = 'd'
)
----
1	1	1

query III
SELECT count(*), min(len), max(len) FROM rows_aa MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A{0,1} A{0,1} A{0,1})
    DEFINE A AS A.c = 'a', B AS B.c = 'b', C AS C.c = 'c', D AS D.c = 'd'
)
----
1	2	2

query III
SELECT count(*), min(len), max(len) FROM rows_abab MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN ((A|B)+)
    DEFINE A AS A.c = 'a', B AS B.c = 'b', C AS C.c = 'c', D AS D.c = 'd'
)
----
1	4	4

# a quantifier that can only match nothing still matches - as an empty match at every row, covering
# no rows at all, so the aggregate over the match sees nothing
query III
SELECT count(*), min(len), max(len) FROM rows_aaa MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A{0,0})
    DEFINE A AS A.c = 'a', B AS B.c = 'b', C AS C.c = 'c', D AS D.c = 'd'
)
----
3	0	0

query III
SELECT count(*), min(len), max(len) FROM rows_a MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (((A)))
    DEFINE A AS A.c = 'a', B AS B.c = 'b', C AS C.c = 'c', D AS D.c = 'd'
)
----
1	1	1

query III
SELECT count(*), min(len), max(len) FROM rows_abac MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN ((A B|A C)+)
    DEFINE A AS A.c = 'a', B AS B.c = 'b', C AS C.c = 'c', D AS D.c = 'd'
)
----
1	4	4

query III
SELECT count(*), min(len), max(len) FROM rows_aab MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A+ A B)
    DEFINE A AS A.c = 'a', B AS B.c = 'b', C AS C.c = 'c', D AS D.c = 'd'
)
----
1	3	3

query III
SELECT count(*), min(len), max(len) FROM rows_aaab MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A{2,} B)
    DEFINE A AS A.c = 'a', B AS B.c = 'b', C AS C.c = 'c', D AS D.c = 'd'
)
----
1	4	4

# the optional B has to give its row to the mandatory one
query III
SELECT count(*), min(len), max(len) FROM rows_ab MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A B{0,1} B)
    DEFINE A AS A.c = 'a', B AS B.c = 'b', C AS C.c = 'c', D AS D.c = 'd'
)
----
1	2	2

# An empty match covers no rows. It is still a match: it is numbered, it is reported once per row it
# happens at, and every measure over it sees nothing - count is zero and CLASSIFIER() is NULL,
# because no row was ever assigned to a variable.
query III
SELECT match_no, len, var_name FROM rows_aaa MATCH_RECOGNIZE(
    ORDER BY i MEASURES MATCH_NUMBER() AS match_no, count(*) AS len, CLASSIFIER() AS var_name
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (B*)
    DEFINE B AS B.c = 'b'
) ORDER BY match_no
----
1	0	NULL
2	0	NULL
3	0	NULL

# where the pattern can match rows it does, and only the rows it cannot reach are empty matches
query III
SELECT match_no, len, var_name FROM rows_aab MATCH_RECOGNIZE(
    ORDER BY i MEASURES MATCH_NUMBER() AS match_no, count(*) AS len, CLASSIFIER() AS var_name
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (B*)
    DEFINE B AS B.c = 'b'
) ORDER BY match_no
----
1	0	NULL
2	0	NULL
3	1	B

# an empty match does not stop the scan: it steps to the next row rather than skipping
query I
SELECT count(*) FROM rows_aaaaa MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (B{0,3})
    DEFINE B AS B.c = 'b'
)
----
5

# The cases above are a handful of rows each, so an engine that tries every split still answers them.
# These are the same shapes at a length where that is not an option: ((A+)+ B) over a thousand rows
# splits into 2^999 candidates, and the run below never matches, so an engine that explores them would
# have to explore all of them. If one of these ever stops returning, it has not become slow - it has
# stopped being polynomial, and the test will hang rather than fail.

statement ok
CREATE TABLE long_a AS SELECT i::INTEGER AS i, 'a' AS c FROM range(1000) t(i);

statement ok
CREATE TABLE long_ab AS SELECT i::INTEGER AS i, CASE WHEN i = 999 THEN 'b' ELSE 'a' END AS c FROM range(1000) t(i);

# nothing to end on, so every way of splitting the run fails
query II
SELECT count(*), max(len) FROM long_a MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN ((A+)+ B)
    DEFINE A AS A.c = 'a', B AS B.c = 'b'
)
----
0	NULL

query II
SELECT count(*), max(len) FROM long_a MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A+ A+ A+ B)
    DEFINE A AS A.c = 'a', B AS B.c = 'b'
)
----
0	NULL

query II
SELECT count(*), max(len) FROM long_a MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A* A* A* A* B)
    DEFINE A AS A.c = 'a', B AS B.c = 'b'
)
----
0	NULL

# the same shapes with the B at the very end, so the search succeeds only after the whole run
query II
SELECT count(*), max(len) FROM long_ab MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN ((A+)+ B)
    DEFINE A AS A.c = 'a', B AS B.c = 'b'
)
----
1	1000

query II
SELECT count(*), max(len) FROM long_ab MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A+ A+ A+ B)
    DEFINE A AS A.c = 'a', B AS B.c = 'b'
)
----
1	1000

# a greedy run that has to give back a row a thousand rows after it took it
query II
SELECT count(*), max(len) FROM long_ab MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A+ B)
    DEFINE A AS A.c = 'a', B AS B.c = 'b'
)
----
1	1000

# a star inside a star over a long run: the inner one can still match nothing at every step
query II
SELECT count(*), max(len) FROM long_a MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN ((A*)*)
    DEFINE A AS A.c = 'a'
)
----
1	1000

# n optional repetitions followed by n mandatory ones, at n = 50 rather than n = 4
statement ok
CREATE TABLE fifty_a AS SELECT i::INTEGER AS i, 'a' AS c FROM range(50) t(i);

query II
SELECT count(*), max(len) FROM fifty_a MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS len
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN ((A{0,1}){50} A{50})
    DEFINE A AS A.c = 'a'
)
----
1	50
