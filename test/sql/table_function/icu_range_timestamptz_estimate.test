# name: test/sql/table_function/icu_range_timestamptz_estimate.test
# description: The row count of a TIMESTAMPTZ range is an estimate, not a maximum
# group: [table_function]

require icu

statement ok
SET Calendar = 'gregorian';

# in New York, March 2024 has a day of 23 hours
statement ok
SET TimeZone = 'America/New_York';

query I
SELECT count(*) FROM (SELECT * FROM generate_series(TIMESTAMPTZ '2024-03-01', TIMESTAMPTZ '2024-03-31', INTERVAL 1 DAY) LIMIT 30)
----
30

query I
SELECT s FROM (SELECT sum(1::BIGINT) AS s FROM generate_series(TIMESTAMPTZ '2024-03-01', TIMESTAMPTZ '2024-03-31', INTERVAL 1 DAY)) WHERE s = 31
----
31

query I
SELECT count(*) FROM (SELECT * FROM range(TIMESTAMPTZ '2023-02-01', TIMESTAMPTZ '2023-03-02', INTERVAL 1 MONTH) LIMIT 1)
----
1

statement ok
SET TimeZone = 'UTC';

# the estimate leaves out the end that generate_series includes
query I
SELECT s FROM (SELECT sum(1::BIGINT) AS s FROM generate_series(TIMESTAMPTZ '2024-03-01 12:00:00', TIMESTAMPTZ '2024-03-08 12:00:00', INTERVAL 1 DAY)) WHERE s >= 8
----
8

# a sum must not use a kernel that assumes no overflow
statement ok
CREATE TABLE big AS SELECT 1700000000000000000::BIGINT AS v;

query II
SELECT sum(v), count(*) FROM big, generate_series(TIMESTAMPTZ '2024-01-01', TIMESTAMPTZ '2024-01-06', INTERVAL 1 DAY)
----
10200000000000000000	6
