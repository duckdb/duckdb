# name: test/sql/table_function/glob_extended.test
# description: glob_extended returns the options to open every file with
# group: [table_function]

statement ok
COPY (SELECT i FROM range(3) t(i)) TO '__TEST_DIR__/glob_extended_a.csv';

statement ok
COPY (SELECT i FROM range(3) t(i)) TO '__TEST_DIR__/glob_extended_b.csv';

query IIII
SELECT parse_filename(file), options['type']::VARCHAR, options['file_size']::BIGINT > 0, options['last_modified'] IS NOT NULL
FROM glob_extended('__TEST_DIR__/glob_extended_*.csv')
----
glob_extended_a.csv	file	true	true
glob_extended_b.csv	file	true	true

# the files are the same as those glob returns
query I
SELECT count(*) FROM (SELECT file FROM glob('__TEST_DIR__/glob_extended_*.csv') EXCEPT SELECT file FROM glob_extended('__TEST_DIR__/glob_extended_*.csv'))
----
0

query I
SELECT count(*) FROM glob_extended(['__TEST_DIR__/glob_extended_a.csv', '__TEST_DIR__/nothing_*.csv'])
----
1

statement error
SELECT count(*) FROM glob_extended('__TEST_DIR__/nothing_*.csv', allow_empty := false)
----
No files found that match the pattern

# a path that matches nothing is globbed as a directory of files with the fallback extension
statement ok
COPY (SELECT i, i AS j FROM range(1) t(i)) TO '__TEST_DIR__/glob_extended_dir' (FORMAT csv, PARTITION_BY i);

query I
SELECT count(*) FROM glob_extended('__TEST_DIR__/glob_extended_dir', fallback_extension := 'csv')
----
1

query I
SELECT count(*) FROM glob_extended('__TEST_DIR__/glob_extended_dir')
----
0

# files given with options to open them with are returned as-is, together with those options
query II
SELECT file, options FROM glob_extended([{'filename': 'not_a_file_*.csv', 'file_size': 10}])
----
not_a_file_*.csv	{file_size=10}

query II
SELECT file, options FROM glob_extended([{'filename': 'not_a_file_*.csv'}::VARIANT, '__TEST_DIR__/nothing_*.csv'::VARIANT])
----
not_a_file_*.csv	{}

# the readers list their files through glob_extended
query II
SELECT count(*), sum(i) FROM read_csv('__TEST_DIR__/glob_extended_*.csv')
----
6	6

statement error
SELECT * FROM read_csv('__TEST_DIR__/nothing_*.csv')
----
No files found that match the pattern
