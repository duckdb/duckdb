# name: test/sql/table_function/warn_deprecated_identifier_conversion.test
# description: Test deprecated implicit identifier-to-string conversion setting in table functions
# group: [table_function]

# Default behavior still converts the identifier to a string.
query I
SELECT count(*) FROM glob(no_such_file.csv);
----
0

# Explicit string literals should continue to work.
query I
SELECT count(*) FROM glob('no_such_file.csv');
----
0

# Explicitly enabling the deprecated behavior should not warn.
statement ok
SET table_function_identifier_conversion='ENABLE_IMPLICIT_STRING';

query I
SELECT count(*) FROM glob(no_such_file.csv);
----
0

# Disabling the deprecated behavior rejects implicit conversion.
statement ok
SET table_function_identifier_conversion='DISABLE_IMPLICIT_STRING';

statement error
SELECT count(*) FROM glob(no_such_file.csv);
----
Deprecated implicit conversion of unbound identifiers to strings in table function arguments detected

statement ok
RESET table_function_identifier_conversion;

# A COPY option that takes a list of column names binds each identifier as the name it spells, not as
# a column reference the conversion would have to turn into a string: no warning, and no error with
# the conversion disabled.
require parquet

statement ok
SET table_function_identifier_conversion='DISABLE_IMPLICIT_STRING';

statement ok
COPY (SELECT 1 AS a, 0 AS p, 2 AS q) TO '__TEST_DIR__/partitioned_one' (FORMAT PARQUET, PARTITION_BY p);

statement ok
COPY (SELECT 1 AS a, 0 AS p, 2 AS q) TO '__TEST_DIR__/partitioned_two' (FORMAT PARQUET, PARTITION_BY (p, q));

query III
SELECT a, p, q FROM read_parquet('__TEST_DIR__/partitioned_two/**/*.parquet');
----
1	0	2

# A name that is also a SQL value function is still a column name here.
statement ok
COPY (SELECT 1 AS a, 'x' AS p, 'y' AS "user") TO '__TEST_DIR__/force_quote.csv' (FORCE_QUOTE (p, "user"));

query I
SELECT replace(content, chr(10), '|') FROM read_text('__TEST_DIR__/force_quote.csv');
----
a,"p","user"|1,"x","y"|

statement ok
RESET table_function_identifier_conversion;
