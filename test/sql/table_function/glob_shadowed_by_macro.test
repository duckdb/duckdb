# name: test/sql/table_function/glob_shadowed_by_macro.test
# description: A user table macro named glob does not change how readers expand their globs
# group: [table_function]

statement ok
COPY (SELECT 42 AS i) TO '{TEST_DIR}/glob_shadowed_a.csv'

statement ok
COPY (SELECT 43 AS i) TO '{TEST_DIR}/glob_shadowed_b.csv'

statement ok
CREATE MACRO "glob"(pattern) AS TABLE SELECT pattern AS file;

query I
SELECT count(*) FROM read_text('{TEST_DIR}/glob_shadowed_a.csv')
----
1

query I
SELECT sum(i) FROM read_csv('{TEST_DIR}/glob_shadowed_*.csv')
----
85

# the macro itself still resolves for direct calls
query I
SELECT file FROM glob('not a pattern')
----
not a pattern
