# name: test/sql/sql_export/mark_results.test
# description: SQL export preserves scalar MARK results and rejects unsupported conjunction semantics
# group: [sql_export]

statement ok
SET debug_verify_sql_export='strict';

statement ok
SET threads=1;

statement ok
SET max_execution_time=5000;

query I rowsort
SELECT 1 = ANY(SELECT 1);
----
1

query I rowsort
SELECT 1 = ANY(SELECT 2);
----
0

query I rowsort
SELECT 'ABC' COLLATE nocase IN (SELECT 'aBc');
----
1

query I rowsort
SELECT NULL::INTERVAL IN (SELECT INTERVAL 1 DAY);
----
NULL

query I rowsort
SELECT 1 = ANY(SELECT 1 WHERE false);
----
0

query I rowsort
SELECT 1 = ANY(SELECT NULL::INTEGER);
----
NULL

query I rowsort
SELECT 1 NOT IN (VALUES (2),(NULL));
----
NULL

query I rowsort
SELECT 1 WHERE (1,2) IN (SELECT 1,2);
----
1

query I rowsort
SELECT 1 WHERE (1,2) IN (VALUES (1,2),(1,2),(NULL,2));
----
1

query I rowsort
SELECT __mark_join_marker FROM (VALUES (NULL::INTEGER)) l(a) JOIN BY (TYPE MARK) (VALUES (2)) r(b) ON a IS DISTINCT FROM 2;
----
1

query I rowsort
SELECT __mark_join_marker FROM (VALUES (NULL::INTEGER)) l(a) JOIN BY (TYPE MARK) (VALUES (2)) r(b) ON a IS DISTINCT FROM NULL::INTEGER;
----
0

statement ok
SET debug_verify_sql_export='off';

query I rowsort
SELECT __mark_join_marker FROM (VALUES (1)) l(a) JOIN BY (TYPE MARK) (VALUES (2)) r(b) ON a<2 AND a>2;
----
0

statement ok
SET debug_verify_sql_export='strict';

statement error
EXPLAIN (SQL) SELECT __mark_join_marker FROM (VALUES (1)) l(a) JOIN BY (TYPE MARK) (VALUES (2)) r(b) ON a<2 AND a>2;
----
<REGEX>:.*UNSUPPORTED_EXPORT_FEATURE.*The MARK condition requires conjunction execution semantics.*

