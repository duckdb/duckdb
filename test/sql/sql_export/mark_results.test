CREATE TABLE mark_probe(id INTEGER,label VARCHAR,a INTEGER,c INTEGER);

statement ok
INSERT INTO mark_probe VALUES (0,'null',NULL,NULL),(1,'one',1,NULL),(2,'two',2,2);

statement ok
CREATE TABLE mark_build(b INTEGER,d INTEGER);

statement ok
INSERT INTO mark_build VALUES (1,NULL);

statement ok
SET debug_verify_sql_export='off';

query TTII rowsort
SELECT label,label,id,__mark_join_marker FROM mark_probe JOIN BY (TYPE MARK) mark_build ON a=b AND c+d>0;
----
null	null	0	NULL
one	one	1	NULL
two	two	2	0

statement ok
SET debug_verify_sql_export='strict';

statement error
EXPLAIN (SQL) SELECT label,label,id,__mark_join_marker FROM mark_probe JOIN BY (TYPE MARK) mark_build ON a=b AND c+d>0;
----
<REGEX>:.*UNSUPPORTED_EXPORT_FEATURE.*The MARK condition requires conjunction execution semantics.*

