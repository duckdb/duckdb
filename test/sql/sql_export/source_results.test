# name: test/sql/sql_export/source_results.test
# description: SQL export preserves range invocations, system rows and scan projections
# group: [sql_export]

statement ok
SET debug_verify_sql_export='strict';

query I
SELECT * FROM range(4);
----
0
1
2
3

query I
SELECT count(*) FROM range(4);
----
4

query I
SELECT * FROM range(5,0,-2);
----
5
3
1

query I
SELECT * FROM generate_series(5,1,-2);
----
5
3
1

query I
SELECT * FROM range(NULL::BIGINT);
----

query I
SELECT * FROM range(4,0);
----

query II
SELECT x,x FROM range(5) t(x) WHERE x>=2 ORDER BY x DESC;
----
4	4
3	3
2	2

query T
SELECT * FROM range(TIMESTAMP '2020-01-01',TIMESTAMP '2020-01-03',INTERVAL '1 day');
----
2020-01-01 00:00:00
2020-01-02 00:00:00

query T
SELECT * FROM generate_series(TIMESTAMP '2020-01-01',TIMESTAMP '2020-01-03',INTERVAL '1 day');
----
2020-01-01 00:00:00
2020-01-02 00:00:00
2020-01-03 00:00:00

