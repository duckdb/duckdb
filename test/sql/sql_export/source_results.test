statement ok
CREATE TABLE scan_rows(i INTEGER, j INTEGER, "text value" VARCHAR, n DECIMAL(12,3), xs INTEGER[]);

statement ok
INSERT INTO scan_rows VALUES (1,3,'first',1.125,[1,NULL]),(2,2,NULL,NULL,[]),(2,2,'duplicate',2.250,[2]),(2,2,'duplicate',2.250,[2]),(NULL,4,'null',4.500,NULL);

query IITRT rowsort
SELECT * FROM scan_rows;
----
1	3	first	1.125	[1, NULL]
2	2	NULL	NULL	[]
2	2	duplicate	2.250	[2]
2	2	duplicate	2.250	[2]
NULL	4	null	4.500	NULL

query TIT rowsort
SELECT "text value",i,"text value" FROM scan_rows WHERE i>=2;
----
NULL	2	NULL
duplicate	2	duplicate
duplicate	2	duplicate

query RT rowsort
SELECT n,xs FROM scan_rows WHERE i IS NULL OR i=1;
----
1.125	[1, NULL]
4.500	NULL

query II rowsort
SELECT rowid,i FROM scan_rows WHERE j=2;
----
1	2
2	2
3	2

query T rowsort
SELECT "text value" FROM scan_rows WHERE j=2;
----
NULL
duplicate
duplicate

query R rowsort
SELECT n FROM scan_rows WHERE i<j;
----
1.125

query I rowsort
SELECT count(*) FROM scan_rows WHERE j=2;
----
3

query ITI rowsort
SELECT a,e,b FROM scan_rows AS q(a,b,c,d,e) WHERE b=2;
----
2	[2]	2
2	[2]	2
2	[]	2

query I rowsort
SELECT i FROM scan_rows WHERE i+j=4;
----
1
2
2
2

query R rowsort
SELECT n FROM scan_rows WHERE j=2;
----
2.250
2.250
NULL
