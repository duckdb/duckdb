# name: test/sql/sql_export/statement_verification.test
# description: Verify exported SQL through the statement verifier and execute it once
# group: [sql_export]

statement ok
SET debug_verify_statement='explain_sql_strict';

query I
SELECT sum(i) FROM (VALUES (1),(2),(2),(4)) t(i) WHERE i>1;
----
8

statement ok
CREATE SEQUENCE statement_export_calls;

query II
SELECT x,x FROM (SELECT nextval('statement_export_calls') x) q;
----
1	1

query I
SELECT nextval('statement_export_calls');
----
2

statement error
SELECT error('exported execution failure');
----
exported execution failure

query I
SELECT 42;
----
42

statement ok
PREPARE statement_export_parameter AS SELECT $1::INTEGER + 1;

query I
EXECUTE statement_export_parameter(4);
----
5

statement ok
RESET debug_verify_statement;

statement ok
CREATE TABLE export_transaction(i INTEGER);

statement ok
SET debug_verify_statement='explain_sql';

statement ok
BEGIN;

query I
WITH ins AS (INSERT INTO export_transaction VALUES (1)) SELECT 42;
----
42

query I
SELECT count(*) FROM export_transaction;
----
1

statement ok
ROLLBACK;

query I
SELECT count(*) FROM export_transaction;
----
0

foreach verification explain_sql explain_sql_strict

statement ok
SET debug_verify_statement='{verification}';

statement ok
BEGIN;

statement error
SELECT error('exported runtime failure');
----
exported runtime failure

statement error
SELECT 42;
----
Current transaction is aborted

statement ok
ROLLBACK;

endloop

statement ok
RESET debug_verify_statement;
