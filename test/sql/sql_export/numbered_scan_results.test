# name: test/sql/sql_export/numbered_scan_results.test
# description: SQL export preserves visible row numbers and offsets after deletes and checkpoints
# group: [sql_export]

statement ok
SET debug_verify_sql_export='strict';

statement ok
SET max_execution_time=5000;

foreach threads 1 4

statement ok
SET threads={threads};

statement ok
DROP TABLE IF EXISTS numbered_scan;

statement ok
CREATE TABLE numbered_scan AS SELECT i, (i%7)::INTEGER v, {'x':i,'y':i::VARCHAR} s FROM range(300000)t(i);

statement ok
DELETE FROM numbered_scan WHERE i%5=1;

statement ok
CHECKPOINT;

statement ok
BEGIN;

statement ok
INSERT INTO numbered_scan SELECT i,(i%7)::INTEGER,{'x':i,'y':i::VARCHAR} FROM range(300000,300017)t(i);

foreach optimizer '' 'window_rewriter'

statement ok
SET disabled_optimizers={optimizer};

foreach mode off strict

statement ok
SET debug_verify_sql_export='{mode}';

query III nosort numbered_result
SELECT * FROM (SELECT i,v,row_number() OVER () n FROM numbered_scan) WHERE i<10 ORDER BY i;

endloop

reset label numbered_result

query TT
EXPLAIN (SQL) SELECT * FROM (SELECT i,v,row_number() OVER () n FROM numbered_scan) WHERE i<10 ORDER BY i;
----
sql	<REGEX>:.*"?system"?[.]main[.]row_number[(][)] OVER [(][)].*

endloop

foreach optimizer '' 'window_rewriter'

statement ok
SET disabled_optimizers={optimizer};

foreach mode off strict

statement ok
SET debug_verify_sql_export='{mode}';

query III nosort numbered_result
SELECT * FROM (SELECT i,v,row_number() OVER () n FROM numbered_scan) WHERE i>=299990 ORDER BY i;

endloop

reset label numbered_result

query TT
EXPLAIN (SQL) SELECT * FROM (SELECT i,v,row_number() OVER () n FROM numbered_scan) WHERE i>=299990 ORDER BY i;
----
sql	<REGEX>:.*"?system"?[.]main[.]row_number[(][)] OVER [(][)].*

endloop

foreach optimizer '' 'window_rewriter'

statement ok
SET disabled_optimizers={optimizer};

foreach mode off strict

statement ok
SET debug_verify_sql_export='{mode}';

query III nosort numbered_result
SELECT * FROM (SELECT i,rowid,row_number() OVER () n FROM numbered_scan) WHERE i>=299990 ORDER BY i;

endloop

reset label numbered_result

query TT
EXPLAIN (SQL) SELECT * FROM (SELECT i,rowid,row_number() OVER () n FROM numbered_scan) WHERE i>=299990 ORDER BY i;
----
sql	<REGEX>:.*"?system"?[.]main[.]row_number[(][)] OVER [(][)].*

endloop

foreach optimizer '' 'window_rewriter'

statement ok
SET disabled_optimizers={optimizer};

foreach mode off strict

statement ok
SET debug_verify_sql_export='{mode}';

query II nosort numbered_result
SELECT * FROM (SELECT s.x,row_number() OVER () n FROM numbered_scan) LIMIT 4097;

endloop

reset label numbered_result

query TT
EXPLAIN (SQL) SELECT * FROM (SELECT s.x,row_number() OVER () n FROM numbered_scan) LIMIT 4097;
----
sql	<REGEX>:.*"?system"?[.]main[.]row_number[(][)] OVER [(][)].*

endloop

foreach optimizer '' 'window_rewriter'

statement ok
SET disabled_optimizers={optimizer};

foreach mode off strict

statement ok
SET debug_verify_sql_export='{mode}';

query I nosort numbered_result
SELECT row_number() OVER () n FROM numbered_scan LIMIT 1;

endloop

reset label numbered_result

query TT
EXPLAIN (SQL) SELECT row_number() OVER () n FROM numbered_scan LIMIT 1;
----
sql	<REGEX>:.*"?system"?[.]main[.]row_number[(][)] OVER [(][)].*

endloop

foreach optimizer '' 'window_rewriter'

statement ok
SET disabled_optimizers={optimizer};

foreach mode off strict

statement ok
SET debug_verify_sql_export='{mode}';

query III nosort numbered_result
SELECT i,n,n FROM (SELECT i,row_number() OVER () n FROM numbered_scan) LIMIT 3;

endloop

reset label numbered_result

query TT
EXPLAIN (SQL) SELECT i,n,n FROM (SELECT i,row_number() OVER () n FROM numbered_scan) LIMIT 3;
----
sql	<REGEX>:.*"?system"?[.]main[.]row_number[(][)] OVER [(][)].*

endloop

statement ok
SET disabled_optimizers='';

statement ok
ROLLBACK;

endloop

statement ok
CREATE TABLE offset_rows AS SELECT i::INTEGER AS i FROM range(245760) t(i);

statement ok
CHECKPOINT;

statement ok
INSERT INTO offset_rows VALUES (-1);

statement ok
SET disabled_optimizers='statistics_propagation';

foreach mode off strict

statement ok
SET debug_verify_sql_export='{mode}';

query I nosort numbered_25
SELECT i FROM offset_rows ORDER BY i LIMIT 1 OFFSET 1;

endloop

reset label numbered_25

foreach mode off strict

statement ok
SET debug_verify_sql_export='{mode}';

query I nosort numbered_26
SELECT i FROM offset_rows ORDER BY i LIMIT 1 OFFSET 122880;

endloop

reset label numbered_26

foreach mode off strict

statement ok
SET debug_verify_sql_export='{mode}';

query I nosort numbered_27
SELECT i FROM offset_rows ORDER BY i OFFSET 200000;

endloop

reset label numbered_27

statement ok
SET disabled_optimizers='';

statement ok
CREATE TABLE hinted_scan AS SELECT i,i%7 v FROM range(100)t(i);

foreach mode off strict

statement ok
SET debug_verify_sql_export='{mode}';

query II nosort numbered_28
SELECT i,v FROM hinted_scan WHERE i>50;

endloop

reset label numbered_28

statement ok
CREATE TABLE hint_groups AS SELECT i,CASE WHEN i<122880 THEN i+1 ELSE i-1 END v FROM range(300000)t(i);

foreach mode off strict

statement ok
SET debug_verify_sql_export='{mode}';

query II nosort numbered_29
SELECT i,v FROM hint_groups WHERE i>v LIMIT 5;

endloop

reset label numbered_29
