# name: test/sql/sql_export/mark_strategies.test
# description: MARK strategy results and SQL export restrictions retain three-valued semantics
# group: [sql_export]

statement ok
SET debug_verify_sql_export='strict';

statement ok
SET nested_loop_join_threshold=0;

statement ok
SET merge_join_threshold=0;

statement ok
SET prefer_range_joins=true;

query TT
EXPLAIN SELECT __mark_join_marker FROM (VALUES (1,3),(NULL::INTEGER,2)) l(a,c) JOIN BY (TYPE MARK) (VALUES (2,1),(NULL::INTEGER,2)) r(b,d) ON a=b ORDER BY a NULLS LAST;
----
physical_plan	<REGEX>:.*Hash Join.*

query I
SELECT __mark_join_marker FROM (VALUES (1,3),(NULL::INTEGER,2)) l(a,c) JOIN BY (TYPE MARK) (VALUES (2,1),(NULL::INTEGER,2)) r(b,d) ON a=b ORDER BY a NULLS LAST;
----
NULL
NULL

query TT
