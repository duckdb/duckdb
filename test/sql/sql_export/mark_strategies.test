----
physical_plan	<REGEX>:.*Hash Join.*

query I
SELECT __mark_join_marker FROM (VALUES (1,3),(NULL::INTEGER,2)) l(a,c) JOIN BY (TYPE MARK) (VALUES (2,1),(NULL::INTEGER,2)) r(b,d) ON a IS NOT DISTINCT FROM b AND c IS NOT DISTINCT FROM d ORDER BY a NULLS LAST;
----
false
true

statement error
EXPLAIN (SQL) SELECT __mark_join_marker FROM (VALUES (1,3),(NULL::INTEGER,2)) l(a,c) JOIN BY (TYPE MARK) (VALUES (2,1),(NULL::INTEGER,2)) r(b,d) ON a IS NOT DISTINCT FROM b AND c=d ORDER BY a NULLS LAST;
----
<REGEX>:.*EXPLAIN \(SQL\) cannot render this query: The MARK condition requires conjunction execution semantics.*

statement error
EXPLAIN (SQL) SELECT __mark_join_marker FROM (VALUES (1,3),(NULL::INTEGER,2)) l(a,c) JOIN BY (TYPE MARK) (VALUES (2,1),(NULL::INTEGER,2)) r(b,d) ON a IS NOT DISTINCT FROM b AND c<d ORDER BY a NULLS LAST;
----
<REGEX>:.*EXPLAIN \(SQL\) cannot render this query: The MARK condition requires conjunction execution semantics.*

