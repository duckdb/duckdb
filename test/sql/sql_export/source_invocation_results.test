# name: test/sql/sql_export/source_invocation_results.test
# description: Source invocation, common subplans and consumed file predicates
# group: [sql_export]

statement ok
SET debug_verify_sql_export='strict';

require parquet

foreach serializer false true

statement ok
SET debug_verify_serializer={serializer};

query I
SELECT a.s+b.s FROM (SELECT sum(x) s FROM range(10) t(x)) a, (SELECT sum(x) s FROM range(10) u(x)) b;
----
90

endloop

query TT
EXPLAIN SELECT a.s+b.s FROM (SELECT sum(x) s FROM range(10) t(x)) a, (SELECT sum(x) s FROM range(10) u(x)) b;
----
physical_plan	<REGEX>:.*CTE.*

foreach serializer false true

statement ok
SET debug_verify_serializer={serializer};

query I
SELECT a.s+b.s FROM (SELECT sum(x) s FROM range(10) t(x)) a, (SELECT sum(x) s FROM range(11) u(x)) b;
----
100

endloop

statement ok
CREATE TABLE csv_source(i INTEGER,s VARCHAR);

statement ok
INSERT INTO csv_source VALUES(1,'a'),(2,NULL);

statement ok
COPY csv_source TO '__TEST_DIR__/generic_source.csv' (HEADER,DELIMITER '|');

foreach mode off strict

statement ok
SET debug_verify_sql_export='{mode}';

query IT nosort source_0
SELECT * FROM read_csv('__TEST_DIR__/generic_source.csv', header := true, delim := '|', auto_detect := true) ORDER BY i;

endloop

reset label source_0

foreach mode off strict

statement ok
SET debug_verify_sql_export='{mode}';

query I nosort source_1
SELECT count(*) FROM read_csv('__TEST_DIR__/generic_source.csv', header := true, delim := '|', auto_detect := true);

endloop

reset label source_1

foreach mode off strict

statement ok
SET debug_verify_sql_export='{mode}';

query IT nosort source_2
SELECT i,filename FROM read_csv('__TEST_DIR__/generic_source.csv', header := true, delim := '|', auto_detect := true,filename := true) ORDER BY i;

endloop

reset label source_2

statement ok
COPY (SELECT * FROM (VALUES (10,1),(10,1),(NULL,1),(20,2),(30,NULL)) t(i,p)) TO '__TEST_DIR__/retained_predicates_CSV' (FORMAT CSV,PARTITION_BY(p),HEADER);

statement ok
SET debug_verify_serializer=false;

foreach mode off strict

statement ok
SET debug_verify_sql_export='{mode}';

query I nosort file_predicate_CSV0
SELECT i FROM read_csv('__TEST_DIR__/retained_predicates_CSV/*/*.csv',hive_partitioning := true) WHERE p=1 ORDER BY i;

query I nosort file_predicate_CSV1
SELECT i FROM read_csv('__TEST_DIR__/retained_predicates_CSV/*/*.csv',hive_partitioning := true) WHERE p IS NULL ORDER BY i;

query I nosort file_predicate_CSV2
SELECT i FROM read_csv('__TEST_DIR__/retained_predicates_CSV/*/*.csv',hive_partitioning := true) WHERE p IN (1,2) AND i>15 ORDER BY i;

query I nosort file_predicate_CSV3
SELECT i FROM read_csv('__TEST_DIR__/retained_predicates_CSV/*/*.csv',hive_partitioning := true) WHERE p>=1 OR p IS NULL ORDER BY i;

query I nosort file_predicate_CSV4
SELECT i FROM read_csv('__TEST_DIR__/retained_predicates_CSV/*/*.csv',hive_partitioning := true) WHERE array_to_string([p::VARCHAR, 'x'], '/') = '1/x' ORDER BY i;

endloop

reset label file_predicate_CSV0

reset label file_predicate_CSV1

reset label file_predicate_CSV2

reset label file_predicate_CSV3

reset label file_predicate_CSV4

statement ok
COPY (SELECT * FROM (VALUES (10,1),(10,1),(NULL,1),(20,2),(30,NULL)) t(i,p)) TO '__TEST_DIR__/retained_predicates_parquet' (FORMAT parquet,PARTITION_BY(p));

foreach serializer false true

statement ok
SET debug_verify_serializer={serializer};

foreach mode off strict

statement ok
SET debug_verify_sql_export='{mode}';

query I nosort file_predicate_parquet0
SELECT i FROM read_parquet('__TEST_DIR__/retained_predicates_parquet/*/*.parquet',hive_partitioning := true) WHERE p=1 ORDER BY i;

query I nosort file_predicate_parquet1
SELECT i FROM read_parquet('__TEST_DIR__/retained_predicates_parquet/*/*.parquet',hive_partitioning := true) WHERE p IS NULL ORDER BY i;

query I nosort file_predicate_parquet2
SELECT i FROM read_parquet('__TEST_DIR__/retained_predicates_parquet/*/*.parquet',hive_partitioning := true) WHERE p IN (1,2) AND i>15 ORDER BY i;

query I nosort file_predicate_parquet3
SELECT i FROM read_parquet('__TEST_DIR__/retained_predicates_parquet/*/*.parquet',hive_partitioning := true) WHERE p>=1 OR p IS NULL ORDER BY i;

query I nosort file_predicate_parquet4
SELECT i FROM read_parquet('__TEST_DIR__/retained_predicates_parquet/*/*.parquet',hive_partitioning := true) WHERE array_to_string([p::VARCHAR, 'x'], '/') = '1/x' ORDER BY i;

endloop

reset label file_predicate_parquet0

reset label file_predicate_parquet1

reset label file_predicate_parquet2

reset label file_predicate_parquet3

reset label file_predicate_parquet4

endloop
