----
<REGEX>:.*UNSUPPORTED_EXPORT_FEATURE.*The MARK condition requires conjunction execution semantics.*

query I
SELECT last_value FROM duckdb_sequences() WHERE sequence_name='seq';
----
NULL

statement ok
DROP SEQUENCE IF EXISTS seq;

statement ok
CREATE SEQUENCE seq;

statement ok
SET debug_verify_serializer=false;

statement error
EXPLAIN (SQL) SELECT i,CASE WHEN i>=4096 THEN CAST(error('grouped mark stream') AS BIGINT) ELSE nextval('seq') END,x=ANY(SELECT y FROM r WHERE r.g=l.g) m FROM l;
----
<REGEX>:.*UNSUPPORTED_EXPORT_FEATURE.*The MARK condition requires conjunction execution semantics.*

query I
SELECT last_value FROM duckdb_sequences() WHERE sequence_name='seq';
----
NULL

