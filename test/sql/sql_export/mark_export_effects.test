# name: test/sql/sql_export/mark_export_effects.test
# description: Rejected MARK export never evaluates volatile or throwing projections
# group: [sql_export]

statement ok
SET debug_verify_sql_export='strict';

statement ok
SET threads=1;

statement ok
SET max_execution_time=5000;

statement ok
SET max_streaming_buffer_size='1b';

statement ok
CREATE TABLE l AS SELECT i,(i%5)::DOUBLE g,CASE WHEN i%11=0 THEN NULL ELSE i%13 END x FROM range(8192)t(i);

statement ok
CREATE TABLE r AS SELECT (i%4)::DOUBLE g,CASE WHEN i%7=0 THEN NULL ELSE i%13 END y FROM range(64)t(i);

statement ok
DROP SEQUENCE IF EXISTS seq;

statement ok
CREATE SEQUENCE seq;

statement ok
SET debug_verify_serializer=false;

statement error
EXPLAIN (SQL) SELECT i,nextval('seq'),x=ANY(SELECT y FROM r WHERE r.g=l.g) m FROM l;
----
<REGEX>:.*UNSUPPORTED_EXPORT_FEATURE.*The MARK condition requires conjunction execution semantics.*

query I
SELECT last_value FROM duckdb_sequences() WHERE sequence_name='seq';
----
NULL

statement ok
DROP SEQUENCE IF EXISTS seq;

statement ok
CREATE SEQUENCE seq;

statement ok
SET debug_verify_serializer=true;

statement error
EXPLAIN (SQL) SELECT i,nextval('seq'),x=ANY(SELECT y FROM r WHERE r.g=l.g) m FROM l;
----
<REGEX>:.*UNSUPPORTED_EXPORT_FEATURE.*The MARK condition requires conjunction execution semantics.*

query I
SELECT last_value FROM duckdb_sequences() WHERE sequence_name='seq';
----
NULL

statement ok
DROP SEQUENCE IF EXISTS seq;

statement ok
CREATE SEQUENCE seq;

statement ok
SET debug_verify_serializer=false;

statement error
EXPLAIN (SQL) SELECT i,nextval('seq'),x=ANY(SELECT y FROM r WHERE r.g=l.g) m FROM l LIMIT 1;
----
<REGEX>:.*UNSUPPORTED_EXPORT_FEATURE.*The MARK condition requires conjunction execution semantics.*

query I
SELECT last_value FROM duckdb_sequences() WHERE sequence_name='seq';
----
NULL

