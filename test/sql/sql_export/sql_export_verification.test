# name: test/sql/sql_export/sql_export_verification.test
# description: Configure SQL export verification and preserve ordinary SQL results
# group: [sql_export]

statement ok
SET debug_verify_sql_export='off';

query I
SELECT count(*) FROM duckdb_settings() WHERE name='debug_verify_sql_export';
----
0

query I
SELECT count(*) FROM duckdb_settings(debug := true) WHERE name='debug_verify_sql_export';
----
1

statement error
SET debug_verify_sql_export='invalid';
----
<REGEX>:.*

statement error
SET debug_verify_sql_export=NULL;
----
cannot be NULL

statement ok
SET debug_verify_sql_export='strict';

query I
SELECT sum(i) FROM (VALUES (1),(2),(2),(4)) t(i) WHERE i>1;
----
8

statement ok
SET enable_optimizer=false;

query II
SELECT b,a FROM (VALUES (1,2),(NULL,2),(1,2)) t(a,b);
----
2	1
2	NULL
2	1

statement ok
RESET enable_optimizer;

statement ok
RESET debug_verify_sql_export;

statement ok
SET GLOBAL debug_verify_sql_export='report';

query I other
SELECT * FROM range(3);
----
0
1
2

statement ok
RESET GLOBAL debug_verify_sql_export;

statement ok
SET debug_verify_sql_export='report';

query I
SELECT * FROM range(3);
----
0
1
2

statement ok
RESET debug_verify_sql_export;
