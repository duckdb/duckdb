# name: test/sql/sql_export/copy_empty_filename_pattern.test
# description: An explicitly empty filename pattern round-trips through the generated COPY
# group: [sql_export]

statement ok
COPY (
        SELECT CAST(1 AS INTEGER) AS a
    ) TO '__TEST_DIR__/empty_pattern_rt'(FORMAT 'csv', "filename_pattern" '', "per_thread_output" TRUE)

query I
SELECT count(*) FROM read_csv_auto('__TEST_DIR__/empty_pattern_rt/.csv');
----
1
