statement ok
CREATE TABLE t AS SELECT * FROM (VALUES (-3,-1),(-2,2),(1,-3),(2,2)) v(i,j);

query I rowsort
SELECT i FROM t WHERE abs(i)=2;
----
-2
2

query I rowsort
SELECT i FROM t WHERE abs(i)+abs(j)=4;
----
-2
-3
1
2

query I rowsort
SELECT i FROM t WHERE i<j;
----
-2
-3

