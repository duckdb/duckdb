# name: test/sql/sql_export/mark_distinctness_statistics.test
# description: Reconstruct two-valued MARK comparisons after statistics simplify distinctness
# group: [sql_export]

statement ok
CREATE TABLE p(k INTEGER, v INTEGER);

statement ok
CREATE TABLE b(k INTEGER, v INTEGER);

statement ok
INSERT INTO p VALUES (1,10),(2,20),(3,30);

statement ok
INSERT INTO b VALUES (1,11),(2,20);

statement ok
SET debug_verify_statement='explain_sql_strict';

query II
SELECT p.k,__mark_join_marker FROM p JOIN BY(TYPE MARK) b
ON p.k IS NOT DISTINCT FROM b.k AND p.v IS DISTINCT FROM b.v ORDER BY p.k;
----
1	true
2	false
3	false

query II
SELECT p.k,__mark_join_marker FROM p JOIN BY(TYPE MARK) b
ON p.v IS DISTINCT FROM b.v AND p.k IS NOT DISTINCT FROM b.k ORDER BY p.k;
----
1	true
2	false
3	false

query II
SELECT p.k,__mark_join_marker FROM p JOIN BY(TYPE MARK) b
ON p.k IS NOT DISTINCT FROM b.k AND p.v IS NOT DISTINCT FROM b.v ORDER BY p.k;
----
1	false
2	true
3	false

query II
SELECT p.k,__mark_join_marker FROM p JOIN BY(TYPE MARK) b
ON p.k IS NOT DISTINCT FROM b.k AND p.v > b.v ORDER BY p.k;
----
1	false
2	false
3	false

# A nullable grouping comparison must keep its NULL-safe meaning.
statement ok
INSERT INTO p VALUES (NULL,40);

statement ok
INSERT INTO b VALUES (NULL,41);

query II
SELECT p.k,__mark_join_marker FROM p JOIN BY(TYPE MARK) b
ON p.k IS NOT DISTINCT FROM b.k AND p.v IS DISTINCT FROM b.v ORDER BY p.k;
----
1	true
2	false
3	false
NULL	true

query II
SELECT p.k,__mark_join_marker FROM p JOIN BY(TYPE MARK) b
ON p.k IS NOT DISTINCT FROM b.k AND p.v > b.v ORDER BY p.k;
----
1	false
2	false
3	false
NULL	false

statement ok
PREPARE mark_roundtrip AS
SELECT p.k,__mark_join_marker FROM p JOIN BY(TYPE MARK) b
ON p.k IS NOT DISTINCT FROM b.k AND p.v IS DISTINCT FROM b.v ORDER BY p.k;

query II
EXECUTE mark_roundtrip;
----
1	true
2	false
3	false
NULL	true

statement ok
DELETE FROM b;

query II
EXECUTE mark_roundtrip;
----
1	false
2	false
3	false
NULL	false

statement ok
INSERT INTO b VALUES (NULL,NULL),(1,10);

query II
EXECUTE mark_roundtrip;
----
1	false
2	false
3	false
NULL	true
