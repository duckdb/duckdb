# name: test/sql/sql_export/grouped_tuple_mark_roundtrip.test
# description: SQL export preserves grouped tuple equality, nested NULLs and empty groups
# group: [sql_export]

statement ok
CREATE TABLE probes(id INTEGER,g INTEGER,v TUPLE(INTEGER,INTEGER));

statement ok
CREATE TABLE candidates(g INTEGER,v TUPLE(INTEGER,INTEGER));

statement ok
INSERT INTO probes VALUES(0,0,NULL),(1,1,row(1,2)),(2,1,row(9,9)),(3,1,NULL),(4,2,row(1,2)),(5,2,row(2,2)),(6,2,NULL),(7,3,row(1,2)),(8,3,NULL),(9,NULL,row(1,2)),(10,4,row(1,NULL)),(11,4,row(1,2));

statement ok
INSERT INTO candidates VALUES(1,row(1,2)),(1,row(1,2)),(1,NULL),(2,row(2,2)),(NULL,row(1,2)),(4,row(1,NULL));

statement ok
SET debug_verify_statement='explain_sql_strict';

foreach serializer false true

statement ok
SET debug_verify_serializer={serializer};

foreach external false true

statement ok
SET debug_force_external={external};

query T
SELECT list(marker ORDER BY id) FROM (SELECT id,v IN(SELECT c.v FROM candidates c WHERE c.g=p.g) marker FROM probes p);
----
[false, true, NULL, NULL, false, true, NULL, false, false, false, true, false]

query T
SELECT list(marker ORDER BY id) FROM (SELECT id,v NOT IN(SELECT c.v FROM candidates c WHERE c.g=p.g) marker FROM probes p);
----
[true, false, NULL, NULL, true, false, NULL, true, true, true, false, true]

query T
SELECT list(marker ORDER BY id) FROM (SELECT id,v IN(SELECT c.v FROM candidates c WHERE c.g IS NOT DISTINCT FROM p.g) marker FROM probes p);
----
[false, true, NULL, NULL, false, true, NULL, false, false, true, true, false]

# Explicit MARK binding reconstructs the same grouping keys and tuple comparison.
query T
SELECT list(__mark_join_marker ORDER BY id) FROM probes p JOIN BY(TYPE MARK) candidates c ON p.g IS NOT DISTINCT FROM c.g AND p.v=c.v;
----
[false, true, NULL, NULL, false, true, NULL, false, false, true, true, false]

# Tuple equality retains the difference between NULL tuples and tuples containing NULL.
query I
SELECT count(*) FROM probes p WHERE p.v IN(SELECT c.v FROM candidates c WHERE c.g=p.g);
----
3

endloop

endloop

statement ok
RESET debug_force_external;

statement ok
RESET debug_verify_serializer;

statement error
SELECT __mark_join_marker FROM probes p JOIN BY(TYPE MARK) candidates c ON p.g IS NOT DISTINCT FROM c.g AND p.v<c.v;
----
Unsupported explicit MARK join conditions

statement error
SELECT __mark_join_marker FROM probes p JOIN BY(TYPE MARK) candidates c ON p.g IS NOT DISTINCT FROM c.g AND p.v<>c.v;
----
Unsupported explicit MARK join conditions

statement ok
INSERT INTO candidates SELECT 2,row(2,2) FROM range(4096);

query T
SELECT list(marker ORDER BY id) FROM (SELECT id,v IN(SELECT c.v FROM candidates c WHERE c.g=p.g) marker FROM probes p);
----
[false, true, NULL, NULL, false, true, NULL, false, false, false, true, false]

statement ok
DELETE FROM candidates;

query T
SELECT list(marker ORDER BY id) FROM (SELECT id,v IN(SELECT c.v FROM candidates c WHERE c.g=p.g) marker FROM probes p);
----
[false, false, false, false, false, false, false, false, false, false, false, false]
