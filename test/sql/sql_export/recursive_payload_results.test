statement error
WITH RECURSIVE r(k,v) USING KEY(k,last(CASE WHEN k=3 THEN error('payload call failure') ELSE nextval('seq') END) AS v) AS (VALUES(1,1) UNION SELECT k+1,v FROM r WHERE k<4) SELECT k,v FROM r;
----
<REGEX>:Invalid Input Error:.*payload call failure.*

statement ok
ROLLBACK;

