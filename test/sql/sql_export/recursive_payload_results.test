statement ok
SET debug_verify_serializer=true;

statement ok
SET debug_verify_sql_export='off';

query IT nosort payload_max_true
WITH RECURSIVE r(k,v) USING KEY(k,max(v)) AS (SELECT 1,v FROM nested_payload UNION ALL SELECT k+1,v FROM r WHERE k<3) SELECT k,v FROM r ORDER BY k;

statement ok
SET debug_verify_sql_export='strict';

query IT nosort payload_max_true
WITH RECURSIVE r(k,v) USING KEY(k,max(v)) AS (SELECT 1,v FROM nested_payload UNION ALL SELECT k+1,v FROM r WHERE k<3) SELECT k,v FROM r ORDER BY k;

statement ok
DROP SEQUENCE IF EXISTS seq;

statement ok
CREATE SEQUENCE seq;

statement ok
SET debug_verify_sql_export='off';

statement ok
BEGIN;

query II rowsort payload_rows_000
WITH RECURSIVE r(k,v) USING KEY(k,last(nextval('seq')) AS v) AS (VALUES(1,1) UNION SELECT k+1,v FROM r WHERE k<4) SELECT k,v FROM r;

statement ok
ROLLBACK;

query I nosort payload_calls_000
SELECT currval('seq');

statement ok
DROP SEQUENCE IF EXISTS seq;

statement ok
