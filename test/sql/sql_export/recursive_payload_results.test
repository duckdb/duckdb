# name: test/sql/sql_export/recursive_payload_results.test
# description: Recursive payload clauses retain nested collations, effects and failures
# group: [sql_export]

statement ok
SET debug_verify_sql_export='strict';

statement ok
SET threads=1;

statement ok
SET max_execution_time=1000;

statement ok
CREATE TABLE nested_payload AS SELECT ['A' COLLATE nocase] v UNION ALL SELECT ['a' COLLATE nocase];

statement ok
SET debug_verify_serializer=false;

statement ok
SET debug_verify_sql_export='off';

query IT nosort payload_last_false
WITH RECURSIVE r(k,v) USING KEY(k,last(v)) AS (SELECT 1,v FROM nested_payload UNION ALL SELECT k+1,v FROM r WHERE k<3) SELECT k,v FROM r ORDER BY k;

statement ok
SET debug_verify_sql_export='strict';

query IT nosort payload_last_false
WITH RECURSIVE r(k,v) USING KEY(k,last(v)) AS (SELECT 1,v FROM nested_payload UNION ALL SELECT k+1,v FROM r WHERE k<3) SELECT k,v FROM r ORDER BY k;

statement ok
SET debug_verify_serializer=true;

statement ok
SET debug_verify_sql_export='off';

query IT nosort payload_last_true
WITH RECURSIVE r(k,v) USING KEY(k,last(v)) AS (SELECT 1,v FROM nested_payload UNION ALL SELECT k+1,v FROM r WHERE k<3) SELECT k,v FROM r ORDER BY k;

statement ok
SET debug_verify_sql_export='strict';

