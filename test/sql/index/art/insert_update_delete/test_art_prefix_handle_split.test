# name: test/sql/index/art/insert_update_delete/test_art_prefix_handle_split.test
# description: Test prefix splitting and appending during ART insertion
# group: [insert_update_delete]

statement ok
SET index_scan_percentage = 1.0;

statement ok
SET index_scan_max_count = 0;

# Split at every byte across several prefix nodes, including full-node boundaries.
loop pos 0 60

statement ok
CREATE TABLE splits (key VARCHAR PRIMARY KEY);

statement ok
INSERT INTO splits VALUES (repeat('a', 60));

statement ok
INSERT INTO splits VALUES (repeat('a', {pos}) || 'b' || repeat('a', 59 - {pos}));

query I
SELECT count(*) FROM splits WHERE key = repeat('a', 60);
----
1

query I
SELECT count(*) FROM splits WHERE key = repeat('a', {pos}) || 'b' || repeat('a', 59 - {pos});
----
1

statement error
INSERT INTO splits VALUES (repeat('a', 60));
----
Duplicate key

statement ok
DELETE FROM splits WHERE key = repeat('a', {pos}) || 'b' || repeat('a', 59 - {pos});

query I
SELECT count(*) FROM splits WHERE key = repeat('a', 60);
----
1

statement ok
DROP TABLE splits;

endloop

# Preserve the nested duplicate-key subtree when splitting its preceding prefix.
statement ok
CREATE TABLE duplicates (key VARCHAR);

statement ok
CREATE INDEX duplicates_idx ON duplicates(key);

statement ok
INSERT INTO duplicates VALUES (repeat('a', 60)), (repeat('a', 60));

statement ok
INSERT INTO duplicates VALUES ('b' || repeat('a', 59));

query I
SELECT count(*) FROM duplicates WHERE key = repeat('a', 60);
----
2

query I
SELECT count(*) FROM duplicates WHERE key = 'b' || repeat('a', 59);
----
1

# Split a partially filled prefix at its final byte.
statement ok
CREATE TABLE partial (key VARCHAR PRIMARY KEY);

statement ok
INSERT INTO partial VALUES ('short');

statement ok
INSERT INTO partial VALUES ('shorter');

query T rowsort
SELECT key FROM partial WHERE key IN ('short', 'shorter');
----
short
shorter
