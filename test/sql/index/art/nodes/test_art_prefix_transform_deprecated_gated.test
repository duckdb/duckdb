# name: test/sql/index/art/nodes/test_art_prefix_transform_deprecated_gated.test
# description: Test deprecated prefix and gated leaf conversion across checkpoints
# group: [nodes]

statement ok
SET checkpoint_threshold = '10.0 GB';

statement ok
SET index_scan_max_count = 0;

statement ok
SET index_scan_percentage = 1.0;

statement ok
ATTACH '{TEST_DIR}/prefix_transform_gated.db' AS db (STORAGE_VERSION 'v1.0.0');

statement ok
CREATE TABLE db.t(k1 VARCHAR, k2 VARCHAR, k VARCHAR, payload INTEGER);

# Nine equal index keys create a gated nested leaf.
statement ok
INSERT INTO db.t
SELECT
	repeat('a', 80) || 'gate',
	repeat('b', 80) || 'tail',
	repeat('a', 80) || 'gate' || repeat('b', 80) || 'tail',
	i
FROM range(1, 10) AS r(i);

# Split the long prefixes in both indexed columns.
statement ok
INSERT INTO db.t VALUES
	(repeat('a', 80) || 'gath', repeat('b', 80) || 'tail',
	 repeat('a', 80) || 'gath' || repeat('b', 80) || 'tail', 100),
	(repeat('a', 80) || 'gate', repeat('b', 80) || 'taih',
	 repeat('a', 80) || 'gate' || repeat('b', 80) || 'taih', 101);

statement ok
CREATE INDEX idx_t_compound ON db.t(k1, k2);

# The single-column index lets us verify the loaded index with an index scan.
statement ok
CREATE INDEX idx_t_scan ON db.t(k);

# Convert the in-memory prefixes and gated leaf to the v1.0.0 format.
statement ok
CHECKPOINT db;

statement ok
DETACH db;

statement ok
ATTACH '{TEST_DIR}/prefix_transform_gated.db' AS db;

query II
EXPLAIN ANALYZE
SELECT payload
FROM db.t
WHERE k = repeat('a', 80) || 'gate' || repeat('b', 80) || 'tail';
----
analyzed_plan	<REGEX>:.*Type: Index Scan.*

query I
SELECT payload
FROM db.t
WHERE k = repeat('a', 80) || 'gate' || repeat('b', 80) || 'tail'
ORDER BY payload;
----
1
2
3
4
5
6
7
8
9

query I
SELECT payload
FROM db.t
WHERE k = repeat('a', 80) || 'gath' || repeat('b', 80) || 'tail';
----
100

query I
SELECT payload
FROM db.t
WHERE k = repeat('a', 80) || 'gate' || repeat('b', 80) || 'taih';
----
101

# Convert the deprecated leaf back to a smaller gated nested leaf.
statement ok
DELETE FROM db.t WHERE payload IN (2, 4, 6, 8);

# Convert the gated leaf again without replacing the prefix allocator.
statement ok
CHECKPOINT db;

statement ok
DETACH db;

statement ok
ATTACH '{TEST_DIR}/prefix_transform_gated.db' AS db;

# Use both loaded indexes after the second conversion.
statement ok
DELETE FROM db.t WHERE payload = 1;

query II
EXPLAIN ANALYZE
SELECT payload
FROM db.t
WHERE k = repeat('a', 80) || 'gate' || repeat('b', 80) || 'tail';
----
analyzed_plan	<REGEX>:.*Type: Index Scan.*

query I
SELECT payload
FROM db.t
WHERE k = repeat('a', 80) || 'gate' || repeat('b', 80) || 'tail'
ORDER BY payload;
----
3
5
7
9
