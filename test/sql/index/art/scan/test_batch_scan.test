# name: test/sql/index/art/scan/test_batch_scan.test
# description: Test batched equality index scans for IN lists and joins
# group: [scan]

statement ok
CREATE TABLE t AS SELECT i FROM range(100000) r(i);

statement ok
CREATE UNIQUE INDEX idx ON t(i);

statement ok
SET dynamic_or_filter_threshold = 100;

statement ok
SET disabled_optimizers = 'compressed_materialization';

statement ok
CREATE VIEW in_lookup AS SELECT i FROM t WHERE i IN (
    1, 11, 21, 31, 41, 51, 61, 71, 81, 91,
    101, 111, 121, 131, 141, 151, 161, 171, 181, 191,
    201, 211, 221, 231, 241, 251, 261, 271, 281, 291,
    301, 311, 321, 331, 341, 351, 361, 371, 381, 391,
    401, 411, 421, 431, 441, 451, 461, 471, 481, 491,
    501, 511, 521, 531, 541, 551, 561, 571, 581, 591,
    601, 611, 621, 631, 641, 651, 661, 671, 681, 691,
    701, 711, 721, 731, 741, 751, 761, 771, 781, 791,
    801, 811, 821, 831, 841, 851, 861, 871, 881, 891,
    901, 911, 921, 931, 941, 951, 961, 971, 981, 991
);

query II
EXPLAIN ANALYZE SELECT count(*), sum(i) FROM in_lookup;
----
analyzed_plan	<REGEX>:.*Type: Index Scan.*

query II
SELECT count(*), sum(i) FROM in_lookup;
----
100	49600

statement ok
CREATE TABLE k AS SELECT i * 10 + 1 AS i FROM range(100) r(i);

query II
EXPLAIN ANALYZE SELECT count(*), sum(t.i) FROM t JOIN k USING(i);
----
analyzed_plan	<REGEX>:.*Type: Index Scan.*

query II
SELECT count(*), sum(t.i) FROM t JOIN k USING(i);
----
100	49600
