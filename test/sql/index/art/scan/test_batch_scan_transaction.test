# name: test/sql/index/art/scan/test_batch_scan_transaction.test
# description: Test batch scans with deleted rows
# group: [scan]

statement ok
CREATE TABLE t AS SELECT i, i AS j FROM range(10000) r(i);

statement ok
CREATE UNIQUE INDEX idx ON t(i);

statement ok
CREATE TABLE k AS SELECT i * 3 + 1 AS i FROM range(3000) r(i);

# This transaction must still see j = 1 and j = 19 after the rows are replaced.
statement ok old
BEGIN;

query I old
SELECT count(*) FROM t;
----
10000

statement ok
DELETE FROM t WHERE i IN (1, 19);

statement ok
INSERT INTO t VALUES (1, 1000), (19, 2000);

statement ok old
SET dynamic_or_filter_threshold = 3000;

statement ok old
SET index_scan_max_count = 10000;

query II old
EXPLAIN ANALYZE SELECT sum(j) FROM t SEMI JOIN k USING(i);
----
analyzed_plan	<REGEX>:.*Type: Index Scan.*

query I old
SELECT sum(j) FROM t SEMI JOIN k USING(i);
----
13498500

statement ok old
ROLLBACK;
