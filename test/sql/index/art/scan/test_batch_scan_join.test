# name: test/sql/index/art/scan/test_batch_scan_join.test
# description: Enforce the row-ID capacity across multiple chunks of lookup keys
# group: [scan]

statement ok
CREATE TABLE fact AS SELECT i, i AS payload FROM range(100000) r(i);

statement ok
CREATE UNIQUE INDEX fact_i ON fact(i);

# Span multiple key chunks and enforce the capacity across the entire batch.
statement ok
SET dynamic_or_filter_threshold=3000;

statement ok
SET index_scan_percentage=0;

statement ok
SET index_scan_max_count=3000;

statement ok
CREATE TABLE keys AS SELECT i*31 AS i FROM range(3000) r(i);

query II
EXPLAIN ANALYZE SELECT sum(payload) FROM fact SEMI JOIN keys USING(i);
----
analyzed_plan	<REGEX>:.*Type: Index Scan.*

query II
SELECT count(*), sum(payload) FROM fact SEMI JOIN keys USING(i);
----
3000	139453500

statement ok
SET index_scan_max_count=2999;

query II
EXPLAIN ANALYZE SELECT sum(payload) FROM fact SEMI JOIN keys USING(i);
----
analyzed_plan	<REGEX>:.*Type: Sequential Scan.*

query II
SELECT count(*), sum(payload) FROM fact SEMI JOIN keys USING(i);
----
3000	139453500
