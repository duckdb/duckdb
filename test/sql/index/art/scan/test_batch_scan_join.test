# name: test/sql/index/art/scan/test_batch_scan_join.test
# description: Test batch scan capacity
# group: [scan]

statement ok
CREATE TABLE t AS SELECT i FROM range(100000) r(i);

statement ok
CREATE UNIQUE INDEX idx ON t(i);

statement ok
SET dynamic_or_filter_threshold = 3000;

statement ok
SET index_scan_percentage = 0;

statement ok
SET index_scan_max_count = 3000;

statement ok
CREATE TABLE k AS SELECT i * 31 AS i FROM range(3000) r(i);

query II
EXPLAIN ANALYZE SELECT sum(i) FROM t SEMI JOIN k USING(i);
----
analyzed_plan	<REGEX>:.*Type: Index Scan.*

query II
SELECT count(*), sum(i) FROM t SEMI JOIN k USING(i);
----
3000	139453500

# Each lookup chunk fits, but the combined 3000 matches exceed this limit.
statement ok
SET index_scan_max_count = 2999;

query II
EXPLAIN ANALYZE SELECT sum(i) FROM t SEMI JOIN k USING(i);
----
analyzed_plan	<REGEX>:.*Type: Sequential Scan.*

query II
SELECT count(*), sum(i) FROM t SEMI JOIN k USING(i);
----
3000	139453500
