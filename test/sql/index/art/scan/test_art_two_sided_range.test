# name: test/sql/index/art/scan/test_art_two_sided_range.test
# description: Test using an index scan for a two-sided range filter, e.g., a rewritten BETWEEN.
# group: [scan]

statement ok
CREATE TABLE tbl AS SELECT (range * 2654435761) % 500000 AS i FROM range(500000);

statement ok
CREATE INDEX idx_i ON tbl(i);

query II
EXPLAIN ANALYZE SELECT i FROM tbl WHERE i BETWEEN 499990 AND 499992 ORDER BY i;
----
analyzed_plan	<REGEX>:.*Type: Index Scan.*

query I
SELECT i FROM tbl WHERE i BETWEEN 499990 AND 499992 ORDER BY i;
----
499990
499991
499992

query II
EXPLAIN ANALYZE SELECT i FROM tbl WHERE i >= 499990 AND i <= 499992 ORDER BY i;
----
analyzed_plan	<REGEX>:.*Type: Index Scan.*

query I
SELECT i FROM tbl WHERE i >= 499990 AND i <= 499992 ORDER BY i;
----
499990
499991
499992

query II
EXPLAIN ANALYZE SELECT i FROM tbl WHERE i > 499990 AND i < 499992 ORDER BY i;
----
analyzed_plan	<REGEX>:.*Type: Index Scan.*

query I
SELECT i FROM tbl WHERE i > 499990 AND i < 499992 ORDER BY i;
----
499991

query II
EXPLAIN ANALYZE SELECT i FROM tbl WHERE 499990 <= i AND 499992 >= i ORDER BY i;
----
analyzed_plan	<REGEX>:.*Type: Index Scan.*

query I
SELECT i FROM tbl WHERE 499990 <= i AND 499992 >= i ORDER BY i;
----
499990
499991
499992

query II
EXPLAIN ANALYZE SELECT i FROM tbl WHERE i <= 2 ORDER BY i;
----
analyzed_plan	<REGEX>:.*Type: Index Scan.*

query I
SELECT i FROM tbl WHERE i <= 2 ORDER BY i;
----
0
1
2

query I
SELECT count(*) FROM tbl WHERE i >= 499992 AND i <= 499990;
----
0

query I
SELECT count(*) FROM tbl WHERE i >= 499990 AND i <= NULL;
----
0

query I
SELECT count(*) FROM tbl WHERE i >= NULL AND i <= 499992;
----
0

query II
EXPLAIN ANALYZE SELECT count(*) FROM tbl WHERE i >= 499900 AND i <= 499999 AND i % 7 = 0;
----
analyzed_plan	<REGEX>:.*Type: Sequential Scan.*

query I
SELECT count(*) FROM tbl WHERE i >= 499900 AND i <= 499999 AND i % 7 = 0;
----
14

query II
EXPLAIN ANALYZE SELECT i FROM tbl WHERE i IS NOT DISTINCT FROM 499991 AND i <= 499992;
----
analyzed_plan	<REGEX>:.*Type: Sequential Scan.*

query I
SELECT i FROM tbl WHERE i IS NOT DISTINCT FROM 499991 AND i <= 499992;
----
499991

query I
SELECT i FROM tbl WHERE i IS NOT DISTINCT FROM 499991 AND i <= 499990;
----

query II
EXPLAIN ANALYZE SELECT count(*) FROM tbl WHERE i >= 100 AND i <= 400000;
----
analyzed_plan	<REGEX>:.*Type: Sequential Scan.*

query I
SELECT count(*) FROM tbl WHERE i >= 100 AND i <= 400000;
----
399901

