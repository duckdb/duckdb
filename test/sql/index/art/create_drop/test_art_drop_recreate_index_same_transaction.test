# name: test/sql/index/art/create_drop/test_art_drop_recreate_index_same_transaction.test
# description: Test recreating a dropped index with IF NOT EXISTS in the same transaction
# group: [create_drop]

# TODO: WAL serialization can select the dropped unbound index after a forced reload.
require skip_reload

statement ok
CREATE TABLE t(i INTEGER)

statement ok
CREATE UNIQUE INDEX idx ON t(i)

statement ok
BEGIN

statement ok
DROP INDEX idx

statement ok
CREATE UNIQUE INDEX IF NOT EXISTS idx ON t(i)

statement ok
COMMIT

query I
SELECT count(*) FROM duckdb_indexes() WHERE index_name = 'idx'
----
1

statement error
INSERT INTO t VALUES (1), (1)
----
<REGEX>:Constraint Error:.*

# Reusing the name on another table must not hide an earlier index on t.
statement ok
CREATE TABLE other(i INTEGER)

statement ok
BEGIN

statement ok
DROP INDEX idx

statement ok
CREATE INDEX idx ON other(i)

statement ok
DROP INDEX idx

statement ok
CREATE UNIQUE INDEX IF NOT EXISTS idx ON t(i)

statement ok
COMMIT

query T
SELECT table_name FROM duckdb_indexes() WHERE index_name = 'idx'
----
t

statement error
INSERT INTO t VALUES (1), (1)
----
<REGEX>:Constraint Error:.*
