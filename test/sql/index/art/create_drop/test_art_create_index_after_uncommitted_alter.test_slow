# name: test/sql/index/art/create_drop/test_art_create_index_after_uncommitted_alter.test_slow
# description: Test ART creation on a table that an uncommitted ALTER replaced, while the ALTER commits a delete
# group: [create_drop]

statement ok
CREATE TABLE t AS SELECT range AS a, range AS b, range AS c FROM range(10000000);

# thread 1 drops a column and deletes a row while thread 0 creates an index on the old version of the table
concurrentloop threadid 0 2

onlyif threadid=1
statement ok
BEGIN;

onlyif threadid=1
statement ok
ALTER TABLE t DROP COLUMN a;

onlyif threadid=0
sleep 1 second

onlyif threadid=0
statement error
CREATE INDEX idx_c ON t(c);
----
<REGEX>:.*Transaction conflict.*altered.*

onlyif threadid=1
sleep 2 second

onlyif threadid=1
statement ok
DELETE FROM t WHERE b = 1;

onlyif threadid=1
statement ok
COMMIT;

endloop

query II
SELECT count(*), count(*) FILTER (WHERE b = 1) FROM t;
----
9999999	0
