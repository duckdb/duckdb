# name: test/sql/index/art/create_drop/test_art_create_index_during_alter.test_slow
# description: Test ART creation racing an ALTER TABLE
# group: [create_drop]

statement ok
SET checkpoint_threshold = '1TB';

statement ok
CREATE TABLE t AS SELECT range AS c, range AS d FROM range(200000);

statement ok
CREATE TABLE ledger(entry UBIGINT);

statement ok
CREATE INDEX idx_ledger ON ledger(entry);

concurrentforeach role con_h con_x con_a

# con_h: its COMMIT appends 10M keys to idx_ledger under the commit lock, so con_x waits to publish idx_d
onlyif role=con_h
statement ok
BEGIN;

onlyif role=con_h
statement ok
INSERT INTO ledger SELECT hash(i) FROM range(10000000) r(i);

onlyif role=con_h
sleep 200 millisecond

onlyif role=con_h
statement ok
COMMIT;

onlyif role=con_x
statement maybe
CREATE INDEX idx_d ON t(d);
----
<REGEX>:.*attempting to add an index to table "t" but it has been .* by a different transaction.*

onlyif role=con_a
sleep 4000 millisecond

onlyif role=con_a
statement maybe
ALTER TABLE t DROP COLUMN d;
----
an index depends on it

endloop

# the index exists only if its column does
query I
SELECT (SELECT count(*) FROM duckdb_indexes() WHERE table_name = 't') = (SELECT count(*) FROM duckdb_columns() WHERE table_name = 't' AND column_name = 'd');
----
true

statement ok
INSERT INTO t SELECT * FROM t WHERE c >= 5000 AND c < 6000;

statement ok
DELETE FROM t WHERE c < 1000;

query I
SELECT count(*) FROM t WHERE c = 5000;
----
2
