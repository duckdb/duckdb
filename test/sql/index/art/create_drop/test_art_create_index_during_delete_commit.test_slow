# name: test/sql/index/art/create_drop/test_art_create_index_during_delete_commit.test_slow
# description: Test ART creation while a large DELETE commits
# group: [create_drop]

# keep con_d's commit from checkpointing
statement ok
SET checkpoint_threshold = '1TB';

statement ok
CREATE TABLE orders AS SELECT range AS order_id, hash(range) AS ref_a, hash(range + 1) AS ref_b, range % 1000 AS customer_id FROM range(2000000);

statement ok
CREATE INDEX idx_ref_a ON orders(ref_a);

statement ok
CREATE INDEX idx_ref_b ON orders(ref_b);

concurrentforeach role con_d con_x

onlyif role=con_x
statement ok
BEGIN;

onlyif role=con_x
query I
SELECT count(*) FROM orders;
----
2000000

onlyif role=con_d
statement ok
BEGIN;

onlyif role=con_d
statement ok
DELETE FROM orders WHERE order_id % 2 = 0;

onlyif role=con_d
sleep 200 millisecond

# the commit removes 1M rows from idx_ref_a and idx_ref_b
onlyif role=con_d
statement ok
COMMIT;

onlyif role=con_x
sleep 400 millisecond

# COALESCE makes a NULL key a real key
onlyif role=con_x
statement ok
CREATE INDEX idx_new ON orders(COALESCE(customer_id, -1));

# con_x still sees the deleted rows
onlyif role=con_x
query I
SELECT count(*) FROM orders WHERE COALESCE(customer_id, -1) = 8;
----
2000

onlyif role=con_x
statement ok
COMMIT;

endloop

query I
SELECT count(*) FROM orders;
----
1000000

query II
SELECT (SELECT count(*) FROM orders WHERE COALESCE(customer_id, -1) = 7), (SELECT count(*) FROM orders WHERE COALESCE(customer_id, -1) = 8);
----
2000	0
