# name: test/sql/index/art/create_drop/test_art_create_index_older_snapshot.test
# description: Test indexes built after a delete that an older snapshot does not see
# group: [create_drop]

statement ok
CREATE TABLE t(k INTEGER, v INTEGER, w INTEGER);

statement ok
INSERT INTO t SELECT i, i, i FROM range(10000) r(i);

# keeps the delete below for cleanup until con_old ends
statement ok
CREATE INDEX idx_v ON t(v);

statement ok con_old
BEGIN;

query I con_old
SELECT count(*) FROM t;
----
10000

statement ok
DELETE FROM t WHERE k IN (5, 7);

statement ok
CREATE UNIQUE INDEX idx_k ON t(k);

# idx_k does not hold row 5, which con_old still sees
query III con_old
SELECT k, v, w FROM t WHERE k = 5;
----
5	5	5

# an index that con_old builds holds the rows as of the last commit too
statement ok con_old
CREATE INDEX idx_w ON t(w);

query III con_old
SELECT k, v, w FROM t WHERE w = 7;
----
7	7	7

statement ok con_old
COMMIT;

query II
SELECT k, w FROM t WHERE k = 6;
----
6	6

query I
SELECT count(*) FROM t WHERE w = 7;
----
0

# the deleted key is not in idx_k
statement ok
INSERT INTO t VALUES (5, 5, 5);

query III
SELECT k, v, w FROM t WHERE k = 5;
----
5	5	5

# the same through ALTER TABLE ADD PRIMARY KEY
statement ok
CREATE TABLE u AS SELECT range AS k FROM range(10000);

statement ok con_old
BEGIN;

query I con_old
SELECT count(*) FROM u;
----
10000

statement ok
DELETE FROM u WHERE k = 5;

statement ok
ALTER TABLE u ADD PRIMARY KEY (k);

query I con_old
SELECT k FROM u WHERE k = 5;
----
5

statement ok con_old
COMMIT;

statement ok
INSERT INTO u VALUES (5);
