# V2
statement ok
COPY (SELECT 'POINT(1 2)'::GEOGRAPHY as geography)
TO '{TEST_DIR}/test_geography_v2.parquet' (FORMAT PARQUET, GEOPARQUET_VERSION 'V2');

query I
SELECT (decode(value)) as col
FROM parquet_kv_metadata('{TEST_DIR}/test_geography_v2.parquet');
----
{"version":"2.0.0","primary_column":"geography","columns":{"geography":{"encoding":"WKB","geometry_types":["Point"],"edges":"spherical","bbox":[1.0,2.0,1.0,2.0]}}}

query I
SELECT geo_types from parquet_metadata('{TEST_DIR}/test_geography_v2.parquet');
