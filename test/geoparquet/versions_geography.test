# name: test/geoparquet/versions_geography.test
# description: GEOGRAPHY is written like GEOMETRY for every GeoParquet version, with spherical edges
# group: [geoparquet]

require parquet

# DEFAULT (V1)

statement ok
COPY (SELECT 'POINT(1 2)'::GEOGRAPHY as geography)
TO '{TEST_DIR}/test_geography_default.parquet' (FORMAT PARQUET);

query I
SELECT (decode(value)) as col
FROM parquet_kv_metadata('{TEST_DIR}/test_geography_default.parquet');
----
{"version":"1.0.0","primary_column":"geography","columns":{"geography":{"encoding":"WKB","geometry_types":["Point"],"edges":"spherical","bbox":[1.0,2.0,1.0,2.0]}}}

query I
SELECT geo_types from parquet_metadata('{TEST_DIR}/test_geography_default.parquet');
----
NULL

query I
SELECT logical_type FROM parquet_schema('{TEST_DIR}/test_geography_default.parquet') WHERE name = 'geography';
----
NULL

query II
SELECT typeof(geography), ST_AsText(geography) FROM '{TEST_DIR}/test_geography_default.parquet';
----
GEOGRAPHY('OGC:CRS84')	POINT (1 2)

# V1

statement ok
COPY (SELECT 'POINT(1 2)'::GEOGRAPHY as geography)
TO '{TEST_DIR}/test_geography_v1.parquet' (FORMAT PARQUET, GEOPARQUET_VERSION 'V1');

query I
SELECT (decode(value)) as col
FROM parquet_kv_metadata('{TEST_DIR}/test_geography_v1.parquet');
----
{"version":"1.0.0","primary_column":"geography","columns":{"geography":{"encoding":"WKB","geometry_types":["Point"],"edges":"spherical","bbox":[1.0,2.0,1.0,2.0]}}}

query I
SELECT geo_types from parquet_metadata('{TEST_DIR}/test_geography_v1.parquet');
----
NULL

query I
SELECT logical_type FROM parquet_schema('{TEST_DIR}/test_geography_v1.parquet') WHERE name = 'geography';
----
NULL

query II
SELECT typeof(geography), ST_AsText(geography) FROM '{TEST_DIR}/test_geography_v1.parquet';
----
GEOGRAPHY('OGC:CRS84')	POINT (1 2)

# NONE

statement ok
COPY (SELECT 'POINT(1 2)'::GEOGRAPHY as geography)
TO '{TEST_DIR}/test_geography_none.parquet' (FORMAT PARQUET, GEOPARQUET_VERSION 'NONE');

query I
SELECT (decode(value)) as col
FROM parquet_kv_metadata('{TEST_DIR}/test_geography_none.parquet');
----

query I
SELECT geo_types from parquet_metadata('{TEST_DIR}/test_geography_none.parquet');
----
[point]

query I
SELECT logical_type FROM parquet_schema('{TEST_DIR}/test_geography_none.parquet') WHERE name = 'geography';
----
GeographyType(crs=<null>, algorithm=SPHERICAL)

query II
SELECT typeof(geography), ST_AsText(geography) FROM '{TEST_DIR}/test_geography_none.parquet';
----
GEOGRAPHY	POINT (1 2)

