# name: test/parquet/corrupt/row_group_rows_beyond_file.test
# description: Reject row groups that declare more rows than their column chunks hold when no column chunk is read
# group: [corrupt]

require parquet

statement ok
SET max_execution_time=10000;

# A row group of 9223372036854775807 rows whose column chunk has no metadata: a scan that reads no column chunk
# produced the declared rows from the footer alone.
statement error
SELECT 42 FROM read_parquet('{DATA_DIR}/parquet-testing/corrupt/row_group_rows_beyond_file.parquet');
----
column chunk is missing its metadata

# count(*) is not answered from the row counts of such row groups either
statement error
SELECT count(*) FROM read_parquet('{DATA_DIR}/parquet-testing/corrupt/row_group_rows_beyond_file.parquet');
----
column chunk is missing its metadata

# Two row groups with 2 and 9223372036854775807 rows: adding up the row counts for count(*) was an internal error.
statement error
SELECT count(*) FROM read_parquet('{DATA_DIR}/parquet-testing/corrupt/row_group_rows_overflow.parquet');
----
Column has 1 values but row group has 9223372036854775807 rows

statement error
SELECT * FROM read_parquet('{DATA_DIR}/parquet-testing/corrupt/row_group_rows_overflow.parquet');
----
Column has 1 values but row group has 9223372036854775807 rows

# a scan without columns of the file of test/sql/copy/parquet/parquet_row_group_row_count.test
statement error
SELECT count(*) FROM read_parquet('{DATA_DIR}/parquet-testing/broken/huge_rg_num_rows.parquet');
----
Column has 3 values but row group has 9223372036854775807 rows

statement error
SELECT 42 FROM read_parquet('{DATA_DIR}/parquet-testing/broken/huge_rg_num_rows.parquet');
----
Column has 3 values but row group has 9223372036854775807 rows

# 9223372036854775807 rows of a REQUIRED column whose statistics count every value as NULL: the column was produced
# as NULLs without reading a page, so the probe side of the join did not end. A column without definition levels has
# no NULLs, so its pages are read.
statement error
SELECT count(*)
FROM read_parquet('{DATA_DIR}/parquet-testing/corrupt/required_column_all_null_statistics.parquet') p
JOIN (SELECT (i * 3)::INTEGER AS k FROM range(40) t(i)) b ON p.id = b.k;
----
Failed to decompress GZIP block

query I
SELECT 42;
----
42
