# name: test/parquet/late_materialization_virtual_column_filter.test
# description: Late materialization with a pushed-down filter on a virtual column (e.g. filename) must not index returned_types with a virtual column id
# group: [parquet]

require parquet

statement ok
COPY (SELECT i, i + 1 AS j, i + 2 AS k, -i AS l FROM range(100) t(i)) TO '{TEST_DIR}/lm_virtual_filter.parquet' (FORMAT parquet)

# a filter on the virtual filename column used to throw
# INTERNAL Error: Attempted to access index -9223372036854775808 within vector of size 4
query IIII
SELECT * FROM read_parquet('{TEST_DIR}/lm_virtual_filter.parquet') WHERE filename LIKE '%lm_virtual_filter%' ORDER BY j DESC LIMIT 5
----
99	100	101	-99
98	99	100	-98
97	98	99	-97
96	97	98	-96
95	96	97	-95

# a non-matching filename filter yields no rows
query IIII
SELECT * FROM read_parquet('{TEST_DIR}/lm_virtual_filter.parquet') WHERE filename LIKE '%does_not_exist%' ORDER BY j DESC LIMIT 5
----

# without a virtual column filter the results are unchanged
query IIII
SELECT * FROM read_parquet('{TEST_DIR}/lm_virtual_filter.parquet') ORDER BY j DESC LIMIT 3
----
99	100	101	-99
98	99	100	-98
97	98	99	-97
