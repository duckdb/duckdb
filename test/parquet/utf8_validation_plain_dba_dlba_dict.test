query T
SELECT * FROM parquet_scan(
             'data/parquet-testing/binary_string.parquet',
             binary_as_string=false
         );
----
foo
bar
baz

statement ok
SET debug_verify_serializer=true

query T
SELECT * FROM read_parquet(
    'data/parquet-testing/invalid.parquet',
    utf8_validation='replace'
)
----
TREL?

query T
SELECT * FROM read_parquet(
    'data/parquet-testing/invalid.parquet',
    utf8_validation='ignore'
)
----
TREL

statement ok
SET debug_verify_serializer=false

query T
SELECT * FROM read_parquet(
    'data/parquet-testing/invalid.parquet',
    utf8_validation='iGnOrE'
)
----
TREL

query T
SELECT hex(decode(from_hex('C328'), 'ignore'));
----
28

query T
SELECT hex(decode(from_hex('E228A1'), 'ignore'));
----
28

query T
SELECT hex(decode(from_hex('E28228'), 'ignore'));
----
28

query T
SELECT hex(decode(from_hex('F0288CBC'), 'ignore'));
----
28

query T
SELECT hex(decode(from_hex('C2FF28'), 'ignore'));
----
28

query T
SELECT hex(decode(from_hex('C2FF28'), 'replace'));
----
3F3F28

query T
SELECT hex(decode(from_hex('C08041'), 'ignore'));
----
41

