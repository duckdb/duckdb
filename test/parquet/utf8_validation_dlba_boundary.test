# name: test/parquet/utf8_validation_dlba_boundary.test
# description: DELTA_LENGTH_BYTE_ARRAY strings that cut a multi-byte character are rejected, complete ones are not
# group: [parquet]

require parquet

# strings ending in 2, 3 and 4 byte characters are valid
statement ok
COPY (SELECT s FROM (VALUES (1, 'café'), (2, 'Привет'), (3, 'cost €'), (4, 'ok 😀'), (5, 'ascii')) t(i, s) ORDER BY i) TO '__TEST_DIR__/dlba_complete.parquet' (PARQUET_VERSION v2, DICTIONARY_SIZE_LIMIT 0);

query T
SELECT list(s) FROM '__TEST_DIR__/dlba_complete.parquet';
----
[café, Привет, cost €, ok 😀, ascii]

# a 3 byte character split over two strings
statement ok
COPY (SELECT s FROM (VALUES (1, 'a\xE2\x82'::BLOB), (2, '\xACb'::BLOB)) t(i, s) ORDER BY i) TO '__TEST_DIR__/dlba_split3.parquet' (PARQUET_VERSION v2, DICTIONARY_SIZE_LIMIT 0);

statement error
SELECT s FROM read_parquet('__TEST_DIR__/dlba_split3.parquet', binary_as_string=true);
----
Invalid Input Error

# a 4 byte character split after its second byte
statement ok
COPY (SELECT s FROM (VALUES (1, 'x\xF0\x9F'::BLOB), (2, '\x98\x80y'::BLOB)) t(i, s) ORDER BY i) TO '__TEST_DIR__/dlba_split4.parquet' (PARQUET_VERSION v2, DICTIONARY_SIZE_LIMIT 0);

statement error
SELECT s FROM read_parquet('__TEST_DIR__/dlba_split4.parquet', binary_as_string=true);
----
Invalid Input Error

# a 4 byte character split before its last byte
statement ok
COPY (SELECT s FROM (VALUES (1, 'x\xF0\x9F\x98'::BLOB), (2, '\x80'::BLOB)) t(i, s) ORDER BY i) TO '__TEST_DIR__/dlba_split4_last.parquet' (PARQUET_VERSION v2, DICTIONARY_SIZE_LIMIT 0);

statement error
SELECT s FROM read_parquet('__TEST_DIR__/dlba_split4_last.parquet', binary_as_string=true);
----
Invalid Input Error

