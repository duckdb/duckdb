# name: test/parquet/variant/variant_malicious.test
# group: [variant]

require parquet

statement error
SELECT * FROM read_parquet('{DATA_DIR}/parquet-testing/variant_malicious.parquet');
----
IO Error: Data corruption detected, read of length_in_bytes (1) would exceed buffer capacity

statement error
SELECT variant_bytes_to_variant('\x01\x02\xC8\x05\x0A\x00\x00\x00\x00\x00'::BLOB);
----
IO Error: Corrupted VARIANT 'metadata' buffer, the next dictionary offset is smaller than the last offset

# Invalid UTF-8 in a short string is corrupted input, not an internal error
statement error
SELECT variant_bytes_to_variant('\x01\x00\x00\x05\xFF'::BLOB);
----
IO Error: Can't decode Variant short-string, string isn't valid UTF8

# Decimal scale exceeding the maximum DECIMAL width
statement error
SELECT variant_bytes_to_variant('\x01\x00\x00\x20\xFF\x05\x00\x00\x00'::BLOB);
----
IO Error: Corrupted VARIANT 'value' buffer, decimal scale 255 exceeds the maximum of 38

statement error
SELECT variant_bytes_to_variant('\x01\x00\x00\x24\x27\x05\x00\x00\x00\x00\x00\x00\x00'::BLOB);
----
IO Error: Corrupted VARIANT 'value' buffer, decimal scale 39 exceeds the maximum of 38

# DECIMAL16 value outside of the DECIMAL(38) range
statement error
SELECT variant_bytes_to_variant('\x01\x00\x00\x28\x00\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\x7F'::BLOB);
----
IO Error: Corrupted VARIANT 'value' buffer, DECIMAL16 value exceeds the maximum width of 38

statement error
SELECT variant_bytes_to_variant('\x01\x00\x00\x28\x26\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x80'::BLOB);
----
IO Error: Corrupted VARIANT 'value' buffer, DECIMAL16 value exceeds the maximum width of 38
