# name: test/parquet/variant/variant_malicious.test
# group: [variant]

require parquet

statement error
SELECT * FROM read_parquet('{DATA_DIR}/parquet-testing/variant_malicious.parquet');
----
IO Error: Data corruption detected, read of length_in_bytes (1) would exceed buffer capacity

statement error
SELECT variant_bytes_to_variant('\x01\x02\xC8\x05\x0A\x00\x00\x00\x00\x00'::BLOB);
----
IO Error: Corrupted VARIANT 'metadata' buffer, the next dictionary offset is smaller than the last offset

# Invalid UTF-8 in a short string is corrupted input, not an internal error
statement error
SELECT variant_bytes_to_variant('\x01\x00\x00\x05\xFF'::BLOB);
----
IO Error: Can't decode Variant short-string, string isn't valid UTF8

# TIME values outside of [00:00:00, 24:00:00] are corrupted input
statement error
SELECT variant_bytes_to_variant('\x01\x00\x00\x44\x00\x10\xAC\xD1\x53\x00\x00\x00'::BLOB);
----
IO Error: Corrupted VARIANT 'value' buffer, TIME value (360000000000) is out of range

statement error
SELECT variant_bytes_to_variant('\x01\x00\x00\x44\x00\x00\x92\xDB\x0B\x7D\x7F\x02'::BLOB);
----
IO Error: Corrupted VARIANT 'value' buffer, TIME value (180000000000000000) is out of range

statement error
SELECT variant_bytes_to_variant('\x01\x00\x00\x44\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF'::BLOB);
----
IO Error: Corrupted VARIANT 'value' buffer, TIME value (-1) is out of range

statement error
SELECT variant_bytes_to_variant('\x01\x00\x00\x44\x01\x60\xD7\x1D\x14\x00\x00\x00'::BLOB);
----
IO Error: Corrupted VARIANT 'value' buffer, TIME value (86400000001) is out of range

query II
SELECT variant_bytes_to_variant('\x01\x00\x00\x44\x00\x60\xD7\x1D\x14\x00\x00\x00'::BLOB) v, variant_typeof(v);
----
24:00:00	TIME_MICROS

query I
SELECT variant_bytes_to_variant('\x01\x00\x00\x44\x00\x00\x00\x00\x00\x00\x00\x00'::BLOB);
----
00:00:00

# DECIMAL scales above the maximum decimal width are corrupted input
statement error
SELECT variant_bytes_to_variant('\x01\x00\x00\x20\x27\x01\x00\x00\x00'::BLOB);
----
IO Error: Corrupted VARIANT 'value' buffer, DECIMAL scale (39) is out of range

statement error
SELECT variant_bytes_to_variant('\x01\x00\x00\x28\xFF\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00'::BLOB);
----
IO Error: Corrupted VARIANT 'value' buffer, DECIMAL scale (255) is out of range
