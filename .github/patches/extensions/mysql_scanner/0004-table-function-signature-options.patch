+	signature.AddOptionalNamedParameter("connection", LogicalType::UBIGINT)
+	    .AddOptionalNamedParameter("prepare", LogicalType::BOOLEAN);
+	if (suppress_dml_output) {
+		signature.AddOptionalNamedParameter("suppress_dml_output", LogicalType::BOOLEAN);
+	}
+	return signature;
