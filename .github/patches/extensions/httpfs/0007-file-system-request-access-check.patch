+void S3Url::RefuseEndpointQueryParameter(const string &url) {
+	auto question_pos = url.find_first_of('?');
+	if (question_pos == string::npos) {
+		return;
+	}
+	auto query_params = ParseQueryParameters(url.substr(question_pos + 1));
+	if (query_params.find("s3_endpoint") != query_params.end()) {
+		// the query string can hold credentials, so only the path is named
+		throw PermissionException(
+		    "Cannot use the URL parameter s3_endpoint for \"%s\" - external access is disabled by configuration",
+		    url.substr(0, question_pos));
+	}
+}
