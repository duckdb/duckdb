diff --git a/test/sql/httpfs/external_access_file_system.test b/test/sql/httpfs/external_access_file_system.test
new file mode 100644
index 0000000..16080c9
--- /dev/null
+++ b/test/sql/httpfs/external_access_file_system.test
@@ -0,0 +1,121 @@
+# name: test/sql/httpfs/external_access_file_system.test
+# description: An allowed directory admits the requests httpfs makes for the paths under it
+# group: [httpfs]
+
+require httpfs
+
+statement ok
+SET allow_persistent_secrets = false;
+
+statement ok
+SET http_retries = 0;
+
+# the endpoint is a closed local port, so every request that is sent fails to connect
+statement ok
+CREATE SECRET (TYPE s3, KEY_ID 'k', SECRET 's', REGION 'us-east-1', ENDPOINT '127.0.0.1:9', URL_STYLE 'path', USE_SSL false);
+
+statement ok
+SET allowed_directories = ['s3://allowed-bucket/', 'http://127.0.0.1:10/', 'hf://datasets/allowed-user/allowed-dataset/'];
+
+# with external access on, a URL parameter can send the request to another endpoint
+statement error
+SELECT * FROM read_csv('s3://allowed-bucket/x.csv?s3_endpoint=127.0.0.1:11');
+----
+<REGEX>:.*IO Error.*http://127\.0\.0\.1:11/allowed-bucket/x\.csv.*
+
+statement ok
+SET enable_external_access = false;
+
+statement error
+SELECT * FROM read_csv('s3://allowed-bucket/x.csv');
+----
+<REGEX>:.*IO Error.*http://127\.0\.0\.1:9/allowed-bucket/x\.csv.*
+
+statement error
+SELECT * FROM glob('s3://allowed-bucket/*.csv');
+----
+<REGEX>:.*IO Error.*http://127\.0\.0\.1:9/allowed-bucket/.*
+
+statement error
+COPY (SELECT 42 AS i) TO 's3://allowed-bucket/out.csv';
+----
+<REGEX>:.*IO Error.*s3://allowed-bucket/out\.csv.*
+
+statement error
+SELECT * FROM read_csv('s3://other-bucket/x.csv');
+----
+Permission Error: Cannot access file "s3://other-bucket/x.csv" - file system operations are disabled by configuration
+
+statement error
+SELECT * FROM glob('s3://other-bucket/*.csv');
+----
+Permission Error: Cannot access file "s3://other-bucket/*.csv"
+
+statement error
+COPY (SELECT 42 AS i) TO 's3://other-bucket/out.csv';
+----
+Permission Error: Cannot access file "s3://other-bucket/out.csv"
+
+# when the URL chooses the endpoint, the request is checked as the url it is sent to, not as the S3 path
+statement error
+SELECT * FROM read_csv('s3://allowed-bucket/x.csv?s3_endpoint=127.0.0.1:11');
+----
+Permission Error: Cannot access "http://127.0.0.1:11/allowed-bucket/x.csv" - file system operations are disabled by configuration
+
+statement error
+SELECT * FROM read_csv('s3://allowed-bucket/x.csv?s3_endpoint=');
+----
+<REGEX>:Permission Error: Cannot access "http://s3[^"]*amazonaws\.com/allowed-bucket/x\.csv".*
+
+statement error
+SELECT * FROM glob('s3://allowed-bucket/*.csv?s3_endpoint=127.0.0.1:11');
+----
+<REGEX>:Permission Error: Cannot access "http://127\.0\.0\.1:11/allowed-bucket/.*
+
+statement error
+COPY (SELECT 42 AS i) TO 's3://allowed-bucket/out.csv?s3_endpoint=127.0.0.1:11';
+----
+<REGEX>:Permission Error: Cannot access "http://127\.0\.0\.1:11/allowed-bucket/out\.csv.*
+
+# an endpoint chosen by the URL is admitted when that url is allowed itself
+statement error
+SELECT * FROM read_csv('s3://allowed-bucket/x.csv?s3_endpoint=127.0.0.1:10');
+----
+<REGEX>:.*IO Error.*http://127\.0\.0\.1:10/allowed-bucket/x\.csv.*
+
+# other URL parameters still apply
+statement error
+SELECT * FROM read_csv('s3://allowed-bucket/x.csv?s3_region=us-west-2&s3_url_style=path&s3_use_ssl=false');
+----
+<REGEX>:.*IO Error.*http://127\.0\.0\.1:9/allowed-bucket/x\.csv.*
+
+# hf:// paths are sent to huggingface.co: the proxy is a closed local port, so the requests fail to connect
+statement ok
+SET http_proxy = '127.0.0.1:9';
+
+# no CA certificate bundle is readable under the restricted configuration, for either client
+statement ok
+SET enable_server_cert_verification = false;
+
+statement ok
+SET enable_curl_server_cert_verification = false;
+
+statement error
+SELECT * FROM read_csv('hf://datasets/allowed-user/allowed-dataset/x.csv');
+----
+<REGEX>:.*IO Error.*https://huggingface\.co/datasets/allowed-user/allowed-dataset/resolve/main/x\.csv.*
+
+statement error
+SELECT * FROM glob('hf://datasets/allowed-user/allowed-dataset/*.csv');
+----
+<REGEX>:.*IO Error.*https://huggingface\.co/api/datasets/allowed-user/allowed-dataset/tree/main.*
+
+statement error
+SELECT * FROM read_csv('hf://datasets/other-user/other-dataset/x.csv');
+----
+Permission Error: Cannot access file "hf://datasets/other-user/other-dataset/x.csv"
+
+statement error
+SELECT * FROM glob('hf://datasets/other-user/other-dataset/*.csv');
+----
+Permission Error: Cannot access file "hf://datasets/other-user/other-dataset/*.csv"
