diff --git a/src/include/external_access.hpp b/src/include/external_access.hpp
new file mode 100644
index 0000000..62be7bd
--- /dev/null
+++ b/src/include/external_access.hpp
@@ -0,0 +1,34 @@
+#pragma once
+
+#include "duckdb_extension_api.hpp"
+#include "capi_pointers.hpp"
+#include "scanner_exception.hpp"
+
+#include <memory>
+
+namespace odbcscanner {
+
+using ClientContextPtr = std::unique_ptr<_duckdb_client_context, void (*)(duckdb_client_context)>;
+
+inline void ClientContextDeleter(duckdb_client_context context) {
+	if (context != nullptr) {
+		duckdb_destroy_client_context(&context);
+	}
+}
+
+//! Opening an ODBC connection accesses an external resource - a local file or a network host, depending on the driver -
+//! outside of the file systems of DuckDB, so it must honor enable_external_access like the other data-access paths.
+inline void VerifyExternalAccess(duckdb_client_context context) {
+	auto value = ValuePtr(duckdb_client_context_get_config_option(context, "enable_external_access", nullptr),
+	                      ValueDeleter);
+	if (value.get() == nullptr || duckdb_is_null_value(value.get())) {
+		// the setting is unavailable - do not block
+		return;
+	}
+	if (!duckdb_get_bool(value.get())) {
+		throw ScannerException(
+		    "ODBC connections cannot be opened when external access is disabled (enable_external_access)");
+	}
+}
+
+} // namespace odbcscanner
diff --git a/test/sql/external_access.test b/test/sql/external_access.test
new file mode 100644
index 0000000..a569839
--- /dev/null
+++ b/test/sql/external_access.test
@@ -0,0 +1,19 @@
+# name: test/sql/external_access.test
+# description: odbc_query and odbc_connect check enable_external_access before opening a connection
+# group: [sql]
+
+require odbc_scanner
+
+statement ok
+SET enable_external_access=false;
+
+# the connection is not even opened: the check fails at bind, before the ODBC driver is touched
+statement error
+SELECT * FROM odbc_query('Driver=SQLite3;Database=test.sqlite;', 'SELECT 1');
+----
+<REGEX>:.*enable_external_access.*
+
+statement error
+SELECT odbc_connect('Driver=SQLite3;Database=test.sqlite;');
+----
+<REGEX>:.*enable_external_access.*
