--- a/test/sql/legacy/legacy_parser.test
+++ /dev/null
@@ -1,144 +0,0 @@
-# name: test/sql/legacy/legacy_parser.test
-# description: The 1.5 Postgres-derived parser, registered as a parser override
-# group: [legacy]
-
-require legacy_parser
-
-# loading alone changes nothing: the built-in parser handles every query until the opt-in is set
-query I
-SELECT current_setting('enable_legacy_parser')
-----
-false
-
-query I
-SELECT lower(current_setting('allow_parser_override_extension'))
-----
-default
-
-query I
-1 + 1
-----
-2
-
-# the opt-in: the legacy grammar is the parser, and the core setting moves from default to strict
-statement ok
-SET enable_legacy_parser = true
-
-query I
-SELECT current_setting('allow_parser_override_extension')
-----
-strict
-
-query I
-SELECT 42
-----
-42
-
-# column naming follows the 1.5 parser
-query I
-SELECT [1, 2, 3][2]
-----
-2
-
-query II
-WITH c AS (SELECT range AS i, range % 2 AS j FROM range(6)) SELECT j, sum(i) FROM c GROUP BY j ORDER BY j
-----
-0	6
-1	9
-
-statement ok
-CREATE TABLE t(i INTEGER, j INTEGER)
-
-statement ok
-ALTER TABLE t ADD COLUMN k INTEGER DEFAULT 5
-
-query III
-INSERT INTO t VALUES (1, 2, 3) RETURNING *
-----
-1	2	3
-
-statement ok
-PREPARE p AS SELECT count(*) FROM t WHERE i = $1
-
-query I
-EXECUTE p(1)
-----
-1
-
-# the legacy parser's own error wording
-statement error
-SELEC 1
-----
-syntax error at or near "SELEC"
-
-# PEG-only syntax is rejected outright in strict mode
-statement error
-1 + 1
-----
-syntax error at or near "1"
-
-# switching the opt-in off means the built-in parser again, without touching the parser options
-statement ok
-SET enable_legacy_parser = false
-
-query I
-SELECT current_setting('allow_parser_override_extension')
-----
-strict
-
-query I
-1 + 1
-----
-2
-
-statement ok
-SET enable_legacy_parser = true
-
-statement error
-1 + 1
-----
-syntax error at or near "1"
-
-# fallback mode hands what the legacy grammar rejects to the PEG parser
-statement ok
-SET allow_parser_override_extension='fallback'
-
-query I
-1 + 1
-----
-2
-
-statement error
-SELEC 1
-----
-syntax error at or near "1"
-
-# default disables the override entirely
-statement ok
-SET allow_parser_override_extension='default'
-
-query I
-1 + 1
-----
-2
-
-# enabling again moves the core setting off default once more
-statement ok
-SET enable_legacy_parser = true
-
-statement error
-1 + 1
-----
-syntax error at or near "1"
-
-# an override mode that was chosen explicitly is kept
-statement ok
-SET allow_parser_override_extension='fallback'
-
-statement ok
-SET enable_legacy_parser = true
-
-query I
-SELECT current_setting('allow_parser_override_extension')
-----
-fallback
