+//! Whether a REFRESH option asks for refreshing to be on. Refreshing is the default for secrets
+//! created from a credential chain, so the useful thing to pass is a value that turns it off
+static bool ParseRefreshOption(const string &value) {
+	auto lower_value = StringUtil::Lower(value);
+	if (lower_value == "auto" || lower_value == "true" || lower_value == "on" || lower_value == "1") {
+		return true;
+	}
+	if (lower_value == "disabled" || lower_value == "false" || lower_value == "off" || lower_value == "0") {
+		return false;
+	}
+	throw InvalidInputException("Invalid value for REFRESH: '%s', expected 'auto' or 'disabled'", value);
+}
