-using PostgresTransactionManager = dbconnector::storage::TransactionManager<PostgresCatalog, PostgresTransaction>;
+class PostgresTransactionManager : public TransactionManager {
+public:
+	PostgresTransactionManager(AttachedDatabase &db_p, PostgresCatalog &catalog_p)
+	    : TransactionManager(db_p), catalog(catalog_p) {
+	}
+
+	Transaction &StartTransaction(Context &context) override {
+		auto transaction = make_uniq<PostgresTransaction>(catalog, *this, context);
+		transaction->Start();
+		auto &result = *transaction;
+		std::lock_guard<std::mutex> guard(transaction_lock);
+		transactions[result] = std::move(transaction);
+		return result;
+	}
+
+	ErrorData CommitTransaction(ClientContext &context, Transaction &transaction) override {
+		auto &db_transaction = transaction.Cast<PostgresTransaction>();
+		ErrorData error;
+		try {
+			db_transaction.Commit(context);
+		} catch (const std::exception &ex) {
+			error = ErrorData(ex);
+		} catch (...) {
+			error = ErrorData("Server COMMIT failed");
+		}
+		DestroyTransaction(transaction);
+		return error;
+	}
+
+	void RollbackTransaction(Transaction &transaction) override {
+		auto &db_transaction = transaction.Cast<PostgresTransaction>();
+		try {
+			db_transaction.Rollback();
+		} catch (...) {
+			DestroyTransaction(transaction);
+			throw;
+		}
+		DestroyTransaction(transaction);
+	}
+
+	void Checkpoint(ClientContext &context, bool force = false) override {
+		auto &transaction = PostgresTransaction::Get(context, db.GetCatalog());
+		auto &conn = transaction.GetConnection(context);
+		conn.Execute(context, "CHECKPOINT");
+	}
+
+protected:
+	void DestroyTransaction(Transaction &transaction) {
+		std::lock_guard<std::mutex> guard(transaction_lock);
+		transactions.erase(transaction);
+	}
+
+	PostgresCatalog &catalog;
+	std::mutex transaction_lock;
+	reference_map_t<Transaction, unique_ptr<PostgresTransaction>> transactions;
+};
 
 } // namespace duckdb
