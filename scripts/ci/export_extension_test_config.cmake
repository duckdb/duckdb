function(duckdb_extension_load NAME)
    duckdb_parse_extension("${NAME}" EXT ${ARGN})
    if(NOT EXT_SELECTED)
        return()
    endif()
    set(NAME "${EXTENSION_NAME_LOWERCASE}")
    list(APPEND DUCKDB_EXTENSION_NAMES "${NAME}")
    set(DUCKDB_EXTENSION_NAMES "${DUCKDB_EXTENSION_NAMES}" PARENT_SCOPE)
    if(EXT_DONT_BUILD OR NOT EXT_LOAD_TESTS OR NAME IN_LIST PREBUILT_EXTENSIONS)
        return()
    endif()
    duckdb_resolve_extension_paths("${NAME}" EXT "")
    set(record "")
    foreach(field NAME GIT_URL GIT_TAG SOURCE_DIR INCLUDE_DIR TEST_DIR SOURCE_PATH INCLUDE_PATH TEST_PATH CHECKOUT_DIR)
        string(TOLOWER "${field}" key)
        if(field STREQUAL "NAME")
            duckdb_manifest_json_string(value "${NAME}")
        else()
            duckdb_manifest_json_string(value "${EXT_${field}}")
        endif()
        string(APPEND record "\"${key}\":${value},")
    endforeach()
    set(submodules "")
    foreach(submodule IN LISTS EXT_SUBMODULES)
        duckdb_manifest_json_string(value "${submodule}")
        if(submodules)
            string(APPEND submodules ",")
        endif()
        string(APPEND submodules "${value}")
    endforeach()
    set(apply_patches false)
    if(EXT_APPLY_PATCHES)
        set(apply_patches true)
    endif()
    string(APPEND record "\"submodules\":[${submodules}],\"apply_patches\":${apply_patches}")
    get_property(records GLOBAL PROPERTY EXTENSION_TEST_RECORDS)
    if(records)
        file(APPEND "${OUTPUT_FILE}" ",\n")
    endif()
    file(APPEND "${OUTPUT_FILE}" "{${record}}")
    set_property(GLOBAL PROPERTY EXTENSION_TEST_RECORDS TRUE)
endfunction()

function(duckdb_extension_statically_link)
endfunction()

file(WRITE "${OUTPUT_FILE}" "[\n")
