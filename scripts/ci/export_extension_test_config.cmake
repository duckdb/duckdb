cmake_minimum_required(VERSION 3.20)

if(NOT PROJECT_SOURCE_DIR OR NOT EXTENSION_CONFIGS OR NOT OUTPUT_FILE)
    message(FATAL_ERROR "PROJECT_SOURCE_DIR, EXTENSION_CONFIGS and OUTPUT_FILE must be set")
endif()

set(CMAKE_CURRENT_SOURCE_DIR "${PROJECT_SOURCE_DIR}")
set(EXTENSION_CONFIG_BASE_DIR "${PROJECT_SOURCE_DIR}/.github/config/extensions")
set(WASM_ENABLED 0)
set(MUSL_ENABLED 0)
set(MINGW OFF)
set(EMSCRIPTEN OFF)
set(WIN32 OFF)
if(CMAKE_SYSTEM_NAME STREQUAL "Windows")
    set(WIN32 ON)
endif()
if(DEFINED ENV{BUILD_COMPLETE_EXTENSION_SET})
    set(BUILD_COMPLETE_EXTENSION_SET "$ENV{BUILD_COMPLETE_EXTENSION_SET}")
else()
    set(BUILD_COMPLETE_EXTENSION_SET 1)
endif()

function(json_string RESULT INPUT)
    string(REPLACE "\\" "\\\\" escaped "${INPUT}")
    string(REPLACE "\"" "\\\"" escaped "${escaped}")
    string(REPLACE "\n" "\\n" escaped "${escaped}")
    string(REPLACE "\r" "\\r" escaped "${escaped}")
    string(REPLACE "\t" "\\t" escaped "${escaped}")
    set(${RESULT} "\"${escaped}\"" PARENT_SCOPE)
endfunction()

function(duckdb_extension_load NAME)
    string(TOLOWER "${NAME}" NAME)
    get_property(names GLOBAL PROPERTY EXTENSION_TEST_NAMES)
    if(NAME IN_LIST names)
        return()
    endif()
    set_property(GLOBAL APPEND PROPERTY EXTENSION_TEST_NAMES "${NAME}")

    cmake_parse_arguments(EXT "DONT_BUILD;LOAD_TESTS;APPLY_PATCHES"
        "SOURCE_DIR;INCLUDE_DIR;TEST_DIR;GIT_URL;GIT_TAG;EXTENSION_VERSION;LINKED_LIBS"
        "SUBMODULES" ${ARGN})
    if(EXT_DONT_BUILD OR NOT EXT_LOAD_TESTS)
        return()
    endif()
    if(EXT_GIT_URL AND NOT EXT_GIT_TAG)
        message(FATAL_ERROR "No GIT_TAG specified for ${NAME}")
    endif()

    set(record "")
    foreach(field NAME GIT_URL GIT_TAG SOURCE_DIR TEST_DIR)
        string(TOLOWER "${field}" key)
        if(field STREQUAL "NAME")
            json_string(value "${NAME}")
        else()
            json_string(value "${EXT_${field}}")
        endif()
        string(APPEND record "\"${key}\":${value},")
    endforeach()
    set(submodules "")
    foreach(submodule IN LISTS EXT_SUBMODULES)
        json_string(value "${submodule}")
        if(submodules)
            string(APPEND submodules ",")
        endif()
        string(APPEND submodules "${value}")
    endforeach()
    set(apply_patches false)
    if(EXT_APPLY_PATCHES)
        set(apply_patches true)
    endif()
    string(APPEND record "\"submodules\":[${submodules}],\"apply_patches\":${apply_patches}")
    get_property(records GLOBAL PROPERTY EXTENSION_TEST_RECORDS)
    if(records)
        file(APPEND "${OUTPUT_FILE}" ",\n")
    endif()
    file(APPEND "${OUTPUT_FILE}" "{${record}}")
    set_property(GLOBAL PROPERTY EXTENSION_TEST_RECORDS TRUE)
endfunction()

function(duckdb_extension_statically_link)
endfunction()

file(WRITE "${OUTPUT_FILE}" "[\n")
foreach(config IN LISTS EXTENSION_CONFIGS)
    get_filename_component(config "${config}" ABSOLUTE BASE_DIR "${PROJECT_SOURCE_DIR}")
    include("${config}")
endforeach()
file(APPEND "${OUTPUT_FILE}" "\n]\n")
