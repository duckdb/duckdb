cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/../../extension/extension_config_resolution.cmake")
file(READ "${INPUT_FILE}" records)
string(JSON count LENGTH "${records}")
file(WRITE "${OUTPUT_FILE}" "[\n")
if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        foreach(field name source_dir include_dir test_dir git_url checkout_dir)
            string(JSON value ERROR_VARIABLE error GET "${records}" ${index} ${field})
            if(error)
                set(value "")
            endif()
            string(TOUPPER "${field}" key)
            set(EXT_${key} "${value}")
        endforeach()
        duckdb_resolve_extension_paths("${EXT_NAME}" EXT "${EXT_CHECKOUT_DIR}")
        duckdb_manifest_json_string(path "${EXT_TEST_PATH}")
        if(index GREATER 0)
            file(APPEND "${OUTPUT_FILE}" ",\n")
        endif()
        file(APPEND "${OUTPUT_FILE}" "${path}")
    endforeach()
endif()
file(APPEND "${OUTPUT_FILE}" "\n]\n")
