TagStatement <- 'TAG' 'ON' TagOnType DottedIdentifier TagActionInfo
TagOnType <- CommentTable / CommentSequence / CommentFunction / CommentMacroTable / CommentMacro / CommentView /
             CommentIndex / CommentType / CommentColumn
TagActionInfo <- TagSetAction / TagUnsetAction
TagSetAction <- 'SET' TagAssignmentList
TagUnsetAction <- 'UNSET' TagNameList
TagAssignmentList <- Parens(List(TagAssignment))
TagNameList <- Parens(List(StringLiteral))
TagAssignment <- StringLiteral '=' StringLiteral
